{"type":"data","nodes":[null,{"type":"data","data":[{"moduleCategories":1},[2,17,44,53,77,98,110,140,146,173,185,221,250],{"title":3,"modules":4},"Comenzamos",[5,8,11,14],{"slug":6,"title":7},"introduccion","Bienvenido a tu software gastronómico",{"slug":9,"title":10},"iniciar-sesion","Cómo Iniciar Sesión",{"slug":12,"title":13},"recuperar-contrasena","Cómo Recuperar tu Contraseña",{"slug":15,"title":16},"guia-de-inicio-rapido","Guía de Inicio Rápido",{"title":18,"modules":19},"Ventas",[20,23,26,29,32,35,38,41],{"slug":21,"title":22},"salon-de-ventas","Cómo Usar el Salón de Ventas (Adición)",{"slug":24,"title":25},"caja-rapida","Cómo Usar la Caja Rápida (Registradora)",{"slug":27,"title":28},"mozos","Cómo Cargar los Mozos",{"slug":30,"title":31},"clientes","Cómo Gestionar los Clientes",{"slug":33,"title":34},"descuentos","Cómo Configurar Descuentos",{"slug":36,"title":37},"nueva-reserva","Cómo Cargar una Nueva Reserva",{"slug":39,"title":40},"listado-de-reservas","Cómo Usar el Listado de Reservas",{"slug":42,"title":43},"grilla-de-reservas","Cómo Usar la Grilla de Reservas",{"title":45,"modules":46},"Medios de Pago",[47,50],{"slug":48,"title":49},"configuracion-procesadores","Configuración de Procesadores de Pago",{"slug":51,"title":52},"transacciones-mercadopago","Transacciones MercadoPago",{"title":54,"modules":55},"Productos",[56,59,62,65,68,71,74],{"slug":57,"title":58},"menu","Menú de Productos (Carta)",{"slug":60,"title":61},"categorias","Categorías de Productos",{"slug":63,"title":64},"variantes-grupo-sabores","Variantes y Grupos de Sabores",{"slug":66,"title":67},"maestro-de-productos","Maestro de Productos",{"slug":69,"title":70},"subproductos-elaborados","Sub-Productos (Elaborados)",{"slug":72,"title":73},"recetas","Recetas",{"slug":75,"title":76},"analisis-duplicados","Buscar Duplicados",{"title":78,"modules":79},"Compras",[80,83,86,89,92,95],{"slug":81,"title":82},"todas-las-ordenes-compra","Órdenes de Compra",{"slug":84,"title":85},"crear-orden-compra","Crear una Orden de Compra",{"slug":87,"title":88},"ordenes-a-aprobar","Órdenes a aprobar",{"slug":90,"title":91},"mercaderias","Mercaderías",{"slug":93,"title":94},"proveedores","Proveedores",{"slug":96,"title":97},"historial-de-compras","Historial de Compras",{"title":99,"modules":100},"Stock",[101,104,107],{"slug":102,"title":103},"stock-mercaderias","Stock de Mercaderías",{"slug":105,"title":106},"stock-subproductos","Stock de Subproductos",{"slug":108,"title":109},"movimientos-de-stock","Movimientos de Stock",{"title":111,"modules":112},"Finanzas",[113,116,119,122,125,128,131,134,137],{"slug":114,"title":115},"arqueos-de-caja","Arqueos de Caja",{"slug":117,"title":118},"listado-de-cajas","Listado de Cajas",{"slug":120,"title":121},"transacciones-de-cobro","Transacciones de Cobro",{"slug":123,"title":124},"factura-manual","Factura Manual",{"slug":126,"title":127},"resumen-de-deuda","Resumen de Deuda",{"slug":129,"title":130},"pagos","Pagos",{"slug":132,"title":133},"historial-de-facturas","Historial de Facturas",{"slug":135,"title":136},"historico-de-mesas","Histórico de Mesas",{"slug":138,"title":139},"puntos-de-venta-pdv","Puntos de Venta (PDVs)",{"title":141,"modules":142},"Comandero",[143],{"slug":144,"title":145},"comandero","Comandero (pantalla de cocina)",{"title":147,"modules":148},"RRHH",[149,152,155,158,161,164,167,170],{"slug":150,"title":151},"empleados","Empleados",{"slug":153,"title":154},"empleados-trabajando","Empleados Trabajando",{"slug":156,"title":157},"registro-diario-fichaje","Registro Diario de Fichaje",{"slug":159,"title":160},"reporte-mensual-fichaje","Reporte Mensual de Fichaje",{"slug":162,"title":163},"departamentos","Departamentos",{"slug":165,"title":166},"turnos-y-horarios-fichaje","Turnos y Horarios de Fichaje",{"slug":168,"title":169},"sueldos-y-jornales","Sueldos y Jornales",{"slug":171,"title":172},"datos-de-acceso-app","Datos de Acceso a la App de Fichaje",{"title":174,"modules":175},"Reportes",[176,179,182],{"slug":177,"title":178},"tablero-general","Tablero General",{"slug":180,"title":181},"productos-mas-vendidos","Productos Más Vendidos",{"slug":183,"title":184},"compras-por-mercaderia","Compras por Mercadería",{"title":186,"modules":187},"Configuracion",[188,191,194,197,200,203,206,209,212,215,218],{"slug":189,"title":190},"configuracion-general","Configuración general",{"slug":192,"title":193},"impresoras","Cómo cargar las impresoras del local",{"slug":195,"title":196},"perfiles-de-impresion","Cómo usar los perfiles de impresión",{"slug":198,"title":199},"usuarios-del-sistema","Cómo administrar los Usuarios del Sistema",{"slug":201,"title":202},"usuarios-con-pin","Cómo administrar los Usuarios con PIN",{"slug":204,"title":205},"punto-de-venta","🏛️ Trámite en ARCA (con clave fiscal)",{"slug":207,"title":208},"permisos-por-rol","Cómo configurar los Permisos por Rol",{"slug":210,"title":211},"turnos-mesa","Turnos de Mesa",{"slug":213,"title":214},"medios-de-cobro","Medios de cobro",{"slug":216,"title":217},"clasificacion-de-gastos","Clasificación de Gastos",{"slug":219,"title":220},"centros-de-costo","Centros de Costo",{"title":222,"modules":223},"Biblioteca de Drivers",[224,226,229,232,235,238,241,244,247],{"slug":225,"title":222},"biblioteca-de-drivers",{"slug":227,"title":228},"sam4s-giant-100","Sam4S Giant - 100",{"slug":230,"title":231},"citizen-ct-s310ii","Citizen CT-S310II",{"slug":233,"title":234},"epson-tm-t20","Epson TM-T20",{"slug":236,"title":237},"drivers-genericos","Drivers Genéricos POS",{"slug":239,"title":240},"epson-tm-t88","Epson TM-T88V",{"slug":242,"title":243},"fiscalberry-windows","Instalar Fiscalberry en Windows",{"slug":245,"title":246},"fiscalberry-linux","Instalar Fiscalberry en Linux",{"slug":248,"title":249},"fiscalberry-android","Instalar Fiscalberry en Android",{"title":251,"modules":252},"Extra",[253,256,259,262,265,268,271,274,277,280],{"slug":254,"title":255},"01-faq-solucion-inicial-pantalla-congelada","📖 Manual de Usuario: Solución Inicial si la Pantalla se Congela o no Carga",{"slug":257,"title":258},"03-faq-mozo-reabrir-mesa-anulada","📖 Manual de Usuario: Cómo Reabrir una Mesa Anulada o Cerrada por Error",{"slug":260,"title":261},"05-faq-cajero-emitir-factura-a","📖 Manual de Usuario: Cómo Emitir una Factura A Cargando Datos del Cliente",{"slug":263,"title":264},"06-faq-cajero-ingreso-egreso-cajon","📖 Manual de Usuario: Cómo Registrar Entradas y Salidas de Dinero del Cajón",{"slug":266,"title":267},"07-faq-cajero-activar-medio-pago","📖 Manual de Usuario: Cómo Activar un Medio de Pago que no Aparece al Cobrar",{"slug":269,"title":270},"08-faq-cajero-diferencia-facturado-vs-abiertas","📖 Manual de Usuario: Diferencia entre \"Facturado Total Mesas\" y \"Abiertas Por Usuario\" en Caja",{"slug":272,"title":273},"10-faq-supervisor-cierre-caja-diferencias","📖 Manual de Usuario: Cómo Auditar y Solucionar Diferencias en el Cierre de Caja",{"slug":275,"title":276},"preguntas-frecuentes","Preguntas Frecuentes y Guías Rápidas por Rol",{"slug":278,"title":279},"buchon-bot","Buchón Bot",{"slug":281,"title":282},"troubleshooting-semantico","📖 Guía Única de Resolución de Problemas y Errores (Troubleshooting)"],"uses":{}},{"type":"data","data":[{"slug":1,"title":2,"content":3,"tableOfContents":4,"seo":34,"llmTxtFile":38},"crear-orden-compra","Crear una Orden de Compra","\u003Cdiv id=\"crear-una-orden-de-compra\">\u003C/div>\n\n\u003Cblockquote>\n\u003Cp>\u003Cstrong>¿Dónde está en el sistema?:\u003C/strong> Menú principal → \u003Cstrong>Compras\u003C/strong> → \u003Cstrong>Crear orden de compra\u003C/strong>\n\u003Cstrong>¿Quién lo usa?:\u003C/strong> Compradores, encargados y administradores\u003C/p>\n\u003C/blockquote>\n\u003Cblockquote>\n\u003Cp>🎯 \u003Cstrong>¿Para qué sirve esto?\u003C/strong>\nUna orden de compra (OC) es el pedido que le hacés a un proveedor: qué mercadería, cuánta y a qué precio.\nQueda guardada para controlar después si te llegó todo y si la factura coincide.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🔑 Antes de empezar\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"antes-de-empezar\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"antes-de-empezar\">\u003C/div>\n\n\u003Cul>\n\u003Cli>El proveedor tiene que estar cargado. Mirá \u003Ca href=\"/user-guide/proveedores\">Proveedores\u003C/a>.\u003C/li>\n\u003Cli>Conviene tener cargadas las mercaderías. Mirá \u003Ca href=\"/user-guide/mercaderias\">Mercaderías\u003C/a>.\u003C/li>\n\u003Cli>Tu usuario tiene que tener el permiso de \u003Cstrong>Compras\u003C/strong> en \u003Ca href=\"/user-guide/permisos-por-rol\">Permisos por Rol\u003C/a>.\u003C/li>\n\u003C/ul>\n\u003Cblockquote>\n\u003Cp>💡 \u003Cstrong>Consejo útil:\u003C/strong> en la orden de compra va solo mercadería. Un equipo (un horno) o un servicio (un abono) no va acá: se carga como factura cuando llega.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                📍 Paso 1: Entrá a la pantalla\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-1-entra-a-la-pantalla\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-1-entra-a-la-pantalla\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/50-compras/53-00a-menu-grupo-compras.png\" alt=\"Menú lateral con el grupo Compras marcado en rojo\">\u003C/p>\n\u003Col>\n\u003Cli>En el menú de la izquierda, tocá \u003Cstrong>Compras\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/50-compras/53-00b-menu-opcion-form.png\" alt=\"Opción Crear orden de compra marcada en rojo\">\u003C/p>\n\u003Col start=\"2\">\n\u003Cli>Tocá \u003Cstrong>Crear orden de compra\u003C/strong>. Se abre la pantalla \u003Cstrong>Generar Orden de Compra\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                📝 Paso 2: Completá la orden\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-2-completa-la-orden\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-2-completa-la-orden\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/50-compras/53-41-formulario-completo.png\" alt=\"Formulario Generar Orden de Compra completo: tipo, fecha, proveedor, observaciones y dos mercaderías\">\u003C/p>\n\u003Cp>Así se ve la orden completa. De arriba hacia abajo:\u003C/p>\n\u003Ch3 class=\"relative\">\n                Los datos de la orden\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"los-datos-de-la-orden\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h3>\n            \u003Cdiv id=\"los-datos-de-la-orden\">\u003C/div>\n\n\u003Cul>\n\u003Cli>\u003Cstrong>Tipo\u003C/strong>: dejá \u003Cstrong>Orden de Compra\u003C/strong>. Si solo querés pedir precios, elegí \u003Cstrong>Solicitud Presupuesto\u003C/strong>.\u003C/li>\n\u003Cli>\u003Cstrong>Fecha de entrega esperada\u003C/strong>: el día en que necesitás la mercadería. El proveedor la ve.\u003C/li>\n\u003Cli>\u003Cstrong>Proveedor\u003C/strong>: escribí parte del nombre o el CUIT y tocalo en la lista que aparece. Abajo se ven su teléfono, su mail y su CUIT.\u003C/li>\n\u003Cli>\u003Cstrong>No Enviar Mail\u003C/strong>: es un interruptor. Si lo tocás cambia a \u003Cstrong>Enviar por Mail\u003C/strong> y, al guardar, la orden le llega por mail al proveedor. Si queda en \u003Cstrong>No Enviar Mail\u003C/strong>, no se manda.\u003C/li>\n\u003Cli>\u003Cstrong>Subir Remito\u003C/strong>: si ya tenés el remito, subí la foto. Es opcional.\u003C/li>\n\u003Cli>\u003Cstrong>Recepcionado\u003C/strong>: marcalo solo si la mercadería ya llegó.\u003C/li>\n\u003Cli>\u003Cstrong>Imprimir Orden\u003C/strong>: marcalo si querés que salga impresa al guardar.\u003C/li>\n\u003Cli>\u003Cstrong>Observaciones\u003C/strong>: lo que tenga que saber el proveedor. Por ejemplo: \u003Cem>Entregar por la mañana, antes de las 11\u003C/em>.\u003C/li>\n\u003Cli>El botón con la flechita, arriba de \u003Cstrong>Detalles de la OC\u003C/strong>, sirve para mandar el pedido por WhatsApp o copiarlo.\u003C/li>\n\u003C/ul>\n\u003Cblockquote>\n\u003Cp>⚠️ \u003Cstrong>Atención:\u003C/strong> elegí siempre el proveedor de la lista. Si escribís un nombre que no está, el sistema crea un proveedor nuevo.\u003C/p>\n\u003C/blockquote>\n\u003Ch3 class=\"relative\">\n                Las mercaderías (Detalles de la OC)\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"las-mercaderias-detalles-de-la-oc\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h3>\n            \u003Cdiv id=\"las-mercaderias-detalles-de-la-oc\">\u003C/div>\n\n\u003Cp>Cada renglón es una mercadería. De izquierda a derecha:\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Mercadería\u003C/strong>: escribí el nombre y tocala en la lista. Por ejemplo: \u003Cem>Harina 0000 x 25 kg\u003C/em>.\u003C/li>\n\u003Cli>\u003Cstrong>Cantidad\u003C/strong>: cuántas pedís. Por ejemplo: \u003Cem>4\u003C/em>.\u003C/li>\n\u003Cli>\u003Cstrong>U.M.\u003C/strong>: la unidad en que la pedís. Por ejemplo: \u003Cem>Bolsa\u003C/em>.\u003C/li>\n\u003Cli>\u003Cstrong>Precio Total s/Imp.\u003C/strong>: el total de ese renglón, sin impuestos. Por ejemplo: \u003Cem>48000\u003C/em>.\u003C/li>\n\u003Cli>\u003Cstrong>IVA\u003C/strong>: elegí el IVA. Por ejemplo: \u003Cem>IVA 21%\u003C/em>.\u003C/li>\n\u003Cli>\u003Cstrong>Precio c/Imp.\u003C/strong>: se calcula solo.\u003C/li>\n\u003Cli>\u003Cstrong>Observación\u003C/strong>: una aclaración, si hace falta.\u003C/li>\n\u003Cli>La \u003Cstrong>✖\u003C/strong> roja saca ese renglón.\u003C/li>\n\u003C/ul>\n\u003Cp>Debajo de cada renglón aparece una \u003Cstrong>Sugerencia\u003C/strong>: el stock actual, cuánto consumís por día y la cantidad sugerida. Tocá \u003Cstrong>Aplicar\u003C/strong> para usar esa cantidad, o la \u003Cstrong>i\u003C/strong> para ver cómo se calculó.\u003C/p>\n\u003Cp>Para sumar otra mercadería, tocá \u003Cstrong>Agregar otro Mercadería\u003C/strong>, abajo de todo.\u003C/p>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                💾 Paso 3: Guardá la orden\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-3-guarda-la-orden\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-3-guarda-la-orden\">\u003C/div>\n\n\u003Col>\n\u003Cli>Tocá el botón azul \u003Cstrong>Guardar Orden de Compra\u003C/strong>, arriba de todo.\u003C/li>\n\u003Cli>Si tu comercio pide aprobar las compras, la orden queda \u003Cstrong>a aprobar\u003C/strong>. Mirá \u003Ca href=\"/user-guide/ordenes-a-aprobar\">Órdenes a aprobar\u003C/a>.\u003C/li>\n\u003C/ol>\n\u003Ch3 class=\"relative\">\n                Si escribiste una mercadería nueva\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"si-escribiste-una-mercaderia-nueva\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h3>\n            \u003Cdiv id=\"si-escribiste-una-mercaderia-nueva\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/50-compras/53-40-ventana-mercaderias-nuevas.png\" alt=\"Ventana Se van a crear mercaderías nuevas en el catálogo, con los botones Cancelar y Sí, crearlas\">\u003C/p>\n\u003Cp>Si escribiste una mercadería que no existe, antes de guardar aparece esta ventana. Te muestra los nombres nuevos:\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Sí, crearlas\u003C/strong>: si es algo que comprás para el stock o para una receta. Se crea la mercadería y se guarda la orden.\u003C/li>\n\u003Cli>\u003Cstrong>Cancelar\u003C/strong>: si te equivocaste de nombre, o si es un equipo o un servicio. Volvés a la orden para corregir el renglón.\u003C/li>\n\u003C/ul>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                📤 Paso 4: Mandale la orden al proveedor\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-4-mandale-la-orden-al-proveedor\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-4-mandale-la-orden-al-proveedor\">\u003C/div>\n\n\u003Cul>\n\u003Cli>Desde el formulario, con el botón de WhatsApp (Paso 2).\u003C/li>\n\u003Cli>O después, por mail, desde \u003Ca href=\"/user-guide/todas-las-ordenes-compra\">Órdenes de compra\u003C/a>.\u003C/li>\n\u003C/ul>\n\u003Cblockquote>\n\u003Cp>⚠️ \u003Cstrong>Atención:\u003C/strong> si la orden está \u003Cstrong>a aprobar\u003C/strong>, esperá a que la aprueben antes de mandarla.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                ⚠️ Resolución de Inconvenientes\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"resolucion-de-inconvenientes\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"resolucion-de-inconvenientes\">\u003C/div>\n\n\u003Cdiv class=\"table-wrapper\">\u003Ctable>\n\u003Cthead>\n\u003Ctr>\n\u003Cth>Problema\u003C/th>\n\u003Cth>Causa más frecuente\u003C/th>\n\u003Cth>Solución recomendada\u003C/th>\n\u003C/tr>\n\u003C/thead>\n\u003Ctbody>\u003Ctr>\n\u003Ctd>\u003Cstrong>Se creó un proveedor repetido\u003C/strong>\u003C/td>\n\u003Ctd>Escribiste el nombre y no lo elegiste de la lista.\u003C/td>\n\u003Ctd>Juntalos en \u003Ca href=\"/user-guide/proveedores\">Proveedores\u003C/a> con \u003Cstrong>Unificar\u003C/strong>.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>No aparece la mercadería al escribir\u003C/strong>\u003C/td>\n\u003Ctd>No está cargada, o está con otro nombre.\u003C/td>\n\u003Ctd>Buscala en \u003Ca href=\"/user-guide/mercaderias\">Mercaderías\u003C/a> o cargala nueva.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>La orden no se puede mandar al proveedor\u003C/strong>\u003C/td>\n\u003Ctd>Está \u003Cstrong>a aprobar\u003C/strong> o fue \u003Cstrong>rechazada\u003C/strong>.\u003C/td>\n\u003Ctd>Revisala en \u003Ca href=\"/user-guide/ordenes-a-aprobar\">Órdenes a aprobar\u003C/a>.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>El total no coincide con la factura\u003C/strong>\u003C/td>\n\u003Ctd>El precio del renglón se cargó por unidad y no el total.\u003C/td>\n\u003Ctd>En \u003Cstrong>Precio Total s/Imp.\u003C/strong> va el total del renglón, no el precio unitario.\u003C/td>\n\u003C/tr>\n\u003C/tbody>\u003C/table>\u003C/div>\n",[5,9,12,15,19,22,25,28,31],{"id":6,"title":7,"level":8},"antes-de-empezar","Antes de empezar",2,{"id":10,"title":11,"level":8},"paso-1-entra-a-la-pantalla","Paso 1: Entrá a la pantalla",{"id":13,"title":14,"level":8},"paso-2-completa-la-orden","Paso 2: Completá la orden",{"id":16,"title":17,"level":18},"los-datos-de-la-orden","Los datos de la orden",3,{"id":20,"title":21,"level":18},"las-mercaderias-detalles-de-la-oc","Las mercaderías (Detalles de la OC)",{"id":23,"title":24,"level":8},"paso-3-guarda-la-orden","Paso 3: Guardá la orden",{"id":26,"title":27,"level":18},"si-escribiste-una-mercaderia-nueva","Si escribiste una mercadería nueva",{"id":29,"title":30,"level":8},"paso-4-mandale-la-orden-al-proveedor","Paso 4: Mandale la orden al proveedor",{"id":32,"title":33,"level":8},"resolucion-de-inconvenientes","Resolución de Inconvenientes",{"title":35,"description":36,"keywords":37},"Crear una Orden de Compra - Manual","¿Dónde está en el sistema?: Menú principal → Compras → Crear orden de compra\n ¿Quién lo usa?: Compradores, encargados y administradores","crear orden compra, paxapos, crear una orden de compra, tutorial, guía, manual usuario","53-crear-orden-compra.txt"],"uses":{"params":["slug"]}}]}
