{"type":"data","nodes":[null,{"type":"data","data":[{"moduleCategories":1},[2,17,44,53,77,98,110,140,146,173,185,221,250],{"title":3,"modules":4},"Comenzamos",[5,8,11,14],{"slug":6,"title":7},"introduccion","Bienvenido a tu software gastronómico",{"slug":9,"title":10},"iniciar-sesion","Cómo Iniciar Sesión",{"slug":12,"title":13},"recuperar-contrasena","Cómo Recuperar tu Contraseña",{"slug":15,"title":16},"guia-de-inicio-rapido","Guía de Inicio Rápido",{"title":18,"modules":19},"Ventas",[20,23,26,29,32,35,38,41],{"slug":21,"title":22},"salon-de-ventas","Cómo Usar el Salón de Ventas (Adición)",{"slug":24,"title":25},"caja-rapida","Cómo Usar la Caja Rápida (Registradora)",{"slug":27,"title":28},"mozos","Cómo Cargar los Mozos",{"slug":30,"title":31},"clientes","Cómo Gestionar los Clientes",{"slug":33,"title":34},"descuentos","Cómo Configurar Descuentos",{"slug":36,"title":37},"nueva-reserva","Cómo Cargar una Nueva Reserva",{"slug":39,"title":40},"listado-de-reservas","Cómo Usar el Listado de Reservas",{"slug":42,"title":43},"grilla-de-reservas","Cómo Usar la Grilla de Reservas",{"title":45,"modules":46},"Medios de Pago",[47,50],{"slug":48,"title":49},"configuracion-procesadores","Configuración de Procesadores de Pago",{"slug":51,"title":52},"transacciones-mercadopago","Transacciones MercadoPago",{"title":54,"modules":55},"Productos",[56,59,62,65,68,71,74],{"slug":57,"title":58},"menu","Menú de Productos (Carta)",{"slug":60,"title":61},"categorias","Categorías de Productos",{"slug":63,"title":64},"variantes-grupo-sabores","Variantes y Grupos de Sabores",{"slug":66,"title":67},"maestro-de-productos","Maestro de Productos",{"slug":69,"title":70},"subproductos-elaborados","Sub-Productos (Elaborados)",{"slug":72,"title":73},"recetas","Recetas",{"slug":75,"title":76},"analisis-duplicados","Buscar Duplicados",{"title":78,"modules":79},"Compras",[80,83,86,89,92,95],{"slug":81,"title":82},"todas-las-ordenes-compra","Órdenes de Compra",{"slug":84,"title":85},"crear-orden-compra","Crear una Orden de Compra",{"slug":87,"title":88},"ordenes-a-aprobar","Órdenes a aprobar",{"slug":90,"title":91},"mercaderias","Mercaderías",{"slug":93,"title":94},"proveedores","Proveedores",{"slug":96,"title":97},"historial-de-compras","Historial de Compras",{"title":99,"modules":100},"Stock",[101,104,107],{"slug":102,"title":103},"stock-mercaderias","Stock de Mercaderías",{"slug":105,"title":106},"stock-subproductos","Stock de Subproductos",{"slug":108,"title":109},"movimientos-de-stock","Movimientos de Stock",{"title":111,"modules":112},"Finanzas",[113,116,119,122,125,128,131,134,137],{"slug":114,"title":115},"arqueos-de-caja","Arqueos de Caja",{"slug":117,"title":118},"listado-de-cajas","Listado de Cajas",{"slug":120,"title":121},"transacciones-de-cobro","Transacciones de Cobro",{"slug":123,"title":124},"factura-manual","Factura Manual",{"slug":126,"title":127},"resumen-de-deuda","Resumen de Deuda",{"slug":129,"title":130},"pagos","Pagos",{"slug":132,"title":133},"historial-de-facturas","Historial de Facturas",{"slug":135,"title":136},"historico-de-mesas","Histórico de Mesas",{"slug":138,"title":139},"puntos-de-venta-pdv","Puntos de Venta (PDVs)",{"title":141,"modules":142},"Comandero",[143],{"slug":144,"title":145},"comandero","Comandero (pantalla de cocina)",{"title":147,"modules":148},"RRHH",[149,152,155,158,161,164,167,170],{"slug":150,"title":151},"empleados","Empleados",{"slug":153,"title":154},"empleados-trabajando","Empleados Trabajando",{"slug":156,"title":157},"registro-diario-fichaje","Registro Diario de Fichaje",{"slug":159,"title":160},"reporte-mensual-fichaje","Reporte Mensual de Fichaje",{"slug":162,"title":163},"departamentos","Departamentos",{"slug":165,"title":166},"turnos-y-horarios-fichaje","Turnos y Horarios de Fichaje",{"slug":168,"title":169},"sueldos-y-jornales","Sueldos y Jornales",{"slug":171,"title":172},"datos-de-acceso-app","Datos de Acceso a la App de Fichaje",{"title":174,"modules":175},"Reportes",[176,179,182],{"slug":177,"title":178},"tablero-general","Tablero General",{"slug":180,"title":181},"productos-mas-vendidos","Productos Más Vendidos",{"slug":183,"title":184},"compras-por-mercaderia","Compras por Mercadería",{"title":186,"modules":187},"Configuracion",[188,191,194,197,200,203,206,209,212,215,218],{"slug":189,"title":190},"configuracion-general","Configuración general",{"slug":192,"title":193},"impresoras","Cómo cargar las impresoras del local",{"slug":195,"title":196},"perfiles-de-impresion","Cómo usar los perfiles de impresión",{"slug":198,"title":199},"usuarios-del-sistema","Cómo administrar los Usuarios del Sistema",{"slug":201,"title":202},"usuarios-con-pin","Cómo administrar los Usuarios con PIN",{"slug":204,"title":205},"punto-de-venta","🏛️ Trámite en ARCA (con clave fiscal)",{"slug":207,"title":208},"permisos-por-rol","Cómo configurar los Permisos por Rol",{"slug":210,"title":211},"turnos-mesa","Turnos de Mesa",{"slug":213,"title":214},"medios-de-cobro","Medios de cobro",{"slug":216,"title":217},"clasificacion-de-gastos","Clasificación de Gastos",{"slug":219,"title":220},"centros-de-costo","Centros de Costo",{"title":222,"modules":223},"Biblioteca de Drivers",[224,226,229,232,235,238,241,244,247],{"slug":225,"title":222},"biblioteca-de-drivers",{"slug":227,"title":228},"sam4s-giant-100","Sam4S Giant - 100",{"slug":230,"title":231},"citizen-ct-s310ii","Citizen CT-S310II",{"slug":233,"title":234},"epson-tm-t20","Epson TM-T20",{"slug":236,"title":237},"drivers-genericos","Drivers Genéricos POS",{"slug":239,"title":240},"epson-tm-t88","Epson TM-T88V",{"slug":242,"title":243},"fiscalberry-windows","Instalar Fiscalberry en Windows",{"slug":245,"title":246},"fiscalberry-linux","Instalar Fiscalberry en Linux",{"slug":248,"title":249},"fiscalberry-android","Instalar Fiscalberry en Android",{"title":251,"modules":252},"Extra",[253,256,259,262,265,268,271,274,277,280],{"slug":254,"title":255},"01-faq-solucion-inicial-pantalla-congelada","📖 Manual de Usuario: Solución Inicial si la Pantalla se Congela o no Carga",{"slug":257,"title":258},"03-faq-mozo-reabrir-mesa-anulada","📖 Manual de Usuario: Cómo Reabrir una Mesa Anulada o Cerrada por Error",{"slug":260,"title":261},"05-faq-cajero-emitir-factura-a","📖 Manual de Usuario: Cómo Emitir una Factura A Cargando Datos del Cliente",{"slug":263,"title":264},"06-faq-cajero-ingreso-egreso-cajon","📖 Manual de Usuario: Cómo Registrar Entradas y Salidas de Dinero del Cajón",{"slug":266,"title":267},"07-faq-cajero-activar-medio-pago","📖 Manual de Usuario: Cómo Activar un Medio de Pago que no Aparece al Cobrar",{"slug":269,"title":270},"08-faq-cajero-diferencia-facturado-vs-abiertas","📖 Manual de Usuario: Diferencia entre \"Facturado Total Mesas\" y \"Abiertas Por Usuario\" en Caja",{"slug":272,"title":273},"10-faq-supervisor-cierre-caja-diferencias","📖 Manual de Usuario: Cómo Auditar y Solucionar Diferencias en el Cierre de Caja",{"slug":275,"title":276},"preguntas-frecuentes","Preguntas Frecuentes y Guías Rápidas por Rol",{"slug":278,"title":279},"buchon-bot","Buchón Bot",{"slug":281,"title":282},"troubleshooting-semantico","📖 Guía Única de Resolución de Problemas y Errores (Troubleshooting)"],"uses":{}},{"type":"data","data":[{"slug":1,"title":2,"content":3,"tableOfContents":4,"seo":30,"llmTxtFile":34},"listado-de-cajas","Listado de Cajas","\u003Cdiv id=\"listado-de-cajas\">\u003C/div>\n\n\u003Cblockquote>\n\u003Cp>\u003Cstrong>¿Dónde está en el sistema?:\u003C/strong> Menú principal → \u003Cstrong>Finanzas\u003C/strong> → \u003Cstrong>Caja\u003C/strong> → \u003Cstrong>Listado de Cajas\u003C/strong>\n\u003Cstrong>¿Quién lo usa?:\u003C/strong> Administradores y Tesoreros\u003C/p>\n\u003C/blockquote>\n\u003Cblockquote>\n\u003Cp>🎯 \u003Cstrong>¿Para qué sirve esto?\u003C/strong>\nAcá ves las cajas de tu comercio y creás las que falten. Por ejemplo: \u003Cem>Caja Barra\u003C/em> o \u003Cem>Caja Terraza\u003C/em>.\nTambién elegís qué usuarios pueden trabajar en cada caja.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🔑 Antes de empezar\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"antes-de-empezar\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"antes-de-empezar\">\u003C/div>\n\n\u003Cul>\n\u003Cli>Tu usuario tiene que ser administrador. Los botones de cada caja solo los ve un administrador.\u003C/li>\n\u003Cli>Mirá el permiso de \u003Cstrong>Caja\u003C/strong> en \u003Ca href=\"/user-guide/permisos-por-rol\">Permisos por Rol\u003C/a>.\u003C/li>\n\u003Cli>Para abrir o cerrar el turno de una caja, seguí la guía de \u003Ca href=\"/user-guide/arqueos-de-caja\">Arqueos de Caja\u003C/a>.\u003C/li>\n\u003C/ul>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                📍 Paso 1: Entrá a la pantalla\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-1-entra-a-la-pantalla\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-1-entra-a-la-pantalla\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/70-finanzas/73-00a-menu-grupo-finanzas.png\" alt=\"Menú lateral con el grupo Finanzas marcado en rojo\">\u003C/p>\n\u003Col>\n\u003Cli>En el menú de la izquierda, tocá \u003Cstrong>Finanzas\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/70-finanzas/73-00b-menu-opcion-listado-de-cajas.png\" alt=\"Opción Listado de Cajas marcada en rojo, debajo del título Caja\">\u003C/p>\n\u003Col start=\"2\">\n\u003Cli>Tocá \u003Cstrong>Listado de Cajas\u003C/strong>. Está debajo del título \u003Cstrong>CAJA\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/70-finanzas/73-01-pantalla-listado-de-cajas.png\" alt=\"Pantalla Listado de Cajas con Caja Ventas y Caja Prueba Manual y el botón verde Nueva Caja arriba a la derecha\">\u003C/p>\n\u003Cp>Cada renglón es una caja. Las columnas dicen:\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Id\u003C/strong>: el número que le puso el sistema.\u003C/li>\n\u003Cli>\u003Cstrong>Nombre\u003C/strong>: cómo se llama la caja.\u003C/li>\n\u003Cli>\u003Cstrong>Cant. Arqueos\u003C/strong>: cuántos turnos se abrieron en esa caja.\u003C/li>\n\u003Cli>\u003Cstrong>Computa Cobros\u003C/strong>: la tilde verde dice que suma los cobros que entran en efectivo.\u003C/li>\n\u003Cli>\u003Cstrong>Computa Pagos\u003C/strong>: la tilde verde dice que resta los pagos que salen en efectivo.\u003C/li>\n\u003Cli>\u003Cstrong>¿Es Caja Ciega?\u003C/strong>: la tilde dice que el cajero no ve cuánto debería haber al cerrar.\u003C/li>\n\u003Cli>\u003Cstrong>Imprime cierre\u003C/strong>: si hay una impresora, se imprime el resumen al cerrar. Por ejemplo: \u003Cem>comandera\u003C/em>.\u003C/li>\n\u003Cli>\u003Cstrong>Usuario\u003C/strong>: quiénes pueden usar la caja.\u003C/li>\n\u003Cli>\u003Cstrong>Acciones\u003C/strong>: los botones de cada caja (Paso 4).\u003C/li>\n\u003C/ul>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                ➕ Paso 2: Tocá el botón &quot;Nueva Caja&quot;\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-2-toca-el-boton-nueva-caja\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-2-toca-el-boton-nueva-caja\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/70-finanzas/73-02-donde-esta-boton-nueva-caja.png\" alt=\"Pantalla Listado de Cajas con el botón verde Nueva Caja marcado en rojo arriba a la derecha\">\u003C/p>\n\u003Col>\n\u003Cli>Tocá el botón verde \u003Cstrong>Nueva Caja\u003C/strong>, arriba a la derecha.\u003C/li>\n\u003Cli>Se abre una pantalla con los datos para completar.\u003C/li>\n\u003C/ol>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                📝 Paso 3: Completá los datos de la caja\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-3-completa-los-datos-de-la-caja\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-3-completa-los-datos-de-la-caja\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/70-finanzas/73-03-formulario-nueva-caja.png\" alt=\"Formulario de la caja completo con Caja Prueba Manual, dos tildes, la impresora y los usuarios tildados\">\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Nombre\u003C/strong>: escribí cómo querés llamar a la caja. Por ejemplo: \u003Cem>Caja Prueba Manual\u003C/em>. No puede repetirse.\u003C/li>\n\u003Cli>\u003Cstrong>Computa Ingresos\u003C/strong>: tildala si esta caja recibe cobros.\u003C/li>\n\u003Cli>\u003Cstrong>Computa Egresos\u003C/strong>: tildala si desde esta caja se hacen pagos.\u003C/li>\n\u003Cli>\u003Cstrong>Es Caja Ciega\u003C/strong>: tildala si el cajero no tiene que ver cuánto debería haber al cerrar.\u003C/li>\n\u003Cli>\u003Cstrong>Printer\u003C/strong>: elegí la impresora que saca el resumen al cerrar. Con \u003Cstrong>No imprimir Cierre de Arqueo\u003C/strong> no se imprime nada.\u003C/li>\n\u003Cli>\u003Cstrong>Usuarios habilitados para usar esta caja\u003C/strong>: tildá quién puede abrir y cerrar esta caja. Hay dos listas: los usuarios del comercio (por ejemplo \u003Cem>\u003Ca href=\"mailto:paxapos@paxapos.com\">paxapos@paxapos.com\u003C/a>\u003C/em>) y los genéricos (por ejemplo \u003Cem>Mozo 1 (dueño)\u003C/em>).\u003C/li>\n\u003Cli>\u003Cstrong>Guardar\u003C/strong>: el botón azul de abajo. Crea la caja.\u003C/li>\n\u003C/ul>\n\u003Cblockquote>\n\u003Cp>⚠️ \u003Cstrong>Atención:\u003C/strong> un cajero sin permiso para ver todo solo ve las cajas donde lo tildaste.\u003C/p>\n\u003C/blockquote>\n\u003Col>\n\u003Cli>Completá los datos.\u003C/li>\n\u003Cli>Tocá el botón azul \u003Cstrong>Guardar\u003C/strong>.\u003C/li>\n\u003Cli>Volvés al listado y la caja nueva aparece con su número.\u003C/li>\n\u003C/ol>\n\u003Cblockquote>\n\u003Cp>💡 \u003Cstrong>Consejo útil:\u003C/strong> antes de crear una caja, mirá el listado. Si ya existe con ese nombre, no la cargues de nuevo.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🧰 Paso 4: Conocé los botones de cada caja\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-4-conoce-los-botones-de-cada-caja\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-4-conoce-los-botones-de-cada-caja\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/70-finanzas/73-04-barra-de-iconos-del-renglon.png\" alt=\"Botones de una caja: un más azul, un lápiz azul y un tacho rojo\">\u003C/p>\n\u003Cp>A la derecha de cada caja hay tres botones:\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>➕ (más)\u003C/strong>: abre un turno nuevo en esa caja. Seguí la guía de \u003Ca href=\"/user-guide/arqueos-de-caja\">Arqueos de Caja\u003C/a>.\u003C/li>\n\u003Cli>\u003Cstrong>✏️ (lápiz)\u003C/strong>: cambia los datos de la caja (Paso 5).\u003C/li>\n\u003Cli>\u003Cstrong>🗑 (tacho)\u003C/strong>: borra la caja (Paso 6).\u003C/li>\n\u003C/ul>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                ✏️ Paso 5: Cambiá los datos de una caja\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-5-cambia-los-datos-de-una-caja\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-5-cambia-los-datos-de-una-caja\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/70-finanzas/73-05-formulario-editar-caja.png\" alt=\"Formulario Editar caja con los datos de Caja Prueba Manual y el botón Guardar\">\u003C/p>\n\u003Col>\n\u003Cli>Tocá el lápiz de la caja que querés cambiar.\u003C/li>\n\u003Cli>Se abre el mismo formulario del Paso 3, con los datos que ya tenía.\u003C/li>\n\u003Cli>Cambiá lo que necesites y tocá \u003Cstrong>Guardar\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🗑️ Paso 6: Borrá una caja\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-6-borra-una-caja\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-6-borra-una-caja\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/70-finanzas/73-06-donde-esta-boton-borrar-caja.png\" alt=\"Listado de Cajas con el tacho rojo de la fila Caja Prueba Manual marcado en rojo\">\u003C/p>\n\u003Cblockquote>\n\u003Cp>⚠️ \u003Cstrong>Atención:\u003C/strong> borrar una caja no se puede deshacer. Hacelo solo con cajas que nunca usaste.\u003C/p>\n\u003C/blockquote>\n\u003Col>\n\u003Cli>Tocá el tacho rojo de la caja.\u003C/li>\n\u003Cli>El sistema te pregunta si estás seguro de borrarla.\u003C/li>\n\u003Cli>Si tocás aceptar, la caja desaparece del listado.\u003C/li>\n\u003C/ol>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                ⚠️ Resolución de Inconvenientes\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"resolucion-de-inconvenientes\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"resolucion-de-inconvenientes\">\u003C/div>\n\n\u003Cdiv class=\"table-wrapper\">\u003Ctable>\n\u003Cthead>\n\u003Ctr>\n\u003Cth>Problema\u003C/th>\n\u003Cth>Causa más frecuente\u003C/th>\n\u003Cth>Solución recomendada\u003C/th>\n\u003C/tr>\n\u003C/thead>\n\u003Ctbody>\u003Ctr>\n\u003Ctd>No veo los botones de la columna \u003Cstrong>Acciones\u003C/strong>.\u003C/td>\n\u003Ctd>Tu usuario no es administrador.\u003C/td>\n\u003Ctd>Pedile a un administrador que haga el cambio.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>Toco \u003Cstrong>Guardar\u003C/strong> y la caja no se crea.\u003C/td>\n\u003Ctd>Ya hay una caja con ese nombre, o el nombre está vacío.\u003C/td>\n\u003Ctd>Escribí otro nombre. Por ejemplo: \u003Cem>Caja Terraza 2\u003C/em>.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>Al tocar el tacho dice que no tengo permiso.\u003C/td>\n\u003Ctd>Tu rol no tiene el permiso de cerrar arqueos.\u003C/td>\n\u003Ctd>Pedile a un administrador que ajuste el permiso en \u003Ca href=\"/user-guide/permisos-por-rol\">Permisos por Rol\u003C/a>.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>Un cajero no ve su caja al abrir un turno.\u003C/td>\n\u003Ctd>No está tildado en \u003Cstrong>Usuarios habilitados para usar esta caja\u003C/strong>.\u003C/td>\n\u003Ctd>Tocá el lápiz de la caja, tildalo y tocá \u003Cstrong>Guardar\u003C/strong>.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>En \u003Cstrong>Arqueos de Caja\u003C/strong> dice &quot;No hay cajas configuradas&quot;.\u003C/td>\n\u003Ctd>Todas las cajas ya tienen un turno abierto.\u003C/td>\n\u003Ctd>No falta crear ninguna: cerrá un turno para poder abrir otro.\u003C/td>\n\u003C/tr>\n\u003C/tbody>\u003C/table>\u003C/div>\n",[5,9,12,15,18,21,24,27],{"id":6,"title":7,"level":8},"antes-de-empezar","Antes de empezar",2,{"id":10,"title":11,"level":8},"paso-1-entra-a-la-pantalla","Paso 1: Entrá a la pantalla",{"id":13,"title":14,"level":8},"paso-2-toca-el-boton-nueva-caja","Paso 2: Tocá el botón \"Nueva Caja\"",{"id":16,"title":17,"level":8},"paso-3-completa-los-datos-de-la-caja","Paso 3: Completá los datos de la caja",{"id":19,"title":20,"level":8},"paso-4-conoce-los-botones-de-cada-caja","Paso 4: Conocé los botones de cada caja",{"id":22,"title":23,"level":8},"paso-5-cambia-los-datos-de-una-caja","Paso 5: Cambiá los datos de una caja",{"id":25,"title":26,"level":8},"paso-6-borra-una-caja","Paso 6: Borrá una caja",{"id":28,"title":29,"level":8},"resolucion-de-inconvenientes","Resolución de Inconvenientes",{"title":31,"description":32,"keywords":33},"Listado de Cajas - Manual","¿Dónde está en el sistema?: Menú principal → Finanzas → Caja → Listado de Cajas\n ¿Quién lo usa?: Administradores y Tesoreros","listado de cajas, paxapos, listado de cajas, tutorial, guía, manual usuario","73-listado-de-cajas.txt"],"uses":{"params":["slug"]}}]}
