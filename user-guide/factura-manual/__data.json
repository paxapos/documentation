{"type":"data","nodes":[null,{"type":"data","data":[{"moduleCategories":1},[2,17,44,53,77,98,110,140,146,173,185,221,250],{"title":3,"modules":4},"Comenzamos",[5,8,11,14],{"slug":6,"title":7},"introduccion","Bienvenido a tu software gastronómico",{"slug":9,"title":10},"iniciar-sesion","Cómo Iniciar Sesión",{"slug":12,"title":13},"recuperar-contrasena","Cómo Recuperar tu Contraseña",{"slug":15,"title":16},"guia-de-inicio-rapido","Guía de Inicio Rápido",{"title":18,"modules":19},"Ventas",[20,23,26,29,32,35,38,41],{"slug":21,"title":22},"salon-de-ventas","Cómo Usar el Salón de Ventas (Adición)",{"slug":24,"title":25},"caja-rapida","Cómo Usar la Caja Rápida (Registradora)",{"slug":27,"title":28},"mozos","Cómo Cargar los Mozos",{"slug":30,"title":31},"clientes","Cómo Gestionar los Clientes",{"slug":33,"title":34},"descuentos","Cómo Configurar Descuentos",{"slug":36,"title":37},"nueva-reserva","Cómo Cargar una Nueva Reserva",{"slug":39,"title":40},"listado-de-reservas","Cómo Usar el Listado de Reservas",{"slug":42,"title":43},"grilla-de-reservas","Cómo Usar la Grilla de Reservas",{"title":45,"modules":46},"Medios de Pago",[47,50],{"slug":48,"title":49},"configuracion-procesadores","Configuración de Procesadores de Pago",{"slug":51,"title":52},"transacciones-mercadopago","Transacciones MercadoPago",{"title":54,"modules":55},"Productos",[56,59,62,65,68,71,74],{"slug":57,"title":58},"menu","Menú de Productos (Carta)",{"slug":60,"title":61},"categorias","Categorías de Productos",{"slug":63,"title":64},"variantes-grupo-sabores","Variantes y Grupos de Sabores",{"slug":66,"title":67},"maestro-de-productos","Maestro de Productos",{"slug":69,"title":70},"subproductos-elaborados","Sub-Productos (Elaborados)",{"slug":72,"title":73},"recetas","Recetas",{"slug":75,"title":76},"analisis-duplicados","Buscar Duplicados",{"title":78,"modules":79},"Compras",[80,83,86,89,92,95],{"slug":81,"title":82},"todas-las-ordenes-compra","Órdenes de Compra",{"slug":84,"title":85},"crear-orden-compra","Crear una Orden de Compra",{"slug":87,"title":88},"ordenes-a-aprobar","Órdenes a aprobar",{"slug":90,"title":91},"mercaderias","Mercaderías",{"slug":93,"title":94},"proveedores","Proveedores",{"slug":96,"title":97},"historial-de-compras","Historial de Compras",{"title":99,"modules":100},"Stock",[101,104,107],{"slug":102,"title":103},"stock-mercaderias","Stock de Mercaderías",{"slug":105,"title":106},"stock-subproductos","Stock de Subproductos",{"slug":108,"title":109},"movimientos-de-stock","Movimientos de Stock",{"title":111,"modules":112},"Finanzas",[113,116,119,122,125,128,131,134,137],{"slug":114,"title":115},"arqueos-de-caja","Arqueos de Caja",{"slug":117,"title":118},"listado-de-cajas","Listado de Cajas",{"slug":120,"title":121},"transacciones-de-cobro","Transacciones de Cobro",{"slug":123,"title":124},"factura-manual","Factura Manual",{"slug":126,"title":127},"resumen-de-deuda","Resumen de Deuda",{"slug":129,"title":130},"pagos","Pagos",{"slug":132,"title":133},"historial-de-facturas","Historial de Facturas",{"slug":135,"title":136},"historico-de-mesas","Histórico de Mesas",{"slug":138,"title":139},"puntos-de-venta-pdv","Puntos de Venta (PDVs)",{"title":141,"modules":142},"Comandero",[143],{"slug":144,"title":145},"comandero","Comandero (pantalla de cocina)",{"title":147,"modules":148},"RRHH",[149,152,155,158,161,164,167,170],{"slug":150,"title":151},"empleados","Empleados",{"slug":153,"title":154},"empleados-trabajando","Empleados Trabajando",{"slug":156,"title":157},"registro-diario-fichaje","Registro Diario de Fichaje",{"slug":159,"title":160},"reporte-mensual-fichaje","Reporte Mensual de Fichaje",{"slug":162,"title":163},"departamentos","Departamentos",{"slug":165,"title":166},"turnos-y-horarios-fichaje","Turnos y Horarios de Fichaje",{"slug":168,"title":169},"sueldos-y-jornales","Sueldos y Jornales",{"slug":171,"title":172},"datos-de-acceso-app","Datos de Acceso a la App de Fichaje",{"title":174,"modules":175},"Reportes",[176,179,182],{"slug":177,"title":178},"tablero-general","Tablero General",{"slug":180,"title":181},"productos-mas-vendidos","Productos Más Vendidos",{"slug":183,"title":184},"compras-por-mercaderia","Compras por Mercadería",{"title":186,"modules":187},"Configuracion",[188,191,194,197,200,203,206,209,212,215,218],{"slug":189,"title":190},"configuracion-general","Configuración general",{"slug":192,"title":193},"impresoras","Cómo cargar las impresoras del local",{"slug":195,"title":196},"perfiles-de-impresion","Cómo usar los perfiles de impresión",{"slug":198,"title":199},"usuarios-del-sistema","Cómo administrar los Usuarios del Sistema",{"slug":201,"title":202},"usuarios-con-pin","Cómo administrar los Usuarios con PIN",{"slug":204,"title":205},"punto-de-venta","🏛️ Trámite en ARCA (con clave fiscal)",{"slug":207,"title":208},"permisos-por-rol","Cómo configurar los Permisos por Rol",{"slug":210,"title":211},"turnos-mesa","Turnos de Mesa",{"slug":213,"title":214},"medios-de-cobro","Medios de cobro",{"slug":216,"title":217},"clasificacion-de-gastos","Clasificación de Gastos",{"slug":219,"title":220},"centros-de-costo","Centros de Costo",{"title":222,"modules":223},"Biblioteca de Drivers",[224,226,229,232,235,238,241,244,247],{"slug":225,"title":222},"biblioteca-de-drivers",{"slug":227,"title":228},"sam4s-giant-100","Sam4S Giant - 100",{"slug":230,"title":231},"citizen-ct-s310ii","Citizen CT-S310II",{"slug":233,"title":234},"epson-tm-t20","Epson TM-T20",{"slug":236,"title":237},"drivers-genericos","Drivers Genéricos POS",{"slug":239,"title":240},"epson-tm-t88","Epson TM-T88V",{"slug":242,"title":243},"fiscalberry-windows","Instalar Fiscalberry en Windows",{"slug":245,"title":246},"fiscalberry-linux","Instalar Fiscalberry en Linux",{"slug":248,"title":249},"fiscalberry-android","Instalar Fiscalberry en Android",{"title":251,"modules":252},"Extra",[253,256,259,262,265,268,271,274,277,280],{"slug":254,"title":255},"01-faq-solucion-inicial-pantalla-congelada","📖 Manual de Usuario: Solución Inicial si la Pantalla se Congela o no Carga",{"slug":257,"title":258},"03-faq-mozo-reabrir-mesa-anulada","📖 Manual de Usuario: Cómo Reabrir una Mesa Anulada o Cerrada por Error",{"slug":260,"title":261},"05-faq-cajero-emitir-factura-a","📖 Manual de Usuario: Cómo Emitir una Factura A Cargando Datos del Cliente",{"slug":263,"title":264},"06-faq-cajero-ingreso-egreso-cajon","📖 Manual de Usuario: Cómo Registrar Entradas y Salidas de Dinero del Cajón",{"slug":266,"title":267},"07-faq-cajero-activar-medio-pago","📖 Manual de Usuario: Cómo Activar un Medio de Pago que no Aparece al Cobrar",{"slug":269,"title":270},"08-faq-cajero-diferencia-facturado-vs-abiertas","📖 Manual de Usuario: Diferencia entre \"Facturado Total Mesas\" y \"Abiertas Por Usuario\" en Caja",{"slug":272,"title":273},"10-faq-supervisor-cierre-caja-diferencias","📖 Manual de Usuario: Cómo Auditar y Solucionar Diferencias en el Cierre de Caja",{"slug":275,"title":276},"preguntas-frecuentes","Preguntas Frecuentes y Guías Rápidas por Rol",{"slug":278,"title":279},"buchon-bot","Buchón Bot",{"slug":281,"title":282},"troubleshooting-semantico","📖 Guía Única de Resolución de Problemas y Errores (Troubleshooting)"],"uses":{}},{"type":"data","data":[{"slug":1,"title":2,"content":3,"tableOfContents":4,"seo":30,"llmTxtFile":34},"factura-manual","Factura Manual","\u003Cdiv id=\"factura-manual\">\u003C/div>\n\n\u003Cblockquote>\n\u003Cp>\u003Cstrong>¿Dónde está en el sistema?:\u003C/strong> Menú principal → \u003Cstrong>Finanzas\u003C/strong> → \u003Cstrong>Facturas y Pagos\u003C/strong> → \u003Cstrong>Factura Manual\u003C/strong>\n\u003Cstrong>¿Quién lo usa?:\u003C/strong> Encargados de Cuentas a Pagar y Contadores\u003C/p>\n\u003C/blockquote>\n\u003Cblockquote>\n\u003Cp>🎯 \u003Cstrong>¿Para qué sirve esto?\u003C/strong>\nSirve para cargar a mano una factura que te hizo un proveedor: luz, alquiler, mercadería.\nAl guardarla, queda la deuda con ese proveedor hasta que la pagues.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🔑 Antes de empezar\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"antes-de-empezar\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"antes-de-empezar\">\u003C/div>\n\n\u003Cul>\n\u003Cli>Tu usuario tiene que tener el permiso \u003Cstrong>Contabilidad / Gastos\u003C/strong> con la acción \u003Cstrong>cargar_gasto\u003C/strong>, en \u003Ca href=\"/user-guide/permisos-por-rol\">Permisos por Rol\u003C/a>.\u003C/li>\n\u003Cli>Tené a mano la factura de papel o el PDF. Vas a copiar los datos.\u003C/li>\n\u003Cli>El proveedor tiene que estar en \u003Ca href=\"/user-guide/proveedores\">Proveedores\u003C/a>. Si no está, el sistema lo crea al guardar.\u003C/li>\n\u003Cli>Podés cargar poco y completar después. El dato más importante es el \u003Cstrong>Total de la Factura\u003C/strong>.\u003C/li>\n\u003C/ul>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                📍 Paso 1: Entrá a la pantalla\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-1-entra-a-la-pantalla\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-1-entra-a-la-pantalla\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/70-finanzas/76-00a-menu-grupo-finanzas.png\" alt=\"Menú lateral con el grupo Finanzas marcado en rojo\">\u003C/p>\n\u003Col>\n\u003Cli>En el menú de la izquierda, tocá \u003Cstrong>Finanzas\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/70-finanzas/76-00b-menu-opcion-factura-manual.png\" alt=\"Opción Factura Manual marcada en rojo, debajo del título Facturas y Pagos\">\u003C/p>\n\u003Col start=\"2\">\n\u003Cli>Tocá \u003Cstrong>Factura Manual\u003C/strong>. Está debajo del título \u003Cstrong>FACTURAS Y PAGOS\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/70-finanzas/76-01-pantalla-factura-manual.png\" alt=\"Pantalla Factura Manual con la zona para subir la imagen a la izquierda y los datos de la factura a la derecha\">\u003C/p>\n\u003Cp>Así se ve la pantalla, con el título \u003Cstrong>Nueva Factura\u003C/strong> arriba. Es larga: bajá con la rueda del mouse para ver todo.\u003C/p>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🖼️ Paso 2: Adjuntá la imagen (si querés)\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-2-adjunta-la-imagen-si-queres\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-2-adjunta-la-imagen-si-queres\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/70-finanzas/76-02-zona-imagen.png\" alt=\"Recuadro punteado con una nube y el texto Arrastrá o hacé clic para adjuntar imagen de la factura\">\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Arrastrá o hacé clic\u003C/strong>: arrastrá la foto de la factura hasta el recuadro, o tocalo y elegí el archivo. Sirve un PDF, JPG o PNG de hasta 10 MB.\u003C/li>\n\u003Cli>\u003Cstrong>IA\u003C/strong>: arriba a la izquierda hay una insignia gris que dice \u003Cstrong>IA OFF\u003C/strong> cuando la inteligencia artificial está apagada. Si tu comercio la tiene prendida, el sistema puede leer la factura solo. Si está apagada, cargás los datos a mano.\u003C/li>\n\u003C/ul>\n\u003Cblockquote>\n\u003Cp>💡 \u003Cstrong>Consejo útil:\u003C/strong> adjuntar la imagen es opcional, pero después te ahorra buscar el papel.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                📝 Paso 3: Completá los datos de la factura\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-3-completa-los-datos-de-la-factura\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-3-completa-los-datos-de-la-factura\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/70-finanzas/76-03-datos-de-la-factura.png\" alt=\"Datos de la factura completos: fecha, proveedor Distribuidora Ejemplo, tipo B, número 0001-00000123 y la observación Factura de prueba del manual\">\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Fecha de la factura\u003C/strong>: la fecha que dice el papel. Es obligatoria.\u003C/li>\n\u003Cli>\u003Cstrong>Vencimiento (opcional)\u003C/strong>: hasta cuándo tenés para pagarla.\u003C/li>\n\u003Cli>\u003Cstrong>Proveedor\u003C/strong>: escribí parte del nombre o el CUIT y tocá el proveedor en la lista. Por ejemplo: \u003Cem>Distribuidora Ejemplo\u003C/em>.\u003C/li>\n\u003Cli>\u003Cstrong>Tipo de factura\u003C/strong>: elegí la letra de la factura. Por ejemplo: \u003Cstrong>&quot;B&quot;\u003C/strong>.\u003C/li>\n\u003Cli>\u003Cstrong>Número de factura\u003C/strong>: a la izquierda el punto de venta (por ejemplo \u003Cem>0001\u003C/em>) y a la derecha el número (por ejemplo \u003Cem>00000123\u003C/em>).\u003C/li>\n\u003Cli>\u003Cstrong>Clasificación (opcional)\u003C/strong>: para qué gasto es. Por ejemplo: \u003Cem>MANO DE OBRA\u003C/em>.\u003C/li>\n\u003Cli>\u003Cstrong>PDV / Centro de costo (opcional)\u003C/strong>: a qué local o sector pertenece el gasto.\u003C/li>\n\u003Cli>\u003Cstrong>CAPEX / Bien de uso\u003C/strong>: tildalo solo si es una inversión, como una máquina o equipamiento.\u003C/li>\n\u003Cli>\u003Cstrong>Observaciones (opcional)\u003C/strong>: un texto libre. Por ejemplo: \u003Cem>Factura de prueba del manual\u003C/em>.\u003C/li>\n\u003C/ul>\n\u003Cblockquote>\n\u003Cp>💡 \u003Cstrong>Consejo útil:\u003C/strong> al guardar, el sistema completa el número con ceros. Por ejemplo, \u003Cem>0001-00000123\u003C/em> se ve como \u003Cem>00001-00000000000000000123\u003C/em>.\u003C/p>\n\u003C/blockquote>\n\u003Cblockquote>\n\u003Cp>💡 \u003Cstrong>Consejo útil:\u003C/strong> si escribís un número que ya cargaste para ese proveedor, el sistema avisa que ya existe y no la guarda dos veces.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🧾 Paso 4: Revisá los impuestos\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-4-revisa-los-impuestos\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-4-revisa-los-impuestos\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/70-finanzas/76-04-impuestos-del-proveedor.png\" alt=\"Columna Impuestos del proveedor con retenciones de Ganancias, IIBB, IVA y SUSS, y el botón Agregar Otros Impuestos\">\u003C/p>\n\u003Cp>Al elegir el proveedor, abajo de la imagen aparecen sus impuestos.\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Casillero de cada impuesto\u003C/strong>: tildalo si la factura lo lleva. Después completá el importe.\u003C/li>\n\u003Cli>\u003Cstrong>Agregar Otros Impuestos\u003C/strong>: abre la lista de los demás impuestos, como \u003Cstrong>IVA 21%\u003C/strong>.\u003C/li>\n\u003Cli>Si todavía no elegiste proveedor, ves el mensaje \u003Cstrong>Seleccioná un proveedor para ver los impuestos\u003C/strong>.\u003C/li>\n\u003C/ul>\n\u003Cp>\u003Cimg src=\"/images/manual/70-finanzas/76-05-agregar-iva.png\" alt=\"Impuesto IVA 21% tildado, con el neto 1239.67 y el IVA calculado 260,33\">\u003C/p>\n\u003Cp>Ejemplo con \u003Cstrong>IVA 21%\u003C/strong>:\u003C/p>\n\u003Col>\n\u003Cli>Tocá \u003Cstrong>Agregar Otros Impuestos\u003C/strong> y tildá \u003Cstrong>IVA 21%\u003C/strong>.\u003C/li>\n\u003Cli>Escribí el importe sin IVA en \u003Cstrong>Neto\u003C/strong>. Por ejemplo: \u003Cem>1239.67\u003C/em>.\u003C/li>\n\u003Cli>El sistema calcula el \u003Cstrong>Impuesto\u003C/strong> solo: \u003Cem>260,33\u003C/em>.\u003C/li>\n\u003Cli>El \u003Cstrong>Total de la Factura\u003C/strong> se completa con la suma: \u003Cem>1500\u003C/em>.\u003C/li>\n\u003C/ol>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                💵 Paso 5: Escribí el total y guardá\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-5-escribi-el-total-y-guarda\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-5-escribi-el-total-y-guarda\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/70-finanzas/76-06-importes-y-botones.png\" alt=\"Importes: Neto Gravado, Total de la Factura con 1500, Moneda ARS, y los botones Guardar borrador y Guardar y Pagar\">\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Neto Gravado\u003C/strong>: no se escribe. Se calcula solo con los impuestos que tildaste. Por ejemplo: \u003Cem>1239,67\u003C/em>.\u003C/li>\n\u003Cli>\u003Cstrong>Total de la Factura\u003C/strong>: escribí el total del papel. Por ejemplo: \u003Cem>1500\u003C/em>.\u003C/li>\n\u003Cli>\u003Cstrong>Moneda\u003C/strong>: dejá \u003Cstrong>ARS\u003C/strong> (pesos). Si elegís otra, aparece el casillero \u003Cstrong>Cotización\u003C/strong>.\u003C/li>\n\u003Cli>\u003Cstrong>Guardar borrador\u003C/strong>: guarda la factura \u003Cstrong>sin pagar\u003C/strong>. Queda la deuda.\u003C/li>\n\u003Cli>\u003Cstrong>Guardar y Pagar\u003C/strong>: guarda la factura y te lleva a pagarla.\u003C/li>\n\u003C/ul>\n\u003Cblockquote>\n\u003Cp>⚠️ \u003Cstrong>Atención:\u003C/strong> \u003Cstrong>Guardar y Pagar\u003C/strong> te lleva a registrar un pago de verdad. Si solo querés cargar la deuda, usá \u003Cstrong>Guardar borrador\u003C/strong>.\u003C/p>\n\u003C/blockquote>\n\u003Col>\n\u003Cli>Para dejar la factura pendiente de pago, tocá \u003Cstrong>Guardar borrador\u003C/strong>.\u003C/li>\n\u003Cli>El sistema guarda la factura y vuelve a la pantalla desde donde entraste.\u003C/li>\n\u003Cli>Buscala en \u003Ca href=\"/user-guide/historial-de-facturas\">Historial de Facturas\u003C/a>. Vas a verla con el monto en \u003Cstrong>Falta pagar\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cblockquote>\n\u003Cp>💡 \u003Cstrong>Consejo útil:\u003C/strong> el botón \u003Cstrong>Guardar\u003C/strong> solo aparece al editar una factura que ya está toda pagada.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                📦 Paso 6: Cargá los ítems (opcional)\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-6-carga-los-items-opcional\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-6-carga-los-items-opcional\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/70-finanzas/76-08-items-de-la-factura.png\" alt=\"Panel Ítems de la factura con un renglón Harina 0000 x 25 kg, cantidad 1 e importe 1500, y el botón Agregar ítem\">\u003C/p>\n\u003Cp>Es el detalle de lo que compraste. Sirve si querés que cuente para el stock.\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Mercadería\u003C/strong>: escribí el nombre y elegí de la lista. Por ejemplo: \u003Cem>Harina 0000 x 25 kg\u003C/em>.\u003C/li>\n\u003Cli>\u003Cstrong>Cantidad\u003C/strong>: cuántas unidades vinieron.\u003C/li>\n\u003Cli>\u003Cstrong>Unidad\u003C/strong>: la unidad de medida, si el sistema la ofrece.\u003C/li>\n\u003Cli>\u003Cstrong>Importe de línea\u003C/strong>: cuánto costó ese renglón.\u003C/li>\n\u003Cli>\u003Cstrong>Quitar\u003C/strong>: tildalo para sacar el renglón de la factura.\u003C/li>\n\u003Cli>\u003Cstrong>Agregar ítem\u003C/strong>: suma un renglón nuevo.\u003C/li>\n\u003Cli>\u003Cstrong>Suma de los ítems\u003C/strong>: el sistema la compara con el total y avisa si no coinciden.\u003C/li>\n\u003C/ul>\n\u003Cblockquote>\n\u003Cp>💡 \u003Cstrong>Consejo útil:\u003C/strong> si no elegís una mercadería de la lista, el renglón se guarda igual y queda \u003Cstrong>pendiente de vincular\u003C/strong>. Nunca se crea una mercadería nueva desde una factura.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                ⚠️ Resolución de Inconvenientes\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"resolucion-de-inconvenientes\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"resolucion-de-inconvenientes\">\u003C/div>\n\n\u003Cdiv class=\"table-wrapper\">\u003Ctable>\n\u003Cthead>\n\u003Ctr>\n\u003Cth>Problema\u003C/th>\n\u003Cth>Causa más frecuente\u003C/th>\n\u003Cth>Solución recomendada\u003C/th>\n\u003C/tr>\n\u003C/thead>\n\u003Ctbody>\u003Ctr>\n\u003Ctd>\u003Cstrong>&quot;Número de Factura: Este número de factura ya esta cargada para este mismo proveedor&quot;\u003C/strong>\u003C/td>\n\u003Ctd>Esa factura ya se cargó antes.\u003C/td>\n\u003Ctd>Buscala en \u003Ca href=\"/user-guide/historial-de-facturas\">Historial de Facturas\u003C/a>. Si es otra, revisá el número.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>No aparece el menú Factura Manual\u003C/strong>\u003C/td>\n\u003Ctd>Tu usuario no tiene el permiso de cargar facturas.\u003C/td>\n\u003Ctd>Pedile a un administrador que lo active en \u003Ca href=\"/user-guide/permisos-por-rol\">Permisos por Rol\u003C/a>.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>No aparece el proveedor en la lista\u003C/strong>\u003C/td>\n\u003Ctd>Está escrito distinto o no existe.\u003C/td>\n\u003Ctd>Escribí menos letras o el CUIT. Si no existe, se crea al guardar.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>No puedo guardar\u003C/strong>\u003C/td>\n\u003Ctd>Falta la \u003Cstrong>Fecha de la factura\u003C/strong>.\u003C/td>\n\u003Ctd>Elegí la fecha y tocá \u003Cstrong>Guardar borrador\u003C/strong> otra vez.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>Se guardó pero no sé si está paga\u003C/strong>\u003C/td>\n\u003Ctd>Se usó \u003Cstrong>Guardar borrador\u003C/strong>: queda sin pagar.\u003C/td>\n\u003Ctd>Mirá la columna \u003Cstrong>Falta pagar\u003C/strong> en \u003Ca href=\"/user-guide/historial-de-facturas\">Historial de Facturas\u003C/a>.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>Me equivoqué en un dato\u003C/strong>\u003C/td>\n\u003Ctd>Se guardó con un error.\u003C/td>\n\u003Ctd>Abrí la factura con \u003Cstrong>Editar\u003C/strong> en el \u003Ca href=\"/user-guide/historial-de-facturas\">Historial de Facturas\u003C/a> y corregila.\u003C/td>\n\u003C/tr>\n\u003C/tbody>\u003C/table>\u003C/div>\n",[5,9,12,15,18,21,24,27],{"id":6,"title":7,"level":8},"antes-de-empezar","Antes de empezar",2,{"id":10,"title":11,"level":8},"paso-1-entra-a-la-pantalla","Paso 1: Entrá a la pantalla",{"id":13,"title":14,"level":8},"paso-2-adjunta-la-imagen-si-queres","Paso 2: Adjuntá la imagen (si querés)",{"id":16,"title":17,"level":8},"paso-3-completa-los-datos-de-la-factura","Paso 3: Completá los datos de la factura",{"id":19,"title":20,"level":8},"paso-4-revisa-los-impuestos","Paso 4: Revisá los impuestos",{"id":22,"title":23,"level":8},"paso-5-escribi-el-total-y-guarda","Paso 5: Escribí el total y guardá",{"id":25,"title":26,"level":8},"paso-6-carga-los-items-opcional","Paso 6: Cargá los ítems (opcional)",{"id":28,"title":29,"level":8},"resolucion-de-inconvenientes","Resolución de Inconvenientes",{"title":31,"description":32,"keywords":33},"Factura Manual - Manual","¿Dónde está en el sistema?: Menú principal → Finanzas → Facturas y Pagos → Factura Manual\n ¿Quién lo usa?: Encargados de Cuentas a Pag...","factura manual, paxapos, factura manual, tutorial, guía, manual usuario","76-factura-manual.txt"],"uses":{"params":["slug"]}}]}
