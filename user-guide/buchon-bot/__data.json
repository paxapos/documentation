":178},"tablero-general","Tablero General",{"slug":180,"title":181},"productos-mas-vendidos","Productos Más Vendidos",{"slug":183,"title":184},"compras-por-mercaderia","Compras por Mercadería",{"title":186,"modules":187},"Configuracion",[188,191,194,197,200,203,206,209,212,215,218],{"slug":189,"title":190},"configuracion-general","Configuración general",{"slug":192,"title":193},"impresoras","Cómo cargar las impresoras del local",{"slug":195,"title":196},"perfiles-de-impresion","Cómo usar los perfiles de impresión",{"slug":198,"title":199},"usuarios-del-sistema","Cómo administrar los Usuarios del Sistema",{"slug":201,"title":202},"usuarios-con-pin","Cómo administrar los Usuarios con PIN",{"slug":204,"title":205},"punto-de-venta","🏛️ Trámite en ARCA (con clave fiscal)",{"slug":207,"title":208},"permisos-por-rol","Cómo configurar los Permisos por Rol",{"slug":210,"title":211},"turnos-mesa","Turnos de Mesa",{"slug":213,"title":214},"medios-de-cobro","Medios de cobro",{"slug":216,"title":217},"clasificacion-de-gastos","Clasificación de Gastos",{"slug":219,"title":220},"centros-de-costo","Centros de Costo",{"title":222,"modules":223},"Biblioteca de Drivers",[224,226,229,232,235,238,241,244,247],{"slug":225,"title":222},"biblioteca-de-drivers",{"slug":227,"title":228},"sam4s-giant-100","Sam4S Giant - 100",{"slug":230,"title":231},"citizen-ct-s310ii","Citizen CT-S310II",{"slug":233,"title":234},"epson-tm-t20","Epson TM-T20",{"slug":236,"title":237},"drivers-genericos","Drivers Genéricos POS",{"slug":239,"title":240},"epson-tm-t88","Epson TM-T88V",{"slug":242,"title":243},"fiscalberry-windows","Instalar Fiscalberry en Windows",{"slug":245,"title":246},"fiscalberry-linux","Instalar Fiscalberry en Linux",{"slug":248,"title":249},"fiscalberry-android","Instalar Fiscalberry en Android",{"title":251,"modules":252},"Extra",[253,256,259,262,265,268,271,274,277,280],{"slug":254,"title":255},"01-faq-solucion-inicial-pantalla-congelada","📖 Manual de Usuario: Solución Inicial si la Pantalla se Congela o no Carga",{"slug":257,"title":258},"03-faq-mozo-reabrir-mesa-anulada","📖 Manual de Usuario: Cómo Reabrir una Mesa Anulada o Cerrada por Error",{"slug":260,"title":261},"05-faq-cajero-emitir-factura-a","📖 Manual de Usuario: Cómo Emitir una Factura A Cargando Datos del Cliente",{"slug":263,"title":264},"06-faq-cajero-ingreso-egreso-cajon","📖 Manual de Usuario: Cómo Registrar Entradas y Salidas de Dinero del Cajón",{"slug":266,"title":267},"07-faq-cajero-activar-medio-pago","📖 Manual de Usuario: Cómo Activar un Medio de Pago que no Aparece al Cobrar",{"slug":269,"title":270},"08-faq-cajero-diferencia-facturado-vs-abiertas","📖 Manual de Usuario: Diferencia entre \"Facturado Total Mesas\" y \"Abiertas Por Usuario\" en Caja",{"slug":272,"title":273},"10-faq-supervisor-cierre-caja-diferencias","📖 Manual de Usuario: Cómo Auditar y Solucionar Diferencias en el Cierre de Caja",{"slug":275,"title":276},"preguntas-frecuentes","Preguntas Frecuentes y Guías Rápidas por Rol",{"slug":278,"title":279},"buchon-bot","Buchón Bot",{"slug":281,"title":282},"troubleshooting-semantico","📖 Guía Única de Resolución de Problemas y Errores (Troubleshooting)"],"uses":{}},{"type":"data","data":[{"slug":1,"title":2,"content":3,"tableOfContents":4,"seo":46,"llmTxtFile":50},"buchon-bot","Buchón Bot","\u003Cdiv id=\"buchon-bot\">\u003C/div>\n\n\u003Cblockquote>\n\u003Cp>\u003Cstrong>¿Dónde está en el sistema?:\u003C/strong> Menú principal → \u003Cstrong>Configuración\u003C/strong> → \u003Cstrong>Sistema\u003C/strong> → \u003Cstrong>Inteligencia Artificial\u003C/strong> (solapa \u003Cstrong>Buchón Bot\u003C/strong>)\u003Cbr>\u003Cstrong>¿Quién lo usa?:\u003C/strong> Propietario / Administrador del Comercio\u003C/p>\n\u003C/blockquote>\n\u003Cblockquote>\n\u003Cp>🎯 \u003Cstrong>¿Para qué sirve esto?\u003C/strong>\u003Cbr>Es tu &quot;espía digital&quot; que te avisa por Telegram cuando pasa algo raro en tu negocio. Desde que se acaba el stock hasta si alguien hace movimientos sospechosos. ¡Tus ojos cuando no estás!\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                ⚠️ \u003Cstrong>IMPORTANTE: Solo para el dueño\u003C/strong>\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"importante-solo-para-el-dueno\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"importante-solo-para-el-dueno\">\u003C/div>\n\n\u003Cp>Este módulo es \u003Cstrong>exclusivo del propietario\u003C/strong>. Los empleados NO pueden acceder a esta función.\u003C/p>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                📱 \u003Cstrong>¿Cómo funciona?\u003C/strong>\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"como-funciona\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"como-funciona\">\u003C/div>\n\n\u003Cpre>\u003Ccode>🚨 Pasa algo raro en el sistema\n   ↓\n🤖 Buchón Bot lo detecta automáticamente\n   ↓\n📲 Te llega mensaje a Telegram al toque\n   ↓\n🏃‍♂️ Podés actuar rápido\n\u003C/code>\u003C/pre>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🔍 \u003Cstrong>¿Qué tipo de cosas te avisa?\u003C/strong>\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"que-tipo-de-cosas-te-avisa\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"que-tipo-de-cosas-te-avisa\">\u003C/div>\n\n\u003Ch3 class=\"relative\">\n                \u003Cstrong>📦 Alertas de Stock:\u003C/strong>\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"alertas-de-stock\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h3>\n            \u003Cdiv id=\"alertas-de-stock\">\u003C/div>\n\n\u003Cp>\u003Cstrong>📋 Situaciones que detecta:\u003C/strong>\u003C/p>\n\u003Cp>\u003Cstrong>🔹 Stock crítico\u003C/strong>\u003Cbr>📨 \u003Cem>Ejemplo de mensaje:\u003C/em> &quot;⚠️ Quedan solo 2 Coca-Colas&quot;\u003Cbr>💡 \u003Cem>Por qué es importante:\u003C/em> Para comprar antes de quedarte sin nada\u003C/p>\n\u003Cp>\u003Cstrong>🔹 Stock agotado\u003C/strong>\u003Cbr>📨 \u003Cem>Ejemplo de mensaje:\u003C/em> &quot;🚨 Se acabó el Asado!&quot;\u003Cbr>💡 \u003Cem>Por qué es importante:\u003C/em> Para avisar a los mozos que no lo ofrezcan\u003C/p>\n\u003Cp>\u003Cstrong>🔹 Movimiento raro\u003C/strong>\u003Cbr>📨 \u003Cem>Ejemplo de mensaje:\u003C/em> &quot;👀 Se descontaron 50 empanadas sin venta&quot;\u003Cbr>💡 \u003Cem>Por qué es importante:\u003C/em> Posible error o irregularidad\u003C/p>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                ⚙️ \u003Cstrong>¿Cómo configurarlo?\u003C/strong>\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"como-configurarlo\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"como-configurarlo\">\u003C/div>\n\n\u003Ch3 class=\"relative\">\n                \u003Cstrong>📲 Paso 1: Conectar Telegram\u003C/strong>\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-1-conectar-telegram\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h3>\n            \u003Cdiv id=\"paso-1-conectar-telegram\">\u003C/div>\n\n\u003Col>\n\u003Cli>\u003Cstrong>Abrir Telegram\u003C/strong> en tu celular\u003C/li>\n\u003Cli>\u003Cstrong>Buscar el bot\u003C/strong> de PaxaPOS (te lo da soporte técnico)\u003C/li>\n\u003Cli>\u003Cstrong>Escribir /start\u003C/strong> para activarlo\u003C/li>\n\u003Cli>\u003Cstrong>Copiar tu Chat ID\u003C/strong> (aparece automáticamente)\u003C/li>\n\u003C/ol>\n\u003Ch3 class=\"relative\">\n                \u003Cstrong>🔧 Paso 2: Configurar alertas\u003C/strong>\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-2-configurar-alertas\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h3>\n            \u003Cdiv id=\"paso-2-configurar-alertas\">\u003C/div>\n\n\u003Col>\n\u003Cli>\u003Cstrong>Entrá al sistema\u003C/strong> con tu usuario de propietario.\u003C/li>\n\u003Cli>\u003Cstrong>Dirigite a:\u003C/strong> Menú principal → \u003Cstrong>Configuración\u003C/strong> → \u003Cstrong>Sistema\u003C/strong> → \u003Cstrong>Inteligencia Artificial\u003C/strong> (solapa \u003Cstrong>Buchón Bot\u003C/strong>) o \u003Cstrong>Configuración\u003C/strong> → \u003Cstrong>Buchón Bot\u003C/strong>.\u003C/li>\n\u003Cli>\u003Cstrong>Pegar tu Chat ID\u003C/strong> de Telegram.\u003C/li>\n\u003Cli>\u003Cstrong>Elegir qué alertas querés:\u003C/strong>\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cstrong>⚙️ Tipos de alertas recomendadas:\u003C/strong>\u003C/p>\n\u003Cp>\u003Cstrong>🔹 Stock bajo\u003C/strong>\u003Cbr>💡 \u003Cem>Recomendación:\u003C/em> ✅ Activar\u003Cbr>❓ \u003Cem>Por qué:\u003C/em> Evitás quedarte sin productos\u003C/p>\n\u003Cp>\u003Cstrong>🔹 Ventas grandes\u003C/strong>\u003Cbr>💡 \u003Cem>Recomendación:\u003C/em> ✅ Activar\u003Cbr>❓ \u003Cem>Por qué:\u003C/em> Control de caja\u003C/p>\n\u003Cp>\u003Cstrong>🔹 Anulaciones\u003C/strong>\u003Cbr>💡 \u003Cem>Recomendación:\u003C/em> ✅ Activar\u003Cbr>❓ \u003Cem>Por qué:\u003C/em> Detectar irregularidades\u003C/p>\n\u003Cp>\u003Cstrong>🔹 Accesos fuera de hora\u003C/strong>\u003Cbr>💡 \u003Cem>Recomendación:\u003C/em> ⚠️ Opcional\u003Cbr>❓ \u003Cem>Por qué:\u003C/em> Si tenés personal de confianza\u003C/p>\n\u003Ch3 class=\"relative\">\n                \u003Cstrong>🎯 Paso 3: Ajustar umbrales\u003C/strong>\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-3-ajustar-umbrales\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h3>\n            \u003Cdiv id=\"paso-3-ajustar-umbrales\">\u003C/div>\n\n\u003Cp>\u003Cstrong>⚙️ Configuraciones importantes:\u003C/strong>\u003C/p>\n\u003Cp>\u003Cstrong>🔹 Stock mínimo\u003C/strong>\u003Cbr>📝 \u003Cem>Qué significa:\u003C/em> Cuando avisar que se acaba\u003Cbr>📋 \u003Cem>Ejemplo:\u003C/em> 5 unidades\u003C/p>\n\u003Cp>\u003Cstrong>🔹 Descuento máximo\u003C/strong>\u003Cbr>📝 \u003Cem>Qué significa:\u003C/em> % máximo sin alerta\u003Cbr>📋 \u003Cem>Ejemplo:\u003C/em> 50%\u003C/p>\n\u003Cp>\u003Cstrong>🔹 Horario permitido\u003C/strong>\u003Cbr>📝 \u003Cem>Qué significa:\u003C/em> Cuándo puede haber movimiento\u003Cbr>📋 \u003Cem>Ejemplo:\u003C/em> 8 AM a 12 AM\u003C/p>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                💡 \u003Cstrong>Casos de uso prácticos\u003C/strong>\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"casos-de-uso-practicos\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"casos-de-uso-practicos\">\u003C/div>\n\n\u003Ch3 class=\"relative\">\n                \u003Cstrong>🏪 Para un restaurante:\u003C/strong>\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"para-un-restaurante\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h3>\n            \u003Cdiv id=\"para-un-restaurante\">\u003C/div>\n\n\u003Cpre>\u003Ccode>📲 &quot;⚠️ Quedan 3 milanesas - Stock crítico&quot;\n→ Llamás al proveedor para pedir más\n\u003C/code>\u003C/pre>\n\u003Ch3 class=\"relative\">\n                \u003Cstrong>🍕 Para una pizzería:\u003C/strong>\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"para-una-pizzeria\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h3>\n            \u003Cdiv id=\"para-una-pizzeria\">\u003C/div>\n\n\u003Cpre>\u003Ccode>📲 &quot;🍅 Se acabó salsa de tomate!&quot;\n→ Parás la venta de pizzas hasta reponer\n\u003C/code>\u003C/pre>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🚨 \u003Cstrong>¿Problemas comunes?\u003C/strong>\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-