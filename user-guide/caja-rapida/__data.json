{"type":"data","nodes":[null,{"type":"data","data":[{"moduleCategories":1},[2,17,44,53,77,98,110,140,146,173,185,221,250],{"title":3,"modules":4},"Comenzamos",[5,8,11,14],{"slug":6,"title":7},"introduccion","Bienvenido a tu software gastronómico",{"slug":9,"title":10},"iniciar-sesion","Cómo Iniciar Sesión",{"slug":12,"title":13},"recuperar-contrasena","Cómo Recuperar tu Contraseña",{"slug":15,"title":16},"guia-de-inicio-rapido","Guía de Inicio Rápido",{"title":18,"modules":19},"Ventas",[20,23,26,29,32,35,38,41],{"slug":21,"title":22},"salon-de-ventas","Cómo Usar el Salón de Ventas (Adición)",{"slug":24,"title":25},"caja-rapida","Cómo Usar la Caja Rápida (Registradora)",{"slug":27,"title":28},"mozos","Cómo Cargar los Mozos",{"slug":30,"title":31},"clientes","Cómo Gestionar los Clientes",{"slug":33,"title":34},"descuentos","Cómo Configurar Descuentos",{"slug":36,"title":37},"nueva-reserva","Cómo Cargar una Nueva Reserva",{"slug":39,"title":40},"listado-de-reservas","Cómo Usar el Listado de Reservas",{"slug":42,"title":43},"grilla-de-reservas","Cómo Usar la Grilla de Reservas",{"title":45,"modules":46},"Medios de Pago",[47,50],{"slug":48,"title":49},"configuracion-procesadores","Configuración de Procesadores de Pago",{"slug":51,"title":52},"transacciones-mercadopago","Transacciones MercadoPago",{"title":54,"modules":55},"Productos",[56,59,62,65,68,71,74],{"slug":57,"title":58},"menu","Menú de Productos (Carta)",{"slug":60,"title":61},"categorias","Categorías de Productos",{"slug":63,"title":64},"variantes-grupo-sabores","Variantes y Grupos de Sabores",{"slug":66,"title":67},"maestro-de-productos","Maestro de Productos",{"slug":69,"title":70},"subproductos-elaborados","Sub-Productos (Elaborados)",{"slug":72,"title":73},"recetas","Recetas",{"slug":75,"title":76},"analisis-duplicados","Buscar Duplicados",{"title":78,"modules":79},"Compras",[80,83,86,89,92,95],{"slug":81,"title":82},"todas-las-ordenes-compra","Órdenes de Compra",{"slug":84,"title":85},"crear-orden-compra","Crear una Orden de Compra",{"slug":87,"title":88},"ordenes-a-aprobar","Órdenes a aprobar",{"slug":90,"title":91},"mercaderias","Mercaderías",{"slug":93,"title":94},"proveedores","Proveedores",{"slug":96,"title":97},"historial-de-compras","Historial de Compras",{"title":99,"modules":100},"Stock",[101,104,107],{"slug":102,"title":103},"stock-mercaderias","Stock de Mercaderías",{"slug":105,"title":106},"stock-subproductos","Stock de Subproductos",{"slug":108,"title":109},"movimientos-de-stock","Movimientos de Stock",{"title":111,"modules":112},"Finanzas",[113,116,119,122,125,128,131,134,137],{"slug":114,"title":115},"arqueos-de-caja","Arqueos de Caja",{"slug":117,"title":118},"listado-de-cajas","Listado de Cajas",{"slug":120,"title":121},"transacciones-de-cobro","Transacciones de Cobro",{"slug":123,"title":124},"factura-manual","Factura Manual",{"slug":126,"title":127},"resumen-de-deuda","Resumen de Deuda",{"slug":129,"title":130},"pagos","Pagos",{"slug":132,"title":133},"historial-de-facturas","Historial de Facturas",{"slug":135,"title":136},"historico-de-mesas","Histórico de Mesas",{"slug":138,"title":139},"puntos-de-venta-pdv","Puntos de Venta (PDVs)",{"title":141,"modules":142},"Comandero",[143],{"slug":144,"title":145},"comandero","Comandero (pantalla de cocina)",{"title":147,"modules":148},"RRHH",[149,152,155,158,161,164,167,170],{"slug":150,"title":151},"empleados","Empleados",{"slug":153,"title":154},"empleados-trabajando","Empleados Trabajando",{"slug":156,"title":157},"registro-diario-fichaje","Registro Diario de Fichaje",{"slug":159,"title":160},"reporte-mensual-fichaje","Reporte Mensual de Fichaje",{"slug":162,"title":163},"departamentos","Departamentos",{"slug":165,"title":166},"turnos-y-horarios-fichaje","Turnos y Horarios de Fichaje",{"slug":168,"title":169},"sueldos-y-jornales","Sueldos y Jornales",{"slug":171,"title":172},"datos-de-acceso-app","Datos de Acceso a la App de Fichaje",{"title":174,"modules":175},"Reportes",[176,179,182],{"slug":177,"title":178},"tablero-general","Tablero General",{"slug":180,"title":181},"productos-mas-vendidos","Productos Más Vendidos",{"slug":183,"title":184},"compras-por-mercaderia","Compras por Mercadería",{"title":186,"modules":187},"Configuracion",[188,191,194,197,200,203,206,209,212,215,218],{"slug":189,"title":190},"configuracion-general","Configuración general",{"slug":192,"title":193},"impresoras","Cómo cargar las impresoras del local",{"slug":195,"title":196},"perfiles-de-impresion","Cómo usar los perfiles de impresión",{"slug":198,"title":199},"usuarios-del-sistema","Cómo administrar los Usuarios del Sistema",{"slug":201,"title":202},"usuarios-con-pin","Cómo administrar los Usuarios con PIN",{"slug":204,"title":205},"punto-de-venta","🏛️ Trámite en ARCA (con clave fiscal)",{"slug":207,"title":208},"permisos-por-rol","Cómo configurar los Permisos por Rol",{"slug":210,"title":211},"turnos-mesa","Turnos de Mesa",{"slug":213,"title":214},"medios-de-cobro","Medios de cobro",{"slug":216,"title":217},"clasificacion-de-gastos","Clasificación de Gastos",{"slug":219,"title":220},"centros-de-costo","Centros de Costo",{"title":222,"modules":223},"Biblioteca de Drivers",[224,226,229,232,235,238,241,244,247],{"slug":225,"title":222},"biblioteca-de-drivers",{"slug":227,"title":228},"sam4s-giant-100","Sam4S Giant - 100",{"slug":230,"title":231},"citizen-ct-s310ii","Citizen CT-S310II",{"slug":233,"title":234},"epson-tm-t20","Epson TM-T20",{"slug":236,"title":237},"drivers-genericos","Drivers Genéricos POS",{"slug":239,"title":240},"epson-tm-t88","Epson TM-T88V",{"slug":242,"title":243},"fiscalberry-windows","Instalar Fiscalberry en Windows",{"slug":245,"title":246},"fiscalberry-linux","Instalar Fiscalberry en Linux",{"slug":248,"title":249},"fiscalberry-android","Instalar Fiscalberry en Android",{"title":251,"modules":252},"Extra",[253,256,259,262,265,268,271,274,277,280],{"slug":254,"title":255},"01-faq-solucion-inicial-pantalla-congelada","📖 Manual de Usuario: Solución Inicial si la Pantalla se Congela o no Carga",{"slug":257,"title":258},"03-faq-mozo-reabrir-mesa-anulada","📖 Manual de Usuario: Cómo Reabrir una Mesa Anulada o Cerrada por Error",{"slug":260,"title":261},"05-faq-cajero-emitir-factura-a","📖 Manual de Usuario: Cómo Emitir una Factura A Cargando Datos del Cliente",{"slug":263,"title":264},"06-faq-cajero-ingreso-egreso-cajon","📖 Manual de Usuario: Cómo Registrar Entradas y Salidas de Dinero del Cajón",{"slug":266,"title":267},"07-faq-cajero-activar-medio-pago","📖 Manual de Usuario: Cómo Activar un Medio de Pago que no Aparece al Cobrar",{"slug":269,"title":270},"08-faq-cajero-diferencia-facturado-vs-abiertas","📖 Manual de Usuario: Diferencia entre \"Facturado Total Mesas\" y \"Abiertas Por Usuario\" en Caja",{"slug":272,"title":273},"10-faq-supervisor-cierre-caja-diferencias","📖 Manual de Usuario: Cómo Auditar y Solucionar Diferencias en el Cierre de Caja",{"slug":275,"title":276},"preguntas-frecuentes","Preguntas Frecuentes y Guías Rápidas por Rol",{"slug":278,"title":279},"buchon-bot","Buchón Bot",{"slug":281,"title":282},"troubleshooting-semantico","📖 Guía Única de Resolución de Problemas y Errores (Troubleshooting)"],"uses":{}},{"type":"data","data":[{"slug":1,"title":2,"content":3,"tableOfContents":4,"seo":27,"llmTxtFile":31},"caja-rapida","Cómo Usar la Caja Rápida (Registradora)","\u003Cdiv id=\"caja-rapida-registradora\">\u003C/div>\n\n\u003Cblockquote>\n\u003Cp>\u003Cstrong>¿Dónde está en el sistema?:\u003C/strong> Menú principal → \u003Cstrong>Ventas\u003C/strong> → \u003Cstrong>Caja Rápida\u003C/strong>\u003Cbr>\u003Cstrong>¿Quién lo usa?:\u003C/strong> Cajeros y personal de mostrador\u003C/p>\n\u003C/blockquote>\n\u003Cblockquote>\n\u003Cp>🎯 \u003Cstrong>¿Para qué sirve esto?\u003C/strong>\nLa Caja Rápida funciona como una registradora. Sirve para vender en el mostrador sin abrir una mesa. Es ideal para take-away, kioscos o cafeterías de paso.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                📍 \u003Cstrong>Paso 1: Entrá a la Caja Rápida\u003C/strong>\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-1-entra-a-la-caja-rapida\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-1-entra-a-la-caja-rapida\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/22-00a-menu-grupo-ventas.png\" alt=\"Grupo Ventas del menú lateral, marcado en rojo\">\u003C/p>\n\u003Col>\n\u003Cli>En el menú de la izquierda, tocá \u003Cstrong>Ventas\u003C/strong>. Se despliegan sus opciones.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/22-00b-menu-opcion-registradora.png\" alt=\"Opción Caja Rápida dentro del grupo Ventas, marcada en rojo\">\u003C/p>\n\u003Col start=\"2\">\n\u003Cli>Tocá \u003Cstrong>Caja Rápida\u003C/strong>.\u003C/li>\n\u003Cli>Se abre la pantalla de la registradora.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/05-registradora-inicio.png\" alt=\"Pantalla de la Caja Rápida con los productos a la izquierda y el total a la derecha\">\u003C/p>\n\u003Cp>En esta pantalla vas a ver:\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Arriba:\u003C/strong> el menú de precios que se usa (por ejemplo, \u003Cem>Menú #Catálogo\u003C/em>) y el mozo.\u003C/li>\n\u003Cli>\u003Cstrong>Arriba a la derecha:\u003C/strong> los botones de la caja y el botón \u003Cstrong>Ayuda (H)\u003C/strong>.\u003C/li>\n\u003Cli>\u003Cstrong>A la izquierda:\u003C/strong> los productos para vender.\u003C/li>\n\u003Cli>\u003Cstrong>A la derecha:\u003C/strong> el total a pagar y la lista de lo que vas cargando.\u003C/li>\n\u003Cli>\u003Cstrong>Abajo:\u003C/strong> el botón verde \u003Cstrong>COBRAR\u003C/strong>.\u003C/li>\n\u003C/ul>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                💰 \u003Cstrong>Paso 2: Abrí la caja antes de vender\u003C/strong>\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-2-abri-la-caja-antes-de-vender\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-2-abri-la-caja-antes-de-vender\">\u003C/div>\n\n\u003Cblockquote>\n\u003Cp>⚠️ \u003Cstrong>Atención:\u003C/strong> Si la caja está cerrada, la pantalla \u003Cstrong>no muestra ningún producto\u003C/strong>. Primero abrí la caja.\u003C/p>\n\u003C/blockquote>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/33-registradora-boton-abrir-caja.png\" alt=\"Botón Abrir Caja en la parte de arriba de la registradora\">\u003C/p>\n\u003Col>\n\u003Cli>Arriba a la derecha, tocá el botón \u003Cstrong>Abrir Caja\u003C/strong>.\u003C/li>\n\u003Cli>Se abre una ventanita para abrir la caja.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/34-registradora-dialogo-abrir-caja.png\" alt=\"Ventanita Nuevo Arqueo con la caja y el importe inicial\">\u003C/p>\n\u003Col start=\"3\">\n\u003Cli>\u003Cp>En \u003Cstrong>Caja\u003C/strong>, elegí la caja que vas a usar.\u003C/p>\n\u003C/li>\n\u003Cli>\u003Cp>En \u003Cstrong>Importe inicial\u003C/strong>, escribí la plata que hay en el cajón al empezar. Por ejemplo: \u003Cem>$ 20.000\u003C/em>.\u003C/p>\n\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/22-72-donde-esta-boton-abrir-arqueo.png\" alt=\"Pantalla Nuevo Arqueo con el botón Abrir Arqueo marcado en rojo\">\u003C/p>\n\u003Col start=\"5\">\n\u003Cli>Tocá el botón azul \u003Cstrong>Abrir Arqueo\u003C/strong>.\u003C/li>\n\u003Cli>La caja queda abierta y aparecen los productos.\u003C/li>\n\u003C/ol>\n\u003Cblockquote>\n\u003Cp>💡 \u003Cstrong>Consejo útil:\u003C/strong> La caja queda abierta hasta que la cierres. No hace falta abrirla en cada venta.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🧰 \u003Cstrong>Botones de la caja (arriba a la derecha)\u003C/strong>\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"botones-de-la-caja\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"botones-de-la-caja\">\u003C/div>\n\n\u003Cp>Con la caja abierta, arriba a la derecha vas a ver estos botones:\u003C/p>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/22-12-donde-esta-boton-cerrar-caja-s.png\" alt=\"Registradora con el botón Cerrar Caja marcado en rojo\">\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Cerrar Caja:\u003C/strong> se usa al terminar el turno, para contar la plata y cerrar la caja.\u003C/li>\n\u003C/ul>\n\u003Cblockquote>\n\u003Cp>⚠️ \u003Cstrong>Atención:\u003C/strong> Cerrar la caja termina el turno. Después no vas a poder vender hasta abrirla de nuevo.\u003C/p>\n\u003C/blockquote>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/22-14-donde-esta-boton-retiro.png\" alt=\"Registradora con el botón Retiro marcado en rojo\">\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Retiro:\u003C/strong> anotá cuando sacás plata del cajón. Por ejemplo, para pagarle a un proveedor.\u003C/li>\n\u003C/ul>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/22-16-donde-esta-boton-ingreso.png\" alt=\"Registradora con el botón Ingreso marcado en rojo\">\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Ingreso:\u003C/strong> anotá cuando ponés plata en el cajón. Por ejemplo, cambio extra.\u003C/li>\n\u003C/ul>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/22-18-donde-esta-boton-ayuda-h.png\" alt=\"Registradora con el botón Ayuda marcado en rojo\">\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Ayuda (H):\u003C/strong> abre una guía rápida de la pantalla y los atajos de teclado. También se abre con la tecla \u003Cstrong>H\u003C/strong>.\u003C/li>\n\u003C/ul>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🛒 \u003Cstrong>Paso 3: Cargá los productos de la venta\u003C/strong>\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-3-carga-los-productos-de-la-venta\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-3-carga-los-productos-de-la-venta\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/22-20-campo-buscar-producto.png\" alt=\"Casillero Buscar producto arriba de la lista de productos\">\u003C/p>\n\u003Col>\n\u003Cli>Si tenés muchos productos, escribí el nombre en \u003Cstrong>Buscar producto...\u003C/strong>. La lista se achica mientras escribís.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/22-21-donde-esta-boton-producto.png\" alt=\"Registradora con el producto Café marcado en rojo\">\u003C/p>\n\u003Col start=\"2\">\n\u003Cli>Tocá el producto. Por ejemplo, \u003Cstrong>Café\u003C/strong>.\u003C/li>\n\u003Cli>En el medio aparece un teclado con números.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/22-74-teclado-importe.png\" alt=\"Teclado numérico con el importe del Café escrito\">\u003C/p>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/22-25-campo-0-00.png\" alt=\"Recuadro Importe con el precio escrito\">\u003C/p>\n\u003Col start=\"4\">\n\u003Cli>Escribí el importe con los números del teclado. Por ejemplo: \u003Cstrong>1\u003C/strong>, \u003Cstrong>2\u003C/strong>, \u003Cstrong>0\u003C/strong>, \u003Cstrong>0\u003C/strong> para \u003Cem>$ 1.200\u003C/em>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/22-48-donde-esta-boton-borrar-ultimo.png\" alt=\"Teclado con el botón de la flecha marcado en rojo\">\u003C/p>\n\u003Cul>\n\u003Cli>Si te equivocaste en un número, tocá la \u003Cstrong>flecha ←\u003C/strong>. Borra el último número.\u003C/li>\n\u003C/ul>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/22-50-donde-esta-boton-c.png\" alt=\"Teclado con el botón C marcado en rojo\">\u003C/p>\n\u003Cul>\n\u003Cli>Para empezar de nuevo, tocá \u003Cstrong>C\u003C/strong>. Borra todo el importe.\u003C/li>\n\u003C/ul>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/22-52-donde-esta-boton-agregar.png\" alt=\"Teclado con el botón Agregar marcado en rojo\">\u003C/p>\n\u003Col start=\"5\">\n\u003Cli>Tocá el botón verde \u003Cstrong>AGREGAR\u003C/strong>.\u003C/li>\n\u003Cli>El producto aparece en la lista de la derecha. El \u003Cstrong>Total a pagar\u003C/strong> se actualiza.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/29-registradora-carrito.png\" alt=\"Registradora con el Café en la lista y el total a pagar de $1200\">\u003C/p>\n\u003Col start=\"7\">\n\u003Cli>Repetí los pasos para cada producto de la venta.\u003C/li>\n\u003C/ol>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                ✏️ \u003Cstrong>Paso 4: Corregí la lista si te equivocaste\u003C/strong>\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-4-corregi-la-lista-si-te-equivocaste\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-4-corregi-la-lista-si-te-equivocaste\">\u003C/div>\n\n\n\u003Cul>\n\u003Cli>Para \u003Cstrong>quitar un producto\u003C/strong>, tocá la \u003Cstrong>✕\u003C/strong> gris a la izquierda (o cualquier parte de la fila, menos el precio).\u003C/li>\n\u003Cli>Aparece un aviso con \u003Cstrong>Deshacer\u003C/strong>. Tenés 5 segundos por si lo borraste sin querer.\u003C/li>\n\u003C/ul>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/22-77-precio-editable.png\" alt=\"Precio del producto con el lápiz para corregirlo\">\u003C/p>\n\u003Cul>\n\u003Cli>Para \u003Cstrong>cambiar el precio\u003C/strong>, tocá el precio (el que tiene el lápiz ✏️). Escribí el importe correcto.\u003C/li>\n\u003C/ul>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/22-54-donde-esta-boton-vaciar.png\" alt=\"Registradora con el botón Vaciar marcado en rojo\">\u003C/p>\n\u003Cul>\n\u003Cli>Para \u003Cstrong>borrar toda la lista\u003C/strong>, tocá \u003Cstrong>Vaciar\u003C/strong>. El sistema te pide que confirmes.\u003C/li>\n\u003C/ul>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                💵 \u003Cstrong>Paso 5: Cobrá la venta\u003C/strong>\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-5-cobra-la-venta\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-5-cobra-la-venta\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/22-61-donde-esta-boton-cobrar.png\" alt=\"Registradora con el botón Cobrar marcado en rojo abajo de todo\">\u003C/p>\n\u003Col>\n\u003Cli>Revisá el \u003Cstrong>Total a pagar\u003C/strong>.\u003C/li>\n\u003Cli>Tocá el botón verde \u003Cstrong>COBRAR\u003C/strong>, abajo de todo.\u003C/li>\n\u003Cli>Se abre la pantalla de cobro con los medios de pago.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/31-registradora-pantalla-pago.png\" alt=\"Pantalla de cobro con los medios de pago\">\u003C/p>\n\u003Cblockquote>\n\u003Cp>⚠️ \u003Cstrong>Atención:\u003C/strong> Tocar un medio de pago \u003Cstrong>cobra la venta en ese momento\u003C/strong>. No hay un paso para confirmar. Revisá la lista antes de tocarlo.\u003C/p>\n\u003C/blockquote>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/32-registradora-boton-medio-pago.png\" alt=\"Botón verde de un medio de pago\">\u003C/p>\n\u003Col start=\"4\">\n\u003Cli>Tocá el medio de pago que usa el cliente. Por ejemplo: \u003Cstrong>Efectivo\u003C/strong>, \u003Cstrong>Tarjeta Débito\u003C/strong> o \u003Cstrong>Mercado Pago\u003C/strong>.\u003C/li>\n\u003Cli>La venta queda cobrada. Si hay impresora, sale el ticket.\u003C/li>\n\u003Cli>La lista queda vacía, lista para la próxima venta.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/22-59-donde-esta-boton-mas-medios-de-pago.png\" alt=\"Pantalla de cobro con el botón Más medios de pago marcado en rojo\">\u003C/p>\n\u003Cul>\n\u003Cli>Si no ves el medio de pago, tocá \u003Cstrong>Más medios de pago\u003C/strong>. Aparecen los demás.\u003C/li>\n\u003C/ul>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/22-76-pantalla-mas-medios-de-pago.png\" alt=\"Pantalla de cobro con todos los medios de pago a la vista\">\u003C/p>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/22-56-donde-esta-boton-volver.png\" alt=\"Pantalla de cobro con el botón Volver marcado en rojo\">\u003C/p>\n\u003Cul>\n\u003Cli>Si todavía no querés cobrar, tocá \u003Cstrong>← Volver\u003C/strong>. Volvés a la lista sin cobrar nada.\u003C/li>\n\u003C/ul>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                ⚠️ \u003Cstrong>Resolución de Inconvenientes\u003C/strong>\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"resolucion-de-inconvenientes\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"resolucion-de-inconvenientes\">\u003C/div>\n\n\u003Cdiv class=\"table-wrapper\">\u003Ctable>\n\u003Cthead>\n\u003Ctr>\n\u003Cth>Problema\u003C/th>\n\u003Cth>Causa más frecuente\u003C/th>\n\u003Cth>Solución recomendada\u003C/th>\n\u003C/tr>\n\u003C/thead>\n\u003Ctbody>\u003Ctr>\n\u003Ctd>\u003Cstrong>No aparecen productos en la pantalla\u003C/strong>\u003C/td>\n\u003Ctd>La caja está cerrada.\u003C/td>\n\u003Ctd>Abrí la caja (ver \u003Ca href=\"#paso-2-abri-la-caja-antes-de-vender\">Paso 2\u003C/a>).\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>Sigue sin haber productos con la caja abierta\u003C/strong>\u003C/td>\n\u003Ctd>El menú no tiene productos sueltos, o están todos dentro de categorías.\u003C/td>\n\u003Ctd>Pedile al encargado que revise el menú en \u003Cstrong>Productos → Menú\u003C/strong>.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>El botón Cobrar está gris\u003C/strong>\u003C/td>\n\u003Ctd>No agregaste ningún producto a la lista.\u003C/td>\n\u003Ctd>Agregá al menos un producto antes de cobrar.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>El ticket no se imprime\u003C/strong>\u003C/td>\n\u003Ctd>La impresora está apagada, desconectada o sin papel.\u003C/td>\n\u003Ctd>Revisá la impresora y que Fiscalberry esté abierto (ver \u003Ca href=\"/user-guide/impresoras\">Gestión de Impresoras\u003C/a>).\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>Te equivocaste de producto\u003C/strong>\u003C/td>\n\u003Ctd>Tocaste otro producto.\u003C/td>\n\u003Ctd>Tocá la \u003Cstrong>✕\u003C/strong> al lado del producto para quitarlo antes de cobrar. Si lo quitaste sin querer, tocá \u003Cstrong>Deshacer\u003C/strong>.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>Cobraste con el medio de pago equivocado\u003C/strong>\u003C/td>\n\u003Ctd>Tocaste otro medio de pago.\u003C/td>\n\u003Ctd>Avisale al encargado: se corrige desde \u003Cstrong>Finanzas\u003C/strong>.\u003C/td>\n\u003C/tr>\n\u003C/tbody>\u003C/table>\u003C/div>\n",[5,9,12,15,18,21,24],{"id":6,"title":7,"level":8},"paso-1-entra-a-la-caja-rapida","Paso 1: Entrá a la Caja Rápida",2,{"id":10,"title":11,"level":8},"paso-2-abri-la-caja-antes-de-vender","Paso 2: Abrí la caja antes de vender",{"id":13,"title":14,"level":8},"botones-de-la-caja","Botones de la caja (arriba a la derecha)",{"id":16,"title":17,"level":8},"paso-3-carga-los-productos-de-la-venta","Paso 3: Cargá los productos de la venta",{"id":19,"title":20,"level":8},"paso-4-corregi-la-lista-si-te-equivocaste","Paso 4: Corregí la lista si te equivocaste",{"id":22,"title":23,"level":8},"paso-5-cobra-la-venta","Paso 5: Cobrá la venta",{"id":25,"title":26,"level":8},"resolucion-de-inconvenientes","Resolución de Inconvenientes",{"title":28,"description":29,"keywords":30},"Cómo Usar la Caja Rápida (Registradora) - Manual","¿Dónde está en el sistema?: Menú principal → Ventas → Caja Rápida  \n ¿Quién lo usa?: Cajeros y personal de mostrador","caja rapida, paxapos, cómo usar la caja rápida (registradora), tutorial, guía, manual usuario","22-caja-rapida.txt"],"uses":{"params":["slug"]}}]}
