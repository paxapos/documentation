{"type":"data","nodes":[null,{"type":"data","data":[{"moduleCategories":1},[2,17,44,53,77,98,110,140,146,173,185,221,250],{"title":3,"modules":4},"Comenzamos",[5,8,11,14],{"slug":6,"title":7},"introduccion","Bienvenido a tu software gastronómico",{"slug":9,"title":10},"iniciar-sesion","Cómo Iniciar Sesión",{"slug":12,"title":13},"recuperar-contrasena","Cómo Recuperar tu Contraseña",{"slug":15,"title":16},"guia-de-inicio-rapido","Guía de Inicio Rápido",{"title":18,"modules":19},"Ventas",[20,23,26,29,32,35,38,41],{"slug":21,"title":22},"salon-de-ventas","Cómo Usar el Salón de Ventas (Adición)",{"slug":24,"title":25},"caja-rapida","Cómo Usar la Caja Rápida (Registradora)",{"slug":27,"title":28},"mozos","Cómo Cargar los Mozos",{"slug":30,"title":31},"clientes","Cómo Gestionar los Clientes",{"slug":33,"title":34},"descuentos","Cómo Configurar Descuentos",{"slug":36,"title":37},"nueva-reserva","Cómo Cargar una Nueva Reserva",{"slug":39,"title":40},"listado-de-reservas","Cómo Usar el Listado de Reservas",{"slug":42,"title":43},"grilla-de-reservas","Cómo Usar la Grilla de Reservas",{"title":45,"modules":46},"Medios de Pago",[47,50],{"slug":48,"title":49},"configuracion-procesadores","Configuración de Procesadores de Pago",{"slug":51,"title":52},"transacciones-mercadopago","Transacciones MercadoPago",{"title":54,"modules":55},"Productos",[56,59,62,65,68,71,74],{"slug":57,"title":58},"menu","Menú de Productos (Carta)",{"slug":60,"title":61},"categorias","Categorías de Productos",{"slug":63,"title":64},"variantes-grupo-sabores","Variantes y Grupos de Sabores",{"slug":66,"title":67},"maestro-de-productos","Maestro de Productos",{"slug":69,"title":70},"subproductos-elaborados","Sub-Productos (Elaborados)",{"slug":72,"title":73},"recetas","Recetas",{"slug":75,"title":76},"analisis-duplicados","Buscar Duplicados",{"title":78,"modules":79},"Compras",[80,83,86,89,92,95],{"slug":81,"title":82},"todas-las-ordenes-compra","Órdenes de Compra",{"slug":84,"title":85},"crear-orden-compra","Crear una Orden de Compra",{"slug":87,"title":88},"ordenes-a-aprobar","Órdenes a aprobar",{"slug":90,"title":91},"mercaderias","Mercaderías",{"slug":93,"title":94},"proveedores","Proveedores",{"slug":96,"title":97},"historial-de-compras","Historial de Compras",{"title":99,"modules":100},"Stock",[101,104,107],{"slug":102,"title":103},"stock-mercaderias","Stock de Mercaderías",{"slug":105,"title":106},"stock-subproductos","Stock de Subproductos",{"slug":108,"title":109},"movimientos-de-stock","Movimientos de Stock",{"title":111,"modules":112},"Finanzas",[113,116,119,122,125,128,131,134,137],{"slug":114,"title":115},"arqueos-de-caja","Arqueos de Caja",{"slug":117,"title":118},"listado-de-cajas","Listado de Cajas",{"slug":120,"title":121},"transacciones-de-cobro","Transacciones de Cobro",{"slug":123,"title":124},"factura-manual","Factura Manual",{"slug":126,"title":127},"resumen-de-deuda","Resumen de Deuda",{"slug":129,"title":130},"pagos","Pagos",{"slug":132,"title":133},"historial-de-facturas","Historial de Facturas",{"slug":135,"title":136},"historico-de-mesas","Histórico de Mesas",{"slug":138,"title":139},"puntos-de-venta-pdv","Puntos de Venta (PDVs)",{"title":141,"modules":142},"Comandero",[143],{"slug":144,"title":145},"comandero","Comandero (pantalla de cocina)",{"title":147,"modules":148},"RRHH",[149,152,155,158,161,164,167,170],{"slug":150,"title":151},"empleados","Empleados",{"slug":153,"title":154},"empleados-trabajando","Empleados Trabajando",{"slug":156,"title":157},"registro-diario-fichaje","Registro Diario de Fichaje",{"slug":159,"title":160},"reporte-mensual-fichaje","Reporte Mensual de Fichaje",{"slug":162,"title":163},"departamentos","Departamentos",{"slug":165,"title":166},"turnos-y-horarios-fichaje","Turnos y Horarios de Fichaje",{"slug":168,"title":169},"sueldos-y-jornales","Sueldos y Jornales",{"slug":171,"title":172},"datos-de-acceso-app","Datos de Acceso a la App de Fichaje",{"title":174,"modules":175},"Reportes",[176,179,182],{"slug":177,"title":178},"tablero-general","Tablero General",{"slug":180,"title":181},"productos-mas-vendidos","Productos Más Vendidos",{"slug":183,"title":184},"compras-por-mercaderia","Compras por Mercadería",{"title":186,"modules":187},"Configuracion",[188,191,194,197,200,203,206,209,212,215,218],{"slug":189,"title":190},"configuracion-general","Configuración general",{"slug":192,"title":193},"impresoras","Cómo cargar las impresoras del local",{"slug":195,"title":196},"perfiles-de-impresion","Cómo usar los perfiles de impresión",{"slug":198,"title":199},"usuarios-del-sistema","Cómo administrar los Usuarios del Sistema",{"slug":201,"title":202},"usuarios-con-pin","Cómo administrar los Usuarios con PIN",{"slug":204,"title":205},"punto-de-venta","🏛️ Trámite en ARCA (con clave fiscal)",{"slug":207,"title":208},"permisos-por-rol","Cómo configurar los Permisos por Rol",{"slug":210,"title":211},"turnos-mesa","Turnos de Mesa",{"slug":213,"title":214},"medios-de-cobro","Medios de cobro",{"slug":216,"title":217},"clasificacion-de-gastos","Clasificación de Gastos",{"slug":219,"title":220},"centros-de-costo","Centros de Costo",{"title":222,"modules":223},"Biblioteca de Drivers",[224,226,229,232,235,238,241,244,247],{"slug":225,"title":222},"biblioteca-de-drivers",{"slug":227,"title":228},"sam4s-giant-100","Sam4S Giant - 100",{"slug":230,"title":231},"citizen-ct-s310ii","Citizen CT-S310II",{"slug":233,"title":234},"epson-tm-t20","Epson TM-T20",{"slug":236,"title":237},"drivers-genericos","Drivers Genéricos POS",{"slug":239,"title":240},"epson-tm-t88","Epson TM-T88V",{"slug":242,"title":243},"fiscalberry-windows","Instalar Fiscalberry en Windows",{"slug":245,"title":246},"fiscalberry-linux","Instalar Fiscalberry en Linux",{"slug":248,"title":249},"fiscalberry-android","Instalar Fiscalberry en Android",{"title":251,"modules":252},"Extra",[253,256,259,262,265,268,271,274,277,280],{"slug":254,"title":255},"01-faq-solucion-inicial-pantalla-congelada","📖 Manual de Usuario: Solución Inicial si la Pantalla se Congela o no Carga",{"slug":257,"title":258},"03-faq-mozo-reabrir-mesa-anulada","📖 Manual de Usuario: Cómo Reabrir una Mesa Anulada o Cerrada por Error",{"slug":260,"title":261},"05-faq-cajero-emitir-factura-a","📖 Manual de Usuario: Cómo Emitir una Factura A Cargando Datos del Cliente",{"slug":263,"title":264},"06-faq-cajero-ingreso-egreso-cajon","📖 Manual de Usuario: Cómo Registrar Entradas y Salidas de Dinero del Cajón",{"slug":266,"title":267},"07-faq-cajero-activar-medio-pago","📖 Manual de Usuario: Cómo Activar un Medio de Pago que no Aparece al Cobrar",{"slug":269,"title":270},"08-faq-cajero-diferencia-facturado-vs-abiertas","📖 Manual de Usuario: Diferencia entre \"Facturado Total Mesas\" y \"Abiertas Por Usuario\" en Caja",{"slug":272,"title":273},"10-faq-supervisor-cierre-caja-diferencias","📖 Manual de Usuario: Cómo Auditar y Solucionar Diferencias en el Cierre de Caja",{"slug":275,"title":276},"preguntas-frecuentes","Preguntas Frecuentes y Guías Rápidas por Rol",{"slug":278,"title":279},"buchon-bot","Buchón Bot",{"slug":281,"title":282},"troubleshooting-semantico","📖 Guía Única de Resolución de Problemas y Errores (Troubleshooting)"],"uses":{}},{"type":"data","data":[{"slug":1,"title":2,"content":3,"tableOfContents":4,"seo":33,"llmTxtFile":37},"historial-de-facturas","Historial de Facturas","\u003Cdiv id=\"historial-de-facturas\">\u003C/div>\n\n\u003Cblockquote>\n\u003Cp>\u003Cstrong>¿Dónde está en el sistema?:\u003C/strong> Menú principal → \u003Cstrong>Finanzas\u003C/strong> → \u003Cstrong>Facturas y Pagos\u003C/strong> → \u003Cstrong>Historial de Facturas\u003C/strong>\n\u003Cstrong>¿Quién lo usa?:\u003C/strong> Contadores, Encargados de Cuentas a Pagar y Administradores\u003C/p>\n\u003C/blockquote>\n\u003Cblockquote>\n\u003Cp>🎯 \u003Cstrong>¿Para qué sirve esto?\u003C/strong>\nEs la lista de todas las facturas de tus proveedores, pagas y sin pagar.\nBuscás una factura, ves cuánto falta pagar, la corregís, la pagás o la cerrás.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🔑 Antes de empezar\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"antes-de-empezar\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"antes-de-empezar\">\u003C/div>\n\n\u003Cul>\n\u003Cli>Tu usuario tiene que tener el permiso \u003Cstrong>Contabilidad / Gastos\u003C/strong> en \u003Ca href=\"/user-guide/permisos-por-rol\">Permisos por Rol\u003C/a>.\u003C/li>\n\u003Cli>Las facturas llegan desde \u003Ca href=\"/user-guide/factura-manual\">Factura Manual\u003C/a> o desde \u003Cstrong>Nueva Factura\u003C/strong>.\u003C/li>\n\u003Cli>Para ver la deuda por proveedor, mirá \u003Ca href=\"/user-guide/resumen-de-deuda\">Resumen de Deuda\u003C/a>.\u003C/li>\n\u003C/ul>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                📍 Paso 1: Entrá a la pantalla\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-1-entra-a-la-pantalla\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-1-entra-a-la-pantalla\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/70-finanzas/79-00a-menu-grupo-finanzas.png\" alt=\"Menú lateral con el grupo Finanzas marcado en rojo\">\u003C/p>\n\u003Col>\n\u003Cli>En el menú de la izquierda, tocá \u003Cstrong>Finanzas\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/70-finanzas/79-00b-menu-opcion-historial-de-facturas.png\" alt=\"Opción Historial de Facturas marcada en rojo, debajo del título Facturas y Pagos\">\u003C/p>\n\u003Col start=\"2\">\n\u003Cli>Tocá \u003Cstrong>Historial de Facturas\u003C/strong>. Está debajo del título \u003Cstrong>FACTURAS Y PAGOS\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/70-finanzas/79-01-pantalla-historial-de-facturas.png\" alt=\"Pantalla Historial de Facturas con los botones de arriba, el buscador, el resumen y la lista\">\u003C/p>\n\u003Cp>Así se ve la pantalla. Arriba están los botones, después el buscador, el resumen de la búsqueda y la lista de facturas.\u003C/p>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🔘 Paso 2: Conocé los botones de arriba\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-2-conoce-los-botones-de-arriba\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-2-conoce-los-botones-de-arriba\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/70-finanzas/79-02-botones-de-arriba.png\" alt=\"Cinco botones juntos: Nueva Factura en verde, Factura Manual, Facturas directas, CAPEX y Exportar XLSX\">\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Nueva Factura\u003C/strong>: para subir la foto de una factura y cargar sus datos.\u003C/li>\n\u003Cli>\u003Cstrong>Factura Manual\u003C/strong>: abre \u003Ca href=\"/user-guide/factura-manual\">Factura Manual\u003C/a>, para escribir los datos a mano.\u003C/li>\n\u003Cli>\u003Cstrong>Facturas directas\u003C/strong>: deja solo las facturas sin orden de compra.\u003C/li>\n\u003Cli>\u003Cstrong>CAPEX\u003C/strong>: deja solo las facturas de inversión (bienes de uso). Aparece si tu comercio usa CAPEX/OPEX.\u003C/li>\n\u003Cli>\u003Cstrong>Exportar XLSX\u003C/strong>: baja la lista, con los filtros que hayas puesto, en una planilla de Excel.\u003C/li>\n\u003C/ul>\n\u003Cp>Si elegís \u003Cstrong>Facturas directas\u003C/strong> o \u003Cstrong>CAPEX\u003C/strong>, arriba de la lista aparece un aviso. Tocá \u003Cstrong>Quitar filtro\u003C/strong> para volver a ver todo.\u003C/p>\n\u003Cblockquote>\n\u003Cp>💡 \u003Cstrong>Consejo útil:\u003C/strong> si tu comercio tiene lectura con IA, aparece también un recuadro para arrastrar una factura y digitalizarla.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🔎 Paso 3: Buscá una factura\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-3-busca-una-factura\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-3-busca-una-factura\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/70-finanzas/79-03-buscador.png\" alt=\"Panel de búsqueda con todos los filtros, el número 123 escrito en Num Factura y los botones Descargar Excel y Buscar\">\u003C/p>\n\u003Cp>Completá lo que sepas y tocá \u003Cstrong>Buscar\u003C/strong>. Los casilleros son:\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Estado\u003C/strong>: \u003Cstrong>Abierto\u003C/strong> (se puede modificar) o \u003Cstrong>Cerrado\u003C/strong> (ya está en un cierre).\u003C/li>\n\u003Cli>\u003Cstrong>Con Deuda\u003C/strong>: tildalo para ver solo las que faltan pagar.\u003C/li>\n\u003Cli>\u003Cstrong>Proveedor\u003C/strong>: escribí el nombre y elegí uno. Usá el casillero de arriba (abajo hay otro \u003Cstrong>Proveedor\u003C/strong> que hoy no filtra).\u003C/li>\n\u003Cli>\u003Cstrong>Clasificacion\u003C/strong>: el tipo de gasto.\u003C/li>\n\u003Cli>\u003Cstrong>Sin Clasificar\u003C/strong>: solo las que no tienen clasificación.\u003C/li>\n\u003Cli>\u003Cstrong>Sin OC\u003C/strong>: solo las que no vienen de una orden de compra.\u003C/li>\n\u003Cli>\u003Cstrong>CAPEX/OPEX\u003C/strong>: inversión o gasto operativo.\u003C/li>\n\u003Cli>\u003Cstrong>Tipo Costo\u003C/strong>: costo fijo o variable.\u003C/li>\n\u003Cli>\u003Cstrong>Tipo Factura\u003C/strong>: la letra. Por ejemplo: \u003Cstrong>&quot;B&quot;\u003C/strong>.\u003C/li>\n\u003Cli>\u003Cstrong>Num Factura\u003C/strong>: escribí parte del número. Por ejemplo: \u003Cem>123\u003C/em>.\u003C/li>\n\u003Cli>\u003Cstrong>Neto\u003C/strong> y \u003Cstrong>Total\u003C/strong>: el importe exacto.\u003C/li>\n\u003Cli>\u003Cstrong>N° de OC\u003C/strong>: el número de la orden de compra.\u003C/li>\n\u003Cli>\u003Cstrong>Desde\u003C/strong> y \u003Cstrong>Hasta\u003C/strong>: el rango de fechas de la factura.\u003C/li>\n\u003Cli>\u003Cstrong>Descargar Excel\u003C/strong>: baja el resultado en una planilla.\u003C/li>\n\u003Cli>\u003Cstrong>Buscar\u003C/strong>: aplica los filtros.\u003C/li>\n\u003C/ul>\n\u003Cblockquote>\n\u003Cp>💡 \u003Cstrong>Consejo útil:\u003C/strong> para ver todo un mes, poné el primer día en \u003Cstrong>Desde\u003C/strong> y el último en \u003Cstrong>Hasta\u003C/strong>.\u003C/p>\n\u003C/blockquote>\n\u003Cp>\u003Cimg src=\"/images/manual/70-finanzas/79-05-resultado-busqueda.png\" alt=\"Lista con una sola factura, la número 51 de Distribuidora Ejemplo, tipo B, por 1.500 pesos\">\u003C/p>\n\u003Cp>La lista muestra solo lo que coincide. Arriba dice cuántas facturas encontró. Por ejemplo: \u003Cstrong>Se encontraron 1 Facturas en el historial\u003C/strong>.\u003C/p>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                📊 Paso 4: Leé el resumen y la lista\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-4-lee-el-resumen-y-la-lista\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-4-lee-el-resumen-y-la-lista\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/70-finanzas/79-04-resumen-de-busqueda.png\" alt=\"Resumen de Búsqueda con Total General 1.500, Total Sin IVA 1.239,67 y Saldo o Falta de pagar 1.500\">\u003C/p>\n\u003Cp>El \u003Cstrong>Resumen de Búsqueda\u003C/strong> suma \u003Cstrong>todas\u003C/strong> las facturas que encontró, no solo las de la pantalla:\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Total General\u003C/strong>: lo que suman con impuestos.\u003C/li>\n\u003Cli>\u003Cstrong>Total Sin IVA\u003C/strong>: lo que suman sin impuestos.\u003C/li>\n\u003Cli>\u003Cstrong>Saldo / Falta de pagar\u003C/strong>: lo que todavía no pagaste. En rojo si hay deuda, en verde si no.\u003C/li>\n\u003C/ul>\n\u003Cp>Las columnas de la lista dicen:\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Casilla\u003C/strong>: para elegir la factura (Paso 7). Si la factura está cerrada, ves un candado.\u003C/li>\n\u003Cli>\u003Cstrong>#\u003C/strong>: el número interno. Debajo dice \u003Cstrong>Directa\u003C/strong> (sin orden de compra) o el número de la orden.\u003C/li>\n\u003Cli>\u003Cstrong>Clasificación\u003C/strong> y \u003Cstrong>CAPEX/OPEX\u003C/strong>: para qué gasto es.\u003C/li>\n\u003Cli>\u003Cstrong>Fecha\u003C/strong>, \u003Cstrong>Proveedor\u003C/strong>, \u003Cstrong>Imagen\u003C/strong> y \u003Cstrong>Tipo\u003C/strong>: cuándo, de quién, si tiene foto y qué letra.\u003C/li>\n\u003Cli>\u003Cstrong>N° Comprobante\u003C/strong>: punto de venta y número.\u003C/li>\n\u003Cli>\u003Cstrong>Total Sin IVA\u003C/strong> y \u003Cstrong>Total\u003C/strong>: los importes.\u003C/li>\n\u003Cli>\u003Cstrong>Falta pagar\u003C/strong>: naranja si hay deuda. Una tilde verde si está paga.\u003C/li>\n\u003Cli>\u003Cstrong>Observación\u003C/strong> y \u003Cstrong>Creado\u003C/strong>: la nota y cuándo se cargó.\u003C/li>\n\u003C/ul>\n\u003Cp>Abajo de la lista, la línea \u003Cstrong>Resumen\u003C/strong> cuenta las facturas, el total y lo pendiente.\u003C/p>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                ⚙️ Paso 5: Usá el menú de cada factura\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-5-usa-el-menu-de-cada-factura\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-5-usa-el-menu-de-cada-factura\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/70-finanzas/79-06-menu-engranaje-abierto.png\" alt=\"Menú de la rueda abierto con Pagar, Ver, Añadir items, Editar, Duplicar y Borrar, marcado en rojo\">\u003C/p>\n\u003Col>\n\u003Cli>Al final del renglón, tocá el botón con la rueda ⚙. Es azul si la factura tiene deuda.\u003C/li>\n\u003Cli>Se abre una lista con las opciones:\u003C/li>\n\u003C/ol>\n\u003Cul>\n\u003Cli>\u003Cstrong>Pagar\u003C/strong>: abre la ventanita para pagar. Solo aparece si falta pagar. Mirá \u003Ca href=\"/user-guide/resumen-de-deuda\">Resumen de Deuda\u003C/a>.\u003C/li>\n\u003Cli>\u003Cstrong>Ver\u003C/strong>: muestra el detalle de la factura. También podés tocar cualquier lugar vacío del renglón.\u003C/li>\n\u003Cli>\u003Cstrong>Añadir items\u003C/strong>: carga lo que compraste en esa factura.\u003C/li>\n\u003Cli>\u003Cstrong>Editar\u003C/strong>: corrige los datos.\u003C/li>\n\u003Cli>\u003Cstrong>Duplicar\u003C/strong>: hace una copia para cargar otra parecida.\u003C/li>\n\u003Cli>\u003Cstrong>Borrar\u003C/strong>: elimina la factura.\u003C/li>\n\u003Cli>\u003Cstrong>Descargar Archivo\u003C/strong> o \u003Cstrong>Subir Archivo\u003C/strong>: bajan o suben la foto de la factura, si corresponde.\u003C/li>\n\u003C/ul>\n\u003Cblockquote>\n\u003Cp>⚠️ \u003Cstrong>Atención:\u003C/strong> \u003Cstrong>Pagar\u003C/strong> registra un pago de verdad. \u003Cstrong>Borrar\u003C/strong> elimina la factura. Tocalos solo si estás seguro.\u003C/p>\n\u003C/blockquote>\n\u003Cblockquote>\n\u003Cp>💡 \u003Cstrong>Consejo útil:\u003C/strong> \u003Cstrong>Editar\u003C/strong>, \u003Cstrong>Duplicar\u003C/strong> y \u003Cstrong>Borrar\u003C/strong> no aparecen en facturas cerradas ni en las pagadas antes del último arqueo de caja. Un administrador siempre las ve.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🧾 Paso 6: Mostrá los impuestos\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-6-mostra-los-impuestos\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-6-mostra-los-impuestos\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/70-finanzas/79-07-donde-esta-boton-mostrar-impuestos.png\" alt=\"Pantalla con el botón Mostrar Impuestos marcado en rojo, arriba a la derecha de la lista\">\u003C/p>\n\u003Col>\n\u003Cli>Tocá \u003Cstrong>Mostrar Impuestos\u003C/strong>, arriba a la derecha de la lista.\u003C/li>\n\u003Cli>Aparecen las columnas de impuestos de cada factura.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/70-finanzas/79-08-tabla-con-impuestos.png\" alt=\"Lista con las columnas IVA 21% con neto 1.239,67 e impuesto 260,33\">\u003C/p>\n\u003Cp>Cada impuesto muestra dos números: \u003Cstrong>Neto\u003C/strong> (el importe sobre el que se calcula) e \u003Cstrong>Imp.\u003C/strong> (el impuesto). El botón pasa a decir \u003Cstrong>Ocultar Impuestos\u003C/strong>: tocalo para volver.\u003C/p>\n\u003Cblockquote>\n\u003Cp>💡 \u003Cstrong>Consejo útil:\u003C/strong> este botón solo aparece si alguna de las facturas de la lista tiene impuestos.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                ☑️ Paso 7: Pagá o cerrá varias facturas juntas\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-7-paga-o-cierra-varias-facturas-juntas\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-7-paga-o-cierra-varias-facturas-juntas\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/70-finanzas/79-09-factura-seleccionada.png\" alt=\"Panel Gastos Seleccionados con un gasto elegido, Total de Facturas 1.500, Total a Pagar 1.500 y los botones Pagar y Aplicar Cierre\">\u003C/p>\n\u003Col>\n\u003Cli>Tildá la casilla de cada factura. Para elegir todas, tildá la de la fila de títulos.\u003C/li>\n\u003Cli>Arriba de la lista aparece el panel \u003Cstrong>Gastos Seleccionados\u003C/strong>.\u003C/li>\n\u003Cli>Ahí ves cuántas elegiste, el \u003Cstrong>Total de Facturas\u003C/strong> y el \u003Cstrong>Total a Pagar\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cp>Tenés dos botones:\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Pagar Facturas\u003C/strong>: abre el pago de todas las que tildaste. El botón muestra el total. Por ejemplo: \u003Cstrong>Pagar 1.500,00\u003C/strong>.\u003C/li>\n\u003Cli>\u003Cstrong>Aplicar Cierre\u003C/strong>: junta las facturas en un cierre, para que nadie las modifique.\u003C/li>\n\u003C/ul>\n\u003Cblockquote>\n\u003Cp>⚠️ \u003Cstrong>Atención:\u003C/strong> revisá qué facturas tildaste antes de tocar \u003Cstrong>Pagar Facturas\u003C/strong>. El pago es por la suma de todas.\u003C/p>\n\u003C/blockquote>\n\u003Ch3>Aplicar un cierre\u003C/h3>\n\u003Cp>\u003Cimg src=\"/images/manual/70-finanzas/79-10-ventanita-aplicar-cierre.png\" alt=\"Ventanita con Crear Nuevo Cierre, Asignar a uno de los últimos cierres, y los botones Cancelar y Guardar\">\u003C/p>\n\u003Cp>Al tocar \u003Cstrong>Aplicar Cierre\u003C/strong> se abre esta ventanita:\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>breve descripción del periodo\u003C/strong>: escribí un nombre. Por ejemplo: \u003Cem>Cierre de Abril\u003C/em>.\u003C/li>\n\u003Cli>\u003Cstrong>Selecccione un cierre\u003C/strong> (así está escrito en pantalla): si sos administrador, tildalo para sumar las facturas a un cierre que ya existe. Después elegí cuál en la lista.\u003C/li>\n\u003Cli>\u003Cstrong>Cancelar\u003C/strong>: cierra la ventanita sin hacer nada.\u003C/li>\n\u003Cli>\u003Cstrong>Guardar\u003C/strong>: aplica el cierre.\u003C/li>\n\u003C/ul>\n\u003Cblockquote>\n\u003Cp>⚠️ \u003Cstrong>Atención:\u003C/strong> al \u003Cstrong>Guardar\u003C/strong>, las facturas quedan cerradas y ya no se pueden modificar. Un cierre solo se deshace con permiso de administrador.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                ⚠️ Resolución de Inconvenientes\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"resolucion-de-inconvenientes\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"resolucion-de-inconvenientes\">\u003C/div>\n\n\u003Cdiv class=\"table-wrapper\">\u003Ctable>\n\u003Cthead>\n\u003Ctr>\n\u003Cth>Problema\u003C/th>\n\u003Cth>Causa más frecuente\u003C/th>\n\u003Cth>Solución recomendada\u003C/th>\n\u003C/tr>\n\u003C/thead>\n\u003Ctbody>\u003Ctr>\n\u003Ctd>\u003Cstrong>No encuentro una factura\u003C/strong>\u003C/td>\n\u003Ctd>Hay un filtro puesto que la esconde.\u003C/td>\n\u003Ctd>Vaciá los casilleros y tocá \u003Cstrong>Buscar\u003C/strong>. Probá con menos del número.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>No aparece el botón Mostrar Impuestos\u003C/strong>\u003C/td>\n\u003Ctd>Ninguna factura de la lista tiene impuestos.\u003C/td>\n\u003Ctd>Es normal. Aparece solo si alguna los tiene.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>No veo Editar ni Borrar\u003C/strong>\u003C/td>\n\u003Ctd>La factura está en un cierre o se pagó antes del último arqueo de caja.\u003C/td>\n\u003Ctd>Un administrador puede modificarla. Un candado en la primera columna indica un cierre.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>Falta pagar dice $ pero ya pagué\u003C/strong>\u003C/td>\n\u003Ctd>El pago se hizo por menos, o todavía no se cargó.\u003C/td>\n\u003Ctd>Abrí la rueda ⚙ → \u003Cstrong>Ver\u003C/strong> y revisá los pagos. Mirá también \u003Ca href=\"/user-guide/pagos\">Pagos (Egresos)\u003C/a>.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>El Saldo del resumen no coincide con mi lista\u003C/strong>\u003C/td>\n\u003Ctd>El resumen suma todas las páginas, no solo la que ves.\u003C/td>\n\u003Ctd>Es normal. Usá los filtros para achicar el resultado.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>Necesito la lista en Excel\u003C/strong>\u003C/td>\n\u003Ctd>—\u003C/td>\n\u003Ctd>Tocá \u003Cstrong>Exportar XLSX\u003C/strong> arriba, o \u003Cstrong>Descargar Excel\u003C/strong> en el buscador.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>Me equivoqué al aplicar un cierre\u003C/strong>\u003C/td>\n\u003Ctd>Se tocó \u003Cstrong>Guardar\u003C/strong> con las facturas equivocadas.\u003C/td>\n\u003Ctd>Pedile a un administrador que las saque del cierre.\u003C/td>\n\u003C/tr>\n\u003C/tbody>\u003C/table>\u003C/div>\n",[5,9,12,15,18,21,24,27,30],{"id":6,"title":7,"level":8},"antes-de-empezar","Antes de empezar",2,{"id":10,"title":11,"level":8},"paso-1-entra-a-la-pantalla","Paso 1: Entrá a la pantalla",{"id":13,"title":14,"level":8},"paso-2-conoce-los-botones-de-arriba","Paso 2: Conocé los botones de arriba",{"id":16,"title":17,"level":8},"paso-3-busca-una-factura","Paso 3: Buscá una factura",{"id":19,"title":20,"level":8},"paso-4-lee-el-resumen-y-la-lista","Paso 4: Leé el resumen y la lista",{"id":22,"title":23,"level":8},"paso-5-usa-el-menu-de-cada-factura","Paso 5: Usá el menú de cada factura",{"id":25,"title":26,"level":8},"paso-6-mostra-los-impuestos","Paso 6: Mostrá los impuestos",{"id":28,"title":29,"level":8},"paso-7-paga-o-cierra-varias-facturas-juntas","Paso 7: Pagá o cerrá varias facturas juntas",{"id":31,"title":32,"level":8},"resolucion-de-inconvenientes","Resolución de Inconvenientes",{"title":34,"description":35,"keywords":36},"Historial de Facturas - Manual","¿Dónde está en el sistema?: Menú principal → Finanzas → Facturas y Pagos → Historial de Facturas\n ¿Quién lo usa?: Contadores, Encargad...","historial de facturas, paxapos, historial de facturas, tutorial, guía, manual usuario","79-historial-de-facturas.txt"],"uses":{"params":["slug"]}}]}
