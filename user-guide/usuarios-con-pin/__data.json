"Crear una Orden de Compra",{"slug":87,"title":88},"ordenes-a-aprobar","Órdenes a aprobar",{"slug":90,"title":91},"mercaderias","Mercaderías",{"slug":93,"title":94},"proveedores","Proveedores",{"slug":96,"title":97},"historial-de-compras","Historial de Compras",{"title":99,"modules":100},"Stock",[101,104,107],{"slug":102,"title":103},"stock-mercaderias","Stock de Mercaderías",{"slug":105,"title":106},"stock-subproductos","Stock de Subproductos",{"slug":108,"title":109},"movimientos-de-stock","Movimientos de Stock",{"title":111,"modules":112},"Finanzas",[113,116,119,122,125,128,131,134,137],{"slug":114,"title":115},"arqueos-de-caja","Arqueos de Caja",{"slug":117,"title":118},"listado-de-cajas","Listado de Cajas",{"slug":120,"title":121},"transacciones-de-cobro","Transacciones de Cobro",{"slug":123,"title":124},"factura-manual","Factura Manual",{"slug":126,"title":127},"resumen-de-deuda","Resumen de Deuda",{"slug":129,"title":130},"pagos","Pagos",{"slug":132,"title":133},"historial-de-facturas","Historial de Facturas",{"slug":135,"title":136},"historico-de-mesas","Histórico de Mesas",{"slug":138,"title":139},"puntos-de-venta-pdv","Puntos de Venta (PDVs)",{"title":141,"modules":142},"Comandero",[143],{"slug":144,"title":145},"comandero","Comandero (pantalla de cocina)",{"title":147,"modules":148},"RRHH",[149,152,155,158,161,164,167,170],{"slug":150,"title":151},"empleados","Empleados",{"slug":153,"title":154},"empleados-trabajando","Empleados Trabajando",{"slug":156,"title":157},"registro-diario-fichaje","Registro Diario de Fichaje",{"slug":159,"title":160},"reporte-mensual-fichaje","Reporte Mensual de Fichaje",{"slug":162,"title":163},"departamentos","Departamentos",{"slug":165,"title":166},"turnos-y-horarios-fichaje","Turnos y Horarios de Fichaje",{"slug":168,"title":169},"sueldos-y-jornales","Sueldos y Jornales",{"slug":171,"title":172},"datos-de-acceso-app","Datos de Acceso a la App de Fichaje",{"title":174,"modules":175},"Reportes",[176,179,182],{"slug":177,"title":178},"tablero-general","Tablero General",{"slug":180,"title":181},"productos-mas-vendidos","Productos Más Vendidos",{"slug":183,"title":184},"compras-por-mercaderia","Compras por Mercadería",{"title":186,"modules":187},"Configuracion",[188,191,194,197,200,203,206,209,212,215,218],{"slug":189,"title":190},"configuracion-general","Configuración general",{"slug":192,"title":193},"impresoras","Cómo cargar las impresoras del local",{"slug":195,"title":196},"perfiles-de-impresion","Cómo usar los perfiles de impresión",{"slug":198,"title":199},"usuarios-del-sistema","Cómo administrar los Usuarios del Sistema",{"slug":201,"title":202},"usuarios-con-pin","Cómo administrar los Usuarios con PIN",{"slug":204,"title":205},"punto-de-venta","🏛️ Trámite en ARCA (con clave fiscal)",{"slug":207,"title":208},"permisos-por-rol","Cómo configurar los Permisos por Rol",{"slug":210,"title":211},"turnos-mesa","Turnos de Mesa",{"slug":213,"title":214},"medios-de-cobro","Medios de cobro",{"slug":216,"title":217},"clasificacion-de-gastos","Clasificación de Gastos",{"slug":219,"title":220},"centros-de-costo","Centros de Costo",{"title":222,"modules":223},"Biblioteca de Drivers",[224,226,229,232,235,238,241,244,247],{"slug":225,"title":222},"biblioteca-de-drivers",{"slug":227,"title":228},"sam4s-giant-100","Sam4S Giant - 100",{"slug":230,"title":231},"citizen-ct-s310ii","Citizen CT-S310II",{"slug":233,"title":234},"epson-tm-t20","Epson TM-T20",{"slug":236,"title":237},"drivers-genericos","Drivers Genéricos POS",{"slug":239,"title":240},"epson-tm-t88","Epson TM-T88V",{"slug":242,"title":243},"fiscalberry-windows","Instalar Fiscalberry en Windows",{"slug":245,"title":246},"fiscalberry-linux","Instalar Fiscalberry en Linux",{"slug":248,"title":249},"fiscalberry-android","Instalar Fiscalberry en Android",{"title":251,"modules":252},"Extra",[253,256,259,262,265,268,271,274,277,280],{"slug":254,"title":255},"01-faq-solucion-inicial-pantalla-congelada","📖 Manual de Usuario: Solución Inicial si la Pantalla se Congela o no Carga",{"slug":257,"title":258},"03-faq-mozo-reabrir-mesa-anulada","📖 Manual de Usuario: Cómo Reabrir una Mesa Anulada o Cerrada por Error",{"slug":260,"title":261},"05-faq-cajero-emitir-factura-a","📖 Manual de Usuario: Cómo Emitir una Factura A Cargando Datos del Cliente",{"slug":263,"title":264},"06-faq-cajero-ingreso-egreso-cajon","📖 Manual de Usuario: Cómo Registrar Entradas y Salidas de Dinero del Cajón",{"slug":266,"title":267},"07-faq-cajero-activar-medio-pago","📖 Manual de Usuario: Cómo Activar un Medio de Pago que no Aparece al Cobrar",{"slug":269,"title":270},"08-faq-cajero-diferencia-facturado-vs-abiertas","📖 Manual de Usuario: Diferencia entre \"Facturado Total Mesas\" y \"Abiertas Por Usuario\" en Caja",{"slug":272,"title":273},"10-faq-supervisor-cierre-caja-diferencias","📖 Manual de Usuario: Cómo Auditar y Solucionar Diferencias en el Cierre de Caja",{"slug":275,"title":276},"preguntas-frecuentes","Preguntas Frecuentes y Guías Rápidas por Rol",{"slug":278,"title":279},"buchon-bot","Buchón Bot",{"slug":281,"title":282},"troubleshooting-semantico","📖 Guía Única de Resolución de Problemas y Errores (Troubleshooting)"],"uses":{}},{"type":"data","data":[{"slug":1,"title":2,"content":3,"tableOfContents":4,"seo":24,"llmTxtFile":28},"usuarios-con-pin","Cómo administrar los Usuarios con PIN","\u003Cdiv id=\"usuarios-con-pin\">\u003C/div>\n\n\u003Cblockquote>\n\u003Cp>\u003Cstrong>¿Dónde está en el sistema?:\u003C/strong> Menú principal → \u003Cstrong>Configuración\u003C/strong> → debajo del título \u003Cstrong>Acceso y Seguridad\u003C/strong> → \u003Cstrong>Usuarios con PIN\u003C/strong>\n\u003Cstrong>¿Quién lo usa?:\u003C/strong> El dueño y los encargados del comercio.\u003C/p>\n\u003C/blockquote>\n\u003Cblockquote>\n\u003Cp>🎯 \u003Cstrong>¿Para qué sirve esto?\u003C/strong>\nLos usuarios con PIN sirven para dispositivos compartidos, como la tele de cocina, la PC del salón o una tablet. Se entra con un código de 4 dígitos, sin email ni contraseña.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                📍 \u003Cstrong>Paso 1: Entrá a la pantalla\u003C/strong>\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-1-entra-a-la-pantalla\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-1-entra-a-la-pantalla\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/110-configuracion/124-00a-menu-grupo-configuracion.png\" alt=\"Menú lateral con el grupo Configuración marcado en rojo\">\u003C/p>\n\u003Col>\n\u003Cli>En el menú de la izquierda, tocá \u003Cstrong>Configuración\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/110-configuracion/124-00b-menu-opcion-usuarios-con-pin.png\" alt=\"Opción Usuarios con PIN marcada en rojo debajo del título Acceso y Seguridad\">\u003C/p>\n\u003Col start=\"2\">\n\u003Cli>Debajo del título \u003Cstrong>Acceso y Seguridad\u003C/strong>, tocá \u003Cstrong>Usuarios con PIN\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/110-configuracion/124-01-pantalla-acceso-rapido-por-pin.png\" alt=\"Pantalla Acceso Rápido por PIN con un usuario en la lista\">\u003C/p>\n\u003Cp>Ves la pantalla \u003Cstrong>Acceso Rápido por PIN\u003C/strong>. Cada tarjeta es un acceso y muestra:\u003C/p>\n\u003Cul>\n\u003Cli>El \u003Cstrong>nombre\u003C/strong> del acceso. Por ejemplo: \u003Cem>Mozo 1\u003C/em>.\u003C/li>\n\u003Cli>El \u003Cstrong>rol\u003C/strong> que tiene (etiqueta gris).\u003C/li>\n\u003Cli>\u003Cstrong>PIN activo\u003C/strong> (etiqueta naranja): ya tiene un código cargado.\u003C/li>\n\u003Cli>El \u003Cstrong>perfil de impresión\u003C/strong>, si tiene uno asignado (etiqueta verde).\u003C/li>\n\u003C/ul>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                ➕ \u003Cstrong>Paso 2: Tocá Crear Usuario\u003C/strong>\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-2-toca-crear-usuario\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-2-toca-crear-usuario\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/110-configuracion/124-02-donde-esta-boton-crear-usuario.png\" alt=\"Pantalla con el botón Crear Usuario marcado en rojo arriba a la derecha\">\u003C/p>\n\u003Col>\n\u003Cli>Buscá el botón azul \u003Cstrong>Crear Usuario\u003C/strong>, arriba a la derecha.\u003C/li>\n\u003Cli>Tocalo una vez.\u003C/li>\n\u003Cli>Se abre la pantalla \u003Cstrong>Crear Usuario de Acceso Rápido\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cp>Si todavía no hay ningún acceso, la pantalla muestra el botón \u003Cstrong>Crear Primer Usuario\u003C/strong>. Hace lo mismo.\u003C/p>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                📝 \u003Cstrong>Paso 3: Completá los datos\u003C/strong>\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-3-completa-los-datos\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-3-completa-los-datos\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/110-configuracion/124-04-formulario-crear-usuario-de-acceso-rapido.png\" alt=\"Pantalla Crear Usuario de Acceso Rápido con nombre Cocina, PIN difuminado y los botones Volver y Guardar\">\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Nombre de usuario\u003C/strong>: cómo se llama el acceso. Por ejemplo: \u003Cem>Cocina\u003C/em>, \u003Cem>Salón\u003C/em> o \u003Cem>Barra\u003C/em>.\u003C/li>\n\u003Cli>\u003Cstrong>Rol\u003C/strong>: qué puede hacer este acceso. Elegí uno de la lista.\u003C/li>\n\u003Cli>\u003Cstrong>PIN de Acceso\u003C/strong>: escribí 4 números. Cada acceso necesita un PIN distinto.\u003C/li>\n\u003Cli>\u003Cstrong>Perfil de Impresión\u003C/strong>: a qué impresoras imprime. Si no elegís, usa el del comercio. \u003Cstrong>Gestionar Perfiles\u003C/strong> te lleva a \u003Ca href=\"/user-guide/perfiles-de-impresion\">Perfiles de Impresión\u003C/a>.\u003C/li>\n\u003Cli>\u003Cstrong>Volver\u003C/strong>: sale sin guardar nada.\u003C/li>\n\u003C/ul>\n\u003Cblockquote>\n\u003Cp>💡 \u003Cstrong>Consejo útil:\u003C/strong> elegí un PIN fácil de recordar para el equipo. No uses el mismo PIN de una tarjeta o clave personal.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                💾 \u003Cstrong>Paso 4: Guardá\u003C/strong>\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-4-guarda\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-4-guarda\">\u003C/div>\n\n\u003Col>\n\u003Cli>Revisá el nombre, el rol y el PIN.\u003C/li>\n\u003Cli>Tocá el botón azul \u003Cstrong>Guardar\u003C/strong>, abajo a la derecha.\u003C/li>\n\u003Cli>Volvés a la lista y el acceso nuevo aparece con la etiqueta \u003Cstrong>PIN activo\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cp>Desde ese momento, quien escriba ese PIN en el dispositivo entra con ese rol.\u003C/p>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                ✏️ \u003Cstrong>Paso 5: Cambiá o eliminá un acceso\u003C/strong>\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-5-cambia-o-elimina-un-acceso\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-5-cambia-o-elimina-un-acceso\">\u003C/div>\n\n\u003Cp>En cada tarjeta de la lista del Paso 1 hay dos botones juntos, a la derecha:\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Editar\u003C/strong>: abre los mismos datos del Paso 3 para cambiar el nombre, el rol, el PIN o el perfil. Tocá \u003Cstrong>Guardar\u003C/strong> para aplicar.\u003C/li>\n\u003Cli>\u003Cstrong>Tacho rojo\u003C/strong>: elimina el acceso. Te pide confirmar antes.\u003C/li>\n\u003C/ul>\n\u003Cblockquote>\n\u003Cp>⚠️ \u003Cstrong>Atención:\u003C/strong> al eliminar un acceso, ese PIN deja de funcionar en todos los dispositivos. Avisale al equipo antes.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                ⚠️ \u003Cstrong>Resolución de Inconvenientes\u003C/strong>\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"resolucion-de-inconvenientes\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"resolucion-de-inconvenientes\">\u003C/div>\n\n\u003Cdiv class=\"table-wrapper\">\u003Ctable>\n\u003Cthead>\n\u003Ctr>\n\u003Cth>Problema\u003C/th>\n\u003Cth>Causa más frecuente\u003C/th>\n\u003Cth>Solución recomendada\u003C/th>\n\u003C/tr>\n\u003C/thead>\n\u003Ctbody>\u003Ctr>\n\u003Ctd>El sistema dice que el PIN ya existe.\u003C/td>\n\u003Ctd>Otro acceso usa esos mismos 4 números.\u003C/td>\n\u003Ctd>Elegí otra combinación de 4 dígitos.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>El PIN no se guarda.\u003C/td>\n\u003Ctd>Tiene menos o más de 4 números.\u003C/td>\n\u003Ctd>Escribí exactamente 4 dígitos.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>El dispositivo no deja entrar con el PIN.\u003C/td>\n\u003Ctd>El acceso fue eliminado o el PIN se cambió.\u003C/td>\n\u003Ctd>Revisá la lista. Editá el acceso y confirmá el PIN.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>Un empleado necesita entrar con su email.\u003C/td>\n\u003Ctd>Ese acceso es compartido, no personal.\u003C/td>\n\u003Ctd>Creale un usuario en \u003Ca href=\"/user-guide/usuarios-del-sistema\">Usuarios del Sistema\u003C/a>.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>No me deja elegir el rol que quiero.\u003C/td>\n\u003Ctd>El rol no existe o no tenés permiso.\u003C/td>\n\u003Ctd>Revisá los roles en \u003Ca href=\"/user-guide/permisos-por-rol\">Permisos por Rol\u003C/a>.\u003C/td>\n\u003C/tr>\n\u003C/tbody>\u003C/table>\u003C/div>\n",[5,9,12,15,18,21],{"id":6,"title":7,"level":8},"paso-1-entra-a-la-pantalla","Paso 1: Entrá a la pantalla",2,{"id":10,"title":11,"level":8},"paso-2-toca-crear-usuario","Paso 2: Tocá Crear Usuario",{"id":13,"title":14,"level":8},"paso-3-completa-los-datos","Paso 3: Completá los datos",{"id":16,"title":17,"level":8},"paso-4-guarda","Paso 4: Guardá",{"id":19,"title":20,"level":8},"paso-5-cambia-o-elimina-un-acceso","Paso 5: Cambiá o eliminá un acceso",{"id":22,"title":23,"level":8},"resolucion-de-inconvenientes","Resolución de Inconvenientes",{"title":25,"description":26,"keywords":27},"Cómo administrar los Usuarios con PIN - Manual","¿Dónde está en el sistema?: Menú principal → Configuración → debajo del título Acceso y Seguridad → Usuarios con PIN\n ¿Quién lo usa?: ...","usuarios con pin, paxapos, cómo administrar los usuarios con pin, tutorial, guía, manual usuario","124-usuarios-con-pin.txt"],"uses":{"params":["slug"]}}]}
