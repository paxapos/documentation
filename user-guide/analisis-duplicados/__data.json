{"type":"data","nodes":[null,{"type":"data","data":[{"moduleCategories":1},[2,17,44,53,77,98,110,140,146,173,185,221,250],{"title":3,"modules":4},"Comenzamos",[5,8,11,14],{"slug":6,"title":7},"introduccion","Bienvenido a tu software gastronómico",{"slug":9,"title":10},"iniciar-sesion","Cómo Iniciar Sesión",{"slug":12,"title":13},"recuperar-contrasena","Cómo Recuperar tu Contraseña",{"slug":15,"title":16},"guia-de-inicio-rapido","Guía de Inicio Rápido",{"title":18,"modules":19},"Ventas",[20,23,26,29,32,35,38,41],{"slug":21,"title":22},"salon-de-ventas","Cómo Usar el Salón de Ventas (Adición)",{"slug":24,"title":25},"caja-rapida","Cómo Usar la Caja Rápida (Registradora)",{"slug":27,"title":28},"mozos","Cómo Cargar los Mozos",{"slug":30,"title":31},"clientes","Cómo Gestionar los Clientes",{"slug":33,"title":34},"descuentos","Cómo Configurar Descuentos",{"slug":36,"title":37},"nueva-reserva","Cómo Cargar una Nueva Reserva",{"slug":39,"title":40},"listado-de-reservas","Cómo Usar el Listado de Reservas",{"slug":42,"title":43},"grilla-de-reservas","Cómo Usar la Grilla de Reservas",{"title":45,"modules":46},"Medios de Pago",[47,50],{"slug":48,"title":49},"configuracion-procesadores","Configuración de Procesadores de Pago",{"slug":51,"title":52},"transacciones-mercadopago","Transacciones MercadoPago",{"title":54,"modules":55},"Productos",[56,59,62,65,68,71,74],{"slug":57,"title":58},"menu","Menú de Productos (Carta)",{"slug":60,"title":61},"categorias","Categorías de Productos",{"slug":63,"title":64},"variantes-grupo-sabores","Variantes y Grupos de Sabores",{"slug":66,"title":67},"maestro-de-productos","Maestro de Productos",{"slug":69,"title":70},"subproductos-elaborados","Sub-Productos (Elaborados)",{"slug":72,"title":73},"recetas","Recetas",{"slug":75,"title":76},"analisis-duplicados","Buscar Duplicados",{"title":78,"modules":79},"Compras",[80,83,86,89,92,95],{"slug":81,"title":82},"todas-las-ordenes-compra","Órdenes de Compra",{"slug":84,"title":85},"crear-orden-compra","Crear una Orden de Compra",{"slug":87,"title":88},"ordenes-a-aprobar","Órdenes a aprobar",{"slug":90,"title":91},"mercaderias","Mercaderías",{"slug":93,"title":94},"proveedores","Proveedores",{"slug":96,"title":97},"historial-de-compras","Historial de Compras",{"title":99,"modules":100},"Stock",[101,104,107],{"slug":102,"title":103},"stock-mercaderias","Stock de Mercaderías",{"slug":105,"title":106},"stock-subproductos","Stock de Subproductos",{"slug":108,"title":109},"movimientos-de-stock","Movimientos de Stock",{"title":111,"modules":112},"Finanzas",[113,116,119,122,125,128,131,134,137],{"slug":114,"title":115},"arqueos-de-caja","Arqueos de Caja",{"slug":117,"title":118},"listado-de-cajas","Listado de Cajas",{"slug":120,"title":121},"transacciones-de-cobro","Transacciones de Cobro",{"slug":123,"title":124},"factura-manual","Factura Manual",{"slug":126,"title":127},"resumen-de-deuda","Resumen de Deuda",{"slug":129,"title":130},"pagos","Pagos",{"slug":132,"title":133},"historial-de-facturas","Historial de Facturas",{"slug":135,"title":136},"historico-de-mesas","Histórico de Mesas",{"slug":138,"title":139},"puntos-de-venta-pdv","Puntos de Venta (PDVs)",{"title":141,"modules":142},"Comandero",[143],{"slug":144,"title":145},"comandero","Comandero (pantalla de cocina)",{"title":147,"modules":148},"RRHH",[149,152,155,158,161,164,167,170],{"slug":150,"title":151},"empleados","Empleados",{"slug":153,"title":154},"empleados-trabajando","Empleados Trabajando",{"slug":156,"title":157},"registro-diario-fichaje","Registro Diario de Fichaje",{"slug":159,"title":160},"reporte-mensual-fichaje","Reporte Mensual de Fichaje",{"slug":162,"title":163},"departamentos","Departamentos",{"slug":165,"title":166},"turnos-y-horarios-fichaje","Turnos y Horarios de Fichaje",{"slug":168,"title":169},"sueldos-y-jornales","Sueldos y Jornales",{"slug":171,"title":172},"datos-de-acceso-app","Datos de Acceso a la App de Fichaje",{"title":174,"modules":175},"Reportes",[176,179,182],{"slug":177,"title":178},"tablero-general","Tablero General",{"slug":180,"title":181},"productos-mas-vendidos","Productos Más Vendidos",{"slug":183,"title":184},"compras-por-mercaderia","Compras por Mercadería",{"title":186,"modules":187},"Configuracion",[188,191,194,197,200,203,206,209,212,215,218],{"slug":189,"title":190},"configuracion-general","Configuración general",{"slug":192,"title":193},"impresoras","Cómo cargar las impresoras del local",{"slug":195,"title":196},"perfiles-de-impresion","Cómo usar los perfiles de impresión",{"slug":198,"title":199},"usuarios-del-sistema","Cómo administrar los Usuarios del Sistema",{"slug":201,"title":202},"usuarios-con-pin","Cómo administrar los Usuarios con PIN",{"slug":204,"title":205},"punto-de-venta","🏛️ Trámite en ARCA (con clave fiscal)",{"slug":207,"title":208},"permisos-por-rol","Cómo configurar los Permisos por Rol",{"slug":210,"title":211},"turnos-mesa","Turnos de Mesa",{"slug":213,"title":214},"medios-de-cobro","Medios de cobro",{"slug":216,"title":217},"clasificacion-de-gastos","Clasificación de Gastos",{"slug":219,"title":220},"centros-de-costo","Centros de Costo",{"title":222,"modules":223},"Biblioteca de Drivers",[224,226,229,232,235,238,241,244,247],{"slug":225,"title":222},"biblioteca-de-drivers",{"slug":227,"title":228},"sam4s-giant-100","Sam4S Giant - 100",{"slug":230,"title":231},"citizen-ct-s310ii","Citizen CT-S310II",{"slug":233,"title":234},"epson-tm-t20","Epson TM-T20",{"slug":236,"title":237},"drivers-genericos","Drivers Genéricos POS",{"slug":239,"title":240},"epson-tm-t88","Epson TM-T88V",{"slug":242,"title":243},"fiscalberry-windows","Instalar Fiscalberry en Windows",{"slug":245,"title":246},"fiscalberry-linux","Instalar Fiscalberry en Linux",{"slug":248,"title":249},"fiscalberry-android","Instalar Fiscalberry en Android",{"title":251,"modules":252},"Extra",[253,256,259,262,265,268,271,274,277,280],{"slug":254,"title":255},"01-faq-solucion-inicial-pantalla-congelada","📖 Manual de Usuario: Solución Inicial si la Pantalla se Congela o no Carga",{"slug":257,"title":258},"03-faq-mozo-reabrir-mesa-anulada","📖 Manual de Usuario: Cómo Reabrir una Mesa Anulada o Cerrada por Error",{"slug":260,"title":261},"05-faq-cajero-emitir-factura-a","📖 Manual de Usuario: Cómo Emitir una Factura A Cargando Datos del Cliente",{"slug":263,"title":264},"06-faq-cajero-ingreso-egreso-cajon","📖 Manual de Usuario: Cómo Registrar Entradas y Salidas de Dinero del Cajón",{"slug":266,"title":267},"07-faq-cajero-activar-medio-pago","📖 Manual de Usuario: Cómo Activar un Medio de Pago que no Aparece al Cobrar",{"slug":269,"title":270},"08-faq-cajero-diferencia-facturado-vs-abiertas","📖 Manual de Usuario: Diferencia entre \"Facturado Total Mesas\" y \"Abiertas Por Usuario\" en Caja",{"slug":272,"title":273},"10-faq-supervisor-cierre-caja-diferencias","📖 Manual de Usuario: Cómo Auditar y Solucionar Diferencias en el Cierre de Caja",{"slug":275,"title":276},"preguntas-frecuentes","Preguntas Frecuentes y Guías Rápidas por Rol",{"slug":278,"title":279},"buchon-bot","Buchón Bot",{"slug":281,"title":282},"troubleshooting-semantico","📖 Guía Única de Resolución de Problemas y Errores (Troubleshooting)"],"uses":{}},{"type":"data","data":[{"slug":1,"title":2,"content":3,"tableOfContents":4,"seo":27,"llmTxtFile":31},"analisis-duplicados","Buscar Duplicados","\u003Cdiv id=\"buscar-duplicados\">\u003C/div>\n\n\u003Cblockquote>\n\u003Cp>\u003Cstrong>¿Dónde está en el sistema?:\u003C/strong> Menú principal → \u003Cstrong>Productos\u003C/strong> → \u003Cstrong>Gestión Avanzada\u003C/strong> → \u003Cstrong>Buscar Duplicados\u003C/strong>\n\u003Cstrong>¿Quién lo usa?:\u003C/strong> Administradores y encargados de compras\u003C/p>\n\u003C/blockquote>\n\u003Cblockquote>\n\u003Cp>🎯 \u003Cstrong>¿Para qué sirve esto?\u003C/strong>\nA veces el mismo producto se carga dos veces con nombres parecidos. Por ejemplo: \u003Cem>Coca Cola 500\u003C/em> y \u003Cem>COCA-COLA 500ml\u003C/em>.\nEsta pantalla los encuentra sola y te deja juntarlos en uno, para que el stock y los costos no se repartan.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🔑 Antes de empezar\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"antes-de-empezar\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"antes-de-empezar\">\u003C/div>\n\n\u003Cul>\n\u003Cli>Tu usuario tiene que tener el permiso de \u003Cstrong>Maestro de Productos\u003C/strong> en \u003Ca href=\"/user-guide/permisos-por-rol\">Permisos por Rol\u003C/a>.\u003C/li>\n\u003C/ul>\n\u003Cblockquote>\n\u003Cp>⚠️ \u003Cstrong>Atención:\u003C/strong> \u003Cstrong>Unificar\u003C/strong> junta dos productos en uno \u003Cstrong>para siempre\u003C/strong>. No se puede deshacer. Revisá bien antes de tocarlo.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                📍 Paso 1: Entrá a la pantalla\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-1-entra-a-la-pantalla\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-1-entra-a-la-pantalla\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/48-00a-menu-grupo-productos.png\" alt=\"Menú lateral con el grupo Productos marcado en rojo\">\u003C/p>\n\u003Col>\n\u003Cli>En el menú de la izquierda, tocá \u003Cstrong>Productos\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/48-00b-menu-opcion-analizar-duplicados-sistema.png\" alt=\"Opción Buscar Duplicados marcada en rojo en el menú lateral\">\u003C/p>\n\u003Col start=\"2\">\n\u003Cli>Tocá \u003Cstrong>Buscar Duplicados\u003C/strong>. Está debajo del título \u003Cstrong>GESTIÓN AVANZADA\u003C/strong>.\u003C/li>\n\u003Cli>El sistema revisa todos tus productos. Puede tardar unos segundos.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/48-01-pantalla-analizar-duplicados-siste.png\" alt=\"Pantalla Buscar Duplicados con el aviso Análisis completado y el primer grupo\">\u003C/p>\n\u003Cp>Arriba, un cuadro azul te dice cuántos grupos de duplicados encontró.\u003C/p>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/48-22-aviso-ia-apagada.png\" alt=\"Etiqueta gris IA OFF\">\u003C/p>\n\u003Cblockquote>\n\u003Cp>💡 \u003Cstrong>Consejo útil:\u003C/strong> si ves \u003Cstrong>IA OFF\u003C/strong>, la búsqueda se hace comparando letras y palabras. Con la inteligencia artificial encendida aparece además el botón \u003Cstrong>Refinar con IA\u003C/strong>. Mirá \u003Ca href=\"/user-guide/configuracion-general#inteligencia-artificial\">Inteligencia Artificial\u003C/a>.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🗂️ Paso 2: Revisá cada grupo\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-2-revisa-cada-grupo\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-2-revisa-cada-grupo\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/48-23-grupo-de-duplicados.png\" alt=\"Título del Grupo 1: Nombre idéntico (normalizado), con 18 productos\">\u003C/p>\n\u003Cp>Cada grupo junta productos que el sistema cree repetidos. El título dice \u003Cstrong>por qué\u003C/strong>. Por ejemplo: \u003Cem>Nombre idéntico\u003C/em> o \u003Cem>Nombres muy similares\u003C/em>.\u003C/p>\n\u003Cblockquote>\n\u003Cp>⚠️ \u003Cstrong>Atención:\u003C/strong> el sistema a veces se equivoca. Por ejemplo, puede juntar \u003Cem>BUDIN CON FRUTA\u003C/em> y \u003Cem>BUDIN SIN FRUTA\u003C/em>, que son distintos. Revisá cada producto antes de unificar.\u003C/p>\n\u003C/blockquote>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/48-02-donde-esta-boton-ver.png\" alt=\"Grupo con el botón Ver del primer producto marcado en rojo\">\u003C/p>\n\u003Col>\n\u003Cli>Para ver un producto, tocá \u003Cstrong>Ver\u003C/strong> en su renglón. Se abre su ficha.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/48-04-donde-esta-boton-duplicados.png\" alt=\"Grupo con el botón Duplicados del primer producto marcado en rojo\">\u003C/p>\n\u003Col start=\"2\">\n\u003Cli>Para ver con qué productos se parece, tocá \u003Cstrong>Duplicados\u003C/strong> en su renglón (Paso 3).\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/48-06-donde-esta-boton-analizar-duplicados.png\" alt=\"Grupo con el botón Analizar duplicados marcado en rojo, debajo de la lista\">\u003C/p>\n\u003Col start=\"3\">\n\u003Cli>\u003Cstrong>Analizar duplicados\u003C/strong>, debajo de cada grupo, hace lo mismo con el primer producto del grupo.\u003C/li>\n\u003C/ol>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🔍 Paso 3: Mirá los duplicados de un producto\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-3-mira-los-duplicados-de-un-producto\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-3-mira-los-duplicados-de-un-producto\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/48-24-pantalla-duplicados-de-un-producto.png\" alt=\"Pantalla Análisis de duplicados del producto BUDIN CON FRUTA con la lista de parecidos\">\u003C/p>\n\u003Cp>Arriba ves el producto elegido. Abajo, los productos parecidos. La columna \u003Cstrong>Similitud\u003C/strong> dice cuánto se parecen. Por ejemplo: \u003Cem>100%\u003C/em> es el mismo nombre.\u003C/p>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🔗 Paso 4: Unificá los productos repetidos\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-4-unifica-los-productos-repetidos\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-4-unifica-los-productos-repetidos\">\u003C/div>\n\n\u003Cblockquote>\n\u003Cp>⚠️ \u003Cstrong>Atención:\u003C/strong> al unificar, los productos de la lista se juntan con el de arriba. Se mantienen sus categorías, impresoras y puestos. \u003Cstrong>No se puede deshacer.\u003C/strong>\u003C/p>\n\u003C/blockquote>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/48-18-donde-esta-boton-unificar-productos.png\" alt=\"Pantalla con el botón azul Unificar productos marcado en rojo\">\u003C/p>\n\u003Col>\n\u003Cli>Si \u003Cstrong>todos\u003C/strong> los productos de la lista son el mismo, tocá \u003Cstrong>Unificar productos\u003C/strong>.\u003C/li>\n\u003Cli>Queda un solo producto.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/48-08-donde-esta-boton-unificar-ahora.png\" alt=\"Pantalla del grupo con el botón naranja Unificar ahora marcado en rojo\">\u003C/p>\n\u003Col start=\"3\">\n\u003Cli>También podés tocar \u003Cstrong>Unificar ahora\u003C/strong>, debajo de cada grupo. Junta todo el grupo en el primer producto.\u003C/li>\n\u003C/ol>\n\u003Cblockquote>\n\u003Cp>💡 \u003Cstrong>Consejo útil:\u003C/strong> si en un grupo hay productos distintos, no uses \u003Cstrong>Unificar ahora\u003C/strong>. Entrá a \u003Cstrong>Duplicados\u003C/strong> del producto correcto y revisá uno por uno.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🔄 Paso 5: Volvé a buscar o salí\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-5-volve-a-buscar-o-sali\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-5-volve-a-buscar-o-sali\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/48-10-donde-esta-boton-ejecutar-nuevo-analisis.png\" alt=\"Pantalla con el botón Ejecutar nuevo análisis marcado en rojo, abajo de todo\">\u003C/p>\n\u003Col>\n\u003Cli>Después de unificar, tocá \u003Cstrong>Ejecutar nuevo análisis\u003C/strong>, abajo de todo. El sistema revisa de nuevo.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/48-14-donde-esta-boton-volver-al-listado.png\" alt=\"Pantalla con el botón Volver al listado marcado en rojo\">\u003C/p>\n\u003Col start=\"2\">\n\u003Cli>Tocá \u003Cstrong>Volver al listado\u003C/strong> para ir al \u003Ca href=\"/user-guide/maestro-de-productos\">Maestro de Productos\u003C/a>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/48-25-donde-esta-boton-volver-al-listado-producto.png\" alt=\"Pantalla de duplicados de un producto con Volver al listado marcado en rojo\">\u003C/p>\n\u003Col start=\"3\">\n\u003Cli>En la pantalla de un producto, \u003Cstrong>Volver al listado\u003C/strong> también te lleva al Maestro de Productos.\u003C/li>\n\u003C/ol>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                ⚠️ Resolución de Inconvenientes\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"resolucion-de-inconvenientes\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"resolucion-de-inconvenientes\">\u003C/div>\n\n\u003Cdiv class=\"table-wrapper\">\u003Ctable>\n\u003Cthead>\n\u003Ctr>\n\u003Cth>Problema\u003C/th>\n\u003Cth>Causa más frecuente\u003C/th>\n\u003Cth>Solución recomendada\u003C/th>\n\u003C/tr>\n\u003C/thead>\n\u003Ctbody>\u003Ctr>\n\u003Ctd>\u003Cstrong>Dice &quot;¡Excelente! No se encontraron productos duplicados&quot;\u003C/strong>\u003C/td>\n\u003Ctd>No hay productos con nombres parecidos.\u003C/td>\n\u003Ctd>No tenés que hacer nada.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>Un grupo junta productos que son distintos\u003C/strong>\u003C/td>\n\u003Ctd>El sistema compara solo los nombres.\u003C/td>\n\u003Ctd>No unifiques ese grupo. Revisá cada producto con \u003Cstrong>Duplicados\u003C/strong>.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>No aparece Refinar con IA\u003C/strong>\u003C/td>\n\u003Ctd>La inteligencia artificial está apagada (\u003Cstrong>IA OFF\u003C/strong>).\u003C/td>\n\u003Ctd>Encendela en \u003Ca href=\"/user-guide/configuracion-general#inteligencia-artificial\">Inteligencia Artificial\u003C/a>.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>Unifiqué dos productos que no eran iguales\u003C/strong>\u003C/td>\n\u003Ctd>Unificar no se puede deshacer.\u003C/td>\n\u003Ctd>Creá de nuevo el producto que falta en el \u003Ca href=\"/user-guide/maestro-de-productos\">Maestro de Productos\u003C/a>.\u003C/td>\n\u003C/tr>\n\u003C/tbody>\u003C/table>\u003C/div>\n",[5,9,12,15,18,21,24],{"id":6,"title":7,"level":8},"antes-de-empezar","Antes de empezar",2,{"id":10,"title":11,"level":8},"paso-1-entra-a-la-pantalla","Paso 1: Entrá a la pantalla",{"id":13,"title":14,"level":8},"paso-2-revisa-cada-grupo","Paso 2: Revisá cada grupo",{"id":16,"title":17,"level":8},"paso-3-mira-los-duplicados-de-un-producto","Paso 3: Mirá los duplicados de un producto",{"id":19,"title":20,"level":8},"paso-4-unifica-los-productos-repetidos","Paso 4: Unificá los productos repetidos",{"id":22,"title":23,"level":8},"paso-5-volve-a-buscar-o-sali","Paso 5: Volvé a buscar o salí",{"id":25,"title":26,"level":8},"resolucion-de-inconvenientes","Resolución de Inconvenientes",{"title":28,"description":29,"keywords":30},"Buscar Duplicados - Manual","¿Dónde está en el sistema?: Menú principal → Productos → Gestión Avanzada → Buscar Duplicados\n ¿Quién lo usa?: Administradores y encar...","analisis duplicados, paxapos, buscar duplicados, tutorial, guía, manual usuario","48-analisis-duplicados.txt"],"uses":{"params":["slug"]}}]}
