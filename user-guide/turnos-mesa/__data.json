{"type":"data","nodes":[null,{"type":"data","data":[{"moduleCategories":1},[2,17,44,53,77,98,110,140,146,173,185,221,250],{"title":3,"modules":4},"Comenzamos",[5,8,11,14],{"slug":6,"title":7},"introduccion","Bienvenido a tu software gastronómico",{"slug":9,"title":10},"iniciar-sesion","Cómo Iniciar Sesión",{"slug":12,"title":13},"recuperar-contrasena","Cómo Recuperar tu Contraseña",{"slug":15,"title":16},"guia-de-inicio-rapido","Guía de Inicio Rápido",{"title":18,"modules":19},"Ventas",[20,23,26,29,32,35,38,41],{"slug":21,"title":22},"salon-de-ventas","Cómo Usar el Salón de Ventas (Adición)",{"slug":24,"title":25},"caja-rapida","Cómo Usar la Caja Rápida (Registradora)",{"slug":27,"title":28},"mozos","Cómo Cargar los Mozos",{"slug":30,"title":31},"clientes","Cómo Gestionar los Clientes",{"slug":33,"title":34},"descuentos","Cómo Configurar Descuentos",{"slug":36,"title":37},"nueva-reserva","Cómo Cargar una Nueva Reserva",{"slug":39,"title":40},"listado-de-reservas","Cómo Usar el Listado de Reservas",{"slug":42,"title":43},"grilla-de-reservas","Cómo Usar la Grilla de Reservas",{"title":45,"modules":46},"Medios de Pago",[47,50],{"slug":48,"title":49},"configuracion-procesadores","Configuración de Procesadores de Pago",{"slug":51,"title":52},"transacciones-mercadopago","Transacciones MercadoPago",{"title":54,"modules":55},"Productos",[56,59,62,65,68,71,74],{"slug":57,"title":58},"menu","Menú de Productos (Carta)",{"slug":60,"title":61},"categorias","Categorías de Productos",{"slug":63,"title":64},"variantes-grupo-sabores","Variantes y Grupos de Sabores",{"slug":66,"title":67},"maestro-de-productos","Maestro de Productos",{"slug":69,"title":70},"subproductos-elaborados","Sub-Productos (Elaborados)",{"slug":72,"title":73},"recetas","Recetas",{"slug":75,"title":76},"analisis-duplicados","Buscar Duplicados",{"title":78,"modules":79},"Compras",[80,83,86,89,92,95],{"slug":81,"title":82},"todas-las-ordenes-compra","Órdenes de Compra",{"slug":84,"title":85},"crear-orden-compra","Crear una Orden de Compra",{"slug":87,"title":88},"ordenes-a-aprobar","Órdenes a aprobar",{"slug":90,"title":91},"mercaderias","Mercaderías",{"slug":93,"title":94},"proveedores","Proveedores",{"slug":96,"title":97},"historial-de-compras","Historial de Compras",{"title":99,"modules":100},"Stock",[101,104,107],{"slug":102,"title":103},"stock-mercaderias","Stock de Mercaderías",{"slug":105,"title":106},"stock-subproductos","Stock de Subproductos",{"slug":108,"title":109},"movimientos-de-stock","Movimientos de Stock",{"title":111,"modules":112},"Finanzas",[113,116,119,122,125,128,131,134,137],{"slug":114,"title":115},"arqueos-de-caja","Arqueos de Caja",{"slug":117,"title":118},"listado-de-cajas","Listado de Cajas",{"slug":120,"title":121},"transacciones-de-cobro","Transacciones de Cobro",{"slug":123,"title":124},"factura-manual","Factura Manual",{"slug":126,"title":127},"resumen-de-deuda","Resumen de Deuda",{"slug":129,"title":130},"pagos","Pagos",{"slug":132,"title":133},"historial-de-facturas","Historial de Facturas",{"slug":135,"title":136},"historico-de-mesas","Histórico de Mesas",{"slug":138,"title":139},"puntos-de-venta-pdv","Puntos de Venta (PDVs)",{"title":141,"modules":142},"Comandero",[143],{"slug":144,"title":145},"comandero","Comandero (pantalla de cocina)",{"title":147,"modules":148},"RRHH",[149,152,155,158,161,164,167,170],{"slug":150,"title":151},"empleados","Empleados",{"slug":153,"title":154},"empleados-trabajando","Empleados Trabajando",{"slug":156,"title":157},"registro-diario-fichaje","Registro Diario de Fichaje",{"slug":159,"title":160},"reporte-mensual-fichaje","Reporte Mensual de Fichaje",{"slug":162,"title":163},"departamentos","Departamentos",{"slug":165,"title":166},"turnos-y-horarios-fichaje","Turnos y Horarios de Fichaje",{"slug":168,"title":169},"sueldos-y-jornales","Sueldos y Jornales",{"slug":171,"title":172},"datos-de-acceso-app","Datos de Acceso a la App de Fichaje",{"title":174,"modules":175},"Reportes",[176,179,182],{"slug":177,"title":178},"tablero-general","Tablero General",{"slug":180,"title":181},"productos-mas-vendidos","Productos Más Vendidos",{"slug":183,"title":184},"compras-por-mercaderia","Compras por Mercadería",{"title":186,"modules":187},"Configuracion",[188,191,194,197,200,203,206,209,212,215,218],{"slug":189,"title":190},"configuracion-general","Configuración general",{"slug":192,"title":193},"impresoras","Cómo cargar las impresoras del local",{"slug":195,"title":196},"perfiles-de-impresion","Cómo usar los perfiles de impresión",{"slug":198,"title":199},"usuarios-del-sistema","Cómo administrar los Usuarios del Sistema",{"slug":201,"title":202},"usuarios-con-pin","Cómo administrar los Usuarios con PIN",{"slug":204,"title":205},"punto-de-venta","🏛️ Trámite en ARCA (con clave fiscal)",{"slug":207,"title":208},"permisos-por-rol","Cómo configurar los Permisos por Rol",{"slug":210,"title":211},"turnos-mesa","Turnos de Mesa",{"slug":213,"title":214},"medios-de-cobro","Medios de cobro",{"slug":216,"title":217},"clasificacion-de-gastos","Clasificación de Gastos",{"slug":219,"title":220},"centros-de-costo","Centros de Costo",{"title":222,"modules":223},"Biblioteca de Drivers",[224,226,229,232,235,238,241,244,247],{"slug":225,"title":222},"biblioteca-de-drivers",{"slug":227,"title":228},"sam4s-giant-100","Sam4S Giant - 100",{"slug":230,"title":231},"citizen-ct-s310ii","Citizen CT-S310II",{"slug":233,"title":234},"epson-tm-t20","Epson TM-T20",{"slug":236,"title":237},"drivers-genericos","Drivers Genéricos POS",{"slug":239,"title":240},"epson-tm-t88","Epson TM-T88V",{"slug":242,"title":243},"fiscalberry-windows","Instalar Fiscalberry en Windows",{"slug":245,"title":246},"fiscalberry-linux","Instalar Fiscalberry en Linux",{"slug":248,"title":249},"fiscalberry-android","Instalar Fiscalberry en Android",{"title":251,"modules":252},"Extra",[253,256,259,262,265,268,271,274,277,280],{"slug":254,"title":255},"01-faq-solucion-inicial-pantalla-congelada","📖 Manual de Usuario: Solución Inicial si la Pantalla se Congela o no Carga",{"slug":257,"title":258},"03-faq-mozo-reabrir-mesa-anulada","📖 Manual de Usuario: Cómo Reabrir una Mesa Anulada o Cerrada por Error",{"slug":260,"title":261},"05-faq-cajero-emitir-factura-a","📖 Manual de Usuario: Cómo Emitir una Factura A Cargando Datos del Cliente",{"slug":263,"title":264},"06-faq-cajero-ingreso-egreso-cajon","📖 Manual de Usuario: Cómo Registrar Entradas y Salidas de Dinero del Cajón",{"slug":266,"title":267},"07-faq-cajero-activar-medio-pago","📖 Manual de Usuario: Cómo Activar un Medio de Pago que no Aparece al Cobrar",{"slug":269,"title":270},"08-faq-cajero-diferencia-facturado-vs-abiertas","📖 Manual de Usuario: Diferencia entre \"Facturado Total Mesas\" y \"Abiertas Por Usuario\" en Caja",{"slug":272,"title":273},"10-faq-supervisor-cierre-caja-diferencias","📖 Manual de Usuario: Cómo Auditar y Solucionar Diferencias en el Cierre de Caja",{"slug":275,"title":276},"preguntas-frecuentes","Preguntas Frecuentes y Guías Rápidas por Rol",{"slug":278,"title":279},"buchon-bot","Buchón Bot",{"slug":281,"title":282},"troubleshooting-semantico","📖 Guía Única de Resolución de Problemas y Errores (Troubleshooting)"],"uses":{}},{"type":"data","data":[{"slug":1,"title":2,"content":3,"tableOfContents":4,"seo":30,"llmTxtFile":34},"turnos-mesa","Turnos de Mesa","\u003Cdiv id=\"turnos-de-mesa\">\u003C/div>\n\n\u003Cblockquote>\n\u003Cp>\u003Cstrong>¿Dónde está en el sistema?:\u003C/strong> Menú principal → \u003Cstrong>Configuración\u003C/strong> → \u003Cstrong>Turnos\u003C/strong>. Está debajo del título \u003Cstrong>Tablas del Sistema\u003C/strong>.\n\u003Cstrong>¿Quién lo usa?:\u003C/strong> Dueños y administradores\u003C/p>\n\u003C/blockquote>\n\u003Cblockquote>\n\u003Cp>🎯 \u003Cstrong>¿Para qué sirve esto?\u003C/strong>\nAcá definís las franjas del día en que trabaja tu local. Por ejemplo: \u003Cem>Desayuno\u003C/em>, \u003Cem>Almuerzo\u003C/em>, \u003Cem>Merienda\u003C/em> y \u003Cem>Cena\u003C/em>.\nCon esas franjas el sistema pone nombre al turno de cada arqueo de caja y arma el reporte de ventas por turno.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🔑 Antes de empezar\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"antes-de-empezar\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"antes-de-empezar\">\u003C/div>\n\n\u003Cul>\n\u003Cli>Tu usuario tiene que poder configurar el sistema. Mirá \u003Ca href=\"/user-guide/permisos-por-rol\">Permisos por Rol\u003C/a>.\u003C/li>\n\u003Cli>Los turnos no pueden pisarse entre sí. Si dos turnos comparten una hora, el sistema no deja guardar.\u003C/li>\n\u003Cli>Cada hora cuenta de a una: el turno de \u003Cem>12 a 16\u003C/em> cubre las horas 12, 13, 14 y 15.\u003C/li>\n\u003C/ul>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🧭 Para qué se usan los turnos en el resto del sistema\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"para-que-se-usan-los-turnos\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"para-que-se-usan-los-turnos\">\u003C/div>\n\n\u003Cul>\n\u003Cli>\u003Cstrong>Arqueos de Caja\u003C/strong>: el título del arqueo muestra el turno que corresponde a la hora de cierre. Por ejemplo: \u003Cem>Cena (de 20 a 6)\u003C/em>. Mirá \u003Ca href=\"/user-guide/arqueos-de-caja\">Arqueos de Caja\u003C/a>.\u003C/li>\n\u003Cli>\u003Cstrong>Ventas por Turnos\u003C/strong> (menú \u003Cstrong>Reportes\u003C/strong>): compara cuánto vendés en cada franja y en cada día de la semana.\u003C/li>\n\u003Cli>\u003Cstrong>Reservas\u003C/strong>: si usás reservas, cada turno puede tener un límite de comensales. Ese límite se carga en la ventanita del turno.\u003C/li>\n\u003C/ul>\n\u003Cblockquote>\n\u003Cp>💡 \u003Cstrong>Consejo útil:\u003C/strong> si no cargás turnos, esas pantallas siguen funcionando. Solo van a mostrar el turno vacío.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                📍 Paso 1: Entrá a la pantalla\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-1-entra-a-la-pantalla\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-1-entra-a-la-pantalla\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/110-configuracion/130-00a-menu-grupo-configuracion.png\" alt=\"Menú lateral con el grupo Configuración marcado en rojo\">\u003C/p>\n\u003Col>\n\u003Cli>En el menú de la izquierda, tocá \u003Cstrong>Configuración\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/110-configuracion/130-00b-menu-opcion-turnos.png\" alt=\"Opción Turnos marcada en rojo, debajo del título Tablas del Sistema\">\u003C/p>\n\u003Col start=\"2\">\n\u003Cli>Tocá \u003Cstrong>Turnos\u003C/strong>. Está debajo del título \u003Cstrong>Tablas del Sistema\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/110-configuracion/130-01-pantalla-turnos.png\" alt=\"Pantalla Gestión de Turnos con la línea de tiempo y las tarjetas de Desayuno, Almuerzo, Merienda y Cena\">\u003C/p>\n\u003Cp>Así se ve la pantalla \u003Cstrong>Gestión de Turnos\u003C/strong>. Tiene tres partes:\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Línea de tiempo de 24 horas\u003C/strong>: dibuja cada turno como una barra. Sirve para ver si se pisan.\u003C/li>\n\u003Cli>\u003Cstrong>Una tarjeta por turno\u003C/strong>: muestra el nombre, el horario, la duración, la hora de inicio y la de fin. Abajo tiene los botones \u003Cstrong>Editar\u003C/strong> y \u003Cstrong>Eliminar\u003C/strong> (Paso 5).\u003C/li>\n\u003Cli>Si un turno termina después de la medianoche, la tarjeta lo avisa con \u003Cem>(cruza medianoche)\u003C/em>.\u003C/li>\n\u003C/ul>\n\u003Cp>Si todavía no cargaste ninguno, ves el aviso \u003Cem>No hay turnos configurados\u003C/em> y el botón \u003Cstrong>Crear Primer Turno\u003C/strong>.\u003C/p>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                ➕ Paso 2: Tocá el botón &quot;Nuevo Turno&quot;\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-2-toca-el-boton-nuevo-turno\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-2-toca-el-boton-nuevo-turno\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/110-configuracion/130-02-donde-esta-boton-nuevo-turno.png\" alt=\"Botón verde Nuevo Turno marcado en rojo arriba a la derecha\">\u003C/p>\n\u003Col>\n\u003Cli>Buscá el botón verde \u003Cstrong>Nuevo Turno\u003C/strong>. Está arriba a la derecha.\u003C/li>\n\u003Cli>Tocalo una vez.\u003C/li>\n\u003Cli>Se abre la pantalla para cargar los datos del turno.\u003C/li>\n\u003C/ol>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                📝 Paso 3: Completá los datos del turno\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-3-completa-los-datos-del-turno\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-3-completa-los-datos-del-turno\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/110-configuracion/130-03-formulario-nuevo-turno.png\" alt=\"Formulario Nuevo Turno con Brunch Prueba de 11 a 12 y los botones Cancelar y Guardar Turno\">\u003C/p>\n\u003Cp>Escribimos el ejemplo \u003Cem>Brunch Prueba\u003C/em>, de 11 a 12. Los casilleros son:\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Horario del turno\u003C/strong> (recuadro violeta): se actualiza solo. Muestra el horario y las horas de duración.\u003C/li>\n\u003Cli>\u003Cstrong>Vista previa en línea de tiempo\u003C/strong>: una barrita que muestra dónde cae el turno en el día.\u003C/li>\n\u003Cli>\u003Cstrong>Nombre del Turno\u003C/strong>: escribí cómo lo vas a llamar. Por ejemplo: \u003Cem>Brunch Prueba\u003C/em>.\u003C/li>\n\u003Cli>\u003Cstrong>Hora inicio\u003C/strong>: la hora en que empieza, de 0 a 23. Los botones de abajo (7:00, 10:00, 12:00, 19:00) la cargan de un toque.\u003C/li>\n\u003Cli>\u003Cstrong>Hora fin\u003C/strong>: la hora en que termina, de 0 a 23. Los botones de abajo (11:00, 16:00, 20:00, 23:00) la cargan de un toque.\u003C/li>\n\u003Cli>\u003Cstrong>Aviso naranja de medianoche\u003C/strong>: no se ve en la foto. Aparece si la hora fin es menor que la de inicio. Es normal en turnos de noche.\u003C/li>\n\u003Cli>\u003Cstrong>Límite de comensales por turno\u003C/strong> y \u003Cstrong>Límite de comensales por reserva\u003C/strong>: solo aparecen si tenés el módulo de reservas. Dejalos vacíos si no querés límite.\u003C/li>\n\u003Cli>\u003Cstrong>Cancelar\u003C/strong>: vuelve a la lista sin guardar nada.\u003C/li>\n\u003Cli>\u003Cstrong>Guardar Turno\u003C/strong>: guarda el turno.\u003C/li>\n\u003C/ul>\n\u003Cblockquote>\n\u003Cp>💡 \u003Cstrong>Consejo útil:\u003C/strong> elegí siempre horas que no use otro turno. Mirá la línea de tiempo de la pantalla anterior.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                💾 Paso 4: Guardá el turno\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-4-guarda-el-turno\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-4-guarda-el-turno\">\u003C/div>\n\n\u003Col>\n\u003Cli>Revisá el nombre y las horas.\u003C/li>\n\u003Cli>Tocá \u003Cstrong>Guardar Turno\u003C/strong>.\u003C/li>\n\u003Cli>Volvés a la lista y ves la tarjeta nueva.\u003C/li>\n\u003C/ol>\n\u003Cp>Si no querés seguir, tocá \u003Cstrong>Cancelar\u003C/strong>. No se guarda nada.\u003C/p>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                ✏️ Paso 5: Cambiá o borrá un turno\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-5-cambia-o-borra-un-turno\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-5-cambia-o-borra-un-turno\">\u003C/div>\n\n\u003Cp>En la pantalla del Paso 1, cada tarjeta tiene dos botones abajo:\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Editar\u003C/strong> (blanco): abre los mismos casilleros del Paso 3, ya cargados. Cambiá lo que necesites y tocá \u003Cstrong>Guardar Turno\u003C/strong>.\u003C/li>\n\u003Cli>\u003Cstrong>Eliminar\u003C/strong> (rojo): borra el turno. Antes te pide confirmación.\u003C/li>\n\u003C/ul>\n\u003Cblockquote>\n\u003Cp>⚠️ \u003Cstrong>Atención:\u003C/strong> al tocar \u003Cstrong>Eliminar\u003C/strong> y confirmar, el turno se pierde. Los arqueos y reportes viejos dejan de mostrar ese nombre de turno.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                ⚠️ Resolución de Inconvenientes\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"resolucion-de-inconvenientes\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"resolucion-de-inconvenientes\">\u003C/div>\n\n\u003Cdiv class=\"table-wrapper\">\u003Ctable>\n\u003Cthead>\n\u003Ctr>\n\u003Cth>Problema\u003C/th>\n\u003Cth>Causa más frecuente\u003C/th>\n\u003Cth>Solución recomendada\u003C/th>\n\u003C/tr>\n\u003C/thead>\n\u003Ctbody>\u003Ctr>\n\u003Ctd>\u003Cstrong>&quot;Este turno se solapa con otro turno existente&quot;\u003C/strong>\u003C/td>\n\u003Ctd>Alguna hora del turno ya pertenece a otro.\u003C/td>\n\u003Ctd>Mirá la línea de tiempo. Cambiá la hora inicio o fin, o editá el otro turno.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>&quot;El nombre del turno es requerido&quot;\u003C/strong>\u003C/td>\n\u003Ctd>Dejaste el nombre vacío.\u003C/td>\n\u003Ctd>Escribí un nombre y guardá de nuevo.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>&quot;La hora debe estar entre 0 y 23&quot;\u003C/strong>\u003C/td>\n\u003Ctd>Escribiste 24 o un número negativo.\u003C/td>\n\u003Ctd>Para medianoche usá 0.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>No ves \u003Cstrong>Turnos\u003C/strong> en el menú.\u003C/td>\n\u003Ctd>Tu usuario no tiene permiso.\u003C/td>\n\u003Ctd>Pedile a un administrador que revise \u003Ca href=\"/user-guide/permisos-por-rol\">Permisos por Rol\u003C/a>.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>El arqueo no muestra el nombre del turno.\u003C/td>\n\u003Ctd>Ningún turno cubre la hora de cierre.\u003C/td>\n\u003Ctd>Cargá un turno que abarque esa hora.\u003C/td>\n\u003C/tr>\n\u003C/tbody>\u003C/table>\u003C/div>\n",[5,9,12,15,18,21,24,27],{"id":6,"title":7,"level":8},"antes-de-empezar","Antes de empezar",2,{"id":10,"title":11,"level":8},"para-que-se-usan-los-turnos","Para qué se usan los turnos en el resto del sistema",{"id":13,"title":14,"level":8},"paso-1-entra-a-la-pantalla","Paso 1: Entrá a la pantalla",{"id":16,"title":17,"level":8},"paso-2-toca-el-boton-nuevo-turno","Paso 2: Tocá el botón \"Nuevo Turno\"",{"id":19,"title":20,"level":8},"paso-3-completa-los-datos-del-turno","Paso 3: Completá los datos del turno",{"id":22,"title":23,"level":8},"paso-4-guarda-el-turno","Paso 4: Guardá el turno",{"id":25,"title":26,"level":8},"paso-5-cambia-o-borra-un-turno","Paso 5: Cambiá o borrá un turno",{"id":28,"title":29,"level":8},"resolucion-de-inconvenientes","Resolución de Inconvenientes",{"title":31,"description":32,"keywords":33},"Turnos de Mesa - Manual","¿Dónde está en el sistema?: Menú principal → Configuración → Turnos. Está debajo del título Tablas del Sistema.\n ¿Quién lo usa?: Dueño...","turnos mesa, paxapos, turnos de mesa, tutorial, guía, manual usuario","130-turnos-mesa.txt"],"uses":{"params":["slug"]}}]}
