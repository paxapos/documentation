{"type":"data","nodes":[null,{"type":"data","data":[{"moduleCategories":1},[2,17,44,53,77,98,110,140,146,173,185,221,250],{"title":3,"modules":4},"Comenzamos",[5,8,11,14],{"slug":6,"title":7},"introduccion","Bienvenido a tu software gastronómico",{"slug":9,"title":10},"iniciar-sesion","Cómo Iniciar Sesión",{"slug":12,"title":13},"recuperar-contrasena","Cómo Recuperar tu Contraseña",{"slug":15,"title":16},"guia-de-inicio-rapido","Guía de Inicio Rápido",{"title":18,"modules":19},"Ventas",[20,23,26,29,32,35,38,41],{"slug":21,"title":22},"salon-de-ventas","Cómo Usar el Salón de Ventas (Adición)",{"slug":24,"title":25},"caja-rapida","Cómo Usar la Caja Rápida (Registradora)",{"slug":27,"title":28},"mozos","Cómo Cargar los Mozos",{"slug":30,"title":31},"clientes","Cómo Gestionar los Clientes",{"slug":33,"title":34},"descuentos","Cómo Configurar Descuentos",{"slug":36,"title":37},"nueva-reserva","Cómo Cargar una Nueva Reserva",{"slug":39,"title":40},"listado-de-reservas","Cómo Usar el Listado de Reservas",{"slug":42,"title":43},"grilla-de-reservas","Cómo Usar la Grilla de Reservas",{"title":45,"modules":46},"Medios de Pago",[47,50],{"slug":48,"title":49},"configuracion-procesadores","Configuración de Procesadores de Pago",{"slug":51,"title":52},"transacciones-mercadopago","Transacciones MercadoPago",{"title":54,"modules":55},"Productos",[56,59,62,65,68,71,74],{"slug":57,"title":58},"menu","Menú de Productos (Carta)",{"slug":60,"title":61},"categorias","Categorías de Productos",{"slug":63,"title":64},"variantes-grupo-sabores","Variantes y Grupos de Sabores",{"slug":66,"title":67},"maestro-de-productos","Maestro de Productos",{"slug":69,"title":70},"subproductos-elaborados","Sub-Productos (Elaborados)",{"slug":72,"title":73},"recetas","Recetas",{"slug":75,"title":76},"analisis-duplicados","Buscar Duplicados",{"title":78,"modules":79},"Compras",[80,83,86,89,92,95],{"slug":81,"title":82},"todas-las-ordenes-compra","Órdenes de Compra",{"slug":84,"title":85},"crear-orden-compra","Crear una Orden de Compra",{"slug":87,"title":88},"ordenes-a-aprobar","Órdenes a aprobar",{"slug":90,"title":91},"mercaderias","Mercaderías",{"slug":93,"title":94},"proveedores","Proveedores",{"slug":96,"title":97},"historial-de-compras","Historial de Compras",{"title":99,"modules":100},"Stock",[101,104,107],{"slug":102,"title":103},"stock-mercaderias","Stock de Mercaderías",{"slug":105,"title":106},"stock-subproductos","Stock de Subproductos",{"slug":108,"title":109},"movimientos-de-stock","Movimientos de Stock",{"title":111,"modules":112},"Finanzas",[113,116,119,122,125,128,131,134,137],{"slug":114,"title":115},"arqueos-de-caja","Arqueos de Caja",{"slug":117,"title":118},"listado-de-cajas","Listado de Cajas",{"slug":120,"title":121},"transacciones-de-cobro","Transacciones de Cobro",{"slug":123,"title":124},"factura-manual","Factura Manual",{"slug":126,"title":127},"resumen-de-deuda","Resumen de Deuda",{"slug":129,"title":130},"pagos","Pagos",{"slug":132,"title":133},"historial-de-facturas","Historial de Facturas",{"slug":135,"title":136},"historico-de-mesas","Histórico de Mesas",{"slug":138,"title":139},"puntos-de-venta-pdv","Puntos de Venta (PDVs)",{"title":141,"modules":142},"Comandero",[143],{"slug":144,"title":145},"comandero","Comandero (pantalla de cocina)",{"title":147,"modules":148},"RRHH",[149,152,155,158,161,164,167,170],{"slug":150,"title":151},"empleados","Empleados",{"slug":153,"title":154},"empleados-trabajando","Empleados Trabajando",{"slug":156,"title":157},"registro-diario-fichaje","Registro Diario de Fichaje",{"slug":159,"title":160},"reporte-mensual-fichaje","Reporte Mensual de Fichaje",{"slug":162,"title":163},"departamentos","Departamentos",{"slug":165,"title":166},"turnos-y-horarios-fichaje","Turnos y Horarios de Fichaje",{"slug":168,"title":169},"sueldos-y-jornales","Sueldos y Jornales",{"slug":171,"title":172},"datos-de-acceso-app","Datos de Acceso a la App de Fichaje",{"title":174,"modules":175},"Reportes",[176,179,182],{"slug":177,"title":178},"tablero-general","Tablero General",{"slug":180,"title":181},"productos-mas-vendidos","Productos Más Vendidos",{"slug":183,"title":184},"compras-por-mercaderia","Compras por Mercadería",{"title":186,"modules":187},"Configuracion",[188,191,194,197,200,203,206,209,212,215,218],{"slug":189,"title":190},"configuracion-general","Configuración general",{"slug":192,"title":193},"impresoras","Cómo cargar las impresoras del local",{"slug":195,"title":196},"perfiles-de-impresion","Cómo usar los perfiles de impresión",{"slug":198,"title":199},"usuarios-del-sistema","Cómo administrar los Usuarios del Sistema",{"slug":201,"title":202},"usuarios-con-pin","Cómo administrar los Usuarios con PIN",{"slug":204,"title":205},"punto-de-venta","🏛️ Trámite en ARCA (con clave fiscal)",{"slug":207,"title":208},"permisos-por-rol","Cómo configurar los Permisos por Rol",{"slug":210,"title":211},"turnos-mesa","Turnos de Mesa",{"slug":213,"title":214},"medios-de-cobro","Medios de cobro",{"slug":216,"title":217},"clasificacion-de-gastos","Clasificación de Gastos",{"slug":219,"title":220},"centros-de-costo","Centros de Costo",{"title":222,"modules":223},"Biblioteca de Drivers",[224,226,229,232,235,238,241,244,247],{"slug":225,"title":222},"biblioteca-de-drivers",{"slug":227,"title":228},"sam4s-giant-100","Sam4S Giant - 100",{"slug":230,"title":231},"citizen-ct-s310ii","Citizen CT-S310II",{"slug":233,"title":234},"epson-tm-t20","Epson TM-T20",{"slug":236,"title":237},"drivers-genericos","Drivers Genéricos POS",{"slug":239,"title":240},"epson-tm-t88","Epson TM-T88V",{"slug":242,"title":243},"fiscalberry-windows","Instalar Fiscalberry en Windows",{"slug":245,"title":246},"fiscalberry-linux","Instalar Fiscalberry en Linux",{"slug":248,"title":249},"fiscalberry-android","Instalar Fiscalberry en Android",{"title":251,"modules":252},"Extra",[253,256,259,262,265,268,271,274,277,280],{"slug":254,"title":255},"01-faq-solucion-inicial-pantalla-congelada","📖 Manual de Usuario: Solución Inicial si la Pantalla se Congela o no Carga",{"slug":257,"title":258},"03-faq-mozo-reabrir-mesa-anulada","📖 Manual de Usuario: Cómo Reabrir una Mesa Anulada o Cerrada por Error",{"slug":260,"title":261},"05-faq-cajero-emitir-factura-a","📖 Manual de Usuario: Cómo Emitir una Factura A Cargando Datos del Cliente",{"slug":263,"title":264},"06-faq-cajero-ingreso-egreso-cajon","📖 Manual de Usuario: Cómo Registrar Entradas y Salidas de Dinero del Cajón",{"slug":266,"title":267},"07-faq-cajero-activar-medio-pago","📖 Manual de Usuario: Cómo Activar un Medio de Pago que no Aparece al Cobrar",{"slug":269,"title":270},"08-faq-cajero-diferencia-facturado-vs-abiertas","📖 Manual de Usuario: Diferencia entre \"Facturado Total Mesas\" y \"Abiertas Por Usuario\" en Caja",{"slug":272,"title":273},"10-faq-supervisor-cierre-caja-diferencias","📖 Manual de Usuario: Cómo Auditar y Solucionar Diferencias en el Cierre de Caja",{"slug":275,"title":276},"preguntas-frecuentes","Preguntas Frecuentes y Guías Rápidas por Rol",{"slug":278,"title":279},"buchon-bot","Buchón Bot",{"slug":281,"title":282},"troubleshooting-semantico","📖 Guía Única de Resolución de Problemas y Errores (Troubleshooting)"],"uses":{}},{"type":"data","data":[{"slug":1,"title":2,"content":3,"tableOfContents":4,"seo":33,"llmTxtFile":37},"pagos","Pagos","\u003Cdiv id=\"pagos\">\u003C/div>\n\n\u003Cblockquote>\n\u003Cp>\u003Cstrong>¿Dónde está en el sistema?:\u003C/strong> Menú principal → \u003Cstrong>Finanzas\u003C/strong> → \u003Cstrong>Facturas y Pagos\u003C/strong> → \u003Cstrong>Pagos\u003C/strong>\n\u003Cstrong>¿Quién lo usa?:\u003C/strong> Tesoreros, cajeros y administradores\u003C/p>\n\u003C/blockquote>\n\u003Cblockquote>\n\u003Cp>🎯 \u003Cstrong>¿Para qué sirve esto?\u003C/strong>\nEs la lista de todos los pagos que hiciste a tus proveedores.\nPodés buscar un pago, ver qué facturas pagó y corregirlo si hizo falta.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🔑 Antes de empezar\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"antes-de-empezar\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"antes-de-empezar\">\u003C/div>\n\n\u003Cul>\n\u003Cli>Tu usuario tiene que tener el permiso de \u003Cstrong>Pagos\u003C/strong> en \u003Ca href=\"/user-guide/permisos-por-rol\">Permisos por Rol\u003C/a>.\u003C/li>\n\u003Cli>Un pago se registra desde una factura. Mirá el Paso 7 de esta página.\u003C/li>\n\u003Cli>Los botones \u003Cstrong>Órdenes Pendientes\u003C/strong> y \u003Cstrong>Compromisos\u003C/strong> aparecen si tu comercio usa órdenes de pago. El botón \u003Cstrong>Retenciones\u003C/strong>, si usa retenciones.\u003C/li>\n\u003C/ul>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                📍 Paso 1: Entrá a la pantalla\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-1-entra-a-la-pantalla\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-1-entra-a-la-pantalla\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/70-finanzas/78-00a-menu-grupo-finanzas.png\" alt=\"Menú lateral con el grupo Finanzas marcado en rojo\">\u003C/p>\n\u003Col>\n\u003Cli>En el menú de la izquierda, tocá \u003Cstrong>Finanzas\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/70-finanzas/78-00b-menu-opcion-pagos.png\" alt=\"Opción Pagos marcada en rojo, debajo del título Facturas y Pagos\">\u003C/p>\n\u003Col start=\"2\">\n\u003Cli>Tocá \u003Cstrong>Pagos\u003C/strong>. Está debajo del título \u003Cstrong>FACTURAS Y PAGOS\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/70-finanzas/78-01-pantalla-pagos.png\" alt=\"Pantalla Listado de Pagos con los botones de arriba, el buscador y la lista de pagos realizados\">\u003C/p>\n\u003Cp>Así se ve la pantalla. Arriba están los botones y el buscador. Abajo, la lista con los pagos más nuevos primero.\u003C/p>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🔘 Paso 2: Conocé los botones de arriba\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-2-conoce-los-botones-de-arriba\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-2-conoce-los-botones-de-arriba\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/70-finanzas/78-02-botones-de-arriba.png\" alt=\"Tres botones juntos: Retenciones en rojo, Órdenes Pendientes en naranja y Compromisos en azul\">\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Retenciones\u003C/strong>: abre el libro con las retenciones que se descontaron a tus proveedores.\u003C/li>\n\u003Cli>\u003Cstrong>Órdenes Pendientes\u003C/strong>: abre los pagos que esperan aprobación.\u003C/li>\n\u003Cli>\u003Cstrong>Compromisos\u003C/strong>: abre los cheques y pagos que se cobran más adelante.\u003C/li>\n\u003C/ul>\n\u003Cp>Cada uno se explica en el Paso 6.\u003C/p>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🔎 Paso 3: Buscá un pago\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-3-busca-un-pago\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-3-busca-un-pago\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/70-finanzas/78-03-buscador.png\" alt=\"Buscador con Importe, Identificador Pago, Tipo de Pago, Proveedor, Estado, Sin Clasificar, Clasificación, cuatro fechas y los botones Descargar Excel y Buscar\">\u003C/p>\n\u003Cp>Completá lo que sepas y tocá \u003Cstrong>Buscar\u003C/strong>. Podés usar uno o varios casilleros:\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Importe\u003C/strong>: cuánto se pagó. Escribí el número exacto. Por ejemplo: \u003Cem>33100\u003C/em>.\u003C/li>\n\u003Cli>\u003Cstrong>Identificador Pago\u003C/strong>: el número del cheque o de la transferencia.\u003C/li>\n\u003Cli>\u003Cstrong>Tipo de Pago\u003C/strong>: cómo se pagó. Por ejemplo: \u003Cstrong>Cheque\u003C/strong>.\u003C/li>\n\u003Cli>\u003Cstrong>Proveedor\u003C/strong>: a quién se le pagó.\u003C/li>\n\u003Cli>\u003Cstrong>Estado\u003C/strong>: \u003Cstrong>Pendiente\u003C/strong>, \u003Cstrong>Aprobado\u003C/strong>, \u003Cstrong>Rechazado\u003C/strong> o \u003Cstrong>Pagado\u003C/strong>.\u003C/li>\n\u003Cli>\u003Cstrong>Sin Clasificar\u003C/strong>: tildalo para ver los pagos de facturas que no tienen clasificación.\u003C/li>\n\u003Cli>\u003Cstrong>Clasificación\u003C/strong>: el tipo de gasto que pagó.\u003C/li>\n\u003Cli>\u003Cstrong>Pago desde\u003C/strong> y \u003Cstrong>Pago hasta\u003C/strong>: el rango de fechas en que hiciste el pago.\u003C/li>\n\u003Cli>\u003Cstrong>Gasto desde\u003C/strong> y \u003Cstrong>Gasto hasta\u003C/strong>: el rango de fechas de la factura pagada.\u003C/li>\n\u003Cli>\u003Cstrong>Descargar Excel\u003C/strong>: baja la lista de pagos en una planilla. Respeta los filtros que pusiste.\u003C/li>\n\u003Cli>\u003Cstrong>Buscar\u003C/strong>: muestra solo los pagos que cumplen lo que pediste.\u003C/li>\n\u003C/ul>\n\u003Cblockquote>\n\u003Cp>💡 \u003Cstrong>Consejo útil:\u003C/strong> para ver todo otra vez, borrá los casilleros y tocá \u003Cstrong>Buscar\u003C/strong>.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                📋 Paso 4: Leé la lista de pagos\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-4-lee-la-lista-de-pagos\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-4-lee-la-lista-de-pagos\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/70-finanzas/78-04-lista-de-pagos.png\" alt=\"Lista de pagos realizados con el primer pago desplegado, que muestra la factura que pagó\">\u003C/p>\n\u003Cp>Arriba a la derecha de la lista se lee cuántos pagos hay. Cada renglón es un pago. Las columnas dicen:\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>#ID\u003C/strong>: el número del pago.\u003C/li>\n\u003Cli>\u003Cstrong>Fecha de Pago\u003C/strong>: cuándo se hizo. Si tiene fecha programada, aparece abajo con un calendario.\u003C/li>\n\u003Cli>\u003Cstrong>Tipo de Pago\u003C/strong>: cómo se pagó. Debajo puede estar el código del cheque o transferencia.\u003C/li>\n\u003Cli>\u003Cstrong>Importe Total\u003C/strong>: cuánto se pagó en total.\u003C/li>\n\u003Cli>\u003Cstrong>Observación\u003C/strong>: la nota que se escribió al pagar.\u003C/li>\n\u003Cli>\u003Cstrong>Gastos\u003C/strong>: a cuántas facturas se aplicó el pago.\u003C/li>\n\u003Cli>\u003Cstrong>Arqueo\u003C/strong>: el arqueo de caja donde salió la plata. Si no salió de la caja, hay un guion. Mirá \u003Ca href=\"/user-guide/arqueos-de-caja\">Arqueos de Caja\u003C/a>.\u003C/li>\n\u003Cli>\u003Cstrong>Creador\u003C/strong>: quién cargó el pago y cuándo.\u003C/li>\n\u003Cli>\u003Cstrong>Acciones\u003C/strong>: el botón de los tres puntitos (⋮). Se explica en el Paso 5.\u003C/li>\n\u003C/ul>\n\u003Cp>Si un pago no está confirmado, arriba de su fecha se ve una etiqueta con su estado. Por ejemplo: \u003Cstrong>Pendiente\u003C/strong>.\u003C/p>\n\u003Cp>Para ver qué facturas pagó un pago, tocá el triángulo \u003Cstrong>▶\u003C/strong> de su renglón, o cualquier parte del renglón. Se despliega una tarjeta por cada factura, con estos datos:\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Proveedor\u003C/strong>: a quién se le pagó.\u003C/li>\n\u003Cli>\u003Cstrong>Factura\u003C/strong>: la letra y el número.\u003C/li>\n\u003Cli>\u003Cstrong>Fecha Gasto\u003C/strong>: la fecha de la factura.\u003C/li>\n\u003Cli>\u003Cstrong>Total Gasto\u003C/strong>: cuánto vale la factura.\u003C/li>\n\u003Cli>\u003Cstrong>Pagado\u003C/strong>: cuánto de esa factura se pagó con este pago.\u003C/li>\n\u003Cli>\u003Cstrong>Ver Detalle Completo\u003C/strong>: abre el pago con todos sus datos.\u003C/li>\n\u003C/ul>\n\u003Cp>Volvé a tocar el renglón para cerrarlo.\u003C/p>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                ⋮ Paso 5: Abrí el menú de un pago\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-5-abri-el-menu-de-un-pago\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-5-abri-el-menu-de-un-pago\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/70-finanzas/78-05-menu-de-un-pago.png\" alt=\"Lista de pagos con el menú del primer pago abierto: Ver Pago Completo, Cambiar Creador, Asignar Arqueo, Editar Pago y Eliminar Pago\">\u003C/p>\n\u003Col>\n\u003Cli>En el renglón del pago, tocá el botón de los tres puntitos (⋮), en la columna \u003Cstrong>Acciones\u003C/strong>.\u003C/li>\n\u003Cli>Se abre una lista. Tocá lo que necesites:\u003C/li>\n\u003C/ol>\n\u003Cul>\n\u003Cli>\u003Cstrong>Ver Pago Completo\u003C/strong>: muestra todos los datos del pago y sus facturas.\u003C/li>\n\u003Cli>\u003Cstrong>Cambiar Creador\u003C/strong>: cambia quién figura como creador del pago.\u003C/li>\n\u003Cli>\u003Cstrong>Asignar Arqueo\u003C/strong>: elige en qué arqueo de caja queda el pago.\u003C/li>\n\u003Cli>\u003Cstrong>Editar Pago\u003C/strong>: corrige los datos del pago.\u003C/li>\n\u003Cli>\u003Cstrong>Eliminar Pago\u003C/strong>: borra el pago. Pregunta antes de borrar.\u003C/li>\n\u003C/ul>\n\u003Cblockquote>\n\u003Cp>⚠️ \u003Cstrong>Atención:\u003C/strong> \u003Cstrong>Eliminar Pago\u003C/strong> saca el pago y la factura vuelve a figurar como deuda. Usalo solo si lo cargaste por error.\u003C/p>\n\u003C/blockquote>\n\u003Cp>Solo ves las opciones que están debajo de \u003Cstrong>Ver Pago Completo\u003C/strong> si el pago es del arqueo de caja actual, o si sos administrador. Los pagos de arqueos ya cerrados solo se pueden mirar.\u003C/p>\n\u003Cp>Si el pago es una orden pendiente, la lista suma \u003Cstrong>Aprobar Orden\u003C/strong> y \u003Cstrong>Rechazar Orden\u003C/strong>. Si ya está aprobada, suma \u003Cstrong>Ejecutar Pago\u003C/strong>.\u003C/p>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🗂️ Paso 6: Recorré las tres solapas\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-6-recorre-las-tres-solapas\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-6-recorre-las-tres-solapas\">\u003C/div>\n\n\u003Ch3>Órdenes Pendientes\u003C/h3>\n\u003Cp>Tocá \u003Cstrong>Órdenes Pendientes\u003C/strong> arriba a la derecha.\u003C/p>\n\u003Cp>\u003Cimg src=\"/images/manual/70-finanzas/78-06-solapa-ordenes-pendientes.png\" alt=\"Pantalla Órdenes de Pago Pendientes con el mensaje No hay órdenes de pago pendientes y los botones Ver Todos los Pagos y Compromisos\">\u003C/p>\n\u003Cp>Acá están los pagos que cargó alguien y todavía nadie aprobó. Si no hay ninguno, ves el cartel \u003Cstrong>No hay órdenes de pago pendientes\u003C/strong>, como en la foto. Cada orden es un renglón con estos datos:\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>#ID\u003C/strong>, \u003Cstrong>Estado\u003C/strong>, \u003Cstrong>Tipo de Pago\u003C/strong>, \u003Cstrong>Importe\u003C/strong> y \u003Cstrong>Proveedor\u003C/strong>.\u003C/li>\n\u003Cli>\u003Cstrong>Fecha Programada\u003C/strong>: cuándo hay que pagar. En rojo si ya venció.\u003C/li>\n\u003Cli>\u003Cstrong>Creado\u003C/strong>, \u003Cstrong>Creador\u003C/strong> y \u003Cstrong>Observación\u003C/strong>.\u003C/li>\n\u003Cli>\u003Cstrong>Acciones\u003C/strong>: el ojo para ver el detalle. Y, si tu usuario tiene permiso, los botones \u003Cstrong>Aprobar\u003C/strong> y \u003Cstrong>Rechazar\u003C/strong>.\u003C/li>\n\u003C/ul>\n\u003Cp>Si hay órdenes que vencen en los próximos 7 días, arriba aparece un aviso amarillo que las lista.\u003C/p>\n\u003Cblockquote>\n\u003Cp>⚠️ \u003Cstrong>Atención:\u003C/strong> \u003Cstrong>Aprobar\u003C/strong> deja la orden lista para pagar. Confirmá el importe y el proveedor antes de tocarlo. Un pago aprobado se cobra con \u003Cstrong>Ejecutar Pago\u003C/strong>.\u003C/p>\n\u003C/blockquote>\n\u003Cp>Arriba a la derecha, \u003Cstrong>Ver Todos los Pagos\u003C/strong> vuelve a la lista y \u003Cstrong>Compromisos\u003C/strong> abre la solapa siguiente.\u003C/p>\n\u003Ch3>Compromisos\u003C/h3>\n\u003Cp>Tocá \u003Cstrong>Compromisos\u003C/strong> arriba a la derecha.\u003C/p>\n\u003Cp>\u003Cimg src=\"/images/manual/70-finanzas/78-07-solapa-compromisos.png\" alt=\"Pantalla Compromisos de Pago con los botones Todos, Pendiente, Aprobado, Rechazado y Pagado, y el mensaje No hay compromisos de pago\">\u003C/p>\n\u003Cp>Acá están los cheques, pagarés y pagos que se cobran más adelante. Si no hay ninguno, ves el cartel \u003Cstrong>No hay compromisos de pago\u003C/strong>, como en la foto.\u003C/p>\n\u003Cul>\n\u003Cli>Arriba hay una tarjeta por cada estado, con el total y la cantidad de compromisos.\u003C/li>\n\u003Cli>Los botones \u003Cstrong>Todos\u003C/strong>, \u003Cstrong>Pendiente\u003C/strong>, \u003Cstrong>Aprobado\u003C/strong>, \u003Cstrong>Rechazado\u003C/strong> y \u003Cstrong>Pagado\u003C/strong> muestran solo los de ese estado.\u003C/li>\n\u003Cli>Cada renglón muestra el \u003Cstrong>Identificador\u003C/strong>, el \u003Cstrong>Importe\u003C/strong>, la \u003Cstrong>Fecha Programada\u003C/strong> y la \u003Cstrong>Fecha Pagado\u003C/strong>.\u003C/li>\n\u003Cli>Si un compromiso no está pagado y venció, la fecha sale en rojo con el aviso \u003Cstrong>Vencido\u003C/strong>.\u003C/li>\n\u003Cli>Los botones \u003Cstrong>Pendientes\u003C/strong> y \u003Cstrong>Todos los Pagos\u003C/strong> de arriba te llevan a las otras pantallas.\u003C/li>\n\u003C/ul>\n\u003Ch3>Retenciones\u003C/h3>\n\u003Cp>Tocá \u003Cstrong>Retenciones\u003C/strong> arriba a la derecha.\u003C/p>\n\u003Cp>\u003Cimg src=\"/images/manual/70-finanzas/78-08-solapa-retenciones.png\" alt=\"Pantalla Libro de Retenciones con el buscador Desde, Hasta, Proveedor, Régimen y Estado, tres tarjetas con totales y una tabla vacía\">\u003C/p>\n\u003Cp>Es el libro de las retenciones que descontaste a tus proveedores al pagarles. Sirve para tu contador.\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Desde\u003C/strong> y \u003Cstrong>Hasta\u003C/strong>: el rango de fechas. Trae el mes actual.\u003C/li>\n\u003Cli>\u003Cstrong>Proveedor\u003C/strong>: solo las retenciones de ese proveedor.\u003C/li>\n\u003Cli>\u003Cstrong>Régimen\u003C/strong>: el tipo de retención. Por ejemplo: \u003Cstrong>Retención de Ganancias\u003C/strong> o \u003Cstrong>Retención de IIBB\u003C/strong>.\u003C/li>\n\u003Cli>\u003Cstrong>Estado\u003C/strong>: \u003Cstrong>Estimada\u003C/strong>, \u003Cstrong>Confirmada\u003C/strong> o \u003Cstrong>Anulada\u003C/strong>.\u003C/li>\n\u003Cli>\u003Cstrong>Filtrar\u003C/strong>: aplica los filtros.\u003C/li>\n\u003Cli>Las tres tarjetas dicen la \u003Cstrong>Base Imponible Total\u003C/strong>, el \u003Cstrong>Total Retenido\u003C/strong> y cuántas \u003Cstrong>Retenciones\u003C/strong> hay.\u003C/li>\n\u003Cli>En la tabla, tocá el \u003Cstrong>#\u003C/strong> de la columna \u003Cstrong>Pago\u003C/strong> para ver el pago. Tocá \u003Cstrong>PDF\u003C/strong> para bajar el certificado.\u003C/li>\n\u003Cli>\u003Cstrong>Volver a Pagos\u003C/strong> te lleva a la lista.\u003C/li>\n\u003C/ul>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                💸 Paso 7: Cómo se paga una factura\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-7-como-se-paga-una-factura\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-7-como-se-paga-una-factura\">\u003C/div>\n\n\u003Cp>Los pagos no se crean desde esta pantalla. Se crean desde la factura:\u003C/p>\n\u003Col>\n\u003Cli>Andá a \u003Ca href=\"/user-guide/resumen-de-deuda\">Resumen de Deuda\u003C/a> y tocá el nombre del proveedor.\u003C/li>\n\u003Cli>En la factura, tocá \u003Cstrong>Acciones\u003C/strong> y después \u003Cstrong>Pagar\u003C/strong>.\u003C/li>\n\u003Cli>Se abre la ventanita \u003Cstrong>Nuevo Pago\u003C/strong>. Completá \u003Cstrong>Fecha de Pago\u003C/strong>, \u003Cstrong>Método\u003C/strong> e \u003Cstrong>Importe\u003C/strong>.\u003C/li>\n\u003Cli>Tocá \u003Cstrong>Pagar Ahora\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cp>El pago aparece acá, en \u003Cstrong>Pagos\u003C/strong>, y la deuda baja. Si dejás vacía la \u003Cstrong>Fecha de Pago\u003C/strong>, se crea una orden que aparece en \u003Cstrong>Órdenes Pendientes\u003C/strong>.\u003C/p>\n\u003Cblockquote>\n\u003Cp>⚠️ \u003Cstrong>Atención:\u003C/strong> \u003Cstrong>Pagar Ahora\u003C/strong> registra un pago de verdad. Revisá el \u003Cstrong>Método\u003C/strong> y el \u003Cstrong>Importe\u003C/strong> antes de tocarlo.\u003C/p>\n\u003C/blockquote>\n\u003Cp>Los pasos con fotos están en \u003Ca href=\"/user-guide/resumen-de-deuda\">Resumen de Deuda\u003C/a>.\u003C/p>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                ⚠️ Resolución de Inconvenientes\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"resolucion-de-inconvenientes\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"resolucion-de-inconvenientes\">\u003C/div>\n\n\u003Cdiv class=\"table-wrapper\">\u003Ctable>\n\u003Cthead>\n\u003Ctr>\n\u003Cth>Problema\u003C/th>\n\u003Cth>Causa más frecuente\u003C/th>\n\u003Cth>Solución recomendada\u003C/th>\n\u003C/tr>\n\u003C/thead>\n\u003Ctbody>\u003Ctr>\n\u003Ctd>\u003Cstrong>No veo los botones Órdenes Pendientes y Compromisos\u003C/strong>\u003C/td>\n\u003Ctd>Tu comercio no usa órdenes de pago.\u003C/td>\n\u003Ctd>Consultá con un administrador.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>No veo el botón Retenciones\u003C/strong>\u003C/td>\n\u003Ctd>El comercio no tiene activado el módulo de retenciones.\u003C/td>\n\u003Ctd>Pedile a un administrador que lo active.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>El menú ⋮ solo tiene Ver Pago Completo\u003C/strong>\u003C/td>\n\u003Ctd>El pago es de un arqueo de caja ya cerrado.\u003C/td>\n\u003Ctd>Pedile a un administrador que lo corrija.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>Pagué una factura y no aparece el pago\u003C/strong>\u003C/td>\n\u003Ctd>El filtro de arriba oculta el pago.\u003C/td>\n\u003Ctd>Borrá los casilleros y tocá \u003Cstrong>Buscar\u003C/strong>.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>Cargué un pago por error\u003C/strong>\u003C/td>\n\u003Ctd>Se eligió mal la factura o el importe.\u003C/td>\n\u003Ctd>Tocá ⋮ → \u003Cstrong>Eliminar Pago\u003C/strong> y volvé a pagar desde \u003Ca href=\"/user-guide/resumen-de-deuda\">Resumen de Deuda\u003C/a>.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>No encuentro la orden que creé\u003C/strong>\u003C/td>\n\u003Ctd>La orden espera aprobación.\u003C/td>\n\u003Ctd>Buscala en \u003Cstrong>Órdenes Pendientes\u003C/strong>.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>Compromisos aparece vacío\u003C/strong>\u003C/td>\n\u003Ctd>Ningún pago tiene fecha programada.\u003C/td>\n\u003Ctd>Los cheques y pagarés diferidos se cargan con \u003Cstrong>Fecha Programada\u003C/strong> en la ventanita \u003Cstrong>Nuevo Pago\u003C/strong>.\u003C/td>\n\u003C/tr>\n\u003C/tbody>\u003C/table>\u003C/div>\n",[5,9,12,15,18,21,24,27,30],{"id":6,"title":7,"level":8},"antes-de-empezar","Antes de empezar",2,{"id":10,"title":11,"level":8},"paso-1-entra-a-la-pantalla","Paso 1: Entrá a la pantalla",{"id":13,"title":14,"level":8},"paso-2-conoce-los-botones-de-arriba","Paso 2: Conocé los botones de arriba",{"id":16,"title":17,"level":8},"paso-3-busca-un-pago","Paso 3: Buscá un pago",{"id":19,"title":20,"level":8},"paso-4-lee-la-lista-de-pagos","Paso 4: Leé la lista de pagos",{"id":22,"title":23,"level":8},"paso-5-abri-el-menu-de-un-pago","⋮ Paso 5: Abrí el menú de un pago",{"id":25,"title":26,"level":8},"paso-6-recorre-las-tres-solapas","Paso 6: Recorré las tres solapas",{"id":28,"title":29,"level":8},"paso-7-como-se-paga-una-factura","Paso 7: Cómo se paga una factura",{"id":31,"title":32,"level":8},"resolucion-de-inconvenientes","Resolución de Inconvenientes",{"title":34,"description":35,"keywords":36},"Pagos - Manual","¿Dónde está en el sistema?: Menú principal → Finanzas → Facturas y Pagos → Pagos\n ¿Quién lo usa?: Tesoreros, cajeros y administradores","pagos, paxapos, pagos, tutorial, guía, manual usuario","78-pagos.txt"],"uses":{"params":["slug"]}}]}
