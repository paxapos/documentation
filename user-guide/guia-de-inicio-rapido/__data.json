":178},"tablero-general","Tablero General",{"slug":180,"title":181},"productos-mas-vendidos","Productos Más Vendidos",{"slug":183,"title":184},"compras-por-mercaderia","Compras por Mercadería",{"title":186,"modules":187},"Configuracion",[188,191,194,197,200,203,206,209,212,215,218],{"slug":189,"title":190},"configuracion-general","Configuración general",{"slug":192,"title":193},"impresoras","Cómo cargar las impresoras del local",{"slug":195,"title":196},"perfiles-de-impresion","Cómo usar los perfiles de impresión",{"slug":198,"title":199},"usuarios-del-sistema","Cómo administrar los Usuarios del Sistema",{"slug":201,"title":202},"usuarios-con-pin","Cómo administrar los Usuarios con PIN",{"slug":204,"title":205},"punto-de-venta","🏛️ Trámite en ARCA (con clave fiscal)",{"slug":207,"title":208},"permisos-por-rol","Cómo configurar los Permisos por Rol",{"slug":210,"title":211},"turnos-mesa","Turnos de Mesa",{"slug":213,"title":214},"medios-de-cobro","Medios de cobro",{"slug":216,"title":217},"clasificacion-de-gastos","Clasificación de Gastos",{"slug":219,"title":220},"centros-de-costo","Centros de Costo",{"title":222,"modules":223},"Biblioteca de Drivers",[224,226,229,232,235,238,241,244,247],{"slug":225,"title":222},"biblioteca-de-drivers",{"slug":227,"title":228},"sam4s-giant-100","Sam4S Giant - 100",{"slug":230,"title":231},"citizen-ct-s310ii","Citizen CT-S310II",{"slug":233,"title":234},"epson-tm-t20","Epson TM-T20",{"slug":236,"title":237},"drivers-genericos","Drivers Genéricos POS",{"slug":239,"title":240},"epson-tm-t88","Epson TM-T88V",{"slug":242,"title":243},"fiscalberry-windows","Instalar Fiscalberry en Windows",{"slug":245,"title":246},"fiscalberry-linux","Instalar Fiscalberry en Linux",{"slug":248,"title":249},"fiscalberry-android","Instalar Fiscalberry en Android",{"title":251,"modules":252},"Extra",[253,256,259,262,265,268,271,274,277,280],{"slug":254,"title":255},"01-faq-solucion-inicial-pantalla-congelada","📖 Manual de Usuario: Solución Inicial si la Pantalla se Congela o no Carga",{"slug":257,"title":258},"03-faq-mozo-reabrir-mesa-anulada","📖 Manual de Usuario: Cómo Reabrir una Mesa Anulada o Cerrada por Error",{"slug":260,"title":261},"05-faq-cajero-emitir-factura-a","📖 Manual de Usuario: Cómo Emitir una Factura A Cargando Datos del Cliente",{"slug":263,"title":264},"06-faq-cajero-ingreso-egreso-cajon","📖 Manual de Usuario: Cómo Registrar Entradas y Salidas de Dinero del Cajón",{"slug":266,"title":267},"07-faq-cajero-activar-medio-pago","📖 Manual de Usuario: Cómo Activar un Medio de Pago que no Aparece al Cobrar",{"slug":269,"title":270},"08-faq-cajero-diferencia-facturado-vs-abiertas","📖 Manual de Usuario: Diferencia entre \"Facturado Total Mesas\" y \"Abiertas Por Usuario\" en Caja",{"slug":272,"title":273},"10-faq-supervisor-cierre-caja-diferencias","📖 Manual de Usuario: Cómo Auditar y Solucionar Diferencias en el Cierre de Caja",{"slug":275,"title":276},"preguntas-frecuentes","Preguntas Frecuentes y Guías Rápidas por Rol",{"slug":278,"title":279},"buchon-bot","Buchón Bot",{"slug":281,"title":282},"troubleshooting-semantico","📖 Guía Única de Resolución de Problemas y Errores (Troubleshooting)"],"uses":{}},{"type":"data","data":[{"slug":1,"title":2,"content":3,"tableOfContents":4,"seo":27,"llmTxtFile":31},"guia-de-inicio-rapido","Guía de Inicio Rápido","\u003Cdiv id=\"guia-de-inicio-rapido\">\u003C/div>\n\n\u003Cblockquote>\n\u003Cp>🎯 \u003Cstrong>¿Para qué sirve esta guía?\u003C/strong>\nSi acabás de recibir tu cuenta de PaxaPOS, esta es la hoja de ruta con lo \u003Cstrong>principal\u003C/strong> para dejar tu local funcionando y hacer tu primera venta. Cada paso te lleva a la guía completa del tema.\u003C/p>\n\u003C/blockquote>\n\u003Ch2 class=\"relative\">\n                📍 Paso 1: Iniciar sesión\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-1-iniciar-sesion\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-1-iniciar-sesion\">\u003C/div>\n\n\u003Cp>Entrá a \u003Ca href=\"https://www.paxapos.com\">www.paxapos.com\u003C/a> con el usuario y contraseña que te dieron.\u003C/p>\n\u003Cblockquote>\n\u003Cp>🔗 Guía completa: \u003Ca href=\"/user-guide/iniciar-sesion\">Cómo Iniciar Sesión\u003C/a>\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🧾 Paso 2: Cargar los datos fiscales del comercio\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-2-cargar-los-datos-fiscales-del-comercio\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-2-cargar-los-datos-fiscales-del-comercio\">\u003C/div>\n\n\u003Cp>Para poder facturar necesitás tus datos fiscales y un \u003Cstrong>punto de venta\u003C/strong> de ARCA cargados en PaxaPOS:\u003C/p>\n\u003Col>\n\u003Cli>Cargá el CUIT, la razón social y el domicilio fiscal en \u003Cstrong>Configuración\u003C/strong> → \u003Cstrong>Fiscal y ARCA\u003C/strong>.\u003C/li>\n\u003Cli>Hacé el trámite en ARCA y creá tu punto de venta: \u003Ca href=\"/user-guide/configuracion-general#tramite-en-arca\">ARCA y Facturación Electrónica\u003C/a>.\u003C/li>\n\u003Cli>Con el PDF del alta del punto de venta, cargalo en \u003Cstrong>Configuración\u003C/strong> → \u003Cstrong>Fiscal y ARCA\u003C/strong> → \u003Cstrong>Puntos de venta\u003C/strong> y avisá a soporte.\u003C/li>\n\u003C/ol>\n\u003Cblockquote>\n\u003Cp>🔗 Guías completas: \u003Ca href=\"/user-guide/puntos-de-venta-pdv\">Puntos de Venta\u003C/a> · \u003Ca href=\"/user-guide/configuracion-general#fiscal-y-arca\">Fiscal y ARCA\u003C/a>\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🍔 Paso 3: Cargar tu menú (categorías y productos)\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-3-cargar-tu-menu-categorias-y-productos\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-3-cargar-tu-menu-categorias-y-productos\">\u003C/div>\n\n\u003Cp>Tu comercio ya arranca con un menú creado: solo tenés que cargarle los productos.\u003C/p>\n\u003Col>\n\u003Cli>Creá tus \u003Cstrong>categorías\u003C/strong> (ej: Entradas, Platos, Bebidas) en \u003Cstrong>Productos\u003C/strong> → \u003Cstrong>Categorías\u003C/strong>.\u003C/li>\n\u003Cli>Si algún producto tiene opciones (ej: gustos de helado), creá sus \u003Cstrong>variantes\u003C/strong> en \u003Cstrong>Productos\u003C/strong> → \u003Cstrong>Variantes\u003C/strong>. No importa si hacés primero las categorías o las variantes.\u003C/li>\n\u003Cli>Cargá cada producto en \u003Cstrong>Productos\u003C/strong> → \u003Cstrong>Menú\u003C/strong>: ahí le elegís la categoría, el precio, las variantes y \u003Cstrong>la impresora por donde sale la comanda\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cblockquote>\n\u003Cp>💡 Para elegir la impresora de cada producto, primero tenés que darla de alta (Paso 4). Si todavía no lo hiciste, podés cargar los productos ahora y elegir la impresora después, editando cada producto.\u003C/p>\n\u003C/blockquote>\n\u003Cblockquote>\n\u003Cp>🔗 Guías completas: \u003Ca href=\"/user-guide/categorias\">Categorías\u003C/a> · \u003Ca href=\"/user-guide/variantes-grupo-sabores\">Variantes\u003C/a> · \u003Ca href=\"/user-guide/menu\">Menú\u003C/a>\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🖨️ Paso 4: Configurar tus impresoras\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-4-configurar-tus-impresoras\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-4-configurar-tus-impresoras\">\u003C/div>\n\n\u003Col>\n\u003Cli>Conectá cada impresora por \u003Cstrong>USB\u003C/strong> (con su driver) o por \u003Cstrong>Ethernet\u003C/strong> (a la misma red).\u003C/li>\n\u003Cli>Instalá \u003Cstrong>Fiscalberry\u003C/strong>, el programa que imprime, y dejalo \u003Cstrong>siempre abierto\u003C/strong>: \u003Ca href=\"/user-guide/fiscalberry-windows\">Windows\u003C/a> · \u003Ca href=\"/user-guide/fiscalberry-linux\">Linux\u003C/a> · \u003Ca href=\"/user-guide/fiscalberry-android\">Android\u003C/a>.\u003C/li>\n\u003Cli>Dá de alta cada impresora (cocina, barra, caja) en \u003Cstrong>Configuración\u003C/strong> → \u003Cstrong>Tablas maestras\u003C/strong> → \u003Cstrong>Impresión y multimedia\u003C/strong> → \u003Cstrong>Impresoras\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cblockquote>\n\u003Cp>🔗 Guía completa: \u003Ca href=\"/user-guide/impresoras\">Gestión de Impresoras\u003C/a>\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                💳 Paso 5: Activar tus medios de pago\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-5-activar-tus-medios-de-pago\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-5-activar-tus-medios-de-pago\">\u003C/div>\n\n\u003Cp>Vinculá las credenciales de tus pasarelas de pago (Prisma Payway, Mercado Pago, Macro Click) en \u003Cstrong>Medios de Pago\u003C/strong> → \u003Cstrong>Configuración de Procesadores\u003C/strong>.\u003C/p>\n\u003Cblockquote>\n\u003Cp>🔗 Guías completas: \u003Ca href=\"/user-guide/configuracion-procesadores\">Configuración de Procesadores de Pago\u003C/a>\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                👥 Paso 6: Crear usuarios para tu equipo\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-6-crear-usuarios-para-tu-equipo\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-6-crear-usuarios-para-tu-equipo\">\u003C/div>\n\n\u003Cp>Dale acceso a mozos, cajeros y encargados creando sus usuarios (o PIN, para un ingreso más rápido) en \u003Cstrong>Configuración\u003C/strong> → \u003Cstrong>Usuarios del Sistema\u003C/strong>.\u003C/p>\n\u003Cblockquote>\n\u003Cp>🔗 Guías completas: \u003Ca href=\"/user-guide/usuarios-del-sistema\">Usuarios del Sistema\u003C/a> · \u003Ca href=\"/user-guide/usuarios-con-pin\">Usuarios con PIN\u003C/a>\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🛎️ Paso 7: Abrir la caja y hacer tu primera venta\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-7-abrir-la-caja-y-hacer-tu-primera-venta\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-7-abrir-la-caja-y-hacer-tu-primera-venta\">\u003C/div>\n\n\u003Col>\n\u003Cli>Abrí el turno con el monto inicial de efectivo en \u003Cstrong>Finanzas\u003C/strong> → \u003Cstrong>Arqueos de Caja\u003C/strong>.\u003C/li>\n\u003Cli>Registrá tu primera venta desde \u003Cstrong>Ventas\u003C/strong> → \u003Cstrong>Salón de Ventas\u003C/strong> (o \u003Cstrong>Caja Rápida\u003C/strong> si es mostrador). En el salón, cada mesa sigue este recorrido: abrir mesa → cargar productos → \u003Cstrong>Comandar\u003C/strong> → \u003Cstrong>Cerrar\u003C/strong> → \u003Cstrong>Cobrar\u003C/strong> → \u003Cstrong>Emitir\u003C/strong> factura (si hace falta) → \u003Cstrong>Checkout\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cblockquote>\n\u003Cp>💡 Antes de abrir la primera mesa, creá tus \u003Cstrong>mozos\u003C/strong> en \u003Cstrong>Configuración\u003C/strong> → \u003Cstrong>Tablas maestras\u003C/strong> → \u003Cstrong>Mozos\u003C/strong> (ver \u003Ca href=\"/user-guide/salon-de-ventas#antes-de-empezar-configurar-los-mozos\">Salón de Ventas\u003C/a>).\u003C/p>\n\u003C/blockquote>\n\u003Cblockquote>\n\u003Cp>🔗 Guías completas: \u003Ca href=\"/user-guide/arqueos-de-caja\">Arqueos de Caja\u003C/a> · \u003Ca href=\"/user-guide/salon-de-ventas\">Salón de Ventas\u003C/a> · \u003Ca href=\"/user-guide/caja-rapida\">Caja Rápida\u003C/a>\u003C/p>\n\u003C/blockquote>\n",[5,9,12,15,18,21,24],{"id":6,"title":7,"level":8},"paso-1-iniciar-sesion","Paso 1: Iniciar sesión",2,{"id":10,"title":11,"level":8},"paso-2-cargar-los-datos-fiscales-del-comercio","Paso 2: Cargar los datos fiscales del comercio",{"id":13,"title":14,"level":8},"paso-3-cargar-tu-menu-categorias-y-productos","Paso 3: Cargar tu menú (categorías y productos)",{"id":16,"title":17,"level":8},"paso-4-configurar-tus-impresoras","Paso 4: Configurar tus impresoras",{"id":19,"title":20,"level":8},"paso-5-activar-tus-medios-de-pago","Paso 5: Activar tus medios de pago",{"id":22,"title":23,"level":8},"paso-6-crear-usuarios-para-tu-equipo","Paso 6: Crear usuarios para tu equipo",{"id":25,"title":26,"level":8},"paso-7-abrir-la-caja-y-hacer-tu-primera-venta","Paso 7: Abrir la caja y hacer tu primera venta",{"title":28,"description":29,"keywords":30},"Guía de Inicio Rápido - Manual","🎯 ¿Para qué sirve esta guía?\n Si acabás de recibir tu cuenta de PaxaPOS, esta es la hoja de ruta con lo principal para dejar tu local funcionando...","guia de inicio rapido, paxapos, guía de inicio rápido, tutorial, guía, manual usuario","14-guia-de-inicio-rapido.txt"],"uses":{"params":["slug"]}}]}
