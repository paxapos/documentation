{"type":"data","nodes":[null,{"type":"data","data":[{"moduleCategories":1},[2,17,44,53,77,98,110,140,146,173,185,221,250],{"title":3,"modules":4},"Comenzamos",[5,8,11,14],{"slug":6,"title":7},"introduccion","Bienvenido a tu software gastronómico",{"slug":9,"title":10},"iniciar-sesion","Cómo Iniciar Sesión",{"slug":12,"title":13},"recuperar-contrasena","Cómo Recuperar tu Contraseña",{"slug":15,"title":16},"guia-de-inicio-rapido","Guía de Inicio Rápido",{"title":18,"modules":19},"Ventas",[20,23,26,29,32,35,38,41],{"slug":21,"title":22},"salon-de-ventas","Cómo Usar el Salón de Ventas (Adición)",{"slug":24,"title":25},"caja-rapida","Cómo Usar la Caja Rápida (Registradora)",{"slug":27,"title":28},"mozos","Cómo Cargar los Mozos",{"slug":30,"title":31},"clientes","Cómo Gestionar los Clientes",{"slug":33,"title":34},"descuentos","Cómo Configurar Descuentos",{"slug":36,"title":37},"nueva-reserva","Cómo Cargar una Nueva Reserva",{"slug":39,"title":40},"listado-de-reservas","Cómo Usar el Listado de Reservas",{"slug":42,"title":43},"grilla-de-reservas","Cómo Usar la Grilla de Reservas",{"title":45,"modules":46},"Medios de Pago",[47,50],{"slug":48,"title":49},"configuracion-procesadores","Configuración de Procesadores de Pago",{"slug":51,"title":52},"transacciones-mercadopago","Transacciones MercadoPago",{"title":54,"modules":55},"Productos",[56,59,62,65,68,71,74],{"slug":57,"title":58},"menu","Menú de Productos (Carta)",{"slug":60,"title":61},"categorias","Categorías de Productos",{"slug":63,"title":64},"variantes-grupo-sabores","Variantes y Grupos de Sabores",{"slug":66,"title":67},"maestro-de-productos","Maestro de Productos",{"slug":69,"title":70},"subproductos-elaborados","Sub-Productos (Elaborados)",{"slug":72,"title":73},"recetas","Recetas",{"slug":75,"title":76},"analisis-duplicados","Buscar Duplicados",{"title":78,"modules":79},"Compras",[80,83,86,89,92,95],{"slug":81,"title":82},"todas-las-ordenes-compra","Órdenes de Compra",{"slug":84,"title":85},"crear-orden-compra","Crear una Orden de Compra",{"slug":87,"title":88},"ordenes-a-aprobar","Órdenes a aprobar",{"slug":90,"title":91},"mercaderias","Mercaderías",{"slug":93,"title":94},"proveedores","Proveedores",{"slug":96,"title":97},"historial-de-compras","Historial de Compras",{"title":99,"modules":100},"Stock",[101,104,107],{"slug":102,"title":103},"stock-mercaderias","Stock de Mercaderías",{"slug":105,"title":106},"stock-subproductos","Stock de Subproductos",{"slug":108,"title":109},"movimientos-de-stock","Movimientos de Stock",{"title":111,"modules":112},"Finanzas",[113,116,119,122,125,128,131,134,137],{"slug":114,"title":115},"arqueos-de-caja","Arqueos de Caja",{"slug":117,"title":118},"listado-de-cajas","Listado de Cajas",{"slug":120,"title":121},"transacciones-de-cobro","Transacciones de Cobro",{"slug":123,"title":124},"factura-manual","Factura Manual",{"slug":126,"title":127},"resumen-de-deuda","Resumen de Deuda",{"slug":129,"title":130},"pagos","Pagos",{"slug":132,"title":133},"historial-de-facturas","Historial de Facturas",{"slug":135,"title":136},"historico-de-mesas","Histórico de Mesas",{"slug":138,"title":139},"puntos-de-venta-pdv","Puntos de Venta (PDVs)",{"title":141,"modules":142},"Comandero",[143],{"slug":144,"title":145},"comandero","Comandero (pantalla de cocina)",{"title":147,"modules":148},"RRHH",[149,152,155,158,161,164,167,170],{"slug":150,"title":151},"empleados","Empleados",{"slug":153,"title":154},"empleados-trabajando","Empleados Trabajando",{"slug":156,"title":157},"registro-diario-fichaje","Registro Diario de Fichaje",{"slug":159,"title":160},"reporte-mensual-fichaje","Reporte Mensual de Fichaje",{"slug":162,"title":163},"departamentos","Departamentos",{"slug":165,"title":166},"turnos-y-horarios-fichaje","Turnos y Horarios de Fichaje",{"slug":168,"title":169},"sueldos-y-jornales","Sueldos y Jornales",{"slug":171,"title":172},"datos-de-acceso-app","Datos de Acceso a la App de Fichaje",{"title":174,"modules":175},"Reportes",[176,179,182],{"slug":177,"title":178},"tablero-general","Tablero General",{"slug":180,"title":181},"productos-mas-vendidos","Productos Más Vendidos",{"slug":183,"title":184},"compras-por-mercaderia","Compras por Mercadería",{"title":186,"modules":187},"Configuracion",[188,191,194,197,200,203,206,209,212,215,218],{"slug":189,"title":190},"configuracion-general","Configuración general",{"slug":192,"title":193},"impresoras","Cómo cargar las impresoras del local",{"slug":195,"title":196},"perfiles-de-impresion","Cómo usar los perfiles de impresión",{"slug":198,"title":199},"usuarios-del-sistema","Cómo administrar los Usuarios del Sistema",{"slug":201,"title":202},"usuarios-con-pin","Cómo administrar los Usuarios con PIN",{"slug":204,"title":205},"punto-de-venta","🏛️ Trámite en ARCA (con clave fiscal)",{"slug":207,"title":208},"permisos-por-rol","Cómo configurar los Permisos por Rol",{"slug":210,"title":211},"turnos-mesa","Turnos de Mesa",{"slug":213,"title":214},"medios-de-cobro","Medios de cobro",{"slug":216,"title":217},"clasificacion-de-gastos","Clasificación de Gastos",{"slug":219,"title":220},"centros-de-costo","Centros de Costo",{"title":222,"modules":223},"Biblioteca de Drivers",[224,226,229,232,235,238,241,244,247],{"slug":225,"title":222},"biblioteca-de-drivers",{"slug":227,"title":228},"sam4s-giant-100","Sam4S Giant - 100",{"slug":230,"title":231},"citizen-ct-s310ii","Citizen CT-S310II",{"slug":233,"title":234},"epson-tm-t20","Epson TM-T20",{"slug":236,"title":237},"drivers-genericos","Drivers Genéricos POS",{"slug":239,"title":240},"epson-tm-t88","Epson TM-T88V",{"slug":242,"title":243},"fiscalberry-windows","Instalar Fiscalberry en Windows",{"slug":245,"title":246},"fiscalberry-linux","Instalar Fiscalberry en Linux",{"slug":248,"title":249},"fiscalberry-android","Instalar Fiscalberry en Android",{"title":251,"modules":252},"Extra",[253,256,259,262,265,268,271,274,277,280],{"slug":254,"title":255},"01-faq-solucion-inicial-pantalla-congelada","📖 Manual de Usuario: Solución Inicial si la Pantalla se Congela o no Carga",{"slug":257,"title":258},"03-faq-mozo-reabrir-mesa-anulada","📖 Manual de Usuario: Cómo Reabrir una Mesa Anulada o Cerrada por Error",{"slug":260,"title":261},"05-faq-cajero-emitir-factura-a","📖 Manual de Usuario: Cómo Emitir una Factura A Cargando Datos del Cliente",{"slug":263,"title":264},"06-faq-cajero-ingreso-egreso-cajon","📖 Manual de Usuario: Cómo Registrar Entradas y Salidas de Dinero del Cajón",{"slug":266,"title":267},"07-faq-cajero-activar-medio-pago","📖 Manual de Usuario: Cómo Activar un Medio de Pago que no Aparece al Cobrar",{"slug":269,"title":270},"08-faq-cajero-diferencia-facturado-vs-abiertas","📖 Manual de Usuario: Diferencia entre \"Facturado Total Mesas\" y \"Abiertas Por Usuario\" en Caja",{"slug":272,"title":273},"10-faq-supervisor-cierre-caja-diferencias","📖 Manual de Usuario: Cómo Auditar y Solucionar Diferencias en el Cierre de Caja",{"slug":275,"title":276},"preguntas-frecuentes","Preguntas Frecuentes y Guías Rápidas por Rol",{"slug":278,"title":279},"buchon-bot","Buchón Bot",{"slug":281,"title":282},"troubleshooting-semantico","📖 Guía Única de Resolución de Problemas y Errores (Troubleshooting)"],"uses":{}},{"type":"data","data":[{"slug":1,"title":2,"content":3,"tableOfContents":4,"seo":24,"llmTxtFile":28},"mozos","Cómo Cargar los Mozos","\u003Cdiv id=\"mozos-del-salon\">\u003C/div>\n\n\u003Cblockquote>\n\u003Cp>\u003Cstrong>¿Dónde está en el sistema?:\u003C/strong> Menú principal → \u003Cstrong>Ventas\u003C/strong> → (parte \u003Cstrong>Reservas Hoteleras\u003C/strong>) → \u003Cstrong>Mozos\u003C/strong>\u003Cbr>\u003Cstrong>¿Quién lo usa?:\u003C/strong> Encargados de salón y administradores\u003C/p>\n\u003C/blockquote>\n\u003Cblockquote>\n\u003Cp>🎯 \u003Cstrong>¿Para qué sirve esto?\u003C/strong>\nCada mesa pertenece a un mozo. Acá cargás los mozos, les elegís con qué impresora y punto de venta trabajan, y los activás o desactivás.\u003C/p>\n\u003C/blockquote>\n\u003Cblockquote>\n\u003Cp>ℹ️ En algunos comercios el mozo tiene otro nombre (por ejemplo, \u003Cem>Camarero\u003C/em>). La pantalla usa el nombre de tu comercio.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🔑 Antes de empezar\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"antes-de-empezar\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"antes-de-empezar\">\u003C/div>\n\n\u003Cul>\n\u003Cli>Tu usuario tiene que tener el permiso \u003Cstrong>Mozos\u003C/strong> en \u003Ca href=\"/user-guide/permisos-por-rol\">Permisos por Rol\u003C/a>.\u003C/li>\n\u003Cli>Para que el mozo entre al sistema con un código, después creale un \u003Ca href=\"/user-guide/usuarios-con-pin\">Usuario con PIN\u003C/a>.\u003C/li>\n\u003C/ul>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                📍 \u003Cstrong>Paso 1: Entrá a Mozos\u003C/strong>\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-1-entra-a-mozos\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-1-entra-a-mozos\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/24-00a-menu-grupo-ventas.png\" alt=\"Grupo Ventas del menú lateral, marcado en rojo\">\u003C/p>\n\u003Col>\n\u003Cli>En el menú de la izquierda, tocá \u003Cstrong>Ventas\u003C/strong>. Se despliegan sus opciones.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/24-00b-menu-opcion-mozos.png\" alt=\"Opción Mozos dentro del grupo Ventas, marcada en rojo\">\u003C/p>\n\u003Col start=\"2\">\n\u003Cli>Bajá hasta la parte \u003Cstrong>Reservas Hoteleras\u003C/strong> y tocá \u003Cstrong>Mozos\u003C/strong>.\u003C/li>\n\u003Cli>Se abre la lista de mozos.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/24-01-pantalla-completa.png\" alt=\"Lista de mozos con su estado, punto de venta, impresora y usuarios\">\u003C/p>\n\u003Cp>En la lista vas a ver, para cada mozo: si está \u003Cstrong>Activo\u003C/strong>, su \u003Cstrong>Punto de Venta\u003C/strong>, su \u003Cstrong>Impresora / Perfil\u003C/strong> y los \u003Cstrong>Usuarios\u003C/strong> que lo pueden usar.\u003C/p>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🔍 \u003Cstrong>Paso 2: Buscá un mozo\u003C/strong>\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-2-busca-un-mozo\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-2-busca-un-mozo\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/24-02-campo-buscar.png\" alt=\"Casillero para buscar mozos\">\u003C/p>\n\u003Col>\n\u003Cli>Escribí el nombre, el apellido o el alias del mozo.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/24-03-donde-esta-boton-buscar.png\" alt=\"Lista de mozos con el botón Buscar marcado en rojo\">\u003C/p>\n\u003Col start=\"2\">\n\u003Cli>Tocá el botón azul \u003Cstrong>Buscar\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                ➕ \u003Cstrong>Paso 3: Cargá un mozo nuevo\u003C/strong>\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-3-carga-un-mozo-nuevo\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-3-carga-un-mozo-nuevo\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/24-05-donde-esta-boton-crear-mozo.png\" alt=\"Lista de mozos con el botón Crear Mozo marcado en rojo arriba a la derecha\">\u003C/p>\n\u003Col>\n\u003Cli>Tocá el botón verde \u003Cstrong>Crear Mozo\u003C/strong>, arriba a la derecha.\u003C/li>\n\u003Cli>Se abre una ventanita \u003Cstrong>Nuevo Mozo\u003C/strong>. Bajá con la ruedita del mouse para ver todo.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/24-30-ventana-nuevo-mozo.png\" alt=\"Ventanita Nuevo Mozo con la Información Básica\">\u003C/p>\n\u003Ch3>Información básica\u003C/h3>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/24-13-campo-numero.png\" alt=\"Casillero Alias o Identificador con el texto Mozo Prueba\">\u003C/p>\n\u003Col start=\"3\">\n\u003Cli>En \u003Cstrong>Alias / Identificador\u003C/strong>, escribí cómo se va a ver el mozo en el salón y en los tickets. Por ejemplo: \u003Cem>Juan\u003C/em> o \u003Cem>1\u003C/em>. \u003Cstrong>Hay que completarlo.\u003C/strong>\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/24-14-campo-nombre.png\" alt=\"Casillero Nombre\">\u003C/p>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/24-15-campo-apellido.png\" alt=\"Casillero Apellido\">\u003C/p>\n\u003Col start=\"4\">\n\u003Cli>En \u003Cstrong>Nombre\u003C/strong> y \u003Cstrong>Apellido\u003C/strong>, escribí el nombre real. Por ejemplo: \u003Cem>Juan Pérez\u003C/em>. Es opcional.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/24-16-campo-media-file.png\" alt=\"Parte Foto de Perfil para subir una imagen\">\u003C/p>\n\u003Col start=\"5\">\n\u003Cli>En \u003Cstrong>Foto de Perfil\u003C/strong> podés subir una foto del mozo (JPG o PNG). Es opcional.\u003C/li>\n\u003C/ol>\n\u003Ch3>Configuración\u003C/h3>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/24-17-campo-punto-de-venta.png\" alt=\"Lista Punto de Venta\">\u003C/p>\n\u003Col start=\"6\">\n\u003Cli>En \u003Cstrong>Punto de Venta\u003C/strong>, elegí con qué punto de venta se facturan las mesas de este mozo.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/24-18-campo-servidor-de-impresion.png\" alt=\"Lista Servidor de Impresión con Usar el del comercio elegido\">\u003C/p>\n\u003Col start=\"7\">\n\u003Cli>En \u003Cstrong>Servidor de Impresión\u003C/strong>, dejá \u003Cstrong>Usar el del comercio\u003C/strong>, salvo que este mozo imprima en otro lugar.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/24-19-campo-perfil-de-impresion.png\" alt=\"Lista Perfil de Impresión con Usar perfil default del comercio elegido\">\u003C/p>\n\u003Col start=\"8\">\n\u003Cli>En \u003Cstrong>Perfil de Impresión\u003C/strong>, dejá \u003Cstrong>Usar perfil default del comercio\u003C/strong>, salvo que use otras impresoras.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/24-22-campo-centro-de-costo.png\" alt=\"Lista Centro de Costo\">\u003C/p>\n\u003Col start=\"9\">\n\u003Cli>En \u003Cstrong>Centro de Costo\u003C/strong>, elegí a qué parte del negocio corresponde. Por ejemplo: \u003Cem>Administrativo - General\u003C/em>. \u003Cstrong>Elegí siempre uno.\u003C/strong>\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/24-23-campo-activo.png\" alt=\"Casilla Estado del Mozo tildada\">\u003C/p>\n\u003Col start=\"10\">\n\u003Cli>Dejá tildada la casilla \u003Cstrong>Estado del Mozo\u003C/strong>. Si la destildás, el mozo no aparece para abrir mesas.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/24-24-campo-apertura-rapida.png\" alt=\"Casilla Mozo Veloz sin tildar\">\u003C/p>\n\u003Col start=\"11\">\n\u003Cli>Tildá \u003Cstrong>Mozo Veloz\u003C/strong> solo si querés que las mesas se abran al instante, sin pedir nombre ni cubiertos.\u003C/li>\n\u003C/ol>\n\u003Ch3>Quién lo puede usar\u003C/h3>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/24-25-campo-usuarios.png\" alt=\"Parte Visibilidad por Usuarios con la lista de usuarios\">\u003C/p>\n\u003Col start=\"12\">\n\u003Cli>En \u003Cstrong>Visibilidad por Usuarios\u003C/strong>, tildá los usuarios que pueden usar este mozo. Si no tildás ninguno, nadie podrá usarlo.\u003C/li>\n\u003C/ol>\n\u003Cblockquote>\n\u003Cp>💡 \u003Cstrong>Consejo útil:\u003C/strong> Tildá el usuario con PIN del propio mozo. Así cada mozo ve solo sus mesas.\u003C/p>\n\u003C/blockquote>\n\u003Ch3>Guardá\u003C/h3>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/24-28-donde-esta-boton-guardar.png\" alt=\"Ventanita con el botón Crear Mozo marcado en rojo abajo a la derecha\">\u003C/p>\n\u003Col start=\"13\">\n\u003Cli>Tocá el botón verde \u003Cstrong>Crear Mozo\u003C/strong>, abajo a la derecha.\u003C/li>\n\u003Cli>Vas a ver un mensaje verde y el mozo aparece en la lista.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/24-31-lista-con-mozo-prueba.png\" alt=\"Lista de mozos con el mozo nuevo marcado en rojo\">\u003C/p>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/24-26-donde-esta-boton-cancelar.png\" alt=\"Ventanita con el botón Cancelar marcado en rojo abajo a la izquierda\">\u003C/p>\n\u003Cul>\n\u003Cli>Si no querés guardarlo, tocá \u003Cstrong>Cancelar\u003C/strong>, abajo a la izquierda.\u003C/li>\n\u003C/ul>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                ✏️ \u003Cstrong>Paso 4: Cambiá, apagá o borrá un mozo\u003C/strong>\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-4-cambia-apaga-o-borra-un-mozo\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-4-cambia-apaga-o-borra-un-mozo\">\u003C/div>\n\n\u003Cp>A la derecha de cada mozo hay tres botones.\u003C/p>\n\u003Ch3>Cambiar sus datos\u003C/h3>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/24-07-donde-esta-boton-editar.png\" alt=\"Lista con el botón del lápiz marcado en rojo\">\u003C/p>\n\u003Col>\n\u003Cli>Tocá el \u003Cstrong>lápiz\u003C/strong> ✏️. Se abre la misma ventanita con sus datos.\u003C/li>\n\u003Cli>Cambiá lo que haga falta y tocá \u003Cstrong>Guardar Cambios\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Ch3>Activar o desactivar\u003C/h3>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/24-09-donde-esta-boton-activar-desactivar.png\" alt=\"Lista con el botón del ojo marcado en rojo\">\u003C/p>\n\u003Cul>\n\u003Cli>Tocá el \u003Cstrong>ojo\u003C/strong> 👁️ para desactivar a un mozo que ya no trabaja. Tocalo de nuevo para activarlo.\u003C/li>\n\u003Cli>El mozo desactivado no aparece para abrir mesas, pero no se pierde nada.\u003C/li>\n\u003C/ul>\n\u003Ch3>Borrar\u003C/h3>\n\u003Cblockquote>\n\u003Cp>⚠️ \u003Cstrong>Atención:\u003C/strong> Borrar un mozo \u003Cstrong>borra todo su historial\u003C/strong>. Si el mozo dejó de trabajar, mejor \u003Cstrong>desactivalo\u003C/strong> con el ojo.\u003C/p>\n\u003C/blockquote>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/24-11-donde-esta-boton-eliminar.png\" alt=\"Lista con el botón rojo de la papelera marcado\">\u003C/p>\n\u003Col>\n\u003Cli>Tocá el botón rojo de la \u003Cstrong>papelera\u003C/strong> 🗑️.\u003C/li>\n\u003Cli>El sistema te pregunta si estás seguro. Tocá \u003Cstrong>Aceptar\u003C/strong> solo si de verdad querés borrarlo.\u003C/li>\n\u003C/ol>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                ⚠️ \u003Cstrong>Resolución de Inconvenientes\u003C/strong>\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"resolucion-de-inconvenientes\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"resolucion-de-inconvenientes\">\u003C/div>\n\n\u003Cdiv class=\"table-wrapper\">\u003Ctable>\n\u003Cthead>\n\u003Ctr>\n\u003Cth>Problema\u003C/th>\n\u003Cth>Causa más frecuente\u003C/th>\n\u003Cth>Solución recomendada\u003C/th>\n\u003C/tr>\n\u003C/thead>\n\u003Ctbody>\u003Ctr>\n\u003Ctd>\u003Cstrong>El mozo no aparece al abrir una mesa\u003C/strong>\u003C/td>\n\u003Ctd>Está desactivado.\u003C/td>\n\u003Ctd>Tocá el \u003Cstrong>ojo\u003C/strong> 👁️ en la lista para activarlo.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>Un usuario no ve al mozo\u003C/strong>\u003C/td>\n\u003Ctd>En \u003Cstrong>Visibilidad por Usuarios\u003C/strong> hay otros usuarios tildados y ese no.\u003C/td>\n\u003Ctd>Editá el mozo y tildá también ese usuario.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>No aparece Mozos en el menú Ventas\u003C/strong>\u003C/td>\n\u003Ctd>Tu usuario no tiene el permiso \u003Cstrong>Mozos\u003C/strong>, o el comercio no tiene activas las reservas hoteleras.\u003C/td>\n\u003Ctd>Pedile al administrador que lo revise en \u003Ca href=\"/user-guide/permisos-por-rol\">Permisos por Rol\u003C/a>.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>Sale una pantalla de error al crear el mozo\u003C/strong>\u003C/td>\n\u003Ctd>Quedó \u003Cstrong>-- Sin centro de costo --\u003C/strong> en \u003Cstrong>Centro de Costo\u003C/strong>.\u003C/td>\n\u003Ctd>Volvé atrás, elegí un centro de costo y guardá de nuevo.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>No me deja guardar\u003C/strong>\u003C/td>\n\u003Ctd>Falta el \u003Cstrong>Alias / Identificador\u003C/strong>.\u003C/td>\n\u003Ctd>Escribí un alias y probá de nuevo.\u003C/td>\n\u003C/tr>\n\u003C/tbody>\u003C/table>\u003C/div>\n",[5,9,12,15,18,21],{"id":6,"title":7,"level":8},"antes-de-empezar","Antes de empezar",2,{"id":10,"title":11,"level":8},"paso-1-entra-a-mozos","Paso 1: Entrá a Mozos",{"id":13,"title":14,"level":8},"paso-2-busca-un-mozo","Paso 2: Buscá un mozo",{"id":16,"title":17,"level":8},"paso-3-carga-un-mozo-nuevo","Paso 3: Cargá un mozo nuevo",{"id":19,"title":20,"level":8},"paso-4-cambia-apaga-o-borra-un-mozo","Paso 4: Cambiá, apagá o borrá un mozo",{"id":22,"title":23,"level":8},"resolucion-de-inconvenientes","Resolución de Inconvenientes",{"title":25,"description":26,"keywords":27},"Cómo Cargar los Mozos - Manual","¿Dónde está en el sistema?: Menú principal → Ventas → (parte Reservas Hoteleras) → Mozos  \n ¿Quién lo usa?: Encargados de salón y admi...","mozos, paxapos, cómo cargar los mozos, tutorial, guía, manual usuario","24-mozos.txt"],"uses":{"params":["slug"]}}]}
