":178},"tablero-general","Tablero General",{"slug":180,"title":181},"productos-mas-vendidos","Productos Más Vendidos",{"slug":183,"title":184},"compras-por-mercaderia","Compras por Mercadería",{"title":186,"modules":187},"Configuracion",[188,191,194,197,200,203,206,209,212,215,218],{"slug":189,"title":190},"configuracion-general","Configuración general",{"slug":192,"title":193},"impresoras","Cómo cargar las impresoras del local",{"slug":195,"title":196},"perfiles-de-impresion","Cómo usar los perfiles de impresión",{"slug":198,"title":199},"usuarios-del-sistema","Cómo administrar los Usuarios del Sistema",{"slug":201,"title":202},"usuarios-con-pin","Cómo administrar los Usuarios con PIN",{"slug":204,"title":205},"punto-de-venta","🏛️ Trámite en ARCA (con clave fiscal)",{"slug":207,"title":208},"permisos-por-rol","Cómo configurar los Permisos por Rol",{"slug":210,"title":211},"turnos-mesa","Turnos de Mesa",{"slug":213,"title":214},"medios-de-cobro","Medios de cobro",{"slug":216,"title":217},"clasificacion-de-gastos","Clasificación de Gastos",{"slug":219,"title":220},"centros-de-costo","Centros de Costo",{"title":222,"modules":223},"Biblioteca de Drivers",[224,226,229,232,235,238,241,244,247],{"slug":225,"title":222},"biblioteca-de-drivers",{"slug":227,"title":228},"sam4s-giant-100","Sam4S Giant - 100",{"slug":230,"title":231},"citizen-ct-s310ii","Citizen CT-S310II",{"slug":233,"title":234},"epson-tm-t20","Epson TM-T20",{"slug":236,"title":237},"drivers-genericos","Drivers Genéricos POS",{"slug":239,"title":240},"epson-tm-t88","Epson TM-T88V",{"slug":242,"title":243},"fiscalberry-windows","Instalar Fiscalberry en Windows",{"slug":245,"title":246},"fiscalberry-linux","Instalar Fiscalberry en Linux",{"slug":248,"title":249},"fiscalberry-android","Instalar Fiscalberry en Android",{"title":251,"modules":252},"Extra",[253,256,259,262,265,268,271,274,277,280],{"slug":254,"title":255},"01-faq-solucion-inicial-pantalla-congelada","📖 Manual de Usuario: Solución Inicial si la Pantalla se Congela o no Carga",{"slug":257,"title":258},"03-faq-mozo-reabrir-mesa-anulada","📖 Manual de Usuario: Cómo Reabrir una Mesa Anulada o Cerrada por Error",{"slug":260,"title":261},"05-faq-cajero-emitir-factura-a","📖 Manual de Usuario: Cómo Emitir una Factura A Cargando Datos del Cliente",{"slug":263,"title":264},"06-faq-cajero-ingreso-egreso-cajon","📖 Manual de Usuario: Cómo Registrar Entradas y Salidas de Dinero del Cajón",{"slug":266,"title":267},"07-faq-cajero-activar-medio-pago","📖 Manual de Usuario: Cómo Activar un Medio de Pago que no Aparece al Cobrar",{"slug":269,"title":270},"08-faq-cajero-diferencia-facturado-vs-abiertas","📖 Manual de Usuario: Diferencia entre \"Facturado Total Mesas\" y \"Abiertas Por Usuario\" en Caja",{"slug":272,"title":273},"10-faq-supervisor-cierre-caja-diferencias","📖 Manual de Usuario: Cómo Auditar y Solucionar Diferencias en el Cierre de Caja",{"slug":275,"title":276},"preguntas-frecuentes","Preguntas Frecuentes y Guías Rápidas por Rol",{"slug":278,"title":279},"buchon-bot","Buchón Bot",{"slug":281,"title":282},"troubleshooting-semantico","📖 Guía Única de Resolución de Problemas y Errores (Troubleshooting)"],"uses":{}},{"type":"data","data":[{"slug":1,"title":2,"content":3,"tableOfContents":4,"seo":24,"llmTxtFile":28},"ordenes-a-aprobar","Órdenes a aprobar","\u003Cdiv id=\"ordenes-a-aprobar\">\u003C/div>\n\n\u003Cblockquote>\n\u003Cp>\u003Cstrong>¿Dónde está en el sistema?:\u003C/strong> Menú principal → \u003Cstrong>Compras\u003C/strong> → \u003Cstrong>Órdenes a aprobar\u003C/strong>\u003C/p>\n\u003C/blockquote>\n\u003Cblockquote>\n\u003Cp>\u003Cstrong>¿Quién lo usa?: Proveedores que tienen órdenes de compra pendientes de aprobación.\u003C/strong>\u003C/p>\n\u003C/blockquote>\n\u003Cblockquote>\n\u003Cp>🎯 \u003Cstrong>¿Para qué sirve esto?\u003C/strong>\nSi tu comercio pide aprobar las compras, cada orden de compra nueva queda esperando acá.\nUn responsable la revisa y la \u003Cstrong>aprueba\u003C/strong> o la \u003Cstrong>rechaza\u003C/strong>. Recién aprobada se le puede mandar al proveedor.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🔑 Antes de empezar\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"antes-de-empezar\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"antes-de-empezar\">\u003C/div>\n\n\u003Cul>\n\u003Cli>Tu usuario tiene que tener el permiso para aprobar y rechazar órdenes de compra, en \u003Ca href=\"/user-guide/permisos-por-rol\">Permisos por Rol\u003C/a>.\u003C/li>\n\u003Cli>El comercio tiene que tener activada la \u003Cstrong>aprobación de órdenes de compra\u003C/strong> en su configuración.\u003C/li>\n\u003C/ul>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                📍 Paso 1: Entrá a la pantalla\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-1-entra-a-la-pantalla\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-1-entra-a-la-pantalla\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/50-compras/54-00a-menu-grupo-compras.png\" alt=\"Menú lateral con el grupo Compras marcado en rojo\">\u003C/p>\n\u003Col>\n\u003Cli>En el menú de la izquierda, tocá \u003Cstrong>Compras\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/50-compras/54-00b-menu-opcion-pendientes-aprobacion.png\" alt=\"Opción Órdenes a aprobar marcada en rojo\">\u003C/p>\n\u003Col start=\"2\">\n\u003Cli>Tocá \u003Cstrong>Órdenes a aprobar\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/50-compras/54-01-pantalla-completa.png\" alt=\"Pantalla OC Pendientes de Aprobación con las órdenes a revisar\">\u003C/p>\n\u003Cp>Así se ve la pantalla. El número al lado del título dice cuántas órdenes esperan.\u003C/p>\n\u003Cblockquote>\n\u003Cp>💡 \u003Cstrong>Consejo útil:\u003C/strong> si no hay nada para aprobar, la pantalla dice \u003Cem>&quot;No hay ordenes pendientes de aprobacion&quot;\u003C/em>.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                👁️ Paso 2: Revisá cada orden\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-2-revisa-cada-orden\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-2-revisa-cada-orden\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/50-compras/54-15-renglon-oc.png\" alt=\"Renglón de una orden: número, proveedor, mercaderías, prioridad, fecha y los botones Aprobar, Rechazar y Ver\">\u003C/p>\n\u003Cp>Cada renglón muestra el número de la orden, el proveedor, qué se pide, la prioridad y la fecha. A la derecha tiene tres botones:\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Aprobar\u003C/strong> (verde): aprueba la orden (Paso 3).\u003C/li>\n\u003Cli>\u003Cstrong>Rechazar\u003C/strong> (rojo): la rechaza (Paso 4).\u003C/li>\n\u003Cli>\u003Cstrong>Ver\u003C/strong>: abre la orden completa.\u003C/li>\n\u003C/ul>\n\u003Cp>\u003Cimg src=\"/images/manual/50-compras/54-16-pantalla-ver-oc.png\" alt=\"Orden de compra con el detalle de lo pedido y el total\">\u003C/p>\n\u003Col>\n\u003Cli>Tocá \u003Cstrong>Ver\u003C/strong> y revisá el proveedor, las cantidades y el total.\u003C/li>\n\u003C/ol>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                ✅ Paso 3: Aprobá la orden\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-3-aproba-la-orden\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-3-aproba-la-orden\">\u003C/div>\n\n\u003Col>\n\u003Cli>Tocá el botón verde \u003Cstrong>Aprobar\u003C/strong> de la orden.\u003C/li>\n\u003Cli>El sistema te pregunta si estás seguro. Tocá \u003Cstrong>Aceptar\u003C/strong>.\u003C/li>\n\u003Cli>La orden sale de esta lista y ya se le puede mandar al proveedor. Mirá \u003Ca href=\"/user-guide/todas-las-ordenes-compra\">Órdenes de compra\u003C/a>.\u003C/li>\n\u003C/ol>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                ❌ Paso 4: Rechazá la orden\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-4-rechaza-la-orden\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-4-rechaza-la-orden\">\u003C/div>\n\n\u003Col>\n\u003Cli>Tocá el botón rojo \u003Cstrong>Rechazar\u003C/strong> de la orden.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/50-compras/54-18-formulario-rechazo.png\" alt=\"Pantalla Rechazar Orden de Compra: datos de la orden, motivo del rechazo y los botones Cancelar y Confirmar Rechazo\">\u003C/p>\n\u003Col start=\"2\">\n\u003Cli>Se abre la pantalla \u003Cstrong>Rechazar Orden de Compra\u003C/strong>. Arriba repite los datos de la orden y lo que se pidió.\u003C/li>\n\u003Cli>En \u003Cstrong>Motivo del rechazo\u003C/strong>, escribí por qué. Por ejemplo: \u003Cem>El precio subió: pedir otro presupuesto\u003C/em>. Quien la cargó lo va a ver.\u003C/li>\n\u003Cli>Tocá el botón rojo \u003Cstrong>Confirmar Rechazo\u003C/strong>. Si te arrepentiste, tocá \u003Cstrong>Cancelar\u003C/strong>: la orden sigue esperando.\u003C/li>\n\u003C/ol>\n\u003Cblockquote>\n\u003Cp>⚠️ \u003Cstrong>Atención:\u003C/strong> una orden rechazada queda cerrada. Si hace falta, hay que cargar una nueva.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                ⚠️ Resolución de Inconvenientes\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"resolucion-de-inconvenientes\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"resolucion-de-inconvenientes\">\u003C/div>\n\n\u003Cdiv class=\"table-wrapper\">\u003Ctable>\n\u003Cthead>\n\u003Ctr>\n\u003Cth>Problema\u003C/th>\n\u003Cth>Causa más frecuente\u003C/th>\n\u003Cth>Solución recomendada\u003C/th>\n\u003C/tr>\n\u003C/thead>\n\u003Ctbody>\u003Ctr>\n\u003Ctd>\u003Cstrong>No aparece Órdenes a aprobar en el menú\u003C/strong>\u003C/td>\n\u003Ctd>El comercio no tiene activada la aprobación, o tu usuario no tiene permiso.\u003C/td>\n\u003Ctd>Pedile al dueño que revise la configuración y tus permisos.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>No veo los botones Aprobar o Rechazar\u003C/strong>\u003C/td>\n\u003Ctd>Tu usuario no tiene permiso para aprobar.\u003C/td>\n\u003Ctd>Pedile al dueño el permiso en \u003Ca href=\"/user-guide/permisos-por-rol\">Permisos por Rol\u003C/a>.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>La orden no aparece en la lista\u003C/strong>\u003C/td>\n\u003Ctd>Ya la aprobaron o la rechazaron, o es un presupuesto.\u003C/td>\n\u003Ctd>Buscala en \u003Ca href=\"/user-guide/todas-las-ordenes-compra\">Órdenes de compra\u003C/a>.\u003C/td>\n\u003C/tr>\n\u003C/tbody>\u003C/table>\u003C/div>\n",[5,9,12,15,18,21],{"id":6,"title":7,"level":8},"antes-de-empezar","Antes de empezar",2,{"id":10,"title":11,"level":8},"paso-1-entra-a-la-pantalla","Paso 1: Entrá a la pantalla",{"id":13,"title":14,"level":8},"paso-2-revisa-cada-orden","Paso 2: Revisá cada orden",{"id":16,"title":17,"level":8},"paso-3-aproba-la-orden","Paso 3: Aprobá la orden",{"id":19,"title":20,"level":8},"paso-4-rechaza-la-orden","Paso 4: Rechazá la orden",{"id":22,"title":23,"level":8},"resolucion-de-inconvenientes","Resolución de Inconvenientes",{"title":25,"description":26,"keywords":27},"Órdenes a aprobar - Manual","¿Dónde está en el sistema?: Menú principal → Compras → Órdenes a aprobar","ordenes a aprobar, paxapos, órdenes a aprobar, tutorial, guía, manual usuario","54-ordenes-a-aprobar.txt"],"uses":{"params":["slug"]}}]}
