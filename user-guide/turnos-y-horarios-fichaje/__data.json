{"type":"data","nodes":[null,{"type":"data","data":[{"moduleCategories":1},[2,17,44,53,77,98,110,140,146,173,185,221,250],{"title":3,"modules":4},"Comenzamos",[5,8,11,14],{"slug":6,"title":7},"introduccion","Bienvenido a tu software gastronómico",{"slug":9,"title":10},"iniciar-sesion","Cómo Iniciar Sesión",{"slug":12,"title":13},"recuperar-contrasena","Cómo Recuperar tu Contraseña",{"slug":15,"title":16},"guia-de-inicio-rapido","Guía de Inicio Rápido",{"title":18,"modules":19},"Ventas",[20,23,26,29,32,35,38,41],{"slug":21,"title":22},"salon-de-ventas","Cómo Usar el Salón de Ventas (Adición)",{"slug":24,"title":25},"caja-rapida","Cómo Usar la Caja Rápida (Registradora)",{"slug":27,"title":28},"mozos","Cómo Cargar los Mozos",{"slug":30,"title":31},"clientes","Cómo Gestionar los Clientes",{"slug":33,"title":34},"descuentos","Cómo Configurar Descuentos",{"slug":36,"title":37},"nueva-reserva","Cómo Cargar una Nueva Reserva",{"slug":39,"title":40},"listado-de-reservas","Cómo Usar el Listado de Reservas",{"slug":42,"title":43},"grilla-de-reservas","Cómo Usar la Grilla de Reservas",{"title":45,"modules":46},"Medios de Pago",[47,50],{"slug":48,"title":49},"configuracion-procesadores","Configuración de Procesadores de Pago",{"slug":51,"title":52},"transacciones-mercadopago","Transacciones MercadoPago",{"title":54,"modules":55},"Productos",[56,59,62,65,68,71,74],{"slug":57,"title":58},"menu","Menú de Productos (Carta)",{"slug":60,"title":61},"categorias","Categorías de Productos",{"slug":63,"title":64},"variantes-grupo-sabores","Variantes y Grupos de Sabores",{"slug":66,"title":67},"maestro-de-productos","Maestro de Productos",{"slug":69,"title":70},"subproductos-elaborados","Sub-Productos (Elaborados)",{"slug":72,"title":73},"recetas","Recetas",{"slug":75,"title":76},"analisis-duplicados","Buscar Duplicados",{"title":78,"modules":79},"Compras",[80,83,86,89,92,95],{"slug":81,"title":82},"todas-las-ordenes-compra","Órdenes de Compra",{"slug":84,"title":85},"crear-orden-compra","Crear una Orden de Compra",{"slug":87,"title":88},"ordenes-a-aprobar","Órdenes a aprobar",{"slug":90,"title":91},"mercaderias","Mercaderías",{"slug":93,"title":94},"proveedores","Proveedores",{"slug":96,"title":97},"historial-de-compras","Historial de Compras",{"title":99,"modules":100},"Stock",[101,104,107],{"slug":102,"title":103},"stock-mercaderias","Stock de Mercaderías",{"slug":105,"title":106},"stock-subproductos","Stock de Subproductos",{"slug":108,"title":109},"movimientos-de-stock","Movimientos de Stock",{"title":111,"modules":112},"Finanzas",[113,116,119,122,125,128,131,134,137],{"slug":114,"title":115},"arqueos-de-caja","Arqueos de Caja",{"slug":117,"title":118},"listado-de-cajas","Listado de Cajas",{"slug":120,"title":121},"transacciones-de-cobro","Transacciones de Cobro",{"slug":123,"title":124},"factura-manual","Factura Manual",{"slug":126,"title":127},"resumen-de-deuda","Resumen de Deuda",{"slug":129,"title":130},"pagos","Pagos",{"slug":132,"title":133},"historial-de-facturas","Historial de Facturas",{"slug":135,"title":136},"historico-de-mesas","Histórico de Mesas",{"slug":138,"title":139},"puntos-de-venta-pdv","Puntos de Venta (PDVs)",{"title":141,"modules":142},"Comandero",[143],{"slug":144,"title":145},"comandero","Comandero (pantalla de cocina)",{"title":147,"modules":148},"RRHH",[149,152,155,158,161,164,167,170],{"slug":150,"title":151},"empleados","Empleados",{"slug":153,"title":154},"empleados-trabajando","Empleados Trabajando",{"slug":156,"title":157},"registro-diario-fichaje","Registro Diario de Fichaje",{"slug":159,"title":160},"reporte-mensual-fichaje","Reporte Mensual de Fichaje",{"slug":162,"title":163},"departamentos","Departamentos",{"slug":165,"title":166},"turnos-y-horarios-fichaje","Turnos y Horarios de Fichaje",{"slug":168,"title":169},"sueldos-y-jornales","Sueldos y Jornales",{"slug":171,"title":172},"datos-de-acceso-app","Datos de Acceso a la App de Fichaje",{"title":174,"modules":175},"Reportes",[176,179,182],{"slug":177,"title":178},"tablero-general","Tablero General",{"slug":180,"title":181},"productos-mas-vendidos","Productos Más Vendidos",{"slug":183,"title":184},"compras-por-mercaderia","Compras por Mercadería",{"title":186,"modules":187},"Configuracion",[188,191,194,197,200,203,206,209,212,215,218],{"slug":189,"title":190},"configuracion-general","Configuración general",{"slug":192,"title":193},"impresoras","Cómo cargar las impresoras del local",{"slug":195,"title":196},"perfiles-de-impresion","Cómo usar los perfiles de impresión",{"slug":198,"title":199},"usuarios-del-sistema","Cómo administrar los Usuarios del Sistema",{"slug":201,"title":202},"usuarios-con-pin","Cómo administrar los Usuarios con PIN",{"slug":204,"title":205},"punto-de-venta","🏛️ Trámite en ARCA (con clave fiscal)",{"slug":207,"title":208},"permisos-por-rol","Cómo configurar los Permisos por Rol",{"slug":210,"title":211},"turnos-mesa","Turnos de Mesa",{"slug":213,"title":214},"medios-de-cobro","Medios de cobro",{"slug":216,"title":217},"clasificacion-de-gastos","Clasificación de Gastos",{"slug":219,"title":220},"centros-de-costo","Centros de Costo",{"title":222,"modules":223},"Biblioteca de Drivers",[224,226,229,232,235,238,241,244,247],{"slug":225,"title":222},"biblioteca-de-drivers",{"slug":227,"title":228},"sam4s-giant-100","Sam4S Giant - 100",{"slug":230,"title":231},"citizen-ct-s310ii","Citizen CT-S310II",{"slug":233,"title":234},"epson-tm-t20","Epson TM-T20",{"slug":236,"title":237},"drivers-genericos","Drivers Genéricos POS",{"slug":239,"title":240},"epson-tm-t88","Epson TM-T88V",{"slug":242,"title":243},"fiscalberry-windows","Instalar Fiscalberry en Windows",{"slug":245,"title":246},"fiscalberry-linux","Instalar Fiscalberry en Linux",{"slug":248,"title":249},"fiscalberry-android","Instalar Fiscalberry en Android",{"title":251,"modules":252},"Extra",[253,256,259,262,265,268,271,274,277,280],{"slug":254,"title":255},"01-faq-solucion-inicial-pantalla-congelada","📖 Manual de Usuario: Solución Inicial si la Pantalla se Congela o no Carga",{"slug":257,"title":258},"03-faq-mozo-reabrir-mesa-anulada","📖 Manual de Usuario: Cómo Reabrir una Mesa Anulada o Cerrada por Error",{"slug":260,"title":261},"05-faq-cajero-emitir-factura-a","📖 Manual de Usuario: Cómo Emitir una Factura A Cargando Datos del Cliente",{"slug":263,"title":264},"06-faq-cajero-ingreso-egreso-cajon","📖 Manual de Usuario: Cómo Registrar Entradas y Salidas de Dinero del Cajón",{"slug":266,"title":267},"07-faq-cajero-activar-medio-pago","📖 Manual de Usuario: Cómo Activar un Medio de Pago que no Aparece al Cobrar",{"slug":269,"title":270},"08-faq-cajero-diferencia-facturado-vs-abiertas","📖 Manual de Usuario: Diferencia entre \"Facturado Total Mesas\" y \"Abiertas Por Usuario\" en Caja",{"slug":272,"title":273},"10-faq-supervisor-cierre-caja-diferencias","📖 Manual de Usuario: Cómo Auditar y Solucionar Diferencias en el Cierre de Caja",{"slug":275,"title":276},"preguntas-frecuentes","Preguntas Frecuentes y Guías Rápidas por Rol",{"slug":278,"title":279},"buchon-bot","Buchón Bot",{"slug":281,"title":282},"troubleshooting-semantico","📖 Guía Única de Resolución de Problemas y Errores (Troubleshooting)"],"uses":{}},{"type":"data","data":[{"slug":1,"title":2,"content":3,"tableOfContents":4,"seo":30,"llmTxtFile":34},"turnos-y-horarios-fichaje","Turnos y Horarios de Fichaje","\u003Cdiv id=\"turnos-y-horarios-de-fichaje\">\u003C/div>\n\n\u003Cblockquote>\n\u003Cp>\u003Cstrong>¿Dónde está en el sistema?:\u003C/strong> Menú principal → \u003Cstrong>RRHH\u003C/strong> → \u003Cstrong>Turnos y Horarios\u003C/strong>\n\u003Cstrong>¿Quién lo usa?:\u003C/strong> Encargados de personal y administradores\u003C/p>\n\u003C/blockquote>\n\u003Cblockquote>\n\u003Cp>🎯 \u003Cstrong>¿Para qué sirve esto?\u003C/strong>\nAcá definís los horarios de trabajo de tu personal. Por ejemplo: \u003Cem>Mañana\u003C/em>, de 08:00 a 16:00, de lunes a viernes.\nCada turno lleva una tolerancia en minutos. El sistema la usa para decidir si alguien llegó a horario.\u003C/p>\n\u003C/blockquote>\n\u003Cblockquote>\n\u003Cp>⚠️ \u003Cstrong>No los confundas con los Turnos de salón.\u003C/strong> Los de este artículo son horarios de \u003Cstrong>trabajo del personal\u003C/strong>. En \u003Cstrong>Configuración → Tablas del Sistema → Turnos\u003C/strong> están los turnos del local para arqueos y reservas. Ese es otro tema: mirá \u003Ca href=\"/user-guide/turnos-mesa\">Turnos de Mesa\u003C/a>.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🔑 Antes de empezar\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"antes-de-empezar\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"antes-de-empezar\">\u003C/div>\n\n\u003Cul>\n\u003Cli>Si no ves \u003Cstrong>RRHH\u003C/strong> en el menú, el módulo no está activo en tu comercio. Pedíselo a soporte.\u003C/li>\n\u003Cli>Tu usuario necesita el permiso de fichaje. Mirá \u003Ca href=\"/user-guide/permisos-por-rol\">Permisos por Rol\u003C/a>.\u003C/li>\n\u003Cli>Primero creás los turnos. Después se los asignás a cada persona en su ficha de \u003Ca href=\"/user-guide/empleados\">Empleados\u003C/a>.\u003C/li>\n\u003C/ul>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                📍 Ver la lista de turnos — Paso 1\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"ver-la-lista-de-turnos-paso-1\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"ver-la-lista-de-turnos-paso-1\">\u003C/div>\n\n\u003Col>\n\u003Cli>En el menú de la izquierda, tocá \u003Cstrong>RRHH\u003C/strong>.\u003C/li>\n\u003Cli>Tocá \u003Cstrong>Turnos y Horarios\u003C/strong>.\u003C/li>\n\u003Cli>Se abre la pantalla \u003Cstrong>Turnos de Fichaje\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cp>Cada turno aparece en un bloque, con su nombre arriba. Adentro ves:\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Ingreso\u003C/strong>: la hora en que empieza el turno.\u003C/li>\n\u003Cli>\u003Cstrong>Egreso\u003C/strong>: la hora en que termina.\u003C/li>\n\u003Cli>\u003Cstrong>Tolerancia\u003C/strong>: los minutos de margen.\u003C/li>\n\u003Cli>\u003Cstrong>Días\u003C/strong>: los días de la semana en que rige. Por ejemplo: \u003Cem>Lunes, Martes, Miércoles\u003C/em>.\u003C/li>\n\u003C/ul>\n\u003Cp>A la derecha de cada bloque hay dos botones: \u003Cstrong>editar\u003C/strong> (gris) y \u003Cstrong>eliminar\u003C/strong> (rojo).\u003C/p>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                ➕ Crear un turno — Paso 2\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"crear-un-turno-paso-2\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"crear-un-turno-paso-2\">\u003C/div>\n\n\u003Col>\n\u003Cli>Arriba a la derecha, tocá el botón verde \u003Cstrong>Nuevo turno\u003C/strong>.\u003C/li>\n\u003Cli>Completá los casilleros:\u003Cul>\n\u003Cli>\u003Cstrong>Nombre\u003C/strong>: cómo lo vas a reconocer. Por ejemplo: \u003Cem>Mañana\u003C/em>.\u003C/li>\n\u003Cli>\u003Cstrong>Días de la semana\u003C/strong>: tildá los días en que se trabaja este turno. Las opciones van de \u003Cstrong>Lunes\u003C/strong> a \u003Cstrong>Domingo\u003C/strong>. Tildá al menos uno.\u003C/li>\n\u003Cli>\u003Cstrong>Hora Ingreso\u003C/strong>: elegí hora y minutos de entrada. Por ejemplo: \u003Cem>08:00\u003C/em>.\u003C/li>\n\u003Cli>\u003Cstrong>Hora Egreso\u003C/strong>: elegí hora y minutos de salida. Por ejemplo: \u003Cem>16:00\u003C/em>.\u003C/li>\n\u003Cli>\u003Cstrong>Tolerancia (minutos)\u003C/strong>: escribí un número. Por ejemplo: \u003Cem>10\u003C/em>.\u003C/li>\n\u003C/ul>\n\u003C/li>\n\u003Cli>Tocá el botón azul \u003Cstrong>Guardar\u003C/strong>.\u003C/li>\n\u003Cli>Volvés a la lista y ves el turno nuevo.\u003C/li>\n\u003C/ol>\n\u003Cblockquote>\n\u003Cp>💡 \u003Cstrong>Consejo útil:\u003C/strong> para un turno partido, creá dos turnos. Por ejemplo \u003Cem>Mediodía\u003C/em> (11 a 15) y \u003Cem>Noche\u003C/em> (19 a 23). Después asignale los dos a la misma persona.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                ⏱️ Qué hace la tolerancia\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"que-hace-la-tolerancia\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"que-hace-la-tolerancia\">\u003C/div>\n\n\u003Cp>La tolerancia es el margen de minutos alrededor de la \u003Cstrong>hora de ingreso\u003C/strong>.\u003C/p>\n\u003Cul>\n\u003Cli>Con turno de ingreso a las 08:00 y tolerancia de 10, entrar hasta las 08:10 cuenta como \u003Cstrong>a horario\u003C/strong>.\u003C/li>\n\u003Cli>Pasadas las 08:10, cuenta como \u003Cstrong>llegada tarde\u003C/strong>.\u003C/li>\n\u003Cli>Entrar más de 10 minutos antes de las 08:00 cuenta como \u003Cstrong>llegada temprano\u003C/strong>.\u003C/li>\n\u003Cli>Con tolerancia vacía o en 0, cualquier minuto de diferencia cuenta.\u003C/li>\n\u003C/ul>\n\u003Cp>Esas cuentas aparecen en el \u003Ca href=\"/user-guide/reporte-mensual-fichaje\">Reporte Mensual\u003C/a> y en la ficha de cada empleado.\u003C/p>\n\u003Cp>El sistema también usa el turno para saber a cuál corresponde cada fichada. Toma los turnos asignados a la persona que rigen ese día de la semana. Elige el que tiene la hora de ingreso más cercana.\u003C/p>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                👤 Asignar turnos a una persona — Paso 3\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"asignar-turnos-a-una-persona-paso-3\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"asignar-turnos-a-una-persona-paso-3\">\u003C/div>\n\n\u003Cp>Crear el turno no alcanza. Hay que asignárselo a cada persona.\u003C/p>\n\u003Col>\n\u003Cli>Abrí la ficha del empleado en \u003Ca href=\"/user-guide/empleados\">Empleados\u003C/a> para crearlo o editarlo.\u003C/li>\n\u003Cli>Buscá el cuadro \u003Cstrong>Jornada y Turnos\u003C/strong>.\u003C/li>\n\u003Cli>En \u003Cstrong>Turnos Asignados\u003C/strong>, tildá los turnos de esa persona.\u003C/li>\n\u003Cli>Guardá la ficha.\u003C/li>\n\u003C/ol>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                ✏️ Cambiar un turno — Paso 4\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"cambiar-un-turno-paso-4\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"cambiar-un-turno-paso-4\">\u003C/div>\n\n\u003Col>\n\u003Cli>En la lista, tocá el botón \u003Cstrong>editar\u003C/strong> del turno.\u003C/li>\n\u003Cli>Cambiá lo que necesites. Los días vienen tildados.\u003C/li>\n\u003Cli>Tocá \u003Cstrong>Guardar\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cp>Al guardar, volvés a la lista con un mensaje de que se guardó.\u003C/p>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🗑️ Eliminar un turno — Paso 5\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"eliminar-un-turno-paso-5\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"eliminar-un-turno-paso-5\">\u003C/div>\n\n\u003Cblockquote>\n\u003Cp>⚠️ \u003Cstrong>Atención:\u003C/strong> eliminar saca el turno de la lista. Confirmá que ya no lo necesitás.\u003C/p>\n\u003C/blockquote>\n\u003Col>\n\u003Cli>En la lista, tocá el botón rojo \u003Cstrong>eliminar\u003C/strong>.\u003C/li>\n\u003Cli>El sistema pregunta \u003Cstrong>Desea eliminar?\u003C/strong>.\u003C/li>\n\u003Cli>Confirmá para borrarlo.\u003C/li>\n\u003C/ol>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                ⚠️ Resolución de Inconvenientes\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"resolucion-de-inconvenientes\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"resolucion-de-inconvenientes\">\u003C/div>\n\n\u003Cdiv class=\"table-wrapper\">\u003Ctable>\n\u003Cthead>\n\u003Ctr>\n\u003Cth>Problema\u003C/th>\n\u003Cth>Causa más frecuente\u003C/th>\n\u003Cth>Solución recomendada\u003C/th>\n\u003C/tr>\n\u003C/thead>\n\u003Ctbody>\u003Ctr>\n\u003Ctd>El sistema marca llegada tarde a alguien puntual.\u003C/td>\n\u003Ctd>La tolerancia está en 0, o la hora de ingreso del turno está mal.\u003C/td>\n\u003Ctd>Editá el turno. Revisá \u003Cstrong>Hora Ingreso\u003C/strong> y subí \u003Cstrong>Tolerancia (minutos)\u003C/strong>.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>La fichada de una persona no toma su turno.\u003C/td>\n\u003Ctd>No le asignaste el turno, o el turno no incluye ese día.\u003C/td>\n\u003Ctd>Revisá \u003Cstrong>Turnos Asignados\u003C/strong> en su ficha y los días tildados en el turno.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>No encuentro los turnos que uso para los arqueos.\u003C/td>\n\u003Ctd>Son otros turnos: los del local.\u003C/td>\n\u003Ctd>Están en \u003Cstrong>Configuración → Tablas del Sistema → Turnos\u003C/strong>. Mirá \u003Ca href=\"/user-guide/turnos-mesa\">Turnos de Mesa\u003C/a>.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>El turno no muestra los días que quería.\u003C/td>\n\u003Ctd>Al guardar, los días quedan como los tildaste.\u003C/td>\n\u003Ctd>Editá el turno y dejá tildados todos los días que correspondan.\u003C/td>\n\u003C/tr>\n\u003C/tbody>\u003C/table>\u003C/div>\n",[5,9,12,15,18,21,24,27],{"id":6,"title":7,"level":8},"antes-de-empezar","Antes de empezar",2,{"id":10,"title":11,"level":8},"ver-la-lista-de-turnos-paso-1","Ver la lista de turnos — Paso 1",{"id":13,"title":14,"level":8},"crear-un-turno-paso-2","Crear un turno — Paso 2",{"id":16,"title":17,"level":8},"que-hace-la-tolerancia","Qué hace la tolerancia",{"id":19,"title":20,"level":8},"asignar-turnos-a-una-persona-paso-3","Asignar turnos a una persona — Paso 3",{"id":22,"title":23,"level":8},"cambiar-un-turno-paso-4","Cambiar un turno — Paso 4",{"id":25,"title":26,"level":8},"eliminar-un-turno-paso-5","Eliminar un turno — Paso 5",{"id":28,"title":29,"level":8},"resolucion-de-inconvenientes","Resolución de Inconvenientes",{"title":31,"description":32,"keywords":33},"Turnos y Horarios de Fichaje - Manual","¿Dónde está en el sistema?: Menú principal → RRHH → Turnos y Horarios\n ¿Quién lo usa?: Encargados de personal y administradores","turnos y horarios fichaje, paxapos, turnos y horarios de fichaje, tutorial, guía, manual usuario","96-turnos-y-horarios-fichaje.txt"],"uses":{"params":["slug"]}}]}
