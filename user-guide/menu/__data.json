{"type":"data","nodes":[null,{"type":"data","data":[{"moduleCategories":1},[2,17,44,53,77,98,110,140,146,173,185,221,250],{"title":3,"modules":4},"Comenzamos",[5,8,11,14],{"slug":6,"title":7},"introduccion","Bienvenido a tu software gastronómico",{"slug":9,"title":10},"iniciar-sesion","Cómo Iniciar Sesión",{"slug":12,"title":13},"recuperar-contrasena","Cómo Recuperar tu Contraseña",{"slug":15,"title":16},"guia-de-inicio-rapido","Guía de Inicio Rápido",{"title":18,"modules":19},"Ventas",[20,23,26,29,32,35,38,41],{"slug":21,"title":22},"salon-de-ventas","Cómo Usar el Salón de Ventas (Adición)",{"slug":24,"title":25},"caja-rapida","Cómo Usar la Caja Rápida (Registradora)",{"slug":27,"title":28},"mozos","Cómo Cargar los Mozos",{"slug":30,"title":31},"clientes","Cómo Gestionar los Clientes",{"slug":33,"title":34},"descuentos","Cómo Configurar Descuentos",{"slug":36,"title":37},"nueva-reserva","Cómo Cargar una Nueva Reserva",{"slug":39,"title":40},"listado-de-reservas","Cómo Usar el Listado de Reservas",{"slug":42,"title":43},"grilla-de-reservas","Cómo Usar la Grilla de Reservas",{"title":45,"modules":46},"Medios de Pago",[47,50],{"slug":48,"title":49},"configuracion-procesadores","Configuración de Procesadores de Pago",{"slug":51,"title":52},"transacciones-mercadopago","Transacciones MercadoPago",{"title":54,"modules":55},"Productos",[56,59,62,65,68,71,74],{"slug":57,"title":58},"menu","Menú de Productos (Carta)",{"slug":60,"title":61},"categorias","Categorías de Productos",{"slug":63,"title":64},"variantes-grupo-sabores","Variantes y Grupos de Sabores",{"slug":66,"title":67},"maestro-de-productos","Maestro de Productos",{"slug":69,"title":70},"subproductos-elaborados","Sub-Productos (Elaborados)",{"slug":72,"title":73},"recetas","Recetas",{"slug":75,"title":76},"analisis-duplicados","Buscar Duplicados",{"title":78,"modules":79},"Compras",[80,83,86,89,92,95],{"slug":81,"title":82},"todas-las-ordenes-compra","Órdenes de Compra",{"slug":84,"title":85},"crear-orden-compra","Crear una Orden de Compra",{"slug":87,"title":88},"ordenes-a-aprobar","Órdenes a aprobar",{"slug":90,"title":91},"mercaderias","Mercaderías",{"slug":93,"title":94},"proveedores","Proveedores",{"slug":96,"title":97},"historial-de-compras","Historial de Compras",{"title":99,"modules":100},"Stock",[101,104,107],{"slug":102,"title":103},"stock-mercaderias","Stock de Mercaderías",{"slug":105,"title":106},"stock-subproductos","Stock de Subproductos",{"slug":108,"title":109},"movimientos-de-stock","Movimientos de Stock",{"title":111,"modules":112},"Finanzas",[113,116,119,122,125,128,131,134,137],{"slug":114,"title":115},"arqueos-de-caja","Arqueos de Caja",{"slug":117,"title":118},"listado-de-cajas","Listado de Cajas",{"slug":120,"title":121},"transacciones-de-cobro","Transacciones de Cobro",{"slug":123,"title":124},"factura-manual","Factura Manual",{"slug":126,"title":127},"resumen-de-deuda","Resumen de Deuda",{"slug":129,"title":130},"pagos","Pagos",{"slug":132,"title":133},"historial-de-facturas","Historial de Facturas",{"slug":135,"title":136},"historico-de-mesas","Histórico de Mesas",{"slug":138,"title":139},"puntos-de-venta-pdv","Puntos de Venta (PDVs)",{"title":141,"modules":142},"Comandero",[143],{"slug":144,"title":145},"comandero","Comandero (pantalla de cocina)",{"title":147,"modules":148},"RRHH",[149,152,155,158,161,164,167,170],{"slug":150,"title":151},"empleados","Empleados",{"slug":153,"title":154},"empleados-trabajando","Empleados Trabajando",{"slug":156,"title":157},"registro-diario-fichaje","Registro Diario de Fichaje",{"slug":159,"title":160},"reporte-mensual-fichaje","Reporte Mensual de Fichaje",{"slug":162,"title":163},"departamentos","Departamentos",{"slug":165,"title":166},"turnos-y-horarios-fichaje","Turnos y Horarios de Fichaje",{"slug":168,"title":169},"sueldos-y-jornales","Sueldos y Jornales",{"slug":171,"title":172},"datos-de-acceso-app","Datos de Acceso a la App de Fichaje",{"title":174,"modules":175},"Reportes",[176,179,182],{"slug":177,"title":178},"tablero-general","Tablero General",{"slug":180,"title":181},"productos-mas-vendidos","Productos Más Vendidos",{"slug":183,"title":184},"compras-por-mercaderia","Compras por Mercadería",{"title":186,"modules":187},"Configuracion",[188,191,194,197,200,203,206,209,212,215,218],{"slug":189,"title":190},"configuracion-general","Configuración general",{"slug":192,"title":193},"impresoras","Cómo cargar las impresoras del local",{"slug":195,"title":196},"perfiles-de-impresion","Cómo usar los perfiles de impresión",{"slug":198,"title":199},"usuarios-del-sistema","Cómo administrar los Usuarios del Sistema",{"slug":201,"title":202},"usuarios-con-pin","Cómo administrar los Usuarios con PIN",{"slug":204,"title":205},"punto-de-venta","🏛️ Trámite en ARCA (con clave fiscal)",{"slug":207,"title":208},"permisos-por-rol","Cómo configurar los Permisos por Rol",{"slug":210,"title":211},"turnos-mesa","Turnos de Mesa",{"slug":213,"title":214},"medios-de-cobro","Medios de cobro",{"slug":216,"title":217},"clasificacion-de-gastos","Clasificación de Gastos",{"slug":219,"title":220},"centros-de-costo","Centros de Costo",{"title":222,"modules":223},"Biblioteca de Drivers",[224,226,229,232,235,238,241,244,247],{"slug":225,"title":222},"biblioteca-de-drivers",{"slug":227,"title":228},"sam4s-giant-100","Sam4S Giant - 100",{"slug":230,"title":231},"citizen-ct-s310ii","Citizen CT-S310II",{"slug":233,"title":234},"epson-tm-t20","Epson TM-T20",{"slug":236,"title":237},"drivers-genericos","Drivers Genéricos POS",{"slug":239,"title":240},"epson-tm-t88","Epson TM-T88V",{"slug":242,"title":243},"fiscalberry-windows","Instalar Fiscalberry en Windows",{"slug":245,"title":246},"fiscalberry-linux","Instalar Fiscalberry en Linux",{"slug":248,"title":249},"fiscalberry-android","Instalar Fiscalberry en Android",{"title":251,"modules":252},"Extra",[253,256,259,262,265,268,271,274,277,280],{"slug":254,"title":255},"01-faq-solucion-inicial-pantalla-congelada","📖 Manual de Usuario: Solución Inicial si la Pantalla se Congela o no Carga",{"slug":257,"title":258},"03-faq-mozo-reabrir-mesa-anulada","📖 Manual de Usuario: Cómo Reabrir una Mesa Anulada o Cerrada por Error",{"slug":260,"title":261},"05-faq-cajero-emitir-factura-a","📖 Manual de Usuario: Cómo Emitir una Factura A Cargando Datos del Cliente",{"slug":263,"title":264},"06-faq-cajero-ingreso-egreso-cajon","📖 Manual de Usuario: Cómo Registrar Entradas y Salidas de Dinero del Cajón",{"slug":266,"title":267},"07-faq-cajero-activar-medio-pago","📖 Manual de Usuario: Cómo Activar un Medio de Pago que no Aparece al Cobrar",{"slug":269,"title":270},"08-faq-cajero-diferencia-facturado-vs-abiertas","📖 Manual de Usuario: Diferencia entre \"Facturado Total Mesas\" y \"Abiertas Por Usuario\" en Caja",{"slug":272,"title":273},"10-faq-supervisor-cierre-caja-diferencias","📖 Manual de Usuario: Cómo Auditar y Solucionar Diferencias en el Cierre de Caja",{"slug":275,"title":276},"preguntas-frecuentes","Preguntas Frecuentes y Guías Rápidas por Rol",{"slug":278,"title":279},"buchon-bot","Buchón Bot",{"slug":281,"title":282},"troubleshooting-semantico","📖 Guía Única de Resolución de Problemas y Errores (Troubleshooting)"],"uses":{}},{"type":"data","data":[{"slug":1,"title":2,"content":3,"tableOfContents":4,"seo":55,"llmTxtFile":59},"menu","Menú de Productos (Carta)","\u003Cdiv id=\"menu-de-productos-carta\">\u003C/div>\n\n\u003Cblockquote>\n\u003Cp>\u003Cstrong>¿Dónde está en el sistema?:\u003C/strong> Menú principal → \u003Cstrong>Productos\u003C/strong> → \u003Cstrong>Menú\u003C/strong>\n\u003Cstrong>¿Quién lo usa?:\u003C/strong> Encargados de la carta y administradores\u003C/p>\n\u003C/blockquote>\n\u003Cblockquote>\n\u003Cp>🎯 \u003Cstrong>¿Para qué sirve esto?\u003C/strong>\nEl \u003Cstrong>Menú\u003C/strong> es la lista de todo lo que vendés. Es lo que ven los mozos cuando cargan una mesa, y tus clientes en el menú online.\nAcá agregás productos, les ponés precio y elegís por qué impresora sale cada comanda.\u003C/p>\n\u003C/blockquote>\n\u003Cblockquote>\n\u003Cp>🧭 \u003Cstrong>Primeros pasos para armar tu menú:\u003C/strong>\u003C/p>\n\u003Col>\n\u003Cli>Creá las \u003Ca href=\"/user-guide/categorias\">Categorías\u003C/a> y las \u003Ca href=\"/user-guide/variantes-grupo-sabores\">Variantes\u003C/a>. No importa el orden.\u003C/li>\n\u003Cli>Cargá los productos en el menú (esta guía).\u003C/li>\n\u003C/ol>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🔑 Antes de empezar\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"antes-de-empezar\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"antes-de-empezar\">\u003C/div>\n\n\u003Cul>\n\u003Cli>Tener creadas las \u003Ca href=\"/user-guide/categorias\">Categorías\u003C/a>.\u003C/li>\n\u003Cli>Si algún producto lleva opciones, tener creadas sus \u003Ca href=\"/user-guide/variantes-grupo-sabores\">Variantes\u003C/a>.\u003C/li>\n\u003Cli>Para elegir la impresora de cada producto, tenerlas cargadas. Mirá \u003Ca href=\"/user-guide/impresoras\">Impresoras\u003C/a>.\u003C/li>\n\u003Cli>Tu usuario tiene que tener el permiso del \u003Cstrong>Menú\u003C/strong> en \u003Ca href=\"/user-guide/permisos-por-rol\">Permisos por Rol\u003C/a>.\u003C/li>\n\u003C/ul>\n\u003Cblockquote>\n\u003Cp>💡 \u003Cstrong>Consejo útil:\u003C/strong> tu comercio ya arranca con un menú creado. No hace falta crear otro: solo cargale los productos.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                📍 Paso 1: Entrá a la pantalla\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-1-entra-a-la-pantalla\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-1-entra-a-la-pantalla\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/41-00a-menu-grupo-productos.png\" alt=\"Menú lateral con el grupo Productos marcado en rojo\">\u003C/p>\n\u003Col>\n\u003Cli>En el menú de la izquierda, tocá \u003Cstrong>Productos\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/41-00b-menu-opcion-index-vendibles.png\" alt=\"Opción Menú marcada en rojo en el menú lateral\">\u003C/p>\n\u003Col start=\"2\">\n\u003Cli>Tocá \u003Cstrong>Menú\u003C/strong>. Es la primera opción.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/41-01-pantalla-index-vendibles.png\" alt=\"Pantalla del Menú Catálogo con la lista de productos\">\u003C/p>\n\u003Cp>Así se ve la pantalla. Arriba están los botones. Abajo, la lista de productos con su precio.\u003C/p>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/41-53-encabezado-menu.png\" alt=\"Barra de arriba: Menú Catálogo, Agregar Producto, Importar, Exportar, Configurar, ayuda y más opciones\">\u003C/p>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                ➕ Paso 2: Agregá un producto al menú\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-2-agrega-un-producto-al-menu\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-2-agrega-un-producto-al-menu\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/41-55-donde-esta-boton-agregar-producto.png\" alt=\"Pantalla con el botón azul Agregar Producto marcado en rojo\">\u003C/p>\n\u003Col>\n\u003Cli>Tocá el botón azul \u003Cstrong>Agregar Producto\u003C/strong>.\u003C/li>\n\u003Cli>Se abre la pantalla \u003Cstrong>Agregar Producto al Menú\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/41-74-pantalla-agregar-producto.png\" alt=\"Pantalla Agregar Producto al Menú con Milanesa napolitana a $ 4500\">\u003C/p>\n\u003Cp>Tiene varias partes. Las importantes son \u003Cstrong>PASO 1\u003C/strong>, \u003Cstrong>PASO 2\u003C/strong> y \u003Cstrong>PASO 3\u003C/strong>.\u003C/p>\n\u003Ch3 class=\"relative\">\n                PASO 1 · Información Básica (obligatoria)\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-1-informacion-basica\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h3>\n            \u003Cdiv id=\"paso-1-informacion-basica\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/41-75-seccion-paso-1.png\" alt=\"Recuadro rojo PASO 1 Información Básica completo\">\u003C/p>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/41-76-campo-nombre-del-producto.png\" alt=\"Casillero Nombre del Producto con Milanesa napolitana\">\u003C/p>\n\u003Col start=\"3\">\n\u003Cli>En \u003Cstrong>Nombre del Producto\u003C/strong>, escribí el nombre. Por ejemplo: \u003Cem>Milanesa napolitana\u003C/em>.\u003C/li>\n\u003Cli>Si el producto ya existe, aparece en una lista mientras escribís. Tocalo para elegirlo.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/41-77-campo-categoria.png\" alt=\"Lista Categoría con Especialidades elegida\">\u003C/p>\n\u003Col start=\"5\">\n\u003Cli>En \u003Cstrong>Categoría\u003C/strong>, elegí dónde aparece en el menú. Por ejemplo: \u003Cem>Especialidades\u003C/em>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/41-78-campo-precio-de-venta.png\" alt=\"Casillero Precio de Venta con 4500\">\u003C/p>\n\u003Col start=\"6\">\n\u003Cli>En \u003Cstrong>Precio de Venta\u003C/strong>, escribí el precio al público. Por ejemplo: \u003Cem>4500\u003C/em>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/41-79-campo-moneda.png\" alt=\"Lista Moneda con Argentina Peso\">\u003C/p>\n\u003Col start=\"7\">\n\u003Cli>\u003Cstrong>Moneda\u003C/strong>: dejala como viene, salvo que vendas en otra moneda.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/41-80-campo-impuesto.png\" alt=\"Lista Impuesto / IVA con IVA 21%\">\u003C/p>\n\u003Col start=\"8\">\n\u003Cli>En \u003Cstrong>Impuesto / IVA\u003C/strong>, elegí el IVA del producto. Por ejemplo: \u003Cem>IVA 21%\u003C/em>.\u003C/li>\n\u003C/ol>\n\u003Cblockquote>\n\u003Cp>⚠️ \u003Cstrong>Atención:\u003C/strong> si el IVA está mal cargado, el producto no se puede facturar bien. La lista del menú te avisa qué productos tienen ese problema.\u003C/p>\n\u003C/blockquote>\n\u003Ch3 class=\"relative\">\n                PASO 2 · Variantes del Producto (si hace falta)\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-2-variantes-del-producto\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h3>\n            \u003Cdiv id=\"paso-2-variantes-del-producto\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/41-81-seccion-paso-2-variantes.png\" alt=\"Recuadro PASO 2 Variantes del Producto con la variante Gustos de helado\">\u003C/p>\n\u003Col start=\"9\">\n\u003Cli>Tildá las variantes que lleva el producto. Por ejemplo: \u003Cem>Gustos de helado\u003C/em>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/41-82-donde-esta-boton-administrar-variantes.png\" alt=\"Pantalla con el botón naranja Administrar Variantes marcado en rojo\">\u003C/p>\n\u003Col start=\"10\">\n\u003Cli>Si no está la que necesitás, tocá \u003Cstrong>Administrar Variantes\u003C/strong> para crearla. Mirá \u003Ca href=\"/user-guide/variantes-grupo-sabores\">Variantes\u003C/a>.\u003C/li>\n\u003C/ol>\n\u003Ch3 class=\"relative\">\n                PASO 3 · Configuración Operativa (impresora)\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-3-configuracion-operativa\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h3>\n            \u003Cdiv id=\"paso-3-configuracion-operativa\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/41-84-seccion-paso-3-impresoras.png\" alt=\"Recuadro PASO 3 Configuración Operativa con ¿Dónde se imprime la comanda?\">\u003C/p>\n\u003Col start=\"11\">\n\u003Cli>En \u003Cstrong>¿Dónde se imprime la comanda?\u003C/strong>, tildá la impresora de este producto. Por ejemplo: \u003Cem>Cocina\u003C/em> o \u003Cem>Barra\u003C/em>.\u003C/li>\n\u003Cli>\u003Cstrong>Puesto\u003C/strong> y \u003Cstrong>Depósito\u003C/strong> son opcionales. Si no los usás, dejalos como están.\u003C/li>\n\u003C/ol>\n\u003Cblockquote>\n\u003Cp>💡 \u003Cstrong>Consejo útil:\u003C/strong> la impresora se elige en cada producto. Así la bebida sale en la barra y la comida en la cocina.\u003C/p>\n\u003C/blockquote>\n\u003Ch3 class=\"relative\">\n                Opciones Adicionales (opcional)\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"opciones-adicionales-opcional\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h3>\n            \u003Cdiv id=\"opciones-adicionales-opcional\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/41-85-donde-esta-boton-mostrar-ocultar.png\" alt=\"Pantalla con el botón Mostrar/Ocultar de Opciones Adicionales marcado en rojo\">\u003C/p>\n\u003Col start=\"13\">\n\u003Cli>Si querés, tocá \u003Cstrong>Mostrar/Ocultar\u003C/strong> en \u003Cstrong>Opciones Adicionales\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/41-87-seccion-opcional-abierta.png\" alt=\"Opciones Adicionales abiertas: Orden y Nombre en Ticket\">\u003C/p>\n\u003Col start=\"14\">\n\u003Cli>\u003Cstrong>Orden\u003C/strong>: en qué lugar aparece en su categoría. \u003Cstrong>Nombre en Ticket\u003C/strong>: un nombre más corto para la comanda y el ticket.\u003C/li>\n\u003C/ol>\n\u003Ch3 class=\"relative\">\n                Guardá el producto\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"guarda-el-producto\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h3>\n            \u003Cdiv id=\"guarda-el-producto\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/41-88-donde-esta-boton-guardar-producto.png\" alt=\"Pantalla con el botón azul Guardar Producto marcado en rojo\">\u003C/p>\n\u003Col start=\"15\">\n\u003Cli>Tocá el botón azul \u003Cstrong>Guardar Producto\u003C/strong>, abajo de todo.\u003C/li>\n\u003Cli>El producto aparece en la lista. Los mozos ya lo pueden cargar en el \u003Ca href=\"/user-guide/salon-de-ventas\">Salón de Ventas\u003C/a>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/41-90-donde-esta-boton-cancelar.png\" alt=\"Pantalla con el botón Cancelar marcado en rojo\">\u003C/p>\n\u003Cblockquote>\n\u003Cp>💡 \u003Cstrong>Consejo útil:\u003C/strong> si te arrepentiste, tocá \u003Cstrong>Cancelar\u003C/strong>, debajo de \u003Cstrong>Guardar Producto\u003C/strong>. No se guarda nada.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                💲 Paso 3: Cambiá un precio desde la lista\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-3-cambia-un-precio-desde-la-lista\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-3-cambia-un-precio-desde-la-lista\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/41-69-fila-producto.png\" alt=\"Renglón de un producto con su stock, categoría, impresora y precio\">\u003C/p>\n\u003Col>\n\u003Cli>Buscá el producto en la lista.\u003C/li>\n\u003Cli>Hacé clic sobre su \u003Cstrong>Precio\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/41-70-celda-precio-editando.png\" alt=\"Renglón con el precio abierto para escribir y un botón verde para confirmar\">\u003C/p>\n\u003Col start=\"3\">\n\u003Cli>Escribí el precio nuevo y tocá el botón verde ✔ (o Enter).\u003C/li>\n\u003C/ol>\n\u003Cblockquote>\n\u003Cp>💡 \u003Cstrong>Consejo útil:\u003C/strong> lo mismo sirve para el nombre, la categoría, el orden y otras columnas. Hacé clic en la celda y cambiala.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                ✏️ Paso 4: Cambiá todos los datos de un producto\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-4-cambia-todos-los-datos-de-un-producto\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-4-cambia-todos-los-datos-de-un-producto\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/41-49-donde-esta-boton-icono.png\" alt=\"Lista con el lápiz de un producto marcado en rojo, a la derecha\">\u003C/p>\n\u003Col>\n\u003Cli>Tocá el lápiz ✏️ a la derecha del producto. Si no lo ves, mové la lista hacia la derecha.\u003C/li>\n\u003Cli>Se abre la misma pantalla que al agregarlo, con sus datos. Cambiá lo que necesites.\u003C/li>\n\u003Cli>Tocá \u003Cstrong>Guardar Producto\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/41-92-seccion-avanzado-abierta.png\" alt=\"Sección AVANZADO Modificar Producto Maestro abierta, con nombre, código, imagen y Sin Stock\">\u003C/p>\n\u003Cp>Al editar aparece además \u003Cstrong>AVANZADO · Modificar Producto Maestro\u003C/strong>. Ahí cambiás el nombre, el código de barras, la foto o marcás \u003Cstrong>Sin Stock\u003C/strong> para que no se pueda vender por un rato.\u003C/p>\n\u003Cblockquote>\n\u003Cp>⚠️ \u003Cstrong>Atención:\u003C/strong> lo que cambies en \u003Cstrong>AVANZADO\u003C/strong> cambia el producto en \u003Cstrong>todos\u003C/strong> tus menús.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🗑️ Paso 5: Sacá un producto del menú\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-5-saca-un-producto-del-menu\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-5-saca-un-producto-del-menu\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/41-51-donde-esta-boton-js-delete-producto.png\" alt=\"Lista con el tacho de un producto marcado en rojo\">\u003C/p>\n\u003Col>\n\u003Cli>Tocá el tacho 🗑️ a la derecha del producto.\u003C/li>\n\u003Cli>El sistema te pregunta si estás seguro. Confirmá para sacarlo.\u003C/li>\n\u003C/ol>\n\u003Cblockquote>\n\u003Cp>💡 \u003Cstrong>Consejo útil:\u003C/strong> el producto sale de este menú, pero sigue existiendo en el \u003Ca href=\"/user-guide/maestro-de-productos\">Maestro de Productos\u003C/a>.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🔎 Paso 6: Buscá un producto\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-6-busca-un-producto\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-6-busca-un-producto\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/41-04-campo-quick-search.png\" alt=\"Casillero Buscar en todos los productos con ALFAJOR escrito\">\u003C/p>\n\u003Col>\n\u003Cli>En \u003Cstrong>Buscar en todos los productos...\u003C/strong>, escribí parte del nombre y tocá Enter. Por ejemplo: \u003Cem>ALFAJOR\u003C/em>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/41-65-resultado-busqueda.png\" alt=\"Lista con los productos que tienen ALFAJOR en el nombre\">\u003C/p>\n\u003Col start=\"2\">\n\u003Cli>La lista muestra solo los que coinciden.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/41-05-donde-esta-boton-icono.png\" alt=\"Pantalla con la cruz para borrar la búsqueda marcada en rojo\">\u003C/p>\n\u003Col start=\"3\">\n\u003Cli>Para ver todo de nuevo, tocá la cruz ⊗ dentro del casillero.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/41-47-donde-esta-boton-limpiar-busqueda.png\" alt=\"Pantalla sin resultados con el botón Limpiar búsqueda marcado en rojo\">\u003C/p>\n\u003Col start=\"4\">\n\u003Cli>Si no encuentra nada, tocá \u003Cstrong>Limpiar búsqueda\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🧰 Paso 7: Filtrá la lista\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-7-filtra-la-lista\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-7-filtra-la-lista\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/41-66-donde-esta-boton-filtros.png\" alt=\"Pantalla con el botón Filtros marcado en rojo\">\u003C/p>\n\u003Col>\n\u003Cli>Tocá \u003Cstrong>Filtros\u003C/strong>, arriba a la derecha.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/41-68-panel-filtros.png\" alt=\"Panel Filtros avanzados abierto\">\u003C/p>\n\u003Col start=\"2\">\n\u003Cli>\u003Cp>Se abre el panel \u003Cstrong>Filtros avanzados\u003C/strong>. Completá solo lo que necesites:\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Nombre del producto\u003C/strong>, \u003Cstrong>Nombre en ticket\u003C/strong> y \u003Cstrong>Stock\u003C/strong> (con stock o sin stock)\u003C/li>\n\u003Cli>\u003Cstrong>Puesto\u003C/strong>, \u003Cstrong>Categoría\u003C/strong> e \u003Cstrong>Impresora\u003C/strong>. Por ejemplo: todo lo que sale por la \u003Cem>Barra\u003C/em>.\u003C/li>\n\u003Cli>\u003Cstrong>Impuesto\u003C/strong>, \u003Cstrong>Precio exacto\u003C/strong> y \u003Cstrong>Orden\u003C/strong>.\u003C/li>\n\u003C/ul>\n\u003C/li>\n\u003Cli>\u003Cp>Tocá \u003Cstrong>Buscar\u003C/strong>, abajo a la derecha del panel.\u003C/p>\n\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/41-32-donde-esta-boton-limpiar-filtros.png\" alt=\"Panel de filtros con el botón Limpiar filtros marcado en rojo\">\u003C/p>\n\u003Col start=\"4\">\n\u003Cli>Para sacar todos los filtros, tocá \u003Cstrong>Limpiar filtros\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/41-07-donde-esta-boton-close.png\" alt=\"Panel de filtros con la cruz de cerrar marcada en rojo\">\u003C/p>\n\u003Col start=\"5\">\n\u003Cli>Para cerrar el panel, tocá la cruz \u003Cstrong>×\u003C/strong> de arriba a la derecha.\u003C/li>\n\u003C/ol>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                ☑️ Paso 8: Cambiá muchos productos de una vez\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-8-cambia-muchos-productos-de-una-vez\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-8-cambia-muchos-productos-de-una-vez\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/41-46-campo-select-all-products.png\" alt=\"Casilla para tildar todos los productos\">\u003C/p>\n\u003Col>\n\u003Cli>Tildá la casilla de cada producto que querés cambiar. La de arriba de todo los tilda a todos.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/41-71-barra-seleccionados.png\" alt=\"Barra de abajo: 1 seleccionado, Categoría, Puesto, Impuesto, Impresora, Stock, Eliminar y una cruz\">\u003C/p>\n\u003Col start=\"2\">\n\u003Cli>Abajo aparece una barra con lo que podés cambiar.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/41-34-donde-esta-boton-flecha.png\" alt=\"Pantalla con el botón Categoría de la barra marcado en rojo\">\u003C/p>\n\u003Col start=\"3\">\n\u003Cli>Tocá lo que querés cambiar. Por ejemplo: \u003Cstrong>Categoría\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/41-72-accion-masiva-abierta.png\" alt=\"Lista de categorías abierta sobre la barra\">\u003C/p>\n\u003Col start=\"4\">\n\u003Cli>Elegí el valor nuevo de la lista.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/41-73-ventana-confirmar-accion-masiva.png\" alt=\"Ventana Cambiar Categoría: Se asignará categoría a 1 producto(s)\">\u003C/p>\n\u003Col start=\"5\">\n\u003Cli>Se abre una ventana que te dice qué va a cambiar.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/41-44-donde-esta-boton-bulk-confirm-ok.png\" alt=\"Ventana con el botón Confirmar marcado en rojo\">\u003C/p>\n\u003Col start=\"6\">\n\u003Cli>Si está bien, tocá \u003Cstrong>Confirmar\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/41-42-donde-esta-boton-icono.png\" alt=\"Ventana con el botón Cancelar marcado en rojo\">\u003C/p>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/41-40-donde-esta-boton-times.png\" alt=\"Ventana con la cruz de cerrar marcada en rojo\">\u003C/p>\n\u003Col start=\"7\">\n\u003Cli>Si no, tocá \u003Cstrong>Cancelar\u003C/strong> o la cruz \u003Cstrong>×\u003C/strong>. No cambia nada.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/41-36-donde-esta-boton-flecha.png\" alt=\"Barra con el botón rojo Eliminar marcado en rojo\">\u003C/p>\n\u003Cblockquote>\n\u003Cp>⚠️ \u003Cstrong>Atención:\u003C/strong> el botón rojo \u003Cstrong>Eliminar\u003C/strong> de la barra saca del menú \u003Cstrong>todos\u003C/strong> los productos tildados.\u003C/p>\n\u003C/blockquote>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/41-38-donde-esta-boton-flecha.png\" alt=\"Barra con la cruz para destildar marcada en rojo\">\u003C/p>\n\u003Col start=\"8\">\n\u003Cli>Para destildar todo, tocá la cruz \u003Cstrong>×\u003C/strong> al final de la barra.\u003C/li>\n\u003C/ol>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🧭 Paso 9: Otros botones de arriba\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-9-otros-botones-de-arriba\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-9-otros-botones-de-arriba\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/41-11-donde-esta-boton-dropdown-toggle.png\" alt=\"Pantalla con el botón Menú: Catálogo marcado en rojo\">\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Menú: Catálogo\u003C/strong>: si tenés más de un menú, lo cambiás acá. También podés crear uno nuevo.\u003C/li>\n\u003C/ul>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/41-54-selector-de-menu-abierto.png\" alt=\"Lista de menús abierta con Catálogo y Nuevo Menú\">\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Importar\u003C/strong>: carga muchos productos juntos desde un Excel.\u003C/li>\n\u003Cli>\u003Cstrong>Exportar\u003C/strong>: descarga la lista de productos en un Excel.\u003C/li>\n\u003Cli>\u003Cstrong>Configurar\u003C/strong>: cambia el nombre, la foto y cómo se ve este menú.\u003C/li>\n\u003C/ul>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/41-17-donde-esta-boton-ayuda-precios.png\" alt=\"Pantalla con el botón de ayuda de precios marcado en rojo\">\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>?\u003C/strong>: explica cómo funcionan los precios y el \u003Cstrong>Precio Futuro\u003C/strong>.\u003C/li>\n\u003C/ul>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/41-63-ayuda-precios-abierta.png\" alt=\"Explicación de precios abierta\">\u003C/p>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/41-19-donde-esta-boton-dropdown-toggle.png\" alt=\"Pantalla con el botón de más opciones marcado en rojo\">\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>⋯\u003C/strong> (tres puntitos): ver el menú online, su código QR y \u003Cstrong>Aplicar precios futuros\u003C/strong>.\u003C/li>\n\u003C/ul>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/41-64-mas-opciones-abierto.png\" alt=\"Lista de más opciones abierta\">\u003C/p>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/41-21-donde-esta-boton-text-danger.png\" alt=\"Lista de más opciones con Eliminar Menú marcado en rojo\">\u003C/p>\n\u003Cblockquote>\n\u003Cp>⚠️ \u003Cstrong>Atención:\u003C/strong> \u003Cstrong>Eliminar Menú\u003C/strong> borra el menú entero con todos sus productos. No se puede deshacer.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                ⚠️ Resolución de Inconvenientes\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"resolucion-de-inconvenientes\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"resolucion-de-inconvenientes\">\u003C/div>\n\n\u003Cdiv class=\"table-wrapper\">\u003Ctable>\n\u003Cthead>\n\u003Ctr>\n\u003Cth>Problema\u003C/th>\n\u003Cth>Causa más frecuente\u003C/th>\n\u003Cth>Solución recomendada\u003C/th>\n\u003C/tr>\n\u003C/thead>\n\u003Ctbody>\u003Ctr>\n\u003Ctd>\u003Cstrong>El mozo no encuentra un producto\u003C/strong>\u003C/td>\n\u003Ctd>Está marcado \u003Cstrong>Sin Stock\u003C/strong>, o no está en el menú.\u003C/td>\n\u003Ctd>Buscalo acá. Si no está, agregalo. Si está, editalo y desmarcá \u003Cstrong>Sin Stock\u003C/strong>.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>La comanda no sale impresa\u003C/strong>\u003C/td>\n\u003Ctd>No tiene impresora en \u003Cstrong>¿Dónde se imprime la comanda?\u003C/strong>.\u003C/td>\n\u003Ctd>Tocá el lápiz y tildá la impresora.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>No aparece ninguna impresora para elegir\u003C/strong>\u003C/td>\n\u003Ctd>Todavía no cargaste las impresoras.\u003C/td>\n\u003Ctd>Seguí \u003Ca href=\"/user-guide/impresoras\">Impresoras\u003C/a> y volvé a editar el producto.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>La factura sale con error por el IVA\u003C/strong>\u003C/td>\n\u003Ctd>El producto no tiene bien el \u003Cstrong>Impuesto / IVA\u003C/strong>.\u003C/td>\n\u003Ctd>Tocá el lápiz y elegí el IVA correcto.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>Cambié un precio y no se guardó\u003C/strong>\u003C/td>\n\u003Ctd>No confirmaste el cambio en la celda.\u003C/td>\n\u003Ctd>Hacé clic de nuevo, escribí el precio y tocá el botón verde ✔.\u003C/td>\n\u003C/tr>\n\u003C/tbody>\u003C/table>\u003C/div>\n",[5,9,12,15,19,22,25,28,31,34,37,40,43,46,49,52],{"id":6,"title":7,"level":8},"antes-de-empezar","Antes de empezar",2,{"id":10,"title":11,"level":8},"paso-1-entra-a-la-pantalla","Paso 1: Entrá a la pantalla",{"id":13,"title":14,"level":8},"paso-2-agrega-un-producto-al-menu","Paso 2: Agregá un producto al menú",{"id":16,"title":17,"level":18},"paso-1-informacion-basica","PASO 1 · Información Básica (obligatoria)",3,{"id":20,"title":21,"level":18},"paso-2-variantes-del-producto","PASO 2 · Variantes del Producto (si hace falta)",{"id":23,"title":24,"level":18},"paso-3-configuracion-operativa","PASO 3 · Configuración Operativa (impresora)",{"id":26,"title":27,"level":18},"opciones-adicionales-opcional","Opciones Adicionales (opcional)",{"id":29,"title":30,"level":18},"guarda-el-producto","Guardá el producto",{"id":32,"title":33,"level":8},"paso-3-cambia-un-precio-desde-la-lista","Paso 3: Cambiá un precio desde la lista",{"id":35,"title":36,"level":8},"paso-4-cambia-todos-los-datos-de-un-producto","Paso 4: Cambiá todos los datos de un producto",{"id":38,"title":39,"level":8},"paso-5-saca-un-producto-del-menu","Paso 5: Sacá un producto del menú",{"id":41,"title":42,"level":8},"paso-6-busca-un-producto","Paso 6: Buscá un producto",{"id":44,"title":45,"level":8},"paso-7-filtra-la-lista","Paso 7: Filtrá la lista",{"id":47,"title":48,"level":8},"paso-8-cambia-muchos-productos-de-una-vez","Paso 8: Cambiá muchos productos de una vez",{"id":50,"title":51,"level":8},"paso-9-otros-botones-de-arriba","Paso 9: Otros botones de arriba",{"id":53,"title":54,"level":8},"resolucion-de-inconvenientes","Resolución de Inconvenientes",{"title":56,"description":57,"keywords":58},"Menú de Productos (Carta) - Manual","¿Dónde está en el sistema?: Menú principal → Productos → Menú\n ¿Quién lo usa?: Encargados de la carta y administradores","menu, paxapos, menú de productos (carta), tutorial, guía, manual usuario","41-menu.txt"],"uses":{"params":["slug"]}}]}
