{"type":"data","nodes":[null,{"type":"data","data":[{"moduleCategories":1},[2,17,44,53,77,98,110,140,146,173,185,221,250],{"title":3,"modules":4},"Comenzamos",[5,8,11,14],{"slug":6,"title":7},"introduccion","Bienvenido a tu software gastronómico",{"slug":9,"title":10},"iniciar-sesion","Cómo Iniciar Sesión",{"slug":12,"title":13},"recuperar-contrasena","Cómo Recuperar tu Contraseña",{"slug":15,"title":16},"guia-de-inicio-rapido","Guía de Inicio Rápido",{"title":18,"modules":19},"Ventas",[20,23,26,29,32,35,38,41],{"slug":21,"title":22},"salon-de-ventas","Cómo Usar el Salón de Ventas (Adición)",{"slug":24,"title":25},"caja-rapida","Cómo Usar la Caja Rápida (Registradora)",{"slug":27,"title":28},"mozos","Cómo Cargar los Mozos",{"slug":30,"title":31},"clientes","Cómo Gestionar los Clientes",{"slug":33,"title":34},"descuentos","Cómo Configurar Descuentos",{"slug":36,"title":37},"nueva-reserva","Cómo Cargar una Nueva Reserva",{"slug":39,"title":40},"listado-de-reservas","Cómo Usar el Listado de Reservas",{"slug":42,"title":43},"grilla-de-reservas","Cómo Usar la Grilla de Reservas",{"title":45,"modules":46},"Medios de Pago",[47,50],{"slug":48,"title":49},"configuracion-procesadores","Configuración de Procesadores de Pago",{"slug":51,"title":52},"transacciones-mercadopago","Transacciones MercadoPago",{"title":54,"modules":55},"Productos",[56,59,62,65,68,71,74],{"slug":57,"title":58},"menu","Menú de Productos (Carta)",{"slug":60,"title":61},"categorias","Categorías de Productos",{"slug":63,"title":64},"variantes-grupo-sabores","Variantes y Grupos de Sabores",{"slug":66,"title":67},"maestro-de-productos","Maestro de Productos",{"slug":69,"title":70},"subproductos-elaborados","Sub-Productos (Elaborados)",{"slug":72,"title":73},"recetas","Recetas",{"slug":75,"title":76},"analisis-duplicados","Buscar Duplicados",{"title":78,"modules":79},"Compras",[80,83,86,89,92,95],{"slug":81,"title":82},"todas-las-ordenes-compra","Órdenes de Compra",{"slug":84,"title":85},"crear-orden-compra","Crear una Orden de Compra",{"slug":87,"title":88},"ordenes-a-aprobar","Órdenes a aprobar",{"slug":90,"title":91},"mercaderias","Mercaderías",{"slug":93,"title":94},"proveedores","Proveedores",{"slug":96,"title":97},"historial-de-compras","Historial de Compras",{"title":99,"modules":100},"Stock",[101,104,107],{"slug":102,"title":103},"stock-mercaderias","Stock de Mercaderías",{"slug":105,"title":106},"stock-subproductos","Stock de Subproductos",{"slug":108,"title":109},"movimientos-de-stock","Movimientos de Stock",{"title":111,"modules":112},"Finanzas",[113,116,119,122,125,128,131,134,137],{"slug":114,"title":115},"arqueos-de-caja","Arqueos de Caja",{"slug":117,"title":118},"listado-de-cajas","Listado de Cajas",{"slug":120,"title":121},"transacciones-de-cobro","Transacciones de Cobro",{"slug":123,"title":124},"factura-manual","Factura Manual",{"slug":126,"title":127},"resumen-de-deuda","Resumen de Deuda",{"slug":129,"title":130},"pagos","Pagos",{"slug":132,"title":133},"historial-de-facturas","Historial de Facturas",{"slug":135,"title":136},"historico-de-mesas","Histórico de Mesas",{"slug":138,"title":139},"puntos-de-venta-pdv","Puntos de Venta (PDVs)",{"title":141,"modules":142},"Comandero",[143],{"slug":144,"title":145},"comandero","Comandero (pantalla de cocina)",{"title":147,"modules":148},"RRHH",[149,152,155,158,161,164,167,170],{"slug":150,"title":151},"empleados","Empleados",{"slug":153,"title":154},"empleados-trabajando","Empleados Trabajando",{"slug":156,"title":157},"registro-diario-fichaje","Registro Diario de Fichaje",{"slug":159,"title":160},"reporte-mensual-fichaje","Reporte Mensual de Fichaje",{"slug":162,"title":163},"departamentos","Departamentos",{"slug":165,"title":166},"turnos-y-horarios-fichaje","Turnos y Horarios de Fichaje",{"slug":168,"title":169},"sueldos-y-jornales","Sueldos y Jornales",{"slug":171,"title":172},"datos-de-acceso-app","Datos de Acceso a la App de Fichaje",{"title":174,"modules":175},"Reportes",[176,179,182],{"slug":177,"title":178},"tablero-general","Tablero General",{"slug":180,"title":181},"productos-mas-vendidos","Productos Más Vendidos",{"slug":183,"title":184},"compras-por-mercaderia","Compras por Mercadería",{"title":186,"modules":187},"Configuracion",[188,191,194,197,200,203,206,209,212,215,218],{"slug":189,"title":190},"configuracion-general","Configuración general",{"slug":192,"title":193},"impresoras","Cómo cargar las impresoras del local",{"slug":195,"title":196},"perfiles-de-impresion","Cómo usar los perfiles de impresión",{"slug":198,"title":199},"usuarios-del-sistema","Cómo administrar los Usuarios del Sistema",{"slug":201,"title":202},"usuarios-con-pin","Cómo administrar los Usuarios con PIN",{"slug":204,"title":205},"punto-de-venta","🏛️ Trámite en ARCA (con clave fiscal)",{"slug":207,"title":208},"permisos-por-rol","Cómo configurar los Permisos por Rol",{"slug":210,"title":211},"turnos-mesa","Turnos de Mesa",{"slug":213,"title":214},"medios-de-cobro","Medios de cobro",{"slug":216,"title":217},"clasificacion-de-gastos","Clasificación de Gastos",{"slug":219,"title":220},"centros-de-costo","Centros de Costo",{"title":222,"modules":223},"Biblioteca de Drivers",[224,226,229,232,235,238,241,244,247],{"slug":225,"title":222},"biblioteca-de-drivers",{"slug":227,"title":228},"sam4s-giant-100","Sam4S Giant - 100",{"slug":230,"title":231},"citizen-ct-s310ii","Citizen CT-S310II",{"slug":233,"title":234},"epson-tm-t20","Epson TM-T20",{"slug":236,"title":237},"drivers-genericos","Drivers Genéricos POS",{"slug":239,"title":240},"epson-tm-t88","Epson TM-T88V",{"slug":242,"title":243},"fiscalberry-windows","Instalar Fiscalberry en Windows",{"slug":245,"title":246},"fiscalberry-linux","Instalar Fiscalberry en Linux",{"slug":248,"title":249},"fiscalberry-android","Instalar Fiscalberry en Android",{"title":251,"modules":252},"Extra",[253,256,259,262,265,268,271,274,277,280],{"slug":254,"title":255},"01-faq-solucion-inicial-pantalla-congelada","📖 Manual de Usuario: Solución Inicial si la Pantalla se Congela o no Carga",{"slug":257,"title":258},"03-faq-mozo-reabrir-mesa-anulada","📖 Manual de Usuario: Cómo Reabrir una Mesa Anulada o Cerrada por Error",{"slug":260,"title":261},"05-faq-cajero-emitir-factura-a","📖 Manual de Usuario: Cómo Emitir una Factura A Cargando Datos del Cliente",{"slug":263,"title":264},"06-faq-cajero-ingreso-egreso-cajon","📖 Manual de Usuario: Cómo Registrar Entradas y Salidas de Dinero del Cajón",{"slug":266,"title":267},"07-faq-cajero-activar-medio-pago","📖 Manual de Usuario: Cómo Activar un Medio de Pago que no Aparece al Cobrar",{"slug":269,"title":270},"08-faq-cajero-diferencia-facturado-vs-abiertas","📖 Manual de Usuario: Diferencia entre \"Facturado Total Mesas\" y \"Abiertas Por Usuario\" en Caja",{"slug":272,"title":273},"10-faq-supervisor-cierre-caja-diferencias","📖 Manual de Usuario: Cómo Auditar y Solucionar Diferencias en el Cierre de Caja",{"slug":275,"title":276},"preguntas-frecuentes","Preguntas Frecuentes y Guías Rápidas por Rol",{"slug":278,"title":279},"buchon-bot","Buchón Bot",{"slug":281,"title":282},"troubleshooting-semantico","📖 Guía Única de Resolución de Problemas y Errores (Troubleshooting)"],"uses":{}},{"type":"data","data":[{"slug":1,"title":2,"content":3,"tableOfContents":4,"seo":24,"llmTxtFile":28},"movimientos-de-stock","Movimientos de Stock","\u003Cdiv id=\"movimientos-de-stock\">\u003C/div>\n\n\u003Cblockquote>\n\u003Cp>\u003Cstrong>¿Dónde está en el sistema?:\u003C/strong> Menú principal → \u003Cstrong>Stock\u003C/strong> → \u003Cstrong>Movimientos\u003C/strong> → \u003Cstrong>Movimientos\u003C/strong>\n\u003Cstrong>¿Quién lo usa?:\u003C/strong> Depósito, encargados y administradores\u003C/p>\n\u003C/blockquote>\n\u003Cblockquote>\n\u003Cp>🎯 \u003Cstrong>¿Para qué sirve esto?\u003C/strong>\nEs la lista de todo lo que entró y salió del stock: compras recibidas, ventas, roturas y conteos.\nTe sirve para entender por qué el stock de algo subió o bajó.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🔑 Antes de empezar\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"antes-de-empezar\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"antes-de-empezar\">\u003C/div>\n\n\u003Cul>\n\u003Cli>Tu usuario tiene que tener el permiso de \u003Cstrong>Stock\u003C/strong> en \u003Ca href=\"/user-guide/permisos-por-rol\">Permisos por Rol\u003C/a>.\u003C/li>\n\u003Cli>Solo aparecen movimientos de lo que tiene el stock controlado. Mirá \u003Ca href=\"/user-guide/stock-mercaderias\">Stock de Mercaderías\u003C/a> y \u003Ca href=\"/user-guide/stock-subproductos\">Stock de Subproductos\u003C/a>.\u003C/li>\n\u003C/ul>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                📍 Paso 1: Entrá a la pantalla\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-1-entra-a-la-pantalla\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-1-entra-a-la-pantalla\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/60-stock/64-00a-menu-grupo-stock.png\" alt=\"Menú lateral con el grupo Stock marcado en rojo\">\u003C/p>\n\u003Col>\n\u003Cli>En el menú de la izquierda, tocá \u003Cstrong>Stock\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/60-stock/64-00b-menu-opcion-movimientos.png\" alt=\"Opción Movimientos marcada en rojo, debajo del título Movimientos\">\u003C/p>\n\u003Col start=\"2\">\n\u003Cli>Tocá \u003Cstrong>Movimientos\u003C/strong>. Está debajo del título \u003Cstrong>MOVIMIENTOS\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/60-stock/64-01-pantalla-movimientos.png\" alt=\"Pantalla Movimientos de Stock con el buscador, el botón Descargar Excel y la lista de movimientos\">\u003C/p>\n\u003Cp>Así se ve la pantalla. Arriba está el buscador y abajo, la lista. Lo más nuevo aparece primero.\u003C/p>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                📖 Paso 2: Leé un movimiento\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-2-lee-un-movimiento\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-2-lee-un-movimiento\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/60-stock/64-02-tabla-movimientos.png\" alt=\"Lista con tres movimientos: menos 3 Medialuna, menos 2 y más 20 de Harina 0000 x 25 kg\">\u003C/p>\n\u003Cp>Cada renglón es una entrada o una salida. Las columnas dicen:\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>#\u003C/strong>: el código del movimiento. Por ejemplo: \u003Cem>59A3B1\u003C/em>.\u003C/li>\n\u003Cli>\u003Cstrong>StockId\u003C/strong>: el número del renglón en la pantalla de stock.\u003C/li>\n\u003Cli>\u003Cstrong>Depósito\u003C/strong>: de qué depósito entró o salió.\u003C/li>\n\u003Cli>\u003Cstrong>Modelo\u003C/strong> y \u003Cstrong>Modelo Id\u003C/strong>: de dónde viene el movimiento (mirá la tabla de abajo).\u003C/li>\n\u003Cli>\u003Cstrong>Subproducto\u003C/strong> o \u003Cstrong>Mercaderia\u003C/strong>: qué se movió. Se completa una de las dos.\u003C/li>\n\u003Cli>\u003Cstrong>UM\u003C/strong>: la unidad. Por ejemplo: \u003Cem>Kilo\u003C/em> o \u003Cem>Unidad\u003C/em>.\u003C/li>\n\u003Cli>\u003Cstrong>Cant\u003C/strong>: cuánto se movió.\u003C/li>\n\u003Cli>\u003Cstrong>Descripción\u003C/strong>: qué pasó, si alguien lo escribió.\u003C/li>\n\u003Cli>\u003Cstrong>Creado\u003C/strong> y \u003Cstrong>Creador\u003C/strong>: cuándo y quién.\u003C/li>\n\u003C/ul>\n\u003Cp>La columna \u003Cstrong>Cant\u003C/strong> te dice si entró o salió:\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Verde con +\u003C/strong>: entró. Por ejemplo: \u003Cem>+20\u003C/em> kilos de harina que llegaron.\u003C/li>\n\u003Cli>\u003Cstrong>Rojo con −\u003C/strong>: salió. Por ejemplo: \u003Cem>−2\u003C/em> por una bolsa rota.\u003C/li>\n\u003C/ul>\n\u003Cp>La columna \u003Cstrong>Modelo\u003C/strong> te dice de dónde viene:\u003C/p>\n\u003Cdiv class=\"table-wrapper\">\u003Ctable>\n\u003Cthead>\n\u003Ctr>\n\u003Cth>Modelo\u003C/th>\n\u003Cth>Qué significa\u003C/th>\n\u003C/tr>\n\u003C/thead>\n\u003Ctbody>\u003Ctr>\n\u003Ctd>\u003Cstrong>PedidoMercaderia\u003C/strong> o \u003Cstrong>Pedido\u003C/strong>\u003C/td>\n\u003Ctd>Una compra que recibiste. Suma.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>DetalleComanda\u003C/strong> o \u003Cstrong>DetalleSabor\u003C/strong>\u003C/td>\n\u003Ctd>Una venta. Resta.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>Desperdicio\u003C/strong>\u003C/td>\n\u003Ctd>Algo que se tiró o se echó a perder. Resta.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>Stock\u003C/strong>\u003C/td>\n\u003Ctd>Un conteo cargado con \u003Cstrong>Reinicializar\u003C/strong>.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>Movimiento\u003C/strong>\u003C/td>\n\u003Ctd>Algo cargado a mano con \u003Cstrong>Agregar Movimiento\u003C/strong>.\u003C/td>\n\u003C/tr>\n\u003C/tbody>\u003C/table>\u003C/div>\n\u003Cblockquote>\n\u003Cp>💡 \u003Cstrong>Consejo útil:\u003C/strong> si un número no te cierra, buscá el producto (Paso 3) y leé sus movimientos de abajo hacia arriba, del más viejo al más nuevo.\u003C/p>\n\u003C/blockquote>\n\u003Cblockquote>\n\u003Cp>⚠️ \u003Cstrong>Atención:\u003C/strong> los links \u003Cstrong>editar\u003C/strong> y \u003Cstrong>borrar\u003C/strong> cambian el stock. Usalos solo para corregir un movimiento cargado a mano por error.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🔎 Paso 3: Buscá los movimientos de un producto\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-3-busca-los-movimientos-de-un-producto\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-3-busca-los-movimientos-de-un-producto\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/60-stock/64-03-panel-busqueda.png\" alt=\"Recuadro de búsqueda con Harina escrito en el casillero Buscar y el botón azul Buscar a la derecha\">\u003C/p>\n\u003Cp>En el recuadro de búsqueda tenés:\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Buscar\u003C/strong>: escribí parte del nombre del producto. Por ejemplo: \u003Cem>Harina\u003C/em>. También podés escribir el \u003Cstrong>StockId\u003C/strong>.\u003C/li>\n\u003Cli>\u003Cstrong>Buscar\u003C/strong>: el botón azul de la derecha, que aplica la búsqueda.\u003C/li>\n\u003C/ul>\n\u003Col>\n\u003Cli>Escribí el nombre y tocá \u003Cstrong>Buscar\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/60-stock/64-04-resultado-busqueda.png\" alt=\"Lista con los dos movimientos de Harina 0000 x 25 kg: menos 2 y más 20\">\u003C/p>\n\u003Col start=\"2\">\n\u003Cli>La lista muestra solo los movimientos de ese producto.\u003C/li>\n\u003C/ol>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                📥 Paso 4: Bajá los movimientos a una planilla\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-4-baja-los-movimientos-a-una-planilla\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-4-baja-los-movimientos-a-una-planilla\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/60-stock/64-05-donde-esta-boton-descargar-excel.png\" alt=\"Pantalla Movimientos de Stock con el botón verde Descargar Excel marcado en rojo, debajo del buscador\">\u003C/p>\n\u003Col>\n\u003Cli>Si querés solo los de un producto, primero buscalo (Paso 3).\u003C/li>\n\u003Cli>Tocá el botón verde \u003Cstrong>Descargar Excel\u003C/strong>, debajo del buscador.\u003C/li>\n\u003Cli>Se baja una planilla con los movimientos, lista para abrir en Excel.\u003C/li>\n\u003C/ol>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                ⚠️ Resolución de Inconvenientes\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"resolucion-de-inconvenientes\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"resolucion-de-inconvenientes\">\u003C/div>\n\n\u003Cdiv class=\"table-wrapper\">\u003Ctable>\n\u003Cthead>\n\u003Ctr>\n\u003Cth>Problema\u003C/th>\n\u003Cth>Causa más frecuente\u003C/th>\n\u003Cth>Solución recomendada\u003C/th>\n\u003C/tr>\n\u003C/thead>\n\u003Ctbody>\u003Ctr>\n\u003Ctd>\u003Cstrong>La lista está vacía\u003C/strong>\u003C/td>\n\u003Ctd>Nada tiene el stock controlado todavía.\u003C/td>\n\u003Ctd>Empezá a controlarlo en \u003Ca href=\"/user-guide/stock-mercaderias\">Stock de Mercaderías\u003C/a> o \u003Ca href=\"/user-guide/stock-subproductos\">Stock de Subproductos\u003C/a>.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>Recibí una compra y no aparece el movimiento\u003C/strong>\u003C/td>\n\u003Ctd>La mercadería no tenía el stock controlado cuando la recibiste.\u003C/td>\n\u003Ctd>Stockeala en \u003Ca href=\"/user-guide/stock-mercaderias\">Stock de Mercaderías\u003C/a>. Las próximas compras van a sumar solas.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>Vendí un producto y no bajó el stock\u003C/strong>\u003C/td>\n\u003Ctd>El producto no tiene el stock controlado, ni una receta con ingredientes controlados.\u003C/td>\n\u003Ctd>Stockealo en \u003Ca href=\"/user-guide/stock-subproductos\">Stock de Subproductos\u003C/a> o revisá su \u003Ca href=\"/user-guide/recetas\">receta\u003C/a>.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>No encuentro un movimiento\u003C/strong>\u003C/td>\n\u003Ctd>La búsqueda tiene un nombre distinto.\u003C/td>\n\u003Ctd>Escribí menos letras. Por ejemplo: \u003Cem>Harin\u003C/em> en vez de \u003Cem>Harina 0000 x 25 kg\u003C/em>.\u003C/td>\n\u003C/tr>\n\u003C/tbody>\u003C/table>\u003C/div>\n",[5,9,12,15,18,21],{"id":6,"title":7,"level":8},"antes-de-empezar","Antes de empezar",2,{"id":10,"title":11,"level":8},"paso-1-entra-a-la-pantalla","Paso 1: Entrá a la pantalla",{"id":13,"title":14,"level":8},"paso-2-lee-un-movimiento","Paso 2: Leé un movimiento",{"id":16,"title":17,"level":8},"paso-3-busca-los-movimientos-de-un-producto","Paso 3: Buscá los movimientos de un producto",{"id":19,"title":20,"level":8},"paso-4-baja-los-movimientos-a-una-planilla","Paso 4: Bajá los movimientos a una planilla",{"id":22,"title":23,"level":8},"resolucion-de-inconvenientes","Resolución de Inconvenientes",{"title":25,"description":26,"keywords":27},"Movimientos de Stock - Manual","¿Dónde está en el sistema?: Menú principal → Stock → Movimientos → Movimientos\n ¿Quién lo usa?: Depósito, encargados y administradores","movimientos de stock, paxapos, movimientos de stock, tutorial, guía, manual usuario","64-movimientos-de-stock.txt"],"uses":{"params":["slug"]}}]}
