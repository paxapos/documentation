":178},"tablero-general","Tablero General",{"slug":180,"title":181},"productos-mas-vendidos","Productos Más Vendidos",{"slug":183,"title":184},"compras-por-mercaderia","Compras por Mercadería",{"title":186,"modules":187},"Configuracion",[188,191,194,197,200,203,206,209,212,215,218],{"slug":189,"title":190},"configuracion-general","Configuración general",{"slug":192,"title":193},"impresoras","Cómo cargar las impresoras del local",{"slug":195,"title":196},"perfiles-de-impresion","Cómo usar los perfiles de impresión",{"slug":198,"title":199},"usuarios-del-sistema","Cómo administrar los Usuarios del Sistema",{"slug":201,"title":202},"usuarios-con-pin","Cómo administrar los Usuarios con PIN",{"slug":204,"title":205},"punto-de-venta","🏛️ Trámite en ARCA (con clave fiscal)",{"slug":207,"title":208},"permisos-por-rol","Cómo configurar los Permisos por Rol",{"slug":210,"title":211},"turnos-mesa","Turnos de Mesa",{"slug":213,"title":214},"medios-de-cobro","Medios de cobro",{"slug":216,"title":217},"clasificacion-de-gastos","Clasificación de Gastos",{"slug":219,"title":220},"centros-de-costo","Centros de Costo",{"title":222,"modules":223},"Biblioteca de Drivers",[224,226,229,232,235,238,241,244,247],{"slug":225,"title":222},"biblioteca-de-drivers",{"slug":227,"title":228},"sam4s-giant-100","Sam4S Giant - 100",{"slug":230,"title":231},"citizen-ct-s310ii","Citizen CT-S310II",{"slug":233,"title":234},"epson-tm-t20","Epson TM-T20",{"slug":236,"title":237},"drivers-genericos","Drivers Genéricos POS",{"slug":239,"title":240},"epson-tm-t88","Epson TM-T88V",{"slug":242,"title":243},"fiscalberry-windows","Instalar Fiscalberry en Windows",{"slug":245,"title":246},"fiscalberry-linux","Instalar Fiscalberry en Linux",{"slug":248,"title":249},"fiscalberry-android","Instalar Fiscalberry en Android",{"title":251,"modules":252},"Extra",[253,256,259,262,265,268,271,274,277,280],{"slug":254,"title":255},"01-faq-solucion-inicial-pantalla-congelada","📖 Manual de Usuario: Solución Inicial si la Pantalla se Congela o no Carga",{"slug":257,"title":258},"03-faq-mozo-reabrir-mesa-anulada","📖 Manual de Usuario: Cómo Reabrir una Mesa Anulada o Cerrada por Error",{"slug":260,"title":261},"05-faq-cajero-emitir-factura-a","📖 Manual de Usuario: Cómo Emitir una Factura A Cargando Datos del Cliente",{"slug":263,"title":264},"06-faq-cajero-ingreso-egreso-cajon","📖 Manual de Usuario: Cómo Registrar Entradas y Salidas de Dinero del Cajón",{"slug":266,"title":267},"07-faq-cajero-activar-medio-pago","📖 Manual de Usuario: Cómo Activar un Medio de Pago que no Aparece al Cobrar",{"slug":269,"title":270},"08-faq-cajero-diferencia-facturado-vs-abiertas","📖 Manual de Usuario: Diferencia entre \"Facturado Total Mesas\" y \"Abiertas Por Usuario\" en Caja",{"slug":272,"title":273},"10-faq-supervisor-cierre-caja-diferencias","📖 Manual de Usuario: Cómo Auditar y Solucionar Diferencias en el Cierre de Caja",{"slug":275,"title":276},"preguntas-frecuentes","Preguntas Frecuentes y Guías Rápidas por Rol",{"slug":278,"title":279},"buchon-bot","Buchón Bot",{"slug":281,"title":282},"troubleshooting-semantico","📖 Guía Única de Resolución de Problemas y Errores (Troubleshooting)"],"uses":{}},{"type":"data","data":[{"slug":1,"title":2,"content":3,"tableOfContents":4,"seo":21,"llmTxtFile":25},"iniciar-sesion","Cómo Iniciar Sesión","\u003Cdiv id=\"iniciar-sesion\">\u003C/div>\n\n\u003Cblockquote>\n\u003Cp>🎯 \u003Cstrong>¿Para qué sirve esto?\u003C/strong>\u003Cbr>Este es tu primer paso para operar en PaxaPOS. Aprenderás las dos modalidades de acceso: ingreso rápido mediante \u003Cstrong>PIN numérico\u003C/strong> (ideal para mozos y personal de salón) e ingreso completo con \u003Cstrong>Correo Electrónico y Contraseña\u003C/strong> (para administradores, cajeros y gestión integral).\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                📍 \u003Cstrong>Paso 1: Accedé a la dirección del sistema\u003C/strong>\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-1-accede-a-la-direccion-del-sistema\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-1-accede-a-la-direccion-del-sistema\">\u003C/div>\n\n\u003Col>\n\u003Cli>Abrí tu navegador web de preferencia (Google Chrome recomendado, Mozilla Firefox, Microsoft Edge o Safari).\u003C/li>\n\u003Cli>En la barra de direcciones superior, escribí la URL exclusiva asignada a tu local\u003C/li>\n\u003Cli>Presioná \u003Cstrong>Enter\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cblockquote>\n\u003Cp>💡 \u003Cstrong>Consejo útil:\u003C/strong> Guardá esta dirección en los \u003Cstrong>Marcadores o Favoritos\u003C/strong> de tu navegador, o creá un acceso directo en el escritorio para abrir el sistema con un solo clic al iniciar tu jornada.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🔢 \u003Cstrong>Método 1: Ingreso rápido con PIN (Recomendado para salón y mozos)\u003C/strong>\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"metodo-1-ingreso-rapido-con-pin\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"metodo-1-ingreso-rapido-con-pin\">\u003C/div>\n\n\u003Cp>Al abrir la página de inicio, por defecto se presenta el teclado táctil numérico de acceso rápido:\u003C/p>\n\u003Cp>\u003Cimg src=\"/images/manual/10-comenzamos/02-login-pin.png\" alt=\"Pantalla de ingreso rápido por PIN\">\u003C/p>\n\u003Ch3>\u003Cstrong>Instrucciones paso a paso:\u003C/strong>\u003C/h3>\n\u003Col>\n\u003Cli>Verificá que la solapa superior activa sea \u003Cstrong>&quot;PIN&quot;\u003C/strong> (seleccionada por defecto).\u003C/li>\n\u003Cli>Ingresá los \u003Cstrong>4 dígitos de tu PIN personal\u003C/strong> asignado:\u003Cul>\n\u003Cli>Podés hacer clic o pulsar directamente sobre los números del \u003Cstrong>teclado numérico en pantalla\u003C/strong> (1 al 9, y 0).\u003C/li>\n\u003Cli>O bien podés tipear los 4 números desde el teclado físico de tu computadora o terminal POS.\u003C/li>\n\u003C/ul>\n\u003C/li>\n\u003Cli>Cada dígito ingresado completará una de las cuatro casillas seguras en pantalla.\u003C/li>\n\u003Cli>Si te equivocás al presionar un número, usá la tecla con la flecha de retroceso \u003Ccode>⌫\u003C/code> para borrar el último dígito ingresado.\u003C/li>\n\u003Cli>Al completar el cuarto dígito, el sistema valida tus credenciales de manera inmediata y automática sin necesidad de presionar ningún botón adicional.\u003C/li>\n\u003C/ol>\n\u003Cblockquote>\n\u003Cp>⚡ \u003Cstrong>¿Para quién está pensado el acceso por PIN?\u003C/strong>\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Mozos y camareros:\u003C/strong> Permite registrar pedidos y comandas en segundos sin demoras.\u003C/li>\n\u003Cli>\u003Cstrong>Personal de turnos rotativos:\u003C/strong> Facilita el cambio de operador ágil en terminales táctiles compartidas.\u003C/li>\n\u003C/ul>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                ✉️ \u003Cstrong>Método 2: Ingreso con Correo Electrónico y Contraseña\u003C/strong>\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"metodo-2-ingreso-con-correo-y-contrasena\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"metodo-2-ingreso-con-correo-y-contrasena\">\u003C/div>\n\n\u003Cp>Para usuarios con perfil de Administrador, Cajero o Encargado, o cuando se requiera gestionar configuraciones, reportes y compras:\u003C/p>\n\u003Cp>\u003Cimg src=\"/images/manual/10-comenzamos/01-login-formulario.png\" alt=\"Formulario de inicio de sesión con correo y contraseña\">\u003C/p>\n\u003Ch3>\u003Cstrong>Instrucciones paso a paso:\u003C/strong>\u003C/h3>\n\u003Col>\n\u003Cli>En la parte superior de la ventana de acceso, hacé clic en la pestaña \u003Cstrong>&quot;Usuario y contraseña&quot;\u003C/strong>.\u003C/li>\n\u003Cli>\u003Cstrong>Campo &quot;Email&quot;:\u003C/strong> Escribí tu dirección de correo electrónico registrada en el comercio (ejemplo: \u003Cem>\u003Ca href=\"mailto:gerencia@milocal.com\">gerencia@milocal.com\u003C/a>\u003C/em>).\u003C/li>\n\u003Cli>\u003Cstrong>Campo &quot;Contraseña&quot;:\u003C/strong> Ingresá tu clave de seguridad (los caracteres se ocultarán automáticamente con puntos por protección).\u003C/li>\n\u003Cli>Hacé clic en el botón azul \u003Cstrong>&quot;Iniciar sesión&quot;\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🚀 \u003Cstrong>Ingreso al Panel Principal\u003C/strong>\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"ingreso-al-panel-principal\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"ingreso-al-panel-principal\">\u003C/div>\n\n\u003Cp>Una vez validadas tus credenciales (por PIN o por correo), el sistema abrirá la pantalla principal según los permisos de tu perfil:\u003C/p>\n\u003Cp>\u003Cimg src=\"/images/manual/10-comenzamos/03-panel-principal.png\" alt=\"Panel principal de PaxaPOS\">\u003C/p>\n\u003Cul>\n\u003Cli>Si tu usuario tiene perfil de salón, accederás directamente a la \u003Cstrong>vista de mesas y adición\u003C/strong>.\u003C/li>\n\u003Cli>Si tenés rol administrativo o de caja, ingresarás al \u003Cstrong>panel de control y menú principal\u003C/strong>, desde donde podrás monitorear ventas, abrir turnos de caja y acceder a todos los módulos de gestión.\u003C/li>\n\u003C/ul>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                ❓ \u003Cstrong>Preguntas Frecuentes y Solución de Inconvenientes\u003C/strong>\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"preguntas-frecuentes-y-solucion-de-inconvenientes\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"preguntas-frecuentes-y-solucion-de-inconvenientes\">\u003C/div>\n\n\u003Cdiv class=\"table-wrapper\">\u003Ctable>\n\u003Cthead>\n\u003Ctr>\n\u003Cth>Problema\u003C/th>\n\u003Cth>Causa más frecuente\u003C/th>\n\u003Cth>Solución recomendada\u003C/th>\n\u003C/tr>\n\u003C/thead>\n\u003Ctbody>\u003Ctr>\n\u003Ctd>\u003Cstrong>&quot;PIN o datos incorrectos&quot;\u003C/strong>\u003C/td>\n\u003Ctd>Se ingresó un número erróneo o el usuario fue deshabilitado.\u003C/td>\n\u003Ctd>Borrá los números con \u003Cem>Backspace\u003C/em> y reintentá. Si persiste, solicitale al administrador del local que verifique o reasigne tu PIN.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>Olvidé mi contraseña de administrador\u003C/strong>\u003C/td>\n\u003Ctd>No recuerdas la clave asignada a tu correo.\u003C/td>\n\u003Ctd>Hacé clic en el enlace \u003Cstrong>&quot;¿Olvidaste tu contraseña?&quot;\u003C/strong> debajo del botón de ingreso (ver guía: \u003Ca href=\"/user-guide/recuperar-contrasena\">Recuperar Contraseña\u003C/a>).\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>La página no carga\u003C/strong>\u003C/td>\n\u003Ctd>Falta de conexión a internet o error en la URL del local.\u003C/td>\n\u003Ctd>Verificá que la terminal tenga conexión a internet activa y que el nombre del local en la barra de direcciones esté bien escrito.\u003C/td>\n\u003C/tr>\n\u003C/tbody>\u003C/table>\u003C/div>\n",[5,9,12,15,18],{"id":6,"title":7,"level":8},"paso-1-accede-a-la-direccion-del-sistema","Paso 1: Accedé a la dirección del sistema",2,{"id":10,"title":11,"level":8},"metodo-1-ingreso-rapido-con-pin","Método 1: Ingreso rápido con PIN (Recomendado para salón y mozos)",{"id":13,"title":14,"level":8},"metodo-2-ingreso-con-correo-y-contrasena","Método 2: Ingreso con Correo Electrónico y Contraseña",{"id":16,"title":17,"level":8},"ingreso-al-panel-principal","Ingreso al Panel Principal",{"id":19,"title":20,"level":8},"preguntas-frecuentes-y-solucion-de-inconvenientes","Preguntas Frecuentes y Solución de Inconvenientes",{"title":22,"description":23,"keywords":24},"Cómo Iniciar Sesión - Manual","🎯 ¿Para qué sirve esto?  \n Este es tu primer paso para operar en PaxaPOS. Aprenderás las dos modalidades de acceso: ingreso rápido mediante PIN num...","iniciar sesion, paxapos, cómo iniciar sesión, tutorial, guía, manual usuario","12-iniciar-sesion.txt"],"uses":{"params":["slug"]}}]}
