{"type":"data","nodes":[null,{"type":"data","data":[{"moduleCategories":1},[2,17,44,53,77,98,110,140,146,173,185,221,250],{"title":3,"modules":4},"Comenzamos",[5,8,11,14],{"slug":6,"title":7},"introduccion","Bienvenido a tu software gastronómico",{"slug":9,"title":10},"iniciar-sesion","Cómo Iniciar Sesión",{"slug":12,"title":13},"recuperar-contrasena","Cómo Recuperar tu Contraseña",{"slug":15,"title":16},"guia-de-inicio-rapido","Guía de Inicio Rápido",{"title":18,"modules":19},"Ventas",[20,23,26,29,32,35,38,41],{"slug":21,"title":22},"salon-de-ventas","Cómo Usar el Salón de Ventas (Adición)",{"slug":24,"title":25},"caja-rapida","Cómo Usar la Caja Rápida (Registradora)",{"slug":27,"title":28},"mozos","Cómo Cargar los Mozos",{"slug":30,"title":31},"clientes","Cómo Gestionar los Clientes",{"slug":33,"title":34},"descuentos","Cómo Configurar Descuentos",{"slug":36,"title":37},"nueva-reserva","Cómo Cargar una Nueva Reserva",{"slug":39,"title":40},"listado-de-reservas","Cómo Usar el Listado de Reservas",{"slug":42,"title":43},"grilla-de-reservas","Cómo Usar la Grilla de Reservas",{"title":45,"modules":46},"Medios de Pago",[47,50],{"slug":48,"title":49},"configuracion-procesadores","Configuración de Procesadores de Pago",{"slug":51,"title":52},"transacciones-mercadopago","Transacciones MercadoPago",{"title":54,"modules":55},"Productos",[56,59,62,65,68,71,74],{"slug":57,"title":58},"menu","Menú de Productos (Carta)",{"slug":60,"title":61},"categorias","Categorías de Productos",{"slug":63,"title":64},"variantes-grupo-sabores","Variantes y Grupos de Sabores",{"slug":66,"title":67},"maestro-de-productos","Maestro de Productos",{"slug":69,"title":70},"subproductos-elaborados","Sub-Productos (Elaborados)",{"slug":72,"title":73},"recetas","Recetas",{"slug":75,"title":76},"analisis-duplicados","Buscar Duplicados",{"title":78,"modules":79},"Compras",[80,83,86,89,92,95],{"slug":81,"title":82},"todas-las-ordenes-compra","Órdenes de Compra",{"slug":84,"title":85},"crear-orden-compra","Crear una Orden de Compra",{"slug":87,"title":88},"ordenes-a-aprobar","Órdenes a aprobar",{"slug":90,"title":91},"mercaderias","Mercaderías",{"slug":93,"title":94},"proveedores","Proveedores",{"slug":96,"title":97},"historial-de-compras","Historial de Compras",{"title":99,"modules":100},"Stock",[101,104,107],{"slug":102,"title":103},"stock-mercaderias","Stock de Mercaderías",{"slug":105,"title":106},"stock-subproductos","Stock de Subproductos",{"slug":108,"title":109},"movimientos-de-stock","Movimientos de Stock",{"title":111,"modules":112},"Finanzas",[113,116,119,122,125,128,131,134,137],{"slug":114,"title":115},"arqueos-de-caja","Arqueos de Caja",{"slug":117,"title":118},"listado-de-cajas","Listado de Cajas",{"slug":120,"title":121},"transacciones-de-cobro","Transacciones de Cobro",{"slug":123,"title":124},"factura-manual","Factura Manual",{"slug":126,"title":127},"resumen-de-deuda","Resumen de Deuda",{"slug":129,"title":130},"pagos","Pagos",{"slug":132,"title":133},"historial-de-facturas","Historial de Facturas",{"slug":135,"title":136},"historico-de-mesas","Histórico de Mesas",{"slug":138,"title":139},"puntos-de-venta-pdv","Puntos de Venta (PDVs)",{"title":141,"modules":142},"Comandero",[143],{"slug":144,"title":145},"comandero","Comandero (pantalla de cocina)",{"title":147,"modules":148},"RRHH",[149,152,155,158,161,164,167,170],{"slug":150,"title":151},"empleados","Empleados",{"slug":153,"title":154},"empleados-trabajando","Empleados Trabajando",{"slug":156,"title":157},"registro-diario-fichaje","Registro Diario de Fichaje",{"slug":159,"title":160},"reporte-mensual-fichaje","Reporte Mensual de Fichaje",{"slug":162,"title":163},"departamentos","Departamentos",{"slug":165,"title":166},"turnos-y-horarios-fichaje","Turnos y Horarios de Fichaje",{"slug":168,"title":169},"sueldos-y-jornales","Sueldos y Jornales",{"slug":171,"title":172},"datos-de-acceso-app","Datos de Acceso a la App de Fichaje",{"title":174,"modules":175},"Reportes",[176,179,182],{"slug":177,"title":178},"tablero-general","Tablero General",{"slug":180,"title":181},"productos-mas-vendidos","Productos Más Vendidos",{"slug":183,"title":184},"compras-por-mercaderia","Compras por Mercadería",{"title":186,"modules":187},"Configuracion",[188,191,194,197,200,203,206,209,212,215,218],{"slug":189,"title":190},"configuracion-general","Configuración general",{"slug":192,"title":193},"impresoras","Cómo cargar las impresoras del local",{"slug":195,"title":196},"perfiles-de-impresion","Cómo usar los perfiles de impresión",{"slug":198,"title":199},"usuarios-del-sistema","Cómo administrar los Usuarios del Sistema",{"slug":201,"title":202},"usuarios-con-pin","Cómo administrar los Usuarios con PIN",{"slug":204,"title":205},"punto-de-venta","🏛️ Trámite en ARCA (con clave fiscal)",{"slug":207,"title":208},"permisos-por-rol","Cómo configurar los Permisos por Rol",{"slug":210,"title":211},"turnos-mesa","Turnos de Mesa",{"slug":213,"title":214},"medios-de-cobro","Medios de cobro",{"slug":216,"title":217},"clasificacion-de-gastos","Clasificación de Gastos",{"slug":219,"title":220},"centros-de-costo","Centros de Costo",{"title":222,"modules":223},"Biblioteca de Drivers",[224,226,229,232,235,238,241,244,247],{"slug":225,"title":222},"biblioteca-de-drivers",{"slug":227,"title":228},"sam4s-giant-100","Sam4S Giant - 100",{"slug":230,"title":231},"citizen-ct-s310ii","Citizen CT-S310II",{"slug":233,"title":234},"epson-tm-t20","Epson TM-T20",{"slug":236,"title":237},"drivers-genericos","Drivers Genéricos POS",{"slug":239,"title":240},"epson-tm-t88","Epson TM-T88V",{"slug":242,"title":243},"fiscalberry-windows","Instalar Fiscalberry en Windows",{"slug":245,"title":246},"fiscalberry-linux","Instalar Fiscalberry en Linux",{"slug":248,"title":249},"fiscalberry-android","Instalar Fiscalberry en Android",{"title":251,"modules":252},"Extra",[253,256,259,262,265,268,271,274,277,280],{"slug":254,"title":255},"01-faq-solucion-inicial-pantalla-congelada","📖 Manual de Usuario: Solución Inicial si la Pantalla se Congela o no Carga",{"slug":257,"title":258},"03-faq-mozo-reabrir-mesa-anulada","📖 Manual de Usuario: Cómo Reabrir una Mesa Anulada o Cerrada por Error",{"slug":260,"title":261},"05-faq-cajero-emitir-factura-a","📖 Manual de Usuario: Cómo Emitir una Factura A Cargando Datos del Cliente",{"slug":263,"title":264},"06-faq-cajero-ingreso-egreso-cajon","📖 Manual de Usuario: Cómo Registrar Entradas y Salidas de Dinero del Cajón",{"slug":266,"title":267},"07-faq-cajero-activar-medio-pago","📖 Manual de Usuario: Cómo Activar un Medio de Pago que no Aparece al Cobrar",{"slug":269,"title":270},"08-faq-cajero-diferencia-facturado-vs-abiertas","📖 Manual de Usuario: Diferencia entre \"Facturado Total Mesas\" y \"Abiertas Por Usuario\" en Caja",{"slug":272,"title":273},"10-faq-supervisor-cierre-caja-diferencias","📖 Manual de Usuario: Cómo Auditar y Solucionar Diferencias en el Cierre de Caja",{"slug":275,"title":276},"preguntas-frecuentes","Preguntas Frecuentes y Guías Rápidas por Rol",{"slug":278,"title":279},"buchon-bot","Buchón Bot",{"slug":281,"title":282},"troubleshooting-semantico","📖 Guía Única de Resolución de Problemas y Errores (Troubleshooting)"],"uses":{}},{"type":"data","data":[{"slug":1,"title":2,"content":3,"tableOfContents":4,"seo":21,"llmTxtFile":25},"clientes","Cómo Gestionar los Clientes","\u003Cdiv id=\"gestion-de-clientes\">\u003C/div>\n\n\u003Cblockquote>\n\u003Cp>\u003Cstrong>¿Dónde está en el sistema?:\u003C/strong> Menú principal → \u003Cstrong>Ventas\u003C/strong> → \u003Cstrong>Clientes\u003C/strong>\u003Cbr>\u003Cstrong>¿Quién lo usa?:\u003C/strong> Cajeros, encargados y administradores\u003C/p>\n\u003C/blockquote>\n\u003Cblockquote>\n\u003Cp>🎯 \u003Cstrong>¿Para qué sirve esto?\u003C/strong>\nAcá cargás, buscás y corregís los clientes de tu comercio. Con los clientes cargados podés asignarlos a una mesa, hacerles la factura con sus datos y darles un descuento.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                📍 \u003Cstrong>Paso 1: Entrá al listado de Clientes\u003C/strong>\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-1-entra-al-listado-de-clientes\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-1-entra-al-listado-de-clientes\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/25-00a-menu-grupo-ventas.png\" alt=\"Grupo Ventas del menú lateral, marcado en rojo\">\u003C/p>\n\u003Col>\n\u003Cli>En el menú de la izquierda, tocá \u003Cstrong>Ventas\u003C/strong>. Se despliegan sus opciones.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/25-00b-menu-opcion-clientes.png\" alt=\"Opción Clientes dentro del grupo Ventas, marcada en rojo\">\u003C/p>\n\u003Col start=\"2\">\n\u003Cli>Bajá hasta la parte \u003Cstrong>Clientes\u003C/strong> y tocá \u003Cstrong>Clientes\u003C/strong>.\u003C/li>\n\u003Cli>Se abre el listado con todos los clientes.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/10-clientes-listado.png\" alt=\"Listado de clientes con el buscador arriba y la tabla abajo\">\u003C/p>\n\u003Cp>En esta pantalla vas a ver:\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Arriba a la derecha:\u003C/strong> el botón verde \u003Cstrong>Crear Nuevo Cliente\u003C/strong>.\u003C/li>\n\u003Cli>\u003Cstrong>En el medio:\u003C/strong> el buscador, con casilleros para buscar por nombre, teléfono, documento y más.\u003C/li>\n\u003Cli>\u003Cstrong>Abajo:\u003C/strong> la tabla con los clientes y, a la derecha de cada uno, sus botones.\u003C/li>\n\u003C/ul>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                ➕ \u003Cstrong>Paso 2: Cargá un cliente nuevo\u003C/strong>\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-2-carga-un-cliente-nuevo\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-2-carga-un-cliente-nuevo\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/25-02-donde-esta-boton-crear-nuevo-s.png\" alt=\"Listado de clientes con el botón Crear Nuevo Cliente marcado en rojo\">\u003C/p>\n\u003Col>\n\u003Cli>Tocá el botón verde \u003Cstrong>Crear Nuevo Cliente\u003C/strong>, arriba a la derecha.\u003C/li>\n\u003Cli>Se abre la pantalla \u003Cstrong>Agregar Cliente\u003C/strong>, con los datos en tres partes.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/11-clientes-nuevo-formulario.png\" alt=\"Pantalla Agregar Cliente con las partes Datos personales, Contacto y Comercial\">\u003C/p>\n\u003Ch3>Datos personales\u003C/h3>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/25-70-campo-nombre-alta.png\" alt=\"Casillero Nombre con el nombre Juan Pérez\">\u003C/p>\n\u003Col start=\"3\">\n\u003Cli>En \u003Cstrong>Nombre\u003C/strong>, escribí el nombre del cliente. Por ejemplo: \u003Cem>Juan Pérez\u003C/em>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/25-11-campo-iva-responsabilidad-id.png\" alt=\"Lista Iva Responsabilidad con Consumidor Final elegido\">\u003C/p>\n\u003Col start=\"4\">\n\u003Cli>En \u003Cstrong>Iva Responsabilidad\u003C/strong>, dejá \u003Cstrong>Consumidor Final\u003C/strong>. Cambialo solo si el cliente te pide factura A (por ejemplo, \u003Cstrong>Resp. Inscripto\u003C/strong>).\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/25-10-campo-tipo-documento-id.png\" alt=\"Lista Tipo Documento\">\u003C/p>\n\u003Col start=\"5\">\n\u003Cli>En \u003Cstrong>Tipo Documento\u003C/strong>, elegí el tipo. Por ejemplo: \u003Cstrong>DNI\u003C/strong> o \u003Cstrong>CUIT\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/25-71-campo-numero-documento.png\" alt=\"Casillero Número de documento\">\u003C/p>\n\u003Col start=\"6\">\n\u003Cli>En \u003Cstrong>Número de documento\u003C/strong>, escribí el número, sin puntos ni guiones.\u003C/li>\n\u003C/ol>\n\u003Ch3>Contacto\u003C/h3>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/25-06-campo-mail.png\" alt=\"Casillero Correo Electrónico\">\u003C/p>\n\u003Col start=\"7\">\n\u003Cli>En \u003Cstrong>Correo Electrónico\u003C/strong>, escribí el mail. Por ejemplo: \u003Cem>\u003Ca href=\"mailto:juan.perez@ejemplo.com\">juan.perez@ejemplo.com\u003C/a>\u003C/em>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/25-72-campo-telefono-alta.png\" alt=\"Casillero Teléfono\">\u003C/p>\n\u003Col start=\"8\">\n\u003Cli>En \u003Cstrong>Teléfono\u003C/strong>, escribí el celular. Por ejemplo: \u003Cem>1155556666\u003C/em>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/25-09-campo-domicilio.png\" alt=\"Casillero Domicilio de facturación\">\u003C/p>\n\u003Col start=\"9\">\n\u003Cli>En \u003Cstrong>Domicilio de facturación\u003C/strong>, escribí la dirección. Por ejemplo: \u003Cem>Av. Siempreviva 742\u003C/em>.\u003C/li>\n\u003C/ol>\n\u003Ch3>Comercial\u003C/h3>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/25-12-campo-descuento-id.png\" alt=\"Lista Descuento con Sin Descuento elegido\">\u003C/p>\n\u003Col start=\"10\">\n\u003Cli>En \u003Cstrong>Descuento\u003C/strong>, elegí un descuento si el cliente siempre lo tiene. Si no, dejá \u003Cstrong>Sin Descuento\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/25-04-campo-codigo.png\" alt=\"Casillero Codigo\">\u003C/p>\n\u003Col start=\"11\">\n\u003Cli>\u003Cstrong>Codigo\u003C/strong> es opcional. Sirve si usás un número propio para cada cliente.\u003C/li>\n\u003C/ol>\n\u003Ch3>Guardá\u003C/h3>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/25-31-donde-esta-boton-actualizar-agregar.png\" alt=\"Pantalla Agregar Cliente con el botón Agregar marcado en rojo abajo a la derecha\">\u003C/p>\n\u003Col start=\"12\">\n\u003Cli>Tocá el botón azul \u003Cstrong>Agregar\u003C/strong>, abajo a la derecha.\u003C/li>\n\u003Cli>El cliente queda guardado y volvés al listado.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/25-29-donde-esta-boton-cancelar.png\" alt=\"Pantalla Agregar Cliente con el botón Cancelar marcado en rojo abajo a la izquierda\">\u003C/p>\n\u003Cul>\n\u003Cli>Si no querés guardar, tocá \u003Cstrong>Cancelar\u003C/strong>, abajo a la izquierda.\u003C/li>\n\u003C/ul>\n\u003Cblockquote>\n\u003Cp>💡 \u003Cstrong>Consejo útil:\u003C/strong> Cargá siempre el \u003Cstrong>teléfono\u003C/strong>, el \u003Cstrong>mail\u003C/strong> o el \u003Cstrong>documento\u003C/strong>. Así el sistema te avisa si el cliente ya existe.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🔍 \u003Cstrong>Paso 3: Buscá un cliente\u003C/strong>\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-3-busca-un-cliente\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-3-busca-un-cliente\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/25-68-panel-busqueda.png\" alt=\"Buscador de clientes con todos sus casilleros\">\u003C/p>\n\u003Col>\n\u003Cli>Usá el buscador que está arriba de la tabla. Completá \u003Cstrong>solo\u003C/strong> lo que sepas del cliente:\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/25-05-campo-nombre.png\" alt=\"Casillero Nombre del buscador con la palabra Prueba escrita\">\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Nombre:\u003C/strong> escribí una parte del nombre. Por ejemplo: \u003Cem>Pérez\u003C/em>.\u003C/li>\n\u003C/ul>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/25-08-campo-telefono.png\" alt=\"Casillero Teléfono del buscador\">\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Teléfono:\u003C/strong> escribí el celular.\u003C/li>\n\u003C/ul>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/25-07-campo-nrodocumento.png\" alt=\"Casillero Nº Documento del buscador\">\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Nº Documento:\u003C/strong> escribí el DNI o el CUIT.\u003C/li>\n\u003C/ul>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/25-18-campo-cliente-tag-id.png\" alt=\"Lista Tag del buscador\">\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Tag:\u003C/strong> elegí una etiqueta para ver solo esos clientes. Por ejemplo: \u003Cem>Frecuente\u003C/em>.\u003C/li>\n\u003C/ul>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/25-14-donde-esta-boton-buscar.png\" alt=\"Listado con el botón Buscar marcado en rojo\">\u003C/p>\n\u003Col start=\"2\">\n\u003Cli>Tocá el botón azul \u003Cstrong>Buscar\u003C/strong>.\u003C/li>\n\u003Cli>La tabla muestra solo los clientes que coinciden.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/25-69-resultado-busqueda.png\" alt=\"Tabla de clientes filtrada por la búsqueda\">\u003C/p>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/25-16-donde-esta-boton-limpiar.png\" alt=\"Listado con el botón Limpiar marcado en rojo\">\u003C/p>\n\u003Col start=\"4\">\n\u003Cli>Para volver a ver todos los clientes, tocá \u003Cstrong>Limpiar\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                ✏️ \u003Cstrong>Paso 4: Mirá, corregí o borrá un cliente\u003C/strong>\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-4-mira-corregi-o-borra-un-cliente\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-4-mira-corregi-o-borra-un-cliente\">\u003C/div>\n\n\u003Cp>A la derecha de cada cliente hay tres botones:\u003C/p>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/39-clientes-botones-accion.png\" alt=\"Botones Ver, Editar y Borrar de un cliente\">\u003C/p>\n\u003Ch3>Ver la ficha\u003C/h3>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/25-21-donde-esta-boton-ver.png\" alt=\"Tabla de clientes con el botón del ojo marcado en rojo\">\u003C/p>\n\u003Col>\n\u003Cli>Tocá el botón del \u003Cstrong>ojo\u003C/strong> 👁️.\u003C/li>\n\u003Cli>Se abre la ficha del cliente.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/25-73-pantalla-ficha-cliente.png\" alt=\"Ficha del cliente con sus datos, consumo, cuentas abiertas e historial de mesas\">\u003C/p>\n\u003Cp>En la ficha vas a ver:\u003C/p>\n\u003Cul>\n\u003Cli>Cuántas \u003Cstrong>visitas\u003C/strong> hizo y cuánto \u003Cstrong>consumió\u003C/strong> en total.\u003C/li>\n\u003Cli>Sus \u003Cstrong>datos\u003C/strong>, las \u003Cstrong>cuentas abiertas\u003C/strong> y el \u003Cstrong>historial de mesas\u003C/strong>.\u003C/li>\n\u003Cli>Si hay \u003Cstrong>clientes parecidos\u003C/strong> cargados (posibles duplicados):\u003C/li>\n\u003C/ul>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/25-74-aviso-duplicados.png\" alt=\"Aviso naranja Posibles Clientes duplicados\">\u003C/p>\n\u003Cul>\n\u003Cli>La parte \u003Cstrong>CRM\u003C/strong>, para anotar gustos o alergias, vincular clientes y ponerle etiquetas (tags):\u003C/li>\n\u003C/ul>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/25-75-seccion-crm.png\" alt=\"Parte CRM de la ficha con Notas, Vínculos y Tags\">\u003C/p>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/25-33-donde-esta-boton-editar-ficha.png\" alt=\"Ficha del cliente con el botón Editar marcado en rojo\">\u003C/p>\n\u003Cul>\n\u003Cli>Para corregir sus datos desde la ficha, tocá \u003Cstrong>Editar\u003C/strong>, arriba a la derecha.\u003C/li>\n\u003C/ul>\n\u003Ch3>Corregir los datos\u003C/h3>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/25-23-donde-esta-boton-editar.png\" alt=\"Tabla de clientes con el botón del lápiz marcado en rojo\">\u003C/p>\n\u003Col>\n\u003Cli>Tocá el botón del \u003Cstrong>lápiz\u003C/strong> ✏️.\u003C/li>\n\u003Cli>Se abren los datos del cliente. Cambiá lo que haga falta.\u003C/li>\n\u003Cli>Tocá \u003Cstrong>Actualizar\u003C/strong> para guardar los cambios.\u003C/li>\n\u003C/ol>\n\u003Ch3>Borrar\u003C/h3>\n\u003Cblockquote>\n\u003Cp>⚠️ \u003Cstrong>Atención:\u003C/strong> Borrar un cliente no se puede deshacer. Revisá bien que sea el cliente correcto.\u003C/p>\n\u003C/blockquote>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/25-25-donde-esta-boton-borrar.png\" alt=\"Tabla de clientes con el botón rojo de la papelera marcado\">\u003C/p>\n\u003Col>\n\u003Cli>Tocá el botón rojo de la \u003Cstrong>papelera\u003C/strong> 🗑️.\u003C/li>\n\u003Cli>El sistema te pregunta si estás seguro. Tocá \u003Cstrong>Aceptar\u003C/strong> para borrarlo.\u003C/li>\n\u003C/ol>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                ⚠️ \u003Cstrong>Resolución de Inconvenientes\u003C/strong>\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"resolucion-de-inconvenientes\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"resolucion-de-inconvenientes\">\u003C/div>\n\n\u003Cdiv class=\"table-wrapper\">\u003Ctable>\n\u003Cthead>\n\u003Ctr>\n\u003Cth>Problema\u003C/th>\n\u003Cth>Causa más frecuente\u003C/th>\n\u003Cth>Solución recomendada\u003C/th>\n\u003C/tr>\n\u003C/thead>\n\u003Ctbody>\u003Ctr>\n\u003Ctd>\u003Cstrong>No encuentro al cliente en la lista\u003C/strong>\u003C/td>\n\u003Ctd>Quedó escrito algo en el buscador.\u003C/td>\n\u003Ctd>Tocá \u003Cstrong>Limpiar\u003C/strong> y buscá por teléfono o documento.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>Se crearon clientes duplicados\u003C/strong>\u003C/td>\n\u003Ctd>Se cargó el mismo cliente sin teléfono, mail ni documento.\u003C/td>\n\u003Ctd>Abrí la ficha: el aviso \u003Cstrong>Posibles Clientes duplicados\u003C/strong> te muestra cuáles son. Borrá el repetido.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>No puedo elegir un descuento\u003C/strong>\u003C/td>\n\u003Ctd>No hay descuentos creados.\u003C/td>\n\u003Ctd>Creá uno en \u003Cstrong>Ventas → Descuentos\u003C/strong> (ver \u003Ca href=\"/user-guide/descuentos\">Descuentos\u003C/a>).\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>No me deja borrar ni editar un cliente\u003C/strong>\u003C/td>\n\u003Ctd>Tu usuario no tiene permiso para modificar clientes.\u003C/td>\n\u003Ctd>Pedile al administrador que lo revise en \u003Ca href=\"/user-guide/permisos-por-rol\">Permisos por Rol\u003C/a>.\u003C/td>\n\u003C/tr>\n\u003C/tbody>\u003C/table>\u003C/div>\n",[5,9,12,15,18],{"id":6,"title":7,"level":8},"paso-1-entra-al-listado-de-clientes","Paso 1: Entrá al listado de Clientes",2,{"id":10,"title":11,"level":8},"paso-2-carga-un-cliente-nuevo","Paso 2: Cargá un cliente nuevo",{"id":13,"title":14,"level":8},"paso-3-busca-un-cliente","Paso 3: Buscá un cliente",{"id":16,"title":17,"level":8},"paso-4-mira-corregi-o-borra-un-cliente","Paso 4: Mirá, corregí o borrá un cliente",{"id":19,"title":20,"level":8},"resolucion-de-inconvenientes","Resolución de Inconvenientes",{"title":22,"description":23,"keywords":24},"Cómo Gestionar los Clientes - Manual","¿Dónde está en el sistema?: Menú principal → Ventas → Clientes  \n ¿Quién lo usa?: Cajeros, encargados y administradores","clientes, paxapos, cómo gestionar los clientes, tutorial, guía, manual usuario","25-clientes.txt"],"uses":{"params":["slug"]}}]}
