{"type":"data","nodes":[null,{"type":"data","data":[{"moduleCategories":1},[2,17,44,53,77,98,110,140,146,173,185,221,250],{"title":3,"modules":4},"Comenzamos",[5,8,11,14],{"slug":6,"title":7},"introduccion","Bienvenido a tu software gastronómico",{"slug":9,"title":10},"iniciar-sesion","Cómo Iniciar Sesión",{"slug":12,"title":13},"recuperar-contrasena","Cómo Recuperar tu Contraseña",{"slug":15,"title":16},"guia-de-inicio-rapido","Guía de Inicio Rápido",{"title":18,"modules":19},"Ventas",[20,23,26,29,32,35,38,41],{"slug":21,"title":22},"salon-de-ventas","Cómo Usar el Salón de Ventas (Adición)",{"slug":24,"title":25},"caja-rapida","Cómo Usar la Caja Rápida (Registradora)",{"slug":27,"title":28},"mozos","Cómo Cargar los Mozos",{"slug":30,"title":31},"clientes","Cómo Gestionar los Clientes",{"slug":33,"title":34},"descuentos","Cómo Configurar Descuentos",{"slug":36,"title":37},"nueva-reserva","Cómo Cargar una Nueva Reserva",{"slug":39,"title":40},"listado-de-reservas","Cómo Usar el Listado de Reservas",{"slug":42,"title":43},"grilla-de-reservas","Cómo Usar la Grilla de Reservas",{"title":45,"modules":46},"Medios de Pago",[47,50],{"slug":48,"title":49},"configuracion-procesadores","Configuración de Procesadores de Pago",{"slug":51,"title":52},"transacciones-mercadopago","Transacciones MercadoPago",{"title":54,"modules":55},"Productos",[56,59,62,65,68,71,74],{"slug":57,"title":58},"menu","Menú de Productos (Carta)",{"slug":60,"title":61},"categorias","Categorías de Productos",{"slug":63,"title":64},"variantes-grupo-sabores","Variantes y Grupos de Sabores",{"slug":66,"title":67},"maestro-de-productos","Maestro de Productos",{"slug":69,"title":70},"subproductos-elaborados","Sub-Productos (Elaborados)",{"slug":72,"title":73},"recetas","Recetas",{"slug":75,"title":76},"analisis-duplicados","Buscar Duplicados",{"title":78,"modules":79},"Compras",[80,83,86,89,92,95],{"slug":81,"title":82},"todas-las-ordenes-compra","Órdenes de Compra",{"slug":84,"title":85},"crear-orden-compra","Crear una Orden de Compra",{"slug":87,"title":88},"ordenes-a-aprobar","Órdenes a aprobar",{"slug":90,"title":91},"mercaderias","Mercaderías",{"slug":93,"title":94},"proveedores","Proveedores",{"slug":96,"title":97},"historial-de-compras","Historial de Compras",{"title":99,"modules":100},"Stock",[101,104,107],{"slug":102,"title":103},"stock-mercaderias","Stock de Mercaderías",{"slug":105,"title":106},"stock-subproductos","Stock de Subproductos",{"slug":108,"title":109},"movimientos-de-stock","Movimientos de Stock",{"title":111,"modules":112},"Finanzas",[113,116,119,122,125,128,131,134,137],{"slug":114,"title":115},"arqueos-de-caja","Arqueos de Caja",{"slug":117,"title":118},"listado-de-cajas","Listado de Cajas",{"slug":120,"title":121},"transacciones-de-cobro","Transacciones de Cobro",{"slug":123,"title":124},"factura-manual","Factura Manual",{"slug":126,"title":127},"resumen-de-deuda","Resumen de Deuda",{"slug":129,"title":130},"pagos","Pagos",{"slug":132,"title":133},"historial-de-facturas","Historial de Facturas",{"slug":135,"title":136},"historico-de-mesas","Histórico de Mesas",{"slug":138,"title":139},"puntos-de-venta-pdv","Puntos de Venta (PDVs)",{"title":141,"modules":142},"Comandero",[143],{"slug":144,"title":145},"comandero","Comandero (pantalla de cocina)",{"title":147,"modules":148},"RRHH",[149,152,155,158,161,164,167,170],{"slug":150,"title":151},"empleados","Empleados",{"slug":153,"title":154},"empleados-trabajando","Empleados Trabajando",{"slug":156,"title":157},"registro-diario-fichaje","Registro Diario de Fichaje",{"slug":159,"title":160},"reporte-mensual-fichaje","Reporte Mensual de Fichaje",{"slug":162,"title":163},"departamentos","Departamentos",{"slug":165,"title":166},"turnos-y-horarios-fichaje","Turnos y Horarios de Fichaje",{"slug":168,"title":169},"sueldos-y-jornales","Sueldos y Jornales",{"slug":171,"title":172},"datos-de-acceso-app","Datos de Acceso a la App de Fichaje",{"title":174,"modules":175},"Reportes",[176,179,182],{"slug":177,"title":178},"tablero-general","Tablero General",{"slug":180,"title":181},"productos-mas-vendidos","Productos Más Vendidos",{"slug":183,"title":184},"compras-por-mercaderia","Compras por Mercadería",{"title":186,"modules":187},"Configuracion",[188,191,194,197,200,203,206,209,212,215,218],{"slug":189,"title":190},"configuracion-general","Configuración general",{"slug":192,"title":193},"impresoras","Cómo cargar las impresoras del local",{"slug":195,"title":196},"perfiles-de-impresion","Cómo usar los perfiles de impresión",{"slug":198,"title":199},"usuarios-del-sistema","Cómo administrar los Usuarios del Sistema",{"slug":201,"title":202},"usuarios-con-pin","Cómo administrar los Usuarios con PIN",{"slug":204,"title":205},"punto-de-venta","🏛️ Trámite en ARCA (con clave fiscal)",{"slug":207,"title":208},"permisos-por-rol","Cómo configurar los Permisos por Rol",{"slug":210,"title":211},"turnos-mesa","Turnos de Mesa",{"slug":213,"title":214},"medios-de-cobro","Medios de cobro",{"slug":216,"title":217},"clasificacion-de-gastos","Clasificación de Gastos",{"slug":219,"title":220},"centros-de-costo","Centros de Costo",{"title":222,"modules":223},"Biblioteca de Drivers",[224,226,229,232,235,238,241,244,247],{"slug":225,"title":222},"biblioteca-de-drivers",{"slug":227,"title":228},"sam4s-giant-100","Sam4S Giant - 100",{"slug":230,"title":231},"citizen-ct-s310ii","Citizen CT-S310II",{"slug":233,"title":234},"epson-tm-t20","Epson TM-T20",{"slug":236,"title":237},"drivers-genericos","Drivers Genéricos POS",{"slug":239,"title":240},"epson-tm-t88","Epson TM-T88V",{"slug":242,"title":243},"fiscalberry-windows","Instalar Fiscalberry en Windows",{"slug":245,"title":246},"fiscalberry-linux","Instalar Fiscalberry en Linux",{"slug":248,"title":249},"fiscalberry-android","Instalar Fiscalberry en Android",{"title":251,"modules":252},"Extra",[253,256,259,262,265,268,271,274,277,280],{"slug":254,"title":255},"01-faq-solucion-inicial-pantalla-congelada","📖 Manual de Usuario: Solución Inicial si la Pantalla se Congela o no Carga",{"slug":257,"title":258},"03-faq-mozo-reabrir-mesa-anulada","📖 Manual de Usuario: Cómo Reabrir una Mesa Anulada o Cerrada por Error",{"slug":260,"title":261},"05-faq-cajero-emitir-factura-a","📖 Manual de Usuario: Cómo Emitir una Factura A Cargando Datos del Cliente",{"slug":263,"title":264},"06-faq-cajero-ingreso-egreso-cajon","📖 Manual de Usuario: Cómo Registrar Entradas y Salidas de Dinero del Cajón",{"slug":266,"title":267},"07-faq-cajero-activar-medio-pago","📖 Manual de Usuario: Cómo Activar un Medio de Pago que no Aparece al Cobrar",{"slug":269,"title":270},"08-faq-cajero-diferencia-facturado-vs-abiertas","📖 Manual de Usuario: Diferencia entre \"Facturado Total Mesas\" y \"Abiertas Por Usuario\" en Caja",{"slug":272,"title":273},"10-faq-supervisor-cierre-caja-diferencias","📖 Manual de Usuario: Cómo Auditar y Solucionar Diferencias en el Cierre de Caja",{"slug":275,"title":276},"preguntas-frecuentes","Preguntas Frecuentes y Guías Rápidas por Rol",{"slug":278,"title":279},"buchon-bot","Buchón Bot",{"slug":281,"title":282},"troubleshooting-semantico","📖 Guía Única de Resolución de Problemas y Errores (Troubleshooting)"],"uses":{}},{"type":"data","data":[{"slug":1,"title":2,"content":3,"tableOfContents":4,"seo":30,"llmTxtFile":34},"impresoras","Cómo cargar las impresoras del local","\u003Cdiv id=\"impresoras\">\u003C/div>\n\n\u003Cblockquote>\n\u003Cp>\u003Cstrong>¿Dónde está en el sistema?:\u003C/strong> Menú principal → \u003Cstrong>Configuración\u003C/strong> → debajo del título \u003Cstrong>Impresoras\u003C/strong> → \u003Cstrong>Impresoras\u003C/strong>\n\u003Cstrong>¿Quién lo usa?:\u003C/strong> Dueños, Administradores y Soporte Técnico\u003C/p>\n\u003C/blockquote>\n\u003Cblockquote>\n\u003Cp>🎯 \u003Cstrong>¿Para qué sirve esto?\u003C/strong>\nAcá le decís a PaxaPOS qué impresoras tiene tu local (Cocina, Barra, Caja) y cómo están conectadas. Con eso, cada comanda o ticket sale por la impresora correcta.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🔑 \u003Cstrong>Antes de empezar\u003C/strong>\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"antes-de-empezar\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"antes-de-empezar\">\u003C/div>\n\n\u003Cul>\n\u003Cli>La impresora tiene que estar encendida, con papel y conectada (por USB o por cable de red).\u003C/li>\n\u003Cli>\u003Cstrong>Fiscalberry\u003C/strong> tiene que estar instalado y abierto en la computadora del local. Es el programa que manda los trabajos a la impresora. Descargalo en \u003Ca href=\"/user-guide/configuracion-general#impresion\">Configuración general\u003C/a>, sección \u003Cstrong>Impresión\u003C/strong>.\u003C/li>\n\u003Cli>Guías de instalación: \u003Ca href=\"/user-guide/fiscalberry-windows\">Windows\u003C/a>, \u003Ca href=\"/user-guide/fiscalberry-linux\">Linux\u003C/a> y \u003Ca href=\"/user-guide/fiscalberry-android\">Android\u003C/a>.\u003C/li>\n\u003Cli>Si tu impresora es USB y usás Windows, instalá antes el driver. Buscalo en la \u003Ca href=\"/user-guide/biblioteca-de-drivers\">Biblioteca de Drivers\u003C/a>.\u003C/li>\n\u003Cli>Tener el permiso de impresoras en \u003Ca href=\"/user-guide/permisos-por-rol\">Permisos por Rol\u003C/a>.\u003C/li>\n\u003C/ul>\n\u003Cblockquote>\n\u003Cp>⚠️ Una impresora \u003Cstrong>USB\u003C/strong> necesita que Fiscalberry esté en una computadora (Windows o Linux). En \u003Cstrong>Android\u003C/strong> solo funcionan impresoras de red.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                📍 \u003Cstrong>Paso 1: Entrá a Impresoras\u003C/strong>\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-1-entra-a-impresoras\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-1-entra-a-impresoras\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/110-configuracion/120-00a-menu-grupo-configuracion.png\" alt=\"Menú lateral con el grupo Configuración marcado en rojo\">\u003C/p>\n\u003Col>\n\u003Cli>En el menú de la izquierda, tocá \u003Cstrong>Configuración\u003C/strong>. Se despliegan sus opciones.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/110-configuracion/120-00b-menu-opcion-impresoras.png\" alt=\"Menú lateral con la opción Impresoras marcada en rojo, debajo del título Impresoras\">\u003C/p>\n\u003Col start=\"2\">\n\u003Cli>Debajo del título \u003Cstrong>Impresoras\u003C/strong>, tocá \u003Cstrong>Impresoras\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/110-configuracion/120-01-pantalla-impresoras.png\" alt=\"Pantalla Impresoras Instaladas en Paxapos con una impresora cargada\">\u003C/p>\n\u003Cp>Se abre la lista \u003Cstrong>Impresoras Instaladas en Paxapos\u003C/strong>. Cada impresora es una tarjeta, como la del centro de la foto.\u003C/p>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🖨️ \u003Cstrong>Paso 2: Conocé la tarjeta de cada impresora\u003C/strong>\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-2-conoce-la-tarjeta-de-cada-impresora\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-2-conoce-la-tarjeta-de-cada-impresora\">\u003C/div>\n\n\u003Cp>En la foto de arriba, la tarjeta muestra:\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>El nombre\u003C/strong> de la impresora.\u003C/li>\n\u003Cli>\u003Cstrong>Cuántos productos\u003C/strong> salen por ella. Si no tiene ninguno, dice \u003Cem>Sin productos relacionados\u003C/em>.\u003C/li>\n\u003Cli>\u003Cstrong>Paxaprinter\u003C/strong>: el Fiscalberry que la maneja. Si dice \u003Cem>(default)\u003C/em>, usa el principal del local.\u003C/li>\n\u003Cli>\u003Cstrong>Creada\u003C/strong> y \u003Cstrong>Modificada\u003C/strong>: cuándo se cargó y cuándo se cambió por última vez.\u003C/li>\n\u003C/ul>\n\u003Cp>Abajo tiene tres botones (\u003Cstrong>Test de impresión\u003C/strong>, \u003Cstrong>Editar\u003C/strong> y \u003Cstrong>Borrar\u003C/strong>):\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Test de impresión\u003C/strong>: manda un ticket de prueba de verdad. Si no sale papel, revisá la tabla del final.\u003C/li>\n\u003Cli>\u003Cstrong>Editar\u003C/strong>: abre la ventanita con los datos para cambiarlos.\u003C/li>\n\u003Cli>\u003Cstrong>Borrar\u003C/strong> (rojo): elimina la impresora. Antes te pide confirmación.\u003C/li>\n\u003C/ul>\n\u003Cblockquote>\n\u003Cp>⚠️ \u003Cstrong>Atención:\u003C/strong> \u003Cstrong>Test de impresión\u003C/strong> gasta papel y \u003Cstrong>Borrar\u003C/strong> saca la impresora. Los productos que salían por ella quedan sin impresora.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                ➕ \u003Cstrong>Paso 3: Tocá &quot;Nueva Impresora&quot;\u003C/strong>\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-3-toca-nueva-impresora\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-3-toca-nueva-impresora\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/110-configuracion/120-02-donde-esta-boton-nueva-impresora.png\" alt=\"Pantalla Impresoras con el botón verde Nueva Impresora marcado en rojo arriba a la derecha\">\u003C/p>\n\u003Col>\n\u003Cli>Buscá el botón verde \u003Cstrong>Nueva Impresora\u003C/strong>, arriba a la derecha.\u003C/li>\n\u003Cli>Tocalo una vez.\u003C/li>\n\u003Cli>Se abre la ventanita \u003Cstrong>Agregar Impresora\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                📝 \u003Cstrong>Paso 4: Completá los datos\u003C/strong>\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-4-completa-los-datos\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-4-completa-los-datos\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/110-configuracion/120-03-ventana-agregar-impresora.png\" alt=\"Ventanita Agregar Impresora con nombre Cocina Prueba, driver Impresora instalada en Windows y ancho de papel\">\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Nombre\u003C/strong>: un nombre fácil de reconocer. Por ejemplo: \u003Cem>Cocina\u003C/em>, \u003Cem>Barra\u003C/em> o \u003Cem>Caja\u003C/em>.\u003C/li>\n\u003Cli>\u003Cstrong>Alias\u003C/strong>: un nombre corto opcional. Solo lo ven Dueños y Administradores.\u003C/li>\n\u003Cli>\u003Cstrong>Driver\u003C/strong>: cómo está conectada la impresora. Al elegir uno, cambian los casilleros de abajo.\u003C/li>\n\u003Cli>\u003Cstrong>Ancho de papel\u003C/strong>: el tamaño del rollo. \u003Cstrong>80mm (40 columnas)\u003C/strong> es el más común. También hay \u003Cstrong>80mm fuente chica (48 columnas)\u003C/strong> y \u003Cstrong>58mm (32 columnas)\u003C/strong>. Si no elegís, usa 40.\u003C/li>\n\u003Cli>\u003Cstrong>Paxaprinter\u003C/strong>: el Fiscalberry que va a imprimir. Los círculos rojos son los que están apagados y el verde el que está conectado. Con \u003Cstrong>Default\u003C/strong> usa el principal.\u003C/li>\n\u003Cli>\u003Cstrong>Agregar\u003C/strong> (verde): guarda la impresora.\u003C/li>\n\u003Cli>\u003Cstrong>Cancelar\u003C/strong>: cierra sin guardar.\u003C/li>\n\u003C/ul>\n\u003Cp>Estas son las opciones de \u003Cstrong>Driver\u003C/strong>:\u003C/p>\n\u003Cdiv class=\"table-wrapper\">\u003Ctable>\n\u003Cthead>\n\u003Ctr>\n\u003Cth>Fiscalberry está en…\u003C/th>\n\u003Cth>La impresora se conecta por…\u003C/th>\n\u003Cth>Elegí en \u003Cstrong>Driver\u003C/strong>\u003C/th>\n\u003C/tr>\n\u003C/thead>\n\u003Ctbody>\u003Ctr>\n\u003Ctd>Windows\u003C/td>\n\u003Ctd>USB, con el driver instalado\u003C/td>\n\u003Ctd>\u003Cstrong>Impresora instalada en Windows\u003C/strong>\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>Windows, Linux o Android\u003C/td>\n\u003Ctd>Cable de red\u003C/td>\n\u003Ctd>\u003Cstrong>Impresora de Red\u003C/strong>\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>Linux\u003C/td>\n\u003Ctd>USB\u003C/td>\n\u003Ctd>\u003Cstrong>USB\u003C/strong> (o \u003Cstrong>CUPS\u003C/strong>)\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>Android\u003C/td>\n\u003Ctd>Bluetooth\u003C/td>\n\u003Ctd>\u003Cstrong>Impresora Bluetooth\u003C/strong>\u003C/td>\n\u003C/tr>\n\u003C/tbody>\u003C/table>\u003C/div>\n\u003Cp>También existen \u003Cstrong>Serial\u003C/strong>, \u003Cstrong>Archivo\u003C/strong>, \u003Cstrong>Impresion mediante LP\u003C/strong> y \u003Cstrong>Test Dummy\u003C/strong>. Son para casos especiales: pedí ayuda a soporte.\u003C/p>\n\u003Cp>\u003Cimg src=\"/images/manual/110-configuracion/120-04-ventana-impresora-de-red.png\" alt=\"Ventanita con Driver Impresora de Red, IP 192.168.0.200, puerto 9100 y ancho 80mm\">\u003C/p>\n\u003Cp>Con \u003Cstrong>Impresora de Red\u003C/strong> aparecen dos casilleros:\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>IP de la impresora\u003C/strong>: el número de la impresora en tu red. Por ejemplo: \u003Cem>192.168.0.200\u003C/em>.\u003C/li>\n\u003Cli>\u003Cstrong>Puerto\u003C/strong>: dejá \u003Cstrong>9100\u003C/strong>, salvo que soporte te diga otro.\u003C/li>\n\u003C/ul>\n\u003Cblockquote>\n\u003Cp>💡 \u003Cstrong>Consejo útil:\u003C/strong> para saber la IP, imprimí la hoja de autotest. En la mayoría de los modelos apagás la impresora, mantenés apretado \u003Cstrong>FEED\u003C/strong> y la prendés. La IP tiene que empezar con los mismos tres números que la de tu computadora.\u003C/p>\n\u003C/blockquote>\n\u003Cp>Con \u003Cstrong>Impresora instalada en Windows\u003C/strong> aparece \u003Cstrong>Nombre de la impresora\u003C/strong>. Escribilo igual que en Windows.\u003C/p>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                💾 \u003Cstrong>Paso 5: Guardá y probá\u003C/strong>\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-5-guarda-y-proba\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-5-guarda-y-proba\">\u003C/div>\n\n\u003Col>\n\u003Cli>Tocá \u003Cstrong>Agregar\u003C/strong>. La ventanita se cierra y la impresora aparece en la lista.\u003C/li>\n\u003Cli>En su tarjeta, tocá \u003Cstrong>Test de impresión\u003C/strong>. Tiene que salir un ticket.\u003C/li>\n\u003C/ol>\n\u003Cp>Para cambiar algo después, tocá \u003Cstrong>Editar\u003C/strong> en la tarjeta. Se abre la misma ventanita con los datos cargados.\u003C/p>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🍕 \u003Cstrong>Paso 6: Elegí la impresora en cada producto\u003C/strong>\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-6-elegi-la-impresora-en-cada-producto\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-6-elegi-la-impresora-en-cada-producto\">\u003C/div>\n\n\u003Cp>Para que la bebida salga en la barra y la comida en la cocina, al cargar cada producto tildá la impresora en \u003Cstrong>¿Dónde se imprime la comanda?\u003C/strong>.\u003C/p>\n\u003Cp>Ver cómo: \u003Ca href=\"/user-guide/menu\">Menú de Productos\u003C/a>.\u003C/p>\n\u003Cblockquote>\n\u003Cp>💡 \u003Cstrong>Consejo útil:\u003C/strong> en \u003Ca href=\"/user-guide/configuracion-general#impresion\">Configuración general\u003C/a>, sección \u003Cstrong>Impresión\u003C/strong>, tiene que estar elegido el \u003Cstrong>Servidor de impresión\u003C/strong> de tu local. Si querés armar distintos juegos de impresoras, mirá \u003Ca href=\"/user-guide/perfiles-de-impresion\">Perfiles de Impresión\u003C/a>.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                ⚠️ \u003Cstrong>Resolución de Inconvenientes\u003C/strong>\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"resolucion-de-inconvenientes\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"resolucion-de-inconvenientes\">\u003C/div>\n\n\u003Cdiv class=\"table-wrapper\">\u003Ctable>\n\u003Cthead>\n\u003Ctr>\n\u003Cth>Problema\u003C/th>\n\u003Cth>Causa más frecuente\u003C/th>\n\u003Cth>Solución recomendada\u003C/th>\n\u003C/tr>\n\u003C/thead>\n\u003Ctbody>\u003Ctr>\n\u003Ctd>No imprime nada, en ninguna impresora.\u003C/td>\n\u003Ctd>\u003Cstrong>Fiscalberry\u003C/strong> está cerrado.\u003C/td>\n\u003Ctd>Abrilo en la computadora del local y dejalo siempre abierto.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>El test no sale en una impresora \u003Cstrong>USB\u003C/strong>.\u003C/td>\n\u003Ctd>Falta el driver o el \u003Cstrong>Nombre de la impresora\u003C/strong> no es igual al de Windows.\u003C/td>\n\u003Ctd>Instalá el driver de la \u003Ca href=\"/user-guide/biblioteca-de-drivers\">Biblioteca de Drivers\u003C/a> y copiá el nombre exacto.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>El test no sale en una impresora \u003Cstrong>de red\u003C/strong>.\u003C/td>\n\u003Ctd>La IP está mal o no está en la misma red.\u003C/td>\n\u003Ctd>Imprimí la hoja de autotest, revisá la IP y comparala con la de la computadora.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>El texto sale cortado.\u003C/td>\n\u003Ctd>El \u003Cstrong>Ancho de papel\u003C/strong> no coincide con el rollo.\u003C/td>\n\u003Ctd>Tocá \u003Cstrong>Editar\u003C/strong> y elegí el ancho correcto.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>En \u003Cstrong>Paxaprinter\u003C/strong> aparece el mío con un círculo rojo.\u003C/td>\n\u003Ctd>Ese Fiscalberry está apagado o sin internet.\u003C/td>\n\u003Ctd>Abrilo en su computadora y esperá unos segundos.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>No veo el casillero \u003Cstrong>Alias\u003C/strong>.\u003C/td>\n\u003Ctd>Solo lo ven Dueños y Administradores.\u003C/td>\n\u003Ctd>Pedile a un Dueño que lo cargue.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>La tarjeta dice \u003Cem>Paxaprinter #N no encontrada (eliminada)\u003C/em>.\u003C/td>\n\u003Ctd>El Fiscalberry se eliminó.\u003C/td>\n\u003Ctd>Tocá \u003Cstrong>Editar\u003C/strong> y elegí otro \u003Cstrong>Paxaprinter\u003C/strong>.\u003C/td>\n\u003C/tr>\n\u003C/tbody>\u003C/table>\u003C/div>\n",[5,9,12,15,18,21,24,27],{"id":6,"title":7,"level":8},"antes-de-empezar","Antes de empezar",2,{"id":10,"title":11,"level":8},"paso-1-entra-a-impresoras","Paso 1: Entrá a Impresoras",{"id":13,"title":14,"level":8},"paso-2-conoce-la-tarjeta-de-cada-impresora","Paso 2: Conocé la tarjeta de cada impresora",{"id":16,"title":17,"level":8},"paso-3-toca-nueva-impresora","Paso 3: Tocá \"Nueva Impresora\"",{"id":19,"title":20,"level":8},"paso-4-completa-los-datos","Paso 4: Completá los datos",{"id":22,"title":23,"level":8},"paso-5-guarda-y-proba","Paso 5: Guardá y probá",{"id":25,"title":26,"level":8},"paso-6-elegi-la-impresora-en-cada-producto","Paso 6: Elegí la impresora en cada producto",{"id":28,"title":29,"level":8},"resolucion-de-inconvenientes","Resolución de Inconvenientes",{"title":31,"description":32,"keywords":33},"Cómo cargar las impresoras del local - Manual","¿Dónde está en el sistema?: Menú principal → Configuración → debajo del título Impresoras → Impresoras\n ¿Quién lo usa?: Dueños, Admini...","impresoras, paxapos, cómo cargar las impresoras del local, tutorial, guía, manual usuario","120-impresoras.txt"],"uses":{"params":["slug"]}}]}
