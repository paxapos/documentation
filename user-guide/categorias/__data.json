{"type":"data","nodes":[null,{"type":"data","data":[{"moduleCategories":1},[2,17,44,53,77,98,110,140,146,173,185,221,250],{"title":3,"modules":4},"Comenzamos",[5,8,11,14],{"slug":6,"title":7},"introduccion","Bienvenido a tu software gastronómico",{"slug":9,"title":10},"iniciar-sesion","Cómo Iniciar Sesión",{"slug":12,"title":13},"recuperar-contrasena","Cómo Recuperar tu Contraseña",{"slug":15,"title":16},"guia-de-inicio-rapido","Guía de Inicio Rápido",{"title":18,"modules":19},"Ventas",[20,23,26,29,32,35,38,41],{"slug":21,"title":22},"salon-de-ventas","Cómo Usar el Salón de Ventas (Adición)",{"slug":24,"title":25},"caja-rapida","Cómo Usar la Caja Rápida (Registradora)",{"slug":27,"title":28},"mozos","Cómo Cargar los Mozos",{"slug":30,"title":31},"clientes","Cómo Gestionar los Clientes",{"slug":33,"title":34},"descuentos","Cómo Configurar Descuentos",{"slug":36,"title":37},"nueva-reserva","Cómo Cargar una Nueva Reserva",{"slug":39,"title":40},"listado-de-reservas","Cómo Usar el Listado de Reservas",{"slug":42,"title":43},"grilla-de-reservas","Cómo Usar la Grilla de Reservas",{"title":45,"modules":46},"Medios de Pago",[47,50],{"slug":48,"title":49},"configuracion-procesadores","Configuración de Procesadores de Pago",{"slug":51,"title":52},"transacciones-mercadopago","Transacciones MercadoPago",{"title":54,"modules":55},"Productos",[56,59,62,65,68,71,74],{"slug":57,"title":58},"menu","Menú de Productos (Carta)",{"slug":60,"title":61},"categorias","Categorías de Productos",{"slug":63,"title":64},"variantes-grupo-sabores","Variantes y Grupos de Sabores",{"slug":66,"title":67},"maestro-de-productos","Maestro de Productos",{"slug":69,"title":70},"subproductos-elaborados","Sub-Productos (Elaborados)",{"slug":72,"title":73},"recetas","Recetas",{"slug":75,"title":76},"analisis-duplicados","Buscar Duplicados",{"title":78,"modules":79},"Compras",[80,83,86,89,92,95],{"slug":81,"title":82},"todas-las-ordenes-compra","Órdenes de Compra",{"slug":84,"title":85},"crear-orden-compra","Crear una Orden de Compra",{"slug":87,"title":88},"ordenes-a-aprobar","Órdenes a aprobar",{"slug":90,"title":91},"mercaderias","Mercaderías",{"slug":93,"title":94},"proveedores","Proveedores",{"slug":96,"title":97},"historial-de-compras","Historial de Compras",{"title":99,"modules":100},"Stock",[101,104,107],{"slug":102,"title":103},"stock-mercaderias","Stock de Mercaderías",{"slug":105,"title":106},"stock-subproductos","Stock de Subproductos",{"slug":108,"title":109},"movimientos-de-stock","Movimientos de Stock",{"title":111,"modules":112},"Finanzas",[113,116,119,122,125,128,131,134,137],{"slug":114,"title":115},"arqueos-de-caja","Arqueos de Caja",{"slug":117,"title":118},"listado-de-cajas","Listado de Cajas",{"slug":120,"title":121},"transacciones-de-cobro","Transacciones de Cobro",{"slug":123,"title":124},"factura-manual","Factura Manual",{"slug":126,"title":127},"resumen-de-deuda","Resumen de Deuda",{"slug":129,"title":130},"pagos","Pagos",{"slug":132,"title":133},"historial-de-facturas","Historial de Facturas",{"slug":135,"title":136},"historico-de-mesas","Histórico de Mesas",{"slug":138,"title":139},"puntos-de-venta-pdv","Puntos de Venta (PDVs)",{"title":141,"modules":142},"Comandero",[143],{"slug":144,"title":145},"comandero","Comandero (pantalla de cocina)",{"title":147,"modules":148},"RRHH",[149,152,155,158,161,164,167,170],{"slug":150,"title":151},"empleados","Empleados",{"slug":153,"title":154},"empleados-trabajando","Empleados Trabajando",{"slug":156,"title":157},"registro-diario-fichaje","Registro Diario de Fichaje",{"slug":159,"title":160},"reporte-mensual-fichaje","Reporte Mensual de Fichaje",{"slug":162,"title":163},"departamentos","Departamentos",{"slug":165,"title":166},"turnos-y-horarios-fichaje","Turnos y Horarios de Fichaje",{"slug":168,"title":169},"sueldos-y-jornales","Sueldos y Jornales",{"slug":171,"title":172},"datos-de-acceso-app","Datos de Acceso a la App de Fichaje",{"title":174,"modules":175},"Reportes",[176,179,182],{"slug":177,"title":178},"tablero-general","Tablero General",{"slug":180,"title":181},"productos-mas-vendidos","Productos Más Vendidos",{"slug":183,"title":184},"compras-por-mercaderia","Compras por Mercadería",{"title":186,"modules":187},"Configuracion",[188,191,194,197,200,203,206,209,212,215,218],{"slug":189,"title":190},"configuracion-general","Configuración general",{"slug":192,"title":193},"impresoras","Cómo cargar las impresoras del local",{"slug":195,"title":196},"perfiles-de-impresion","Cómo usar los perfiles de impresión",{"slug":198,"title":199},"usuarios-del-sistema","Cómo administrar los Usuarios del Sistema",{"slug":201,"title":202},"usuarios-con-pin","Cómo administrar los Usuarios con PIN",{"slug":204,"title":205},"punto-de-venta","🏛️ Trámite en ARCA (con clave fiscal)",{"slug":207,"title":208},"permisos-por-rol","Cómo configurar los Permisos por Rol",{"slug":210,"title":211},"turnos-mesa","Turnos de Mesa",{"slug":213,"title":214},"medios-de-cobro","Medios de cobro",{"slug":216,"title":217},"clasificacion-de-gastos","Clasificación de Gastos",{"slug":219,"title":220},"centros-de-costo","Centros de Costo",{"title":222,"modules":223},"Biblioteca de Drivers",[224,226,229,232,235,238,241,244,247],{"slug":225,"title":222},"biblioteca-de-drivers",{"slug":227,"title":228},"sam4s-giant-100","Sam4S Giant - 100",{"slug":230,"title":231},"citizen-ct-s310ii","Citizen CT-S310II",{"slug":233,"title":234},"epson-tm-t20","Epson TM-T20",{"slug":236,"title":237},"drivers-genericos","Drivers Genéricos POS",{"slug":239,"title":240},"epson-tm-t88","Epson TM-T88V",{"slug":242,"title":243},"fiscalberry-windows","Instalar Fiscalberry en Windows",{"slug":245,"title":246},"fiscalberry-linux","Instalar Fiscalberry en Linux",{"slug":248,"title":249},"fiscalberry-android","Instalar Fiscalberry en Android",{"title":251,"modules":252},"Extra",[253,256,259,262,265,268,271,274,277,280],{"slug":254,"title":255},"01-faq-solucion-inicial-pantalla-congelada","📖 Manual de Usuario: Solución Inicial si la Pantalla se Congela o no Carga",{"slug":257,"title":258},"03-faq-mozo-reabrir-mesa-anulada","📖 Manual de Usuario: Cómo Reabrir una Mesa Anulada o Cerrada por Error",{"slug":260,"title":261},"05-faq-cajero-emitir-factura-a","📖 Manual de Usuario: Cómo Emitir una Factura A Cargando Datos del Cliente",{"slug":263,"title":264},"06-faq-cajero-ingreso-egreso-cajon","📖 Manual de Usuario: Cómo Registrar Entradas y Salidas de Dinero del Cajón",{"slug":266,"title":267},"07-faq-cajero-activar-medio-pago","📖 Manual de Usuario: Cómo Activar un Medio de Pago que no Aparece al Cobrar",{"slug":269,"title":270},"08-faq-cajero-diferencia-facturado-vs-abiertas","📖 Manual de Usuario: Diferencia entre \"Facturado Total Mesas\" y \"Abiertas Por Usuario\" en Caja",{"slug":272,"title":273},"10-faq-supervisor-cierre-caja-diferencias","📖 Manual de Usuario: Cómo Auditar y Solucionar Diferencias en el Cierre de Caja",{"slug":275,"title":276},"preguntas-frecuentes","Preguntas Frecuentes y Guías Rápidas por Rol",{"slug":278,"title":279},"buchon-bot","Buchón Bot",{"slug":281,"title":282},"troubleshooting-semantico","📖 Guía Única de Resolución de Problemas y Errores (Troubleshooting)"],"uses":{}},{"type":"data","data":[{"slug":1,"title":2,"content":3,"tableOfContents":4,"seo":36,"llmTxtFile":40},"categorias","Categorías de Productos","\u003Cdiv id=\"categorias-de-productos\">\u003C/div>\n\n\u003Cblockquote>\n\u003Cp>\u003Cstrong>¿Dónde está en el sistema?:\u003C/strong> Menú principal → \u003Cstrong>Productos\u003C/strong> → \u003Cstrong>Categorías\u003C/strong>\n\u003Cstrong>¿Quién lo usa?:\u003C/strong> Encargados y administradores\u003C/p>\n\u003C/blockquote>\n\u003Cblockquote>\n\u003Cp>🎯 \u003Cstrong>¿Para qué sirve esto?\u003C/strong>\nLas categorías agrupan los productos de tu menú. Por ejemplo: \u003Cem>Bebidas\u003C/em>, \u003Cem>Pizzas\u003C/em> o \u003Cem>Postres\u003C/em>.\nAsí los mozos encuentran rápido cada producto, y tus clientes ven el menú online ordenado.\u003C/p>\n\u003C/blockquote>\n\u003Cblockquote>\n\u003Cp>🧭 \u003Cstrong>Primeros pasos para armar tu menú:\u003C/strong>\u003C/p>\n\u003Col>\n\u003Cli>Creá las \u003Cstrong>categorías\u003C/strong> (esta guía) y las \u003Ca href=\"/user-guide/variantes-grupo-sabores\">Variantes\u003C/a>. No importa el orden.\u003C/li>\n\u003Cli>Cargá los productos en el \u003Ca href=\"/user-guide/menu\">Menú\u003C/a>.\u003C/li>\n\u003C/ol>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🔑 Antes de empezar\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"antes-de-empezar\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"antes-de-empezar\">\u003C/div>\n\n\u003Cul>\n\u003Cli>Tu usuario tiene que tener el permiso de \u003Cstrong>Categorías de Productos\u003C/strong> en \u003Ca href=\"/user-guide/permisos-por-rol\">Permisos por Rol\u003C/a>.\u003C/li>\n\u003C/ul>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                📍 Paso 1: Entrá a la pantalla\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-1-entra-a-la-pantalla\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-1-entra-a-la-pantalla\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/42-00a-menu-grupo-productos.png\" alt=\"Menú lateral con el grupo Productos marcado en rojo\">\u003C/p>\n\u003Col>\n\u003Cli>En el menú de la izquierda, tocá \u003Cstrong>Productos\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/42-00b-menu-opcion-categorias.png\" alt=\"Opción Categorías marcada en rojo en el menú lateral\">\u003C/p>\n\u003Col start=\"2\">\n\u003Cli>Tocá \u003Cstrong>Categorías\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/42-01-pantalla-index.png\" alt=\"Pantalla Categorías del Menú con la lista de categorías\">\u003C/p>\n\u003Cp>Así se ve la pantalla. Arriba están los botones. Abajo, la lista de tus categorías.\u003C/p>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                ➕ Paso 2: Creá una categoría\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-2-crea-una-categoria\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-2-crea-una-categoria\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/42-06-donde-esta-boton-nueva-categoria.png\" alt=\"Pantalla con el botón azul Nueva Categoría marcado en rojo\">\u003C/p>\n\u003Col>\n\u003Cli>Tocá el botón azul \u003Cstrong>Nueva Categoría\u003C/strong>. Está arriba a la izquierda.\u003C/li>\n\u003Cli>Se abre el formulario.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/42-30-pantalla-nueva-categoria.png\" alt=\"Formulario Nueva Categoría completo con la categoría Bebidas\">\u003C/p>\n\u003Col start=\"3\">\n\u003Cli>En \u003Cstrong>Nombre de la Categoría\u003C/strong>, escribí el nombre. Por ejemplo: \u003Cem>Bebidas\u003C/em>.\u003C/li>\n\u003Cli>En \u003Cstrong>Descripción (opcional)\u003C/strong> podés escribir un texto corto. Se ve en el menú online.\u003C/li>\n\u003Cli>En \u003Cstrong>Orden de visualización\u003C/strong>, poné un número. El número más chico aparece primero.\u003C/li>\n\u003Cli>Marcá \u003Cstrong>Categoría privada\u003C/strong> solo si no querés que los clientes la vean en el menú online.\u003C/li>\n\u003Cli>Si querés, tocá \u003Cstrong>Choose File\u003C/strong> (o \u003Cstrong>Elegir archivo\u003C/strong>) y elegí una foto de la categoría.\u003C/li>\n\u003Cli>Tocá un cuadrito de color. Sirve para reconocer la categoría más rápido.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/42-20-donde-esta-boton-crear-categoria.png\" alt=\"Formulario con el botón verde Crear Categoría marcado en rojo\">\u003C/p>\n\u003Col start=\"9\">\n\u003Cli>Tocá el botón verde \u003Cstrong>Crear Categoría\u003C/strong>.\u003C/li>\n\u003Cli>Volvés a la lista, con la categoría nueva.\u003C/li>\n\u003C/ol>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🗂️ Paso 3: Creá una subcategoría (opcional)\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-3-crea-una-subcategoria-opcional\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-3-crea-una-subcategoria-opcional\">\u003C/div>\n\n\u003Cp>Una subcategoría va dentro de otra. Por ejemplo: \u003Cem>Cervezas\u003C/em> dentro de \u003Cem>Bebidas\u003C/em>.\u003C/p>\n\u003Col>\n\u003Cli>Tocá \u003Cstrong>Nueva Categoría\u003C/strong> y escribí el nombre. Por ejemplo: \u003Cem>Cervezas\u003C/em>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/42-14-campo-categoria-padre.png\" alt=\"Casillero Categoría Padre con Bebidas elegida\">\u003C/p>\n\u003Col start=\"2\">\n\u003Cli>En \u003Cstrong>Categoría Padre\u003C/strong>, elegí la categoría de arriba. Por ejemplo: \u003Cem>Bebidas\u003C/em>.\u003C/li>\n\u003Cli>Tocá \u003Cstrong>Crear Categoría\u003C/strong>.\u003C/li>\n\u003Cli>En la lista, \u003Cem>Cervezas\u003C/em> aparece debajo de \u003Cem>Bebidas\u003C/em>, un poco corrida a la derecha.\u003C/li>\n\u003C/ol>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🔎 Paso 4: Buscá una categoría\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-4-busca-una-categoria\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-4-busca-una-categoria\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/42-08-campo-name.png\" alt=\"Casillero Buscar categoría con la palabra Sandw escrita\">\u003C/p>\n\u003Col>\n\u003Cli>En el casillero \u003Cstrong>Buscar categoría...\u003C/strong>, escribí parte del nombre. Por ejemplo: \u003Cem>Sandw\u003C/em>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/42-09-donde-esta-boton-buscar.png\" alt=\"Pantalla con el botón azul Buscar marcado en rojo\">\u003C/p>\n\u003Col start=\"2\">\n\u003Cli>Tocá el botón azul \u003Cstrong>Buscar\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/42-31-resultado-busqueda.png\" alt=\"Lista con las dos categorías que empiezan con Sandw\">\u003C/p>\n\u003Col start=\"3\">\n\u003Cli>La lista muestra solo las categorías que coinciden.\u003C/li>\n\u003C/ol>\n\u003Cblockquote>\n\u003Cp>⚠️ \u003Cstrong>Atención:\u003C/strong> si la búsqueda encuentra \u003Cstrong>una sola\u003C/strong> categoría, la pantalla dice \u003Cem>&quot;Empezá a organizar tu menú&quot;\u003C/em> como si no hubiera ninguna. Escribí menos letras para que aparezcan varias.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                ✏️ Paso 5: Cambiá una categoría\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-5-cambia-una-categoria\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-5-cambia-una-categoria\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/42-32-fila-categoria.png\" alt=\"Renglón de la categoría Bebidas con el lápiz y el tacho a la derecha\">\u003C/p>\n\u003Cp>Cada renglón muestra el nombre, cuántos productos tiene y si se ve en el menú online.\u003C/p>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/42-11-donde-esta-boton-editar.png\" alt=\"Lista de categorías con el lápiz de Bebidas marcado en rojo\">\u003C/p>\n\u003Col>\n\u003Cli>Pasá el mouse por el renglón de la categoría. A la derecha aparecen un lápiz y un tacho.\u003C/li>\n\u003Cli>Tocá el lápiz ✏️.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/42-33-pantalla-editar-categoria.png\" alt=\"Formulario Editar Categoría Bebidas\">\u003C/p>\n\u003Col start=\"3\">\n\u003Cli>Se abre el formulario con los datos de la categoría. Cambiá lo que necesites.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/42-22-donde-esta-boton-guardar-cambios.png\" alt=\"Formulario con el botón azul Guardar Cambios marcado en rojo\">\u003C/p>\n\u003Col start=\"4\">\n\u003Cli>Tocá el botón azul \u003Cstrong>Guardar Cambios\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🗑️ Paso 6: Borrá una categoría\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-6-borra-una-categoria\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-6-borra-una-categoria\">\u003C/div>\n\n\u003Cblockquote>\n\u003Cp>⚠️ \u003Cstrong>Atención:\u003C/strong> borrar una categoría no se puede deshacer. Antes, pasá sus productos a otra categoría.\u003C/p>\n\u003C/blockquote>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/42-28-donde-esta-boton-eliminar.png\" alt=\"Lista de categorías con el tacho de Bebidas marcado en rojo\">\u003C/p>\n\u003Col>\n\u003Cli>Pasá el mouse por el renglón y tocá el tacho 🗑️.\u003C/li>\n\u003Cli>El sistema te pregunta si estás seguro. Tocá \u003Cstrong>Aceptar\u003C/strong> para borrarla.\u003C/li>\n\u003C/ol>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                ↕️ Paso 7: Cambiá el orden de las categorías\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-7-cambia-el-orden-de-las-categorias\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-7-cambia-el-orden-de-las-categorias\">\u003C/div>\n\n\u003Col>\n\u003Cli>En la lista, agarrá una categoría con las tres rayitas \u003Cstrong>≡\u003C/strong> de la izquierda.\u003C/li>\n\u003Cli>Arrastrala hasta el lugar que quieras y soltala.\u003C/li>\n\u003Cli>El sistema dice \u003Cem>&quot;¡Guardado!&quot;\u003C/em> y recarga la lista.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/42-02-donde-esta-boton-ordenar-a-z.png\" alt=\"Pantalla con el botón Ordenar A-Z marcado en rojo\">\u003C/p>\n\u003Col start=\"4\">\n\u003Cli>Si preferís el orden alfabético, tocá \u003Cstrong>Ordenar A-Z\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cblockquote>\n\u003Cp>⚠️ \u003Cstrong>Atención:\u003C/strong> \u003Cstrong>Ordenar A-Z\u003C/strong> cambia el orden de \u003Cstrong>todas\u003C/strong> las categorías de una vez. El orden que armaste a mano se pierde.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🔧 Paso 8: Arreglá la lista si se ve mal (opcional)\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-8-arregla-la-lista-si-se-ve-mal-opcional\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-8-arregla-la-lista-si-se-ve-mal-opcional\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/42-04-donde-esta-boton-reparar-arbol.png\" alt=\"Pantalla con el botón Reparar árbol marcado en rojo\">\u003C/p>\n\u003Col>\n\u003Cli>Si las subcategorías aparecen en un lugar raro, tocá \u003Cstrong>Reparar árbol\u003C/strong>.\u003C/li>\n\u003Cli>El sistema acomoda cada categoría debajo de la que le corresponde.\u003C/li>\n\u003C/ol>\n\u003Cblockquote>\n\u003Cp>💡 \u003Cstrong>Consejo útil:\u003C/strong> usalo solo si ves la lista rota. Si la lista se ve bien, no hace falta.\u003C/p>\n\u003C/blockquote>\n\u003Cblockquote>\n\u003Cp>➡️ \u003Cstrong>Siguiente paso:\u003C/strong> creá las \u003Ca href=\"/user-guide/variantes-grupo-sabores\">Variantes\u003C/a> si tus productos las necesitan. Después \u003Ca href=\"/user-guide/menu\">cargá los productos en el menú\u003C/a>.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                ⚠️ Resolución de Inconvenientes\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"resolucion-de-inconvenientes\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"resolucion-de-inconvenientes\">\u003C/div>\n\n\u003Cdiv class=\"table-wrapper\">\u003Ctable>\n\u003Cthead>\n\u003Ctr>\n\u003Cth>Problema\u003C/th>\n\u003Cth>Causa más frecuente\u003C/th>\n\u003Cth>Solución recomendada\u003C/th>\n\u003C/tr>\n\u003C/thead>\n\u003Ctbody>\u003Ctr>\n\u003Ctd>\u003Cstrong>No aparece Categorías en el menú\u003C/strong>\u003C/td>\n\u003Ctd>Tu usuario no tiene el permiso de categorías.\u003C/td>\n\u003Ctd>Pedile al dueño que lo active en \u003Ca href=\"/user-guide/permisos-por-rol\">Permisos por Rol\u003C/a>.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>Busqué y dice &quot;Empezá a organizar tu menú&quot;\u003C/strong>\u003C/td>\n\u003Ctd>La búsqueda encontró una sola categoría.\u003C/td>\n\u003Ctd>Escribí menos letras, o buscala mirando la lista completa.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>No puedo borrar una categoría\u003C/strong>\u003C/td>\n\u003Ctd>Tiene productos adentro.\u003C/td>\n\u003Ctd>Pasá esos productos a otra categoría y probá de nuevo.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>La categoría no se ve en el menú online\u003C/strong>\u003C/td>\n\u003Ctd>Está marcada como \u003Cstrong>Categoría privada\u003C/strong>.\u003C/td>\n\u003Ctd>Tocá el lápiz, desmarcá \u003Cstrong>Categoría privada\u003C/strong> y tocá \u003Cstrong>Guardar Cambios\u003C/strong>.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>Las subcategorías se ven desordenadas\u003C/strong>\u003C/td>\n\u003Ctd>La lista quedó con errores.\u003C/td>\n\u003Ctd>Tocá \u003Cstrong>Reparar árbol\u003C/strong>, arriba a la derecha.\u003C/td>\n\u003C/tr>\n\u003C/tbody>\u003C/table>\u003C/div>\n",[5,9,12,15,18,21,24,27,30,33],{"id":6,"title":7,"level":8},"antes-de-empezar","Antes de empezar",2,{"id":10,"title":11,"level":8},"paso-1-entra-a-la-pantalla","Paso 1: Entrá a la pantalla",{"id":13,"title":14,"level":8},"paso-2-crea-una-categoria","Paso 2: Creá una categoría",{"id":16,"title":17,"level":8},"paso-3-crea-una-subcategoria-opcional","Paso 3: Creá una subcategoría (opcional)",{"id":19,"title":20,"level":8},"paso-4-busca-una-categoria","Paso 4: Buscá una categoría",{"id":22,"title":23,"level":8},"paso-5-cambia-una-categoria","Paso 5: Cambiá una categoría",{"id":25,"title":26,"level":8},"paso-6-borra-una-categoria","Paso 6: Borrá una categoría",{"id":28,"title":29,"level":8},"paso-7-cambia-el-orden-de-las-categorias","Paso 7: Cambiá el orden de las categorías",{"id":31,"title":32,"level":8},"paso-8-arregla-la-lista-si-se-ve-mal-opcional","Paso 8: Arreglá la lista si se ve mal (opcional)",{"id":34,"title":35,"level":8},"resolucion-de-inconvenientes","Resolución de Inconvenientes",{"title":37,"description":38,"keywords":39},"Categorías de Productos - Manual","¿Dónde está en el sistema?: Menú principal → Productos → Categorías\n ¿Quién lo usa?: Encargados y administradores","categorias, paxapos, categorías de productos, tutorial, guía, manual usuario","42-categorias.txt"],"uses":{"params":["slug"]}}]}
