{"type":"data","nodes":[null,{"type":"data","data":[{"moduleCategories":1},[2,17,44,53,77,98,110,140,146,173,185,221,250],{"title":3,"modules":4},"Comenzamos",[5,8,11,14],{"slug":6,"title":7},"introduccion","Bienvenido a tu software gastronómico",{"slug":9,"title":10},"iniciar-sesion","Cómo Iniciar Sesión",{"slug":12,"title":13},"recuperar-contrasena","Cómo Recuperar tu Contraseña",{"slug":15,"title":16},"guia-de-inicio-rapido","Guía de Inicio Rápido",{"title":18,"modules":19},"Ventas",[20,23,26,29,32,35,38,41],{"slug":21,"title":22},"salon-de-ventas","Cómo Usar el Salón de Ventas (Adición)",{"slug":24,"title":25},"caja-rapida","Cómo Usar la Caja Rápida (Registradora)",{"slug":27,"title":28},"mozos","Cómo Cargar los Mozos",{"slug":30,"title":31},"clientes","Cómo Gestionar los Clientes",{"slug":33,"title":34},"descuentos","Cómo Configurar Descuentos",{"slug":36,"title":37},"nueva-reserva","Cómo Cargar una Nueva Reserva",{"slug":39,"title":40},"listado-de-reservas","Cómo Usar el Listado de Reservas",{"slug":42,"title":43},"grilla-de-reservas","Cómo Usar la Grilla de Reservas",{"title":45,"modules":46},"Medios de Pago",[47,50],{"slug":48,"title":49},"configuracion-procesadores","Configuración de Procesadores de Pago",{"slug":51,"title":52},"transacciones-mercadopago","Transacciones MercadoPago",{"title":54,"modules":55},"Productos",[56,59,62,65,68,71,74],{"slug":57,"title":58},"menu","Menú de Productos (Carta)",{"slug":60,"title":61},"categorias","Categorías de Productos",{"slug":63,"title":64},"variantes-grupo-sabores","Variantes y Grupos de Sabores",{"slug":66,"title":67},"maestro-de-productos","Maestro de Productos",{"slug":69,"title":70},"subproductos-elaborados","Sub-Productos (Elaborados)",{"slug":72,"title":73},"recetas","Recetas",{"slug":75,"title":76},"analisis-duplicados","Buscar Duplicados",{"title":78,"modules":79},"Compras",[80,83,86,89,92,95],{"slug":81,"title":82},"todas-las-ordenes-compra","Órdenes de Compra",{"slug":84,"title":85},"crear-orden-compra","Crear una Orden de Compra",{"slug":87,"title":88},"ordenes-a-aprobar","Órdenes a aprobar",{"slug":90,"title":91},"mercaderias","Mercaderías",{"slug":93,"title":94},"proveedores","Proveedores",{"slug":96,"title":97},"historial-de-compras","Historial de Compras",{"title":99,"modules":100},"Stock",[101,104,107],{"slug":102,"title":103},"stock-mercaderias","Stock de Mercaderías",{"slug":105,"title":106},"stock-subproductos","Stock de Subproductos",{"slug":108,"title":109},"movimientos-de-stock","Movimientos de Stock",{"title":111,"modules":112},"Finanzas",[113,116,119,122,125,128,131,134,137],{"slug":114,"title":115},"arqueos-de-caja","Arqueos de Caja",{"slug":117,"title":118},"listado-de-cajas","Listado de Cajas",{"slug":120,"title":121},"transacciones-de-cobro","Transacciones de Cobro",{"slug":123,"title":124},"factura-manual","Factura Manual",{"slug":126,"title":127},"resumen-de-deuda","Resumen de Deuda",{"slug":129,"title":130},"pagos","Pagos",{"slug":132,"title":133},"historial-de-facturas","Historial de Facturas",{"slug":135,"title":136},"historico-de-mesas","Histórico de Mesas",{"slug":138,"title":139},"puntos-de-venta-pdv","Puntos de Venta (PDVs)",{"title":141,"modules":142},"Comandero",[143],{"slug":144,"title":145},"comandero","Comandero (pantalla de cocina)",{"title":147,"modules":148},"RRHH",[149,152,155,158,161,164,167,170],{"slug":150,"title":151},"empleados","Empleados",{"slug":153,"title":154},"empleados-trabajando","Empleados Trabajando",{"slug":156,"title":157},"registro-diario-fichaje","Registro Diario de Fichaje",{"slug":159,"title":160},"reporte-mensual-fichaje","Reporte Mensual de Fichaje",{"slug":162,"title":163},"departamentos","Departamentos",{"slug":165,"title":166},"turnos-y-horarios-fichaje","Turnos y Horarios de Fichaje",{"slug":168,"title":169},"sueldos-y-jornales","Sueldos y Jornales",{"slug":171,"title":172},"datos-de-acceso-app","Datos de Acceso a la App de Fichaje",{"title":174,"modules":175},"Reportes",[176,179,182],{"slug":177,"title":178},"tablero-general","Tablero General",{"slug":180,"title":181},"productos-mas-vendidos","Productos Más Vendidos",{"slug":183,"title":184},"compras-por-mercaderia","Compras por Mercadería",{"title":186,"modules":187},"Configuracion",[188,191,194,197,200,203,206,209,212,215,218],{"slug":189,"title":190},"configuracion-general","Configuración general",{"slug":192,"title":193},"impresoras","Cómo cargar las impresoras del local",{"slug":195,"title":196},"perfiles-de-impresion","Cómo usar los perfiles de impresión",{"slug":198,"title":199},"usuarios-del-sistema","Cómo administrar los Usuarios del Sistema",{"slug":201,"title":202},"usuarios-con-pin","Cómo administrar los Usuarios con PIN",{"slug":204,"title":205},"punto-de-venta","🏛️ Trámite en ARCA (con clave fiscal)",{"slug":207,"title":208},"permisos-por-rol","Cómo configurar los Permisos por Rol",{"slug":210,"title":211},"turnos-mesa","Turnos de Mesa",{"slug":213,"title":214},"medios-de-cobro","Medios de cobro",{"slug":216,"title":217},"clasificacion-de-gastos","Clasificación de Gastos",{"slug":219,"title":220},"centros-de-costo","Centros de Costo",{"title":222,"modules":223},"Biblioteca de Drivers",[224,226,229,232,235,238,241,244,247],{"slug":225,"title":222},"biblioteca-de-drivers",{"slug":227,"title":228},"sam4s-giant-100","Sam4S Giant - 100",{"slug":230,"title":231},"citizen-ct-s310ii","Citizen CT-S310II",{"slug":233,"title":234},"epson-tm-t20","Epson TM-T20",{"slug":236,"title":237},"drivers-genericos","Drivers Genéricos POS",{"slug":239,"title":240},"epson-tm-t88","Epson TM-T88V",{"slug":242,"title":243},"fiscalberry-windows","Instalar Fiscalberry en Windows",{"slug":245,"title":246},"fiscalberry-linux","Instalar Fiscalberry en Linux",{"slug":248,"title":249},"fiscalberry-android","Instalar Fiscalberry en Android",{"title":251,"modules":252},"Extra",[253,256,259,262,265,268,271,274,277,280],{"slug":254,"title":255},"01-faq-solucion-inicial-pantalla-congelada","📖 Manual de Usuario: Solución Inicial si la Pantalla se Congela o no Carga",{"slug":257,"title":258},"03-faq-mozo-reabrir-mesa-anulada","📖 Manual de Usuario: Cómo Reabrir una Mesa Anulada o Cerrada por Error",{"slug":260,"title":261},"05-faq-cajero-emitir-factura-a","📖 Manual de Usuario: Cómo Emitir una Factura A Cargando Datos del Cliente",{"slug":263,"title":264},"06-faq-cajero-ingreso-egreso-cajon","📖 Manual de Usuario: Cómo Registrar Entradas y Salidas de Dinero del Cajón",{"slug":266,"title":267},"07-faq-cajero-activar-medio-pago","📖 Manual de Usuario: Cómo Activar un Medio de Pago que no Aparece al Cobrar",{"slug":269,"title":270},"08-faq-cajero-diferencia-facturado-vs-abiertas","📖 Manual de Usuario: Diferencia entre \"Facturado Total Mesas\" y \"Abiertas Por Usuario\" en Caja",{"slug":272,"title":273},"10-faq-supervisor-cierre-caja-diferencias","📖 Manual de Usuario: Cómo Auditar y Solucionar Diferencias en el Cierre de Caja",{"slug":275,"title":276},"preguntas-frecuentes","Preguntas Frecuentes y Guías Rápidas por Rol",{"slug":278,"title":279},"buchon-bot","Buchón Bot",{"slug":281,"title":282},"troubleshooting-semantico","📖 Guía Única de Resolución de Problemas y Errores (Troubleshooting)"],"uses":{}},{"type":"data","data":[{"slug":1,"title":2,"content":3,"tableOfContents":4,"seo":24,"llmTxtFile":28},"puntos-de-venta-pdv","Puntos de Venta (PDVs)","\u003Cdiv id=\"puntos-de-venta-pdvs\">\u003C/div>\n\n\u003Cblockquote>\n\u003Cp>\u003Cstrong>¿Dónde está en el sistema?:\u003C/strong> Menú principal → \u003Cstrong>Finanzas\u003C/strong> → \u003Cstrong>Facturación AFIP\u003C/strong> → \u003Cstrong>Puntos de Venta (PDVs)\u003C/strong>\n\u003Cstrong>¿Quién lo usa?:\u003C/strong> Dueños, administradores y contadores\u003C/p>\n\u003C/blockquote>\n\u003Cblockquote>\n\u003Cp>🎯 \u003Cstrong>¿Para qué sirve esto?\u003C/strong>\nEl punto de venta es el número que ARCA le da a tu comercio para hacer facturas electrónicas.\nAcá lo cargás en PaxaPOS. Sin un punto de venta cargado, no podés facturar.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🔑 Antes de empezar\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"antes-de-empezar\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"antes-de-empezar\">\u003C/div>\n\n\u003Cul>\n\u003Cli>Tener clave fiscal nivel 3 en ARCA.\u003C/li>\n\u003Cli>Tu usuario tiene que tener el permiso de \u003Cstrong>Facturación AFIP\u003C/strong> en \u003Ca href=\"/user-guide/permisos-por-rol\">Permisos por Rol\u003C/a>.\u003C/li>\n\u003Cli>Crear el punto de venta en ARCA primero. Seguí la guía \u003Ca href=\"/user-guide/configuracion-general#tramite-en-arca\">ARCA y Facturación Electrónica\u003C/a>.\u003C/li>\n\u003Cli>Al terminar en ARCA te dan un PDF con el alta del punto de venta. Guardalo: tiene los datos que vas a cargar.\u003C/li>\n\u003C/ul>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                📍 Paso 1: Entrá a la pantalla\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-1-entra-a-la-pantalla\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-1-entra-a-la-pantalla\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/70-finanzas/83-00a-menu-grupo-finanzas.png\" alt=\"Menú lateral con el grupo Finanzas marcado en rojo\">\u003C/p>\n\u003Col>\n\u003Cli>En el menú de la izquierda, tocá \u003Cstrong>Finanzas\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/70-finanzas/83-00b-menu-opcion-puntos-de-venta.png\" alt=\"Opción Puntos de Venta (PDVs) marcada en rojo, debajo del título Facturación AFIP\">\u003C/p>\n\u003Col start=\"2\">\n\u003Cli>Tocá \u003Cstrong>Puntos de Venta (PDVs)\u003C/strong>. Está debajo del título \u003Cstrong>FACTURACIÓN AFIP\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/70-finanzas/83-01-donde-esta-boton-agregar-punto-de-venta.png\" alt=\"Pantalla Punto de Ventas con la tabla vacía y el botón verde Agregar Punto de Venta marcado en rojo, arriba a la derecha\">\u003C/p>\n\u003Cp>Así se ve la pantalla si todavía no cargaste ninguno: la tabla vacía y, arriba a la derecha, el botón verde \u003Cstrong>Agregar Punto de Venta\u003C/strong>.\u003C/p>\n\u003Cp>Cuando ya hay puntos de venta, cada uno es un renglón. Las columnas dicen:\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Punto de Venta\u003C/strong>: el número.\u003C/li>\n\u003Cli>\u003Cstrong>Nombre\u003C/strong>: el nombre interno que le pusiste.\u003C/li>\n\u003Cli>\u003Cstrong>Cuit\u003C/strong>, \u003Cstrong>Direccion\u003C/strong>, \u003Cstrong>Localidad\u003C/strong>, \u003Cstrong>Provincia\u003C/strong> y \u003Cstrong>Codigo Postal\u003C/strong>.\u003C/li>\n\u003Cli>\u003Cstrong>Habilitado\u003C/strong>: dice \u003Cstrong>Si\u003C/strong> o \u003Cstrong>No\u003C/strong>.\u003C/li>\n\u003Cli>\u003Cstrong>Acciones\u003C/strong>: el link \u003Cstrong>Editar\u003C/strong>.\u003C/li>\n\u003C/ul>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                ➕ Paso 2: Agregá un punto de venta\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-2-agrega-un-punto-de-venta\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-2-agrega-un-punto-de-venta\">\u003C/div>\n\n\u003Col>\n\u003Cli>Tocá \u003Cstrong>Agregar Punto de Venta\u003C/strong>.\u003C/li>\n\u003Cli>Se abre la pantalla \u003Cstrong>Punto de Venta\u003C/strong>. Completala con los datos del PDF de ARCA.\u003C/li>\n\u003C/ol>\n\u003Cblockquote>\n\u003Cp>💡 \u003Cstrong>Consejo útil:\u003C/strong> si el comercio ya tiene sus datos fiscales cargados, algunos casilleros ya vienen completos.\u003C/p>\n\u003C/blockquote>\n\u003Cp>\u003Cimg src=\"/images/manual/70-finanzas/83-02-formulario-parte-1.png\" alt=\"Parte de arriba de la pantalla Punto de Venta: el aviso Relación fiscal y los casilleros Nombre, CUIT, Razón Social, Domicilio Fiscal, Responsabilidad IVA, Nombre Fantasia, Concepto de la Factura, Ingresos brutos y Fecha de inicio de actividades\">\u003C/p>\n\u003Cp>Arriba puede aparecer el aviso rojo \u003Cstrong>Relación fiscal\u003C/strong>. Se explica en el Paso 4.\u003C/p>\n\u003Cp>El primer casillero es el nombre. Después vienen los \u003Cstrong>Datos de la Empresa\u003C/strong>:\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Nombre (solo para uso interno)\u003C/strong>: un nombre para reconocerlo vos. Por ejemplo: \u003Cem>Caja del frente\u003C/em>. No sale en la factura.\u003C/li>\n\u003Cli>\u003Cstrong>CUIT\u003C/strong>: los 11 números, sin guiones. Por ejemplo: \u003Cem>20111111112\u003C/em>.\u003C/li>\n\u003Cli>\u003Cstrong>Razón Social\u003C/strong>: el nombre legal del comercio, como figura en ARCA.\u003C/li>\n\u003Cli>\u003Cstrong>Domicilio Fiscal\u003C/strong>: el domicilio fiscal, como figura en ARCA.\u003C/li>\n\u003Cli>\u003Cstrong>Responsabilidad IVA\u003C/strong>: tu condición frente al IVA. Si ya está cargada en los datos del comercio, aparece gris y no se cambia acá. Mirá \u003Ca href=\"/user-guide/configuracion-general#fiscal-y-arca\">Información Fiscal del Comercio\u003C/a>.\u003C/li>\n\u003Cli>\u003Cstrong>Nombre Fantasia\u003C/strong>: el nombre de fantasía que figura en el PDF.\u003C/li>\n\u003Cli>\u003Cstrong>Concepto de la Factura\u003C/strong>: \u003Cstrong>Productos\u003C/strong>, \u003Cstrong>Servicios\u003C/strong>, \u003Cstrong>Productos y Servicios\u003C/strong> u \u003Cstrong>Otro\u003C/strong>. Si tenés dudas, preguntale a tu contador.\u003C/li>\n\u003Cli>\u003Cstrong>Ingresos brutos\u003C/strong>: tu número de Ingresos Brutos.\u003C/li>\n\u003Cli>\u003Cstrong>Fecha de inicio de actividades\u003C/strong>: la que figura en tu constancia de ARCA.\u003C/li>\n\u003C/ul>\n\u003Cp>\u003Cimg src=\"/images/manual/70-finanzas/83-03-formulario-parte-2.png\" alt=\"Parte de abajo de la pantalla: Datos del PDV con Número de Punto de Venta, Domicilio comercial, Localidad, Provincia, Codigo Postal, la casilla Habilitado y el botón Guardar\">\u003C/p>\n\u003Cp>Después vienen los \u003Cstrong>Datos del PDV\u003C/strong>:\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Número de Punto de Venta\u003C/strong>: el número que dice el PDF. Por ejemplo: \u003Cem>3\u003C/em>. Es obligatorio.\u003C/li>\n\u003Cli>\u003Cstrong>Domicilio comercial\u003C/strong>, \u003Cstrong>Localidad\u003C/strong>, \u003Cstrong>Provincia\u003C/strong> y \u003Cstrong>Codigo Postal\u003C/strong>: la dirección del local, como la elegiste en ARCA.\u003C/li>\n\u003Cli>\u003Cstrong>Habilitado\u003C/strong>: dejalo tildado. Si lo destildás, el punto de venta deja de usarse.\u003C/li>\n\u003Cli>\u003Cstrong>Guardar\u003C/strong>: guarda el punto de venta.\u003C/li>\n\u003C/ul>\n\u003Cblockquote>\n\u003Cp>⚠️ \u003Cstrong>Atención:\u003C/strong> un punto de venta mal cargado rompe la facturación electrónica. Revisá el \u003Cstrong>CUIT\u003C/strong> y el \u003Cstrong>Número de Punto de Venta\u003C/strong> contra el PDF antes de tocar \u003Cstrong>Guardar\u003C/strong>.\u003C/p>\n\u003C/blockquote>\n\u003Col start=\"3\">\n\u003Cli>Cuando revisaste todo, tocá \u003Cstrong>Guardar\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cp>Los casilleros \u003Cstrong>CUIT\u003C/strong>, \u003Cstrong>Razón Social\u003C/strong>, \u003Cstrong>Número de Punto de Venta\u003C/strong> y \u003Cstrong>Domicilio Fiscal\u003C/strong> son obligatorios. Si falta uno, la pantalla no te deja guardar.\u003C/p>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                ✏️ Paso 3: Editá un punto de venta\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-3-edita-un-punto-de-venta\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-3-edita-un-punto-de-venta\">\u003C/div>\n\n\u003Col>\n\u003Cli>En la tabla, tocá \u003Cstrong>Editar\u003C/strong> en el renglón del punto de venta.\u003C/li>\n\u003Cli>Se abre la misma pantalla, con los datos cargados.\u003C/li>\n\u003Cli>Cambiá lo que necesites y tocá \u003Cstrong>Guardar\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cp>Una vez guardados, el \u003Cstrong>CUIT\u003C/strong>, la \u003Cstrong>Razón Social\u003C/strong> y el \u003Cstrong>Domicilio Fiscal\u003C/strong> quedan bloqueados: se ven en gris y no se pueden cambiar.\u003C/p>\n\u003Cp>No existe un botón para borrar un punto de venta. Para dejar de usarlo, destildá \u003Cstrong>Habilitado\u003C/strong> y tocá \u003Cstrong>Guardar\u003C/strong>.\u003C/p>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                📨 Paso 4: Revisá la relación fiscal\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-4-revisa-la-relacion-fiscal\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-4-revisa-la-relacion-fiscal\">\u003C/div>\n\n\u003Cp>Para facturar, tu comercio tiene que estar relacionado con PaxaPOS en ARCA. La pantalla lo controla por vos:\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Todo bien:\u003C/strong> debajo de \u003Cstrong>Número de Punto de Venta\u003C/strong> aparece la lista \u003Cstrong>PDV disponibles en ARCA\u003C/strong> con tu número.\u003C/li>\n\u003Cli>\u003Cstrong>Falta algo:\u003C/strong> arriba aparece el aviso rojo \u003Cstrong>Relación fiscal\u003C/strong>, con el texto \u003Cstrong>No hay Puntos de Venta disponibles para el CUIT\u003C/strong> y tu número de CUIT.\u003C/li>\n\u003C/ul>\n\u003Cp>Si ves el aviso, revisá que hayas hecho los tres pasos del trámite en ARCA. Están en \u003Ca href=\"/user-guide/configuracion-general#tramite-en-arca\">ARCA y Facturación Electrónica\u003C/a>. Después avisá a soporte para que confirmemos la relación:\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>WhatsApp:\u003C/strong> \u003Ca href=\"https://wa.me/542254629000?text=Hola!%20Ya%20cargu%C3%A9%20mi%20punto%20de%20venta%20en%20PaxaPOS.%20Mi%20CUIT%20es:%20__%20y%20el%20punto%20de%20venta%20es:%20__\" target=\"_blank\">+54 2254 62-9000\u003C/a>\u003C/li>\n\u003C/ul>\n\u003Cp>Mandanos el \u003Cstrong>CUIT\u003C/strong> del comercio y el \u003Cstrong>número de punto de venta\u003C/strong>.\u003C/p>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                ⚠️ Resolución de Inconvenientes\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"resolucion-de-inconvenientes\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"resolucion-de-inconvenientes\">\u003C/div>\n\n\u003Cdiv class=\"table-wrapper\">\u003Ctable>\n\u003Cthead>\n\u003Ctr>\n\u003Cth>Problema\u003C/th>\n\u003Cth>Causa más frecuente\u003C/th>\n\u003Cth>Solución recomendada\u003C/th>\n\u003C/tr>\n\u003C/thead>\n\u003Ctbody>\u003Ctr>\n\u003Ctd>\u003Cstrong>Aparece el aviso Relación fiscal\u003C/strong>\u003C/td>\n\u003Ctd>La relación de tu comercio con PaxaPOS en ARCA todavía no está confirmada.\u003C/td>\n\u003Ctd>Revisá el \u003Ca href=\"/user-guide/configuracion-general#tramite-en-arca\">trámite en ARCA\u003C/a> y avisá a soporte (Paso 4).\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>Mi número no aparece en PDV disponibles en ARCA\u003C/strong>\u003C/td>\n\u003Ctd>En ARCA el punto de venta se creó con otro sistema, o todavía no está confirmado.\u003C/td>\n\u003Ctd>Revisá el \u003Cstrong>Sistema\u003C/strong> en el PDF: tiene que ser de \u003Cstrong>Web Services\u003C/strong>. Consultá a soporte.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>No me deja guardar\u003C/strong>\u003C/td>\n\u003Ctd>Falta un dato obligatorio.\u003C/td>\n\u003Ctd>Completá \u003Cstrong>CUIT\u003C/strong>, \u003Cstrong>Razón Social\u003C/strong>, \u003Cstrong>Domicilio Fiscal\u003C/strong> y \u003Cstrong>Número de Punto de Venta\u003C/strong>.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>No puedo cambiar el CUIT ni la Razón Social\u003C/strong>\u003C/td>\n\u003Ctd>Una vez guardado el punto de venta, esos datos quedan bloqueados.\u003C/td>\n\u003Ctd>Pedile ayuda a soporte.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>No veo la opción Puntos de Venta (PDVs)\u003C/strong>\u003C/td>\n\u003Ctd>Tu usuario no tiene el permiso de \u003Cstrong>Facturación AFIP\u003C/strong>.\u003C/td>\n\u003Ctd>Pedíselo a un administrador en \u003Ca href=\"/user-guide/permisos-por-rol\">Permisos por Rol\u003C/a>.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>No encuentro el botón Sincronizar PDVs\u003C/strong>\u003C/td>\n\u003Ctd>Ese botón no existe.\u003C/td>\n\u003Ctd>Cargá cada punto de venta con \u003Cstrong>Agregar Punto de Venta\u003C/strong> (Paso 2).\u003C/td>\n\u003C/tr>\n\u003C/tbody>\u003C/table>\u003C/div>\n",[5,9,12,15,18,21],{"id":6,"title":7,"level":8},"antes-de-empezar","Antes de empezar",2,{"id":10,"title":11,"level":8},"paso-1-entra-a-la-pantalla","Paso 1: Entrá a la pantalla",{"id":13,"title":14,"level":8},"paso-2-agrega-un-punto-de-venta","Paso 2: Agregá un punto de venta",{"id":16,"title":17,"level":8},"paso-3-edita-un-punto-de-venta","Paso 3: Editá un punto de venta",{"id":19,"title":20,"level":8},"paso-4-revisa-la-relacion-fiscal","Paso 4: Revisá la relación fiscal",{"id":22,"title":23,"level":8},"resolucion-de-inconvenientes","Resolución de Inconvenientes",{"title":25,"description":26,"keywords":27},"Puntos de Venta (PDVs) - Manual","¿Dónde está en el sistema?: Menú principal → Finanzas → Facturación AFIP → Puntos de Venta (PDVs)\n ¿Quién lo usa?: Dueños, administrad...","puntos de venta pdv, paxapos, puntos de venta (pdvs), tutorial, guía, manual usuario","83-puntos-de-venta-pdv.txt"],"uses":{"params":["slug"]}}]}
