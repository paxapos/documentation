{"type":"data","nodes":[null,{"type":"data","data":[{"moduleCategories":1},[2,17,44,53,80,101,113,143,149,176,188,227,256],{"title":3,"modules":4},"Comenzamos",[5,8,11,14],{"slug":6,"title":7},"introduccion","Bienvenido a tu software gastronómico",{"slug":9,"title":10},"iniciar-sesion","Cómo Iniciar Sesión",{"slug":12,"title":13},"recuperar-contrasena","Cómo Recuperar tu Contraseña",{"slug":15,"title":16},"guia-de-inicio-rapido","Guía de Inicio Rápido",{"title":18,"modules":19},"Ventas",[20,23,26,29,32,35,38,41],{"slug":21,"title":22},"salon-de-ventas","Cómo Usar el Salón de Ventas (Adición)",{"slug":24,"title":25},"caja-rapida","Cómo Usar la Caja Rápida (Registradora)",{"slug":27,"title":28},"mozos","Cómo Cargar los Mozos",{"slug":30,"title":31},"clientes","Cómo Gestionar los Clientes",{"slug":33,"title":34},"descuentos","Cómo Configurar Descuentos",{"slug":36,"title":37},"nueva-reserva","Cómo Cargar una Nueva Reserva",{"slug":39,"title":40},"listado-de-reservas","Cómo Usar el Listado de Reservas",{"slug":42,"title":43},"grilla-de-reservas","Cómo Usar la Grilla de Reservas",{"title":45,"modules":46},"Medios de Pago",[47,50],{"slug":48,"title":49},"configuracion-procesadores","Configuración de Procesadores de Pago",{"slug":51,"title":52},"transacciones-mercadopago","Transacciones MercadoPago",{"title":54,"modules":55},"Productos",[56,59,62,65,68,71,74,77],{"slug":57,"title":58},"menu","Menú de Productos (Carta)",{"slug":60,"title":61},"categorias","Categorías de Productos",{"slug":63,"title":64},"variantes-grupo-sabores","Variantes y Grupos de Sabores",{"slug":66,"title":67},"maestro-de-productos","Maestro de Productos",{"slug":69,"title":70},"subproductos-elaborados","Sub-Productos (Elaborados)",{"slug":72,"title":73},"recetas","Recetas",{"slug":75,"title":76},"como-conectar-carta-digital-pedimelo-online","Cómo conectar la Carta Digital (Pedímelo Online)",{"slug":78,"title":79},"analisis-duplicados","Buscar Duplicados",{"title":81,"modules":82},"Compras",[83,86,89,92,95,98],{"slug":84,"title":85},"todas-las-ordenes-compra","Órdenes de Compra",{"slug":87,"title":88},"crear-orden-compra","Crear una Orden de Compra",{"slug":90,"title":91},"ordenes-a-aprobar","Órdenes a aprobar",{"slug":93,"title":94},"mercaderias","Mercaderías",{"slug":96,"title":97},"proveedores","Proveedores",{"slug":99,"title":100},"historial-de-compras","Historial de Compras",{"title":102,"modules":103},"Stock",[104,107,110],{"slug":105,"title":106},"stock-mercaderias","Stock de Mercaderías",{"slug":108,"title":109},"stock-subproductos","Stock de Subproductos",{"slug":111,"title":112},"movimientos-de-stock","Movimientos de Stock",{"title":114,"modules":115},"Finanzas",[116,119,122,125,128,131,134,137,140],{"slug":117,"title":118},"arqueos-de-caja","Arqueos de Caja",{"slug":120,"title":121},"listado-de-cajas","Listado de Cajas",{"slug":123,"title":124},"transacciones-de-cobro","Transacciones de Cobro",{"slug":126,"title":127},"factura-manual","Factura Manual",{"slug":129,"title":130},"resumen-de-deuda","Resumen de Deuda",{"slug":132,"title":133},"pagos","Pagos",{"slug":135,"title":136},"historial-de-facturas","Historial de Facturas",{"slug":138,"title":139},"historico-de-mesas","Histórico de Mesas",{"slug":141,"title":142},"puntos-de-venta-pdv","Puntos de Venta (PDVs)",{"title":144,"modules":145},"Comandero",[146],{"slug":147,"title":148},"comandero","Comandero (pantalla de cocina)",{"title":150,"modules":151},"RRHH",[152,155,158,161,164,167,170,173],{"slug":153,"title":154},"empleados","Empleados",{"slug":156,"title":157},"empleados-trabajando","Empleados Trabajando",{"slug":159,"title":160},"registro-diario-fichaje","Registro Diario de Fichaje",{"slug":162,"title":163},"reporte-mensual-fichaje","Reporte Mensual de Fichaje",{"slug":165,"title":166},"departamentos","Departamentos",{"slug":168,"title":169},"turnos-y-horarios-fichaje","Turnos y Horarios de Fichaje",{"slug":171,"title":172},"sueldos-y-jornales","Sueldos y Jornales",{"slug":174,"title":175},"datos-de-acceso-app","Datos de Acceso a la App de Fichaje",{"title":177,"modules":178},"Reportes",[179,182,185],{"slug":180,"title":181},"tablero-general","Tablero General",{"slug":183,"title":184},"productos-mas-vendidos","Productos Más Vendidos",{"slug":186,"title":187},"compras-por-mercaderia","Compras por Mercadería",{"title":189,"modules":190},"Configuracion",[191,194,197,200,203,206,209,212,215,218,221,224],{"slug":192,"title":193},"configuracion-general","Configuración general",{"slug":195,"title":196},"impresoras","Cómo cargar las impresoras del local",{"slug":198,"title":199},"perfiles-de-impresion","Cómo usar los perfiles de impresión",{"slug":201,"title":202},"usuarios-del-sistema","Cómo administrar los Usuarios del Sistema",{"slug":204,"title":205},"usuarios-con-pin","Cómo administrar los Usuarios con PIN",{"slug":207,"title":208},"punto-de-venta","🏛️ Trámite en ARCA (con clave fiscal)",{"slug":210,"title":211},"permisos-por-rol","Cómo configurar los Permisos por Rol",{"slug":213,"title":214},"turnos-mesa","Turnos de Mesa",{"slug":216,"title":217},"medios-de-cobro","Medios de cobro",{"slug":219,"title":220},"clasificacion-de-gastos","Clasificación de Gastos",{"slug":222,"title":223},"centros-de-costo","Centros de Costo",{"slug":225,"title":226},"facturacion-del-servicio","Consumos del mes y tope de inteligencia artificial",{"title":228,"modules":229},"Biblioteca de Drivers",[230,232,235,238,241,244,247,250,253],{"slug":231,"title":228},"biblioteca-de-drivers",{"slug":233,"title":234},"sam4s-giant-100","Sam4S Giant - 100",{"slug":236,"title":237},"citizen-ct-s310ii","Citizen CT-S310II",{"slug":239,"title":240},"epson-tm-t20","Epson TM-T20",{"slug":242,"title":243},"drivers-genericos","Drivers Genéricos POS",{"slug":245,"title":246},"epson-tm-t88","Epson TM-T88V",{"slug":248,"title":249},"fiscalberry-windows","Instalar Fiscalberry en Windows",{"slug":251,"title":252},"fiscalberry-linux","Instalar Fiscalberry en Linux",{"slug":254,"title":255},"fiscalberry-android","Instalar Fiscalberry en Android",{"title":257,"modules":258},"Extra",[259,262,265,268,271,274,277,280],{"slug":260,"title":261},"03-faq-mozo-reabrir-mesa-anulada","Cómo Reabrir una Mesa Anulada o Cerrada por Error",{"slug":263,"title":264},"06-faq-cajero-ingreso-egreso-cajon","Cómo Registrar Entradas y Salidas de Dinero del Cajón",{"slug":266,"title":267},"08-faq-cajero-diferencia-facturado-vs-abiertas","Diferencia entre \"Facturado Total Mesas\" y \"Abiertas Por Usuario\" en Caja",{"slug":269,"title":270},"buchon-bot","Buchón Bot",{"slug":272,"title":273},"01-ia-conectar-claude","IA: Conectar PaxaPos con Claude",{"slug":275,"title":276},"02-ia-conectar-chatgpt","IA: Conectar PaxaPos con ChatGPT",{"slug":278,"title":279},"03-ia-conectar-gemini","IA: Conectar PaxaPos con Gemini",{"slug":281,"title":282},"04-ia-pedidos-desde-asistentes","IA: Pedidos desde asistentes de IA"],"uses":{}},{"type":"data","data":[{"slug":1,"title":2,"content":3,"tableOfContents":4,"seo":27,"llmTxtFile":31},"stock-subproductos","Stock de Subproductos","\u003Cdiv id=\"stock-de-subproductos\">\u003C/div>\n\n\u003Cblockquote>\n\u003Cp>\u003Cstrong>¿Dónde está en el sistema?:\u003C/strong> Menú principal → \u003Cstrong>Stock\u003C/strong> → \u003Cstrong>Inventario\u003C/strong> → \u003Cstrong>Stock Subproductos\u003C/strong>\n\u003Cstrong>¿Quién lo usa?:\u003C/strong> Cocina y encargados de producción\u003C/p>\n\u003C/blockquote>\n\u003Cblockquote>\n\u003Cp>🎯 \u003Cstrong>¿Para qué sirve esto?\u003C/strong>\nAcá ves cuánto te queda de lo que preparás en tu cocina. Por ejemplo: cuántas \u003Cem>Medialunas\u003C/em> o \u003Cem>Empanadas de carne\u003C/em> hay listas.\nTambién cargás qué preparaciones querés controlar y el mínimo que no querés perforar.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🔑 Antes de empezar\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"antes-de-empezar\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"antes-de-empezar\">\u003C/div>\n\n\u003Cul>\n\u003Cli>Tu usuario tiene que tener el permiso de \u003Cstrong>Stock\u003C/strong> en \u003Ca href=\"/user-guide/permisos-por-rol\">Permisos por Rol\u003C/a>.\u003C/li>\n\u003Cli>El producto tiene que estar cargado. Mirá \u003Ca href=\"/user-guide/maestro-de-productos\">Maestro de Productos\u003C/a> y \u003Ca href=\"/user-guide/subproductos-elaborados\">Subproductos Elaborados\u003C/a>.\u003C/li>\n\u003Cli>Lo que le comprás a un proveedor (harina, levadura) va en \u003Ca href=\"/user-guide/stock-mercaderias\">Stock de Mercaderías\u003C/a>.\u003C/li>\n\u003C/ul>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                📍 Paso 1: Entrá a la pantalla\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-1-entra-a-la-pantalla\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-1-entra-a-la-pantalla\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/60-stock/63-00a-menu-grupo-stock.png\" alt=\"Menú lateral con el grupo Stock marcado en rojo\">\u003C/p>\n\u003Col>\n\u003Cli>En el menú de la izquierda, tocá \u003Cstrong>Stock\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/60-stock/63-00b-menu-opcion-stock-subproductos.png\" alt=\"Opción Stock Subproductos marcada en rojo, debajo de Stock Mercaderías\">\u003C/p>\n\u003Col start=\"2\">\n\u003Cli>Tocá \u003Cstrong>Stock Subproductos\u003C/strong>. Está debajo del título \u003Cstrong>INVENTARIO\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/60-stock/63-01-pantalla-stock-subproductos.png\" alt=\"Pantalla Stock de Subproductos con el buscador y la lista: Empanadas de carne en rojo y Medialuna\">\u003C/p>\n\u003Cp>Así se ve la pantalla. Cada renglón es una preparación que tiene el stock controlado. Las columnas dicen:\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Depósito\u003C/strong>: dónde está guardada. Por ejemplo: \u003Cem>Depósito Central\u003C/em>.\u003C/li>\n\u003Cli>\u003Cstrong>Subproducto\u003C/strong>: el nombre. Tocalo para ver la ficha del producto.\u003C/li>\n\u003Cli>\u003Cstrong>Costo Elaboración\u003C/strong>: cuánto te cuesta prepararla, según su receta.\u003C/li>\n\u003Cli>\u003Cstrong>U/M de Stock\u003C/strong>: cómo la contás. Por ejemplo: \u003Cem>Unidad\u003C/em>.\u003C/li>\n\u003Cli>\u003Cstrong>fecha inicio\u003C/strong> y \u003Cstrong>cantidad inicial\u003C/strong>: cuándo empezaste a controlarla y cuánto había ese día.\u003C/li>\n\u003Cli>\u003Cstrong>cant en stock\u003C/strong>: cuánto hay ahora. Es la cantidad inicial más lo que entró, menos lo que salió.\u003C/li>\n\u003Cli>\u003Cstrong>Nivel minimo de stock\u003C/strong>: por debajo de ese número te conviene preparar más.\u003C/li>\n\u003Cli>\u003Cstrong>acciones\u003C/strong>: los botones de cada renglón (Paso 4).\u003C/li>\n\u003C/ul>\n\u003Cp>Los colores del renglón te avisan:\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Rojo\u003C/strong>: no hay nada, o hay menos que el mínimo. Por ejemplo: \u003Cem>Empanadas de carne\u003C/em> en \u003Cem>0\u003C/em>.\u003C/li>\n\u003Cli>\u003Cstrong>Amarillo\u003C/strong>: hay justo el mínimo.\u003C/li>\n\u003Cli>\u003Cstrong>Blanco\u003C/strong>: hay más que el mínimo.\u003C/li>\n\u003C/ul>\n\u003Cblockquote>\n\u003Cp>💡 \u003Cstrong>Consejo útil:\u003C/strong> cuando vendés un producto que tiene el stock controlado, el sistema lo descuenta solo.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🔎 Paso 2: Buscá una preparación\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-2-busca-una-preparacion\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-2-busca-una-preparacion\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/60-stock/63-04-panel-busqueda.png\" alt=\"Recuadro de búsqueda con Medialuna escrito, los depósitos y el botón azul Buscar\">\u003C/p>\n\u003Cp>En el recuadro de búsqueda tenés:\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Buscar por Nombre\u003C/strong>: escribí parte del nombre. Por ejemplo: \u003Cem>Medialuna\u003C/em>.\u003C/li>\n\u003Cli>\u003Cstrong>Seleccione Depósito\u003C/strong>: mostrá solo lo que está en un depósito.\u003C/li>\n\u003Cli>\u003Cstrong>Buscar\u003C/strong>: el botón azul de abajo, que aplica la búsqueda.\u003C/li>\n\u003C/ul>\n\u003Col>\n\u003Cli>Completá lo que necesites y tocá \u003Cstrong>Buscar\u003C/strong>.\u003C/li>\n\u003Cli>La lista muestra solo las que coinciden.\u003C/li>\n\u003C/ol>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                ➕ Paso 3: Empezá a controlar el stock de una preparación\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-3-empeza-a-controlar-el-stock-de-una-preparacion\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-3-empeza-a-controlar-el-stock-de-una-preparacion\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/60-stock/63-02-donde-esta-boton-stockear-subproducto.png\" alt=\"Pantalla Stock de Subproductos con el botón verde Stockear Subproducto marcado en rojo arriba a la derecha\">\u003C/p>\n\u003Col>\n\u003Cli>Tocá el botón verde \u003Cstrong>Stockear Subproducto\u003C/strong>, arriba a la derecha.\u003C/li>\n\u003Cli>Se abre una ventanita con los datos para completar.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/60-stock/63-03-formulario-stockear.png\" alt=\"Ventanita Formulario Stokear Producto completa con Café, Depósito Central, 10, 5, la fecha y el botón Guardar\">\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Producto\u003C/strong>: escribí parte del nombre y tocalo en la lista. Por ejemplo: \u003Cem>Café\u003C/em>.\u003C/li>\n\u003Cli>\u003Cstrong>Deposito\u003C/strong>: dónde lo guardás. Por ejemplo: \u003Cem>Depósito Central\u003C/em>.\u003C/li>\n\u003Cli>\u003Cstrong>Cant Inicial\u003C/strong>: cuánto hay hoy. Por ejemplo: \u003Cem>10\u003C/em>.\u003C/li>\n\u003Cli>\u003Cstrong>Stock Minimo\u003C/strong>: el número que no querés perforar. Por ejemplo: \u003Cem>5\u003C/em>.\u003C/li>\n\u003Cli>\u003Cstrong>Fecha\u003C/strong>: desde cuándo lo controlás. Ya viene con la fecha y hora de hoy.\u003C/li>\n\u003C/ul>\n\u003Col start=\"3\">\n\u003Cli>Tocá el botón verde \u003Cstrong>Guardar\u003C/strong>.\u003C/li>\n\u003Cli>La preparación aparece en la lista.\u003C/li>\n\u003C/ol>\n\u003Cblockquote>\n\u003Cp>💡 \u003Cstrong>Consejo útil:\u003C/strong> en la lista de \u003Cstrong>Producto\u003C/strong> no aparecen los que ya tienen el stock controlado ni lo que le comprás a un proveedor.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🧰 Paso 4: Conocé los botones de cada renglón\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-4-conoce-los-botones-de-cada-renglon\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-4-conoce-los-botones-de-cada-renglon\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/60-stock/63-05-botones-del-renglon.png\" alt=\"Botones de un renglón: Agregar Precio Unitario, Editar nivel minimo de Stock, reinicializar, Agregar Movimiento y eliminar en rojo\">\u003C/p>\n\u003Cp>A la derecha de cada renglón hay cinco botones:\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Agregar Precio Unitario\u003C/strong>: cargá el costo del producto.\u003C/li>\n\u003Cli>\u003Cstrong>Editar nivel minimo de Stock\u003C/strong>: cambiá el mínimo. Escribí el número nuevo y tocá \u003Cstrong>Guardar\u003C/strong>.\u003C/li>\n\u003Cli>\u003Cstrong>reinicializar\u003C/strong>: cargá lo que contaste (Paso 5).\u003C/li>\n\u003Cli>\u003Cstrong>Agregar Movimiento\u003C/strong>: sumá o restá una cantidad a mano. Por ejemplo: \u003Cem>se quemaron 3 medialunas\u003C/em>. Marcá \u003Cstrong>ALTA\u003C/strong> si entra o \u003Cstrong>BAJA\u003C/strong> si sale, escribí qué pasó y tocá \u003Cstrong>Guardar\u003C/strong>.\u003C/li>\n\u003Cli>\u003Cstrong>eliminar\u003C/strong>: el botón rojo. Deja de controlar el stock de esa preparación.\u003C/li>\n\u003C/ul>\n\u003Cblockquote>\n\u003Cp>⚠️ \u003Cstrong>Atención:\u003C/strong> \u003Cstrong>eliminar\u003C/strong> saca la preparación de esta lista. El sistema te pregunta si estás seguro. Usalo solo si ya no querés controlarla.\u003C/p>\n\u003C/blockquote>\n\u003Cp>Estos botones funcionan igual que en \u003Ca href=\"/user-guide/stock-mercaderias\">Stock de Mercaderías\u003C/a>.\u003C/p>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🔢 Paso 5: Cargá lo que contaste\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-5-carga-lo-que-contaste\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-5-carga-lo-que-contaste\">\u003C/div>\n\n\u003Cp>Hacelo cuando contás las preparaciones a mano y el número no coincide con el sistema.\u003C/p>\n\u003Col>\n\u003Cli>Tocá el botón \u003Cstrong>reinicializar\u003C/strong> del renglón.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/60-stock/63-06-ventana-reinicializar.png\" alt=\"Ventanita reinicializar de Medialuna con 23 escrito, el aviso amarillo Sobrante 2 Unidades, la observación y el botón Guardar\">\u003C/p>\n\u003Col start=\"2\">\n\u003Cli>Arriba ves la \u003Cstrong>Cantidad Inicial\u003C/strong> y el \u003Cstrong>Movimiento Saldo\u003C/strong> (lo que entró menos lo que salió).\u003C/li>\n\u003Cli>En \u003Cstrong>Cantidad Actual en Stock\u003C/strong>, escribí lo que contaste. Por ejemplo: \u003Cem>23\u003C/em>.\u003C/li>\n\u003Cli>Mirá el aviso de abajo:\u003Cul>\n\u003Cli>\u003Cstrong>Stock perfecto!\u003C/strong> en verde: coincide con el sistema.\u003C/li>\n\u003Cli>\u003Cstrong>Faltante\u003C/strong> en rojo: contaste menos de lo que dice el sistema.\u003C/li>\n\u003Cli>\u003Cstrong>Sobrante\u003C/strong> en amarillo: contaste más. Por ejemplo: \u003Cem>Sobrante: 2 Unidades\u003C/em>.\u003C/li>\n\u003C/ul>\n\u003C/li>\n\u003Cli>En \u003Cstrong>Observación\u003C/strong>, escribí algo que te ayude a recordarlo. Por ejemplo: \u003Cem>Conteo de la mañana\u003C/em>.\u003C/li>\n\u003Cli>Tocá \u003Cstrong>Guardar\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cblockquote>\n\u003Cp>⚠️ \u003Cstrong>Atención:\u003C/strong> al guardar, el stock pasa a ser el número que contaste. No se puede deshacer.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                ⚠️ Resolución de Inconvenientes\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"resolucion-de-inconvenientes\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"resolucion-de-inconvenientes\">\u003C/div>\n\n\u003Cdiv class=\"table-wrapper\">\u003Ctable>\n\u003Cthead>\n\u003Ctr>\n\u003Cth>Problema\u003C/th>\n\u003Cth>Causa más frecuente\u003C/th>\n\u003Cth>Solución recomendada\u003C/th>\n\u003C/tr>\n\u003C/thead>\n\u003Ctbody>\u003Ctr>\n\u003Ctd>\u003Cstrong>El producto no aparece en la lista para stockear\u003C/strong>\u003C/td>\n\u003Ctd>Ya tiene el stock controlado, o es algo que le comprás a un proveedor.\u003C/td>\n\u003Ctd>Buscalo en esta pantalla. Si lo comprás, usá \u003Ca href=\"/user-guide/stock-mercaderias\">Stock de Mercaderías\u003C/a>.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>No coincide lo que hay en la heladera con el sistema\u003C/strong>\u003C/td>\n\u003Ctd>Se preparó una tanda o se tiró algo sin cargarlo.\u003C/td>\n\u003Ctd>Usá \u003Cstrong>Agregar Movimiento\u003C/strong> para lo que falta, o contá y usá \u003Cstrong>reinicializar\u003C/strong>.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>El renglón está en rojo\u003C/strong>\u003C/td>\n\u003Ctd>No hay nada, o hay menos que el mínimo.\u003C/td>\n\u003Ctd>Prepará más, o bajá el mínimo con \u003Cstrong>Editar nivel minimo de Stock\u003C/strong>.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>Al lado del nombre sale &quot;()&quot; sin unidad\u003C/strong>\u003C/td>\n\u003Ctd>El producto no tiene cargada su unidad de stock.\u003C/td>\n\u003Ctd>Cargala en la ficha del producto, en \u003Ca href=\"/user-guide/maestro-de-productos\">Maestro de Productos\u003C/a>.\u003C/td>\n\u003C/tr>\n\u003C/tbody>\u003C/table>\u003C/div>\n",[5,9,12,15,18,21,24],{"id":6,"title":7,"level":8},"antes-de-empezar","Antes de empezar",2,{"id":10,"title":11,"level":8},"paso-1-entra-a-la-pantalla","Paso 1: Entrá a la pantalla",{"id":13,"title":14,"level":8},"paso-2-busca-una-preparacion","Paso 2: Buscá una preparación",{"id":16,"title":17,"level":8},"paso-3-empeza-a-controlar-el-stock-de-una-preparacion","Paso 3: Empezá a controlar el stock de una preparación",{"id":19,"title":20,"level":8},"paso-4-conoce-los-botones-de-cada-renglon","Paso 4: Conocé los botones de cada renglón",{"id":22,"title":23,"level":8},"paso-5-carga-lo-que-contaste","Paso 5: Cargá lo que contaste",{"id":25,"title":26,"level":8},"resolucion-de-inconvenientes","Resolución de Inconvenientes",{"title":28,"description":29,"keywords":30},"Stock de Subproductos - Manual","¿Dónde está en el sistema?: Menú principal → Stock → Inventario → Stock Subproductos\n ¿Quién lo usa?: Cocina y encargados de producción","stock subproductos, paxapos, stock de subproductos, tutorial, guía, manual usuario","63-stock-subproductos.txt"],"uses":{"params":["slug"]}}]}
