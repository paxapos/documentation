"Crear una Orden de Compra",{"slug":87,"title":88},"ordenes-a-aprobar","Órdenes a aprobar",{"slug":90,"title":91},"mercaderias","Mercaderías",{"slug":93,"title":94},"proveedores","Proveedores",{"slug":96,"title":97},"historial-de-compras","Historial de Compras",{"title":99,"modules":100},"Stock",[101,104,107],{"slug":102,"title":103},"stock-mercaderias","Stock de Mercaderías",{"slug":105,"title":106},"stock-subproductos","Stock de Subproductos",{"slug":108,"title":109},"movimientos-de-stock","Movimientos de Stock",{"title":111,"modules":112},"Finanzas",[113,116,119,122,125,128,131,134,137],{"slug":114,"title":115},"arqueos-de-caja","Arqueos de Caja",{"slug":117,"title":118},"listado-de-cajas","Listado de Cajas",{"slug":120,"title":121},"transacciones-de-cobro","Transacciones de Cobro",{"slug":123,"title":124},"factura-manual","Factura Manual",{"slug":126,"title":127},"resumen-de-deuda","Resumen de Deuda",{"slug":129,"title":130},"pagos","Pagos",{"slug":132,"title":133},"historial-de-facturas","Historial de Facturas",{"slug":135,"title":136},"historico-de-mesas","Histórico de Mesas",{"slug":138,"title":139},"puntos-de-venta-pdv","Puntos de Venta (PDVs)",{"title":141,"modules":142},"Comandero",[143],{"slug":144,"title":145},"comandero","Comandero (pantalla de cocina)",{"title":147,"modules":148},"RRHH",[149,152,155,158,161,164,167,170],{"slug":150,"title":151},"empleados","Empleados",{"slug":153,"title":154},"empleados-trabajando","Empleados Trabajando",{"slug":156,"title":157},"registro-diario-fichaje","Registro Diario de Fichaje",{"slug":159,"title":160},"reporte-mensual-fichaje","Reporte Mensual de Fichaje",{"slug":162,"title":163},"departamentos","Departamentos",{"slug":165,"title":166},"turnos-y-horarios-fichaje","Turnos y Horarios de Fichaje",{"slug":168,"title":169},"sueldos-y-jornales","Sueldos y Jornales",{"slug":171,"title":172},"datos-de-acceso-app","Datos de Acceso a la App de Fichaje",{"title":174,"modules":175},"Reportes",[176,179,182],{"slug":177,"title":178},"tablero-general","Tablero General",{"slug":180,"title":181},"productos-mas-vendidos","Productos Más Vendidos",{"slug":183,"title":184},"compras-por-mercaderia","Compras por Mercadería",{"title":186,"modules":187},"Configuracion",[188,191,194,197,200,203,206,209,212,215,218],{"slug":189,"title":190},"configuracion-general","Configuración general",{"slug":192,"title":193},"impresoras","Cómo cargar las impresoras del local",{"slug":195,"title":196},"perfiles-de-impresion","Cómo usar los perfiles de impresión",{"slug":198,"title":199},"usuarios-del-sistema","Cómo administrar los Usuarios del Sistema",{"slug":201,"title":202},"usuarios-con-pin","Cómo administrar los Usuarios con PIN",{"slug":204,"title":205},"punto-de-venta","🏛️ Trámite en ARCA (con clave fiscal)",{"slug":207,"title":208},"permisos-por-rol","Cómo configurar los Permisos por Rol",{"slug":210,"title":211},"turnos-mesa","Turnos de Mesa",{"slug":213,"title":214},"medios-de-cobro","Medios de cobro",{"slug":216,"title":217},"clasificacion-de-gastos","Clasificación de Gastos",{"slug":219,"title":220},"centros-de-costo","Centros de Costo",{"title":222,"modules":223},"Biblioteca de Drivers",[224,226,229,232,235,238,241,244,247],{"slug":225,"title":222},"biblioteca-de-drivers",{"slug":227,"title":228},"sam4s-giant-100","Sam4S Giant - 100",{"slug":230,"title":231},"citizen-ct-s310ii","Citizen CT-S310II",{"slug":233,"title":234},"epson-tm-t20","Epson TM-T20",{"slug":236,"title":237},"drivers-genericos","Drivers Genéricos POS",{"slug":239,"title":240},"epson-tm-t88","Epson TM-T88V",{"slug":242,"title":243},"fiscalberry-windows","Instalar Fiscalberry en Windows",{"slug":245,"title":246},"fiscalberry-linux","Instalar Fiscalberry en Linux",{"slug":248,"title":249},"fiscalberry-android","Instalar Fiscalberry en Android",{"title":251,"modules":252},"Extra",[253,256,259,262,265,268,271,274,277,280],{"slug":254,"title":255},"01-faq-solucion-inicial-pantalla-congelada","📖 Manual de Usuario: Solución Inicial si la Pantalla se Congela o no Carga",{"slug":257,"title":258},"03-faq-mozo-reabrir-mesa-anulada","📖 Manual de Usuario: Cómo Reabrir una Mesa Anulada o Cerrada por Error",{"slug":260,"title":261},"05-faq-cajero-emitir-factura-a","📖 Manual de Usuario: Cómo Emitir una Factura A Cargando Datos del Cliente",{"slug":263,"title":264},"06-faq-cajero-ingreso-egreso-cajon","📖 Manual de Usuario: Cómo Registrar Entradas y Salidas de Dinero del Cajón",{"slug":266,"title":267},"07-faq-cajero-activar-medio-pago","📖 Manual de Usuario: Cómo Activar un Medio de Pago que no Aparece al Cobrar",{"slug":269,"title":270},"08-faq-cajero-diferencia-facturado-vs-abiertas","📖 Manual de Usuario: Diferencia entre \"Facturado Total Mesas\" y \"Abiertas Por Usuario\" en Caja",{"slug":272,"title":273},"10-faq-supervisor-cierre-caja-diferencias","📖 Manual de Usuario: Cómo Auditar y Solucionar Diferencias en el Cierre de Caja",{"slug":275,"title":276},"preguntas-frecuentes","Preguntas Frecuentes y Guías Rápidas por Rol",{"slug":278,"title":279},"buchon-bot","Buchón Bot",{"slug":281,"title":282},"troubleshooting-semantico","📖 Guía Única de Resolución de Problemas y Errores (Troubleshooting)"],"uses":{}},{"type":"data","data":[{"slug":1,"title":2,"content":3,"tableOfContents":4,"seo":27,"llmTxtFile":31},"grilla-de-reservas","Cómo Usar la Grilla de Reservas","\u003Cdiv id=\"grilla-de-reservas\">\u003C/div>\n\n\u003Cblockquote>\n\u003Cp>\u003Cstrong>¿Dónde está en el sistema?:\u003C/strong> Menú principal → \u003Cstrong>Ventas\u003C/strong> → (parte \u003Cstrong>Reservas Hoteleras\u003C/strong>) → \u003Cstrong>Grilla de Reservas\u003C/strong>\u003Cbr>\u003Cstrong>¿Quién lo usa?:\u003C/strong> Recepción y encargados de comercios con alojamiento\u003C/p>\n\u003C/blockquote>\n\u003Cblockquote>\n\u003Cp>🎯 \u003Cstrong>¿Para qué sirve esto?\u003C/strong>\nEs un calendario grande para alojamientos. Cada fila es una habitación y cada columna es un día. Ves de un vistazo qué habitaciones están ocupadas, y cargás o cambiás reservas desde la misma grilla.\u003C/p>\n\u003C/blockquote>\n\u003Cblockquote>\n\u003Cp>🔗 Pantallas relacionadas: \u003Ca href=\"/user-guide/nueva-reserva\">Nueva Reserva\u003C/a> · \u003Ca href=\"/user-guide/listado-de-reservas\">Listado de Reservas\u003C/a> · \u003Ca href=\"/user-guide/mozos\">Mozos\u003C/a> (las habitaciones se cargan ahí)\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                📍 \u003Cstrong>Paso 1: Entrá a la Grilla de Reservas\u003C/strong>\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-1-entra-a-la-grilla-de-reservas\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-1-entra-a-la-grilla-de-reservas\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/29-00a-menu-grupo-ventas.png\" alt=\"Grupo Ventas del menú lateral, marcado en rojo\">\u003C/p>\n\u003Col>\n\u003Cli>En el menú de la izquierda, tocá \u003Cstrong>Ventas\u003C/strong>. Se despliegan sus opciones.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/29-00b-menu-opcion-grilla-de-reservas.png\" alt=\"Opción Grilla de Reservas dentro del grupo Ventas, marcada en rojo\">\u003C/p>\n\u003Col start=\"2\">\n\u003Cli>Bajá hasta la parte \u003Cstrong>Reservas Hoteleras\u003C/strong> y tocá \u003Cstrong>Grilla de Reservas\u003C/strong>.\u003C/li>\n\u003Cli>Se abre la grilla, centrada en el día de hoy.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/29-01-pantalla-completa.png\" alt=\"Grilla con las habitaciones a la izquierda, los días arriba y una reserva naranja\">\u003C/p>\n\u003Cp>En esta pantalla vas a ver:\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>A la izquierda:\u003C/strong> una fila por habitación.\u003C/li>\n\u003Cli>\u003Cstrong>Arriba:\u003C/strong> los días. El día de hoy está marcado en naranja, con una línea vertical.\u003C/li>\n\u003Cli>\u003Cstrong>En la grilla:\u003C/strong> cada reserva es una barrita de color, desde el día que llegan hasta el día que se van.\u003C/li>\n\u003Cli>\u003Cstrong>Arriba a la izquierda:\u003C/strong> cuántas reservas hay.\u003C/li>\n\u003C/ul>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🧭 \u003Cstrong>Paso 2: Moverte por los días\u003C/strong>\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-2-moverte-por-los-dias\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-2-moverte-por-los-dias\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/29-02-donde-esta-boton-semana-anterior.png\" alt=\"Grilla con el botón de semana anterior marcado en rojo\">\u003C/p>\n\u003Cul>\n\u003Cli>Tocá \u003Cstrong>‹\u003C/strong> para ir a la semana anterior.\u003C/li>\n\u003C/ul>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/29-06-donde-esta-boton-semana-siguiente.png\" alt=\"Grilla con el botón de semana siguiente marcado en rojo\">\u003C/p>\n\u003Cul>\n\u003Cli>Tocá \u003Cstrong>›\u003C/strong> para ir a la semana siguiente.\u003C/li>\n\u003C/ul>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/29-04-donde-esta-boton-hoy.png\" alt=\"Grilla con el botón Hoy marcado en rojo\">\u003C/p>\n\u003Cul>\n\u003Cli>Tocá \u003Cstrong>Hoy\u003C/strong> para volver al día de hoy.\u003C/li>\n\u003C/ul>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/29-08-donde-esta-boton-actualizar.png\" alt=\"Grilla con el botón de actualizar marcado en rojo\">\u003C/p>\n\u003Cul>\n\u003Cli>Tocá \u003Cstrong>↻\u003C/strong> para traer las reservas que cargaron otras personas.\u003C/li>\n\u003C/ul>\n\u003Cblockquote>\n\u003Cp>💡 \u003Cstrong>Consejo útil:\u003C/strong> También podés mover la grilla arrastrándola con el dedo o con el mouse.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                ➕ \u003Cstrong>Paso 3: Cargá una reserva desde la grilla\u003C/strong>\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-3-carga-una-reserva-desde-la-grilla\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-3-carga-una-reserva-desde-la-grilla\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/29-44-crear-reserva-arrastrando.png\" alt=\"Grilla con dos días marcados en celeste en la fila de una habitación\">\u003C/p>\n\u003Col>\n\u003Cli>Buscá la fila de la habitación.\u003C/li>\n\u003Cli>Tocá el día que \u003Cstrong>llegan\u003C/strong> y, sin soltar, arrastrá hacia la derecha hasta la última noche.\u003C/li>\n\u003Cli>Los días elegidos se pintan de celeste.\u003C/li>\n\u003Cli>Soltá. La reserva se crea y aparece como una barrita de color.\u003C/li>\n\u003C/ol>\n\u003Cblockquote>\n\u003Cp>💡 \u003Cstrong>Consejo útil:\u003C/strong> Para una sola noche, arrastrá dentro del mismo día.\u003C/p>\n\u003C/blockquote>\n\u003Cblockquote>\n\u003Cp>⚠️ \u003Cstrong>Atención:\u003C/strong> Si esa habitación ya tiene una reserva en esas fechas, vas a ver un aviso rojo y no se crea nada.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                👁️ \u003Cstrong>Paso 4: Abrí una reserva\u003C/strong>\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-4-abri-una-reserva\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-4-abri-una-reserva\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/29-12-donde-esta-boton-reserva.png\" alt=\"Grilla con una reserva marcada en rojo\">\u003C/p>\n\u003Col>\n\u003Cli>Tocá la barrita de la reserva.\u003C/li>\n\u003Cli>A la derecha se abre el panel \u003Cstrong>Detalle de reserva\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/29-46-panel-reserva.png\" alt=\"Panel Detalle de reserva a la derecha de la grilla\">\u003C/p>\n\u003Ch3>Cambiar los datos\u003C/h3>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/29-24-campo-buscar-y-asignar-cliente.png\" alt=\"Casillero para buscar y asignar un cliente\">\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Cliente:\u003C/strong> escribí el nombre, el DNI o el teléfono y elegilo de la lista.\u003C/li>\n\u003C/ul>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/29-25-campo-check-in.png\" alt=\"Casillero Check-in\">\u003C/p>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/29-26-campo-check-out.png\" alt=\"Casillero Check-out\">\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Check-in\u003C/strong> y \u003Cstrong>Check-out:\u003C/strong> el día que llegan y el día que se van.\u003C/li>\n\u003C/ul>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/29-27-campo-comensales.png\" alt=\"Casillero de cubiertos\">\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Cubierto:\u003C/strong> cuántas personas son. Por ejemplo: \u003Cem>2\u003C/em>.\u003C/li>\n\u003C/ul>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/29-28-campo-estado.png\" alt=\"Lista Estado\">\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Estado:\u003C/strong> cómo está la reserva. Por ejemplo: \u003Cem>Pendiente\u003C/em>.\u003C/li>\n\u003C/ul>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/29-35-campo-observacion.png\" alt=\"Casillero Observación\">\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Observación:\u003C/strong> cualquier pedido especial. Por ejemplo: \u003Cem>Llegan tarde, después de las 22\u003C/em>.\u003C/li>\n\u003C/ul>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/29-36-donde-esta-boton-guardar-cambios.png\" alt=\"Panel con el botón Guardar cambios marcado en rojo\">\u003C/p>\n\u003Col start=\"3\">\n\u003Cli>Tocá el botón azul \u003Cstrong>Guardar cambios\u003C/strong>, abajo del panel.\u003C/li>\n\u003C/ol>\n\u003Ch3>Recibir al huésped\u003C/h3>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/29-29-donde-esta-boton-recepcionar.png\" alt=\"Panel con el botón Recepcionar marcado en rojo\">\u003C/p>\n\u003Cul>\n\u003Cli>Cuando llegan, tocá el botón verde \u003Cstrong>Recepcionar\u003C/strong>. La reserva pasa a estar ocupada.\u003C/li>\n\u003C/ul>\n\u003Ch3>Ver la reserva completa\u003C/h3>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/29-38-donde-esta-boton-ver.png\" alt=\"Panel con el botón Ver marcado en rojo\">\u003C/p>\n\u003Cul>\n\u003Cli>Tocá \u003Cstrong>Ver\u003C/strong> para abrir la reserva en la pantalla clásica, con todos sus datos.\u003C/li>\n\u003C/ul>\n\u003Ch3>Cerrar el panel\u003C/h3>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/29-42-donde-esta-boton-cerrar-panel.png\" alt=\"Panel con la cruz de cerrar marcada en rojo\">\u003C/p>\n\u003Cul>\n\u003Cli>Tocá la \u003Cstrong>✕\u003C/strong> de arriba a la derecha para cerrar el panel sin cambiar nada.\u003C/li>\n\u003C/ul>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                ❌ \u003Cstrong>Paso 5: Cancelá o borrá una reserva\u003C/strong>\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-5-cancela-o-borra-una-reserva\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-5-cancela-o-borra-una-reserva\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/29-33-donde-esta-boton-cancelar-reserva.png\" alt=\"Panel con el botón Cancelar marcado en rojo\">\u003C/p>\n\u003Cul>\n\u003Cli>Si el huésped avisa que no viene, tocá el botón rojo \u003Cstrong>Cancelar\u003C/strong>. La reserva queda cancelada.\u003C/li>\n\u003C/ul>\n\u003Cblockquote>\n\u003Cp>⚠️ \u003Cstrong>Atención:\u003C/strong> \u003Cstrong>Eliminar reserva\u003C/strong> la borra para siempre. Usalo solo si la cargaste por error. Si el cliente no viene, usá \u003Cstrong>Cancelar\u003C/strong>.\u003C/p>\n\u003C/blockquote>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/29-40-donde-esta-boton-eliminar-reserva.png\" alt=\"Panel con el botón Eliminar reserva marcado en rojo\">\u003C/p>\n\u003Cul>\n\u003Cli>Para borrarla, tocá \u003Cstrong>Eliminar reserva\u003C/strong>, abajo de todo.\u003C/li>\n\u003C/ul>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                ⋮ \u003Cstrong>Paso 6: Más opciones\u003C/strong>\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-6-mas-opciones\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-6-mas-opciones\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/29-10-donde-esta-boton-opciones.png\" alt=\"Grilla con el botón de los tres puntos marcado en rojo\">\u003C/p>\n\u003Col>\n\u003Cli>Tocá el botón \u003Cstrong>⋮\u003C/strong>, arriba a la derecha.\u003C/li>\n\u003Cli>Se abre un menú:\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/29-45-menu-opciones.png\" alt=\"Menú con Reporte de Ocupación, Historico de Mesas, Mozos, Ir a Página Principal y Refrescar\">\u003C/p>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/29-14-donde-esta-boton-reporte-de-ocupacion.png\" alt=\"Menú con Reporte de Ocupación marcado en rojo\">\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Reporte de Ocupación:\u003C/strong> un informe de las habitaciones ocupadas.\u003C/li>\n\u003C/ul>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/29-16-donde-esta-boton-historico-de-reservas.png\" alt=\"Menú con Historico de Mesas marcado en rojo\">\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Historico de Mesas:\u003C/strong> todas las reservas pasadas.\u003C/li>\n\u003C/ul>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/29-18-donde-esta-boton-mozos.png\" alt=\"Menú con Mozos marcado en rojo\">\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Mozos:\u003C/strong> para cargar o cambiar las habitaciones (ver \u003Ca href=\"/user-guide/mozos\">Mozos\u003C/a>).\u003C/li>\n\u003C/ul>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/29-20-donde-esta-boton-ir-a-pagina-principal.png\" alt=\"Menú con Ir a Página Principal marcado en rojo\">\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Ir a Página Principal:\u003C/strong> sale de la grilla.\u003C/li>\n\u003Cli>\u003Cstrong>Refrescar:\u003C/strong> igual que el botón \u003Cstrong>↻\u003C/strong>.\u003C/li>\n\u003C/ul>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                ⚠️ \u003Cstrong>Resolución de Inconvenientes\u003C/strong>\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"resolucion-de-inconvenientes\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"resolucion-de-inconvenientes\">\u003C/div>\n\n\u003Cdiv class=\"table-wrapper\">\u003Ctable>\n\u003Cthead>\n\u003Ctr>\n\u003Cth>Problema\u003C/th>\n\u003Cth>Causa más frecuente\u003C/th>\n\u003Cth>Solución recomendada\u003C/th>\n\u003C/tr>\n\u003C/thead>\n\u003Ctbody>\u003Ctr>\n\u003Ctd>\u003Cstrong>No aparece Grilla de Reservas en el menú\u003C/strong>\u003C/td>\n\u003Ctd>El comercio no tiene activas las reservas hoteleras.\u003C/td>\n\u003Ctd>Pedile al administrador que las active.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>Una reserva no aparece en la grilla\u003C/strong>\u003C/td>\n\u003Ctd>No tiene habitación asignada, o es de otra semana.\u003C/td>\n\u003Ctd>Buscala en el \u003Ca href=\"/user-guide/listado-de-reservas\">Listado de Reservas\u003C/a> o tocá \u003Cstrong>›\u003C/strong> para avanzar.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>Aparece &quot;Ya hay una reserva en esas fechas&quot;\u003C/strong>\u003C/td>\n\u003Ctd>Esa habitación ya está ocupada esos días.\u003C/td>\n\u003Ctd>Elegí otros días u otra habitación.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>No veo una habitación\u003C/strong>\u003C/td>\n\u003Ctd>La habitación está desactivada o no la puede ver tu usuario.\u003C/td>\n\u003Ctd>Revisala en \u003Ca href=\"/user-guide/mozos\">Mozos\u003C/a>.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>No veo lo que cargó otra persona\u003C/strong>\u003C/td>\n\u003Ctd>La grilla no se actualizó sola.\u003C/td>\n\u003Ctd>Tocá \u003Cstrong>↻\u003C/strong>.\u003C/td>\n\u003C/tr>\n\u003C/tbody>\u003C/table>\u003C/div>\n",[5,9,12,15,18,21,24],{"id":6,"title":7,"level":8},"paso-1-entra-a-la-grilla-de-reservas","Paso 1: Entrá a la Grilla de Reservas",2,{"id":10,"title":11,"level":8},"paso-2-moverte-por-los-dias","Paso 2: Moverte por los días",{"id":13,"title":14,"level":8},"paso-3-carga-una-reserva-desde-la-grilla","Paso 3: Cargá una reserva desde la grilla",{"id":16,"title":17,"level":8},"paso-4-abri-una-reserva","Paso 4: Abrí una reserva",{"id":19,"title":20,"level":8},"paso-5-cancela-o-borra-una-reserva","Paso 5: Cancelá o borrá una reserva",{"id":22,"title":23,"level":8},"paso-6-mas-opciones","⋮ Paso 6: Más opciones",{"id":25,"title":26,"level":8},"resolucion-de-inconvenientes","Resolución de Inconvenientes",{"title":28,"description":29,"keywords":30},"Cómo Usar la Grilla de Reservas - Manual","¿Dónde está en el sistema?: Menú principal → Ventas → (parte Reservas Hoteleras) → Grilla de Reservas  \n ¿Quién lo usa?: Recepción y e...","grilla de reservas, paxapos, cómo usar la grilla de reservas, tutorial, guía, manual usuario","29-grilla-de-reservas.txt"],"uses":{"params":["slug"]}}]}
