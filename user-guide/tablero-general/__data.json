{"type":"data","nodes":[null,{"type":"data","data":[{"moduleCategories":1},[2,17,44,53,77,98,110,140,146,173,185,221,250],{"title":3,"modules":4},"Comenzamos",[5,8,11,14],{"slug":6,"title":7},"introduccion","Bienvenido a tu software gastronómico",{"slug":9,"title":10},"iniciar-sesion","Cómo Iniciar Sesión",{"slug":12,"title":13},"recuperar-contrasena","Cómo Recuperar tu Contraseña",{"slug":15,"title":16},"guia-de-inicio-rapido","Guía de Inicio Rápido",{"title":18,"modules":19},"Ventas",[20,23,26,29,32,35,38,41],{"slug":21,"title":22},"salon-de-ventas","Cómo Usar el Salón de Ventas (Adición)",{"slug":24,"title":25},"caja-rapida","Cómo Usar la Caja Rápida (Registradora)",{"slug":27,"title":28},"mozos","Cómo Cargar los Mozos",{"slug":30,"title":31},"clientes","Cómo Gestionar los Clientes",{"slug":33,"title":34},"descuentos","Cómo Configurar Descuentos",{"slug":36,"title":37},"nueva-reserva","Cómo Cargar una Nueva Reserva",{"slug":39,"title":40},"listado-de-reservas","Cómo Usar el Listado de Reservas",{"slug":42,"title":43},"grilla-de-reservas","Cómo Usar la Grilla de Reservas",{"title":45,"modules":46},"Medios de Pago",[47,50],{"slug":48,"title":49},"configuracion-procesadores","Configuración de Procesadores de Pago",{"slug":51,"title":52},"transacciones-mercadopago","Transacciones MercadoPago",{"title":54,"modules":55},"Productos",[56,59,62,65,68,71,74],{"slug":57,"title":58},"menu","Menú de Productos (Carta)",{"slug":60,"title":61},"categorias","Categorías de Productos",{"slug":63,"title":64},"variantes-grupo-sabores","Variantes y Grupos de Sabores",{"slug":66,"title":67},"maestro-de-productos","Maestro de Productos",{"slug":69,"title":70},"subproductos-elaborados","Sub-Productos (Elaborados)",{"slug":72,"title":73},"recetas","Recetas",{"slug":75,"title":76},"analisis-duplicados","Buscar Duplicados",{"title":78,"modules":79},"Compras",[80,83,86,89,92,95],{"slug":81,"title":82},"todas-las-ordenes-compra","Órdenes de Compra",{"slug":84,"title":85},"crear-orden-compra","Crear una Orden de Compra",{"slug":87,"title":88},"ordenes-a-aprobar","Órdenes a aprobar",{"slug":90,"title":91},"mercaderias","Mercaderías",{"slug":93,"title":94},"proveedores","Proveedores",{"slug":96,"title":97},"historial-de-compras","Historial de Compras",{"title":99,"modules":100},"Stock",[101,104,107],{"slug":102,"title":103},"stock-mercaderias","Stock de Mercaderías",{"slug":105,"title":106},"stock-subproductos","Stock de Subproductos",{"slug":108,"title":109},"movimientos-de-stock","Movimientos de Stock",{"title":111,"modules":112},"Finanzas",[113,116,119,122,125,128,131,134,137],{"slug":114,"title":115},"arqueos-de-caja","Arqueos de Caja",{"slug":117,"title":118},"listado-de-cajas","Listado de Cajas",{"slug":120,"title":121},"transacciones-de-cobro","Transacciones de Cobro",{"slug":123,"title":124},"factura-manual","Factura Manual",{"slug":126,"title":127},"resumen-de-deuda","Resumen de Deuda",{"slug":129,"title":130},"pagos","Pagos",{"slug":132,"title":133},"historial-de-facturas","Historial de Facturas",{"slug":135,"title":136},"historico-de-mesas","Histórico de Mesas",{"slug":138,"title":139},"puntos-de-venta-pdv","Puntos de Venta (PDVs)",{"title":141,"modules":142},"Comandero",[143],{"slug":144,"title":145},"comandero","Comandero (pantalla de cocina)",{"title":147,"modules":148},"RRHH",[149,152,155,158,161,164,167,170],{"slug":150,"title":151},"empleados","Empleados",{"slug":153,"title":154},"empleados-trabajando","Empleados Trabajando",{"slug":156,"title":157},"registro-diario-fichaje","Registro Diario de Fichaje",{"slug":159,"title":160},"reporte-mensual-fichaje","Reporte Mensual de Fichaje",{"slug":162,"title":163},"departamentos","Departamentos",{"slug":165,"title":166},"turnos-y-horarios-fichaje","Turnos y Horarios de Fichaje",{"slug":168,"title":169},"sueldos-y-jornales","Sueldos y Jornales",{"slug":171,"title":172},"datos-de-acceso-app","Datos de Acceso a la App de Fichaje",{"title":174,"modules":175},"Reportes",[176,179,182],{"slug":177,"title":178},"tablero-general","Tablero General",{"slug":180,"title":181},"productos-mas-vendidos","Productos Más Vendidos",{"slug":183,"title":184},"compras-por-mercaderia","Compras por Mercadería",{"title":186,"modules":187},"Configuracion",[188,191,194,197,200,203,206,209,212,215,218],{"slug":189,"title":190},"configuracion-general","Configuración general",{"slug":192,"title":193},"impresoras","Cómo cargar las impresoras del local",{"slug":195,"title":196},"perfiles-de-impresion","Cómo usar los perfiles de impresión",{"slug":198,"title":199},"usuarios-del-sistema","Cómo administrar los Usuarios del Sistema",{"slug":201,"title":202},"usuarios-con-pin","Cómo administrar los Usuarios con PIN",{"slug":204,"title":205},"punto-de-venta","🏛️ Trámite en ARCA (con clave fiscal)",{"slug":207,"title":208},"permisos-por-rol","Cómo configurar los Permisos por Rol",{"slug":210,"title":211},"turnos-mesa","Turnos de Mesa",{"slug":213,"title":214},"medios-de-cobro","Medios de cobro",{"slug":216,"title":217},"clasificacion-de-gastos","Clasificación de Gastos",{"slug":219,"title":220},"centros-de-costo","Centros de Costo",{"title":222,"modules":223},"Biblioteca de Drivers",[224,226,229,232,235,238,241,244,247],{"slug":225,"title":222},"biblioteca-de-drivers",{"slug":227,"title":228},"sam4s-giant-100","Sam4S Giant - 100",{"slug":230,"title":231},"citizen-ct-s310ii","Citizen CT-S310II",{"slug":233,"title":234},"epson-tm-t20","Epson TM-T20",{"slug":236,"title":237},"drivers-genericos","Drivers Genéricos POS",{"slug":239,"title":240},"epson-tm-t88","Epson TM-T88V",{"slug":242,"title":243},"fiscalberry-windows","Instalar Fiscalberry en Windows",{"slug":245,"title":246},"fiscalberry-linux","Instalar Fiscalberry en Linux",{"slug":248,"title":249},"fiscalberry-android","Instalar Fiscalberry en Android",{"title":251,"modules":252},"Extra",[253,256,259,262,265,268,271,274,277,280],{"slug":254,"title":255},"01-faq-solucion-inicial-pantalla-congelada","📖 Manual de Usuario: Solución Inicial si la Pantalla se Congela o no Carga",{"slug":257,"title":258},"03-faq-mozo-reabrir-mesa-anulada","📖 Manual de Usuario: Cómo Reabrir una Mesa Anulada o Cerrada por Error",{"slug":260,"title":261},"05-faq-cajero-emitir-factura-a","📖 Manual de Usuario: Cómo Emitir una Factura A Cargando Datos del Cliente",{"slug":263,"title":264},"06-faq-cajero-ingreso-egreso-cajon","📖 Manual de Usuario: Cómo Registrar Entradas y Salidas de Dinero del Cajón",{"slug":266,"title":267},"07-faq-cajero-activar-medio-pago","📖 Manual de Usuario: Cómo Activar un Medio de Pago que no Aparece al Cobrar",{"slug":269,"title":270},"08-faq-cajero-diferencia-facturado-vs-abiertas","📖 Manual de Usuario: Diferencia entre \"Facturado Total Mesas\" y \"Abiertas Por Usuario\" en Caja",{"slug":272,"title":273},"10-faq-supervisor-cierre-caja-diferencias","📖 Manual de Usuario: Cómo Auditar y Solucionar Diferencias en el Cierre de Caja",{"slug":275,"title":276},"preguntas-frecuentes","Preguntas Frecuentes y Guías Rápidas por Rol",{"slug":278,"title":279},"buchon-bot","Buchón Bot",{"slug":281,"title":282},"troubleshooting-semantico","📖 Guía Única de Resolución de Problemas y Errores (Troubleshooting)"],"uses":{}},{"type":"data","data":[{"slug":1,"title":2,"content":3,"tableOfContents":4,"seo":51,"llmTxtFile":55},"tablero-general","Tablero General","\u003Cdiv id=\"tablero-general\">\u003C/div>\n\n\u003Cblockquote>\n\u003Cp>\u003Cstrong>¿Dónde está en el sistema?:\u003C/strong> Menú principal → \u003Cstrong>Reportes\u003C/strong> → \u003Cstrong>Tablero General\u003C/strong>. Está debajo del título \u003Cstrong>GENERAL\u003C/strong>.\n\u003Cstrong>¿Quién lo usa?:\u003C/strong> Dueños de local, gerentes y contadores\u003C/p>\n\u003C/blockquote>\n\u003Cblockquote>\n\u003Cp>🎯 \u003Cstrong>¿Para qué sirve esto?\u003C/strong>\nAcá ves cómo le fue a tu negocio en un período: cuánto vendiste, cuánto gastaste y cuánto ganaste.\nLa pantalla se titula \u003Cstrong>Tu negocio en números\u003C/strong>. Solo se mira: no cambia ningún dato.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🔑 Antes de empezar\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"antes-de-empezar\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"antes-de-empezar\">\u003C/div>\n\n\u003Cul>\n\u003Cli>Tu usuario tiene que tener el permiso de \u003Cstrong>Reportes\u003C/strong> en \u003Ca href=\"/user-guide/permisos-por-rol\">Permisos por Rol\u003C/a>.\u003C/li>\n\u003Cli>Para que haya números, tenés que tener ventas cobradas y gastos cargados en las fechas que elijas.\u003C/li>\n\u003Cli>Los bloques que no tienen datos \u003Cstrong>no se muestran\u003C/strong>. Es normal: no es un error.\u003C/li>\n\u003C/ul>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                📍 \u003Cstrong>Paso 1: Entrá a la pantalla\u003C/strong>\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-1-entra-a-la-pantalla\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-1-entra-a-la-pantalla\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/100-reportes/101-00a-menu-grupo-reportes.png\" alt=\"Menú lateral con el grupo Reportes marcado en rojo\">\u003C/p>\n\u003Col>\n\u003Cli>En el menú de la izquierda, tocá \u003Cstrong>Reportes\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/100-reportes/101-00b-menu-opcion-tablero-general.png\" alt=\"Opción Tablero General marcada en rojo, debajo del título General\">\u003C/p>\n\u003Col start=\"2\">\n\u003Cli>Tocá \u003Cstrong>Tablero General\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/100-reportes/101-01-pantalla-tablero-general.png\" alt=\"Pantalla Tu negocio en números con el resumen del período, las tarjetas azules y el filtro de fechas\">\u003C/p>\n\u003Cp>Así se ve la pantalla. Cuando entrás, muestra los \u003Cstrong>últimos 7 días\u003C/strong>. Más abajo vas a ver cómo cambiar las fechas.\u003C/p>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🔘 \u003Cstrong>Paso 2: Los botones de arriba\u003C/strong>\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-2-los-botones-de-arriba\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-2-los-botones-de-arriba\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/100-reportes/101-02-donde-esta-boton-exportar.png\" alt=\"Pantalla con el grupo de dos botones, recargar y Exportar, marcado en rojo debajo del título\">\u003C/p>\n\u003Cp>Debajo del título hay dos botones juntos.\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Botón con dos flechas (↻)\u003C/strong>: vuelve a cargar la pantalla con los datos de este momento. Sirve si hubo ventas nuevas.\u003C/li>\n\u003Cli>\u003Cstrong>Exportar\u003C/strong> (azul): baja a tu computadora un archivo con los números principales de la pantalla. Lo abrís con Excel.\u003C/li>\n\u003C/ul>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🗂️ \u003Cstrong>Paso 3: Elegí un centro de costo (si tenés)\u003C/strong>\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-3-elegi-un-centro-de-costo\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-3-elegi-un-centro-de-costo\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/100-reportes/101-03-pestanas-centro-de-costo.png\" alt=\"Pestañas Global, Administrativo - General, CASER, corralon, desarrollo, obras publicas, Otro, salud y seguridad\">\u003C/p>\n\u003Cp>Estas pestañas \u003Cstrong>solo aparecen si tu comercio tiene centros de costo\u003C/strong>.\u003C/p>\n\u003Col>\n\u003Cli>\u003Cstrong>Global\u003C/strong> muestra todo el comercio junto.\u003C/li>\n\u003Cli>Tocá el nombre de un centro para ver solo lo suyo.\u003C/li>\n\u003Cli>La pantalla se recarga y aparece un aviso arriba.\u003C/li>\n\u003C/ol>\n\u003Cblockquote>\n\u003Cp>💡 \u003Cstrong>Consejo útil:\u003C/strong> en un centro, las ventas, los cobros y los métodos de pago son del centro. Los gastos, el IVA y la facturación siguen siendo los de todo el comercio.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                📅 \u003Cstrong>Paso 4: Elegí las fechas\u003C/strong>\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-4-elegi-las-fechas\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-4-elegi-las-fechas\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/100-reportes/101-04-filtro-fechas.png\" alt=\"Panel Rango de Fechas con los casilleros Desde y Hasta y el botón azul Actualizar Datos\">\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Desde\u003C/strong>: el primer día que querés mirar.\u003C/li>\n\u003Cli>\u003Cstrong>Hasta\u003C/strong>: el último día.\u003C/li>\n\u003Cli>\u003Cstrong>Actualizar Datos\u003C/strong>: tocalo para ver los números de esas fechas.\u003C/li>\n\u003Cli>El cartel celeste te recuerda que cada día se cuenta desde una hora fija (por ejemplo 06:00) hasta la misma hora del día siguiente. Esa hora se configura en tu comercio.\u003C/li>\n\u003C/ul>\n\u003Cblockquote>\n\u003Cp>💡 \u003Cstrong>Consejo útil:\u003C/strong> los gráficos se dibujan si el rango es de \u003Cstrong>menos de 180 días\u003C/strong>. Con más días ves los números, pero no los gráficos. El máximo es de unos 2 años.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                📊 \u003Cstrong>Paso 5: Leé el resumen de arriba\u003C/strong>\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-5-lee-el-resumen-de-arriba\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-5-lee-el-resumen-de-arriba\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/100-reportes/101-05-resumen-ejecutivo.png\" alt=\"Resumen ejecutivo con la frase En estos 90 días tu negocio ganó y tres tarjetas: Ventas, Gastos y Resultado\">\u003C/p>\n\u003Cp>Es la respuesta corta a &quot;¿cómo me fue?&quot;.\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>La frase de arriba\u003C/strong> dice si tu negocio \u003Cstrong>ganó\u003C/strong> (verde) o \u003Cstrong>perdió\u003C/strong> (rojo) en esos días.\u003C/li>\n\u003Cli>\u003Cstrong>Margen\u003C/strong>: de cada $100 que vendiste, cuántos te quedaron limpios.\u003C/li>\n\u003Cli>\u003Cstrong>Ventas\u003C/strong>: lo que vendiste, y cuánto es por día.\u003C/li>\n\u003Cli>\u003Cstrong>Gastos\u003C/strong>: lo que gastaste, y qué parte de tus ventas representa.\u003C/li>\n\u003Cli>\u003Cstrong>Resultado\u003C/strong>: ventas menos gastos. Verde es ganancia y rojo es pérdida.\u003C/li>\n\u003Cli>\u003Cstrong>Las flechas ▲ ▼\u003C/strong> comparan con el período anterior de la misma cantidad de días. En Ventas, ▲ es bueno. En Gastos, ▼ (gastaste menos) es bueno: por eso sale en verde.\u003C/li>\n\u003C/ul>\n\u003Cblockquote>\n\u003Cp>💡 \u003Cstrong>Consejo útil:\u003C/strong> si cargaste ventas pero no gastos, el resultado no aparece. Cargá tus gastos para conocer tu ganancia real.\u003C/p>\n\u003C/blockquote>\n\u003Cp>\u003Cimg src=\"/images/manual/100-reportes/101-06-kpis-principales.png\" alt=\"Cuatro tarjetas azules: Mesas 357, Cubiertos 1.186, Tickets Fiscales 0 y Días Analizados 90\">\u003C/p>\n\u003Cp>Las tarjetas azules cuentan cosas del período:\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Mesas\u003C/strong>: cuántas mesas cerraste.\u003C/li>\n\u003Cli>\u003Cstrong>Cubiertos\u003C/strong>: cuántas personas comieron.\u003C/li>\n\u003Cli>\u003Cstrong>Tickets Fiscales\u003C/strong>: cuántas facturas electrónicas o tickets fiscales emitiste. Si no facturás con el sistema, da 0.\u003C/li>\n\u003Cli>\u003Cstrong>Días Analizados\u003C/strong>: cuántos días abarcan las fechas que elegiste.\u003C/li>\n\u003C/ul>\n\u003Cp>Los nombres \u003Cstrong>Mesas\u003C/strong> y \u003Cstrong>Cubiertos\u003C/strong> pueden cambiar según cómo configuraste tu comercio.\u003C/p>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                💰 \u003Cstrong>Paso 6: Leé ventas y gastos\u003C/strong>\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-6-lee-ventas-y-gastos\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-6-lee-ventas-y-gastos\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/100-reportes/101-07-resumen-ventas-y-gastos.png\" alt=\"Paneles Resumen de Ventas, con total, descuentos, cobros y promedio, y Resumen de Gastos, con gastos totales, pagos, gastos fiscales e IVA compras\">\u003C/p>\n\u003Cp>\u003Cstrong>Resumen de Ventas\u003C/strong> (a la izquierda):\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Total de Ventas\u003C/strong>: la suma de todas las mesas cerradas.\u003C/li>\n\u003Cli>\u003Cstrong>Descuentos\u003C/strong>: cuánto se rebajó en total. Es la diferencia entre el precio sin descuento y lo que se cobró.\u003C/li>\n\u003Cli>\u003Cstrong>Cobros\u003C/strong>: la plata que entró en el período. Puede ser distinta de las ventas si hubo cobros parciales o pagos de otros días.\u003C/li>\n\u003Cli>\u003Cstrong>Promedio por Cubierto\u003C/strong>: cuánto gastó cada persona, en promedio.\u003C/li>\n\u003Cli>\u003Cstrong>Promedio por Mesa\u003C/strong>: cuánto se vendió por mesa, en promedio.\u003C/li>\n\u003C/ul>\n\u003Cp>\u003Cstrong>Resumen de Gastos\u003C/strong> (a la derecha):\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Gastos Totales\u003C/strong>: todo lo que cargaste como gasto.\u003C/li>\n\u003Cli>\u003Cstrong>Pagos Realizados\u003C/strong>: lo que ya pagaste de esos gastos. Si es menor, todavía debés plata.\u003C/li>\n\u003Cli>\u003Cstrong>Gastos Fiscales\u003C/strong>: los gastos que tienen factura.\u003C/li>\n\u003Cli>\u003Cstrong>IVA Compras\u003C/strong>: el IVA de esas facturas. Es un IVA que se descuenta a tu favor.\u003C/li>\n\u003C/ul>\n\u003Cblockquote>\n\u003Cp>💡 \u003Cstrong>Consejo útil:\u003C/strong> pasá el mouse por un número para ver un cartelito que explica de dónde sale.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                ⚖️ \u003Cstrong>Paso 7: Leé los saldos\u003C/strong>\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-7-lee-los-saldos\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-7-lee-los-saldos\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/100-reportes/101-08-saldos-y-estado-fiscal.png\" alt=\"Tres tarjetas: Saldo Operativo con la etiqueta verde Ganancia, Flujo de Caja con la etiqueta Positivo y Situación IVA con la etiqueta Saldo a favor\">\u003C/p>\n\u003Cp>Estas tres tarjetas resumen el resultado. Cada una tiene una etiqueta de color: verde es bueno y rojo es malo.\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Saldo Operativo\u003C/strong>: ventas menos gastos. La etiqueta dice \u003Cstrong>GANANCIA\u003C/strong> o \u003Cstrong>PÉRDIDA\u003C/strong>. Si tenés inversiones grandes (compra de equipos, obras), aparecen abajo aparte y \u003Cstrong>no\u003C/strong> se restan.\u003C/li>\n\u003Cli>\u003Cstrong>Flujo de Caja\u003C/strong>: cobros menos pagos. Es la plata que realmente entró y salió. Dice \u003Cstrong>POSITIVO\u003C/strong> o \u003Cstrong>NEGATIVO\u003C/strong>.\u003C/li>\n\u003Cli>\u003Cstrong>Situación IVA\u003C/strong>: el IVA de tus ventas menos el IVA de tus compras. \u003Cstrong>A PAGAR\u003C/strong> significa que le debés IVA a ARCA (ex AFIP). \u003Cstrong>SALDO A FAVOR\u003C/strong> significa que te queda a favor. Si el número está entre paréntesis, es a favor.\u003C/li>\n\u003C/ul>\n\u003Cp>Estas tarjetas aparecen solo si hay ventas y gastos en el período.\u003C/p>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🧮 \u003Cstrong>Paso 8: Leé la Contribución Marginal\u003C/strong>\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-8-lee-la-contribucion-marginal\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-8-lee-la-contribucion-marginal\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/100-reportes/101-09-contribucion-marginal.png\" alt=\"Panel Contribución Marginal con Ventas, Costos Variables, Contribución Marginal, Costos Fijos y otros, y Resultado Operativo\">\u003C/p>\n\u003Cp>Es una cuenta de izquierda a derecha, de las ventas al resultado:\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Ventas\u003C/strong>: lo que vendiste.\u003C/li>\n\u003Cli>\u003Cstrong>Costos Variables\u003C/strong>: gastos que suben y bajan con lo que vendés, como la mercadería.\u003C/li>\n\u003Cli>\u003Cstrong>Contribución Marginal\u003C/strong>: lo que sobra después de pagar esos costos. Entre paréntesis está el porcentaje sobre las ventas. Sirve para pagar los costos fijos.\u003C/li>\n\u003Cli>\u003Cstrong>Costos Fijos y otros\u003C/strong>: gastos que pagás venda o no venda, como el alquiler, más los gastos sin clasificar.\u003C/li>\n\u003Cli>\u003Cstrong>Resultado Operativo\u003C/strong>: lo que queda al final. Es el mismo número del Saldo Operativo.\u003C/li>\n\u003C/ul>\n\u003Cp>Si tu comercio cobra Ingresos Brutos, abajo aparece una línea con el impuesto \u003Cstrong>estimado\u003C/strong> y el resultado después de pagarlo.\u003C/p>\n\u003Cblockquote>\n\u003Cp>⚠️ \u003Cstrong>Atención:\u003C/strong> para que esta cuenta funcione, tenés que marcar cada clasificación de gastos como costo \u003Cstrong>fijo\u003C/strong> o \u003Cstrong>variable\u003C/strong>. Si no, en lugar de la cuenta ves un aviso celeste con un enlace a \u003Cstrong>Clasificaciones\u003C/strong>. Ahí elegís el \u003Cstrong>Tipo de costo\u003C/strong> de cada una.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🧾 \u003Cstrong>Paso 9: Facturación Electrónica y Métricas Operativas\u003C/strong>\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-9-facturacion-electronica-y-metricas-operativas\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-9-facturacion-electronica-y-metricas-operativas\">\u003C/div>\n\n\u003Cp>Estos dos paneles aparecen \u003Cstrong>solo si emitiste facturas electrónicas o cierres Z en las fechas elegidas\u003C/strong>. Si no, no se muestran. En el comercio de prueba no había facturas, por eso no hay foto.\u003C/p>\n\u003Cp>\u003Cstrong>Facturación Electrónica\u003C/strong>:\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Total Fiscal\u003C/strong>: todo lo que facturaste, con IVA.\u003C/li>\n\u003Cli>\u003Cstrong>Neto Fiscal\u003C/strong>: lo facturado sin el IVA.\u003C/li>\n\u003Cli>\u003Cstrong>IVA Ventas\u003C/strong>: el IVA de esas facturas.\u003C/li>\n\u003Cli>\u003Cstrong>Promedio Ticket\u003C/strong>: cuánto vale cada factura, en promedio.\u003C/li>\n\u003Cli>\u003Cstrong>Notas de Crédito\u003C/strong>: aparece si hiciste devoluciones o anulaciones. Ya están restadas del total.\u003C/li>\n\u003C/ul>\n\u003Cp>\u003Cstrong>Métricas Operativas\u003C/strong>:\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Promedio de Permanencia\u003C/strong>: cuánto tiempo se queda una mesa, en promedio. Se lee en horas, minutos y segundos. Dice \u003Cstrong>No disponible\u003C/strong> si no hay datos.\u003C/li>\n\u003C/ul>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🥧 \u003Cstrong>Paso 10: Leé los métodos de pago\u003C/strong>\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-10-lee-los-metodos-de-pago\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-10-lee-los-metodos-de-pago\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/100-reportes/101-10-grafico-metodos-de-pago.png\" alt=\"Gráfico de torta Métodos de Pago a la izquierda y lista Detalle por Método a la derecha con montos y porcentajes\">\u003C/p>\n\u003Cp>Muestra con qué te pagaron.\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>El gráfico de torta\u003C/strong>: cada color es un método de pago. Cuanto más grande el trozo, más plata entró por ahí. El número dentro es el porcentaje.\u003C/li>\n\u003Cli>\u003Cstrong>Detalle por Método\u003C/strong>: la misma información en lista, de mayor a menor. Cada renglón tiene el color, el nombre, el porcentaje y el monto.\u003C/li>\n\u003Cli>\u003Cstrong>Buscar método de pago\u003C/strong>: escribí un nombre y la lista muestra solo ese.\u003C/li>\n\u003C/ul>\n\u003Cp>Solo salen los métodos que tuvieron cobros.\u003C/p>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                📈 \u003Cstrong>Paso 11: Leé los gráficos por día\u003C/strong>\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-11-lee-los-graficos-por-dia\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-11-lee-los-graficos-por-dia\">\u003C/div>\n\n\u003Cp>Estos tres gráficos muestran \u003Cstrong>cada día\u003C/strong> del período. A la izquierda están los días más viejos y a la derecha los más nuevos. Pasá el mouse por un punto o una barra para ver el monto exacto.\u003C/p>\n\u003Cp>\u003Cimg src=\"/images/manual/100-reportes/101-11-grafico-evolucion-ventas-gastos.png\" alt=\"Gráfico de líneas Evolución de Ventas y Gastos con la línea verde de ventas y la roja de gastos\">\u003C/p>\n\u003Cp>\u003Cstrong>Evolución de Ventas y Gastos\u003C/strong>: la línea verde son las ventas, la roja son los gastos y la azul es lo facturado. Si la verde queda muy arriba de la roja, el negocio gana.\u003C/p>\n\u003Cp>\u003Cimg src=\"/images/manual/100-reportes/101-12-grafico-margen-de-ganancia.png\" alt=\"Gráfico de barras Margen de Ganancia por Día con barras verdes\">\u003C/p>\n\u003Cp>\u003Cstrong>Margen de Ganancia por Día\u003C/strong>: cada barra es un día. Es la venta menos los gastos de ese día. Una barra alta es un buen día. Solo aparece si cargaste gastos.\u003C/p>\n\u003Cp>\u003Cimg src=\"/images/manual/100-reportes/101-13-grafico-flujo-de-caja.png\" alt=\"Gráfico de barras Flujo de Caja por Día con barras azules\">\u003C/p>\n\u003Cp>\u003Cstrong>Flujo de Caja por Día\u003C/strong>: cada barra es la plata que cobraste menos la que pagaste ese día.\u003C/p>\n\u003Cblockquote>\n\u003Cp>💡 \u003Cstrong>Consejo útil:\u003C/strong> si un día no tuvo movimientos, la línea baja a cero y no hay barra. Los gastos suelen cargarse en pocos días, por eso se ven casi en cero.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🧩 \u003Cstrong>Paso 12: Mirá en qué gastás\u003C/strong>\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-12-mira-en-que-gastas\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-12-mira-en-que-gastas\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/100-reportes/101-14-grafico-gastos-por-clasificacion.png\" alt=\"Aviso amarillo Tu mayor gasto es Sin clasificar, gráfico de torta de Gastos por Clasificación y lista Detalle por Clasificación\">\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>El aviso amarillo\u003C/strong> te dice cuál es tu mayor gasto y qué parte de todos tus gastos es. Es el primer lugar para buscar ahorro.\u003C/li>\n\u003Cli>\u003Cstrong>Gastos por Clasificación\u003C/strong>: el gráfico de torta reparte tus gastos por tipo, como mercadería o sueldos. Cada color es un tipo.\u003C/li>\n\u003Cli>\u003Cstrong>Detalle por Clasificación\u003C/strong>: la lista con el monto de cada tipo, de mayor a menor.\u003C/li>\n\u003C/ul>\n\u003Cblockquote>\n\u003Cp>💡 \u003Cstrong>Consejo útil:\u003C/strong> si casi todo dice \u003Cstrong>Sin clasificar\u003C/strong>, no vas a saber en qué gastás. Cuando cargues un gasto, elegí su clasificación.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🗓️ \u003Cstrong>Paso 13: Leé las tablas por día\u003C/strong>\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-13-lee-las-tablas-por-dia\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-13-lee-las-tablas-por-dia\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/100-reportes/101-15-tabla-ventas-por-dia.png\" alt=\"Tabla Ventas por Día con las columnas Fecha, Mesas, Ventas, Promedio x Ticket, Cubiertos, Promedio x Cubierto, Cobros y Fiscal\">\u003C/p>\n\u003Cp>\u003Cstrong>Ventas por Día\u003C/strong>: una fila por día, del más nuevo al más viejo. En la foto se ven los primeros días; en pantalla ves todos.\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Fecha\u003C/strong>: el día.\u003C/li>\n\u003Cli>\u003Cstrong>Mesas\u003C/strong>: cuántas mesas cerraste.\u003C/li>\n\u003Cli>\u003Cstrong>Ventas\u003C/strong>: el total vendido.\u003C/li>\n\u003Cli>\u003Cstrong>Promedio x Ticket\u003C/strong>: ventas dividido mesas.\u003C/li>\n\u003Cli>\u003Cstrong>Cubiertos\u003C/strong>: cuántas personas.\u003C/li>\n\u003Cli>\u003Cstrong>Promedio x Cubierto\u003C/strong>: lo que gastó cada persona.\u003C/li>\n\u003Cli>\u003Cstrong>Cobros\u003C/strong>: lo que cobraste ese día.\u003C/li>\n\u003Cli>\u003Cstrong>Fiscal (Tickets)\u003C/strong>: lo facturado. Entre paréntesis está la cantidad de facturas.\u003C/li>\n\u003C/ul>\n\u003Cp>\u003Cimg src=\"/images/manual/100-reportes/101-16-tabla-gastos-por-dia.png\" alt=\"Tabla Gastos por Día con las columnas Fecha, Gasto Sin IVA, Total y Pagos\">\u003C/p>\n\u003Cp>\u003Cstrong>Gastos por Día\u003C/strong>:\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Fecha\u003C/strong>: el día.\u003C/li>\n\u003Cli>\u003Cstrong>Gasto Sin IVA\u003C/strong>: el gasto sin el impuesto.\u003C/li>\n\u003Cli>\u003Cstrong>Total\u003C/strong>: el gasto con IVA.\u003C/li>\n\u003Cli>\u003Cstrong>Pagos\u003C/strong>: lo que pagaste ese día.\u003C/li>\n\u003C/ul>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                ⚠️ \u003Cstrong>Resolución de Inconvenientes\u003C/strong>\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"resolucion-de-inconvenientes\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"resolucion-de-inconvenientes\">\u003C/div>\n\n\u003Cdiv class=\"table-wrapper\">\u003Ctable>\n\u003Cthead>\n\u003Ctr>\n\u003Cth>Problema\u003C/th>\n\u003Cth>Causa más frecuente\u003C/th>\n\u003Cth>Solución recomendada\u003C/th>\n\u003C/tr>\n\u003C/thead>\n\u003Ctbody>\u003Ctr>\n\u003Ctd>\u003Cstrong>&quot;No hay movimientos en el período seleccionado&quot;\u003C/strong>\u003C/td>\n\u003Ctd>No hay ventas ni gastos en esas fechas\u003C/td>\n\u003Ctd>Ampliá el rango con \u003Cstrong>Desde\u003C/strong> y \u003Cstrong>Hasta\u003C/strong>, o probá otro centro de costo.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>No veo los gráficos\u003C/td>\n\u003Ctd>El rango es de 180 días o más, o no hay ventas\u003C/td>\n\u003Ctd>Elegí menos de 180 días y tocá \u003Cstrong>Actualizar Datos\u003C/strong>.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>No veo \u003Cstrong>Resultado\u003C/strong>, \u003Cstrong>Saldo Operativo\u003C/strong> ni \u003Cstrong>Contribución Marginal\u003C/strong>\u003C/td>\n\u003Ctd>No hay gastos cargados en el período\u003C/td>\n\u003Ctd>Cargá tus gastos y volvé a mirar.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>En lugar de la Contribución Marginal veo un aviso celeste\u003C/td>\n\u003Ctd>Las clasificaciones no tienen tipo de costo\u003C/td>\n\u003Ctd>Tocá el enlace \u003Cstrong>Clasificaciones\u003C/strong> y elegí fijo o variable en cada una.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>No veo \u003Cstrong>Facturación Electrónica\u003C/strong> ni \u003Cstrong>Métricas Operativas\u003C/strong>\u003C/td>\n\u003Ctd>No hay facturas electrónicas en las fechas\u003C/td>\n\u003Ctd>Es normal si no facturás con el sistema. Probá otro rango.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>Todo el gasto dice \u003Cstrong>Sin clasificar\u003C/strong>\u003C/td>\n\u003Ctd>Los gastos se cargaron sin clasificación\u003C/td>\n\u003Ctd>Clasificá los gastos al cargarlos.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>Ventas\u003C/strong> y \u003Cstrong>Cobros\u003C/strong> no coinciden\u003C/td>\n\u003Ctd>Hubo cobros parciales o pagos de otros días\u003C/td>\n\u003Ctd>Es normal. Los \u003Cstrong>Cobros\u003C/strong> cuentan la plata del período.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>El día no cierra a medianoche\u003C/td>\n\u003Ctd>Cada día se cuenta desde la hora de corte (ej. 06:00)\u003C/td>\n\u003Ctd>Es a propósito: una venta de madrugada cuenta para el día anterior.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>No veo el menú \u003Cstrong>Reportes\u003C/strong>\u003C/td>\n\u003Ctd>Tu usuario no tiene el permiso\u003C/td>\n\u003Ctd>Pedile al dueño que te lo dé en \u003Ca href=\"/user-guide/permisos-por-rol\">Permisos por Rol\u003C/a>.\u003C/td>\n\u003C/tr>\n\u003C/tbody>\u003C/table>\u003C/div>\n",[5,9,12,15,18,21,24,27,30,33,36,39,42,45,48],{"id":6,"title":7,"level":8},"antes-de-empezar","Antes de empezar",2,{"id":10,"title":11,"level":8},"paso-1-entra-a-la-pantalla","Paso 1: Entrá a la pantalla",{"id":13,"title":14,"level":8},"paso-2-los-botones-de-arriba","Paso 2: Los botones de arriba",{"id":16,"title":17,"level":8},"paso-3-elegi-un-centro-de-costo","Paso 3: Elegí un centro de costo (si tenés)",{"id":19,"title":20,"level":8},"paso-4-elegi-las-fechas","Paso 4: Elegí las fechas",{"id":22,"title":23,"level":8},"paso-5-lee-el-resumen-de-arriba","Paso 5: Leé el resumen de arriba",{"id":25,"title":26,"level":8},"paso-6-lee-ventas-y-gastos","Paso 6: Leé ventas y gastos",{"id":28,"title":29,"level":8},"paso-7-lee-los-saldos","Paso 7: Leé los saldos",{"id":31,"title":32,"level":8},"paso-8-lee-la-contribucion-marginal","Paso 8: Leé la Contribución Marginal",{"id":34,"title":35,"level":8},"paso-9-facturacion-electronica-y-metricas-operativas","Paso 9: Facturación Electrónica y Métricas Operativas",{"id":37,"title":38,"level":8},"paso-10-lee-los-metodos-de-pago","Paso 10: Leé los métodos de pago",{"id":40,"title":41,"level":8},"paso-11-lee-los-graficos-por-dia","Paso 11: Leé los gráficos por día",{"id":43,"title":44,"level":8},"paso-12-mira-en-que-gastas","Paso 12: Mirá en qué gastás",{"id":46,"title":47,"level":8},"paso-13-lee-las-tablas-por-dia","Paso 13: Leé las tablas por día",{"id":49,"title":50,"level":8},"resolucion-de-inconvenientes","Resolución de Inconvenientes",{"title":52,"description":53,"keywords":54},"Tablero General - Manual","¿Dónde está en el sistema?: Menú principal → Reportes → Tablero General. Está debajo del título GENERAL.\n ¿Quién lo usa?: Dueños de lo...","tablero general, paxapos, tablero general, tutorial, guía, manual usuario","101-tablero-general.txt"],"uses":{"params":["slug"]}}]}
