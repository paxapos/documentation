{"type":"data","nodes":[null,{"type":"data","data":[{"moduleCategories":1},[2,17,44,53,77,98,110,140,146,173,185,221,250],{"title":3,"modules":4},"Comenzamos",[5,8,11,14],{"slug":6,"title":7},"introduccion","Bienvenido a tu software gastronómico",{"slug":9,"title":10},"iniciar-sesion","Cómo Iniciar Sesión",{"slug":12,"title":13},"recuperar-contrasena","Cómo Recuperar tu Contraseña",{"slug":15,"title":16},"guia-de-inicio-rapido","Guía de Inicio Rápido",{"title":18,"modules":19},"Ventas",[20,23,26,29,32,35,38,41],{"slug":21,"title":22},"salon-de-ventas","Cómo Usar el Salón de Ventas (Adición)",{"slug":24,"title":25},"caja-rapida","Cómo Usar la Caja Rápida (Registradora)",{"slug":27,"title":28},"mozos","Cómo Cargar los Mozos",{"slug":30,"title":31},"clientes","Cómo Gestionar los Clientes",{"slug":33,"title":34},"descuentos","Cómo Configurar Descuentos",{"slug":36,"title":37},"nueva-reserva","Cómo Cargar una Nueva Reserva",{"slug":39,"title":40},"listado-de-reservas","Cómo Usar el Listado de Reservas",{"slug":42,"title":43},"grilla-de-reservas","Cómo Usar la Grilla de Reservas",{"title":45,"modules":46},"Medios de Pago",[47,50],{"slug":48,"title":49},"configuracion-procesadores","Configuración de Procesadores de Pago",{"slug":51,"title":52},"transacciones-mercadopago","Transacciones MercadoPago",{"title":54,"modules":55},"Productos",[56,59,62,65,68,71,74],{"slug":57,"title":58},"menu","Menú de Productos (Carta)",{"slug":60,"title":61},"categorias","Categorías de Productos",{"slug":63,"title":64},"variantes-grupo-sabores","Variantes y Grupos de Sabores",{"slug":66,"title":67},"maestro-de-productos","Maestro de Productos",{"slug":69,"title":70},"subproductos-elaborados","Sub-Productos (Elaborados)",{"slug":72,"title":73},"recetas","Recetas",{"slug":75,"title":76},"analisis-duplicados","Buscar Duplicados",{"title":78,"modules":79},"Compras",[80,83,86,89,92,95],{"slug":81,"title":82},"todas-las-ordenes-compra","Órdenes de Compra",{"slug":84,"title":85},"crear-orden-compra","Crear una Orden de Compra",{"slug":87,"title":88},"ordenes-a-aprobar","Órdenes a aprobar",{"slug":90,"title":91},"mercaderias","Mercaderías",{"slug":93,"title":94},"proveedores","Proveedores",{"slug":96,"title":97},"historial-de-compras","Historial de Compras",{"title":99,"modules":100},"Stock",[101,104,107],{"slug":102,"title":103},"stock-mercaderias","Stock de Mercaderías",{"slug":105,"title":106},"stock-subproductos","Stock de Subproductos",{"slug":108,"title":109},"movimientos-de-stock","Movimientos de Stock",{"title":111,"modules":112},"Finanzas",[113,116,119,122,125,128,131,134,137],{"slug":114,"title":115},"arqueos-de-caja","Arqueos de Caja",{"slug":117,"title":118},"listado-de-cajas","Listado de Cajas",{"slug":120,"title":121},"transacciones-de-cobro","Transacciones de Cobro",{"slug":123,"title":124},"factura-manual","Factura Manual",{"slug":126,"title":127},"resumen-de-deuda","Resumen de Deuda",{"slug":129,"title":130},"pagos","Pagos",{"slug":132,"title":133},"historial-de-facturas","Historial de Facturas",{"slug":135,"title":136},"historico-de-mesas","Histórico de Mesas",{"slug":138,"title":139},"puntos-de-venta-pdv","Puntos de Venta (PDVs)",{"title":141,"modules":142},"Comandero",[143],{"slug":144,"title":145},"comandero","Comandero (pantalla de cocina)",{"title":147,"modules":148},"RRHH",[149,152,155,158,161,164,167,170],{"slug":150,"title":151},"empleados","Empleados",{"slug":153,"title":154},"empleados-trabajando","Empleados Trabajando",{"slug":156,"title":157},"registro-diario-fichaje","Registro Diario de Fichaje",{"slug":159,"title":160},"reporte-mensual-fichaje","Reporte Mensual de Fichaje",{"slug":162,"title":163},"departamentos","Departamentos",{"slug":165,"title":166},"turnos-y-horarios-fichaje","Turnos y Horarios de Fichaje",{"slug":168,"title":169},"sueldos-y-jornales","Sueldos y Jornales",{"slug":171,"title":172},"datos-de-acceso-app","Datos de Acceso a la App de Fichaje",{"title":174,"modules":175},"Reportes",[176,179,182],{"slug":177,"title":178},"tablero-general","Tablero General",{"slug":180,"title":181},"productos-mas-vendidos","Productos Más Vendidos",{"slug":183,"title":184},"compras-por-mercaderia","Compras por Mercadería",{"title":186,"modules":187},"Configuracion",[188,191,194,197,200,203,206,209,212,215,218],{"slug":189,"title":190},"configuracion-general","Configuración general",{"slug":192,"title":193},"impresoras","Cómo cargar las impresoras del local",{"slug":195,"title":196},"perfiles-de-impresion","Cómo usar los perfiles de impresión",{"slug":198,"title":199},"usuarios-del-sistema","Cómo administrar los Usuarios del Sistema",{"slug":201,"title":202},"usuarios-con-pin","Cómo administrar los Usuarios con PIN",{"slug":204,"title":205},"punto-de-venta","🏛️ Trámite en ARCA (con clave fiscal)",{"slug":207,"title":208},"permisos-por-rol","Cómo configurar los Permisos por Rol",{"slug":210,"title":211},"turnos-mesa","Turnos de Mesa",{"slug":213,"title":214},"medios-de-cobro","Medios de cobro",{"slug":216,"title":217},"clasificacion-de-gastos","Clasificación de Gastos",{"slug":219,"title":220},"centros-de-costo","Centros de Costo",{"title":222,"modules":223},"Biblioteca de Drivers",[224,226,229,232,235,238,241,244,247],{"slug":225,"title":222},"biblioteca-de-drivers",{"slug":227,"title":228},"sam4s-giant-100","Sam4S Giant - 100",{"slug":230,"title":231},"citizen-ct-s310ii","Citizen CT-S310II",{"slug":233,"title":234},"epson-tm-t20","Epson TM-T20",{"slug":236,"title":237},"drivers-genericos","Drivers Genéricos POS",{"slug":239,"title":240},"epson-tm-t88","Epson TM-T88V",{"slug":242,"title":243},"fiscalberry-windows","Instalar Fiscalberry en Windows",{"slug":245,"title":246},"fiscalberry-linux","Instalar Fiscalberry en Linux",{"slug":248,"title":249},"fiscalberry-android","Instalar Fiscalberry en Android",{"title":251,"modules":252},"Extra",[253,256,259,262,265,268,271,274,277,280],{"slug":254,"title":255},"01-faq-solucion-inicial-pantalla-congelada","📖 Manual de Usuario: Solución Inicial si la Pantalla se Congela o no Carga",{"slug":257,"title":258},"03-faq-mozo-reabrir-mesa-anulada","📖 Manual de Usuario: Cómo Reabrir una Mesa Anulada o Cerrada por Error",{"slug":260,"title":261},"05-faq-cajero-emitir-factura-a","📖 Manual de Usuario: Cómo Emitir una Factura A Cargando Datos del Cliente",{"slug":263,"title":264},"06-faq-cajero-ingreso-egreso-cajon","📖 Manual de Usuario: Cómo Registrar Entradas y Salidas de Dinero del Cajón",{"slug":266,"title":267},"07-faq-cajero-activar-medio-pago","📖 Manual de Usuario: Cómo Activar un Medio de Pago que no Aparece al Cobrar",{"slug":269,"title":270},"08-faq-cajero-diferencia-facturado-vs-abiertas","📖 Manual de Usuario: Diferencia entre \"Facturado Total Mesas\" y \"Abiertas Por Usuario\" en Caja",{"slug":272,"title":273},"10-faq-supervisor-cierre-caja-diferencias","📖 Manual de Usuario: Cómo Auditar y Solucionar Diferencias en el Cierre de Caja",{"slug":275,"title":276},"preguntas-frecuentes","Preguntas Frecuentes y Guías Rápidas por Rol",{"slug":278,"title":279},"buchon-bot","Buchón Bot",{"slug":281,"title":282},"troubleshooting-semantico","📖 Guía Única de Resolución de Problemas y Errores (Troubleshooting)"],"uses":{}},{"type":"data","data":[{"slug":1,"title":2,"content":3,"tableOfContents":4,"seo":24,"llmTxtFile":28},"descuentos","Cómo Configurar Descuentos","\u003Cdiv id=\"descuentos\">\u003C/div>\n\n\u003Cblockquote>\n\u003Cp>\u003Cstrong>¿Dónde está en el sistema?:\u003C/strong> Menú principal → \u003Cstrong>Ventas\u003C/strong> → \u003Cstrong>Descuentos\u003C/strong>\u003Cbr>\u003Cstrong>¿Quién lo usa?:\u003C/strong> Encargados y administradores\u003C/p>\n\u003C/blockquote>\n\u003Cblockquote>\n\u003Cp>🎯 \u003Cstrong>¿Para qué sirve esto?\u003C/strong>\nAcá creás descuentos listos para usar. Por ejemplo: \u003Cem>10% Empleados\u003C/em> o \u003Cem>Cliente VIP\u003C/em>. Después los aplicás en una mesa o en la Caja Rápida sin hacer cuentas.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                📍 \u003Cstrong>Paso 1: Entrá al listado de Descuentos\u003C/strong>\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-1-entra-al-listado-de-descuentos\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-1-entra-al-listado-de-descuentos\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/26-00a-menu-grupo-ventas.png\" alt=\"Grupo Ventas del menú lateral, marcado en rojo\">\u003C/p>\n\u003Col>\n\u003Cli>En el menú de la izquierda, tocá \u003Cstrong>Ventas\u003C/strong>. Se despliegan sus opciones.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/26-00b-menu-opcion-descuentos.png\" alt=\"Opción Descuentos dentro del grupo Ventas, marcada en rojo\">\u003C/p>\n\u003Col start=\"2\">\n\u003Cli>Bajá hasta la parte \u003Cstrong>Clientes\u003C/strong> y tocá \u003Cstrong>Descuentos\u003C/strong>.\u003C/li>\n\u003Cli>Se abre el listado con los descuentos que ya existen.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/12-descuentos-listado.png\" alt=\"Listado de descuentos con el buscador arriba y la tabla abajo\">\u003C/p>\n\u003Cp>En esta pantalla vas a ver:\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Arriba a la derecha:\u003C/strong> el botón verde \u003Cstrong>Crear Descuento\u003C/strong>.\u003C/li>\n\u003Cli>\u003Cstrong>En el medio:\u003C/strong> el buscador por \u003Cstrong>Nombre del Descuento\u003C/strong>.\u003C/li>\n\u003Cli>\u003Cstrong>Abajo:\u003C/strong> la tabla con cada descuento, su porcentaje y sus botones \u003Cstrong>Editar\u003C/strong> y \u003Cstrong>Borrar\u003C/strong>.\u003C/li>\n\u003C/ul>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🔍 \u003Cstrong>Paso 2: Buscá un descuento\u003C/strong>\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-2-busca-un-descuento\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-2-busca-un-descuento\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/26-04-campo-name.png\" alt=\"Casillero Nombre del Descuento\">\u003C/p>\n\u003Col>\n\u003Cli>En \u003Cstrong>Nombre del Descuento\u003C/strong>, escribí una parte del nombre. Por ejemplo: \u003Cem>10\u003C/em>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/26-05-donde-esta-boton-buscar.png\" alt=\"Listado con el botón Buscar marcado en rojo\">\u003C/p>\n\u003Col start=\"2\">\n\u003Cli>Tocá el botón azul \u003Cstrong>Buscar\u003C/strong>.\u003C/li>\n\u003Cli>La tabla muestra solo los descuentos que coinciden.\u003C/li>\n\u003C/ol>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                ➕ \u003Cstrong>Paso 3: Creá un descuento nuevo\u003C/strong>\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-3-crea-un-descuento-nuevo\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-3-crea-un-descuento-nuevo\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/26-02-donde-esta-boton-crear-descuento.png\" alt=\"Listado con el botón Crear Descuento marcado en rojo\">\u003C/p>\n\u003Col>\n\u003Cli>Tocá el botón verde \u003Cstrong>Crear Descuento\u003C/strong>, arriba a la derecha.\u003C/li>\n\u003Cli>Se abre la pantalla \u003Cstrong>Crear Descuento\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/13-descuentos-nuevo-formulario.png\" alt=\"Pantalla Crear Descuento con Nombre, Descripción y Porcentaje\">\u003C/p>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/26-11-campo-nombre.png\" alt=\"Casillero Nombre con el texto Empleados 10%\">\u003C/p>\n\u003Col start=\"3\">\n\u003Cli>En \u003Cstrong>Nombre\u003C/strong>, escribí un nombre corto. Por ejemplo: \u003Cem>Empleados 10%\u003C/em>. Es el que vas a ver al aplicarlo.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/26-12-campo-description.png\" alt=\"Casillero Descripción\">\u003C/p>\n\u003Col start=\"4\">\n\u003Cli>En \u003Cstrong>Descripción\u003C/strong>, podés anotar para qué es. Por ejemplo: \u003Cem>Descuento para el personal\u003C/em>. Es opcional.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/26-13-campo-porcentaje.png\" alt=\"Casillero Porcentaje con el número 10\">\u003C/p>\n\u003Col start=\"5\">\n\u003Cli>En \u003Cstrong>Porcentaje\u003C/strong>, escribí \u003Cstrong>solo el número\u003C/strong>, sin el signo %. Por ejemplo: \u003Cem>10\u003C/em>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/26-14-donde-esta-boton-agregar.png\" alt=\"Pantalla Crear Descuento con el botón Agregar marcado en rojo\">\u003C/p>\n\u003Col start=\"6\">\n\u003Cli>Tocá el botón verde \u003Cstrong>Agregar\u003C/strong>, abajo a la izquierda.\u003C/li>\n\u003Cli>El descuento queda guardado y aparece en el listado.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/26-16-donde-esta-boton-cancelar.png\" alt=\"Pantalla Crear Descuento con el botón Cancelar marcado en rojo\">\u003C/p>\n\u003Cul>\n\u003Cli>Si no querés guardarlo, tocá \u003Cstrong>Cancelar\u003C/strong>, abajo a la derecha.\u003C/li>\n\u003C/ul>\n\u003Cblockquote>\n\u003Cp>💡 \u003Cstrong>Consejo útil:\u003C/strong> El descuento se calcula sobre el total de la cuenta cuando lo aplicás en el \u003Ca href=\"/user-guide/salon-de-ventas\">Salón de Ventas\u003C/a>.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                ✏️ \u003Cstrong>Paso 4: Cambiá o borrá un descuento\u003C/strong>\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-4-cambia-o-borra-un-descuento\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-4-cambia-o-borra-un-descuento\">\u003C/div>\n\n\u003Cp>A la derecha de cada descuento hay dos botones:\u003C/p>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/40-descuentos-botones-accion.png\" alt=\"Botones Editar y Borrar de un descuento\">\u003C/p>\n\u003Ch3>Cambiar un descuento\u003C/h3>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/26-07-donde-esta-boton-editar.png\" alt=\"Listado con el botón Editar marcado en rojo\">\u003C/p>\n\u003Col>\n\u003Cli>Tocá \u003Cstrong>Editar\u003C/strong> en el descuento que querés cambiar.\u003C/li>\n\u003Cli>Cambiá el nombre, la descripción o el porcentaje.\u003C/li>\n\u003Cli>Tocá el botón verde \u003Cstrong>Actualizar\u003C/strong> para guardar.\u003C/li>\n\u003C/ol>\n\u003Ch3>Borrar un descuento\u003C/h3>\n\u003Cblockquote>\n\u003Cp>⚠️ \u003Cstrong>Atención:\u003C/strong> Borrar un descuento no se puede deshacer.\u003C/p>\n\u003C/blockquote>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/26-09-donde-esta-boton-borrar.png\" alt=\"Listado con el botón rojo Borrar marcado\">\u003C/p>\n\u003Col>\n\u003Cli>Tocá el botón rojo \u003Cstrong>Borrar\u003C/strong>.\u003C/li>\n\u003Cli>El sistema te pregunta si estás seguro. Tocá \u003Cstrong>Aceptar\u003C/strong> para borrarlo.\u003C/li>\n\u003C/ol>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🔒 \u003Cstrong>¿Qué descuentos puede usar un mozo?\u003C/strong>\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"que-descuentos-puede-usar-un-mozo\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"que-descuentos-puede-usar-un-mozo\">\u003C/div>\n\n\u003Cul>\n\u003Cli>Hay un \u003Cstrong>tope\u003C/strong> para los mozos. Se define en \u003Cstrong>Configuración\u003C/strong> → \u003Cstrong>Configuración general\u003C/strong> → \u003Cstrong>Ventas y salón\u003C/strong>, en \u003Cem>Porcentaje máximo de descuento que puede hacer un mozo\u003C/em>.\u003C/li>\n\u003Cli>Los usuarios sin permiso para \u003Cstrong>agregar descuentos\u003C/strong> en el Salón de Ventas solo ven los descuentos que no pasan ese tope.\u003C/li>\n\u003Cli>Para usar un descuento más grande, tiene que aplicarlo alguien con ese permiso (por ejemplo, el encargado).\u003C/li>\n\u003C/ul>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                ⚠️ \u003Cstrong>Resolución de Inconvenientes\u003C/strong>\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"resolucion-de-inconvenientes\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"resolucion-de-inconvenientes\">\u003C/div>\n\n\u003Cdiv class=\"table-wrapper\">\u003Ctable>\n\u003Cthead>\n\u003Ctr>\n\u003Cth>Problema\u003C/th>\n\u003Cth>Causa más frecuente\u003C/th>\n\u003Cth>Solución recomendada\u003C/th>\n\u003C/tr>\n\u003C/thead>\n\u003Ctbody>\u003Ctr>\n\u003Ctd>\u003Cstrong>No veo el botón Crear Descuento\u003C/strong>\u003C/td>\n\u003Ctd>Tu usuario no tiene permiso para los clientes y descuentos.\u003C/td>\n\u003Ctd>Pedile al administrador que lo revise en \u003Ca href=\"/user-guide/permisos-por-rol\">Permisos por Rol\u003C/a>.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>El listado muestra solo algunos descuentos\u003C/strong>\u003C/td>\n\u003Ctd>Tu usuario no tiene permiso para agregar descuentos: solo ve los que no pasan el tope.\u003C/td>\n\u003Ctd>Pedile al encargado que aplique el descuento, o que revise el tope.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>El mozo no puede aplicar un descuento\u003C/strong>\u003C/td>\n\u003Ctd>El descuento es más grande que el tope de los mozos.\u003C/td>\n\u003Ctd>Que lo aplique un encargado con permiso para agregar descuentos.\u003C/td>\n\u003C/tr>\n\u003C/tbody>\u003C/table>\u003C/div>\n",[5,9,12,15,18,21],{"id":6,"title":7,"level":8},"paso-1-entra-al-listado-de-descuentos","Paso 1: Entrá al listado de Descuentos",2,{"id":10,"title":11,"level":8},"paso-2-busca-un-descuento","Paso 2: Buscá un descuento",{"id":13,"title":14,"level":8},"paso-3-crea-un-descuento-nuevo","Paso 3: Creá un descuento nuevo",{"id":16,"title":17,"level":8},"paso-4-cambia-o-borra-un-descuento","Paso 4: Cambiá o borrá un descuento",{"id":19,"title":20,"level":8},"que-descuentos-puede-usar-un-mozo","¿Qué descuentos puede usar un mozo?",{"id":22,"title":23,"level":8},"resolucion-de-inconvenientes","Resolución de Inconvenientes",{"title":25,"description":26,"keywords":27},"Cómo Configurar Descuentos - Manual","¿Dónde está en el sistema?: Menú principal → Ventas → Descuentos  \n ¿Quién lo usa?: Encargados y administradores","descuentos, paxapos, cómo configurar descuentos, tutorial, guía, manual usuario","26-descuentos.txt"],"uses":{"params":["slug"]}}]}
