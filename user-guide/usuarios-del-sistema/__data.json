{"type":"data","nodes":[null,{"type":"data","data":[{"moduleCategories":1},[2,17,44,53,77,98,110,140,146,173,185,221,250],{"title":3,"modules":4},"Comenzamos",[5,8,11,14],{"slug":6,"title":7},"introduccion","Bienvenido a tu software gastronómico",{"slug":9,"title":10},"iniciar-sesion","Cómo Iniciar Sesión",{"slug":12,"title":13},"recuperar-contrasena","Cómo Recuperar tu Contraseña",{"slug":15,"title":16},"guia-de-inicio-rapido","Guía de Inicio Rápido",{"title":18,"modules":19},"Ventas",[20,23,26,29,32,35,38,41],{"slug":21,"title":22},"salon-de-ventas","Cómo Usar el Salón de Ventas (Adición)",{"slug":24,"title":25},"caja-rapida","Cómo Usar la Caja Rápida (Registradora)",{"slug":27,"title":28},"mozos","Cómo Cargar los Mozos",{"slug":30,"title":31},"clientes","Cómo Gestionar los Clientes",{"slug":33,"title":34},"descuentos","Cómo Configurar Descuentos",{"slug":36,"title":37},"nueva-reserva","Cómo Cargar una Nueva Reserva",{"slug":39,"title":40},"listado-de-reservas","Cómo Usar el Listado de Reservas",{"slug":42,"title":43},"grilla-de-reservas","Cómo Usar la Grilla de Reservas",{"title":45,"modules":46},"Medios de Pago",[47,50],{"slug":48,"title":49},"configuracion-procesadores","Configuración de Procesadores de Pago",{"slug":51,"title":52},"transacciones-mercadopago","Transacciones MercadoPago",{"title":54,"modules":55},"Productos",[56,59,62,65,68,71,74],{"slug":57,"title":58},"menu","Menú de Productos (Carta)",{"slug":60,"title":61},"categorias","Categorías de Productos",{"slug":63,"title":64},"variantes-grupo-sabores","Variantes y Grupos de Sabores",{"slug":66,"title":67},"maestro-de-productos","Maestro de Productos",{"slug":69,"title":70},"subproductos-elaborados","Sub-Productos (Elaborados)",{"slug":72,"title":73},"recetas","Recetas",{"slug":75,"title":76},"analisis-duplicados","Buscar Duplicados",{"title":78,"modules":79},"Compras",[80,83,86,89,92,95],{"slug":81,"title":82},"todas-las-ordenes-compra","Órdenes de Compra",{"slug":84,"title":85},"crear-orden-compra","Crear una Orden de Compra",{"slug":87,"title":88},"ordenes-a-aprobar","Órdenes a aprobar",{"slug":90,"title":91},"mercaderias","Mercaderías",{"slug":93,"title":94},"proveedores","Proveedores",{"slug":96,"title":97},"historial-de-compras","Historial de Compras",{"title":99,"modules":100},"Stock",[101,104,107],{"slug":102,"title":103},"stock-mercaderias","Stock de Mercaderías",{"slug":105,"title":106},"stock-subproductos","Stock de Subproductos",{"slug":108,"title":109},"movimientos-de-stock","Movimientos de Stock",{"title":111,"modules":112},"Finanzas",[113,116,119,122,125,128,131,134,137],{"slug":114,"title":115},"arqueos-de-caja","Arqueos de Caja",{"slug":117,"title":118},"listado-de-cajas","Listado de Cajas",{"slug":120,"title":121},"transacciones-de-cobro","Transacciones de Cobro",{"slug":123,"title":124},"factura-manual","Factura Manual",{"slug":126,"title":127},"resumen-de-deuda","Resumen de Deuda",{"slug":129,"title":130},"pagos","Pagos",{"slug":132,"title":133},"historial-de-facturas","Historial de Facturas",{"slug":135,"title":136},"historico-de-mesas","Histórico de Mesas",{"slug":138,"title":139},"puntos-de-venta-pdv","Puntos de Venta (PDVs)",{"title":141,"modules":142},"Comandero",[143],{"slug":144,"title":145},"comandero","Comandero (pantalla de cocina)",{"title":147,"modules":148},"RRHH",[149,152,155,158,161,164,167,170],{"slug":150,"title":151},"empleados","Empleados",{"slug":153,"title":154},"empleados-trabajando","Empleados Trabajando",{"slug":156,"title":157},"registro-diario-fichaje","Registro Diario de Fichaje",{"slug":159,"title":160},"reporte-mensual-fichaje","Reporte Mensual de Fichaje",{"slug":162,"title":163},"departamentos","Departamentos",{"slug":165,"title":166},"turnos-y-horarios-fichaje","Turnos y Horarios de Fichaje",{"slug":168,"title":169},"sueldos-y-jornales","Sueldos y Jornales",{"slug":171,"title":172},"datos-de-acceso-app","Datos de Acceso a la App de Fichaje",{"title":174,"modules":175},"Reportes",[176,179,182],{"slug":177,"title":178},"tablero-general","Tablero General",{"slug":180,"title":181},"productos-mas-vendidos","Productos Más Vendidos",{"slug":183,"title":184},"compras-por-mercaderia","Compras por Mercadería",{"title":186,"modules":187},"Configuracion",[188,191,194,197,200,203,206,209,212,215,218],{"slug":189,"title":190},"configuracion-general","Configuración general",{"slug":192,"title":193},"impresoras","Cómo cargar las impresoras del local",{"slug":195,"title":196},"perfiles-de-impresion","Cómo usar los perfiles de impresión",{"slug":198,"title":199},"usuarios-del-sistema","Cómo administrar los Usuarios del Sistema",{"slug":201,"title":202},"usuarios-con-pin","Cómo administrar los Usuarios con PIN",{"slug":204,"title":205},"punto-de-venta","🏛️ Trámite en ARCA (con clave fiscal)",{"slug":207,"title":208},"permisos-por-rol","Cómo configurar los Permisos por Rol",{"slug":210,"title":211},"turnos-mesa","Turnos de Mesa",{"slug":213,"title":214},"medios-de-cobro","Medios de cobro",{"slug":216,"title":217},"clasificacion-de-gastos","Clasificación de Gastos",{"slug":219,"title":220},"centros-de-costo","Centros de Costo",{"title":222,"modules":223},"Biblioteca de Drivers",[224,226,229,232,235,238,241,244,247],{"slug":225,"title":222},"biblioteca-de-drivers",{"slug":227,"title":228},"sam4s-giant-100","Sam4S Giant - 100",{"slug":230,"title":231},"citizen-ct-s310ii","Citizen CT-S310II",{"slug":233,"title":234},"epson-tm-t20","Epson TM-T20",{"slug":236,"title":237},"drivers-genericos","Drivers Genéricos POS",{"slug":239,"title":240},"epson-tm-t88","Epson TM-T88V",{"slug":242,"title":243},"fiscalberry-windows","Instalar Fiscalberry en Windows",{"slug":245,"title":246},"fiscalberry-linux","Instalar Fiscalberry en Linux",{"slug":248,"title":249},"fiscalberry-android","Instalar Fiscalberry en Android",{"title":251,"modules":252},"Extra",[253,256,259,262,265,268,271,274,277,280],{"slug":254,"title":255},"01-faq-solucion-inicial-pantalla-congelada","📖 Manual de Usuario: Solución Inicial si la Pantalla se Congela o no Carga",{"slug":257,"title":258},"03-faq-mozo-reabrir-mesa-anulada","📖 Manual de Usuario: Cómo Reabrir una Mesa Anulada o Cerrada por Error",{"slug":260,"title":261},"05-faq-cajero-emitir-factura-a","📖 Manual de Usuario: Cómo Emitir una Factura A Cargando Datos del Cliente",{"slug":263,"title":264},"06-faq-cajero-ingreso-egreso-cajon","📖 Manual de Usuario: Cómo Registrar Entradas y Salidas de Dinero del Cajón",{"slug":266,"title":267},"07-faq-cajero-activar-medio-pago","📖 Manual de Usuario: Cómo Activar un Medio de Pago que no Aparece al Cobrar",{"slug":269,"title":270},"08-faq-cajero-diferencia-facturado-vs-abiertas","📖 Manual de Usuario: Diferencia entre \"Facturado Total Mesas\" y \"Abiertas Por Usuario\" en Caja",{"slug":272,"title":273},"10-faq-supervisor-cierre-caja-diferencias","📖 Manual de Usuario: Cómo Auditar y Solucionar Diferencias en el Cierre de Caja",{"slug":275,"title":276},"preguntas-frecuentes","Preguntas Frecuentes y Guías Rápidas por Rol",{"slug":278,"title":279},"buchon-bot","Buchón Bot",{"slug":281,"title":282},"troubleshooting-semantico","📖 Guía Única de Resolución de Problemas y Errores (Troubleshooting)"],"uses":{}},{"type":"data","data":[{"slug":1,"title":2,"content":3,"tableOfContents":4,"seo":30,"llmTxtFile":34},"usuarios-del-sistema","Cómo administrar los Usuarios del Sistema","\u003Cdiv id=\"usuarios-del-sistema\">\u003C/div>\n\n\u003Cblockquote>\n\u003Cp>\u003Cstrong>¿Dónde está en el sistema?:\u003C/strong> Menú principal → \u003Cstrong>Configuración\u003C/strong> → debajo del título \u003Cstrong>Acceso y Seguridad\u003C/strong> → \u003Cstrong>Usuarios del Sistema\u003C/strong>\n\u003Cstrong>¿Quién lo usa?:\u003C/strong> El dueño y los encargados del comercio.\u003C/p>\n\u003C/blockquote>\n\u003Cblockquote>\n\u003Cp>🎯 \u003Cstrong>¿Para qué sirve esto?\u003C/strong>\nAcá ves quién puede entrar a PaxaPOS en tu comercio y con qué rol. Vas a poder darle acceso a una persona nueva o sumar a alguien que ya usa PaxaPOS en otro comercio.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                📍 \u003Cstrong>Paso 1: Entrá a la pantalla\u003C/strong>\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-1-entra-a-la-pantalla\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-1-entra-a-la-pantalla\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/110-configuracion/123-00a-menu-grupo-configuracion.png\" alt=\"Menú lateral con el grupo Configuración marcado en rojo\">\u003C/p>\n\u003Col>\n\u003Cli>En el menú de la izquierda, tocá \u003Cstrong>Configuración\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/110-configuracion/123-00b-menu-opcion-usuarios-del-sistema.png\" alt=\"Opción Usuarios del Sistema marcada en rojo debajo del título Acceso y Seguridad\">\u003C/p>\n\u003Col start=\"2\">\n\u003Cli>Debajo del título \u003Cstrong>Acceso y Seguridad\u003C/strong>, tocá \u003Cstrong>Usuarios del Sistema\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/110-configuracion/123-01-pantalla-usuarios-de-mi-comercio.png\" alt=\"Pantalla Usuarios de mi comercio con la lista de usuarios\">\u003C/p>\n\u003Cp>Ves la lista \u003Cstrong>Usuarios de mi comercio\u003C/strong>. Cada renglón muestra:\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Nombre de usuario\u003C/strong>: el email o nombre con el que entra la persona.\u003C/li>\n\u003Cli>\u003Cstrong>Roles\u003C/strong>: lo que puede hacer en el sistema.\u003C/li>\n\u003Cli>\u003Cstrong>Activo\u003C/strong>: si puede entrar (\u003Cstrong>Yes\u003C/strong>) o no (\u003Cstrong>No\u003C/strong>).\u003C/li>\n\u003Cli>\u003Cstrong>en PaxaPos desde\u003C/strong> y \u003Cstrong>Ultima vez conectado\u003C/strong>: cuándo se creó la cuenta y cuándo entró por última vez.\u003C/li>\n\u003Cli>\u003Cstrong>Acciones\u003C/strong>: los botones para editar al usuario o quitarlo del comercio.\u003C/li>\n\u003C/ul>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                ❓ \u003Cstrong>Paso 2: Conocé qué puede hacer cada rol\u003C/strong>\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-2-conoce-que-puede-hacer-cada-rol\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-2-conoce-que-puede-hacer-cada-rol\">\u003C/div>\n\n\u003Col>\n\u003Cli>Tocá la barra gris \u003Cstrong>¿Qué puede hacer cada rol?\u003C/strong>.\u003C/li>\n\u003Cli>Se despliega la explicación.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/110-configuracion/123-05-ayuda-que-puede-hacer-cada-rol.png\" alt=\"Ayuda desplegada con la explicación de los roles Dueño, Encargado y Cajero / Mozo / otros\">\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Dueño\u003C/strong>: tiene acceso total. Es el único que puede crear o asignar el rol Dueño a otra persona.\u003C/li>\n\u003Cli>\u003Cstrong>Encargado\u003C/strong>: gestiona el día a día y el equipo. Puede crear y vincular usuarios, pero no crear dueños.\u003C/li>\n\u003Cli>\u003Cstrong>Cajero / Mozo / otros\u003C/strong>: solo ven lo de su tarea. No gestionan usuarios.\u003C/li>\n\u003C/ul>\n\u003Cp>Para ver el detalle fino de cada rol, mirá \u003Ca href=\"/user-guide/permisos-por-rol\">Permisos por Rol\u003C/a>.\u003C/p>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🔍 \u003Cstrong>Paso 3: Buscá un usuario\u003C/strong>\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-3-busca-un-usuario\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-3-busca-un-usuario\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/110-configuracion/123-06-filtros-de-la-lista.png\" alt=\"Casillero de búsqueda, lista de roles y botón Filtrar\">\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Buscar entre mis usuarios\u003C/strong>: escribí parte del nombre o del email.\u003C/li>\n\u003Cli>\u003Cstrong>Todos los roles\u003C/strong>: elegí un rol para ver solo a quienes lo tienen.\u003C/li>\n\u003Cli>\u003Cstrong>Filtrar\u003C/strong>: tocalo para aplicar la búsqueda.\u003C/li>\n\u003C/ul>\n\u003Cp>Después de filtrar aparece el botón \u003Cstrong>Limpiar\u003C/strong>. Tocalo para volver a ver a todos.\u003C/p>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                ➕ \u003Cstrong>Paso 4: Elegí entre Crear usuario nuevo y Vincular usuario existente\u003C/strong>\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-4-elegi-entre-crear-y-vincular\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-4-elegi-entre-crear-y-vincular\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/110-configuracion/123-02-donde-esta-botones-crear-y-vincular.png\" alt=\"Pantalla con los botones Crear usuario nuevo y Vincular usuario existente marcados en rojo\">\u003C/p>\n\u003Cp>Arriba a la derecha hay dos botones. Elegí bien para no duplicar cuentas:\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Crear usuario nuevo\u003C/strong> (verde): para alguien que todavía no tiene cuenta en PaxaPOS.\u003C/li>\n\u003Cli>\u003Cstrong>Vincular usuario existente\u003C/strong> (azul): para alguien que ya usa PaxaPOS en otro comercio.\u003C/li>\n\u003C/ul>\n\u003Cblockquote>\n\u003Cp>💡 \u003Cstrong>Consejo útil:\u003C/strong> si dudás, primero probá \u003Cstrong>Vincular usuario existente\u003C/strong> con el email de la persona. Así no se crea una cuenta repetida.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                📝 \u003Cstrong>Paso 5: Creá un usuario nuevo\u003C/strong>\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-5-crea-un-usuario-nuevo\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-5-crea-un-usuario-nuevo\">\u003C/div>\n\n\u003Cp>Tocá \u003Cstrong>Crear usuario nuevo\u003C/strong>. Se abre una ventanita con los datos.\u003C/p>\n\u003Cp>\u003Cimg src=\"/images/manual/110-configuracion/123-03-formulario-crear-usuario-nuevo-parte-1.png\" alt=\"Datos de Acceso y Contraseña con datos de ejemplo de Juan Pérez, contraseñas difuminadas\">\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cp>\u003Cstrong>Username\u003C/strong>: el nombre de usuario. Por ejemplo: \u003Cem>juan.perez\u003C/em>.\u003C/p>\n\u003C/li>\n\u003Cli>\u003Cp>\u003Cstrong>Email\u003C/strong>: el email de la persona. Por ejemplo: \u003Cem>\u003Ca href=\"mailto:juan.perez@ejemplo.com\">juan.perez@ejemplo.com\u003C/a>\u003C/em>.\u003C/p>\n\u003C/li>\n\u003Cli>\u003Cp>\u003Cstrong>Password\u003C/strong> y \u003Cstrong>Password (confirm)\u003C/strong>: la contraseña, escrita dos veces igual.\n\u003Cimg src=\"/images/manual/110-configuracion/123-03-formulario-crear-usuario-nuevo-parte-2.png\" alt=\"Bloque Roles y Permisos con Roles, Cajas y Mozos\">\u003C/p>\n\u003C/li>\n\u003Cli>\u003Cp>\u003Cstrong>Roles\u003C/strong>: tildá el rol que tendrá. Podés abrir \u003Cstrong>¿Qué puede hacer cada rol?\u003C/strong> para elegir mejor.\u003C/p>\n\u003C/li>\n\u003Cli>\u003Cp>\u003Cstrong>Cajas\u003C/strong>: las cajas que puede usar. \u003Cstrong>Seleccionar todos\u003C/strong> las tilda todas.\u003C/p>\n\u003C/li>\n\u003Cli>\u003Cp>\u003Cstrong>Mozos\u003C/strong>: a qué mozo corresponde, si trabaja en el salón.\n\u003Cimg src=\"/images/manual/110-configuracion/123-03-formulario-crear-usuario-nuevo-parte-3.png\" alt=\"Bloques Centros de Costo y Perfil de Impresión, con los botones Cancelar y Registrar nuevo usuario abajo\">\u003C/p>\n\u003C/li>\n\u003Cli>\u003Cp>\u003Cstrong>Centros de Costo\u003C/strong>: a qué áreas pertenece. Define qué compras y ventas ve.\u003C/p>\n\u003C/li>\n\u003Cli>\u003Cp>\u003Cstrong>Perfil de Impresión\u003C/strong>: a qué impresoras imprime. Si no elegís, usa el del comercio. \u003Cstrong>Gestionar Perfiles\u003C/strong> te lleva a \u003Ca href=\"/user-guide/perfiles-de-impresion\">Perfiles de Impresión\u003C/a>.\u003C/p>\n\u003C/li>\n\u003Cli>\u003Cp>\u003Cstrong>Cancelar\u003C/strong>: cierra sin crear nada.\u003C/p>\n\u003C/li>\n\u003C/ul>\n\u003Cblockquote>\n\u003Cp>⚠️ \u003Cstrong>Atención:\u003C/strong> el botón \u003Cstrong>Registrar nuevo usuario\u003C/strong> crea la cuenta de verdad. Revisá el email y el rol antes de tocarlo.\u003C/p>\n\u003C/blockquote>\n\u003Cp>Al tocar \u003Cstrong>Registrar nuevo usuario\u003C/strong>, la persona ya puede entrar y aparece en la lista.\u003C/p>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🔗 \u003Cstrong>Paso 6: Vinculá un usuario que ya existe\u003C/strong>\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-6-vincula-un-usuario-que-ya-existe\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-6-vincula-un-usuario-que-ya-existe\">\u003C/div>\n\n\u003Cp>Tocá \u003Cstrong>Vincular usuario existente\u003C/strong>. Se abre otra ventanita.\u003C/p>\n\u003Cp>\u003Cimg src=\"/images/manual/110-configuracion/123-04-ventanita-vincular-usuario-existente.png\" alt=\"Ventanita Vincular usuario existente con un email de ejemplo y los botones Cancelar y Vincular a mi comercio\">\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Email o nombre de usuario completo\u003C/strong>: escribí el dato exacto. No se muestran sugerencias por seguridad.\u003C/li>\n\u003Cli>\u003Cstrong>Rol en el comercio\u003C/strong>: elegí qué rol tendrá acá.\u003C/li>\n\u003Cli>\u003Cstrong>Cancelar\u003C/strong>: cierra sin hacer nada.\u003C/li>\n\u003Cli>\u003Cstrong>Vincular a mi comercio\u003C/strong>: suma a la persona a tu comercio.\u003C/li>\n\u003C/ul>\n\u003Cblockquote>\n\u003Cp>⚠️ \u003Cstrong>Atención:\u003C/strong> \u003Cstrong>Vincular a mi comercio\u003C/strong> le da acceso real a tu comercio a esa cuenta. Confirmá que es la persona correcta.\u003C/p>\n\u003C/blockquote>\n\u003Cp>Si no existe ninguna cuenta con ese dato, aparece un aviso amarillo con el botón \u003Cstrong>Crear una cuenta nueva con este email\u003C/strong>. Tocalo para seguir por el Paso 5.\u003C/p>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                ✏️ \u003Cstrong>Paso 7: Editá o quitá a un usuario\u003C/strong>\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-7-edita-o-quita-a-un-usuario\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-7-edita-o-quita-a-un-usuario\">\u003C/div>\n\n\u003Cp>En la lista del Paso 1, la columna \u003Cstrong>Acciones\u003C/strong> de cada renglón tiene dos botones juntos:\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Lápiz azul (Editar)\u003C/strong>: abre la pantalla para cambiar el usuario.\u003C/li>\n\u003Cli>\u003Cstrong>Botón con la X (Quitar de mi comercio)\u003C/strong>: le saca el acceso a tu comercio.\u003C/li>\n\u003C/ul>\n\u003Cblockquote>\n\u003Cp>⚠️ \u003Cstrong>Atención:\u003C/strong> \u003Cstrong>Quitar de mi comercio\u003C/strong> hace que la persona pierda el acceso. Su cuenta de PaxaPOS no se borra. Te pide confirmar antes.\u003C/p>\n\u003C/blockquote>\n\u003Cp>Al tocar el lápiz se abre la pantalla de edición:\u003C/p>\n\u003Cp>\u003Cimg src=\"/images/manual/110-configuracion/123-08-editar-usuario-parte-1.png\" alt=\"Pantalla Editando a un usuario con el bloque Roles y Permisos\">\u003C/p>\n\u003Cp>\u003Cimg src=\"/images/manual/110-configuracion/123-08-editar-usuario-parte-2.png\" alt=\"Bloques Centros de Costo y Perfil de Impresión con los botones Cancelar y Guardar cambios\">\u003C/p>\n\u003Cp>Tiene los mismos bloques que el alta, sin usuario ni contraseña. Tocá \u003Cstrong>Guardar cambios\u003C/strong> para aplicar, o \u003Cstrong>Cancelar\u003C/strong> para salir sin cambiar nada.\u003C/p>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                ⚠️ \u003Cstrong>Resolución de Inconvenientes\u003C/strong>\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"resolucion-de-inconvenientes\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"resolucion-de-inconvenientes\">\u003C/div>\n\n\u003Cdiv class=\"table-wrapper\">\u003Ctable>\n\u003Cthead>\n\u003Ctr>\n\u003Cth>Problema\u003C/th>\n\u003Cth>Causa más frecuente\u003C/th>\n\u003Cth>Solución recomendada\u003C/th>\n\u003C/tr>\n\u003C/thead>\n\u003Ctbody>\u003Ctr>\n\u003Ctd>No veo los botones \u003Cstrong>Crear usuario nuevo\u003C/strong> ni \u003Cstrong>Vincular usuario existente\u003C/strong>.\u003C/td>\n\u003Ctd>Tu usuario no tiene permiso para administrar usuarios.\u003C/td>\n\u003Ctd>Pedile al dueño que revise tu rol en \u003Ca href=\"/user-guide/permisos-por-rol\">Permisos por Rol\u003C/a>.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>Vincular usuario existente\u003C/strong> no encuentra a la persona.\u003C/td>\n\u003Ctd>El email o usuario no está escrito completo y exacto.\u003C/td>\n\u003Ctd>Escribilo de nuevo sin espacios. Si no existe, usá \u003Cstrong>Crear una cuenta nueva con este email\u003C/strong>.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>No puedo darle el rol Dueño a alguien.\u003C/td>\n\u003Ctd>Solo el Dueño puede crear o asignar ese rol.\u003C/td>\n\u003Ctd>Pedile al dueño del comercio que lo haga.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>La persona no puede entrar.\u003C/td>\n\u003Ctd>La contraseña está mal escrita o la cuenta está inactiva.\u003C/td>\n\u003Ctd>Revisá la columna \u003Cstrong>Activo\u003C/strong> y editá al usuario.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>Quité a alguien por error.\u003C/td>\n\u003Ctd>Se tocó \u003Cstrong>Quitar de mi comercio\u003C/strong>.\u003C/td>\n\u003Ctd>Volvé a sumarlo con \u003Cstrong>Vincular usuario existente\u003C/strong>.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>Un mozo de PIN no aparece acá.\u003C/td>\n\u003Ctd>Los accesos por PIN están en otra pantalla.\u003C/td>\n\u003Ctd>Mirá \u003Ca href=\"/user-guide/usuarios-con-pin\">Usuarios con PIN\u003C/a>.\u003C/td>\n\u003C/tr>\n\u003C/tbody>\u003C/table>\u003C/div>\n",[5,9,12,15,18,21,24,27],{"id":6,"title":7,"level":8},"paso-1-entra-a-la-pantalla","Paso 1: Entrá a la pantalla",2,{"id":10,"title":11,"level":8},"paso-2-conoce-que-puede-hacer-cada-rol","Paso 2: Conocé qué puede hacer cada rol",{"id":13,"title":14,"level":8},"paso-3-busca-un-usuario","Paso 3: Buscá un usuario",{"id":16,"title":17,"level":8},"paso-4-elegi-entre-crear-y-vincular","Paso 4: Elegí entre Crear usuario nuevo y Vincular usuario existente",{"id":19,"title":20,"level":8},"paso-5-crea-un-usuario-nuevo","Paso 5: Creá un usuario nuevo",{"id":22,"title":23,"level":8},"paso-6-vincula-un-usuario-que-ya-existe","Paso 6: Vinculá un usuario que ya existe",{"id":25,"title":26,"level":8},"paso-7-edita-o-quita-a-un-usuario","Paso 7: Editá o quitá a un usuario",{"id":28,"title":29,"level":8},"resolucion-de-inconvenientes","Resolución de Inconvenientes",{"title":31,"description":32,"keywords":33},"Cómo administrar los Usuarios del Sistema - Manual","¿Dónde está en el sistema?: Menú principal → Configuración → debajo del título Acceso y Seguridad → Usuarios del Sistema\n ¿Quién lo usa?...","usuarios del sistema, paxapos, cómo administrar los usuarios del sistema, tutorial, guía, manual usuario","123-usuarios-del-sistema.txt"],"uses":{"params":["slug"]}}]}
