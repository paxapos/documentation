{"type":"data","nodes":[null,{"type":"data","data":[{"moduleCategories":1},[2,17,44,53,77,98,110,140,146,173,185,221,250],{"title":3,"modules":4},"Comenzamos",[5,8,11,14],{"slug":6,"title":7},"introduccion","Bienvenido a tu software gastronómico",{"slug":9,"title":10},"iniciar-sesion","Cómo Iniciar Sesión",{"slug":12,"title":13},"recuperar-contrasena","Cómo Recuperar tu Contraseña",{"slug":15,"title":16},"guia-de-inicio-rapido","Guía de Inicio Rápido",{"title":18,"modules":19},"Ventas",[20,23,26,29,32,35,38,41],{"slug":21,"title":22},"salon-de-ventas","Cómo Usar el Salón de Ventas (Adición)",{"slug":24,"title":25},"caja-rapida","Cómo Usar la Caja Rápida (Registradora)",{"slug":27,"title":28},"mozos","Cómo Cargar los Mozos",{"slug":30,"title":31},"clientes","Cómo Gestionar los Clientes",{"slug":33,"title":34},"descuentos","Cómo Configurar Descuentos",{"slug":36,"title":37},"nueva-reserva","Cómo Cargar una Nueva Reserva",{"slug":39,"title":40},"listado-de-reservas","Cómo Usar el Listado de Reservas",{"slug":42,"title":43},"grilla-de-reservas","Cómo Usar la Grilla de Reservas",{"title":45,"modules":46},"Medios de Pago",[47,50],{"slug":48,"title":49},"configuracion-procesadores","Configuración de Procesadores de Pago",{"slug":51,"title":52},"transacciones-mercadopago","Transacciones MercadoPago",{"title":54,"modules":55},"Productos",[56,59,62,65,68,71,74],{"slug":57,"title":58},"menu","Menú de Productos (Carta)",{"slug":60,"title":61},"categorias","Categorías de Productos",{"slug":63,"title":64},"variantes-grupo-sabores","Variantes y Grupos de Sabores",{"slug":66,"title":67},"maestro-de-productos","Maestro de Productos",{"slug":69,"title":70},"subproductos-elaborados","Sub-Productos (Elaborados)",{"slug":72,"title":73},"recetas","Recetas",{"slug":75,"title":76},"analisis-duplicados","Buscar Duplicados",{"title":78,"modules":79},"Compras",[80,83,86,89,92,95],{"slug":81,"title":82},"todas-las-ordenes-compra","Órdenes de Compra",{"slug":84,"title":85},"crear-orden-compra","Crear una Orden de Compra",{"slug":87,"title":88},"ordenes-a-aprobar","Órdenes a aprobar",{"slug":90,"title":91},"mercaderias","Mercaderías",{"slug":93,"title":94},"proveedores","Proveedores",{"slug":96,"title":97},"historial-de-compras","Historial de Compras",{"title":99,"modules":100},"Stock",[101,104,107],{"slug":102,"title":103},"stock-mercaderias","Stock de Mercaderías",{"slug":105,"title":106},"stock-subproductos","Stock de Subproductos",{"slug":108,"title":109},"movimientos-de-stock","Movimientos de Stock",{"title":111,"modules":112},"Finanzas",[113,116,119,122,125,128,131,134,137],{"slug":114,"title":115},"arqueos-de-caja","Arqueos de Caja",{"slug":117,"title":118},"listado-de-cajas","Listado de Cajas",{"slug":120,"title":121},"transacciones-de-cobro","Transacciones de Cobro",{"slug":123,"title":124},"factura-manual","Factura Manual",{"slug":126,"title":127},"resumen-de-deuda","Resumen de Deuda",{"slug":129,"title":130},"pagos","Pagos",{"slug":132,"title":133},"historial-de-facturas","Historial de Facturas",{"slug":135,"title":136},"historico-de-mesas","Histórico de Mesas",{"slug":138,"title":139},"puntos-de-venta-pdv","Puntos de Venta (PDVs)",{"title":141,"modules":142},"Comandero",[143],{"slug":144,"title":145},"comandero","Comandero (pantalla de cocina)",{"title":147,"modules":148},"RRHH",[149,152,155,158,161,164,167,170],{"slug":150,"title":151},"empleados","Empleados",{"slug":153,"title":154},"empleados-trabajando","Empleados Trabajando",{"slug":156,"title":157},"registro-diario-fichaje","Registro Diario de Fichaje",{"slug":159,"title":160},"reporte-mensual-fichaje","Reporte Mensual de Fichaje",{"slug":162,"title":163},"departamentos","Departamentos",{"slug":165,"title":166},"turnos-y-horarios-fichaje","Turnos y Horarios de Fichaje",{"slug":168,"title":169},"sueldos-y-jornales","Sueldos y Jornales",{"slug":171,"title":172},"datos-de-acceso-app","Datos de Acceso a la App de Fichaje",{"title":174,"modules":175},"Reportes",[176,179,182],{"slug":177,"title":178},"tablero-general","Tablero General",{"slug":180,"title":181},"productos-mas-vendidos","Productos Más Vendidos",{"slug":183,"title":184},"compras-por-mercaderia","Compras por Mercadería",{"title":186,"modules":187},"Configuracion",[188,191,194,197,200,203,206,209,212,215,218],{"slug":189,"title":190},"configuracion-general","Configuración general",{"slug":192,"title":193},"impresoras","Cómo cargar las impresoras del local",{"slug":195,"title":196},"perfiles-de-impresion","Cómo usar los perfiles de impresión",{"slug":198,"title":199},"usuarios-del-sistema","Cómo administrar los Usuarios del Sistema",{"slug":201,"title":202},"usuarios-con-pin","Cómo administrar los Usuarios con PIN",{"slug":204,"title":205},"punto-de-venta","🏛️ Trámite en ARCA (con clave fiscal)",{"slug":207,"title":208},"permisos-por-rol","Cómo configurar los Permisos por Rol",{"slug":210,"title":211},"turnos-mesa","Turnos de Mesa",{"slug":213,"title":214},"medios-de-cobro","Medios de cobro",{"slug":216,"title":217},"clasificacion-de-gastos","Clasificación de Gastos",{"slug":219,"title":220},"centros-de-costo","Centros de Costo",{"title":222,"modules":223},"Biblioteca de Drivers",[224,226,229,232,235,238,241,244,247],{"slug":225,"title":222},"biblioteca-de-drivers",{"slug":227,"title":228},"sam4s-giant-100","Sam4S Giant - 100",{"slug":230,"title":231},"citizen-ct-s310ii","Citizen CT-S310II",{"slug":233,"title":234},"epson-tm-t20","Epson TM-T20",{"slug":236,"title":237},"drivers-genericos","Drivers Genéricos POS",{"slug":239,"title":240},"epson-tm-t88","Epson TM-T88V",{"slug":242,"title":243},"fiscalberry-windows","Instalar Fiscalberry en Windows",{"slug":245,"title":246},"fiscalberry-linux","Instalar Fiscalberry en Linux",{"slug":248,"title":249},"fiscalberry-android","Instalar Fiscalberry en Android",{"title":251,"modules":252},"Extra",[253,256,259,262,265,268,271,274,277,280],{"slug":254,"title":255},"01-faq-solucion-inicial-pantalla-congelada","📖 Manual de Usuario: Solución Inicial si la Pantalla se Congela o no Carga",{"slug":257,"title":258},"03-faq-mozo-reabrir-mesa-anulada","📖 Manual de Usuario: Cómo Reabrir una Mesa Anulada o Cerrada por Error",{"slug":260,"title":261},"05-faq-cajero-emitir-factura-a","📖 Manual de Usuario: Cómo Emitir una Factura A Cargando Datos del Cliente",{"slug":263,"title":264},"06-faq-cajero-ingreso-egreso-cajon","📖 Manual de Usuario: Cómo Registrar Entradas y Salidas de Dinero del Cajón",{"slug":266,"title":267},"07-faq-cajero-activar-medio-pago","📖 Manual de Usuario: Cómo Activar un Medio de Pago que no Aparece al Cobrar",{"slug":269,"title":270},"08-faq-cajero-diferencia-facturado-vs-abiertas","📖 Manual de Usuario: Diferencia entre \"Facturado Total Mesas\" y \"Abiertas Por Usuario\" en Caja",{"slug":272,"title":273},"10-faq-supervisor-cierre-caja-diferencias","📖 Manual de Usuario: Cómo Auditar y Solucionar Diferencias en el Cierre de Caja",{"slug":275,"title":276},"preguntas-frecuentes","Preguntas Frecuentes y Guías Rápidas por Rol",{"slug":278,"title":279},"buchon-bot","Buchón Bot",{"slug":281,"title":282},"troubleshooting-semantico","📖 Guía Única de Resolución de Problemas y Errores (Troubleshooting)"],"uses":{}},{"type":"data","data":[{"slug":1,"title":2,"content":3,"tableOfContents":4,"seo":34,"llmTxtFile":38},"fiscalberry-linux","Instalar Fiscalberry en Linux","\u003Cdiv id=\"instalar-fiscalberry-en-linux\">\u003C/div>\n\n\u003Cblockquote>\n\u003Cp>\u003Cstrong>¿Dónde está en el sistema?:\u003C/strong> Menú principal → \u003Cstrong>Configuración\u003C/strong> → \u003Cstrong>Impresión\u003C/strong> → bloque \u003Cstrong>Descargar Fiscalberry\u003C/strong>\u003Cbr>\u003Cstrong>¿Quién lo usa?:\u003C/strong> Dueños, encargados o quien instala la computadora del local\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🎯 ¿Qué es y para qué sirve?\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"que-es-y-para-que-sirve\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"que-es-y-para-que-sirve\">\u003C/div>\n\n\u003Cp>\u003Cstrong>Fiscalberry\u003C/strong> es el programa que conecta PaxaPOS con las impresoras de tu local. Se instala en la computadora que está conectada a las impresoras.\u003C/p>\n\u003Cp>Sin Fiscalberry \u003Cstrong>no sale impreso nada\u003C/strong>: ni comandas, ni remitos, ni facturas.\u003C/p>\n\u003Cblockquote>\n\u003Cp>⚠️ \u003Cstrong>MUY IMPORTANTE:\u003C/strong> Fiscalberry tiene que estar \u003Cstrong>siempre abierto\u003C/strong>. Si lo cerrás, \u003Cstrong>no imprime\u003C/strong>.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🔑 Requisitos para empezar\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"requisitos-para-empezar\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"requisitos-para-empezar\">\u003C/div>\n\n\u003Cul>\n\u003Cli>Una computadora con \u003Cstrong>Linux\u003C/strong> y escritorio (con ventanas), conectada a internet.\u003C/li>\n\u003Cli>Tu usuario y contraseña de PaxaPOS.\u003C/li>\n\u003Cli>La impresora conectada a la computadora por \u003Cstrong>USB\u003C/strong> o a la misma red por \u003Cstrong>Ethernet\u003C/strong>. Ver \u003Ca href=\"/user-guide/impresoras\">Gestión de Impresoras\u003C/a>.\u003C/li>\n\u003C/ul>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                📑 Guía Paso a Paso\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"guia-paso-a-paso\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"guia-paso-a-paso\">\u003C/div>\n\n\u003Ch3 class=\"relative\">\n                Paso 1: Descargá Fiscalberry\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-1-descarga-fiscalberry\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h3>\n            \u003Cdiv id=\"paso-1-descarga-fiscalberry\">\u003C/div>\n\n\u003Col>\n\u003Cli>En la computadora del local, entrá a PaxaPOS.\u003C/li>\n\u003Cli>Andá a \u003Cstrong>Configuración\u003C/strong> → \u003Cstrong>Impresión\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003C!-- FOTO: 148-01-menu-configuracion-impresion -->\n\u003Col start=\"3\">\n\u003Cli>Buscá el bloque \u003Cstrong>Descargar Fiscalberry\u003C/strong> (está debajo de \u003Cstrong>Servidor de impresión\u003C/strong>).\u003C/li>\n\u003C/ol>\n\u003C!-- FOTO: 148-02-bloque-descargar-fiscalberry -->\n\u003Col start=\"4\">\n\u003Cli>Tocá el botón de \u003Cstrong>Linux\u003C/strong>. Se descarga un archivo comprimido.\u003C/li>\n\u003C/ol>\n\u003C!-- FOTO: 148-03-boton-descargar-linux -->\n\n\u003Ch3 class=\"relative\">\n                Paso 2: Descomprimí el archivo\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-2-descomprimi-el-archivo\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h3>\n            \u003Cdiv id=\"paso-2-descomprimi-el-archivo\">\u003C/div>\n\n\u003Col>\n\u003Cli>Abrí la carpeta \u003Cstrong>Descargas\u003C/strong>.\u003C/li>\n\u003Cli>Hacé \u003Cstrong>clic derecho\u003C/strong> sobre el archivo de Fiscalberry → \u003Cstrong>Extraer aquí\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003C!-- FOTO: 148-04-extraer-archivo -->\n\u003Col start=\"3\">\n\u003Cli>Se crea una carpeta con Fiscalberry adentro. Dejala en un lugar fijo y no la borres.\u003C/li>\n\u003C/ol>\n\u003Ch3 class=\"relative\">\n                Paso 3: Abrí Fiscalberry\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-3-abri-fiscalberry\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h3>\n            \u003Cdiv id=\"paso-3-abri-fiscalberry\">\u003C/div>\n\n\u003Col>\n\u003Cli>Entrá a la carpeta que se creó.\u003C/li>\n\u003Cli>Hacé \u003Cstrong>doble clic\u003C/strong> en el programa de Fiscalberry.\u003C/li>\n\u003C/ol>\n\u003C!-- FOTO: 148-05-abrir-fiscalberry -->\n\u003Col start=\"3\">\n\u003Cli>Se abre la ventana de Fiscalberry. \u003Cstrong>No la cierres.\u003C/strong>\u003C/li>\n\u003C/ol>\n\u003C!-- FOTO: 148-06-ventana-fiscalberry -->\n\n\u003Ch3 class=\"relative\">\n                Paso 4: Vinculá Fiscalberry con tu comercio\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-4-vincula-fiscalberry-con-tu-comercio\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h3>\n            \u003Cdiv id=\"paso-4-vincula-fiscalberry-con-tu-comercio\">\u003C/div>\n\n\u003Cp>La primera vez, hay que decirle a PaxaPOS que esta computadora es la que imprime.\u003C/p>\n\u003Col>\n\u003Cli>En la ventana de Fiscalberry aparece un \u003Cstrong>link\u003C/strong> o un \u003Cstrong>código QR\u003C/strong>. Tocá el link (o escaneá el QR).\u003C/li>\n\u003C/ol>\n\u003C!-- FOTO: 148-07-link-qr-fiscalberry -->\n\u003Col start=\"2\">\n\u003Cli>Se abre la pantalla \u003Cstrong>Adoptar Servidor de Impresión\u003C/strong> de PaxaPOS.\u003C/li>\n\u003Cli>Si te pide \u003Cstrong>Inicio de sesión requerido\u003C/strong>, tocá \u003Cstrong>Iniciar Sesión\u003C/strong> y entrá con tu usuario y contraseña de PaxaPOS.\u003C/li>\n\u003Cli>En \u003Cstrong>Alias para identificar el servidor de impresión\u003C/strong>, escribí un nombre para reconocer la computadora (ejemplo: \u003Cem>PC Cocina\u003C/em>).\u003C/li>\n\u003C/ol>\n\u003C!-- FOTO: 148-08-campo-alias -->\n\u003Col start=\"5\">\n\u003Cli>En \u003Cstrong>Seleccione el sitio\u003C/strong>, elegí tu comercio.\u003C/li>\n\u003Cli>Tocá \u003Cstrong>Adoptar Servidor de Impresión\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003C!-- FOTO: 148-09-boton-adoptar -->\n\n\u003Cblockquote>\n\u003Cp>⚠️ Si no elegís un sitio, Fiscalberry \u003Cstrong>no se puede usar\u003C/strong>.\u003C/p>\n\u003C/blockquote>\n\u003Ch3 class=\"relative\">\n                Paso 5: Elegí este Fiscalberry como servidor de impresión\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-5-elegi-este-fiscalberry\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h3>\n            \u003Cdiv id=\"paso-5-elegi-este-fiscalberry\">\u003C/div>\n\n\u003Col>\n\u003Cli>En PaxaPOS, andá a \u003Cstrong>Configuración\u003C/strong> → \u003Cstrong>Impresión\u003C/strong>.\u003C/li>\n\u003Cli>En \u003Cstrong>Servidor de impresión\u003C/strong>, elegí el Fiscalberry que acabás de adoptar.\u003C/li>\n\u003C/ol>\n\u003C!-- FOTO: 148-10-servidor-de-impresion -->\n\u003Col start=\"3\">\n\u003Cli>Guardá los cambios.\u003C/li>\n\u003C/ol>\n\u003Cblockquote>\n\u003Cp>➡️ \u003Cstrong>Siguiente paso:\u003C/strong> dá de alta tus impresoras en PaxaPOS. Ver \u003Ca href=\"/user-guide/impresoras\">Gestión de Impresoras\u003C/a>.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                ⚠️ ¿Qué hacer si algo no sale bien? (Problemas Comunes)\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"que-hacer-si-algo-no-sale-bien-problemas-comunes\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"que-hacer-si-algo-no-sale-bien-problemas-comunes\">\u003C/div>\n\n\u003Cdiv class=\"table-wrapper\">\u003Ctable>\n\u003Cthead>\n\u003Ctr>\n\u003Cth>¿Qué te pasa?\u003C/th>\n\u003Cth>¿Por qué puede ser?\u003C/th>\n\u003Cth>¿Cómo se soluciona?\u003C/th>\n\u003C/tr>\n\u003C/thead>\n\u003Ctbody>\u003Ctr>\n\u003Ctd>No imprime nada.\u003C/td>\n\u003Ctd>Fiscalberry está \u003Cstrong>cerrado\u003C/strong>.\u003C/td>\n\u003Ctd>Abrilo de nuevo (Paso 3).\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>Después de reiniciar la computadora, no imprime.\u003C/td>\n\u003Ctd>Fiscalberry quedó cerrado.\u003C/td>\n\u003Ctd>Abrí Fiscalberry de nuevo (Paso 3).\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>No encuentro mi Fiscalberry en \u003Cstrong>Servidor de impresión\u003C/strong>.\u003C/td>\n\u003Ctd>Todavía no lo adoptaste.\u003C/td>\n\u003Ctd>Hacé el Paso 4.\u003C/td>\n\u003C/tr>\n\u003C/tbody>\u003C/table>\u003C/div>\n\u003Cblockquote>\n\u003Cp>🔗 ¿Usás otro sistema? \u003Ca href=\"/user-guide/fiscalberry-windows\">Fiscalberry en Windows\u003C/a> · \u003Ca href=\"/user-guide/fiscalberry-android\">Fiscalberry en Android\u003C/a>\u003C/p>\n\u003C/blockquote>\n",[5,9,12,15,19,22,25,28,31],{"id":6,"title":7,"level":8},"que-es-y-para-que-sirve","¿Qué es y para qué sirve?",2,{"id":10,"title":11,"level":8},"requisitos-para-empezar","Requisitos para empezar",{"id":13,"title":14,"level":8},"guia-paso-a-paso","Guía Paso a Paso",{"id":16,"title":17,"level":18},"paso-1-descarga-fiscalberry","Paso 1: Descargá Fiscalberry",3,{"id":20,"title":21,"level":18},"paso-2-descomprimi-el-archivo","Paso 2: Descomprimí el archivo",{"id":23,"title":24,"level":18},"paso-3-abri-fiscalberry","Paso 3: Abrí Fiscalberry",{"id":26,"title":27,"level":18},"paso-4-vincula-fiscalberry-con-tu-comercio","Paso 4: Vinculá Fiscalberry con tu comercio",{"id":29,"title":30,"level":18},"paso-5-elegi-este-fiscalberry","Paso 5: Elegí este Fiscalberry como servidor de impresión",{"id":32,"title":33,"level":8},"que-hacer-si-algo-no-sale-bien-problemas-comunes","¿Qué hacer si algo no sale bien? (Problemas Comunes)",{"title":35,"description":36,"keywords":37},"Instalar Fiscalberry en Linux - Manual","¿Dónde está en el sistema?: Menú principal → Configuración → Impresión → bloque Descargar Fiscalberry  \n ¿Quién lo usa?: Dueños, encar...","fiscalberry linux, paxapos, instalar fiscalberry en linux, tutorial, guía, manual usuario","148-fiscalberry-linux.txt"],"uses":{"params":["slug"]}}]}
