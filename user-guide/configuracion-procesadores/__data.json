{"type":"data","nodes":[null,{"type":"data","data":[{"moduleCategories":1},[2,17,44,53,77,98,110,140,146,173,185,221,250],{"title":3,"modules":4},"Comenzamos",[5,8,11,14],{"slug":6,"title":7},"introduccion","Bienvenido a tu software gastronómico",{"slug":9,"title":10},"iniciar-sesion","Cómo Iniciar Sesión",{"slug":12,"title":13},"recuperar-contrasena","Cómo Recuperar tu Contraseña",{"slug":15,"title":16},"guia-de-inicio-rapido","Guía de Inicio Rápido",{"title":18,"modules":19},"Ventas",[20,23,26,29,32,35,38,41],{"slug":21,"title":22},"salon-de-ventas","Cómo Usar el Salón de Ventas (Adición)",{"slug":24,"title":25},"caja-rapida","Cómo Usar la Caja Rápida (Registradora)",{"slug":27,"title":28},"mozos","Cómo Cargar los Mozos",{"slug":30,"title":31},"clientes","Cómo Gestionar los Clientes",{"slug":33,"title":34},"descuentos","Cómo Configurar Descuentos",{"slug":36,"title":37},"nueva-reserva","Cómo Cargar una Nueva Reserva",{"slug":39,"title":40},"listado-de-reservas","Cómo Usar el Listado de Reservas",{"slug":42,"title":43},"grilla-de-reservas","Cómo Usar la Grilla de Reservas",{"title":45,"modules":46},"Medios de Pago",[47,50],{"slug":48,"title":49},"configuracion-procesadores","Configuración de Procesadores de Pago",{"slug":51,"title":52},"transacciones-mercadopago","Transacciones MercadoPago",{"title":54,"modules":55},"Productos",[56,59,62,65,68,71,74],{"slug":57,"title":58},"menu","Menú de Productos (Carta)",{"slug":60,"title":61},"categorias","Categorías de Productos",{"slug":63,"title":64},"variantes-grupo-sabores","Variantes y Grupos de Sabores",{"slug":66,"title":67},"maestro-de-productos","Maestro de Productos",{"slug":69,"title":70},"subproductos-elaborados","Sub-Productos (Elaborados)",{"slug":72,"title":73},"recetas","Recetas",{"slug":75,"title":76},"analisis-duplicados","Buscar Duplicados",{"title":78,"modules":79},"Compras",[80,83,86,89,92,95],{"slug":81,"title":82},"todas-las-ordenes-compra","Órdenes de Compra",{"slug":84,"title":85},"crear-orden-compra","Crear una Orden de Compra",{"slug":87,"title":88},"ordenes-a-aprobar","Órdenes a aprobar",{"slug":90,"title":91},"mercaderias","Mercaderías",{"slug":93,"title":94},"proveedores","Proveedores",{"slug":96,"title":97},"historial-de-compras","Historial de Compras",{"title":99,"modules":100},"Stock",[101,104,107],{"slug":102,"title":103},"stock-mercaderias","Stock de Mercaderías",{"slug":105,"title":106},"stock-subproductos","Stock de Subproductos",{"slug":108,"title":109},"movimientos-de-stock","Movimientos de Stock",{"title":111,"modules":112},"Finanzas",[113,116,119,122,125,128,131,134,137],{"slug":114,"title":115},"arqueos-de-caja","Arqueos de Caja",{"slug":117,"title":118},"listado-de-cajas","Listado de Cajas",{"slug":120,"title":121},"transacciones-de-cobro","Transacciones de Cobro",{"slug":123,"title":124},"factura-manual","Factura Manual",{"slug":126,"title":127},"resumen-de-deuda","Resumen de Deuda",{"slug":129,"title":130},"pagos","Pagos",{"slug":132,"title":133},"historial-de-facturas","Historial de Facturas",{"slug":135,"title":136},"historico-de-mesas","Histórico de Mesas",{"slug":138,"title":139},"puntos-de-venta-pdv","Puntos de Venta (PDVs)",{"title":141,"modules":142},"Comandero",[143],{"slug":144,"title":145},"comandero","Comandero (pantalla de cocina)",{"title":147,"modules":148},"RRHH",[149,152,155,158,161,164,167,170],{"slug":150,"title":151},"empleados","Empleados",{"slug":153,"title":154},"empleados-trabajando","Empleados Trabajando",{"slug":156,"title":157},"registro-diario-fichaje","Registro Diario de Fichaje",{"slug":159,"title":160},"reporte-mensual-fichaje","Reporte Mensual de Fichaje",{"slug":162,"title":163},"departamentos","Departamentos",{"slug":165,"title":166},"turnos-y-horarios-fichaje","Turnos y Horarios de Fichaje",{"slug":168,"title":169},"sueldos-y-jornales","Sueldos y Jornales",{"slug":171,"title":172},"datos-de-acceso-app","Datos de Acceso a la App de Fichaje",{"title":174,"modules":175},"Reportes",[176,179,182],{"slug":177,"title":178},"tablero-general","Tablero General",{"slug":180,"title":181},"productos-mas-vendidos","Productos Más Vendidos",{"slug":183,"title":184},"compras-por-mercaderia","Compras por Mercadería",{"title":186,"modules":187},"Configuracion",[188,191,194,197,200,203,206,209,212,215,218],{"slug":189,"title":190},"configuracion-general","Configuración general",{"slug":192,"title":193},"impresoras","Cómo cargar las impresoras del local",{"slug":195,"title":196},"perfiles-de-impresion","Cómo usar los perfiles de impresión",{"slug":198,"title":199},"usuarios-del-sistema","Cómo administrar los Usuarios del Sistema",{"slug":201,"title":202},"usuarios-con-pin","Cómo administrar los Usuarios con PIN",{"slug":204,"title":205},"punto-de-venta","🏛️ Trámite en ARCA (con clave fiscal)",{"slug":207,"title":208},"permisos-por-rol","Cómo configurar los Permisos por Rol",{"slug":210,"title":211},"turnos-mesa","Turnos de Mesa",{"slug":213,"title":214},"medios-de-cobro","Medios de cobro",{"slug":216,"title":217},"clasificacion-de-gastos","Clasificación de Gastos",{"slug":219,"title":220},"centros-de-costo","Centros de Costo",{"title":222,"modules":223},"Biblioteca de Drivers",[224,226,229,232,235,238,241,244,247],{"slug":225,"title":222},"biblioteca-de-drivers",{"slug":227,"title":228},"sam4s-giant-100","Sam4S Giant - 100",{"slug":230,"title":231},"citizen-ct-s310ii","Citizen CT-S310II",{"slug":233,"title":234},"epson-tm-t20","Epson TM-T20",{"slug":236,"title":237},"drivers-genericos","Drivers Genéricos POS",{"slug":239,"title":240},"epson-tm-t88","Epson TM-T88V",{"slug":242,"title":243},"fiscalberry-windows","Instalar Fiscalberry en Windows",{"slug":245,"title":246},"fiscalberry-linux","Instalar Fiscalberry en Linux",{"slug":248,"title":249},"fiscalberry-android","Instalar Fiscalberry en Android",{"title":251,"modules":252},"Extra",[253,256,259,262,265,268,271,274,277,280],{"slug":254,"title":255},"01-faq-solucion-inicial-pantalla-congelada","📖 Manual de Usuario: Solución Inicial si la Pantalla se Congela o no Carga",{"slug":257,"title":258},"03-faq-mozo-reabrir-mesa-anulada","📖 Manual de Usuario: Cómo Reabrir una Mesa Anulada o Cerrada por Error",{"slug":260,"title":261},"05-faq-cajero-emitir-factura-a","📖 Manual de Usuario: Cómo Emitir una Factura A Cargando Datos del Cliente",{"slug":263,"title":264},"06-faq-cajero-ingreso-egreso-cajon","📖 Manual de Usuario: Cómo Registrar Entradas y Salidas de Dinero del Cajón",{"slug":266,"title":267},"07-faq-cajero-activar-medio-pago","📖 Manual de Usuario: Cómo Activar un Medio de Pago que no Aparece al Cobrar",{"slug":269,"title":270},"08-faq-cajero-diferencia-facturado-vs-abiertas","📖 Manual de Usuario: Diferencia entre \"Facturado Total Mesas\" y \"Abiertas Por Usuario\" en Caja",{"slug":272,"title":273},"10-faq-supervisor-cierre-caja-diferencias","📖 Manual de Usuario: Cómo Auditar y Solucionar Diferencias en el Cierre de Caja",{"slug":275,"title":276},"preguntas-frecuentes","Preguntas Frecuentes y Guías Rápidas por Rol",{"slug":278,"title":279},"buchon-bot","Buchón Bot",{"slug":281,"title":282},"troubleshooting-semantico","📖 Guía Única de Resolución de Problemas y Errores (Troubleshooting)"],"uses":{}},{"type":"data","data":[{"slug":1,"title":2,"content":3,"tableOfContents":4,"seo":37,"llmTxtFile":41},"configuracion-procesadores","Configuración de Procesadores de Pago","\u003Cdiv id=\"configuracion-de-procesadores-de-pago\">\u003C/div>\n\n\u003Cblockquote>\n\u003Cp>\u003Cstrong>¿Dónde está en el sistema?:\u003C/strong> Menú principal → \u003Cstrong>Medios de Pago\u003C/strong> → \u003Cstrong>Configuración de Procesadores\u003C/strong>\n\u003Cstrong>¿Quién lo usa?:\u003C/strong> Dueños y administradores del comercio\u003C/p>\n\u003C/blockquote>\n\u003Cblockquote>\n\u003Cp>🎯 \u003Cstrong>¿Para qué sirve esto?\u003C/strong>\nAcá elegís con qué empresa cobrás cuando el cliente paga con QR, con un link o con una terminal de tarjetas.\nEsa empresa se llama &quot;procesador&quot;. Por ejemplo: \u003Cem>MercadoPago\u003C/em>, \u003Cem>Payway\u003C/em> o \u003Cem>MacroClick\u003C/em>.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🔑 Antes de empezar\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"antes-de-empezar\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"antes-de-empezar\">\u003C/div>\n\n\u003Cul>\n\u003Cli>Tu usuario tiene que tener el permiso \u003Cstrong>Contabilidad\u003C/strong> de Finanzas en \u003Ca href=\"/user-guide/permisos-por-rol\">Permisos por Rol\u003C/a>.\u003C/li>\n\u003Cli>Tenés que tener una cuenta abierta en el procesador que vas a usar. Por ejemplo, una cuenta de MercadoPago.\u003C/li>\n\u003C/ul>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                📍 Paso 1: Entrá a la pantalla\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-1-entra-a-la-pantalla\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-1-entra-a-la-pantalla\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/30-medios-de-pago/31-00a-menu-grupo-payments.png\" alt=\"Menú lateral con el grupo Medios de Pago marcado en rojo\">\u003C/p>\n\u003Col>\n\u003Cli>En el menú de la izquierda, tocá \u003Cstrong>Medios de Pago\u003C/strong>.\u003C/li>\n\u003Cli>Se abre la lista de opciones de ese grupo.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/30-medios-de-pago/31-00b-menu-opcion-processors.png\" alt=\"Opción Configuración de Procesadores marcada en rojo en el menú lateral\">\u003C/p>\n\u003Col start=\"3\">\n\u003Cli>Tocá \u003Cstrong>Configuración de Procesadores\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/30-medios-de-pago/31-01-pantalla-processors.png\" alt=\"Pantalla Medios de Pago con las tres tarjetas: Cobro con QR, Link de Pago y Terminal SmartPOS\">\u003C/p>\n\u003Cp>Así se ve la pantalla. Arriba hay tres tarjetas, una por cada forma de cobrar.\u003C/p>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                📱 Paso 2: Elegí el procesador para cobrar con QR\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-2-elegi-el-procesador-para-cobrar-con-qr\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-2-elegi-el-procesador-para-cobrar-con-qr\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/30-medios-de-pago/31-02-campo-data-paymentsconfig-qr-processor.png\" alt=\"Tarjeta Cobro con QR con las opciones MercadoPago, MacroClick y Deshabilitado\">\u003C/p>\n\u003Col>\n\u003Cli>Mirá la tarjeta \u003Cstrong>Cobro con QR\u003C/strong>. Es la de la izquierda.\u003C/li>\n\u003Cli>Tocá el nombre del procesador que querés usar. Por ejemplo: \u003Cstrong>MercadoPago\u003C/strong>.\u003C/li>\n\u003Cli>La opción elegida queda con borde azul.\u003C/li>\n\u003Cli>Si no cobrás con QR, tocá \u003Cstrong>Deshabilitado\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🔗 Paso 3: Elegí el procesador para el link de pago\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-3-elegi-el-procesador-para-el-link-de-pago\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-3-elegi-el-procesador-para-el-link-de-pago\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/30-medios-de-pago/31-03-campo-data-paymentsconfig-payment-link.png\" alt=\"Tarjeta Link de Pago con las opciones MercadoPago, Payway, Pedimelo Online y Deshabilitado\">\u003C/p>\n\u003Col>\n\u003Cli>Mirá la tarjeta \u003Cstrong>Link de Pago\u003C/strong>. Es la del medio.\u003C/li>\n\u003Cli>El link de pago es el que le mandás al cliente por WhatsApp o por email.\u003C/li>\n\u003Cli>Tocá el procesador que querés usar, o \u003Cstrong>Deshabilitado\u003C/strong> si no lo usás.\u003C/li>\n\u003C/ol>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                💳 Paso 4: Elegí el procesador para la terminal de tarjetas\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-4-elegi-el-procesador-para-la-terminal-de-tarjetas\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-4-elegi-el-procesador-para-la-terminal-de-tarjetas\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/30-medios-de-pago/31-04-campo-data-paymentsconfig-smartpos-pro.png\" alt=\"Tarjeta Terminal SmartPOS con las opciones MercadoPago, Payway y Deshabilitado\">\u003C/p>\n\u003Col>\n\u003Cli>Mirá la tarjeta \u003Cstrong>Terminal SmartPOS\u003C/strong>. Es la de la derecha.\u003C/li>\n\u003Cli>Es la maquinita donde el cliente pasa o apoya la tarjeta.\u003C/li>\n\u003Cli>Tocá la empresa de tu terminal, o \u003Cstrong>Deshabilitado\u003C/strong> si no tenés una.\u003C/li>\n\u003C/ol>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                💾 Paso 5: Guardá lo que elegiste\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-5-guarda-lo-que-elegiste\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-5-guarda-lo-que-elegiste\">\u003C/div>\n\n\u003Cblockquote>\n\u003Cp>⚠️ \u003Cstrong>Atención:\u003C/strong> al guardar cambia la forma de cobrar de todo el comercio. Revisá bien las tres tarjetas antes.\u003C/p>\n\u003C/blockquote>\n\u003Cp>\u003Cimg src=\"/images/manual/30-medios-de-pago/31-05-donde-esta-boton-guardar-configuracion.png\" alt=\"Pantalla con el botón azul Guardar Configuración marcado en rojo, debajo de las tarjetas\">\u003C/p>\n\u003Col>\n\u003Cli>Tocá el botón azul \u003Cstrong>Guardar Configuración\u003C/strong>. Está debajo de las tres tarjetas.\u003C/li>\n\u003Cli>La pantalla se vuelve a cargar con lo que elegiste.\u003C/li>\n\u003Cli>Más abajo aparece una solapa por cada procesador que elegiste.\u003C/li>\n\u003C/ol>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                ⚙️ Paso 6: Conectá tu cuenta del procesador\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-6-conecta-tu-cuenta-del-procesador\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-6-conecta-tu-cuenta-del-procesador\">\u003C/div>\n\n\u003Cp>Después de guardar, en la parte de abajo hay una solapa por cada procesador que usás.\u003C/p>\n\u003Ch3 class=\"relative\">\n                Opción A: Vincular con MercadoPago (la más fácil)\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"opcion-a-vincular-con-mercadopago\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h3>\n            \u003Cdiv id=\"opcion-a-vincular-con-mercadopago\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/30-medios-de-pago/31-11-donde-esta-boton-vincular-mercadopago.png\" alt=\"Pantalla con el botón naranja Vincular con MercadoPago marcado en rojo\">\u003C/p>\n\u003Col>\n\u003Cli>Tocá el botón naranja \u003Cstrong>Vincular con MercadoPago\u003C/strong>.\u003C/li>\n\u003Cli>Se abre la página de MercadoPago.\u003C/li>\n\u003Cli>Entrá con tu usuario de MercadoPago y aceptá darle permiso a PaxaPOS.\u003C/li>\n\u003Cli>Al terminar, volvés a PaxaPOS con la cuenta conectada.\u003C/li>\n\u003C/ol>\n\u003Cblockquote>\n\u003Cp>💡 \u003Cstrong>Consejo útil:\u003C/strong> así no tenés que copiar ninguna clave a mano.\u003C/p>\n\u003C/blockquote>\n\u003Ch3 class=\"relative\">\n                Opción B: Configurar Credenciales\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"opcion-b-configurar-credenciales\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h3>\n            \u003Cdiv id=\"opcion-b-configurar-credenciales\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/30-medios-de-pago/31-09-donde-esta-boton-configurar-credenciales.png\" alt=\"Pantalla con el botón azul Configurar Credenciales marcado en rojo\">\u003C/p>\n\u003Col>\n\u003Cli>Tocá el botón azul \u003Cstrong>Configurar Credenciales\u003C/strong>.\u003C/li>\n\u003Cli>Se abre la pantalla de ese procesador.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/30-medios-de-pago/31-15-pantalla-mercadopago.png\" alt=\"Pantalla MercadoPago con el estado de la cuenta y los canales de cobro\">\u003C/p>\n\u003Col start=\"3\">\n\u003Cli>Arriba ves si la cuenta está bien conectada.\u003C/li>\n\u003Cli>Si ves un cuadro rojo que dice \u003Cstrong>No pudimos verificar la cuenta\u003C/strong>, tocá \u003Cstrong>Reconectar con MercadoPago\u003C/strong>.\u003C/li>\n\u003Cli>En \u003Cstrong>Canales de cobro\u003C/strong> ves con qué cobra hoy cada forma de pago.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/30-medios-de-pago/31-16-donde-esta-boton-volver-a-medios-de-pago.png\" alt=\"Pantalla MercadoPago con el botón Volver a medios de pago marcado en rojo\">\u003C/p>\n\u003Col start=\"6\">\n\u003Cli>Cuando termines, tocá \u003Cstrong>Volver a medios de pago\u003C/strong>. Está abajo de todo.\u003C/li>\n\u003C/ol>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                ⚠️ Resolución de Inconvenientes\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"resolucion-de-inconvenientes\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"resolucion-de-inconvenientes\">\u003C/div>\n\n\u003Cdiv class=\"table-wrapper\">\u003Ctable>\n\u003Cthead>\n\u003Ctr>\n\u003Cth>Problema\u003C/th>\n\u003Cth>Causa más frecuente\u003C/th>\n\u003Cth>Solución recomendada\u003C/th>\n\u003C/tr>\n\u003C/thead>\n\u003Ctbody>\u003Ctr>\n\u003Ctd>\u003Cstrong>No aparece Medios de Pago en el menú\u003C/strong>\u003C/td>\n\u003Ctd>Tu usuario no tiene el permiso \u003Cstrong>Contabilidad\u003C/strong> de Finanzas.\u003C/td>\n\u003Ctd>Pedile al dueño que lo active en \u003Ca href=\"/user-guide/permisos-por-rol\">Permisos por Rol\u003C/a>.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>Abajo no aparece ninguna solapa de procesador\u003C/strong>\u003C/td>\n\u003Ctd>Todavía no elegiste ni guardaste un procesador.\u003C/td>\n\u003Ctd>Elegí uno en alguna tarjeta y tocá \u003Cstrong>Guardar Configuración\u003C/strong>.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>Cuadro rojo &quot;No pudimos verificar la cuenta&quot;\u003C/strong>\u003C/td>\n\u003Ctd>La conexión con MercadoPago venció o se cortó.\u003C/td>\n\u003Ctd>Tocá \u003Cstrong>Configurar Credenciales\u003C/strong> y después \u003Cstrong>Reconectar con MercadoPago\u003C/strong>.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>El cliente no puede pagar con QR o con link\u003C/strong>\u003C/td>\n\u003Ctd>Esa tarjeta quedó en \u003Cstrong>Deshabilitado\u003C/strong>.\u003C/td>\n\u003Ctd>Elegí un procesador en esa tarjeta y guardá.\u003C/td>\n\u003C/tr>\n\u003C/tbody>\u003C/table>\u003C/div>\n",[5,9,12,15,18,21,24,27,31,34],{"id":6,"title":7,"level":8},"antes-de-empezar","Antes de empezar",2,{"id":10,"title":11,"level":8},"paso-1-entra-a-la-pantalla","Paso 1: Entrá a la pantalla",{"id":13,"title":14,"level":8},"paso-2-elegi-el-procesador-para-cobrar-con-qr","Paso 2: Elegí el procesador para cobrar con QR",{"id":16,"title":17,"level":8},"paso-3-elegi-el-procesador-para-el-link-de-pago","Paso 3: Elegí el procesador para el link de pago",{"id":19,"title":20,"level":8},"paso-4-elegi-el-procesador-para-la-terminal-de-tarjetas","Paso 4: Elegí el procesador para la terminal de tarjetas",{"id":22,"title":23,"level":8},"paso-5-guarda-lo-que-elegiste","Paso 5: Guardá lo que elegiste",{"id":25,"title":26,"level":8},"paso-6-conecta-tu-cuenta-del-procesador","Paso 6: Conectá tu cuenta del procesador",{"id":28,"title":29,"level":30},"opcion-a-vincular-con-mercadopago","Opción A: Vincular con MercadoPago (la más fácil)",3,{"id":32,"title":33,"level":30},"opcion-b-configurar-credenciales","Opción B: Configurar Credenciales",{"id":35,"title":36,"level":8},"resolucion-de-inconvenientes","Resolución de Inconvenientes",{"title":38,"description":39,"keywords":40},"Configuración de Procesadores de Pago - Manual","¿Dónde está en el sistema?: Menú principal → Medios de Pago → Configuración de Procesadores\n ¿Quién lo usa?: Dueños y administradores del ...","configuracion procesadores, paxapos, configuración de procesadores de pago, tutorial, guía, manual usuario","31-configuracion-procesadores.txt"],"uses":{"params":["slug"]}}]}
