{"type":"data","nodes":[null,{"type":"data","data":[{"moduleCategories":1},[2,17,44,53,77,98,110,140,146,173,185,221,250],{"title":3,"modules":4},"Comenzamos",[5,8,11,14],{"slug":6,"title":7},"introduccion","Bienvenido a tu software gastronómico",{"slug":9,"title":10},"iniciar-sesion","Cómo Iniciar Sesión",{"slug":12,"title":13},"recuperar-contrasena","Cómo Recuperar tu Contraseña",{"slug":15,"title":16},"guia-de-inicio-rapido","Guía de Inicio Rápido",{"title":18,"modules":19},"Ventas",[20,23,26,29,32,35,38,41],{"slug":21,"title":22},"salon-de-ventas","Cómo Usar el Salón de Ventas (Adición)",{"slug":24,"title":25},"caja-rapida","Cómo Usar la Caja Rápida (Registradora)",{"slug":27,"title":28},"mozos","Cómo Cargar los Mozos",{"slug":30,"title":31},"clientes","Cómo Gestionar los Clientes",{"slug":33,"title":34},"descuentos","Cómo Configurar Descuentos",{"slug":36,"title":37},"nueva-reserva","Cómo Cargar una Nueva Reserva",{"slug":39,"title":40},"listado-de-reservas","Cómo Usar el Listado de Reservas",{"slug":42,"title":43},"grilla-de-reservas","Cómo Usar la Grilla de Reservas",{"title":45,"modules":46},"Medios de Pago",[47,50],{"slug":48,"title":49},"configuracion-procesadores","Configuración de Procesadores de Pago",{"slug":51,"title":52},"transacciones-mercadopago","Transacciones MercadoPago",{"title":54,"modules":55},"Productos",[56,59,62,65,68,71,74],{"slug":57,"title":58},"menu","Menú de Productos (Carta)",{"slug":60,"title":61},"categorias","Categorías de Productos",{"slug":63,"title":64},"variantes-grupo-sabores","Variantes y Grupos de Sabores",{"slug":66,"title":67},"maestro-de-productos","Maestro de Productos",{"slug":69,"title":70},"subproductos-elaborados","Sub-Productos (Elaborados)",{"slug":72,"title":73},"recetas","Recetas",{"slug":75,"title":76},"analisis-duplicados","Buscar Duplicados",{"title":78,"modules":79},"Compras",[80,83,86,89,92,95],{"slug":81,"title":82},"todas-las-ordenes-compra","Órdenes de Compra",{"slug":84,"title":85},"crear-orden-compra","Crear una Orden de Compra",{"slug":87,"title":88},"ordenes-a-aprobar","Órdenes a aprobar",{"slug":90,"title":91},"mercaderias","Mercaderías",{"slug":93,"title":94},"proveedores","Proveedores",{"slug":96,"title":97},"historial-de-compras","Historial de Compras",{"title":99,"modules":100},"Stock",[101,104,107],{"slug":102,"title":103},"stock-mercaderias","Stock de Mercaderías",{"slug":105,"title":106},"stock-subproductos","Stock de Subproductos",{"slug":108,"title":109},"movimientos-de-stock","Movimientos de Stock",{"title":111,"modules":112},"Finanzas",[113,116,119,122,125,128,131,134,137],{"slug":114,"title":115},"arqueos-de-caja","Arqueos de Caja",{"slug":117,"title":118},"listado-de-cajas","Listado de Cajas",{"slug":120,"title":121},"transacciones-de-cobro","Transacciones de Cobro",{"slug":123,"title":124},"factura-manual","Factura Manual",{"slug":126,"title":127},"resumen-de-deuda","Resumen de Deuda",{"slug":129,"title":130},"pagos","Pagos",{"slug":132,"title":133},"historial-de-facturas","Historial de Facturas",{"slug":135,"title":136},"historico-de-mesas","Histórico de Mesas",{"slug":138,"title":139},"puntos-de-venta-pdv","Puntos de Venta (PDVs)",{"title":141,"modules":142},"Comandero",[143],{"slug":144,"title":145},"comandero","Comandero (pantalla de cocina)",{"title":147,"modules":148},"RRHH",[149,152,155,158,161,164,167,170],{"slug":150,"title":151},"empleados","Empleados",{"slug":153,"title":154},"empleados-trabajando","Empleados Trabajando",{"slug":156,"title":157},"registro-diario-fichaje","Registro Diario de Fichaje",{"slug":159,"title":160},"reporte-mensual-fichaje","Reporte Mensual de Fichaje",{"slug":162,"title":163},"departamentos","Departamentos",{"slug":165,"title":166},"turnos-y-horarios-fichaje","Turnos y Horarios de Fichaje",{"slug":168,"title":169},"sueldos-y-jornales","Sueldos y Jornales",{"slug":171,"title":172},"datos-de-acceso-app","Datos de Acceso a la App de Fichaje",{"title":174,"modules":175},"Reportes",[176,179,182],{"slug":177,"title":178},"tablero-general","Tablero General",{"slug":180,"title":181},"productos-mas-vendidos","Productos Más Vendidos",{"slug":183,"title":184},"compras-por-mercaderia","Compras por Mercadería",{"title":186,"modules":187},"Configuracion",[188,191,194,197,200,203,206,209,212,215,218],{"slug":189,"title":190},"configuracion-general","Configuración general",{"slug":192,"title":193},"impresoras","Cómo cargar las impresoras del local",{"slug":195,"title":196},"perfiles-de-impresion","Cómo usar los perfiles de impresión",{"slug":198,"title":199},"usuarios-del-sistema","Cómo administrar los Usuarios del Sistema",{"slug":201,"title":202},"usuarios-con-pin","Cómo administrar los Usuarios con PIN",{"slug":204,"title":205},"punto-de-venta","🏛️ Trámite en ARCA (con clave fiscal)",{"slug":207,"title":208},"permisos-por-rol","Cómo configurar los Permisos por Rol",{"slug":210,"title":211},"turnos-mesa","Turnos de Mesa",{"slug":213,"title":214},"medios-de-cobro","Medios de cobro",{"slug":216,"title":217},"clasificacion-de-gastos","Clasificación de Gastos",{"slug":219,"title":220},"centros-de-costo","Centros de Costo",{"title":222,"modules":223},"Biblioteca de Drivers",[224,226,229,232,235,238,241,244,247],{"slug":225,"title":222},"biblioteca-de-drivers",{"slug":227,"title":228},"sam4s-giant-100","Sam4S Giant - 100",{"slug":230,"title":231},"citizen-ct-s310ii","Citizen CT-S310II",{"slug":233,"title":234},"epson-tm-t20","Epson TM-T20",{"slug":236,"title":237},"drivers-genericos","Drivers Genéricos POS",{"slug":239,"title":240},"epson-tm-t88","Epson TM-T88V",{"slug":242,"title":243},"fiscalberry-windows","Instalar Fiscalberry en Windows",{"slug":245,"title":246},"fiscalberry-linux","Instalar Fiscalberry en Linux",{"slug":248,"title":249},"fiscalberry-android","Instalar Fiscalberry en Android",{"title":251,"modules":252},"Extra",[253,256,259,262,265,268,271,274,277,280],{"slug":254,"title":255},"01-faq-solucion-inicial-pantalla-congelada","📖 Manual de Usuario: Solución Inicial si la Pantalla se Congela o no Carga",{"slug":257,"title":258},"03-faq-mozo-reabrir-mesa-anulada","📖 Manual de Usuario: Cómo Reabrir una Mesa Anulada o Cerrada por Error",{"slug":260,"title":261},"05-faq-cajero-emitir-factura-a","📖 Manual de Usuario: Cómo Emitir una Factura A Cargando Datos del Cliente",{"slug":263,"title":264},"06-faq-cajero-ingreso-egreso-cajon","📖 Manual de Usuario: Cómo Registrar Entradas y Salidas de Dinero del Cajón",{"slug":266,"title":267},"07-faq-cajero-activar-medio-pago","📖 Manual de Usuario: Cómo Activar un Medio de Pago que no Aparece al Cobrar",{"slug":269,"title":270},"08-faq-cajero-diferencia-facturado-vs-abiertas","📖 Manual de Usuario: Diferencia entre \"Facturado Total Mesas\" y \"Abiertas Por Usuario\" en Caja",{"slug":272,"title":273},"10-faq-supervisor-cierre-caja-diferencias","📖 Manual de Usuario: Cómo Auditar y Solucionar Diferencias en el Cierre de Caja",{"slug":275,"title":276},"preguntas-frecuentes","Preguntas Frecuentes y Guías Rápidas por Rol",{"slug":278,"title":279},"buchon-bot","Buchón Bot",{"slug":281,"title":282},"troubleshooting-semantico","📖 Guía Única de Resolución de Problemas y Errores (Troubleshooting)"],"uses":{}},{"type":"data","data":[{"slug":1,"title":2,"content":3,"tableOfContents":4,"seo":24,"llmTxtFile":28},"mercaderias","Mercaderías","\u003Cdiv id=\"mercaderias\">\u003C/div>\n\n\u003Cblockquote>\n\u003Cp>\u003Cstrong>¿Dónde está en el sistema?:\u003C/strong> Menú principal → \u003Cstrong>Compras\u003C/strong> → \u003Cstrong>Catálogo\u003C/strong> → \u003Cstrong>Mercaderías\u003C/strong>\n\u003Cstrong>¿Quién lo usa?:\u003C/strong> Compradores, encargados de depósito y administradores\u003C/p>\n\u003C/blockquote>\n\u003Cblockquote>\n\u003Cp>🎯 \u003Cstrong>¿Para qué sirve esto?\u003C/strong>\nUna mercadería es algo que le comprás a un proveedor, tal como te lo vende. Por ejemplo: \u003Cem>Harina 0000 x 25 kg\u003C/em> o \u003Cem>Coca Cola pack x 6\u003C/em>.\nAcá cargás cómo lo comprás y cómo lo contás en el depósito, para que el stock y los costos den bien.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🔑 Antes de empezar\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"antes-de-empezar\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"antes-de-empezar\">\u003C/div>\n\n\u003Cul>\n\u003Cli>Tu usuario tiene que tener el permiso de \u003Cstrong>Mercaderías\u003C/strong> en \u003Ca href=\"/user-guide/permisos-por-rol\">Permisos por Rol\u003C/a>.\u003C/li>\n\u003Cli>Conviene tener cargado el proveedor. Mirá \u003Ca href=\"/user-guide/proveedores\">Proveedores\u003C/a>.\u003C/li>\n\u003C/ul>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                📍 Paso 1: Entrá a la pantalla\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-1-entra-a-la-pantalla\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-1-entra-a-la-pantalla\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/50-compras/56-00a-menu-grupo-compras.png\" alt=\"Menú lateral con el grupo Compras marcado en rojo\">\u003C/p>\n\u003Col>\n\u003Cli>En el menú de la izquierda, tocá \u003Cstrong>Compras\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/50-compras/56-00b-menu-opcion-mercaderias.png\" alt=\"Opción Mercaderías marcada en rojo, debajo de Catálogo\">\u003C/p>\n\u003Col start=\"2\">\n\u003Cli>Tocá \u003Cstrong>Mercaderías\u003C/strong>. Está debajo del título \u003Cstrong>CATÁLOGO\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/50-compras/56-01-pantalla-index.png\" alt=\"Pantalla Mercaderías con el buscador y la lista\">\u003C/p>\n\u003Cp>Así se ve la pantalla. Cada renglón es una mercadería, con su unidad de compra, su costo y su proveedor.\u003C/p>\n\u003Cblockquote>\n\u003Cp>💡 \u003Cstrong>Consejo útil:\u003C/strong> hacé clic en una celda de la lista (por ejemplo, el costo) para cambiarla al instante.\u003C/p>\n\u003C/blockquote>\n\u003Cp>\u003Cimg src=\"/images/manual/50-compras/56-43-encabezado.png\" alt=\"Botones de arriba: Nuevo Mercadería, ayuda y Descargar Excel\">\u003C/p>\n\u003Cp>Arriba tenés tres botones:\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Nuevo Mercadería\u003C/strong>: carga una mercadería nueva (Paso 3).\u003C/li>\n\u003Cli>\u003Cstrong>?\u003C/strong>: muestra una explicación corta de la pantalla.\u003C/li>\n\u003Cli>\u003Cstrong>Descargar Excel\u003C/strong>: baja la lista a una planilla.\u003C/li>\n\u003C/ul>\n\u003Cp>\u003Cimg src=\"/images/manual/50-compras/56-27-ayuda-abierta.png\" alt=\"Explicación de la pantalla abierta debajo del botón de ayuda\">\u003C/p>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🔎 Paso 2: Buscá una mercadería\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-2-busca-una-mercaderia\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-2-busca-una-mercaderia\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/50-compras/56-04-panel-busqueda.png\" alt=\"Recuadro de búsqueda con Harina 0000 escrito, proveedores, rubros y el botón Buscar\">\u003C/p>\n\u003Cp>En el recuadro de búsqueda tenés:\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Buscar por nombre...\u003C/strong>: escribí parte del nombre. Por ejemplo: \u003Cem>Harina 0000\u003C/em>.\u003C/li>\n\u003Cli>\u003Cstrong>Todos los proveedores\u003C/strong>: mostrá solo lo que le comprás a un proveedor.\u003C/li>\n\u003Cli>\u003Cstrong>Todos los rubros\u003C/strong>: mostrá solo un rubro. Por ejemplo: \u003Cem>Almacén\u003C/em>.\u003C/li>\n\u003Cli>\u003Cstrong>Buscar\u003C/strong>: el botón azul de la derecha, que aplica la búsqueda.\u003C/li>\n\u003C/ul>\n\u003Col>\n\u003Cli>Completá lo que necesites y tocá \u003Cstrong>Buscar\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/50-compras/56-33-resultado-busqueda.png\" alt=\"Lista con la mercadería Harina 0000 x 25 kg\">\u003C/p>\n\u003Col start=\"2\">\n\u003Cli>La lista muestra solo las que coinciden.\u003C/li>\n\u003C/ol>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                ➕ Paso 3: Cargá una mercadería nueva\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-3-carga-una-mercaderia-nueva\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-3-carga-una-mercaderia-nueva\">\u003C/div>\n\n\u003Col>\n\u003Cli>Tocá el botón azul \u003Cstrong>Nuevo Mercadería\u003C/strong>, arriba a la izquierda.\u003C/li>\n\u003Cli>Se abre el formulario \u003Cstrong>Crear Nuevo Mercadería\u003C/strong>. Tiene cuatro partes.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/50-compras/56-40-formulario-parte-1.png\" alt=\"Formulario, primera parte: PASO 1 Información Básica y PASO 2 Unidades, completos con Harina 0000 x 25 kg\">\u003C/p>\n\u003Cp>\u003Cstrong>PASO 1 · Información Básica\u003C/strong> (obligatoria):\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Producto\u003C/strong>: el producto que es. Por ejemplo: \u003Cem>Harina 0000\u003C/em>. Si no existe, se crea.\u003C/li>\n\u003Cli>\u003Cstrong>Nombre de Compra\u003C/strong>: cómo aparece en la factura del proveedor. Por ejemplo: \u003Cem>Harina 0000 x 25 kg\u003C/em>.\u003C/li>\n\u003Cli>\u003Cstrong>Código de Barras\u003C/strong>: es opcional.\u003C/li>\n\u003Cli>\u003Cstrong>Rubro / Categoría\u003C/strong>: el grupo. Por ejemplo: \u003Cem>Almacén\u003C/em>.\u003C/li>\n\u003C/ul>\n\u003Cp>\u003Cstrong>PASO 2 · Unidades\u003C/strong> (cómo lo comprás y cómo lo contás):\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Comprás por\u003C/strong>: cómo te lo factura el proveedor. Por ejemplo: \u003Cem>Bolsa\u003C/em>.\u003C/li>\n\u003Cli>\u003Cstrong>Contás por\u003C/strong>: cómo lo contás en el depósito y en las recetas. Por ejemplo: \u003Cem>Kilo\u003C/em>.\u003C/li>\n\u003Cli>\u003Cstrong>Equivalencia\u003C/strong>: cuántas unidades de stock trae cada unidad de compra. Por ejemplo: \u003Cem>25\u003C/em>, porque \u003Cem>1 Bolsa = 25 Kilo\u003C/em>. Abajo el sistema te lo muestra escrito, para que lo revises.\u003C/li>\n\u003C/ul>\n\u003Cp>\u003Cimg src=\"/images/manual/50-compras/56-41-formulario-parte-2.png\" alt=\"Formulario, segunda parte: PASO 3 Costos e impuestos, Proveedor habitual y los botones Cancelar y Guardar Mercadería\">\u003C/p>\n\u003Cp>\u003Cstrong>PASO 3 · Costos e impuestos\u003C/strong>:\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Porcentaje de Desperdicio\u003C/strong>: cuánto se pierde al usarlo. Por ejemplo: \u003Cem>2\u003C/em>.\u003C/li>\n\u003Cli>\u003Cstrong>IVA de Compra\u003C/strong>: el IVA que te cobra el proveedor. Por ejemplo: \u003Cem>IVA 21%\u003C/em>.\u003C/li>\n\u003C/ul>\n\u003Cp>\u003Cstrong>OPCIONAL · Proveedor habitual\u003C/strong>: tocá \u003Cstrong>Mostrar/Ocultar\u003C/strong> y elegí en \u003Cstrong>Proveedor por Defecto\u003C/strong> a quién se lo comprás siempre. Se usa al armar la orden de compra.\u003C/p>\n\u003Cp>El recuadro azul \u003Cstrong>¿Cuántos mercaderías puedo crear?\u003C/strong> explica cuándo conviene una sola mercadería por producto y cuándo varias (por marca, proveedor o presentación).\u003C/p>\n\u003Col start=\"3\">\n\u003Cli>Tocá el botón azul \u003Cstrong>Guardar Mercadería\u003C/strong>, abajo a la derecha. Si te arrepentiste, tocá \u003Cstrong>Cancelar\u003C/strong>: no se guarda nada.\u003C/li>\n\u003C/ol>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                ✏️ Paso 4: Mirá o cambiá una mercadería\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-4-mira-o-cambia-una-mercaderia\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-4-mira-o-cambia-una-mercaderia\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/50-compras/56-42-botones-del-renglon.png\" alt=\"Los cuatro botones de un renglón: ojo, hojita, lápiz y tacho\">\u003C/p>\n\u003Cp>A la derecha de cada renglón hay cuatro botones:\u003C/p>\n\u003Cul>\n\u003Cli>El ojo 👁️ abre el detalle completo de la mercadería.\u003C/li>\n\u003Cli>La hojita 🌿 abre la ficha del producto. Mirá \u003Ca href=\"/user-guide/maestro-de-productos\">Maestro de Productos\u003C/a>.\u003C/li>\n\u003Cli>El lápiz ✏️ abre una ventana para cambiar los datos. Cambiá lo que necesites y tocá \u003Cstrong>Guardar Mercadería\u003C/strong>.\u003C/li>\n\u003Cli>El tacho 🗑️ borra la mercadería. El sistema te pregunta si estás seguro.\u003C/li>\n\u003C/ul>\n\u003Cp>\u003Cimg src=\"/images/manual/50-compras/56-37-pantalla-detalle.png\" alt=\"Detalle de la mercadería Harina 0000 x 25 kg\">\u003C/p>\n\u003Cp>Así se ve el detalle completo.\u003C/p>\n\u003Cp>\u003Cimg src=\"/images/manual/50-compras/56-38-ventana-editar.png\" alt=\"Ventana Editando Mercadería con los datos de Harina 0000\">\u003C/p>\n\u003Cp>Y así, la ventana del lápiz.\u003C/p>\n\u003Cblockquote>\n\u003Cp>⚠️ \u003Cstrong>Atención:\u003C/strong> si borrás una mercadería que ya compraste, desaparece de las próximas órdenes de compra.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                ⚠️ Resolución de Inconvenientes\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"resolucion-de-inconvenientes\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"resolucion-de-inconvenientes\">\u003C/div>\n\n\u003Cdiv class=\"table-wrapper\">\u003Ctable>\n\u003Cthead>\n\u003Ctr>\n\u003Cth>Problema\u003C/th>\n\u003Cth>Causa más frecuente\u003C/th>\n\u003Cth>Solución recomendada\u003C/th>\n\u003C/tr>\n\u003C/thead>\n\u003Ctbody>\u003Ctr>\n\u003Ctd>\u003Cstrong>El stock sube 25 veces más (o menos) de lo que compré\u003C/strong>\u003C/td>\n\u003Ctd>La \u003Cstrong>Equivalencia\u003C/strong> está mal.\u003C/td>\n\u003Ctd>Tocá el lápiz y revisá \u003Cstrong>Comprás por\u003C/strong>, \u003Cstrong>Contás por\u003C/strong> y \u003Cstrong>Equivalencia\u003C/strong>.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>La receta usa gramos y la mercadería está en kilos\u003C/strong>\u003C/td>\n\u003Ctd>La unidad de \u003Cstrong>Contás por\u003C/strong> no coincide con la receta.\u003C/td>\n\u003Ctd>Usá la misma unidad en la mercadería y en la receta.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>El costo sale en $0\u003C/strong>\u003C/td>\n\u003Ctd>Todavía no la compraste.\u003C/td>\n\u003Ctd>Cargá una orden de compra o hacé clic en el costo y escribilo.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>No aparece Mercaderías en el menú\u003C/strong>\u003C/td>\n\u003Ctd>La opción del menú está sin nombre en la configuración del comercio.\u003C/td>\n\u003Ctd>Pedile a soporte que revise el \u003Cstrong>título de mercadería\u003C/strong> del comercio.\u003C/td>\n\u003C/tr>\n\u003C/tbody>\u003C/table>\u003C/div>\n",[5,9,12,15,18,21],{"id":6,"title":7,"level":8},"antes-de-empezar","Antes de empezar",2,{"id":10,"title":11,"level":8},"paso-1-entra-a-la-pantalla","Paso 1: Entrá a la pantalla",{"id":13,"title":14,"level":8},"paso-2-busca-una-mercaderia","Paso 2: Buscá una mercadería",{"id":16,"title":17,"level":8},"paso-3-carga-una-mercaderia-nueva","Paso 3: Cargá una mercadería nueva",{"id":19,"title":20,"level":8},"paso-4-mira-o-cambia-una-mercaderia","Paso 4: Mirá o cambiá una mercadería",{"id":22,"title":23,"level":8},"resolucion-de-inconvenientes","Resolución de Inconvenientes",{"title":25,"description":26,"keywords":27},"Mercaderías - Manual","¿Dónde está en el sistema?: Menú principal → Compras → Catálogo → Mercaderías\n ¿Quién lo usa?: Compradores, encargados de depósito y a...","mercaderias, paxapos, mercaderías, tutorial, guía, manual usuario","56-mercaderias.txt"],"uses":{"params":["slug"]}}]}
