{"type":"data","nodes":[null,{"type":"data","data":[{"moduleCategories":1},[2,17,44,53,77,98,110,140,146,173,185,221,250],{"title":3,"modules":4},"Comenzamos",[5,8,11,14],{"slug":6,"title":7},"introduccion","Bienvenido a tu software gastronómico",{"slug":9,"title":10},"iniciar-sesion","Cómo Iniciar Sesión",{"slug":12,"title":13},"recuperar-contrasena","Cómo Recuperar tu Contraseña",{"slug":15,"title":16},"guia-de-inicio-rapido","Guía de Inicio Rápido",{"title":18,"modules":19},"Ventas",[20,23,26,29,32,35,38,41],{"slug":21,"title":22},"salon-de-ventas","Cómo Usar el Salón de Ventas (Adición)",{"slug":24,"title":25},"caja-rapida","Cómo Usar la Caja Rápida (Registradora)",{"slug":27,"title":28},"mozos","Cómo Cargar los Mozos",{"slug":30,"title":31},"clientes","Cómo Gestionar los Clientes",{"slug":33,"title":34},"descuentos","Cómo Configurar Descuentos",{"slug":36,"title":37},"nueva-reserva","Cómo Cargar una Nueva Reserva",{"slug":39,"title":40},"listado-de-reservas","Cómo Usar el Listado de Reservas",{"slug":42,"title":43},"grilla-de-reservas","Cómo Usar la Grilla de Reservas",{"title":45,"modules":46},"Medios de Pago",[47,50],{"slug":48,"title":49},"configuracion-procesadores","Configuración de Procesadores de Pago",{"slug":51,"title":52},"transacciones-mercadopago","Transacciones MercadoPago",{"title":54,"modules":55},"Productos",[56,59,62,65,68,71,74],{"slug":57,"title":58},"menu","Menú de Productos (Carta)",{"slug":60,"title":61},"categorias","Categorías de Productos",{"slug":63,"title":64},"variantes-grupo-sabores","Variantes y Grupos de Sabores",{"slug":66,"title":67},"maestro-de-productos","Maestro de Productos",{"slug":69,"title":70},"subproductos-elaborados","Sub-Productos (Elaborados)",{"slug":72,"title":73},"recetas","Recetas",{"slug":75,"title":76},"analisis-duplicados","Buscar Duplicados",{"title":78,"modules":79},"Compras",[80,83,86,89,92,95],{"slug":81,"title":82},"todas-las-ordenes-compra","Órdenes de Compra",{"slug":84,"title":85},"crear-orden-compra","Crear una Orden de Compra",{"slug":87,"title":88},"ordenes-a-aprobar","Órdenes a aprobar",{"slug":90,"title":91},"mercaderias","Mercaderías",{"slug":93,"title":94},"proveedores","Proveedores",{"slug":96,"title":97},"historial-de-compras","Historial de Compras",{"title":99,"modules":100},"Stock",[101,104,107],{"slug":102,"title":103},"stock-mercaderias","Stock de Mercaderías",{"slug":105,"title":106},"stock-subproductos","Stock de Subproductos",{"slug":108,"title":109},"movimientos-de-stock","Movimientos de Stock",{"title":111,"modules":112},"Finanzas",[113,116,119,122,125,128,131,134,137],{"slug":114,"title":115},"arqueos-de-caja","Arqueos de Caja",{"slug":117,"title":118},"listado-de-cajas","Listado de Cajas",{"slug":120,"title":121},"transacciones-de-cobro","Transacciones de Cobro",{"slug":123,"title":124},"factura-manual","Factura Manual",{"slug":126,"title":127},"resumen-de-deuda","Resumen de Deuda",{"slug":129,"title":130},"pagos","Pagos",{"slug":132,"title":133},"historial-de-facturas","Historial de Facturas",{"slug":135,"title":136},"historico-de-mesas","Histórico de Mesas",{"slug":138,"title":139},"puntos-de-venta-pdv","Puntos de Venta (PDVs)",{"title":141,"modules":142},"Comandero",[143],{"slug":144,"title":145},"comandero","Comandero (pantalla de cocina)",{"title":147,"modules":148},"RRHH",[149,152,155,158,161,164,167,170],{"slug":150,"title":151},"empleados","Empleados",{"slug":153,"title":154},"empleados-trabajando","Empleados Trabajando",{"slug":156,"title":157},"registro-diario-fichaje","Registro Diario de Fichaje",{"slug":159,"title":160},"reporte-mensual-fichaje","Reporte Mensual de Fichaje",{"slug":162,"title":163},"departamentos","Departamentos",{"slug":165,"title":166},"turnos-y-horarios-fichaje","Turnos y Horarios de Fichaje",{"slug":168,"title":169},"sueldos-y-jornales","Sueldos y Jornales",{"slug":171,"title":172},"datos-de-acceso-app","Datos de Acceso a la App de Fichaje",{"title":174,"modules":175},"Reportes",[176,179,182],{"slug":177,"title":178},"tablero-general","Tablero General",{"slug":180,"title":181},"productos-mas-vendidos","Productos Más Vendidos",{"slug":183,"title":184},"compras-por-mercaderia","Compras por Mercadería",{"title":186,"modules":187},"Configuracion",[188,191,194,197,200,203,206,209,212,215,218],{"slug":189,"title":190},"configuracion-general","Configuración general",{"slug":192,"title":193},"impresoras","Cómo cargar las impresoras del local",{"slug":195,"title":196},"perfiles-de-impresion","Cómo usar los perfiles de impresión",{"slug":198,"title":199},"usuarios-del-sistema","Cómo administrar los Usuarios del Sistema",{"slug":201,"title":202},"usuarios-con-pin","Cómo administrar los Usuarios con PIN",{"slug":204,"title":205},"punto-de-venta","🏛️ Trámite en ARCA (con clave fiscal)",{"slug":207,"title":208},"permisos-por-rol","Cómo configurar los Permisos por Rol",{"slug":210,"title":211},"turnos-mesa","Turnos de Mesa",{"slug":213,"title":214},"medios-de-cobro","Medios de cobro",{"slug":216,"title":217},"clasificacion-de-gastos","Clasificación de Gastos",{"slug":219,"title":220},"centros-de-costo","Centros de Costo",{"title":222,"modules":223},"Biblioteca de Drivers",[224,226,229,232,235,238,241,244,247],{"slug":225,"title":222},"biblioteca-de-drivers",{"slug":227,"title":228},"sam4s-giant-100","Sam4S Giant - 100",{"slug":230,"title":231},"citizen-ct-s310ii","Citizen CT-S310II",{"slug":233,"title":234},"epson-tm-t20","Epson TM-T20",{"slug":236,"title":237},"drivers-genericos","Drivers Genéricos POS",{"slug":239,"title":240},"epson-tm-t88","Epson TM-T88V",{"slug":242,"title":243},"fiscalberry-windows","Instalar Fiscalberry en Windows",{"slug":245,"title":246},"fiscalberry-linux","Instalar Fiscalberry en Linux",{"slug":248,"title":249},"fiscalberry-android","Instalar Fiscalberry en Android",{"title":251,"modules":252},"Extra",[253,256,259,262,265,268,271,274,277,280],{"slug":254,"title":255},"01-faq-solucion-inicial-pantalla-congelada","📖 Manual de Usuario: Solución Inicial si la Pantalla se Congela o no Carga",{"slug":257,"title":258},"03-faq-mozo-reabrir-mesa-anulada","📖 Manual de Usuario: Cómo Reabrir una Mesa Anulada o Cerrada por Error",{"slug":260,"title":261},"05-faq-cajero-emitir-factura-a","📖 Manual de Usuario: Cómo Emitir una Factura A Cargando Datos del Cliente",{"slug":263,"title":264},"06-faq-cajero-ingreso-egreso-cajon","📖 Manual de Usuario: Cómo Registrar Entradas y Salidas de Dinero del Cajón",{"slug":266,"title":267},"07-faq-cajero-activar-medio-pago","📖 Manual de Usuario: Cómo Activar un Medio de Pago que no Aparece al Cobrar",{"slug":269,"title":270},"08-faq-cajero-diferencia-facturado-vs-abiertas","📖 Manual de Usuario: Diferencia entre \"Facturado Total Mesas\" y \"Abiertas Por Usuario\" en Caja",{"slug":272,"title":273},"10-faq-supervisor-cierre-caja-diferencias","📖 Manual de Usuario: Cómo Auditar y Solucionar Diferencias en el Cierre de Caja",{"slug":275,"title":276},"preguntas-frecuentes","Preguntas Frecuentes y Guías Rápidas por Rol",{"slug":278,"title":279},"buchon-bot","Buchón Bot",{"slug":281,"title":282},"troubleshooting-semantico","📖 Guía Única de Resolución de Problemas y Errores (Troubleshooting)"],"uses":{}},{"type":"data","data":[{"slug":1,"title":2,"content":3,"tableOfContents":4,"seo":58,"llmTxtFile":62},"salon-de-ventas","Cómo Usar el Salón de Ventas (Adición)","\u003Cdiv id=\"salon-de-ventas\">\u003C/div>\n\n\u003Cblockquote>\n\u003Cp>\u003Cstrong>¿Dónde está en el sistema?:\u003C/strong> Menú principal → \u003Cstrong>Ventas\u003C/strong> → \u003Cstrong>Salón de Ventas\u003C/strong>\u003Cbr>\u003Cstrong>¿Quién lo usa?:\u003C/strong> Mozos, Cajeros y Encargados de Salón\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🎯 ¿Qué es y para qué sirve esta pantalla?\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"que-es-y-para-que-sirve-esta-pantalla\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"que-es-y-para-que-sirve-esta-pantalla\">\u003C/div>\n\n\u003Cp>El \u003Cstrong>Salón de Ventas\u003C/strong> (también llamado \u003Cstrong>Adición\u003C/strong>) es la pantalla donde se atiende cada mesa, de principio a fin:\u003C/p>\n\u003Col>\n\u003Cli>\u003Cstrong>Abrir la mesa\u003C/strong> y elegir el mozo que la atiende.\u003C/li>\n\u003Cli>\u003Cstrong>Cargar los productos\u003C/strong> que pide el cliente y \u003Cstrong>comandar\u003C/strong> (mandar el pedido a cocina o barra).\u003C/li>\n\u003Cli>\u003Cstrong>Cerrar la mesa\u003C/strong> cuando piden la cuenta e imprimir el \u003Cstrong>remito\u003C/strong> (la cuenta).\u003C/li>\n\u003Cli>\u003Cstrong>Cobrar\u003C/strong> con uno o varios medios de pago.\u003C/li>\n\u003Cli>\u003Cstrong>Emitir la factura\u003C/strong> con CAE cuando el cliente la necesita (por ejemplo, una \u003Cstrong>Factura A\u003C/strong>).\u003C/li>\n\u003Cli>Hacer el \u003Cstrong>Checkout\u003C/strong> para \u003Cstrong>liberar la mesa\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cblockquote>\n\u003Cp>🧭 \u003Cstrong>El recorrido completo de una mesa es:\u003C/strong>\nAbrir mesa → Cargar productos → \u003Cstrong>Comandar\u003C/strong> → \u003Cstrong>Cerrar\u003C/strong> → Imprimir remito → \u003Cstrong>Cobrar\u003C/strong> → \u003Cstrong>Emitir\u003C/strong> factura (solo si hace falta) → \u003Cstrong>Checkout\u003C/strong>\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🔑 Requisitos para empezar a usarlo\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"requisitos-para-empezar-a-usarlo\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"requisitos-para-empezar-a-usarlo\">\u003C/div>\n\n\u003Cul>\n\u003Cli>Tener al menos un \u003Cstrong>mozo\u003C/strong> creado (ver \u003Ca href=\"#antes-de-empezar-configurar-los-mozos\">Antes de empezar: configurar los mozos\u003C/a>).\u003C/li>\n\u003Cli>Tener productos cargados en el menú (ver \u003Ca href=\"/user-guide/menu\">Menú de Productos\u003C/a>).\u003C/li>\n\u003Cli>Para cobrar en efectivo o con tarjeta cargada a mano, tener la \u003Cstrong>caja abierta\u003C/strong> (ver \u003Ca href=\"#paso-2-abri-la-caja\">Paso 2: Abrí la caja\u003C/a>).\u003C/li>\n\u003Cli>Para imprimir comandas, remitos y facturas, tener \u003Cstrong>Fiscalberry\u003C/strong> abierto en la computadora del local (ver \u003Ca href=\"/user-guide/impresoras\">Gestión de Impresoras\u003C/a>).\u003C/li>\n\u003Cli>Para facturar electrónicamente, tener el \u003Cstrong>punto de venta\u003C/strong> cargado (ver \u003Ca href=\"/user-guide/puntos-de-venta-pdv\">Puntos de Venta\u003C/a>).\u003C/li>\n\u003C/ul>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                👥 Antes de empezar: configurar los mozos\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"antes-de-empezar-configurar-los-mozos\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"antes-de-empezar-configurar-los-mozos\">\u003C/div>\n\n\u003Cp>Cada mesa pertenece a un mozo. Hay que hacer dos cosas: \u003Cstrong>crear el mozo\u003C/strong> y darle un \u003Cstrong>usuario con PIN\u003C/strong> para que pueda entrar al sistema.\u003C/p>\n\u003Ch3 class=\"relative\">\n                Paso A: Crear el mozo y sus ajustes\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-a-crear-el-mozo\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h3>\n            \u003Cdiv id=\"paso-a-crear-el-mozo\">\u003C/div>\n\n\u003Cp>Los mozos se cargan en \u003Cstrong>Ventas\u003C/strong> → \u003Cstrong>Mozos\u003C/strong>. Ahí elegís su alias, su punto de venta, su impresora y quién lo puede usar.\u003C/p>\n\u003Cblockquote>\n\u003Cp>🔗 Guía completa, paso a paso y con fotos: \u003Ca href=\"/user-guide/mozos\">Cómo Cargar los Mozos\u003C/a>\u003C/p>\n\u003C/blockquote>\n\u003Ch3 class=\"relative\">\n                Paso C: Crear el usuario con PIN\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-c-crear-el-usuario-con-pin\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h3>\n            \u003Cdiv id=\"paso-c-crear-el-usuario-con-pin\">\u003C/div>\n\n\u003Cp>Para que el mozo entre al sistema con un código numérico, creale un \u003Cstrong>usuario con PIN\u003C/strong> en \u003Cstrong>Configuración\u003C/strong> → \u003Cstrong>Usuarios y acceso\u003C/strong> → \u003Cstrong>Usuarios con PIN\u003C/strong>.\u003C/p>\n\u003Cblockquote>\n\u003Cp>🔗 Guía completa: \u003Ca href=\"/user-guide/usuarios-con-pin\">Usuarios con PIN\u003C/a>\u003C/p>\n\u003C/blockquote>\n\u003Cblockquote>\n\u003Cp>💡 \u003Cstrong>Consejo útil:\u003C/strong> En \u003Cstrong>Visibilidad por Usuarios\u003C/strong> del mozo marcá su usuario con PIN. Así cada mozo ve solo su columna de mesas.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                📑 Guía Paso a Paso: ¿Cómo se usa?\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"guia-paso-a-paso-como-se-usa\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"guia-paso-a-paso-como-se-usa\">\u003C/div>\n\n\u003Ch3 class=\"relative\">\n                Paso 1: Entrá al Salón de Ventas\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-1-entra-al-salon-de-ventas\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h3>\n            \u003Cdiv id=\"paso-1-entra-al-salon-de-ventas\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/21-00a-menu-grupo-ventas.png\" alt=\"Grupo Ventas del menú lateral, marcado en rojo\">\u003C/p>\n\u003Col>\n\u003Cli>En el menú de la izquierda, tocá \u003Cstrong>Ventas\u003C/strong>. Se despliegan sus opciones.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/21-00b-menu-opcion-adicionar.png\" alt=\"Opción Salón de Ventas dentro del grupo Ventas, marcada en rojo\">\u003C/p>\n\u003Col start=\"2\">\n\u003Cli>Tocá \u003Cstrong>Salón de Ventas\u003C/strong>.\u003C/li>\n\u003Cli>Vas a ver las mesas abiertas, agrupadas por mozo.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/01-salon-listado-mesas.png\" alt=\"Listado de mesas del salón con mesas abiertas en rojo y el botón Abrir Mesa\">\u003C/p>\n\u003Cp>En esta pantalla vas a ver:\u003C/p>\n\u003Cul>\n\u003Cli>El botón \u003Cstrong>&quot;+ Abrir Mesa&quot;\u003C/strong> para crear una mesa nueva.\u003C/li>\n\u003Cli>Las mesas abiertas de cada mozo, con su \u003Cstrong>número\u003C/strong>, \u003Cstrong>importe\u003C/strong> y \u003Cstrong>hora de apertura\u003C/strong>.\u003C/li>\n\u003Cli>Arriba a la derecha, cuántas \u003Cstrong>Mesas\u003C/strong> y \u003Cstrong>Cubiertos\u003C/strong> hay activos.\u003C/li>\n\u003C/ul>\n\u003Chr>\n\u003Ch3 class=\"relative\">\n                Paso 2: Abrí la caja\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-2-abri-la-caja\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h3>\n            \u003Cdiv id=\"paso-2-abri-la-caja\">\u003C/div>\n\n\u003Cp>Para cobrar en efectivo necesitás la caja abierta. Si está cerrada, arriba aparece el botón \u003Cstrong>Abrir Caja\u003C/strong>.\u003C/p>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/21-205-donde-esta-boton-abrir-caja.png\" alt=\"Encabezado del Salón de Ventas con el botón Abrir Caja marcado en rojo\">\u003C/p>\n\u003Col>\n\u003Cli>Tocá \u003Cstrong>Abrir Caja\u003C/strong>. Está arriba, en el encabezado del salón.\u003C/li>\n\u003Cli>Si tenés más de una caja, elegí cuál abrir y tocá \u003Cstrong>Continuar\u003C/strong>.\u003C/li>\n\u003Cli>Se abre la ventana \u003Cstrong>Iniciar Caja\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/21-207-dialogo-iniciar-caja.png\" alt=\"Ventana Iniciar Caja con la lista de billetes\">\u003C/p>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/21-208-campo-billetes.png\" alt=\"Casillero para la cantidad de billetes\">\u003C/p>\n\u003Col start=\"4\">\n\u003Cli>Al lado de cada billete, escribí cuántos hay en la caja. Por ejemplo: \u003Cem>2\u003C/em> billetes de \u003Cem>$ 1.000\u003C/em>.\u003C/li>\n\u003Cli>Arriba se suma solo el \u003Cstrong>Total en Caja\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/21-209-boton-confirmar-abrir-caja.png\" alt=\"Botón verde Abrir Caja para confirmar\">\u003C/p>\n\u003Col start=\"6\">\n\u003Cli>Tocá el botón verde \u003Cstrong>Abrir Caja\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/21-210-caja-abierta.png\" alt=\"Mensaje Caja Abierta con el importe inicial\">\u003C/p>\n\u003Col start=\"7\">\n\u003Cli>Vas a ver el mensaje \u003Cstrong>¡Caja Abierta!\u003C/strong>. Ahora en el encabezado está el botón para cerrarla.\u003C/li>\n\u003C/ol>\n\u003Cblockquote>\n\u003Cp>💡 Si no ves el botón \u003Cstrong>Abrir Caja\u003C/strong>, la caja ya está abierta. Seguí con el paso siguiente.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch3 class=\"relative\">\n                Paso 3: Abrí una mesa\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-3-abri-una-mesa\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h3>\n            \u003Cdiv id=\"paso-3-abri-una-mesa\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/21-42-donde-esta-boton-abrir.png\" alt=\"Listado de mesas con el botón Abrir Mesa marcado en rojo\">\u003C/p>\n\u003Col>\n\u003Cli>\u003Cp>Tocá \u003Cstrong>&quot;+ Abrir Mesa&quot;\u003C/strong>.\u003C/p>\n\u003C/li>\n\u003Cli>\u003Cp>Si te lo pide, elegí el \u003Cstrong>mozo\u003C/strong> que va a atender la mesa.\u003C/p>\n\u003C/li>\n\u003C/ol>\n\u003C!-- FOTO: 21-05-elegir-mozo -->\n\u003Col start=\"3\">\n\u003Cli>Escribí la \u003Cstrong>descripción\u003C/strong> de la mesa (por ejemplo, el número: \u003Cem>12\u003C/em>) y la \u003Cstrong>cantidad de cubiertos\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/17-salon-dialogo-abrir-mesa.png\" alt=\"Diálogo para abrir una mesa nueva con cantidad de cubiertos\">\u003C/p>\n\u003Col start=\"4\">\n\u003Cli>Tocá \u003Cstrong>Guardar\u003C/strong>. Se abre la mesa, vacía.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/18-salon-mesa-abierta.png\" alt=\"Mesa recién abierta, sin productos cargados\">\u003C/p>\n\u003Cblockquote>\n\u003Cp>💡 Si el mozo tiene activado \u003Cstrong>Mozo Veloz\u003C/strong>, la mesa se abre directo, sin pedir descripción ni cubiertos.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch3 class=\"relative\">\n                Paso 4: Cargá los productos y comandá\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-4-carga-los-productos-y-comanda\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h3>\n            \u003Cdiv id=\"paso-4-carga-los-productos-y-comanda\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/21-148-donde-esta-boton-nueva-comanda.png\" alt=\"Mesa abierta con el botón Nueva Comanda marcado en rojo\">\u003C/p>\n\u003Col>\n\u003Cli>\u003Cp>Dentro de la mesa, tocá \u003Cstrong>&quot;+ Nueva Comanda&quot;\u003C/strong>.\u003C/p>\n\u003C/li>\n\u003Cli>\u003Cp>Se abre el catálogo. Buscá o tocá los productos que pidió el cliente. Cada uno se suma a la lista con su precio.\u003C/p>\n\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/20-salon-catalogo-productos.png\" alt=\"Catálogo de productos del menú activo\">\u003C/p>\n\u003Cp>Si no buscás, tocá primero la \u003Cstrong>categoría\u003C/strong> (por ejemplo, \u003Cstrong>Pizzas\u003C/strong>). Vas a ver sus productos.\u003C/p>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/21-211-boton-categoria.png\" alt=\"Botón azul de la categoría Pizzas en el catálogo\">\u003C/p>\n\u003Cp>Tocá el producto. Se suma a la comanda de la izquierda.\u003C/p>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/21-197-boton-producto.png\" alt=\"Botón de un producto del catálogo\">\u003C/p>\n\u003Col start=\"3\">\n\u003Cli>Si el producto tiene \u003Cstrong>variantes\u003C/strong> (por ejemplo, gustos de helado), elegí las opciones que te pide\u003C/li>\n\u003C/ol>\n\u003C!-- FOTO: 21-06-elegir-variantes -->\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/21-198-donde-esta-boton-comandar.png\" alt=\"Catálogo con el botón Comandar marcado en rojo\">\u003C/p>\n\u003Col start=\"4\">\n\u003Cli>\u003Cp>Cuando terminaste, tocá \u003Cstrong>Comandar\u003C/strong>. El pedido sale impreso en cocina o barra.\u003C/p>\n\u003C/li>\n\u003Cli>\u003Cp>La mesa vuelve a su vista principal, con la comanda cargada.\u003C/p>\n\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/23-salon-comanda-cargada.png\" alt=\"Mesa con la comanda cargada tras comandar\">\u003C/p>\n\u003Cblockquote>\n\u003Cp>💡 Si el cliente pide algo más, repetí este paso: cada vez que tocás \u003Cstrong>Comandar\u003C/strong> sale una comanda nueva.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch3 class=\"relative\">\n                Paso 5: Asigná un cliente (o creá uno nuevo)\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-5-asigna-un-cliente-o-crea-uno-nuevo\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h3>\n            \u003Cdiv id=\"paso-5-asigna-un-cliente-o-crea-uno-nuevo\">\u003C/div>\n\n\u003Cp>Asignar un cliente es \u003Cstrong>opcional\u003C/strong>, pero es \u003Cstrong>obligatorio para hacer una Factura A\u003C/strong>. Lo podés hacer \u003Cstrong>en cualquier momento\u003C/strong>, mientras la mesa esté abierta o después de cerrarla.\u003C/p>\n\u003Col>\n\u003Cli>\u003Cp>Dentro de la mesa, tocá \u003Cstrong>⚙️ Opciones\u003C/strong> (arriba a la derecha).\n\u003Cimg src=\"/images/manual/20-ventas/21-115-donde-esta-boton-opciones.png\" alt=\"Mesa con el botón Opciones marcado en rojo\">\u003C/p>\n\u003C/li>\n\u003Cli>\u003Cp>Tocá \u003Cstrong>Cliente\u003C/strong>.\u003C/p>\n\u003C/li>\n\u003C/ol>\n\u003C!-- FOTO: 21-08-opcion-cliente -->\n\u003Col start=\"3\">\n\u003Cli>Se abre la ventana \u003Cstrong>Seleccionar Cliente\u003C/strong>. Escribí el nombre, teléfono o email en el buscador.\u003C/li>\n\u003C/ol>\n\u003C!-- FOTO: 21-09-buscar-cliente -->\n\u003Col start=\"4\">\n\u003Cli>\u003Cstrong>Si el cliente aparece\u003C/strong>, tocalo y queda asignado a la mesa.\u003C/li>\n\u003Cli>\u003Cstrong>Si el cliente no existe\u003C/strong>, tocá \u003Cstrong>Crear Cliente\u003C/strong>. Se abre otra ventana con el formulario:\u003C/li>\n\u003C/ol>\n\u003C!-- FOTO: 21-10-boton-crear-cliente -->\n\n\u003Cdiv class=\"table-wrapper\">\u003Ctable>\n\u003Cthead>\n\u003Ctr>\n\u003Cth>Campo\u003C/th>\n\u003Cth>¿Qué poner?\u003C/th>\n\u003C/tr>\n\u003C/thead>\n\u003Ctbody>\u003Ctr>\n\u003Ctd>\u003Cstrong>Teléfono (whatsapp)\u003C/strong>\u003C/td>\n\u003Ctd>El teléfono del cliente.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>Nombre/Razón Social\u003C/strong>\u003C/td>\n\u003Ctd>El nombre de la persona o de la empresa.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>Domicilio de Facturación\u003C/strong>\u003C/td>\n\u003Ctd>La dirección que va en la factura.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>E-mail\u003C/strong>\u003C/td>\n\u003Ctd>Para mandarle la factura por correo.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>Tipo de documento\u003C/strong> y \u003Cstrong>Número\u003C/strong>\u003C/td>\n\u003Ctd>Para una Factura A: elegí \u003Cstrong>CUIT\u003C/strong> y escribí los 11 números.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>Descuento\u003C/strong>\u003C/td>\n\u003Ctd>Si el cliente tiene un descuento fijo. Si no, dejá \u003Cstrong>Sin Descuento\u003C/strong>.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>Fecha\u003C/strong>\u003C/td>\n\u003Ctd>Cumpleaños o inicio de actividades (opcional).\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>Condición IVA\u003C/strong>\u003C/td>\n\u003Ctd>\u003Cstrong>Define si la factura sale A o B.\u003C/strong> Para una Factura A elegí \u003Cstrong>Responsable Inscripto\u003C/strong>.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>Observación\u003C/strong>\u003C/td>\n\u003Ctd>Una nota sobre el cliente (opcional).\u003C/td>\n\u003C/tr>\n\u003C/tbody>\u003C/table>\u003C/div>\n\u003C!-- FOTO: 21-11-formulario-crear-cliente -->\n\n\u003Col start=\"6\">\n\u003Cli>Guardá el cliente. Queda asignado a la mesa y su nombre aparece en el costado de la mesa.\u003C/li>\n\u003C/ol>\n\u003Cblockquote>\n\u003Cp>🔗 Para ver y editar todos tus clientes: \u003Ca href=\"/user-guide/clientes\">Clientes\u003C/a>\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch3 class=\"relative\">\n                Paso 6: Cerrá la mesa e imprimí el remito\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-6-cerra-la-mesa-e-imprimi-el-remito\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h3>\n            \u003Cdiv id=\"paso-6-cerra-la-mesa-e-imprimi-el-remito\">\u003C/div>\n\n\u003Cp>Cuando el cliente pide la cuenta:\u003C/p>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/21-119-donde-esta-boton-cerrar.png\" alt=\"Mesa con el botón Cerrar marcado en rojo\">\u003C/p>\n\u003Col>\n\u003Cli>\u003Cp>Tocá \u003Cstrong>🔒 Cerrar\u003C/strong>, en la barra de la izquierda. La mesa se cierra y ya no se le pueden cargar productos.\u003C/p>\n\u003C/li>\n\u003Cli>\u003Cp>La pantalla cambia a la vista \u003Cstrong>🧾 Remito\u003C/strong>: el detalle de todo lo consumido, con el total.\u003C/p>\n\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/25-salon-remito.png\" alt=\"Vista de Remito con el detalle de la mesa cerrada\">\u003C/p>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/21-154-donde-esta-boton-imprimir.png\" alt=\"Remito con el botón Imprimir marcado en rojo\">\u003C/p>\n\u003Col start=\"3\">\n\u003Cli>Si el remito \u003Cstrong>no salió impreso solo\u003C/strong>, tocá \u003Cstrong>Imprimir\u003C/strong> en la sección \u003Cstrong>🖨️ Remito\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cblockquote>\n\u003Cp>💡 El \u003Cstrong>remito\u003C/strong> es la cuenta para el cliente: dice \u003Cstrong>&quot;Documento no válido como factura&quot;\u003C/strong>. No es una factura.\nDesde la misma sección también podés \u003Cstrong>Descargar Img\u003C/strong> o \u003Cstrong>Descargar PDF A4\u003C/strong> para mandarlo por WhatsApp o mail.\u003C/p>\n\u003C/blockquote>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/21-121-donde-esta-boton-reabrir.png\" alt=\"Mesa cerrada con el botón Reabrir marcado en rojo\">\u003C/p>\n\u003Cblockquote>\n\u003Cp>🔓 ¿Cerraste por error? Tocá \u003Cstrong>🔓 Reabrir\u003C/strong> y la mesa vuelve a estar abierta.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch3 class=\"relative\">\n                Paso 7: Cobrá la mesa\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-7-cobra-la-mesa\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h3>\n            \u003Cdiv id=\"paso-7-cobra-la-mesa\">\u003C/div>\n\n\u003Col>\n\u003Cli>\u003Cp>En la vista \u003Cstrong>Remito\u003C/strong>, tocá \u003Cstrong>💰 Cobrar\u003C/strong>.\n\u003Cimg src=\"/images/manual/20-ventas/21-150-donde-esta-boton-cobrar.png\" alt=\"Remito con el botón Cobrar marcado en rojo\">\u003C/p>\n\u003C/li>\n\u003Cli>\u003Cp>Se abre la pantalla de cobro con el \u003Cstrong>Total a cobrar\u003C/strong>. En \u003Cstrong>¿Cómo paga?\u003C/strong> elegí el medio de pago (efectivo, tarjeta, Mercado Pago, etc.). Si no ves el que buscás, tocá \u003Cstrong>Más métodos de pago...\u003C/strong>\n\u003Cimg src=\"/images/manual/20-ventas/28-salon-pantalla-cobro.png\" alt=\"Pantalla de cobro con el total y los medios de pago\">\u003C/p>\n\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/21-200-boton-metodo-efectivo.png\" alt=\"Botón del medio de pago Efectivo\">\n3. \u003Cstrong>Si paga en efectivo:\u003C/strong> en \u003Cstrong>💵 ¿Con cuánto paga el cliente?\u003C/strong> escribí el billete que te dio. El sistema te muestra el \u003Cstrong>Vuelto\u003C/strong>. Si paga justo, tocá \u003Cstrong>✓ Monto exacto\u003C/strong>.\n\u003Cimg src=\"/images/manual/20-ventas/21-201-campo-con-cuanto-paga.png\" alt=\"Casillero Con cuánto paga el cliente\">\u003C/p>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/21-202-pantalla-cobro-efectivo.png\" alt=\"Pantalla de cobro con Efectivo elegido y el vuelto calculado\">\u003C/p>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/21-203-boton-confirmar-cobro.png\" alt=\"Botón verde para confirmar el cobro\">\u003C/p>\n\u003Col start=\"4\">\n\u003Cli>Tocá el botón verde de abajo para confirmar el pago.\u003C/li>\n\u003C/ol>\n\u003Cblockquote>\n\u003Cp>⚠️ \u003Cstrong>Atención:\u003C/strong> El botón verde cobra de verdad. Revisá la mesa y el total antes de tocarlo. Si te equivocaste de mesa, tocá \u003Cstrong>← Volver a la mesa\u003C/strong> y no se cobra nada.\u003C/p>\n\u003C/blockquote>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/21-204-boton-volver-a-la-mesa.png\" alt=\"Botón Volver a la mesa\">\u003C/p>\n\u003Ch4 class=\"relative\">\n                Si paga con varios medios\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"si-paga-con-varios-medios\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h4>\n            \u003Cdiv id=\"si-paga-con-varios-medios\">\u003C/div>\n\n\u003Cp>Por ejemplo, una parte en efectivo y otra con tarjeta:\u003C/p>\n\u003Col>\n\u003Cli>Cobrá la primera parte: elegí el medio y escribí \u003Cstrong>solo ese monto\u003C/strong>.\u003C/li>\n\u003Cli>La mesa queda con saldo pendiente y el botón cambia a \u003Cstrong>💰 Agregar Pago\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003C!-- FOTO: 21-15-boton-agregar-pago -->\n\u003Col start=\"3\">\n\u003Cli>Tocá \u003Cstrong>Agregar Pago\u003C/strong> y cobrá lo que falta con el otro medio.\u003C/li>\n\u003Cli>Repetí hasta que no falte nada.\u003C/li>\n\u003C/ol>\n\u003Cblockquote>\n\u003Cp>💡 Si varias personas pagan su parte, en la pantalla de cobro podés usar \u003Cstrong>✂️ Dividir\u003C/strong> para repartir el total y cargar un pago por cada uno (\u003Cstrong>➕ Agregar Otro Pago\u003C/strong>).\u003C/p>\n\u003C/blockquote>\n\u003Ch4 class=\"relative\">\n                ¿No aparece el medio de pago que necesitás?\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"no-aparece-el-medio-de-pago\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h4>\n            \u003Cdiv id=\"no-aparece-el-medio-de-pago\">\u003C/div>\n\n\u003Cp>Los medios de pago se dan de alta en \u003Cstrong>Configuración\u003C/strong> → \u003Cstrong>Tablas maestras\u003C/strong> → \u003Cstrong>Tipos de Pago\u003C/strong>.\u003C/p>\n\u003Cblockquote>\n\u003Cp>🔗 Guías completas: \u003Ca href=\"/user-guide/medios-de-cobro\">Medios de cobro\u003C/a> · \u003Ca href=\"/user-guide/configuracion-general#cobros-y-pagos\">Cobros y pagos\u003C/a>\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch3 class=\"relative\">\n                Paso 8: Emití la factura (solo si hace falta)\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-8-emiti-la-factura\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h3>\n            \u003Cdiv id=\"paso-8-emiti-la-factura\">\u003C/div>\n\n\u003Cp>Si el cliente te pide factura, hacela desde la sección \u003Cstrong>🧾 Factura Fiscal\u003C/strong> de la vista \u003Cstrong>Remito\u003C/strong>:\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Emitir:\u003C/strong> hace la factura electrónica en ARCA (con \u003Cstrong>CAE\u003C/strong>).\u003C/li>\n\u003Cli>\u003Cstrong>Imprimir:\u003C/strong> hace la factura y además la imprime por \u003Cstrong>Fiscalberry\u003C/strong>.\u003C/li>\n\u003C/ul>\n\u003C!-- FOTO: 21-16-seccion-factura-fiscal -->\n\n\u003Ch4 class=\"relative\">\n                Cómo hacer una Factura A\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"como-hacer-una-factura-a\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h4>\n            \u003Cdiv id=\"como-hacer-una-factura-a\">\u003C/div>\n\n\u003Col>\n\u003Cli>Asigná a la mesa un cliente con \u003Cstrong>Condición IVA: Responsable Inscripto\u003C/strong> y su \u003Cstrong>CUIT\u003C/strong> (ver \u003Ca href=\"#paso-5-asigna-un-cliente-o-crea-uno-nuevo\">Paso 5\u003C/a>).\u003C/li>\n\u003Cli>En \u003Cstrong>🧾 Factura Fiscal\u003C/strong>, tocá \u003Cstrong>Imprimir\u003C/strong> o \u003Cstrong>Emitir\u003C/strong>.\u003C/li>\n\u003Cli>Como el cliente es \u003Cstrong>Responsable Inscripto\u003C/strong>, la factura sale \u003Cstrong>A\u003C/strong>. Si la mesa no tiene cliente, o el cliente no es Responsable Inscripto, la factura \u003Cstrong>no\u003C/strong> sale A.\u003C/li>\n\u003C/ol>\n\u003Cblockquote>\n\u003Cp>⚠️ \u003Cstrong>Atención:\u003C/strong> Revisá bien el cliente antes de facturar. Una factura mal hecha no se borra: hay que anularla con una \u003Cstrong>Nota de Crédito\u003C/strong>.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch3 class=\"relative\">\n                Paso 9: Hacé el Checkout (liberá la mesa)\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-9-hace-el-checkout\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h3>\n            \u003Cdiv id=\"paso-9-hace-el-checkout\">\u003C/div>\n\n\u003Col>\n\u003Cli>Cuando la mesa está \u003Cstrong>totalmente cobrada\u003C/strong>, en la vista \u003Cstrong>Remito\u003C/strong> aparece el botón \u003Cstrong>👋 Checkout\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003C!-- FOTO: 21-17-boton-checkout -->\n\u003Col start=\"2\">\n\u003Cli>Tocalo. La mesa se \u003Cstrong>libera\u003C/strong> y sale del listado del salón.\u003C/li>\n\u003C/ol>\n\u003Cblockquote>\n\u003Cp>⚠️ Si la mesa tiene \u003Cstrong>pagos pendientes de aprobación\u003C/strong>, el sistema te avisa antes. Podés \u003Cstrong>✓ Aprobar pagos primero\u003C/strong> o \u003Cstrong>⚠️ Checkout de todos modos\u003C/strong> (en ese caso, esos pagos \u003Cstrong>no\u003C/strong> se cuentan como cobrados).\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                ⚙️ Más opciones dentro de una mesa\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"mas-opciones-dentro-de-una-mesa\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"mas-opciones-dentro-de-una-mesa\">\u003C/div>\n\n\u003Cp>El botón \u003Cstrong>⚙️ Opciones\u003C/strong> (arriba a la derecha de la mesa) tiene más acciones. Algunas solo funcionan con la mesa \u003Cstrong>abierta\u003C/strong>:\u003C/p>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/21-199-dialogo-opciones.png\" alt=\"Ventana Opciones de la mesa\">\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>👤 Mozo:\u003C/strong> cambiá el mozo de la mesa. Se abre una ventana para \u003Cstrong>Seleccionar\u003C/strong> el nuevo mozo.\u003C/li>\n\u003Cli>\u003Cstrong>✏️ Número:\u003C/strong> cambiá la descripción o número de la mesa.\u003C/li>\n\u003Cli>\u003Cstrong>🍽️ Cubiertos:\u003C/strong> cambiá la cantidad de cubiertos.\u003C/li>\n\u003Cli>\u003Cstrong>Cliente:\u003C/strong> asigná o cambiá el cliente (ver \u003Ca href=\"#paso-5-asigna-un-cliente-o-crea-uno-nuevo\">Paso 5\u003C/a>).\u003C/li>\n\u003Cli>\u003Cstrong>Observación:\u003C/strong> una nota sobre la mesa.\u003C/li>\n\u003Cli>\u003Cstrong>💸 Descuento:\u003C/strong> aplicá un descuento a la mesa.\u003C/li>\n\u003Cli>\u003Cstrong>✂️ Dividir Mesa:\u003C/strong> separá consumos en otra mesa.\u003C/li>\n\u003Cli>\u003Cstrong>🗑️ Anular Mesa:\u003C/strong> anula la mesa completa.\u003C/li>\n\u003C/ul>\n\u003Cblockquote>\n\u003Cp>ℹ️ Si no ves alguno de estos botones, tu usuario no tiene permiso para usarlo. Pedíselo al administrador.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                ⚠️ ¿Qué hacer si algo no sale bien? (Problemas Comunes)\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"que-hacer-si-algo-no-sale-bien-problemas-comunes\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"que-hacer-si-algo-no-sale-bien-problemas-comunes\">\u003C/div>\n\n\u003Cdiv class=\"table-wrapper\">\u003Ctable>\n\u003Cthead>\n\u003Ctr>\n\u003Cth>¿Qué te pasa?\u003C/th>\n\u003Cth>¿Por qué puede ser?\u003C/th>\n\u003Cth>¿Cómo se soluciona?\u003C/th>\n\u003C/tr>\n\u003C/thead>\n\u003Ctbody>\u003Ctr>\n\u003Ctd>El mozo no aparece para abrir la mesa.\u003C/td>\n\u003Ctd>El mozo está \u003Cstrong>inactivo\u003C/strong>, o tu usuario no está en su \u003Cstrong>Visibilidad por Usuarios\u003C/strong>.\u003C/td>\n\u003Ctd>Editá el mozo en \u003Cstrong>Configuración → Tablas maestras → Mozos\u003C/strong> y revisá esas dos opciones.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>No sale impresa la comanda ni el remito.\u003C/td>\n\u003Ctd>\u003Cstrong>Fiscalberry\u003C/strong> está cerrado, o la impresora está apagada o sin papel.\u003C/td>\n\u003Ctd>Abrí Fiscalberry en la computadora del local y revisá la impresora. Ver \u003Ca href=\"/user-guide/impresoras\">Gestión de Impresoras\u003C/a>.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>El sistema no me deja cobrar en efectivo.\u003C/td>\n\u003Ctd>No hay un \u003Cstrong>arqueo de caja abierto\u003C/strong>.\u003C/td>\n\u003Ctd>Tocá \u003Cstrong>Abrir Caja\u003C/strong> arriba en el salón (ver \u003Ca href=\"#paso-2-abri-la-caja\">Paso 2\u003C/a>) y volvé a cobrar.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>No aparece el botón \u003Cstrong>Cobrar\u003C/strong>.\u003C/td>\n\u003Ctd>La mesa todavía está abierta, o ya está totalmente cobrada.\u003C/td>\n\u003Ctd>Primero tocá \u003Cstrong>🔒 Cerrar\u003C/strong>. Si ya está cobrada, tocá \u003Cstrong>👋 Checkout\u003C/strong>.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>No aparece el botón \u003Cstrong>Checkout\u003C/strong>.\u003C/td>\n\u003Ctd>Todavía falta cobrar una parte.\u003C/td>\n\u003Ctd>Tocá \u003Cstrong>💰 Agregar Pago\u003C/strong> y cobrá lo que falta.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>La factura no salió \u003Cstrong>A\u003C/strong> y el cliente la quería A.\u003C/td>\n\u003Ctd>El cliente no tiene la \u003Cstrong>Condición IVA: Responsable Inscripto\u003C/strong>, o no estaba asignado a la mesa.\u003C/td>\n\u003Ctd>Hay que anular esa factura con una Nota de Crédito. Antes de volver a facturar, corregí el cliente y asignalo a la mesa.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>La mesa sigue ocupada pero la gente ya se fue.\u003C/td>\n\u003Ctd>Faltó cobrar o hacer el \u003Cstrong>Checkout\u003C/strong>.\u003C/td>\n\u003Ctd>Abrí la mesa, cobrá lo que falte y tocá \u003Cstrong>👋 Checkout\u003C/strong>.\u003C/td>\n\u003C/tr>\n\u003C/tbody>\u003C/table>\u003C/div>\n",[5,9,12,15,19,22,25,28,31,34,37,40,43,46,49,52,55],{"id":6,"title":7,"level":8},"que-es-y-para-que-sirve-esta-pantalla","¿Qué es y para qué sirve esta pantalla?",2,{"id":10,"title":11,"level":8},"requisitos-para-empezar-a-usarlo","Requisitos para empezar a usarlo",{"id":13,"title":14,"level":8},"antes-de-empezar-configurar-los-mozos","Antes de empezar: configurar los mozos",{"id":16,"title":17,"level":18},"paso-a-crear-el-mozo","Paso A: Crear el mozo y sus ajustes",3,{"id":20,"title":21,"level":18},"paso-c-crear-el-usuario-con-pin","Paso C: Crear el usuario con PIN",{"id":23,"title":24,"level":8},"guia-paso-a-paso-como-se-usa","Guía Paso a Paso: ¿Cómo se usa?",{"id":26,"title":27,"level":18},"paso-1-entra-al-salon-de-ventas","Paso 1: Entrá al Salón de Ventas",{"id":29,"title":30,"level":18},"paso-2-abri-la-caja","Paso 2: Abrí la caja",{"id":32,"title":33,"level":18},"paso-3-abri-una-mesa","Paso 3: Abrí una mesa",{"id":35,"title":36,"level":18},"paso-4-carga-los-productos-y-comanda","Paso 4: Cargá los productos y comandá",{"id":38,"title":39,"level":18},"paso-5-asigna-un-cliente-o-crea-uno-nuevo","Paso 5: Asigná un cliente (o creá uno nuevo)",{"id":41,"title":42,"level":18},"paso-6-cerra-la-mesa-e-imprimi-el-remito","Paso 6: Cerrá la mesa e imprimí el remito",{"id":44,"title":45,"level":18},"paso-7-cobra-la-mesa","Paso 7: Cobrá la mesa",{"id":47,"title":48,"level":18},"paso-8-emiti-la-factura","Paso 8: Emití la factura (solo si hace falta)",{"id":50,"title":51,"level":18},"paso-9-hace-el-checkout","Paso 9: Hacé el Checkout (liberá la mesa)",{"id":53,"title":54,"level":8},"mas-opciones-dentro-de-una-mesa","Más opciones dentro de una mesa",{"id":56,"title":57,"level":8},"que-hacer-si-algo-no-sale-bien-problemas-comunes","¿Qué hacer si algo no sale bien? (Problemas Comunes)",{"title":59,"description":60,"keywords":61},"Cómo Usar el Salón de Ventas (Adición) - Manual","¿Dónde está en el sistema?: Menú principal → Ventas → Salón de Ventas  \n ¿Quién lo usa?: Mozos, Cajeros y Encargados de Salón","salon de ventas, paxapos, cómo usar el salón de ventas (adición), tutorial, guía, manual usuario","21-salon-de-ventas.txt"],"uses":{"params":["slug"]}}]}
