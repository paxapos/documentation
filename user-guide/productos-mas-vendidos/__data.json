{"type":"data","nodes":[null,{"type":"data","data":[{"moduleCategories":1},[2,17,44,53,77,98,110,140,146,173,185,221,250],{"title":3,"modules":4},"Comenzamos",[5,8,11,14],{"slug":6,"title":7},"introduccion","Bienvenido a tu software gastronómico",{"slug":9,"title":10},"iniciar-sesion","Cómo Iniciar Sesión",{"slug":12,"title":13},"recuperar-contrasena","Cómo Recuperar tu Contraseña",{"slug":15,"title":16},"guia-de-inicio-rapido","Guía de Inicio Rápido",{"title":18,"modules":19},"Ventas",[20,23,26,29,32,35,38,41],{"slug":21,"title":22},"salon-de-ventas","Cómo Usar el Salón de Ventas (Adición)",{"slug":24,"title":25},"caja-rapida","Cómo Usar la Caja Rápida (Registradora)",{"slug":27,"title":28},"mozos","Cómo Cargar los Mozos",{"slug":30,"title":31},"clientes","Cómo Gestionar los Clientes",{"slug":33,"title":34},"descuentos","Cómo Configurar Descuentos",{"slug":36,"title":37},"nueva-reserva","Cómo Cargar una Nueva Reserva",{"slug":39,"title":40},"listado-de-reservas","Cómo Usar el Listado de Reservas",{"slug":42,"title":43},"grilla-de-reservas","Cómo Usar la Grilla de Reservas",{"title":45,"modules":46},"Medios de Pago",[47,50],{"slug":48,"title":49},"configuracion-procesadores","Configuración de Procesadores de Pago",{"slug":51,"title":52},"transacciones-mercadopago","Transacciones MercadoPago",{"title":54,"modules":55},"Productos",[56,59,62,65,68,71,74],{"slug":57,"title":58},"menu","Menú de Productos (Carta)",{"slug":60,"title":61},"categorias","Categorías de Productos",{"slug":63,"title":64},"variantes-grupo-sabores","Variantes y Grupos de Sabores",{"slug":66,"title":67},"maestro-de-productos","Maestro de Productos",{"slug":69,"title":70},"subproductos-elaborados","Sub-Productos (Elaborados)",{"slug":72,"title":73},"recetas","Recetas",{"slug":75,"title":76},"analisis-duplicados","Buscar Duplicados",{"title":78,"modules":79},"Compras",[80,83,86,89,92,95],{"slug":81,"title":82},"todas-las-ordenes-compra","Órdenes de Compra",{"slug":84,"title":85},"crear-orden-compra","Crear una Orden de Compra",{"slug":87,"title":88},"ordenes-a-aprobar","Órdenes a aprobar",{"slug":90,"title":91},"mercaderias","Mercaderías",{"slug":93,"title":94},"proveedores","Proveedores",{"slug":96,"title":97},"historial-de-compras","Historial de Compras",{"title":99,"modules":100},"Stock",[101,104,107],{"slug":102,"title":103},"stock-mercaderias","Stock de Mercaderías",{"slug":105,"title":106},"stock-subproductos","Stock de Subproductos",{"slug":108,"title":109},"movimientos-de-stock","Movimientos de Stock",{"title":111,"modules":112},"Finanzas",[113,116,119,122,125,128,131,134,137],{"slug":114,"title":115},"arqueos-de-caja","Arqueos de Caja",{"slug":117,"title":118},"listado-de-cajas","Listado de Cajas",{"slug":120,"title":121},"transacciones-de-cobro","Transacciones de Cobro",{"slug":123,"title":124},"factura-manual","Factura Manual",{"slug":126,"title":127},"resumen-de-deuda","Resumen de Deuda",{"slug":129,"title":130},"pagos","Pagos",{"slug":132,"title":133},"historial-de-facturas","Historial de Facturas",{"slug":135,"title":136},"historico-de-mesas","Histórico de Mesas",{"slug":138,"title":139},"puntos-de-venta-pdv","Puntos de Venta (PDVs)",{"title":141,"modules":142},"Comandero",[143],{"slug":144,"title":145},"comandero","Comandero (pantalla de cocina)",{"title":147,"modules":148},"RRHH",[149,152,155,158,161,164,167,170],{"slug":150,"title":151},"empleados","Empleados",{"slug":153,"title":154},"empleados-trabajando","Empleados Trabajando",{"slug":156,"title":157},"registro-diario-fichaje","Registro Diario de Fichaje",{"slug":159,"title":160},"reporte-mensual-fichaje","Reporte Mensual de Fichaje",{"slug":162,"title":163},"departamentos","Departamentos",{"slug":165,"title":166},"turnos-y-horarios-fichaje","Turnos y Horarios de Fichaje",{"slug":168,"title":169},"sueldos-y-jornales","Sueldos y Jornales",{"slug":171,"title":172},"datos-de-acceso-app","Datos de Acceso a la App de Fichaje",{"title":174,"modules":175},"Reportes",[176,179,182],{"slug":177,"title":178},"tablero-general","Tablero General",{"slug":180,"title":181},"productos-mas-vendidos","Productos Más Vendidos",{"slug":183,"title":184},"compras-por-mercaderia","Compras por Mercadería",{"title":186,"modules":187},"Configuracion",[188,191,194,197,200,203,206,209,212,215,218],{"slug":189,"title":190},"configuracion-general","Configuración general",{"slug":192,"title":193},"impresoras","Cómo cargar las impresoras del local",{"slug":195,"title":196},"perfiles-de-impresion","Cómo usar los perfiles de impresión",{"slug":198,"title":199},"usuarios-del-sistema","Cómo administrar los Usuarios del Sistema",{"slug":201,"title":202},"usuarios-con-pin","Cómo administrar los Usuarios con PIN",{"slug":204,"title":205},"punto-de-venta","🏛️ Trámite en ARCA (con clave fiscal)",{"slug":207,"title":208},"permisos-por-rol","Cómo configurar los Permisos por Rol",{"slug":210,"title":211},"turnos-mesa","Turnos de Mesa",{"slug":213,"title":214},"medios-de-cobro","Medios de cobro",{"slug":216,"title":217},"clasificacion-de-gastos","Clasificación de Gastos",{"slug":219,"title":220},"centros-de-costo","Centros de Costo",{"title":222,"modules":223},"Biblioteca de Drivers",[224,226,229,232,235,238,241,244,247],{"slug":225,"title":222},"biblioteca-de-drivers",{"slug":227,"title":228},"sam4s-giant-100","Sam4S Giant - 100",{"slug":230,"title":231},"citizen-ct-s310ii","Citizen CT-S310II",{"slug":233,"title":234},"epson-tm-t20","Epson TM-T20",{"slug":236,"title":237},"drivers-genericos","Drivers Genéricos POS",{"slug":239,"title":240},"epson-tm-t88","Epson TM-T88V",{"slug":242,"title":243},"fiscalberry-windows","Instalar Fiscalberry en Windows",{"slug":245,"title":246},"fiscalberry-linux","Instalar Fiscalberry en Linux",{"slug":248,"title":249},"fiscalberry-android","Instalar Fiscalberry en Android",{"title":251,"modules":252},"Extra",[253,256,259,262,265,268,271,274,277,280],{"slug":254,"title":255},"01-faq-solucion-inicial-pantalla-congelada","📖 Manual de Usuario: Solución Inicial si la Pantalla se Congela o no Carga",{"slug":257,"title":258},"03-faq-mozo-reabrir-mesa-anulada","📖 Manual de Usuario: Cómo Reabrir una Mesa Anulada o Cerrada por Error",{"slug":260,"title":261},"05-faq-cajero-emitir-factura-a","📖 Manual de Usuario: Cómo Emitir una Factura A Cargando Datos del Cliente",{"slug":263,"title":264},"06-faq-cajero-ingreso-egreso-cajon","📖 Manual de Usuario: Cómo Registrar Entradas y Salidas de Dinero del Cajón",{"slug":266,"title":267},"07-faq-cajero-activar-medio-pago","📖 Manual de Usuario: Cómo Activar un Medio de Pago que no Aparece al Cobrar",{"slug":269,"title":270},"08-faq-cajero-diferencia-facturado-vs-abiertas","📖 Manual de Usuario: Diferencia entre \"Facturado Total Mesas\" y \"Abiertas Por Usuario\" en Caja",{"slug":272,"title":273},"10-faq-supervisor-cierre-caja-diferencias","📖 Manual de Usuario: Cómo Auditar y Solucionar Diferencias en el Cierre de Caja",{"slug":275,"title":276},"preguntas-frecuentes","Preguntas Frecuentes y Guías Rápidas por Rol",{"slug":278,"title":279},"buchon-bot","Buchón Bot",{"slug":281,"title":282},"troubleshooting-semantico","📖 Guía Única de Resolución de Problemas y Errores (Troubleshooting)"],"uses":{}},{"type":"data","data":[{"slug":1,"title":2,"content":3,"tableOfContents":4,"seo":33,"llmTxtFile":37},"productos-mas-vendidos","Productos Más Vendidos","\u003Cdiv id=\"productos-mas-vendidos\">\u003C/div>\n\n\u003Cblockquote>\n\u003Cp>\u003Cstrong>¿Dónde está en el sistema?:\u003C/strong> Menú principal → \u003Cstrong>Reportes\u003C/strong> → \u003Cstrong>Productos más vendidos\u003C/strong> (debajo del título \u003Cstrong>VENTAS\u003C/strong>)\n\u003Cstrong>¿Quién lo usa?:\u003C/strong> Chefs, encargados de carta y gerentes\u003C/p>\n\u003C/blockquote>\n\u003Cblockquote>\n\u003Cp>🎯 \u003Cstrong>¿Para qué sirve esto?\u003C/strong>\nTe muestra qué productos vendés más y cuáles casi no se venden.\nSirve para decidir qué comprar, qué destacar en la carta y qué sacar del menú.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🔑 Antes de empezar\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"antes-de-empezar\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"antes-de-empezar\">\u003C/div>\n\n\u003Cul>\n\u003Cli>Tu usuario tiene que tener el permiso de \u003Cstrong>Reportes básicos\u003C/strong> en \u003Ca href=\"/user-guide/permisos-por-rol\">Permisos por Rol\u003C/a>.\u003C/li>\n\u003Cli>Para ver las tarjetas de arriba hace falta además el permiso de \u003Cstrong>Reportes con números\u003C/strong>.\u003C/li>\n\u003Cli>Tiene que haber ventas cerradas en las fechas que elijas.\u003C/li>\n\u003C/ul>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                📍 \u003Cstrong>Paso 1: Entrá a la pantalla\u003C/strong>\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-1-entra-a-la-pantalla\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-1-entra-a-la-pantalla\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/100-reportes/106-00a-menu-grupo-reportes.png\" alt=\"Menú lateral con el grupo Reportes marcado en rojo\">\u003C/p>\n\u003Col>\n\u003Cli>En el menú de la izquierda, tocá \u003Cstrong>Reportes\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/100-reportes/106-00b-menu-opcion-productos-mas-vendidos.png\" alt=\"Opción Productos más vendidos marcada en rojo dentro del menú\">\u003C/p>\n\u003Col start=\"2\">\n\u003Cli>Tocá \u003Cstrong>Productos más vendidos\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/100-reportes/106-01-pantalla-productos-mas-vendidos.png\" alt=\"Pantalla Ranking de Productos Más Vendidos con los filtros a la izquierda y el ranking a la derecha\">\u003C/p>\n\u003Cp>A la izquierda están los filtros. A la derecha, el ranking.\u003C/p>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🔎 \u003Cstrong>Paso 2: Elegí qué querés ver\u003C/strong>\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-2-elegi-que-queres-ver\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-2-elegi-que-queres-ver\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/100-reportes/106-03-filtros.png\" alt=\"Panel de filtros con Cálculo por Ventas, Mozo, Usuario, Producto, Categorías, Tags, Desde, Hasta y el botón verde Filtrar\">\u003C/p>\n\u003Cp>Todos los filtros son opcionales. Dejalos como están para ver todo.\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Cálculo por Ventas\u003C/strong>: ordena el ranking por plata vendida. Es lo que viene marcado.\u003C/li>\n\u003Cli>\u003Cstrong>Cálculo por Unidades\u003C/strong>: ordena el ranking por cantidad de unidades vendidas.\u003C/li>\n\u003Cli>\u003Cstrong>Seleccione Mozo\u003C/strong>: mirá solo lo que vendió un mozo.\u003C/li>\n\u003Cli>\u003Cstrong>Seleccione Usuario\u003C/strong>: mirá solo lo cargado por un usuario.\u003C/li>\n\u003Cli>\u003Cstrong>Seleccione Producto\u003C/strong>: mirá un solo producto.\u003C/li>\n\u003Cli>\u003Cstrong>Categorías\u003C/strong>: elegí una o más. Para elegir varias, tocalas con la tecla Ctrl apretada.\u003C/li>\n\u003Cli>\u003Cstrong>Tags\u003C/strong>: lo mismo, pero por etiquetas del producto.\u003C/li>\n\u003Cli>\u003Cstrong>Desde\u003C/strong> y \u003Cstrong>Hasta\u003C/strong>: el período que querés analizar. Debajo dice cuántos días son.\u003C/li>\n\u003Cli>\u003Cstrong>Filtrar\u003C/strong>: el botón verde. Aplica todo lo que elegiste.\u003C/li>\n\u003C/ul>\n\u003Col>\n\u003Cli>Elegí las fechas en \u003Cstrong>Desde\u003C/strong> y \u003Cstrong>Hasta\u003C/strong>.\u003C/li>\n\u003Cli>Tocá \u003Cstrong>Filtrar\u003C/strong>.\u003C/li>\n\u003Cli>La pantalla se actualiza con el nuevo ranking.\u003C/li>\n\u003C/ol>\n\u003Cblockquote>\n\u003Cp>💡 \u003Cstrong>Consejo útil:\u003C/strong> si el ranking sale vacío, ampliá el rango de fechas. Solo cuentan las ventas de ese período.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                📊 \u003Cstrong>Paso 3: Leé las tarjetas de resumen\u003C/strong>\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-3-lee-las-tarjetas-de-resumen\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-3-lee-las-tarjetas-de-resumen\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/100-reportes/106-05-tarjetas-resumen.png\" alt=\"Cuatro tarjetas: Ventas Totales, Productos Vendidos, Productos Estrella (A) y Productos a Evaluar (C)\">\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Ventas Totales\u003C/strong>: la plata vendida en el período, y cuántos días son.\u003C/li>\n\u003Cli>\u003Cstrong>Productos Vendidos\u003C/strong>: cuántos productos distintos se vendieron.\u003C/li>\n\u003Cli>\u003Cstrong>Productos Estrella (A)\u003C/strong>: cuántos productos generan el 70% de las ventas.\u003C/li>\n\u003Cli>\u003Cstrong>Productos a Evaluar (C)\u003C/strong>: cuántos productos suman solo el último 10%.\u003C/li>\n\u003C/ul>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🔤 \u003Cstrong>Paso 4: Entendé las letras A, B y C\u003C/strong>\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-4-entende-las-letras-a-b-y-c\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-4-entende-las-letras-a-b-y-c\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/100-reportes/106-04-leyenda-analisis-abc.png\" alt=\"Recuadro Análisis ABC (Pareto) con las letras A, B y C explicadas\">\u003C/p>\n\u003Cp>El sistema ordena los productos del que más vende al que menos. Después les pone una letra:\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>A, Estrellas\u003C/strong>: juntos son el 70% de tus ventas. No te quedes sin stock de estos.\u003C/li>\n\u003Cli>\u003Cstrong>B, Importantes\u003C/strong>: son el siguiente 20%. Mantené buen inventario.\u003C/li>\n\u003Cli>\u003Cstrong>C, Complementarios\u003C/strong>: son el último 10%. Evaluá si vale la pena mantenerlos.\u003C/li>\n\u003C/ul>\n\u003Cp>Debajo del recuadro, otro cuadro explica la etiqueta \u003Cstrong>+variante\u003C/strong>. Aparece cuando un producto también se vendió dentro de un combo.\u003C/p>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🏆 \u003Cstrong>Paso 5: Leé el ranking\u003C/strong>\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-5-lee-el-ranking\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-5-lee-el-ranking\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/100-reportes/106-06-ranking-de-productos.png\" alt=\"Tabla del ranking con las columnas #, ABC, Producto, Cantidad, Ventas, Beneficio, Margen y % del Total\">\u003C/p>\n\u003Cp>Cada renglón es un producto. Las columnas dicen:\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>#\u003C/strong>: el puesto. Los tres primeros llevan una estrella de oro, plata y bronce.\u003C/li>\n\u003Cli>\u003Cstrong>ABC\u003C/strong>: la letra del Paso 4.\u003C/li>\n\u003Cli>\u003Cstrong>Producto\u003C/strong>: el nombre. Tocalo para abrir la ficha del producto.\u003C/li>\n\u003Cli>\u003Cstrong>Cantidad\u003C/strong>: cuántas unidades se vendieron.\u003C/li>\n\u003Cli>\u003Cstrong>Ventas\u003C/strong>: la plata vendida, con descuentos ya restados. Debajo, el promedio por día.\u003C/li>\n\u003Cli>\u003Cstrong>Beneficio\u003C/strong>: ventas menos el costo de lo vendido.\u003C/li>\n\u003Cli>\u003Cstrong>Margen %\u003C/strong>: cuánto de cada venta es ganancia. Verde es alto (50% o más). Se pone amarillo o rojo cuando baja.\u003C/li>\n\u003Cli>\u003Cstrong>% del Total\u003C/strong>: cuánto pesa el producto sobre las ventas totales.\u003C/li>\n\u003C/ul>\n\u003Cp>Si elegiste un mozo, aparece además una columna con su número.\u003C/p>\n\u003Cblockquote>\n\u003Cp>💡 \u003Cstrong>Consejo útil:\u003C/strong> si el \u003Cstrong>Beneficio\u003C/strong> es igual a \u003Cstrong>Ventas\u003C/strong>, el producto no tiene costo cargado. Cargalo en la receta del producto para que el margen sea real.\u003C/p>\n\u003C/blockquote>\n\u003Cp>\u003Cstrong>Productos con variantes:\u003C/strong> cuando un producto se vendió también dentro de un combo, aparece la etiqueta azul \u003Cstrong>+variante\u003C/strong> al lado del nombre. En \u003Cstrong>Cantidad\u003C/strong> se ve cuántas fueron por combo. Al final del renglón hay un botón con el ícono de lista, \u003Cstrong>Ver variantes de este producto\u003C/strong>. Tocalo para ver el detalle. Solo mira, no cambia nada. Estos productos no aparecen en el período de estas fotos.\u003C/p>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                ⚠️ \u003Cstrong>Paso 6: Mirá los productos sin ventas\u003C/strong>\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-6-mira-los-productos-sin-ventas\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-6-mira-los-productos-sin-ventas\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/100-reportes/106-07-productos-sin-ventas.png\" alt=\"Recuadro Productos sin ventas en este período con la lista de nombres separados por puntos\">\u003C/p>\n\u003Cp>Abajo del ranking hay una lista con los productos del menú que no vendieron nada en esas fechas. Sirve para revisar precios, cambiarlos de lugar en el menú o dejar de ofrecerlos. Si la lista es larga, se desplaza hacia abajo.\u003C/p>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                📥 \u003Cstrong>Paso 7: Bajá el ranking a Excel\u003C/strong>\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-7-baja-el-ranking-a-excel\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-7-baja-el-ranking-a-excel\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/100-reportes/106-02-donde-esta-boton-descargar-excel.png\" alt=\"Botón azul Descargar Excel marcado en rojo arriba de los filtros\">\u003C/p>\n\u003Col>\n\u003Cli>Elegí los filtros y tocá \u003Cstrong>Filtrar\u003C/strong>.\u003C/li>\n\u003Cli>Tocá el botón azul \u003Cstrong>Descargar Excel\u003C/strong>, arriba de los filtros.\u003C/li>\n\u003Cli>Se baja un archivo con los productos vendidos según lo que filtraste.\u003C/li>\n\u003C/ol>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                ⚠️ \u003Cstrong>Resolución de Inconvenientes\u003C/strong>\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"resolucion-de-inconvenientes\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"resolucion-de-inconvenientes\">\u003C/div>\n\n\u003Cdiv class=\"table-wrapper\">\u003Ctable>\n\u003Cthead>\n\u003Ctr>\n\u003Cth>Problema\u003C/th>\n\u003Cth>Causa más frecuente\u003C/th>\n\u003Cth>Solución recomendada\u003C/th>\n\u003C/tr>\n\u003C/thead>\n\u003Ctbody>\u003Ctr>\n\u003Ctd>No aparece \u003Cstrong>Productos más vendidos\u003C/strong> en el menú\u003C/td>\n\u003Ctd>Tu usuario no tiene el permiso de reportes\u003C/td>\n\u003Ctd>Pedile al dueño que lo active en \u003Ca href=\"/user-guide/permisos-por-rol\">Permisos por Rol\u003C/a>.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>El ranking sale vacío\u003C/td>\n\u003Ctd>No hay ventas cerradas en esas fechas\u003C/td>\n\u003Ctd>Ampliá \u003Cstrong>Desde\u003C/strong> y \u003Cstrong>Hasta\u003C/strong> y tocá \u003Cstrong>Filtrar\u003C/strong>.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>Un producto no figura en el ranking\u003C/td>\n\u003Ctd>No se vendió en el período\u003C/td>\n\u003Ctd>Buscalo en la lista de productos sin ventas.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>No veo las tarjetas de arriba\u003C/td>\n\u003Ctd>Falta el permiso de reportes con números\u003C/td>\n\u003Ctd>Pedile al dueño que lo active.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>El \u003Cstrong>Margen %\u003C/strong> da 100%\u003C/td>\n\u003Ctd>El producto no tiene costo cargado\u003C/td>\n\u003Ctd>Cargale el costo en su receta.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>No encuentro &quot;Ordenar por Unidades&quot;\u003C/td>\n\u003Ctd>Ese botón no existe\u003C/td>\n\u003Ctd>Elegí \u003Cstrong>Cálculo por Unidades\u003C/strong> y tocá \u003Cstrong>Filtrar\u003C/strong>.\u003C/td>\n\u003C/tr>\n\u003C/tbody>\u003C/table>\u003C/div>\n",[5,9,12,15,18,21,24,27,30],{"id":6,"title":7,"level":8},"antes-de-empezar","Antes de empezar",2,{"id":10,"title":11,"level":8},"paso-1-entra-a-la-pantalla","Paso 1: Entrá a la pantalla",{"id":13,"title":14,"level":8},"paso-2-elegi-que-queres-ver","Paso 2: Elegí qué querés ver",{"id":16,"title":17,"level":8},"paso-3-lee-las-tarjetas-de-resumen","Paso 3: Leé las tarjetas de resumen",{"id":19,"title":20,"level":8},"paso-4-entende-las-letras-a-b-y-c","Paso 4: Entendé las letras A, B y C",{"id":22,"title":23,"level":8},"paso-5-lee-el-ranking","Paso 5: Leé el ranking",{"id":25,"title":26,"level":8},"paso-6-mira-los-productos-sin-ventas","Paso 6: Mirá los productos sin ventas",{"id":28,"title":29,"level":8},"paso-7-baja-el-ranking-a-excel","Paso 7: Bajá el ranking a Excel",{"id":31,"title":32,"level":8},"resolucion-de-inconvenientes","Resolución de Inconvenientes",{"title":34,"description":35,"keywords":36},"Productos Más Vendidos - Manual","¿Dónde está en el sistema?: Menú principal → Reportes → Productos más vendidos (debajo del título VENTAS)\n ¿Quién lo usa?: Chefs, enca...","productos mas vendidos, paxapos, productos más vendidos, tutorial, guía, manual usuario","106-productos-mas-vendidos.txt"],"uses":{"params":["slug"]}}]}
