{"type":"data","nodes":[null,{"type":"data","data":[{"moduleCategories":1},[2,17,44,53,77,98,110,140,146,173,185,221,250],{"title":3,"modules":4},"Comenzamos",[5,8,11,14],{"slug":6,"title":7},"introduccion","Bienvenido a tu software gastronómico",{"slug":9,"title":10},"iniciar-sesion","Cómo Iniciar Sesión",{"slug":12,"title":13},"recuperar-contrasena","Cómo Recuperar tu Contraseña",{"slug":15,"title":16},"guia-de-inicio-rapido","Guía de Inicio Rápido",{"title":18,"modules":19},"Ventas",[20,23,26,29,32,35,38,41],{"slug":21,"title":22},"salon-de-ventas","Cómo Usar el Salón de Ventas (Adición)",{"slug":24,"title":25},"caja-rapida","Cómo Usar la Caja Rápida (Registradora)",{"slug":27,"title":28},"mozos","Cómo Cargar los Mozos",{"slug":30,"title":31},"clientes","Cómo Gestionar los Clientes",{"slug":33,"title":34},"descuentos","Cómo Configurar Descuentos",{"slug":36,"title":37},"nueva-reserva","Cómo Cargar una Nueva Reserva",{"slug":39,"title":40},"listado-de-reservas","Cómo Usar el Listado de Reservas",{"slug":42,"title":43},"grilla-de-reservas","Cómo Usar la Grilla de Reservas",{"title":45,"modules":46},"Medios de Pago",[47,50],{"slug":48,"title":49},"configuracion-procesadores","Configuración de Procesadores de Pago",{"slug":51,"title":52},"transacciones-mercadopago","Transacciones MercadoPago",{"title":54,"modules":55},"Productos",[56,59,62,65,68,71,74],{"slug":57,"title":58},"menu","Menú de Productos (Carta)",{"slug":60,"title":61},"categorias","Categorías de Productos",{"slug":63,"title":64},"variantes-grupo-sabores","Variantes y Grupos de Sabores",{"slug":66,"title":67},"maestro-de-productos","Maestro de Productos",{"slug":69,"title":70},"subproductos-elaborados","Sub-Productos (Elaborados)",{"slug":72,"title":73},"recetas","Recetas",{"slug":75,"title":76},"analisis-duplicados","Buscar Duplicados",{"title":78,"modules":79},"Compras",[80,83,86,89,92,95],{"slug":81,"title":82},"todas-las-ordenes-compra","Órdenes de Compra",{"slug":84,"title":85},"crear-orden-compra","Crear una Orden de Compra",{"slug":87,"title":88},"ordenes-a-aprobar","Órdenes a aprobar",{"slug":90,"title":91},"mercaderias","Mercaderías",{"slug":93,"title":94},"proveedores","Proveedores",{"slug":96,"title":97},"historial-de-compras","Historial de Compras",{"title":99,"modules":100},"Stock",[101,104,107],{"slug":102,"title":103},"stock-mercaderias","Stock de Mercaderías",{"slug":105,"title":106},"stock-subproductos","Stock de Subproductos",{"slug":108,"title":109},"movimientos-de-stock","Movimientos de Stock",{"title":111,"modules":112},"Finanzas",[113,116,119,122,125,128,131,134,137],{"slug":114,"title":115},"arqueos-de-caja","Arqueos de Caja",{"slug":117,"title":118},"listado-de-cajas","Listado de Cajas",{"slug":120,"title":121},"transacciones-de-cobro","Transacciones de Cobro",{"slug":123,"title":124},"factura-manual","Factura Manual",{"slug":126,"title":127},"resumen-de-deuda","Resumen de Deuda",{"slug":129,"title":130},"pagos","Pagos",{"slug":132,"title":133},"historial-de-facturas","Historial de Facturas",{"slug":135,"title":136},"historico-de-mesas","Histórico de Mesas",{"slug":138,"title":139},"puntos-de-venta-pdv","Puntos de Venta (PDVs)",{"title":141,"modules":142},"Comandero",[143],{"slug":144,"title":145},"comandero","Comandero (pantalla de cocina)",{"title":147,"modules":148},"RRHH",[149,152,155,158,161,164,167,170],{"slug":150,"title":151},"empleados","Empleados",{"slug":153,"title":154},"empleados-trabajando","Empleados Trabajando",{"slug":156,"title":157},"registro-diario-fichaje","Registro Diario de Fichaje",{"slug":159,"title":160},"reporte-mensual-fichaje","Reporte Mensual de Fichaje",{"slug":162,"title":163},"departamentos","Departamentos",{"slug":165,"title":166},"turnos-y-horarios-fichaje","Turnos y Horarios de Fichaje",{"slug":168,"title":169},"sueldos-y-jornales","Sueldos y Jornales",{"slug":171,"title":172},"datos-de-acceso-app","Datos de Acceso a la App de Fichaje",{"title":174,"modules":175},"Reportes",[176,179,182],{"slug":177,"title":178},"tablero-general","Tablero General",{"slug":180,"title":181},"productos-mas-vendidos","Productos Más Vendidos",{"slug":183,"title":184},"compras-por-mercaderia","Compras por Mercadería",{"title":186,"modules":187},"Configuracion",[188,191,194,197,200,203,206,209,212,215,218],{"slug":189,"title":190},"configuracion-general","Configuración general",{"slug":192,"title":193},"impresoras","Cómo cargar las impresoras del local",{"slug":195,"title":196},"perfiles-de-impresion","Cómo usar los perfiles de impresión",{"slug":198,"title":199},"usuarios-del-sistema","Cómo administrar los Usuarios del Sistema",{"slug":201,"title":202},"usuarios-con-pin","Cómo administrar los Usuarios con PIN",{"slug":204,"title":205},"punto-de-venta","🏛️ Trámite en ARCA (con clave fiscal)",{"slug":207,"title":208},"permisos-por-rol","Cómo configurar los Permisos por Rol",{"slug":210,"title":211},"turnos-mesa","Turnos de Mesa",{"slug":213,"title":214},"medios-de-cobro","Medios de cobro",{"slug":216,"title":217},"clasificacion-de-gastos","Clasificación de Gastos",{"slug":219,"title":220},"centros-de-costo","Centros de Costo",{"title":222,"modules":223},"Biblioteca de Drivers",[224,226,229,232,235,238,241,244,247],{"slug":225,"title":222},"biblioteca-de-drivers",{"slug":227,"title":228},"sam4s-giant-100","Sam4S Giant - 100",{"slug":230,"title":231},"citizen-ct-s310ii","Citizen CT-S310II",{"slug":233,"title":234},"epson-tm-t20","Epson TM-T20",{"slug":236,"title":237},"drivers-genericos","Drivers Genéricos POS",{"slug":239,"title":240},"epson-tm-t88","Epson TM-T88V",{"slug":242,"title":243},"fiscalberry-windows","Instalar Fiscalberry en Windows",{"slug":245,"title":246},"fiscalberry-linux","Instalar Fiscalberry en Linux",{"slug":248,"title":249},"fiscalberry-android","Instalar Fiscalberry en Android",{"title":251,"modules":252},"Extra",[253,256,259,262,265,268,271,274,277,280],{"slug":254,"title":255},"01-faq-solucion-inicial-pantalla-congelada","📖 Manual de Usuario: Solución Inicial si la Pantalla se Congela o no Carga",{"slug":257,"title":258},"03-faq-mozo-reabrir-mesa-anulada","📖 Manual de Usuario: Cómo Reabrir una Mesa Anulada o Cerrada por Error",{"slug":260,"title":261},"05-faq-cajero-emitir-factura-a","📖 Manual de Usuario: Cómo Emitir una Factura A Cargando Datos del Cliente",{"slug":263,"title":264},"06-faq-cajero-ingreso-egreso-cajon","📖 Manual de Usuario: Cómo Registrar Entradas y Salidas de Dinero del Cajón",{"slug":266,"title":267},"07-faq-cajero-activar-medio-pago","📖 Manual de Usuario: Cómo Activar un Medio de Pago que no Aparece al Cobrar",{"slug":269,"title":270},"08-faq-cajero-diferencia-facturado-vs-abiertas","📖 Manual de Usuario: Diferencia entre \"Facturado Total Mesas\" y \"Abiertas Por Usuario\" en Caja",{"slug":272,"title":273},"10-faq-supervisor-cierre-caja-diferencias","📖 Manual de Usuario: Cómo Auditar y Solucionar Diferencias en el Cierre de Caja",{"slug":275,"title":276},"preguntas-frecuentes","Preguntas Frecuentes y Guías Rápidas por Rol",{"slug":278,"title":279},"buchon-bot","Buchón Bot",{"slug":281,"title":282},"troubleshooting-semantico","📖 Guía Única de Resolución de Problemas y Errores (Troubleshooting)"],"uses":{}},{"type":"data","data":[{"slug":1,"title":2,"content":3,"tableOfContents":4,"seo":36,"llmTxtFile":40},"variantes-grupo-sabores","Variantes y Grupos de Sabores","\u003Cdiv id=\"variantes-y-grupos-de-sabores\">\u003C/div>\n\n\u003Cblockquote>\n\u003Cp>\u003Cstrong>¿Dónde está en el sistema?:\u003C/strong> Menú principal → \u003Cstrong>Productos\u003C/strong> → \u003Cstrong>Variantes\u003C/strong>\n\u003Cstrong>¿Quién lo usa?:\u003C/strong> Encargados del menú y administradores\u003C/p>\n\u003C/blockquote>\n\u003Cblockquote>\n\u003Cp>🎯 \u003Cstrong>¿Para qué sirve esto?\u003C/strong>\nUna variante es un grupo de opciones que el cliente elige al pedir. Por ejemplo: \u003Cem>Gustos de helado\u003C/em> (Chocolate, Frutilla, Dulce de leche).\nTambién sirve para el punto de la carne, la guarnición o el tamaño de un plato.\u003C/p>\n\u003C/blockquote>\n\u003Cblockquote>\n\u003Cp>🧭 \u003Cstrong>Primeros pasos para armar tu menú:\u003C/strong>\u003C/p>\n\u003Col>\n\u003Cli>Creá las \u003Cstrong>variantes\u003C/strong> (esta guía) y las \u003Ca href=\"/user-guide/categorias\">Categorías\u003C/a>. No importa el orden.\u003C/li>\n\u003Cli>Cargá los productos en el \u003Ca href=\"/user-guide/menu\">Menú\u003C/a>. Ahí le asignás a cada producto sus variantes.\u003C/li>\n\u003C/ol>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🔑 Antes de empezar\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"antes-de-empezar\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"antes-de-empezar\">\u003C/div>\n\n\u003Cul>\n\u003Cli>Tu usuario tiene que tener el permiso de \u003Cstrong>Variantes\u003C/strong> en \u003Ca href=\"/user-guide/permisos-por-rol\">Permisos por Rol\u003C/a>.\u003C/li>\n\u003C/ul>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                📍 Paso 1: Entrá a la pantalla\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-1-entra-a-la-pantalla\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-1-entra-a-la-pantalla\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/43-00a-menu-grupo-productos.png\" alt=\"Menú lateral con el grupo Productos marcado en rojo\">\u003C/p>\n\u003Col>\n\u003Cli>En el menú de la izquierda, tocá \u003Cstrong>Productos\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/43-00b-menu-opcion-grupo-sabores.png\" alt=\"Opción Variantes marcada en rojo en el menú lateral\">\u003C/p>\n\u003Col start=\"2\">\n\u003Cli>Tocá \u003Cstrong>Variantes\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/43-01-pantalla-index.png\" alt=\"Pantalla Variantes con la variante Gustos de helado\">\u003C/p>\n\u003Cp>Así se ve la pantalla. Cada variante aparece en un recuadro, con sus opciones.\u003C/p>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/43-22-donde-esta-boton-ayuda.png\" alt=\"Pantalla con el botón de ayuda marcado en rojo\">\u003C/p>\n\u003Cblockquote>\n\u003Cp>💡 \u003Cstrong>Consejo útil:\u003C/strong> si tocás el botón \u003Cstrong>?\u003C/strong> de arriba, aparece una explicación corta.\u003C/p>\n\u003C/blockquote>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/43-24-ayuda-abierta.png\" alt=\"Explicación ¿Qué es una Variante? abierta debajo del botón de ayuda\">\u003C/p>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                ➕ Paso 2: Creá una variante\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-2-crea-una-variante\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-2-crea-una-variante\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/43-20-donde-esta-boton-crear-variante.png\" alt=\"Pantalla con el botón azul Crear Variante marcado en rojo\">\u003C/p>\n\u003Col>\n\u003Cli>Tocá el botón azul \u003Cstrong>Crear Variante\u003C/strong>. Está arriba a la izquierda.\u003C/li>\n\u003Cli>Se abre una ventana.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/43-25-ventana-crear-variante.png\" alt=\"Ventana Crear Variante con los datos de Gustos de helado\">\u003C/p>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/43-06-campo-nombre-de-la-variante.png\" alt=\"Casillero Nombre de la Variante con Gustos de helado escrito\">\u003C/p>\n\u003Col start=\"3\">\n\u003Cli>En \u003Cstrong>Nombre de la Variante\u003C/strong>, escribí el nombre. Por ejemplo: \u003Cem>Gustos de helado\u003C/em>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/43-07-campo-cantidad-minima.png\" alt=\"Casillero Cantidad Mínima con el número 1\">\u003C/p>\n\u003Col start=\"4\">\n\u003Cli>En \u003Cstrong>Cantidad Mínima\u003C/strong>, poné cuántas opciones \u003Cstrong>tiene que\u003C/strong> elegir el cliente. Por ejemplo: \u003Cem>1\u003C/em>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/43-08-campo-cantidad-maxima.png\" alt=\"Casillero Cantidad Máxima con el número 3\">\u003C/p>\n\u003Col start=\"5\">\n\u003Cli>En \u003Cstrong>Cantidad Máxima\u003C/strong>, poné cuántas opciones \u003Cstrong>puede\u003C/strong> elegir como mucho. Por ejemplo: \u003Cem>3\u003C/em>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/43-09-campo-variante-privada.png\" alt=\"Casilla Variante Privada sin marcar\">\u003C/p>\n\u003Col start=\"6\">\n\u003Cli>Marcá \u003Cstrong>Variante Privada\u003C/strong> solo si no querés que se vea en el menú online.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/43-10-campo-mostrar-cada-opcion-como-product.png\" alt=\"Casilla Mostrar cada opción como producto independiente en KDS sin marcar\">\u003C/p>\n\u003Col start=\"7\">\n\u003Cli>Marcá \u003Cstrong>Mostrar cada opción como producto independiente en KDS\u003C/strong> si querés que la cocina vea cada opción en un renglón aparte.\u003C/li>\n\u003C/ol>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🍦 Paso 3: Agregá las opciones\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-3-agrega-las-opciones\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-3-agrega-las-opciones\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/43-11-donde-esta-boton-agregar-opcion.png\" alt=\"Ventana con el botón azul Agregar Opción marcado en rojo\">\u003C/p>\n\u003Col>\n\u003Cli>Tocá el botón azul \u003Cstrong>Agregar Opción\u003C/strong>. Aparece un renglón nuevo.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/43-17-campo-sabor.png\" alt=\"Renglón de una opción: nombre Chocolate, precio, impresora, puesto y botón Eliminar\">\u003C/p>\n\u003Col start=\"2\">\n\u003Cli>En \u003Cstrong>Nombre de la Opción\u003C/strong>, escribí la opción. Por ejemplo: \u003Cem>Chocolate\u003C/em>.\u003C/li>\n\u003Cli>En \u003Cstrong>Precio\u003C/strong>, poné cuánto se cobra de más. Si no cuesta extra, dejá \u003Cem>0\u003C/em>.\u003C/li>\n\u003Cli>Repetí con cada opción. Por ejemplo: \u003Cem>Frutilla\u003C/em> y \u003Cem>Dulce de leche\u003C/em>.\u003C/li>\n\u003C/ol>\n\u003Cblockquote>\n\u003Cp>💡 \u003Cstrong>Consejo útil:\u003C/strong> si la opción no existe como producto, el sistema la crea sola al guardar.\u003C/p>\n\u003C/blockquote>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/43-18-donde-esta-boton-eliminar.png\" alt=\"Ventana con el botón rojo Eliminar de una opción marcado en rojo\">\u003C/p>\n\u003Col start=\"5\">\n\u003Cli>Si te equivocaste en una opción, tocá el botón rojo \u003Cstrong>Eliminar\u003C/strong> de ese renglón.\u003C/li>\n\u003C/ol>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                💾 Paso 4: Guardá la variante\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-4-guarda-la-variante\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-4-guarda-la-variante\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/43-13-donde-esta-boton-agregar-variante.png\" alt=\"Ventana con el botón verde Agregar Variante marcado en rojo\">\u003C/p>\n\u003Col>\n\u003Cli>Tocá el botón verde \u003Cstrong>Agregar Variante\u003C/strong>. Está abajo de todo.\u003C/li>\n\u003Cli>La variante aparece en la lista.\u003C/li>\n\u003C/ol>\n\u003Cblockquote>\n\u003Cp>💡 \u003Cstrong>Consejo útil:\u003C/strong> si te arrepentiste, tocá \u003Cstrong>Volver al Listado\u003C/strong>. No se guarda nada.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                ✏️ Paso 5: Cambiá una variante\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-5-cambia-una-variante\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-5-cambia-una-variante\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/43-28-tarjeta-variante.png\" alt=\"Recuadro de la variante Gustos de helado con sus opciones y los botones Editar y Borrar\">\u003C/p>\n\u003Cp>Cada recuadro muestra el nombre, el mínimo y el máximo, las opciones y en qué productos se usa.\u003C/p>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/43-29-donde-esta-boton-editar.png\" alt=\"Pantalla con el botón Editar de la variante marcado en rojo\">\u003C/p>\n\u003Col>\n\u003Cli>Tocá \u003Cstrong>Editar\u003C/strong>, a la derecha de la variante.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/43-31-ventana-editar-variante.png\" alt=\"Ventana Editar Gustos de helado con los datos cargados\">\u003C/p>\n\u003Col start=\"2\">\n\u003Cli>Se abre la ventana con los datos. Cambiá lo que necesites.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/43-15-donde-esta-boton-actualizar-variante.png\" alt=\"Ventana con el botón verde Actualizar Variante marcado en rojo\">\u003C/p>\n\u003Col start=\"3\">\n\u003Cli>Tocá el botón verde \u003Cstrong>Actualizar Variante\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🗑️ Paso 6: Borrá una variante\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-6-borra-una-variante\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-6-borra-una-variante\">\u003C/div>\n\n\u003Cblockquote>\n\u003Cp>⚠️ \u003Cstrong>Atención:\u003C/strong> si borrás una variante, los productos que la usan dejan de ofrecer esas opciones.\u003C/p>\n\u003C/blockquote>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/43-04-donde-esta-boton-borrar.png\" alt=\"Pantalla con el botón rojo Borrar de la variante marcado en rojo\">\u003C/p>\n\u003Col>\n\u003Cli>Tocá el botón rojo \u003Cstrong>Borrar\u003C/strong>, a la derecha de la variante.\u003C/li>\n\u003Cli>El sistema te pregunta si estás seguro. Tocá \u003Cstrong>Aceptar\u003C/strong> para borrarla.\u003C/li>\n\u003C/ol>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                📋 Paso 7: Mirá todas las opciones juntas (opcional)\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-7-mira-todas-las-opciones-juntas-opcional\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-7-mira-todas-las-opciones-juntas-opcional\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/43-02-donde-esta-boton-listado-de-opciones.png\" alt=\"Pantalla con el botón Listado de Opciones marcado en rojo\">\u003C/p>\n\u003Col>\n\u003Cli>Tocá \u003Cstrong>Listado de Opciones\u003C/strong>, arriba a la derecha.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/43-32-pantalla-listado-de-opciones.png\" alt=\"Pantalla Listado de Opciones en Variantes con Chocolate, Frutilla y Dulce de leche\">\u003C/p>\n\u003Col start=\"2\">\n\u003Cli>Ves todas las opciones de todas las variantes en una sola lista, con su precio.\u003C/li>\n\u003C/ol>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🔗 Paso 8: Asigná la variante a un producto\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-8-asigna-la-variante-a-un-producto\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-8-asigna-la-variante-a-un-producto\">\u003C/div>\n\n\u003Cp>La variante se asigna cuando cargás el producto en el menú, en la parte \u003Cstrong>Variantes del Producto\u003C/strong>.\nMirá cómo en \u003Ca href=\"/user-guide/menu\">Menú de Productos\u003C/a>.\u003C/p>\n\u003Cblockquote>\n\u003Cp>➡️ \u003Cstrong>Siguiente paso:\u003C/strong> si todavía no lo hiciste, creá las \u003Ca href=\"/user-guide/categorias\">Categorías\u003C/a>. Después \u003Ca href=\"/user-guide/menu\">cargá los productos en el menú\u003C/a>.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                ⚠️ Resolución de Inconvenientes\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"resolucion-de-inconvenientes\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"resolucion-de-inconvenientes\">\u003C/div>\n\n\u003Cdiv class=\"table-wrapper\">\u003Ctable>\n\u003Cthead>\n\u003Ctr>\n\u003Cth>Problema\u003C/th>\n\u003Cth>Causa más frecuente\u003C/th>\n\u003Cth>Solución recomendada\u003C/th>\n\u003C/tr>\n\u003C/thead>\n\u003Ctbody>\u003Ctr>\n\u003Ctd>\u003Cstrong>El mozo no puede elegir más de una opción\u003C/strong>\u003C/td>\n\u003Ctd>La \u003Cstrong>Cantidad Máxima\u003C/strong> es 1.\u003C/td>\n\u003Ctd>Tocá \u003Cstrong>Editar\u003C/strong> y subí la \u003Cstrong>Cantidad Máxima\u003C/strong>.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>El sistema obliga a elegir una opción\u003C/strong>\u003C/td>\n\u003Ctd>La \u003Cstrong>Cantidad Mínima\u003C/strong> es mayor a 0.\u003C/td>\n\u003Ctd>Si la opción no es obligatoria, poné \u003Cstrong>Cantidad Mínima\u003C/strong> en 0.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>Al guardar sale una pantalla &quot;Database Error&quot;\u003C/strong>\u003C/td>\n\u003Ctd>Es una falla del sistema, no un error tuyo.\u003C/td>\n\u003Ctd>Avisale a soporte de PaxaPOS con el nombre de la variante.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>La variante no aparece al cargar el producto\u003C/strong>\u003C/td>\n\u003Ctd>No se guardó, o no la marcaste en el producto.\u003C/td>\n\u003Ctd>Revisá que esté en esta lista y marcala en \u003Cstrong>Variantes del Producto\u003C/strong>.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>La variante no se ve en el menú online\u003C/strong>\u003C/td>\n\u003Ctd>Está marcada como \u003Cstrong>Variante Privada\u003C/strong>.\u003C/td>\n\u003Ctd>Tocá \u003Cstrong>Editar\u003C/strong>, desmarcala y tocá \u003Cstrong>Actualizar Variante\u003C/strong>.\u003C/td>\n\u003C/tr>\n\u003C/tbody>\u003C/table>\u003C/div>\n",[5,9,12,15,18,21,24,27,30,33],{"id":6,"title":7,"level":8},"antes-de-empezar","Antes de empezar",2,{"id":10,"title":11,"level":8},"paso-1-entra-a-la-pantalla","Paso 1: Entrá a la pantalla",{"id":13,"title":14,"level":8},"paso-2-crea-una-variante","Paso 2: Creá una variante",{"id":16,"title":17,"level":8},"paso-3-agrega-las-opciones","Paso 3: Agregá las opciones",{"id":19,"title":20,"level":8},"paso-4-guarda-la-variante","Paso 4: Guardá la variante",{"id":22,"title":23,"level":8},"paso-5-cambia-una-variante","Paso 5: Cambiá una variante",{"id":25,"title":26,"level":8},"paso-6-borra-una-variante","Paso 6: Borrá una variante",{"id":28,"title":29,"level":8},"paso-7-mira-todas-las-opciones-juntas-opcional","Paso 7: Mirá todas las opciones juntas (opcional)",{"id":31,"title":32,"level":8},"paso-8-asigna-la-variante-a-un-producto","Paso 8: Asigná la variante a un producto",{"id":34,"title":35,"level":8},"resolucion-de-inconvenientes","Resolución de Inconvenientes",{"title":37,"description":38,"keywords":39},"Variantes y Grupos de Sabores - Manual","¿Dónde está en el sistema?: Menú principal → Productos → Variantes\n ¿Quién lo usa?: Encargados del menú y administradores","variantes grupo sabores, paxapos, variantes y grupos de sabores, tutorial, guía, manual usuario","43-variantes-grupo-sabores.txt"],"uses":{"params":["slug"]}}]}
