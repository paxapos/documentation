{"type":"data","nodes":[null,{"type":"data","data":[{"moduleCategories":1},[2,17,44,53,77,98,110,140,146,173,185,221,250],{"title":3,"modules":4},"Comenzamos",[5,8,11,14],{"slug":6,"title":7},"introduccion","Bienvenido a tu software gastronómico",{"slug":9,"title":10},"iniciar-sesion","Cómo Iniciar Sesión",{"slug":12,"title":13},"recuperar-contrasena","Cómo Recuperar tu Contraseña",{"slug":15,"title":16},"guia-de-inicio-rapido","Guía de Inicio Rápido",{"title":18,"modules":19},"Ventas",[20,23,26,29,32,35,38,41],{"slug":21,"title":22},"salon-de-ventas","Cómo Usar el Salón de Ventas (Adición)",{"slug":24,"title":25},"caja-rapida","Cómo Usar la Caja Rápida (Registradora)",{"slug":27,"title":28},"mozos","Cómo Cargar los Mozos",{"slug":30,"title":31},"clientes","Cómo Gestionar los Clientes",{"slug":33,"title":34},"descuentos","Cómo Configurar Descuentos",{"slug":36,"title":37},"nueva-reserva","Cómo Cargar una Nueva Reserva",{"slug":39,"title":40},"listado-de-reservas","Cómo Usar el Listado de Reservas",{"slug":42,"title":43},"grilla-de-reservas","Cómo Usar la Grilla de Reservas",{"title":45,"modules":46},"Medios de Pago",[47,50],{"slug":48,"title":49},"configuracion-procesadores","Configuración de Procesadores de Pago",{"slug":51,"title":52},"transacciones-mercadopago","Transacciones MercadoPago",{"title":54,"modules":55},"Productos",[56,59,62,65,68,71,74],{"slug":57,"title":58},"menu","Menú de Productos (Carta)",{"slug":60,"title":61},"categorias","Categorías de Productos",{"slug":63,"title":64},"variantes-grupo-sabores","Variantes y Grupos de Sabores",{"slug":66,"title":67},"maestro-de-productos","Maestro de Productos",{"slug":69,"title":70},"subproductos-elaborados","Sub-Productos (Elaborados)",{"slug":72,"title":73},"recetas","Recetas",{"slug":75,"title":76},"analisis-duplicados","Buscar Duplicados",{"title":78,"modules":79},"Compras",[80,83,86,89,92,95],{"slug":81,"title":82},"todas-las-ordenes-compra","Órdenes de Compra",{"slug":84,"title":85},"crear-orden-compra","Crear una Orden de Compra",{"slug":87,"title":88},"ordenes-a-aprobar","Órdenes a aprobar",{"slug":90,"title":91},"mercaderias","Mercaderías",{"slug":93,"title":94},"proveedores","Proveedores",{"slug":96,"title":97},"historial-de-compras","Historial de Compras",{"title":99,"modules":100},"Stock",[101,104,107],{"slug":102,"title":103},"stock-mercaderias","Stock de Mercaderías",{"slug":105,"title":106},"stock-subproductos","Stock de Subproductos",{"slug":108,"title":109},"movimientos-de-stock","Movimientos de Stock",{"title":111,"modules":112},"Finanzas",[113,116,119,122,125,128,131,134,137],{"slug":114,"title":115},"arqueos-de-caja","Arqueos de Caja",{"slug":117,"title":118},"listado-de-cajas","Listado de Cajas",{"slug":120,"title":121},"transacciones-de-cobro","Transacciones de Cobro",{"slug":123,"title":124},"factura-manual","Factura Manual",{"slug":126,"title":127},"resumen-de-deuda","Resumen de Deuda",{"slug":129,"title":130},"pagos","Pagos",{"slug":132,"title":133},"historial-de-facturas","Historial de Facturas",{"slug":135,"title":136},"historico-de-mesas","Histórico de Mesas",{"slug":138,"title":139},"puntos-de-venta-pdv","Puntos de Venta (PDVs)",{"title":141,"modules":142},"Comandero",[143],{"slug":144,"title":145},"comandero","Comandero (pantalla de cocina)",{"title":147,"modules":148},"RRHH",[149,152,155,158,161,164,167,170],{"slug":150,"title":151},"empleados","Empleados",{"slug":153,"title":154},"empleados-trabajando","Empleados Trabajando",{"slug":156,"title":157},"registro-diario-fichaje","Registro Diario de Fichaje",{"slug":159,"title":160},"reporte-mensual-fichaje","Reporte Mensual de Fichaje",{"slug":162,"title":163},"departamentos","Departamentos",{"slug":165,"title":166},"turnos-y-horarios-fichaje","Turnos y Horarios de Fichaje",{"slug":168,"title":169},"sueldos-y-jornales","Sueldos y Jornales",{"slug":171,"title":172},"datos-de-acceso-app","Datos de Acceso a la App de Fichaje",{"title":174,"modules":175},"Reportes",[176,179,182],{"slug":177,"title":178},"tablero-general","Tablero General",{"slug":180,"title":181},"productos-mas-vendidos","Productos Más Vendidos",{"slug":183,"title":184},"compras-por-mercaderia","Compras por Mercadería",{"title":186,"modules":187},"Configuracion",[188,191,194,197,200,203,206,209,212,215,218],{"slug":189,"title":190},"configuracion-general","Configuración general",{"slug":192,"title":193},"impresoras","Cómo cargar las impresoras del local",{"slug":195,"title":196},"perfiles-de-impresion","Cómo usar los perfiles de impresión",{"slug":198,"title":199},"usuarios-del-sistema","Cómo administrar los Usuarios del Sistema",{"slug":201,"title":202},"usuarios-con-pin","Cómo administrar los Usuarios con PIN",{"slug":204,"title":205},"punto-de-venta","🏛️ Trámite en ARCA (con clave fiscal)",{"slug":207,"title":208},"permisos-por-rol","Cómo configurar los Permisos por Rol",{"slug":210,"title":211},"turnos-mesa","Turnos de Mesa",{"slug":213,"title":214},"medios-de-cobro","Medios de cobro",{"slug":216,"title":217},"clasificacion-de-gastos","Clasificación de Gastos",{"slug":219,"title":220},"centros-de-costo","Centros de Costo",{"title":222,"modules":223},"Biblioteca de Drivers",[224,226,229,232,235,238,241,244,247],{"slug":225,"title":222},"biblioteca-de-drivers",{"slug":227,"title":228},"sam4s-giant-100","Sam4S Giant - 100",{"slug":230,"title":231},"citizen-ct-s310ii","Citizen CT-S310II",{"slug":233,"title":234},"epson-tm-t20","Epson TM-T20",{"slug":236,"title":237},"drivers-genericos","Drivers Genéricos POS",{"slug":239,"title":240},"epson-tm-t88","Epson TM-T88V",{"slug":242,"title":243},"fiscalberry-windows","Instalar Fiscalberry en Windows",{"slug":245,"title":246},"fiscalberry-linux","Instalar Fiscalberry en Linux",{"slug":248,"title":249},"fiscalberry-android","Instalar Fiscalberry en Android",{"title":251,"modules":252},"Extra",[253,256,259,262,265,268,271,274,277,280],{"slug":254,"title":255},"01-faq-solucion-inicial-pantalla-congelada","📖 Manual de Usuario: Solución Inicial si la Pantalla se Congela o no Carga",{"slug":257,"title":258},"03-faq-mozo-reabrir-mesa-anulada","📖 Manual de Usuario: Cómo Reabrir una Mesa Anulada o Cerrada por Error",{"slug":260,"title":261},"05-faq-cajero-emitir-factura-a","📖 Manual de Usuario: Cómo Emitir una Factura A Cargando Datos del Cliente",{"slug":263,"title":264},"06-faq-cajero-ingreso-egreso-cajon","📖 Manual de Usuario: Cómo Registrar Entradas y Salidas de Dinero del Cajón",{"slug":266,"title":267},"07-faq-cajero-activar-medio-pago","📖 Manual de Usuario: Cómo Activar un Medio de Pago que no Aparece al Cobrar",{"slug":269,"title":270},"08-faq-cajero-diferencia-facturado-vs-abiertas","📖 Manual de Usuario: Diferencia entre \"Facturado Total Mesas\" y \"Abiertas Por Usuario\" en Caja",{"slug":272,"title":273},"10-faq-supervisor-cierre-caja-diferencias","📖 Manual de Usuario: Cómo Auditar y Solucionar Diferencias en el Cierre de Caja",{"slug":275,"title":276},"preguntas-frecuentes","Preguntas Frecuentes y Guías Rápidas por Rol",{"slug":278,"title":279},"buchon-bot","Buchón Bot",{"slug":281,"title":282},"troubleshooting-semantico","📖 Guía Única de Resolución de Problemas y Errores (Troubleshooting)"],"uses":{}},{"type":"data","data":[{"slug":1,"title":2,"content":3,"tableOfContents":4,"seo":36,"llmTxtFile":40},"transacciones-mercadopago","Transacciones MercadoPago","\u003Cdiv id=\"transacciones-mercadopago\">\u003C/div>\n\n\u003Cblockquote>\n\u003Cp>\u003Cstrong>¿Dónde está en el sistema?:\u003C/strong> Menú principal → \u003Cstrong>Medios de Pago\u003C/strong> → \u003Cstrong>Transacciones MercadoPago\u003C/strong>\n\u003Cstrong>¿Quién lo usa?:\u003C/strong> Cajeros, encargados y contadores\u003C/p>\n\u003C/blockquote>\n\u003Cblockquote>\n\u003Cp>🎯 \u003Cstrong>¿Para qué sirve esto?\u003C/strong>\nAcá ves todos los cobros que entraron por MercadoPago: con QR, con link de pago o con la terminal Point.\nTe sirve para controlar que un cliente pagó y para cuadrar la caja con lo que te depositó MercadoPago.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🔑 Antes de empezar\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"antes-de-empezar\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"antes-de-empezar\">\u003C/div>\n\n\u003Cul>\n\u003Cli>MercadoPago tiene que estar elegido en alguna forma de cobro. Mirá \u003Ca href=\"/user-guide/configuracion-procesadores\">Configuración de Procesadores de Pago\u003C/a>.\u003C/li>\n\u003Cli>Tu usuario tiene que tener el permiso \u003Cstrong>Contabilidad\u003C/strong> de Finanzas en \u003Ca href=\"/user-guide/permisos-por-rol\">Permisos por Rol\u003C/a>.\u003C/li>\n\u003C/ul>\n\u003Cblockquote>\n\u003Cp>💡 \u003Cstrong>Consejo útil:\u003C/strong> esta pantalla es la misma que \u003Ca href=\"/user-guide/transacciones-de-cobro\">Transacciones de Cobro\u003C/a>, pero ya viene filtrada para mostrar solo MercadoPago.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                📍 Paso 1: Entrá a la pantalla\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-1-entra-a-la-pantalla\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-1-entra-a-la-pantalla\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/30-medios-de-pago/32-00a-menu-grupo-payments.png\" alt=\"Menú lateral con el grupo Medios de Pago marcado en rojo\">\u003C/p>\n\u003Col>\n\u003Cli>En el menú de la izquierda, tocá \u003Cstrong>Medios de Pago\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/30-medios-de-pago/32-00b-menu-opcion-mercadopago-transacciones.png\" alt=\"Opción Transacciones MercadoPago marcada en rojo en el menú lateral\">\u003C/p>\n\u003Col start=\"2\">\n\u003Cli>Tocá \u003Cstrong>Transacciones MercadoPago\u003C/strong>. Está debajo del título \u003Cstrong>MERCADOPAGO\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/30-medios-de-pago/32-01-pantalla-index.png\" alt=\"Pantalla Listado de Cobros con los filtros arriba y dos cobros de MercadoPago abajo\">\u003C/p>\n\u003Cp>Así se ve la pantalla. Arriba están los filtros. Abajo, la lista de cobros, del más nuevo al más viejo.\u003C/p>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                📋 Paso 2: Leé la lista de cobros\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-2-lee-la-lista-de-cobros\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-2-lee-la-lista-de-cobros\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/30-medios-de-pago/32-33-fila-cobro-mercadopago.png\" alt=\"Un cobro de MercadoPago en la lista: fecha, arqueo, mesa, tipo de pago, canal, monto y estado\">\u003C/p>\n\u003Cp>Cada renglón es un cobro. De izquierda a derecha:\u003C/p>\n\u003Col>\n\u003Cli>\u003Cstrong>Fecha\u003C/strong>: el día y la hora del cobro.\u003C/li>\n\u003Cli>\u003Cstrong>Arqueo\u003C/strong>: el número de la caja donde quedó anotado.\u003C/li>\n\u003Cli>\u003Cstrong>Mesa\u003C/strong>: la mesa o el pedido que se cobró.\u003C/li>\n\u003Cli>\u003Cstrong>Tipo de Pago\u003C/strong>: dice \u003Cstrong>MercadoPago\u003C/strong> y cómo pagó el cliente.\u003C/li>\n\u003Cli>\u003Cstrong>Canal\u003C/strong>: \u003Cstrong>QR\u003C/strong> (escaneó el código), \u003Cstrong>PAY_LINK\u003C/strong> (link de pago) o la terminal Point.\u003C/li>\n\u003Cli>\u003Cstrong>Monto\u003C/strong>: cuánto pagó el cliente. Por ejemplo: \u003Cem>$ 1.500\u003C/em>.\u003C/li>\n\u003Cli>\u003Cstrong>Estado\u003C/strong>: \u003Cstrong>Aprobado\u003C/strong> quiere decir que la plata entró.\u003C/li>\n\u003C/ol>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🔎 Paso 3: Buscá un cobro con los filtros\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-3-busca-un-cobro-con-los-filtros\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-3-busca-un-cobro-con-los-filtros\">\u003C/div>\n\n\u003Cp>Completá solo los casilleros que necesites. Los demás dejalos como están.\u003C/p>\n\u003Cp>\u003Cimg src=\"/images/manual/30-medios-de-pago/32-02-campo-desde.png\" alt=\"Casillero de fecha Desde\">\u003C/p>\n\u003Col>\n\u003Cli>En el primer casillero de fecha, elegí el día \u003Cstrong>desde\u003C/strong> el que querés ver.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/30-medios-de-pago/32-03-campo-hasta.png\" alt=\"Casillero de fecha Hasta\">\u003C/p>\n\u003Col start=\"2\">\n\u003Cli>En el segundo, elegí el día \u003Cstrong>hasta\u003C/strong> el que querés ver.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/30-medios-de-pago/32-04-campo-status.png\" alt=\"Lista Todos los estados\">\u003C/p>\n\u003Col start=\"3\">\n\u003Cli>En \u003Cstrong>Todos los estados\u003C/strong> podés elegir, por ejemplo, solo los \u003Cstrong>Aprobado\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/30-medios-de-pago/32-05-campo-mesa-id.png\" alt=\"Casillero ID Mesa\">\u003C/p>\n\u003Col start=\"4\">\n\u003Cli>En \u003Cstrong>ID Mesa\u003C/strong> podés escribir el número de una mesa.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/30-medios-de-pago/32-06-campo-instrument.png\" alt=\"Lista Todos los instrumentos\">\u003C/p>\n\u003Col start=\"5\">\n\u003Cli>En \u003Cstrong>Todos los instrumentos\u003C/strong> elegís con qué pagó: tarjeta, dinero en cuenta, etc.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/30-medios-de-pago/32-07-campo-acquirer.png\" alt=\"Lista de procesador con MercadoPago elegido\">\u003C/p>\n\u003Col start=\"6\">\n\u003Cli>Este casillero ya dice \u003Cstrong>MercadoPago\u003C/strong>. No lo cambies: si lo cambiás, vas a ver cobros de otras empresas.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/30-medios-de-pago/32-08-campo-channel.png\" alt=\"Lista Todos los canales\">\u003C/p>\n\u003Col start=\"7\">\n\u003Cli>En \u003Cstrong>Todos los canales\u003C/strong> elegís si fue por QR, link o terminal.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/30-medios-de-pago/32-09-campo-tipo-de-pago.png\" alt=\"Lista Todos los tipos de pago\">\u003C/p>\n\u003Col start=\"8\">\n\u003Cli>En \u003Cstrong>Todos los tipos de pago\u003C/strong> podés elegir un medio de cobro del comercio.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/30-medios-de-pago/32-10-campo-monto-desde.png\" alt=\"Casillero Monto desde\">\u003C/p>\n\u003Cp>\u003Cimg src=\"/images/manual/30-medios-de-pago/32-11-campo-monto-hasta.png\" alt=\"Casillero Monto hasta\">\u003C/p>\n\u003Col start=\"9\">\n\u003Cli>En los dos casilleros \u003Cstrong>Monto\u003C/strong> escribí el importe mínimo y el máximo. Por ejemplo: \u003Cem>1000\u003C/em> y \u003Cem>2000\u003C/em>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/30-medios-de-pago/32-12-donde-esta-boton-filtrar.png\" alt=\"Pantalla con el botón azul Filtrar marcado en rojo\">\u003C/p>\n\u003Col start=\"10\">\n\u003Cli>Tocá el botón azul \u003Cstrong>Filtrar\u003C/strong>.\u003C/li>\n\u003Cli>La lista de abajo muestra solo los cobros que coinciden.\u003C/li>\n\u003C/ol>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🧹 Paso 4: Borrá los filtros\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-4-borra-los-filtros\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-4-borra-los-filtros\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/30-medios-de-pago/32-14-donde-esta-boton-limpiar.png\" alt=\"Pantalla con el botón Limpiar marcado en rojo al lado de Filtrar\">\u003C/p>\n\u003Col>\n\u003Cli>Tocá el botón \u003Cstrong>Limpiar\u003C/strong>. Está al lado de \u003Cstrong>Filtrar\u003C/strong>.\u003C/li>\n\u003Cli>Se borran todos los filtros.\u003C/li>\n\u003C/ol>\n\u003Cblockquote>\n\u003Cp>⚠️ \u003Cstrong>Atención:\u003C/strong> \u003Cstrong>Limpiar\u003C/strong> también saca el filtro de MercadoPago y vas a ver los cobros de todos los medios. Para volver a ver solo MercadoPago, entrá de nuevo desde el menú (Paso 1).\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                👁️ Paso 5: Mirá el detalle de un cobro\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-5-mira-el-detalle-de-un-cobro\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-5-mira-el-detalle-de-un-cobro\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/30-medios-de-pago/32-16-donde-esta-boton-icono.png\" alt=\"Lista de cobros con el botón del ojo marcado en rojo, a la derecha del renglón\">\u003C/p>\n\u003Col>\n\u003Cli>Buscá el cobro en la lista.\u003C/li>\n\u003Cli>Tocá el botón del ojo 👁️. Está a la derecha del renglón, en \u003Cstrong>Acciones\u003C/strong>.\u003C/li>\n\u003Cli>Se abre la pantalla con todos los datos de ese cobro.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/30-medios-de-pago/32-34-pantalla-detalle.png\" alt=\"Pantalla Transacción de Pago con Información General, Detalles de Monto, Método de Pago y Relaciones\">\u003C/p>\n\u003Cp>En esta pantalla ves:\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Información General\u003C/strong>: el estado y los números con los que MercadoPago identifica el cobro.\u003C/li>\n\u003Cli>\u003Cstrong>Detalles de Monto\u003C/strong>: cuánto se cobró.\u003C/li>\n\u003Cli>\u003Cstrong>Método de Pago\u003C/strong>: el procesador (\u003Cstrong>MPAGO\u003C/strong>), el canal (QR o link) y con qué pagó el cliente.\u003C/li>\n\u003Cli>\u003Cstrong>Relaciones\u003C/strong>: la mesa y la caja donde quedó anotado.\u003C/li>\n\u003C/ul>\n\u003Cblockquote>\n\u003Cp>💡 \u003Cstrong>Consejo útil:\u003C/strong> si un cliente dice que pagó y no lo encontrás, compará el \u003Cstrong>ID Pago Externo\u003C/strong> con el número de operación que le figura en su MercadoPago.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🍽️ Paso 6: Abrí la mesa o la caja del cobro\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-6-abri-la-mesa-o-la-caja-del-cobro\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-6-abri-la-mesa-o-la-caja-del-cobro\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/30-medios-de-pago/32-22-donde-esta-boton-icono-mesa.png\" alt=\"Detalle del cobro con el botón azul de la mesa marcado en rojo\">\u003C/p>\n\u003Col>\n\u003Cli>Para ver qué se consumió, tocá el botón azul con el número de la mesa.\u003C/li>\n\u003Cli>Se abre la mesa con sus productos.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/30-medios-de-pago/32-24-donde-esta-boton-arqueo.png\" alt=\"Detalle del cobro con el botón verde Arqueo marcado en rojo\">\u003C/p>\n\u003Col start=\"3\">\n\u003Cli>Para ver la caja donde entró el cobro, tocá el botón verde \u003Cstrong>Arqueo\u003C/strong>.\u003C/li>\n\u003Cli>Se abre el arqueo de esa caja.\u003C/li>\n\u003C/ol>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                ↩️ Paso 7: Volvé a la lista\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-7-volve-a-la-lista\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-7-volve-a-la-lista\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/30-medios-de-pago/32-20-donde-esta-boton-volver-al-listado.png\" alt=\"Detalle del cobro con el botón Volver al listado marcado en rojo, arriba a la derecha\">\u003C/p>\n\u003Col>\n\u003Cli>Tocá \u003Cstrong>Volver al listado\u003C/strong>. Está arriba a la derecha.\u003C/li>\n\u003Cli>Volvés a la lista de cobros.\u003C/li>\n\u003C/ol>\n\u003Cblockquote>\n\u003Cp>💡 \u003Cstrong>Consejo útil:\u003C/strong> si tocás \u003Cstrong>Volver al listado\u003C/strong> se sale del filtro de MercadoPago. Para ver solo MercadoPago otra vez, entrá desde el menú.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                ❓ ¿Puedo cambiar el medio de un cobro de MercadoPago?\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"puedo-cambiar-el-medio-de-un-cobro-de-mercadopago\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"puedo-cambiar-el-medio-de-un-cobro-de-mercadopago\">\u003C/div>\n\n\u003Cp>No. Los cobros de MercadoPago los anota MercadoPago solo, y ya coinciden con lo que te deposita.\nPor eso no vas a ver el botón del lápiz ✏️ ni el botón \u003Cstrong>Corregir el medio\u003C/strong> en estos cobros.\nEse botón solo aparece en los cobros cargados a mano. Mirá \u003Ca href=\"/user-guide/transacciones-de-cobro\">Transacciones de Cobro\u003C/a>.\u003C/p>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                ⚠️ Resolución de Inconvenientes\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"resolucion-de-inconvenientes\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"resolucion-de-inconvenientes\">\u003C/div>\n\n\u003Cdiv class=\"table-wrapper\">\u003Ctable>\n\u003Cthead>\n\u003Ctr>\n\u003Cth>Problema\u003C/th>\n\u003Cth>Causa más frecuente\u003C/th>\n\u003Cth>Solución recomendada\u003C/th>\n\u003C/tr>\n\u003C/thead>\n\u003Ctbody>\u003Ctr>\n\u003Ctd>\u003Cstrong>No aparece Transacciones MercadoPago en el menú\u003C/strong>\u003C/td>\n\u003Ctd>MercadoPago no está elegido en ninguna forma de cobro, o tu usuario no tiene el permiso \u003Cstrong>Contabilidad\u003C/strong>.\u003C/td>\n\u003Ctd>Elegilo en \u003Ca href=\"/user-guide/configuracion-procesadores\">Configuración de Procesadores de Pago\u003C/a>, o pedile al dueño el permiso.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>Sale &quot;No se encontraron transacciones&quot;\u003C/strong>\u003C/td>\n\u003Ctd>No hubo cobros de MercadoPago en esas fechas, o hay un filtro puesto.\u003C/td>\n\u003Ctd>Tocá \u003Cstrong>Limpiar\u003C/strong> y entrá de nuevo desde el menú.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>Veo cobros de Payway o de otros medios\u003C/strong>\u003C/td>\n\u003Ctd>Se borró el filtro de MercadoPago.\u003C/td>\n\u003Ctd>Entrá de nuevo desde el menú \u003Cstrong>Medios de Pago\u003C/strong> → \u003Cstrong>Transacciones MercadoPago\u003C/strong>.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>Un cobro dice Pendiente o Rechazado\u003C/strong>\u003C/td>\n\u003Ctd>El cliente no terminó de pagar, o MercadoPago no aprobó el pago.\u003C/td>\n\u003Ctd>No entregues el pedido hasta ver \u003Cstrong>Aprobado\u003C/strong>. Pedile al cliente que pague de nuevo.\u003C/td>\n\u003C/tr>\n\u003C/tbody>\u003C/table>\u003C/div>\n",[5,9,12,15,18,21,24,27,30,33],{"id":6,"title":7,"level":8},"antes-de-empezar","Antes de empezar",2,{"id":10,"title":11,"level":8},"paso-1-entra-a-la-pantalla","Paso 1: Entrá a la pantalla",{"id":13,"title":14,"level":8},"paso-2-lee-la-lista-de-cobros","Paso 2: Leé la lista de cobros",{"id":16,"title":17,"level":8},"paso-3-busca-un-cobro-con-los-filtros","Paso 3: Buscá un cobro con los filtros",{"id":19,"title":20,"level":8},"paso-4-borra-los-filtros","Paso 4: Borrá los filtros",{"id":22,"title":23,"level":8},"paso-5-mira-el-detalle-de-un-cobro","Paso 5: Mirá el detalle de un cobro",{"id":25,"title":26,"level":8},"paso-6-abri-la-mesa-o-la-caja-del-cobro","Paso 6: Abrí la mesa o la caja del cobro",{"id":28,"title":29,"level":8},"paso-7-volve-a-la-lista","Paso 7: Volvé a la lista",{"id":31,"title":32,"level":8},"puedo-cambiar-el-medio-de-un-cobro-de-mercadopago","¿Puedo cambiar el medio de un cobro de MercadoPago?",{"id":34,"title":35,"level":8},"resolucion-de-inconvenientes","Resolución de Inconvenientes",{"title":37,"description":38,"keywords":39},"Transacciones MercadoPago - Manual","¿Dónde está en el sistema?: Menú principal → Medios de Pago → Transacciones MercadoPago\n ¿Quién lo usa?: Cajeros, encargados y contadores","transacciones mercadopago, paxapos, transacciones mercadopago, tutorial, guía, manual usuario","32-transacciones-mercadopago.txt"],"uses":{"params":["slug"]}}]}
