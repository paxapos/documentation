{"type":"data","nodes":[null,{"type":"data","data":[{"moduleCategories":1},[2,17,44,53,77,98,110,140,146,173,185,221,250],{"title":3,"modules":4},"Comenzamos",[5,8,11,14],{"slug":6,"title":7},"introduccion","Bienvenido a tu software gastronómico",{"slug":9,"title":10},"iniciar-sesion","Cómo Iniciar Sesión",{"slug":12,"title":13},"recuperar-contrasena","Cómo Recuperar tu Contraseña",{"slug":15,"title":16},"guia-de-inicio-rapido","Guía de Inicio Rápido",{"title":18,"modules":19},"Ventas",[20,23,26,29,32,35,38,41],{"slug":21,"title":22},"salon-de-ventas","Cómo Usar el Salón de Ventas (Adición)",{"slug":24,"title":25},"caja-rapida","Cómo Usar la Caja Rápida (Registradora)",{"slug":27,"title":28},"mozos","Cómo Cargar los Mozos",{"slug":30,"title":31},"clientes","Cómo Gestionar los Clientes",{"slug":33,"title":34},"descuentos","Cómo Configurar Descuentos",{"slug":36,"title":37},"nueva-reserva","Cómo Cargar una Nueva Reserva",{"slug":39,"title":40},"listado-de-reservas","Cómo Usar el Listado de Reservas",{"slug":42,"title":43},"grilla-de-reservas","Cómo Usar la Grilla de Reservas",{"title":45,"modules":46},"Medios de Pago",[47,50],{"slug":48,"title":49},"configuracion-procesadores","Configuración de Procesadores de Pago",{"slug":51,"title":52},"transacciones-mercadopago","Transacciones MercadoPago",{"title":54,"modules":55},"Productos",[56,59,62,65,68,71,74],{"slug":57,"title":58},"menu","Menú de Productos (Carta)",{"slug":60,"title":61},"categorias","Categorías de Productos",{"slug":63,"title":64},"variantes-grupo-sabores","Variantes y Grupos de Sabores",{"slug":66,"title":67},"maestro-de-productos","Maestro de Productos",{"slug":69,"title":70},"subproductos-elaborados","Sub-Productos (Elaborados)",{"slug":72,"title":73},"recetas","Recetas",{"slug":75,"title":76},"analisis-duplicados","Buscar Duplicados",{"title":78,"modules":79},"Compras",[80,83,86,89,92,95],{"slug":81,"title":82},"todas-las-ordenes-compra","Órdenes de Compra",{"slug":84,"title":85},"crear-orden-compra","Crear una Orden de Compra",{"slug":87,"title":88},"ordenes-a-aprobar","Órdenes a aprobar",{"slug":90,"title":91},"mercaderias","Mercaderías",{"slug":93,"title":94},"proveedores","Proveedores",{"slug":96,"title":97},"historial-de-compras","Historial de Compras",{"title":99,"modules":100},"Stock",[101,104,107],{"slug":102,"title":103},"stock-mercaderias","Stock de Mercaderías",{"slug":105,"title":106},"stock-subproductos","Stock de Subproductos",{"slug":108,"title":109},"movimientos-de-stock","Movimientos de Stock",{"title":111,"modules":112},"Finanzas",[113,116,119,122,125,128,131,134,137],{"slug":114,"title":115},"arqueos-de-caja","Arqueos de Caja",{"slug":117,"title":118},"listado-de-cajas","Listado de Cajas",{"slug":120,"title":121},"transacciones-de-cobro","Transacciones de Cobro",{"slug":123,"title":124},"factura-manual","Factura Manual",{"slug":126,"title":127},"resumen-de-deuda","Resumen de Deuda",{"slug":129,"title":130},"pagos","Pagos",{"slug":132,"title":133},"historial-de-facturas","Historial de Facturas",{"slug":135,"title":136},"historico-de-mesas","Histórico de Mesas",{"slug":138,"title":139},"puntos-de-venta-pdv","Puntos de Venta (PDVs)",{"title":141,"modules":142},"Comandero",[143],{"slug":144,"title":145},"comandero","Comandero (pantalla de cocina)",{"title":147,"modules":148},"RRHH",[149,152,155,158,161,164,167,170],{"slug":150,"title":151},"empleados","Empleados",{"slug":153,"title":154},"empleados-trabajando","Empleados Trabajando",{"slug":156,"title":157},"registro-diario-fichaje","Registro Diario de Fichaje",{"slug":159,"title":160},"reporte-mensual-fichaje","Reporte Mensual de Fichaje",{"slug":162,"title":163},"departamentos","Departamentos",{"slug":165,"title":166},"turnos-y-horarios-fichaje","Turnos y Horarios de Fichaje",{"slug":168,"title":169},"sueldos-y-jornales","Sueldos y Jornales",{"slug":171,"title":172},"datos-de-acceso-app","Datos de Acceso a la App de Fichaje",{"title":174,"modules":175},"Reportes",[176,179,182],{"slug":177,"title":178},"tablero-general","Tablero General",{"slug":180,"title":181},"productos-mas-vendidos","Productos Más Vendidos",{"slug":183,"title":184},"compras-por-mercaderia","Compras por Mercadería",{"title":186,"modules":187},"Configuracion",[188,191,194,197,200,203,206,209,212,215,218],{"slug":189,"title":190},"configuracion-general","Configuración general",{"slug":192,"title":193},"impresoras","Cómo cargar las impresoras del local",{"slug":195,"title":196},"perfiles-de-impresion","Cómo usar los perfiles de impresión",{"slug":198,"title":199},"usuarios-del-sistema","Cómo administrar los Usuarios del Sistema",{"slug":201,"title":202},"usuarios-con-pin","Cómo administrar los Usuarios con PIN",{"slug":204,"title":205},"punto-de-venta","🏛️ Trámite en ARCA (con clave fiscal)",{"slug":207,"title":208},"permisos-por-rol","Cómo configurar los Permisos por Rol",{"slug":210,"title":211},"turnos-mesa","Turnos de Mesa",{"slug":213,"title":214},"medios-de-cobro","Medios de cobro",{"slug":216,"title":217},"clasificacion-de-gastos","Clasificación de Gastos",{"slug":219,"title":220},"centros-de-costo","Centros de Costo",{"title":222,"modules":223},"Biblioteca de Drivers",[224,226,229,232,235,238,241,244,247],{"slug":225,"title":222},"biblioteca-de-drivers",{"slug":227,"title":228},"sam4s-giant-100","Sam4S Giant - 100",{"slug":230,"title":231},"citizen-ct-s310ii","Citizen CT-S310II",{"slug":233,"title":234},"epson-tm-t20","Epson TM-T20",{"slug":236,"title":237},"drivers-genericos","Drivers Genéricos POS",{"slug":239,"title":240},"epson-tm-t88","Epson TM-T88V",{"slug":242,"title":243},"fiscalberry-windows","Instalar Fiscalberry en Windows",{"slug":245,"title":246},"fiscalberry-linux","Instalar Fiscalberry en Linux",{"slug":248,"title":249},"fiscalberry-android","Instalar Fiscalberry en Android",{"title":251,"modules":252},"Extra",[253,256,259,262,265,268,271,274,277,280],{"slug":254,"title":255},"01-faq-solucion-inicial-pantalla-congelada","📖 Manual de Usuario: Solución Inicial si la Pantalla se Congela o no Carga",{"slug":257,"title":258},"03-faq-mozo-reabrir-mesa-anulada","📖 Manual de Usuario: Cómo Reabrir una Mesa Anulada o Cerrada por Error",{"slug":260,"title":261},"05-faq-cajero-emitir-factura-a","📖 Manual de Usuario: Cómo Emitir una Factura A Cargando Datos del Cliente",{"slug":263,"title":264},"06-faq-cajero-ingreso-egreso-cajon","📖 Manual de Usuario: Cómo Registrar Entradas y Salidas de Dinero del Cajón",{"slug":266,"title":267},"07-faq-cajero-activar-medio-pago","📖 Manual de Usuario: Cómo Activar un Medio de Pago que no Aparece al Cobrar",{"slug":269,"title":270},"08-faq-cajero-diferencia-facturado-vs-abiertas","📖 Manual de Usuario: Diferencia entre \"Facturado Total Mesas\" y \"Abiertas Por Usuario\" en Caja",{"slug":272,"title":273},"10-faq-supervisor-cierre-caja-diferencias","📖 Manual de Usuario: Cómo Auditar y Solucionar Diferencias en el Cierre de Caja",{"slug":275,"title":276},"preguntas-frecuentes","Preguntas Frecuentes y Guías Rápidas por Rol",{"slug":278,"title":279},"buchon-bot","Buchón Bot",{"slug":281,"title":282},"troubleshooting-semantico","📖 Guía Única de Resolución de Problemas y Errores (Troubleshooting)"],"uses":{}},{"type":"data","data":[{"slug":1,"title":2,"content":3,"tableOfContents":4,"seo":52,"llmTxtFile":56},"maestro-de-productos","Maestro de Productos","\u003Cdiv id=\"maestro-de-productos\">\u003C/div>\n\n\u003Cblockquote>\n\u003Cp>\u003Cstrong>¿Dónde está en el sistema?:\u003C/strong> Menú principal → \u003Cstrong>Productos\u003C/strong> → \u003Cstrong>Gestión Avanzada\u003C/strong> → \u003Cstrong>Maestro de Productos\u003C/strong>\n\u003Cstrong>¿Quién lo usa?:\u003C/strong> Administradores y encargados de compras o costos\u003C/p>\n\u003C/blockquote>\n\u003Cblockquote>\n\u003Cp>🎯 \u003Cstrong>¿Para qué sirve esto?\u003C/strong>\nEs la lista de \u003Cstrong>todos\u003C/strong> los productos del comercio: los que vendés, los que comprás y los que preparás vos.\nDesde acá los buscás, los creás, les cambiás el nombre y mirás su ficha completa.\u003C/p>\n\u003C/blockquote>\n\u003Cblockquote>\n\u003Cp>💡 \u003Cstrong>Consejo útil:\u003C/strong> si estás cargando tu carta por primera vez, no empieces por acá. Los productos que vendés se cargan desde el \u003Ca href=\"/user-guide/menu\">Menú\u003C/a>, con su categoría y su precio. El \u003Cstrong>Menú\u003C/strong> tiene solo lo que vendés; el \u003Cstrong>Maestro\u003C/strong> tiene todo.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🔑 Antes de empezar\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"antes-de-empezar\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"antes-de-empezar\">\u003C/div>\n\n\u003Cul>\n\u003Cli>Tu usuario tiene que tener el permiso de \u003Cstrong>Maestro de Productos\u003C/strong> en \u003Ca href=\"/user-guide/permisos-por-rol\">Permisos por Rol\u003C/a>.\u003C/li>\n\u003C/ul>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                📍 Paso 1: Entrá a la pantalla\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-1-entra-a-la-pantalla\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-1-entra-a-la-pantalla\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/44-00a-menu-grupo-productos.png\" alt=\"Menú lateral con el grupo Productos marcado en rojo\">\u003C/p>\n\u003Col>\n\u003Cli>En el menú de la izquierda, tocá \u003Cstrong>Productos\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/44-00b-menu-opcion-productos.png\" alt=\"Opción Maestro de Productos marcada en rojo, debajo de Gestión Avanzada\">\u003C/p>\n\u003Col start=\"2\">\n\u003Cli>Tocá \u003Cstrong>Maestro de Productos\u003C/strong>. Está debajo del título \u003Cstrong>GESTIÓN AVANZADA\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/44-01-pantalla-index.png\" alt=\"Pantalla Maestro de Productos con los filtros arriba y la lista de productos abajo\">\u003C/p>\n\u003Cp>Así se ve la pantalla. La lista tarda unos segundos en aparecer.\u003C/p>\n\u003Cp>La columna \u003Cstrong>Tipo\u003C/strong> te dice qué es cada producto:\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>VENTA\u003C/strong>: lo vendés al cliente. Por ejemplo: \u003Cem>Coca Cola\u003C/em>.\u003C/li>\n\u003Cli>\u003Cstrong>COMPRA\u003C/strong>: lo comprás a un proveedor. Por ejemplo: \u003Cem>Harina\u003C/em>.\u003C/li>\n\u003Cli>\u003Cstrong>SUBPRODUCTO\u003C/strong>: lo preparás vos y lo usás en otros productos. Por ejemplo: una salsa.\u003C/li>\n\u003Cli>\u003Cstrong>INGREDIENTE\u003C/strong>, \u003Cstrong>VARIANTE\u003C/strong> y \u003Cstrong>RECETA\u003C/strong>: se usa en recetas, es una opción de variante o tiene receta.\u003C/li>\n\u003C/ul>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/44-79-donde-esta-boton-ayuda.png\" alt=\"Pantalla con el botón de ayuda marcado en rojo\">\u003C/p>\n\u003Cblockquote>\n\u003Cp>💡 \u003Cstrong>Consejo útil:\u003C/strong> tocá el botón \u003Cstrong>?\u003C/strong> de arriba para ver esta explicación en la pantalla.\u003C/p>\n\u003C/blockquote>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/44-80-ayuda-abierta.png\" alt=\"Explicación ¿Qué es el Maestro de Productos? abierta\">\u003C/p>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🔎 Paso 2: Buscá un producto\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-2-busca-un-producto\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-2-busca-un-producto\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/44-02-campo-search.png\" alt=\"Casillero de búsqueda con la palabra ALFAJOR escrita\">\u003C/p>\n\u003Col>\n\u003Cli>En el primer casillero, escribí el nombre o el código de barras. Por ejemplo: \u003Cem>ALFAJOR\u003C/em>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/44-03-campo-tipo-producto.png\" alt=\"Lista Todos los tipos\">\u003C/p>\n\u003Col start=\"2\">\n\u003Cli>Si querés, en \u003Cstrong>Todos los tipos\u003C/strong> elegí solo los que vendés o solo los que comprás.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/44-04-campo-tiene-receta.png\" alt=\"Lista Con y sin receta\">\u003C/p>\n\u003Col start=\"3\">\n\u003Cli>En \u003Cstrong>Con y sin receta\u003C/strong> podés ver solo los que tienen receta, o solo los que no.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/44-07-campo-deleted.png\" alt=\"Casilla Incluir productos eliminados\">\u003C/p>\n\u003Col start=\"4\">\n\u003Cli>Marcá \u003Cstrong>Incluir productos eliminados\u003C/strong> si buscás uno que borraste.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/44-08-campo-duplicados.png\" alt=\"Casilla Solo duplicados\">\u003C/p>\n\u003Col start=\"5\">\n\u003Cli>Marcá \u003Cstrong>Solo duplicados\u003C/strong> para ver los productos que tienen el mismo nombre que otro.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/44-05-donde-esta-boton-buscar.png\" alt=\"Pantalla con el botón azul Buscar marcado en rojo\">\u003C/p>\n\u003Col start=\"6\">\n\u003Cli>Tocá el botón azul \u003Cstrong>Buscar\u003C/strong>.\u003C/li>\n\u003Cli>La lista muestra solo los productos que coinciden.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/44-13-donde-esta-boton-limpiar-busqueda.png\" alt=\"Pantalla No se encontraron productos con el botón Limpiar búsqueda marcado en rojo\">\u003C/p>\n\u003Col start=\"8\">\n\u003Cli>Si dice \u003Cstrong>No se encontraron productos\u003C/strong>, tocá \u003Cstrong>Limpiar búsqueda\u003C/strong> para ver la lista completa.\u003C/li>\n\u003C/ol>\n\u003Cblockquote>\n\u003Cp>💡 \u003Cstrong>Consejo útil:\u003C/strong> para cambiar el nombre o el código de barras rápido, hacé clic sobre ellos en la lista. Escribí el nuevo y tocá Enter.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                ➕ Paso 3: Creá un producto\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-3-crea-un-producto\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-3-crea-un-producto\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/44-81-donde-esta-boton-crear-nuevo-producto.png\" alt=\"Pantalla con el botón azul Crear Nuevo Producto marcado en rojo\">\u003C/p>\n\u003Col>\n\u003Cli>Tocá el botón azul \u003Cstrong>Crear Nuevo Producto\u003C/strong>. Está arriba a la derecha.\u003C/li>\n\u003Cli>Se abre una ventana.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/44-84-pantalla-nuevo-producto.png\" alt=\"Ventana Crear Nuevo Producto con Pizza Muzzarella escrito\">\u003C/p>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/44-65-campo-name.png\" alt=\"Casillero Nombre con Pizza Muzzarella escrito\">\u003C/p>\n\u003Col start=\"3\">\n\u003Cli>En \u003Cstrong>Nombre\u003C/strong>, escribí el nombre del producto. Por ejemplo: \u003Cem>Pizza Muzzarella\u003C/em>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/44-68-campo-imagen.png\" alt=\"Botón para elegir la imagen del producto\">\u003C/p>\n\u003Col start=\"4\">\n\u003Cli>Si querés, en \u003Cstrong>Imagen\u003C/strong> tocá \u003Cstrong>Choose File\u003C/strong> (o \u003Cstrong>Elegir archivo\u003C/strong>) y elegí una foto.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/44-69-campo-barcode.png\" alt=\"Casillero Código de Barras\">\u003C/p>\n\u003Col start=\"5\">\n\u003Cli>En \u003Cstrong>Código de Barras\u003C/strong>, escribí el código si el producto lo tiene.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/44-70-campo-contas-el-stock-por.png\" alt=\"Lista Contás el stock por con Unidad elegida\">\u003C/p>\n\u003Col start=\"6\">\n\u003Cli>En \u003Cstrong>Contás el stock por\u003C/strong>, elegí cómo lo contás. Por ejemplo: \u003Cem>Unidad\u003C/em>, \u003Cem>Kilo\u003C/em> o \u003Cem>Litro\u003C/em>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/44-71-campo-porcentaje-de-desperdicio.png\" alt=\"Casillero Porcentaje de desperdicio\">\u003C/p>\n\u003Col start=\"7\">\n\u003Cli>En \u003Cstrong>Porcentaje de desperdicio\u003C/strong>, poné cuánto se pierde al usarlo. Por ejemplo: \u003Cem>10\u003C/em>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/44-85-campo-descripcion.png\" alt=\"Casillero Descripción con su barra de herramientas\">\u003C/p>\n\u003Col start=\"8\">\n\u003Cli>En \u003Cstrong>Descripción\u003C/strong> podés escribir un texto sobre el producto.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/44-73-donde-esta-boton-agregar.png\" alt=\"Ventana con el botón verde Agregar marcado en rojo\">\u003C/p>\n\u003Col start=\"9\">\n\u003Cli>Tocá el botón verde \u003Cstrong>Agregar\u003C/strong>.\u003C/li>\n\u003Cli>El producto aparece en la lista.\u003C/li>\n\u003C/ol>\n\u003Ch3 class=\"relative\">\n                Si el nombre ya existe\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"si-el-nombre-ya-existe\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h3>\n            \u003Cdiv id=\"si-el-nombre-ya-existe\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/44-86-aviso-producto-similar.png\" alt=\"Aviso Ya existe un producto similar, con sugerencias de nombres\">\u003C/p>\n\u003Cp>Si ya hay un producto con un nombre muy parecido, el sistema no lo guarda. Te muestra nombres parecidos para elegir.\u003C/p>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/44-66-donde-esta-boton-flecha.png\" alt=\"Pantalla con una sugerencia de nombre marcada en rojo\">\u003C/p>\n\u003Col>\n\u003Cli>Tocá uno de los nombres sugeridos. Se copia en el casillero \u003Cstrong>Nombre\u003C/strong>.\u003C/li>\n\u003Cli>Tocá \u003Cstrong>Agregar\u003C/strong> de nuevo.\u003C/li>\n\u003C/ol>\n\u003Cblockquote>\n\u003Cp>⚠️ \u003Cstrong>Atención:\u003C/strong> antes de crear otro, fijate si el producto ya existe. Dos productos iguales te desordenan el stock y los costos.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                ⚙️ Paso 4: Usá el botón Acciones\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-4-usa-el-boton-acciones\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-4-usa-el-boton-acciones\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/44-09-donde-esta-boton-dropdown-toggle.png\" alt=\"Lista con el botón Acciones de un producto marcado en rojo\">\u003C/p>\n\u003Col>\n\u003Cli>Tocá \u003Cstrong>Acciones\u003C/strong>, a la derecha del producto.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/44-83-menu-acciones-abierto.png\" alt=\"Menú de Acciones abierto con Ver Detalle, Agregar Mercadería, Crear Receta, Editar y Eliminar\">\u003C/p>\n\u003Col start=\"2\">\n\u003Cli>Se abre una lista. Elegí qué querés hacer:\u003Cul>\n\u003Cli>\u003Cstrong>Ver Detalle\u003C/strong>: abre la ficha completa del producto (Paso 5).\u003C/li>\n\u003Cli>\u003Cstrong>Agregar a Menú\u003C/strong>: aparece si el producto todavía no se vende.\u003C/li>\n\u003Cli>\u003Cstrong>Agregar Mercadería\u003C/strong>: para comprarlo a un proveedor.\u003C/li>\n\u003Cli>\u003Cstrong>Crear Receta\u003C/strong> o \u003Cstrong>Editar Receta\u003C/strong>: para cargar sus ingredientes.\u003C/li>\n\u003Cli>\u003Cstrong>Editar\u003C/strong>: abre el formulario del producto.\u003C/li>\n\u003C/ul>\n\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/44-11-donde-esta-boton-eliminar.png\" alt=\"Menú de Acciones con Eliminar marcado en rojo\">\u003C/p>\n\u003Cblockquote>\n\u003Cp>⚠️ \u003Cstrong>Atención:\u003C/strong> \u003Cstrong>Eliminar\u003C/strong> borra el producto. El sistema te pregunta si estás seguro antes. Si te equivocaste, buscalo con \u003Cstrong>Incluir productos eliminados\u003C/strong> y tocá \u003Cstrong>Restaurar\u003C/strong>.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                📄 Paso 5: Mirá la ficha de un producto\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-5-mira-la-ficha-de-un-producto\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-5-mira-la-ficha-de-un-producto\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/44-87-pantalla-ficha.png\" alt=\"Ficha del producto JAMON Y QUESO con sus botones y la sección Cómo se vende este producto\">\u003C/p>\n\u003Cp>La ficha muestra todo sobre el producto. Arriba están los botones. Abajo, una sección por cada uso del producto.\u003C/p>\n\u003Ch3 class=\"relative\">\n                Botones de arriba\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"botones-de-arriba\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h3>\n            \u003Cdiv id=\"botones-de-arriba\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/44-21-donde-esta-boton-editar.png\" alt=\"Ficha con el botón Editar marcado en rojo\">\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Editar\u003C/strong>: abre el formulario del producto (Paso 6).\u003C/li>\n\u003C/ul>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/44-88-donde-esta-boton-agregar-costo.png\" alt=\"Ficha con el botón Agregar Costo marcado en rojo\">\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Agregar Costo (P. Unitario)\u003C/strong>: para cargar a mano cuánto te cuesta, si no lo comprás por el sistema.\u003C/li>\n\u003C/ul>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/44-90-donde-esta-boton-agregar-receta.png\" alt=\"Ficha del producto Frutilla con el botón Agregar Receta marcado en rojo\">\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Agregar Receta\u003C/strong> (o \u003Cstrong>Editar Receta\u003C/strong>): para cargar los ingredientes. Mirá \u003Ca href=\"/user-guide/recetas\">Recetas\u003C/a>.\u003C/li>\n\u003C/ul>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/44-29-donde-esta-boton-borrar.png\" alt=\"Ficha con el botón rojo Borrar marcado en rojo\">\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Borrar\u003C/strong>: borra el producto. El sistema te pregunta si estás seguro antes.\u003C/li>\n\u003C/ul>\n\u003Ch3 class=\"relative\">\n                Cómo se vende este producto\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"como-se-vende-este-producto\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h3>\n            \u003Cdiv id=\"como-se-vende-este-producto\">\u003C/div>\n\n\u003Cp>Aparece si el producto está en algún menú. Muestra el precio, la categoría y el impuesto.\u003C/p>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/44-31-donde-esta-boton-ver-en.png\" alt=\"Ficha con el botón Ver en Menú marcado en rojo\">\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Ver en Menú\u003C/strong>: te lleva al producto dentro del menú, para cambiar el precio.\u003C/li>\n\u003C/ul>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/44-33-donde-esta-boton-agregar-a-otro-menu.png\" alt=\"Ficha con el botón verde Agregar a otro menú marcado en rojo\">\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Agregar a otro menú\u003C/strong>: para venderlo también en otro menú. Por ejemplo: en el de delivery.\u003C/li>\n\u003C/ul>\n\u003Ch3 class=\"relative\">\n                Receta / Elaboración\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"receta-elaboracion\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h3>\n            \u003Cdiv id=\"receta-elaboracion\">\u003C/div>\n\n\u003Cp>Aparece si el producto tiene receta. Muestra los ingredientes y cuánto cuesta prepararlo.\u003C/p>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/44-51-donde-esta-boton-editar-receta.png\" alt=\"Ficha con el botón Editar receta marcado en rojo\">\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Editar receta\u003C/strong>: para cambiar los ingredientes o las cantidades.\u003C/li>\n\u003C/ul>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/44-57-donde-esta-boton-producto-name.png\" alt=\"Solapa Mi Receta con el nombre de un ingrediente marcado en rojo\">\u003C/p>\n\u003Cul>\n\u003Cli>Abajo, en la solapa \u003Cstrong>Mi Receta\u003C/strong>, tocá el nombre de un ingrediente para abrir su ficha.\u003C/li>\n\u003C/ul>\n\u003Ch3 class=\"relative\">\n                Cómo se compra este producto\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"como-se-compra-este-producto\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h3>\n            \u003Cdiv id=\"como-se-compra-este-producto\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/44-92-seccion-compras.png\" alt=\"Sección Cómo se compra este producto con la mercadería CHOCOLATE\">\u003C/p>\n\u003Cp>Aparece si el producto se compra, o si no se vende. Cada renglón es una \u003Cstrong>mercadería\u003C/strong>: la forma en que se lo comprás al proveedor. Por ejemplo: \u003Cem>Chocolate por kilo\u003C/em>.\u003C/p>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/44-39-donde-esta-boton-crear-nueva-mercaderia-para-este.png\" alt=\"Ficha con el botón Crear nueva mercadería marcado en rojo\">\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Crear nueva mercadería para este producto\u003C/strong>: por ejemplo, si ahora lo comprás en otra presentación.\u003C/li>\n\u003C/ul>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/44-35-donde-esta-boton-crear-primera-mercaderia-para-es.png\" alt=\"Ficha de Frutilla con el botón Crear primera mercadería marcado en rojo\">\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Crear primera mercadería para este producto\u003C/strong>: aparece si todavía no lo comprás a nadie.\u003C/li>\n\u003C/ul>\n\u003Ch3 class=\"relative\">\n                En qué recetas se usa este producto\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"en-que-recetas-se-usa-este-producto\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h3>\n            \u003Cdiv id=\"en-que-recetas-se-usa-este-producto\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/44-53-donde-esta-boton-ver.png\" alt=\"Sección En qué recetas se usa este producto con el botón Ver marcado en rojo\">\u003C/p>\n\u003Cul>\n\u003Cli>Aparece si el producto es ingrediente de otros. Tocá \u003Cstrong>Ver\u003C/strong> para abrir el producto que lo usa.\u003C/li>\n\u003C/ul>\n\u003Ch3 class=\"relative\">\n                Este producto es Variante (Sabor)\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"este-producto-es-variante-sabor\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h3>\n            \u003Cdiv id=\"este-producto-es-variante-sabor\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/44-55-donde-esta-boton-editar-sabor.png\" alt=\"Sección Este producto es Variante con el botón Editar Sabor marcado en rojo\">\u003C/p>\n\u003Cul>\n\u003Cli>Aparece si el producto es una opción de una variante. Tocá \u003Cstrong>Editar Sabor\u003C/strong> para cambiar su precio en esa variante. Mirá \u003Ca href=\"/user-guide/variantes-grupo-sabores\">Variantes\u003C/a>.\u003C/li>\n\u003C/ul>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                ✏️ Paso 6: Cambiá los datos de un producto\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-6-cambia-los-datos-de-un-producto\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-6-cambia-los-datos-de-un-producto\">\u003C/div>\n\n\u003Col>\n\u003Cli>En la ficha, tocá \u003Cstrong>Editar\u003C/strong>. O en la lista, tocá \u003Cstrong>Acciones\u003C/strong> → \u003Cstrong>Editar\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/44-93-pantalla-editar-producto.png\" alt=\"Formulario Editar del producto JAMON Y QUESO\">\u003C/p>\n\u003Col start=\"2\">\n\u003Cli>Se abre el formulario con los datos del producto. Cambiá lo que necesites.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/44-75-donde-esta-boton-actualizar.png\" alt=\"Formulario con el botón verde Actualizar marcado en rojo\">\u003C/p>\n\u003Col start=\"3\">\n\u003Cli>Tocá el botón verde \u003Cstrong>Actualizar\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                ⚠️ Resolución de Inconvenientes\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"resolucion-de-inconvenientes\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"resolucion-de-inconvenientes\">\u003C/div>\n\n\u003Cdiv class=\"table-wrapper\">\u003Ctable>\n\u003Cthead>\n\u003Ctr>\n\u003Cth>Problema\u003C/th>\n\u003Cth>Causa más frecuente\u003C/th>\n\u003Cth>Solución recomendada\u003C/th>\n\u003C/tr>\n\u003C/thead>\n\u003Ctbody>\u003Ctr>\n\u003Ctd>\u003Cstrong>La lista dice &quot;Cargando página, por favor espera...&quot;\u003C/strong>\u003C/td>\n\u003Ctd>La lista todavía se está armando.\u003C/td>\n\u003Ctd>Esperá unos segundos. Si no aparece, recargá la página.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>No me deja crear el producto: dice &quot;Ya existe un producto similar&quot;\u003C/strong>\u003C/td>\n\u003Ctd>Ya hay un producto con un nombre casi igual.\u003C/td>\n\u003Ctd>Buscalo en la lista. Si es otro distinto, elegí un nombre sugerido.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>No encuentro un producto que borré\u003C/strong>\u003C/td>\n\u003Ctd>La lista no muestra los borrados.\u003C/td>\n\u003Ctd>Marcá \u003Cstrong>Incluir productos eliminados\u003C/strong> y tocá \u003Cstrong>Buscar\u003C/strong>.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>El producto no aparece para vender\u003C/strong>\u003C/td>\n\u003Ctd>Está en el Maestro pero no en ningún menú.\u003C/td>\n\u003Ctd>Tocá \u003Cstrong>Acciones\u003C/strong> → \u003Cstrong>Agregar a Menú\u003C/strong>, o cargalo desde el \u003Ca href=\"/user-guide/menu\">Menú\u003C/a>.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>El costo del producto sale en $0\u003C/strong>\u003C/td>\n\u003Ctd>No tiene compras, ni receta, ni costo cargado.\u003C/td>\n\u003Ctd>Cargale una mercadería, una receta o tocá \u003Cstrong>Agregar Costo (P. Unitario)\u003C/strong>.\u003C/td>\n\u003C/tr>\n\u003C/tbody>\u003C/table>\u003C/div>\n",[5,9,12,15,18,22,25,28,31,34,37,40,43,46,49],{"id":6,"title":7,"level":8},"antes-de-empezar","Antes de empezar",2,{"id":10,"title":11,"level":8},"paso-1-entra-a-la-pantalla","Paso 1: Entrá a la pantalla",{"id":13,"title":14,"level":8},"paso-2-busca-un-producto","Paso 2: Buscá un producto",{"id":16,"title":17,"level":8},"paso-3-crea-un-producto","Paso 3: Creá un producto",{"id":19,"title":20,"level":21},"si-el-nombre-ya-existe","Si el nombre ya existe",3,{"id":23,"title":24,"level":8},"paso-4-usa-el-boton-acciones","Paso 4: Usá el botón Acciones",{"id":26,"title":27,"level":8},"paso-5-mira-la-ficha-de-un-producto","Paso 5: Mirá la ficha de un producto",{"id":29,"title":30,"level":21},"botones-de-arriba","Botones de arriba",{"id":32,"title":33,"level":21},"como-se-vende-este-producto","Cómo se vende este producto",{"id":35,"title":36,"level":21},"receta-elaboracion","Receta / Elaboración",{"id":38,"title":39,"level":21},"como-se-compra-este-producto","Cómo se compra este producto",{"id":41,"title":42,"level":21},"en-que-recetas-se-usa-este-producto","En qué recetas se usa este producto",{"id":44,"title":45,"level":21},"este-producto-es-variante-sabor","Este producto es Variante (Sabor)",{"id":47,"title":48,"level":8},"paso-6-cambia-los-datos-de-un-producto","Paso 6: Cambiá los datos de un producto",{"id":50,"title":51,"level":8},"resolucion-de-inconvenientes","Resolución de Inconvenientes",{"title":53,"description":54,"keywords":55},"Maestro de Productos - Manual","¿Dónde está en el sistema?: Menú principal → Productos → Gestión Avanzada → Maestro de Productos\n ¿Quién lo usa?: Administradores y en...","maestro de productos, paxapos, maestro de productos, tutorial, guía, manual usuario","44-maestro-de-productos.txt"],"uses":{"params":["slug"]}}]}
