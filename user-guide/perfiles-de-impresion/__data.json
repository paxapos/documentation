{"type":"data","nodes":[null,{"type":"data","data":[{"moduleCategories":1},[2,17,44,53,77,98,110,140,146,173,185,221,250],{"title":3,"modules":4},"Comenzamos",[5,8,11,14],{"slug":6,"title":7},"introduccion","Bienvenido a tu software gastronómico",{"slug":9,"title":10},"iniciar-sesion","Cómo Iniciar Sesión",{"slug":12,"title":13},"recuperar-contrasena","Cómo Recuperar tu Contraseña",{"slug":15,"title":16},"guia-de-inicio-rapido","Guía de Inicio Rápido",{"title":18,"modules":19},"Ventas",[20,23,26,29,32,35,38,41],{"slug":21,"title":22},"salon-de-ventas","Cómo Usar el Salón de Ventas (Adición)",{"slug":24,"title":25},"caja-rapida","Cómo Usar la Caja Rápida (Registradora)",{"slug":27,"title":28},"mozos","Cómo Cargar los Mozos",{"slug":30,"title":31},"clientes","Cómo Gestionar los Clientes",{"slug":33,"title":34},"descuentos","Cómo Configurar Descuentos",{"slug":36,"title":37},"nueva-reserva","Cómo Cargar una Nueva Reserva",{"slug":39,"title":40},"listado-de-reservas","Cómo Usar el Listado de Reservas",{"slug":42,"title":43},"grilla-de-reservas","Cómo Usar la Grilla de Reservas",{"title":45,"modules":46},"Medios de Pago",[47,50],{"slug":48,"title":49},"configuracion-procesadores","Configuración de Procesadores de Pago",{"slug":51,"title":52},"transacciones-mercadopago","Transacciones MercadoPago",{"title":54,"modules":55},"Productos",[56,59,62,65,68,71,74],{"slug":57,"title":58},"menu","Menú de Productos (Carta)",{"slug":60,"title":61},"categorias","Categorías de Productos",{"slug":63,"title":64},"variantes-grupo-sabores","Variantes y Grupos de Sabores",{"slug":66,"title":67},"maestro-de-productos","Maestro de Productos",{"slug":69,"title":70},"subproductos-elaborados","Sub-Productos (Elaborados)",{"slug":72,"title":73},"recetas","Recetas",{"slug":75,"title":76},"analisis-duplicados","Buscar Duplicados",{"title":78,"modules":79},"Compras",[80,83,86,89,92,95],{"slug":81,"title":82},"todas-las-ordenes-compra","Órdenes de Compra",{"slug":84,"title":85},"crear-orden-compra","Crear una Orden de Compra",{"slug":87,"title":88},"ordenes-a-aprobar","Órdenes a aprobar",{"slug":90,"title":91},"mercaderias","Mercaderías",{"slug":93,"title":94},"proveedores","Proveedores",{"slug":96,"title":97},"historial-de-compras","Historial de Compras",{"title":99,"modules":100},"Stock",[101,104,107],{"slug":102,"title":103},"stock-mercaderias","Stock de Mercaderías",{"slug":105,"title":106},"stock-subproductos","Stock de Subproductos",{"slug":108,"title":109},"movimientos-de-stock","Movimientos de Stock",{"title":111,"modules":112},"Finanzas",[113,116,119,122,125,128,131,134,137],{"slug":114,"title":115},"arqueos-de-caja","Arqueos de Caja",{"slug":117,"title":118},"listado-de-cajas","Listado de Cajas",{"slug":120,"title":121},"transacciones-de-cobro","Transacciones de Cobro",{"slug":123,"title":124},"factura-manual","Factura Manual",{"slug":126,"title":127},"resumen-de-deuda","Resumen de Deuda",{"slug":129,"title":130},"pagos","Pagos",{"slug":132,"title":133},"historial-de-facturas","Historial de Facturas",{"slug":135,"title":136},"historico-de-mesas","Histórico de Mesas",{"slug":138,"title":139},"puntos-de-venta-pdv","Puntos de Venta (PDVs)",{"title":141,"modules":142},"Comandero",[143],{"slug":144,"title":145},"comandero","Comandero (pantalla de cocina)",{"title":147,"modules":148},"RRHH",[149,152,155,158,161,164,167,170],{"slug":150,"title":151},"empleados","Empleados",{"slug":153,"title":154},"empleados-trabajando","Empleados Trabajando",{"slug":156,"title":157},"registro-diario-fichaje","Registro Diario de Fichaje",{"slug":159,"title":160},"reporte-mensual-fichaje","Reporte Mensual de Fichaje",{"slug":162,"title":163},"departamentos","Departamentos",{"slug":165,"title":166},"turnos-y-horarios-fichaje","Turnos y Horarios de Fichaje",{"slug":168,"title":169},"sueldos-y-jornales","Sueldos y Jornales",{"slug":171,"title":172},"datos-de-acceso-app","Datos de Acceso a la App de Fichaje",{"title":174,"modules":175},"Reportes",[176,179,182],{"slug":177,"title":178},"tablero-general","Tablero General",{"slug":180,"title":181},"productos-mas-vendidos","Productos Más Vendidos",{"slug":183,"title":184},"compras-por-mercaderia","Compras por Mercadería",{"title":186,"modules":187},"Configuracion",[188,191,194,197,200,203,206,209,212,215,218],{"slug":189,"title":190},"configuracion-general","Configuración general",{"slug":192,"title":193},"impresoras","Cómo cargar las impresoras del local",{"slug":195,"title":196},"perfiles-de-impresion","Cómo usar los perfiles de impresión",{"slug":198,"title":199},"usuarios-del-sistema","Cómo administrar los Usuarios del Sistema",{"slug":201,"title":202},"usuarios-con-pin","Cómo administrar los Usuarios con PIN",{"slug":204,"title":205},"punto-de-venta","🏛️ Trámite en ARCA (con clave fiscal)",{"slug":207,"title":208},"permisos-por-rol","Cómo configurar los Permisos por Rol",{"slug":210,"title":211},"turnos-mesa","Turnos de Mesa",{"slug":213,"title":214},"medios-de-cobro","Medios de cobro",{"slug":216,"title":217},"clasificacion-de-gastos","Clasificación de Gastos",{"slug":219,"title":220},"centros-de-costo","Centros de Costo",{"title":222,"modules":223},"Biblioteca de Drivers",[224,226,229,232,235,238,241,244,247],{"slug":225,"title":222},"biblioteca-de-drivers",{"slug":227,"title":228},"sam4s-giant-100","Sam4S Giant - 100",{"slug":230,"title":231},"citizen-ct-s310ii","Citizen CT-S310II",{"slug":233,"title":234},"epson-tm-t20","Epson TM-T20",{"slug":236,"title":237},"drivers-genericos","Drivers Genéricos POS",{"slug":239,"title":240},"epson-tm-t88","Epson TM-T88V",{"slug":242,"title":243},"fiscalberry-windows","Instalar Fiscalberry en Windows",{"slug":245,"title":246},"fiscalberry-linux","Instalar Fiscalberry en Linux",{"slug":248,"title":249},"fiscalberry-android","Instalar Fiscalberry en Android",{"title":251,"modules":252},"Extra",[253,256,259,262,265,268,271,274,277,280],{"slug":254,"title":255},"01-faq-solucion-inicial-pantalla-congelada","📖 Manual de Usuario: Solución Inicial si la Pantalla se Congela o no Carga",{"slug":257,"title":258},"03-faq-mozo-reabrir-mesa-anulada","📖 Manual de Usuario: Cómo Reabrir una Mesa Anulada o Cerrada por Error",{"slug":260,"title":261},"05-faq-cajero-emitir-factura-a","📖 Manual de Usuario: Cómo Emitir una Factura A Cargando Datos del Cliente",{"slug":263,"title":264},"06-faq-cajero-ingreso-egreso-cajon","📖 Manual de Usuario: Cómo Registrar Entradas y Salidas de Dinero del Cajón",{"slug":266,"title":267},"07-faq-cajero-activar-medio-pago","📖 Manual de Usuario: Cómo Activar un Medio de Pago que no Aparece al Cobrar",{"slug":269,"title":270},"08-faq-cajero-diferencia-facturado-vs-abiertas","📖 Manual de Usuario: Diferencia entre \"Facturado Total Mesas\" y \"Abiertas Por Usuario\" en Caja",{"slug":272,"title":273},"10-faq-supervisor-cierre-caja-diferencias","📖 Manual de Usuario: Cómo Auditar y Solucionar Diferencias en el Cierre de Caja",{"slug":275,"title":276},"preguntas-frecuentes","Preguntas Frecuentes y Guías Rápidas por Rol",{"slug":278,"title":279},"buchon-bot","Buchón Bot",{"slug":281,"title":282},"troubleshooting-semantico","📖 Guía Única de Resolución de Problemas y Errores (Troubleshooting)"],"uses":{}},{"type":"data","data":[{"slug":1,"title":2,"content":3,"tableOfContents":4,"seo":27,"llmTxtFile":31},"perfiles-de-impresion","Cómo usar los perfiles de impresión","\u003Cdiv id=\"perfiles-de-impresion\">\u003C/div>\n\n\u003Cblockquote>\n\u003Cp>\u003Cstrong>¿Dónde está en el sistema?:\u003C/strong> Menú principal → \u003Cstrong>Configuración\u003C/strong> → debajo del título \u003Cstrong>Impresoras\u003C/strong> → \u003Cstrong>Perfiles de Impresión\u003C/strong>\n\u003Cstrong>¿Quién lo usa?:\u003C/strong> Administradores\u003C/p>\n\u003C/blockquote>\n\u003Cblockquote>\n\u003Cp>🎯 \u003Cstrong>¿Para qué sirve esto?\u003C/strong>\nUn perfil es un juego de impresoras: cuál imprime la factura, cuál el remito, cuál abre el cajón y cuál las compras. Sirve para que cada zona, caja o mozo imprima por sus propias impresoras.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🔑 \u003Cstrong>Antes de empezar\u003C/strong>\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"antes-de-empezar\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"antes-de-empezar\">\u003C/div>\n\n\u003Cul>\n\u003Cli>Cargá primero las impresoras en \u003Ca href=\"/user-guide/impresoras\">Impresoras\u003C/a>. Sin impresoras no hay nada para elegir.\u003C/li>\n\u003Cli>Si vas a usar un Fiscalberry, tiene que estar instalado y conectado.\u003C/li>\n\u003Cli>Tener el permiso de perfiles de impresión en \u003Ca href=\"/user-guide/permisos-por-rol\">Permisos por Rol\u003C/a>.\u003C/li>\n\u003C/ul>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                📍 \u003Cstrong>Paso 1: Entrá a Perfiles de Impresión\u003C/strong>\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-1-entra-a-perfiles-de-impresion\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-1-entra-a-perfiles-de-impresion\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/110-configuracion/122-00a-menu-grupo-configuracion.png\" alt=\"Menú lateral con el grupo Configuración marcado en rojo\">\u003C/p>\n\u003Col>\n\u003Cli>En el menú de la izquierda, tocá \u003Cstrong>Configuración\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/110-configuracion/122-00b-menu-opcion-perfiles-de-impresion.png\" alt=\"Menú lateral con la opción Perfiles de Impresión marcada en rojo\">\u003C/p>\n\u003Col start=\"2\">\n\u003Cli>Debajo del título \u003Cstrong>Impresoras\u003C/strong>, tocá \u003Cstrong>Perfiles de Impresión\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/110-configuracion/122-01-pantalla-perfiles.png\" alt=\"Pantalla Perfiles de Impresión con el perfil Default y los botones Nuevo Perfil y Migrar desde config actual\">\u003C/p>\n\u003Cp>Arriba, el cuadro \u003Cstrong>Perfil activo en este terminal\u003C/strong> te dice cuál se usa en esta pantalla y por qué. Por ejemplo, \u003Cem>Default del comercio\u003C/em>.\u003C/p>\n\u003Cp>Puede decir otra cosa:\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Override de sesión\u003C/strong>: elegido solo para este terminal.\u003C/li>\n\u003Cli>\u003Cstrong>Tu preferencia guardada\u003C/strong>: el que elegiste como tuyo.\u003C/li>\n\u003Cli>\u003Cstrong>Usuario PIN\u003C/strong> o \u003Cstrong>Asignado al mozo\u003C/strong>: el que tiene asignado ese usuario.\u003C/li>\n\u003Cli>\u003Cstrong>Configuración legacy\u003C/strong>: todavía no hay perfiles.\u003C/li>\n\u003C/ul>\n\u003Cp>Si es un \u003Cstrong>Override de sesión\u003C/strong>, al lado aparece el botón \u003Cstrong>Quitar override de sesión\u003C/strong>. Al tocarlo, el terminal vuelve al perfil de siempre.\u003C/p>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                📋 \u003Cstrong>Paso 2: Leé la tabla de perfiles\u003C/strong>\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-2-lee-la-tabla-de-perfiles\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-2-lee-la-tabla-de-perfiles\">\u003C/div>\n\n\u003Cp>Seguí mirando la foto de arriba.\u003C/p>\n\u003Cp>Debajo de los dos botones azules está la tabla. Cada renglón es un perfil:\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Nombre\u003C/strong>: el tilde verde marca el perfil activo en este terminal.\u003C/li>\n\u003Cli>\u003Cstrong>Servidor (Paxaprinter)\u003C/strong>: el Fiscalberry que usa.\u003C/li>\n\u003Cli>\u003Cstrong>Fiscal\u003C/strong>, \u003Cstrong>Remito\u003C/strong>, \u003Cstrong>Cajón\u003C/strong>, \u003Cstrong>Compras\u003C/strong>: la impresora de cada función. El guion (—) significa que no tiene.\u003C/li>\n\u003Cli>\u003Cstrong>Al cerrar mesa\u003C/strong>: qué imprime al cerrar (\u003Cstrong>Nada\u003C/strong>, \u003Cstrong>Imprime Remito\u003C/strong> o \u003Cstrong>Directo Fiscal\u003C/strong>).\u003C/li>\n\u003Cli>\u003Cstrong>Default\u003C/strong>: la etiqueta verde marca el perfil principal del comercio. En los demás hay un botón \u003Cstrong>Poner default\u003C/strong>.\u003C/li>\n\u003Cli>\u003Cstrong>Acciones\u003C/strong>, de izquierda a derecha:\u003Cul>\n\u003Cli>\u003Cstrong>Usuario\u003C/strong> (azul): usar como \u003Cem>mi perfil\u003C/em>, queda guardado para siempre.\u003C/li>\n\u003Cli>\u003Cstrong>Teléfono\u003C/strong> (naranja): usar solo en este terminal, hasta que salgas.\u003C/li>\n\u003Cli>\u003Cstrong>Lápiz\u003C/strong>: \u003Cstrong>Editar\u003C/strong> el perfil.\u003C/li>\n\u003Cli>\u003Cstrong>Papelera\u003C/strong> (roja): \u003Cstrong>Eliminar\u003C/strong>. No aparece en el perfil default.\u003C/li>\n\u003C/ul>\n\u003C/li>\n\u003C/ul>\n\u003Cblockquote>\n\u003Cp>⚠️ \u003Cstrong>Atención:\u003C/strong> \u003Cstrong>Poner default\u003C/strong> cambia el perfil de todo el comercio. \u003Cstrong>Eliminar\u003C/strong> borra el perfil y pide confirmación.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                ➕ \u003Cstrong>Paso 3: Tocá &quot;Nuevo Perfil&quot;\u003C/strong>\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-3-toca-nuevo-perfil\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-3-toca-nuevo-perfil\">\u003C/div>\n\n\u003Col>\n\u003Cli>En la pantalla del Paso 1, buscá el botón azul \u003Cstrong>Nuevo Perfil\u003C/strong>, arriba a la izquierda de la tabla.\u003C/li>\n\u003Cli>Tocalo una vez.\u003C/li>\n\u003Cli>Se abre la pantalla \u003Cstrong>Nuevo Perfil de Impresión\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cblockquote>\n\u003Cp>💡 \u003Cstrong>Consejo útil:\u003C/strong> si tu comercio todavía no tiene perfiles, tocá \u003Cstrong>Migrar desde config actual\u003C/strong>. Es el botón blanco, al lado de \u003Cstrong>Nuevo Perfil\u003C/strong>. Crea el perfil default con las impresoras que ya usabas. Suele ser lo primero que hay que hacer.\u003C/p>\n\u003C/blockquote>\n\u003Cblockquote>\n\u003Cp>⚠️ \u003Cstrong>Atención:\u003C/strong> \u003Cstrong>Migrar desde config actual\u003C/strong> crea un perfil de verdad. Usalo una sola vez y solo cuando no tengas perfiles.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                📝 \u003Cstrong>Paso 4: Completá los datos del perfil\u003C/strong>\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-4-completa-los-datos-del-perfil\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-4-completa-los-datos-del-perfil\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/110-configuracion/122-02-formulario-parte-1.png\" alt=\"Primera parte del formulario: nombre del perfil y servidor de impresión\">\u003C/p>\n\u003Cp>Bloque \u003Cstrong>Identificación\u003C/strong>:\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Nombre del perfil\u003C/strong> (obligatorio): por ejemplo, \u003Cem>Piso 1\u003C/em>, \u003Cem>Barra\u003C/em> o \u003Cem>Caja principal\u003C/em>.\u003C/li>\n\u003C/ul>\n\u003Cp>Bloque \u003Cstrong>Servidor de Impresión\u003C/strong>:\u003C/p>\n\u003Cul>\n\u003Cli>Elegí el Fiscalberry que maneja las impresoras de este perfil. \u003Cstrong>Online\u003C/strong> (verde) está conectado y \u003Cstrong>Offline\u003C/strong> (rojo) no.\u003C/li>\n\u003Cli>\u003Cstrong>Sin servidor específico\u003C/strong>: usa la configuración general del comercio.\u003C/li>\n\u003Cli>Si hay uno online, ya viene elegido.\u003C/li>\n\u003C/ul>\n\u003Cp>\u003Cimg src=\"/images/manual/110-configuracion/122-03-formulario-parte-2.png\" alt=\"Segunda parte del formulario: impresoras por tipo, comportamiento al cerrar mesa, perfil default y botones Guardar Perfil y Cancelar\">\u003C/p>\n\u003Cp>Bloque \u003Cstrong>Impresoras por tipo\u003C/strong>. Si dejás uno vacío, usa la configuración default:\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Impresora Fiscal\u003C/strong>: la que emite las facturas.\u003C/li>\n\u003Cli>\u003Cstrong>Remitos / Comandas\u003C/strong>: la que imprime remitos y comandas.\u003C/li>\n\u003Cli>\u003Cstrong>Cajón de dinero\u003C/strong>: la que abre el cajón.\u003C/li>\n\u003Cli>\u003Cstrong>Compras / Pedidos\u003C/strong>: la que imprime los pedidos a proveedores.\u003C/li>\n\u003C/ul>\n\u003Cp>Bloque \u003Cstrong>Comportamiento al cerrar mesa\u003C/strong>:\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Al cerrar o facturar mesa\u003C/strong>: elegí \u003Cstrong>No hacer nada\u003C/strong>, \u003Cstrong>Imprimir Remito\u003C/strong> o \u003Cstrong>Directo a la Fiscal\u003C/strong>.\u003C/li>\n\u003Cli>\u003Cstrong>Imprimir fiscal al checkout\u003C/strong>: tildalo para imprimir la factura al cobrar, solo si no se imprimió antes.\u003C/li>\n\u003C/ul>\n\u003Cp>Último bloque:\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Marcar como perfil default del comercio\u003C/strong>: solo puede haber uno. Si lo tildás, el anterior deja de serlo.\u003C/li>\n\u003C/ul>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                💾 \u003Cstrong>Paso 5: Guardá o cancelá\u003C/strong>\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-5-guarda-o-cancela\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-5-guarda-o-cancela\">\u003C/div>\n\n\u003Col>\n\u003Cli>Tocá \u003Cstrong>Guardar Perfil\u003C/strong> (azul). Volvés a la lista y el perfil nuevo aparece en la tabla.\u003C/li>\n\u003Cli>Si te arrepentís, tocá \u003Cstrong>Cancelar\u003C/strong>. No se guarda nada.\u003C/li>\n\u003C/ol>\n\u003Cp>Para cambiar un perfil, tocá el lápiz de su renglón. Se abre la misma pantalla con sus datos. Ahí el botón dice \u003Cstrong>Guardar Cambios\u003C/strong>.\u003C/p>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                ⚠️ \u003Cstrong>Resolución de Inconvenientes\u003C/strong>\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"resolucion-de-inconvenientes\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"resolucion-de-inconvenientes\">\u003C/div>\n\n\u003Cdiv class=\"table-wrapper\">\u003Ctable>\n\u003Cthead>\n\u003Ctr>\n\u003Cth>Problema\u003C/th>\n\u003Cth>Causa más frecuente\u003C/th>\n\u003Cth>Solución recomendada\u003C/th>\n\u003C/tr>\n\u003C/thead>\n\u003Ctbody>\u003Ctr>\n\u003Ctd>Dice \u003Cstrong>Configuración legacy (sin perfiles)\u003C/strong>.\u003C/td>\n\u003Ctd>Todavía no hay ningún perfil.\u003C/td>\n\u003Ctd>Tocá \u003Cstrong>Migrar desde config actual\u003C/strong> o creá uno con \u003Cstrong>Nuevo Perfil\u003C/strong>.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>No puedo elegir ninguna impresora.\u003C/td>\n\u003Ctd>No hay impresoras cargadas.\u003C/td>\n\u003Ctd>Cargalas primero en \u003Ca href=\"/user-guide/impresoras\">Impresoras\u003C/a>.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>El perfil que quiero no es el que se usa.\u003C/td>\n\u003Ctd>Hay un perfil elegido para este terminal, para el mozo o para vos.\u003C/td>\n\u003Ctd>Mirá \u003Cstrong>Perfil activo en este terminal\u003C/strong>. Tocá \u003Cstrong>Quitar override de sesión\u003C/strong> si aparece.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>No veo la papelera en un perfil.\u003C/td>\n\u003Ctd>Es el perfil default.\u003C/td>\n\u003Ctd>Marcá otro como default con \u003Cstrong>Poner default\u003C/strong> y ahí podés eliminar este.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>El servidor figura \u003Cstrong>Offline\u003C/strong>.\u003C/td>\n\u003Ctd>Fiscalberry está cerrado o sin internet.\u003C/td>\n\u003Ctd>Abrilo en la computadora del local.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>Un mozo imprime en la impresora equivocada.\u003C/td>\n\u003Ctd>Tiene otro perfil asignado.\u003C/td>\n\u003Ctd>Mirá el cuadro \u003Cstrong>Perfil activo en este terminal\u003C/strong> y probá con otro perfil.\u003C/td>\n\u003C/tr>\n\u003C/tbody>\u003C/table>\u003C/div>\n",[5,9,12,15,18,21,24],{"id":6,"title":7,"level":8},"antes-de-empezar","Antes de empezar",2,{"id":10,"title":11,"level":8},"paso-1-entra-a-perfiles-de-impresion","Paso 1: Entrá a Perfiles de Impresión",{"id":13,"title":14,"level":8},"paso-2-lee-la-tabla-de-perfiles","Paso 2: Leé la tabla de perfiles",{"id":16,"title":17,"level":8},"paso-3-toca-nuevo-perfil","Paso 3: Tocá \"Nuevo Perfil\"",{"id":19,"title":20,"level":8},"paso-4-completa-los-datos-del-perfil","Paso 4: Completá los datos del perfil",{"id":22,"title":23,"level":8},"paso-5-guarda-o-cancela","Paso 5: Guardá o cancelá",{"id":25,"title":26,"level":8},"resolucion-de-inconvenientes","Resolución de Inconvenientes",{"title":28,"description":29,"keywords":30},"Cómo usar los perfiles de impresión - Manual","¿Dónde está en el sistema?: Menú principal → Configuración → debajo del título Impresoras → Perfiles de Impresión\n ¿Quién lo usa?: Adm...","perfiles de impresion, paxapos, cómo usar los perfiles de impresión, tutorial, guía, manual usuario","122-perfiles-de-impresion.txt"],"uses":{"params":["slug"]}}]}
