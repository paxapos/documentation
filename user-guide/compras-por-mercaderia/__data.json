{"type":"data","nodes":[null,{"type":"data","data":[{"moduleCategories":1},[2,17,44,53,77,98,110,140,146,173,185,221,250],{"title":3,"modules":4},"Comenzamos",[5,8,11,14],{"slug":6,"title":7},"introduccion","Bienvenido a tu software gastronómico",{"slug":9,"title":10},"iniciar-sesion","Cómo Iniciar Sesión",{"slug":12,"title":13},"recuperar-contrasena","Cómo Recuperar tu Contraseña",{"slug":15,"title":16},"guia-de-inicio-rapido","Guía de Inicio Rápido",{"title":18,"modules":19},"Ventas",[20,23,26,29,32,35,38,41],{"slug":21,"title":22},"salon-de-ventas","Cómo Usar el Salón de Ventas (Adición)",{"slug":24,"title":25},"caja-rapida","Cómo Usar la Caja Rápida (Registradora)",{"slug":27,"title":28},"mozos","Cómo Cargar los Mozos",{"slug":30,"title":31},"clientes","Cómo Gestionar los Clientes",{"slug":33,"title":34},"descuentos","Cómo Configurar Descuentos",{"slug":36,"title":37},"nueva-reserva","Cómo Cargar una Nueva Reserva",{"slug":39,"title":40},"listado-de-reservas","Cómo Usar el Listado de Reservas",{"slug":42,"title":43},"grilla-de-reservas","Cómo Usar la Grilla de Reservas",{"title":45,"modules":46},"Medios de Pago",[47,50],{"slug":48,"title":49},"configuracion-procesadores","Configuración de Procesadores de Pago",{"slug":51,"title":52},"transacciones-mercadopago","Transacciones MercadoPago",{"title":54,"modules":55},"Productos",[56,59,62,65,68,71,74],{"slug":57,"title":58},"menu","Menú de Productos (Carta)",{"slug":60,"title":61},"categorias","Categorías de Productos",{"slug":63,"title":64},"variantes-grupo-sabores","Variantes y Grupos de Sabores",{"slug":66,"title":67},"maestro-de-productos","Maestro de Productos",{"slug":69,"title":70},"subproductos-elaborados","Sub-Productos (Elaborados)",{"slug":72,"title":73},"recetas","Recetas",{"slug":75,"title":76},"analisis-duplicados","Buscar Duplicados",{"title":78,"modules":79},"Compras",[80,83,86,89,92,95],{"slug":81,"title":82},"todas-las-ordenes-compra","Órdenes de Compra",{"slug":84,"title":85},"crear-orden-compra","Crear una Orden de Compra",{"slug":87,"title":88},"ordenes-a-aprobar","Órdenes a aprobar",{"slug":90,"title":91},"mercaderias","Mercaderías",{"slug":93,"title":94},"proveedores","Proveedores",{"slug":96,"title":97},"historial-de-compras","Historial de Compras",{"title":99,"modules":100},"Stock",[101,104,107],{"slug":102,"title":103},"stock-mercaderias","Stock de Mercaderías",{"slug":105,"title":106},"stock-subproductos","Stock de Subproductos",{"slug":108,"title":109},"movimientos-de-stock","Movimientos de Stock",{"title":111,"modules":112},"Finanzas",[113,116,119,122,125,128,131,134,137],{"slug":114,"title":115},"arqueos-de-caja","Arqueos de Caja",{"slug":117,"title":118},"listado-de-cajas","Listado de Cajas",{"slug":120,"title":121},"transacciones-de-cobro","Transacciones de Cobro",{"slug":123,"title":124},"factura-manual","Factura Manual",{"slug":126,"title":127},"resumen-de-deuda","Resumen de Deuda",{"slug":129,"title":130},"pagos","Pagos",{"slug":132,"title":133},"historial-de-facturas","Historial de Facturas",{"slug":135,"title":136},"historico-de-mesas","Histórico de Mesas",{"slug":138,"title":139},"puntos-de-venta-pdv","Puntos de Venta (PDVs)",{"title":141,"modules":142},"Comandero",[143],{"slug":144,"title":145},"comandero","Comandero (pantalla de cocina)",{"title":147,"modules":148},"RRHH",[149,152,155,158,161,164,167,170],{"slug":150,"title":151},"empleados","Empleados",{"slug":153,"title":154},"empleados-trabajando","Empleados Trabajando",{"slug":156,"title":157},"registro-diario-fichaje","Registro Diario de Fichaje",{"slug":159,"title":160},"reporte-mensual-fichaje","Reporte Mensual de Fichaje",{"slug":162,"title":163},"departamentos","Departamentos",{"slug":165,"title":166},"turnos-y-horarios-fichaje","Turnos y Horarios de Fichaje",{"slug":168,"title":169},"sueldos-y-jornales","Sueldos y Jornales",{"slug":171,"title":172},"datos-de-acceso-app","Datos de Acceso a la App de Fichaje",{"title":174,"modules":175},"Reportes",[176,179,182],{"slug":177,"title":178},"tablero-general","Tablero General",{"slug":180,"title":181},"productos-mas-vendidos","Productos Más Vendidos",{"slug":183,"title":184},"compras-por-mercaderia","Compras por Mercadería",{"title":186,"modules":187},"Configuracion",[188,191,194,197,200,203,206,209,212,215,218],{"slug":189,"title":190},"configuracion-general","Configuración general",{"slug":192,"title":193},"impresoras","Cómo cargar las impresoras del local",{"slug":195,"title":196},"perfiles-de-impresion","Cómo usar los perfiles de impresión",{"slug":198,"title":199},"usuarios-del-sistema","Cómo administrar los Usuarios del Sistema",{"slug":201,"title":202},"usuarios-con-pin","Cómo administrar los Usuarios con PIN",{"slug":204,"title":205},"punto-de-venta","🏛️ Trámite en ARCA (con clave fiscal)",{"slug":207,"title":208},"permisos-por-rol","Cómo configurar los Permisos por Rol",{"slug":210,"title":211},"turnos-mesa","Turnos de Mesa",{"slug":213,"title":214},"medios-de-cobro","Medios de cobro",{"slug":216,"title":217},"clasificacion-de-gastos","Clasificación de Gastos",{"slug":219,"title":220},"centros-de-costo","Centros de Costo",{"title":222,"modules":223},"Biblioteca de Drivers",[224,226,229,232,235,238,241,244,247],{"slug":225,"title":222},"biblioteca-de-drivers",{"slug":227,"title":228},"sam4s-giant-100","Sam4S Giant - 100",{"slug":230,"title":231},"citizen-ct-s310ii","Citizen CT-S310II",{"slug":233,"title":234},"epson-tm-t20","Epson TM-T20",{"slug":236,"title":237},"drivers-genericos","Drivers Genéricos POS",{"slug":239,"title":240},"epson-tm-t88","Epson TM-T88V",{"slug":242,"title":243},"fiscalberry-windows","Instalar Fiscalberry en Windows",{"slug":245,"title":246},"fiscalberry-linux","Instalar Fiscalberry en Linux",{"slug":248,"title":249},"fiscalberry-android","Instalar Fiscalberry en Android",{"title":251,"modules":252},"Extra",[253,256,259,262,265,268,271,274,277,280],{"slug":254,"title":255},"01-faq-solucion-inicial-pantalla-congelada","📖 Manual de Usuario: Solución Inicial si la Pantalla se Congela o no Carga",{"slug":257,"title":258},"03-faq-mozo-reabrir-mesa-anulada","📖 Manual de Usuario: Cómo Reabrir una Mesa Anulada o Cerrada por Error",{"slug":260,"title":261},"05-faq-cajero-emitir-factura-a","📖 Manual de Usuario: Cómo Emitir una Factura A Cargando Datos del Cliente",{"slug":263,"title":264},"06-faq-cajero-ingreso-egreso-cajon","📖 Manual de Usuario: Cómo Registrar Entradas y Salidas de Dinero del Cajón",{"slug":266,"title":267},"07-faq-cajero-activar-medio-pago","📖 Manual de Usuario: Cómo Activar un Medio de Pago que no Aparece al Cobrar",{"slug":269,"title":270},"08-faq-cajero-diferencia-facturado-vs-abiertas","📖 Manual de Usuario: Diferencia entre \"Facturado Total Mesas\" y \"Abiertas Por Usuario\" en Caja",{"slug":272,"title":273},"10-faq-supervisor-cierre-caja-diferencias","📖 Manual de Usuario: Cómo Auditar y Solucionar Diferencias en el Cierre de Caja",{"slug":275,"title":276},"preguntas-frecuentes","Preguntas Frecuentes y Guías Rápidas por Rol",{"slug":278,"title":279},"buchon-bot","Buchón Bot",{"slug":281,"title":282},"troubleshooting-semantico","📖 Guía Única de Resolución de Problemas y Errores (Troubleshooting)"],"uses":{}},{"type":"data","data":[{"slug":1,"title":2,"content":3,"tableOfContents":4,"seo":24,"llmTxtFile":28},"compras-por-mercaderia","Compras por Mercadería","\u003Cdiv id=\"compras-por-mercaderia\">\u003C/div>\n\n\u003Cblockquote>\n\u003Cp>\u003Cstrong>¿Dónde está en el sistema?:\u003C/strong> Menú principal → \u003Cstrong>Reportes\u003C/strong> → \u003Cstrong>Compras por Mercadería\u003C/strong> (debajo del título \u003Cstrong>GASTOS Y COMPRAS\u003C/strong>)\n\u003Cstrong>¿Quién lo usa?:\u003C/strong> Compradores, chefs y encargados de costos\u003C/p>\n\u003C/blockquote>\n\u003Cblockquote>\n\u003Cp>🎯 \u003Cstrong>¿Para qué sirve esto?\u003C/strong>\nTe muestra cuánto compraste de cada mercadería en un período y cuánto pagaste.\nSirve para saber en qué gastás más y cuánto te sale cada kilo o unidad.\u003C/p>\n\u003C/blockquote>\n\u003Cblockquote>\n\u003Cp>⚡ \u003Cstrong>Nota:\u003C/strong> el nombre \u003Cstrong>Mercadería\u003C/strong> depende de cómo lo llame tu comercio. Puede decir \u003Cstrong>Insumo\u003C/strong> o \u003Cstrong>Ítem\u003C/strong>. El menú se llama \u003Cstrong>Compras por\u003C/strong> seguido de ese nombre.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🔑 Antes de empezar\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"antes-de-empezar\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"antes-de-empezar\">\u003C/div>\n\n\u003Cul>\n\u003Cli>Tu usuario tiene que tener el permiso de \u003Cstrong>Reportes premium\u003C/strong> en \u003Ca href=\"/user-guide/permisos-por-rol\">Permisos por Rol\u003C/a>.\u003C/li>\n\u003Cli>Tiene que haber órdenes de compra \u003Cstrong>recepcionadas\u003C/strong>. Mirá \u003Ca href=\"/user-guide/todas-las-ordenes-compra\">Todas las Órdenes de Compra\u003C/a>.\u003C/li>\n\u003Cli>Solo se cuentan las compras que tienen precio cargado.\u003C/li>\n\u003C/ul>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                📍 \u003Cstrong>Paso 1: Entrá a la pantalla\u003C/strong>\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-1-entra-a-la-pantalla\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-1-entra-a-la-pantalla\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/100-reportes/109-00a-menu-grupo-reportes.png\" alt=\"Menú lateral con el grupo Reportes marcado en rojo\">\u003C/p>\n\u003Col>\n\u003Cli>En el menú de la izquierda, tocá \u003Cstrong>Reportes\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/100-reportes/109-00b-menu-opcion-compras-por-mercaderia.png\" alt=\"Opción Compras por Mercadería marcada en rojo debajo de Gastos y Compras\">\u003C/p>\n\u003Col start=\"2\">\n\u003Cli>Tocá \u003Cstrong>Compras por Mercadería\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/100-reportes/109-01-pantalla-compras-por-mercaderia.png\" alt=\"Pantalla con los filtros a la izquierda y la tabla de compras a la derecha\">\u003C/p>\n\u003Cp>A la izquierda están los filtros. A la derecha, el total y la tabla.\u003C/p>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🔎 \u003Cstrong>Paso 2: Elegí qué querés ver\u003C/strong>\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-2-elegi-que-queres-ver\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-2-elegi-que-queres-ver\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/100-reportes/109-02-filtros.png\" alt=\"Panel de filtros con Ordenar Precio o Cantidad, Descendente o Ascendente, Seleccione Producto, las fechas y el botón verde Filtrar\">\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Ordenar\u003C/strong>: \u003Cstrong>Precio\u003C/strong> pone primero lo que más plata te costó. \u003Cstrong>Cantidad\u003C/strong> pone primero lo que más compraste.\u003C/li>\n\u003Cli>\u003Cstrong>Descendente\u003C/strong> / \u003Cstrong>Ascendente\u003C/strong>: de mayor a menor, o de menor a mayor.\u003C/li>\n\u003Cli>\u003Cstrong>Seleccione Producto\u003C/strong>: mirá una sola mercadería.\u003C/li>\n\u003Cli>\u003Cstrong>Created From\u003C/strong> y \u003Cstrong>Created To\u003C/strong>: el período. En pantalla dicen así, en inglés. Son el &quot;desde&quot; y el &quot;hasta&quot;. Debajo dice cuántos días son.\u003C/li>\n\u003Cli>\u003Cstrong>Filtrar\u003C/strong>: el botón verde. Aplica todo lo que elegiste.\u003C/li>\n\u003C/ul>\n\u003Col>\n\u003Cli>Elegí las fechas.\u003C/li>\n\u003Cli>Tocá \u003Cstrong>Filtrar\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cp>Si no tocás nada, te muestra los últimos 7 días.\u003C/p>\n\u003Cblockquote>\n\u003Cp>💡 \u003Cstrong>Consejo útil:\u003C/strong> si la tabla sale vacía, ampliá el período.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                📊 \u003Cstrong>Paso 3: Leé el resultado\u003C/strong>\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-3-lee-el-resultado\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-3-lee-el-resultado\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/100-reportes/109-03-tabla-resultado-compras.png\" alt=\"Título con el total de compras y tabla con Harina 0000 y Levadura fresca\">\u003C/p>\n\u003Cp>Arriba dice el total: \u003Cstrong>Total de Compras en 28 días\u003C/strong>. Es la suma de todo lo comprado en el período.\u003C/p>\n\u003Cp>Cada renglón es una mercadería. Las columnas dicen:\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Mercadería\u003C/strong>: el nombre.\u003C/li>\n\u003Cli>\u003Cstrong>UM Stock\u003C/strong>: la unidad en que la contás en el depósito. Por ejemplo: \u003Cem>Kilo\u003C/em>.\u003C/li>\n\u003Cli>\u003Cstrong>Cantidad Recibida\u003C/strong>: cuánto llegó de verdad, según las recepciones.\u003C/li>\n\u003Cli>\u003Cstrong>Costo\u003C/strong>: lo que pagaste en total por esa mercadería.\u003C/li>\n\u003Cli>\u003Cstrong>$/Unitario\u003C/strong>: lo que te sale cada unidad de stock.\u003C/li>\n\u003Cli>\u003Cstrong>% Desperdicio\u003C/strong>: la merma que le cargaste al producto.\u003C/li>\n\u003Cli>\u003Cstrong>$/Unitario c/ Desperdicio\u003C/strong>: el precio por unidad ya con la merma. Si no hay merma, es igual al anterior.\u003C/li>\n\u003Cli>\u003Cstrong>Cant x Día\u003C/strong>: la cantidad recibida dividida por los días del período.\u003C/li>\n\u003Cli>\u003Cstrong>Costo x Día\u003C/strong>: el costo dividido por los días del período.\u003C/li>\n\u003C/ul>\n\u003Cp>La tabla sigue el orden que elegiste en \u003Cstrong>Ordenar\u003C/strong> y \u003Cstrong>Descendente / Ascendente\u003C/strong>.\u003C/p>\n\u003Cblockquote>\n\u003Cp>⚠️ \u003Cstrong>Atención:\u003C/strong> las filas no tienen colores. El código calcula una regla de Pareto (verde, amarillo y rojo) pero no la muestra. Si querés saber cuáles son las estrellas, ordená por \u003Cstrong>Precio\u003C/strong> descendente y mirá los primeros.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🔗 \u003Cstrong>Paso 4: Abrí la ficha de una mercadería\u003C/strong>\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-4-abri-la-ficha-de-una-mercaderia\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-4-abri-la-ficha-de-una-mercaderia\">\u003C/div>\n\n\u003Col>\n\u003Cli>En la tabla del Paso 3, tocá el nombre de la mercadería. Está en azul, en la primera columna.\u003C/li>\n\u003Cli>Se abre la ficha del producto.\u003C/li>\n\u003C/ol>\n\u003Cp>Es solo para mirar: no cambia nada.\u003C/p>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                ⚠️ \u003Cstrong>Resolución de Inconvenientes\u003C/strong>\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"resolucion-de-inconvenientes\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"resolucion-de-inconvenientes\">\u003C/div>\n\n\u003Cdiv class=\"table-wrapper\">\u003Ctable>\n\u003Cthead>\n\u003Ctr>\n\u003Cth>Problema\u003C/th>\n\u003Cth>Causa más frecuente\u003C/th>\n\u003Cth>Solución recomendada\u003C/th>\n\u003C/tr>\n\u003C/thead>\n\u003Ctbody>\u003Ctr>\n\u003Ctd>No veo \u003Cstrong>Compras por Mercadería\u003C/strong> en el menú\u003C/td>\n\u003Ctd>Falta el permiso de reportes premium o el módulo de compras\u003C/td>\n\u003Ctd>Pedile al dueño que lo active en \u003Ca href=\"/user-guide/permisos-por-rol\">Permisos por Rol\u003C/a>.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>La tabla sale vacía\u003C/td>\n\u003Ctd>No hay compras recepcionadas en esas fechas\u003C/td>\n\u003Ctd>Ampliá \u003Cstrong>Created From\u003C/strong> y \u003Cstrong>Created To\u003C/strong>. Revisá que las órdenes estén recepcionadas.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>Una compra no aparece\u003C/td>\n\u003Ctd>Se cargó sin precio\u003C/td>\n\u003Ctd>Cargale el precio a la compra.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>La columna \u003Cstrong>UM Stock\u003C/strong> está vacía\u003C/td>\n\u003Ctd>La mercadería no tiene unidad de stock\u003C/td>\n\u003Ctd>Cargala en \u003Ca href=\"/user-guide/mercaderias\">Mercaderías\u003C/a>.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>No encuentro &quot;Filtrar por Rubro&quot;\u003C/td>\n\u003Ctd>Ese filtro no existe\u003C/td>\n\u003Ctd>Usá \u003Cstrong>Seleccione Producto\u003C/strong> para elegir una mercadería.\u003C/td>\n\u003C/tr>\n\u003C/tbody>\u003C/table>\u003C/div>\n",[5,9,12,15,18,21],{"id":6,"title":7,"level":8},"antes-de-empezar","Antes de empezar",2,{"id":10,"title":11,"level":8},"paso-1-entra-a-la-pantalla","Paso 1: Entrá a la pantalla",{"id":13,"title":14,"level":8},"paso-2-elegi-que-queres-ver","Paso 2: Elegí qué querés ver",{"id":16,"title":17,"level":8},"paso-3-lee-el-resultado","Paso 3: Leé el resultado",{"id":19,"title":20,"level":8},"paso-4-abri-la-ficha-de-una-mercaderia","Paso 4: Abrí la ficha de una mercadería",{"id":22,"title":23,"level":8},"resolucion-de-inconvenientes","Resolución de Inconvenientes",{"title":25,"description":26,"keywords":27},"Compras por Mercadería - Manual","¿Dónde está en el sistema?: Menú principal → Reportes → Compras por Mercadería (debajo del título GASTOS Y COMPRAS)\n ¿Quién lo usa?: C...","compras por mercaderia, paxapos, compras por mercadería, tutorial, guía, manual usuario","109-compras-por-mercaderia.txt"],"uses":{"params":["slug"]}}]}
