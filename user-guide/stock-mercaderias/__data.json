{"type":"data","nodes":[null,{"type":"data","data":[{"moduleCategories":1},[2,17,44,53,77,98,110,140,146,173,185,221,250],{"title":3,"modules":4},"Comenzamos",[5,8,11,14],{"slug":6,"title":7},"introduccion","Bienvenido a tu software gastronómico",{"slug":9,"title":10},"iniciar-sesion","Cómo Iniciar Sesión",{"slug":12,"title":13},"recuperar-contrasena","Cómo Recuperar tu Contraseña",{"slug":15,"title":16},"guia-de-inicio-rapido","Guía de Inicio Rápido",{"title":18,"modules":19},"Ventas",[20,23,26,29,32,35,38,41],{"slug":21,"title":22},"salon-de-ventas","Cómo Usar el Salón de Ventas (Adición)",{"slug":24,"title":25},"caja-rapida","Cómo Usar la Caja Rápida (Registradora)",{"slug":27,"title":28},"mozos","Cómo Cargar los Mozos",{"slug":30,"title":31},"clientes","Cómo Gestionar los Clientes",{"slug":33,"title":34},"descuentos","Cómo Configurar Descuentos",{"slug":36,"title":37},"nueva-reserva","Cómo Cargar una Nueva Reserva",{"slug":39,"title":40},"listado-de-reservas","Cómo Usar el Listado de Reservas",{"slug":42,"title":43},"grilla-de-reservas","Cómo Usar la Grilla de Reservas",{"title":45,"modules":46},"Medios de Pago",[47,50],{"slug":48,"title":49},"configuracion-procesadores","Configuración de Procesadores de Pago",{"slug":51,"title":52},"transacciones-mercadopago","Transacciones MercadoPago",{"title":54,"modules":55},"Productos",[56,59,62,65,68,71,74],{"slug":57,"title":58},"menu","Menú de Productos (Carta)",{"slug":60,"title":61},"categorias","Categorías de Productos",{"slug":63,"title":64},"variantes-grupo-sabores","Variantes y Grupos de Sabores",{"slug":66,"title":67},"maestro-de-productos","Maestro de Productos",{"slug":69,"title":70},"subproductos-elaborados","Sub-Productos (Elaborados)",{"slug":72,"title":73},"recetas","Recetas",{"slug":75,"title":76},"analisis-duplicados","Buscar Duplicados",{"title":78,"modules":79},"Compras",[80,83,86,89,92,95],{"slug":81,"title":82},"todas-las-ordenes-compra","Órdenes de Compra",{"slug":84,"title":85},"crear-orden-compra","Crear una Orden de Compra",{"slug":87,"title":88},"ordenes-a-aprobar","Órdenes a aprobar",{"slug":90,"title":91},"mercaderias","Mercaderías",{"slug":93,"title":94},"proveedores","Proveedores",{"slug":96,"title":97},"historial-de-compras","Historial de Compras",{"title":99,"modules":100},"Stock",[101,104,107],{"slug":102,"title":103},"stock-mercaderias","Stock de Mercaderías",{"slug":105,"title":106},"stock-subproductos","Stock de Subproductos",{"slug":108,"title":109},"movimientos-de-stock","Movimientos de Stock",{"title":111,"modules":112},"Finanzas",[113,116,119,122,125,128,131,134,137],{"slug":114,"title":115},"arqueos-de-caja","Arqueos de Caja",{"slug":117,"title":118},"listado-de-cajas","Listado de Cajas",{"slug":120,"title":121},"transacciones-de-cobro","Transacciones de Cobro",{"slug":123,"title":124},"factura-manual","Factura Manual",{"slug":126,"title":127},"resumen-de-deuda","Resumen de Deuda",{"slug":129,"title":130},"pagos","Pagos",{"slug":132,"title":133},"historial-de-facturas","Historial de Facturas",{"slug":135,"title":136},"historico-de-mesas","Histórico de Mesas",{"slug":138,"title":139},"puntos-de-venta-pdv","Puntos de Venta (PDVs)",{"title":141,"modules":142},"Comandero",[143],{"slug":144,"title":145},"comandero","Comandero (pantalla de cocina)",{"title":147,"modules":148},"RRHH",[149,152,155,158,161,164,167,170],{"slug":150,"title":151},"empleados","Empleados",{"slug":153,"title":154},"empleados-trabajando","Empleados Trabajando",{"slug":156,"title":157},"registro-diario-fichaje","Registro Diario de Fichaje",{"slug":159,"title":160},"reporte-mensual-fichaje","Reporte Mensual de Fichaje",{"slug":162,"title":163},"departamentos","Departamentos",{"slug":165,"title":166},"turnos-y-horarios-fichaje","Turnos y Horarios de Fichaje",{"slug":168,"title":169},"sueldos-y-jornales","Sueldos y Jornales",{"slug":171,"title":172},"datos-de-acceso-app","Datos de Acceso a la App de Fichaje",{"title":174,"modules":175},"Reportes",[176,179,182],{"slug":177,"title":178},"tablero-general","Tablero General",{"slug":180,"title":181},"productos-mas-vendidos","Productos Más Vendidos",{"slug":183,"title":184},"compras-por-mercaderia","Compras por Mercadería",{"title":186,"modules":187},"Configuracion",[188,191,194,197,200,203,206,209,212,215,218],{"slug":189,"title":190},"configuracion-general","Configuración general",{"slug":192,"title":193},"impresoras","Cómo cargar las impresoras del local",{"slug":195,"title":196},"perfiles-de-impresion","Cómo usar los perfiles de impresión",{"slug":198,"title":199},"usuarios-del-sistema","Cómo administrar los Usuarios del Sistema",{"slug":201,"title":202},"usuarios-con-pin","Cómo administrar los Usuarios con PIN",{"slug":204,"title":205},"punto-de-venta","🏛️ Trámite en ARCA (con clave fiscal)",{"slug":207,"title":208},"permisos-por-rol","Cómo configurar los Permisos por Rol",{"slug":210,"title":211},"turnos-mesa","Turnos de Mesa",{"slug":213,"title":214},"medios-de-cobro","Medios de cobro",{"slug":216,"title":217},"clasificacion-de-gastos","Clasificación de Gastos",{"slug":219,"title":220},"centros-de-costo","Centros de Costo",{"title":222,"modules":223},"Biblioteca de Drivers",[224,226,229,232,235,238,241,244,247],{"slug":225,"title":222},"biblioteca-de-drivers",{"slug":227,"title":228},"sam4s-giant-100","Sam4S Giant - 100",{"slug":230,"title":231},"citizen-ct-s310ii","Citizen CT-S310II",{"slug":233,"title":234},"epson-tm-t20","Epson TM-T20",{"slug":236,"title":237},"drivers-genericos","Drivers Genéricos POS",{"slug":239,"title":240},"epson-tm-t88","Epson TM-T88V",{"slug":242,"title":243},"fiscalberry-windows","Instalar Fiscalberry en Windows",{"slug":245,"title":246},"fiscalberry-linux","Instalar Fiscalberry en Linux",{"slug":248,"title":249},"fiscalberry-android","Instalar Fiscalberry en Android",{"title":251,"modules":252},"Extra",[253,256,259,262,265,268,271,274,277,280],{"slug":254,"title":255},"01-faq-solucion-inicial-pantalla-congelada","📖 Manual de Usuario: Solución Inicial si la Pantalla se Congela o no Carga",{"slug":257,"title":258},"03-faq-mozo-reabrir-mesa-anulada","📖 Manual de Usuario: Cómo Reabrir una Mesa Anulada o Cerrada por Error",{"slug":260,"title":261},"05-faq-cajero-emitir-factura-a","📖 Manual de Usuario: Cómo Emitir una Factura A Cargando Datos del Cliente",{"slug":263,"title":264},"06-faq-cajero-ingreso-egreso-cajon","📖 Manual de Usuario: Cómo Registrar Entradas y Salidas de Dinero del Cajón",{"slug":266,"title":267},"07-faq-cajero-activar-medio-pago","📖 Manual de Usuario: Cómo Activar un Medio de Pago que no Aparece al Cobrar",{"slug":269,"title":270},"08-faq-cajero-diferencia-facturado-vs-abiertas","📖 Manual de Usuario: Diferencia entre \"Facturado Total Mesas\" y \"Abiertas Por Usuario\" en Caja",{"slug":272,"title":273},"10-faq-supervisor-cierre-caja-diferencias","📖 Manual de Usuario: Cómo Auditar y Solucionar Diferencias en el Cierre de Caja",{"slug":275,"title":276},"preguntas-frecuentes","Preguntas Frecuentes y Guías Rápidas por Rol",{"slug":278,"title":279},"buchon-bot","Buchón Bot",{"slug":281,"title":282},"troubleshooting-semantico","📖 Guía Única de Resolución de Problemas y Errores (Troubleshooting)"],"uses":{}},{"type":"data","data":[{"slug":1,"title":2,"content":3,"tableOfContents":4,"seo":33,"llmTxtFile":37},"stock-mercaderias","Stock de Mercaderías","\u003Cdiv id=\"stock-de-mercaderias\">\u003C/div>\n\n\u003Cblockquote>\n\u003Cp>\u003Cstrong>¿Dónde está en el sistema?:\u003C/strong> Menú principal → \u003Cstrong>Stock\u003C/strong> → \u003Cstrong>Inventario\u003C/strong> → \u003Cstrong>Stock Mercaderías\u003C/strong>\n\u003Cstrong>¿Quién lo usa?:\u003C/strong> Depósito y encargados de compras\u003C/p>\n\u003C/blockquote>\n\u003Cblockquote>\n\u003Cp>🎯 \u003Cstrong>¿Para qué sirve esto?\u003C/strong>\nAcá ves cuánto te queda de cada cosa que le comprás a un proveedor. Por ejemplo: cuántos kilos de \u003Cem>Harina 0000\u003C/em> hay en el depósito.\nTambién cargás qué mercaderías querés controlar, el mínimo que no querés perforar y los conteos del depósito.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🔑 Antes de empezar\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"antes-de-empezar\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"antes-de-empezar\">\u003C/div>\n\n\u003Cul>\n\u003Cli>Tu usuario tiene que tener el permiso de \u003Cstrong>Stock\u003C/strong> en \u003Ca href=\"/user-guide/permisos-por-rol\">Permisos por Rol\u003C/a>.\u003C/li>\n\u003Cli>La mercadería tiene que estar cargada. Mirá \u003Ca href=\"/user-guide/mercaderias\">Mercaderías\u003C/a>.\u003C/li>\n\u003C/ul>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                📍 Paso 1: Entrá a la pantalla\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-1-entra-a-la-pantalla\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-1-entra-a-la-pantalla\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/60-stock/62-00a-menu-grupo-stock.png\" alt=\"Menú lateral con el grupo Stock marcado en rojo\">\u003C/p>\n\u003Col>\n\u003Cli>En el menú de la izquierda, tocá \u003Cstrong>Stock\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/60-stock/62-00b-menu-opcion-stock-mercaderias.png\" alt=\"Opción Stock Mercaderías marcada en rojo, debajo de Inventario\">\u003C/p>\n\u003Col start=\"2\">\n\u003Cli>Tocá \u003Cstrong>Stock Mercaderías\u003C/strong>. Está debajo del título \u003Cstrong>INVENTARIO\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/60-stock/62-01-pantalla-stock-mercaderias.png\" alt=\"Pantalla Stock de Mercaderias con el buscador arriba y la lista con Harina 0000 y Levadura fresca\">\u003C/p>\n\u003Cp>Así se ve la pantalla. Cada renglón es una mercadería que tiene el stock controlado. Las columnas dicen:\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Depósito\u003C/strong>: dónde está guardada. Por ejemplo: \u003Cem>Depósito Central\u003C/em>.\u003C/li>\n\u003Cli>\u003Cstrong>Mercadería\u003C/strong>: el nombre. Tocalo para ver la ficha del producto.\u003C/li>\n\u003Cli>\u003Cstrong>PU Ult. Compra\u003C/strong> y \u003Cstrong>Fecha Ult. Compra\u003C/strong>: cuánto la pagaste la última vez y cuándo.\u003C/li>\n\u003Cli>\u003Cstrong>U/M de Compra\u003C/strong>: cómo te la vende el proveedor. Por ejemplo: \u003Cem>Bolsa\u003C/em>.\u003C/li>\n\u003Cli>\u003Cstrong>U/M de Stock\u003C/strong>: cómo la contás en el depósito. Por ejemplo: \u003Cem>Kilo\u003C/em>.\u003C/li>\n\u003Cli>\u003Cstrong>fecha inicio\u003C/strong> y \u003Cstrong>cantidad inicial\u003C/strong>: cuándo empezaste a controlarla y cuánto había ese día.\u003C/li>\n\u003Cli>\u003Cstrong>cant en stock\u003C/strong>: cuánto hay ahora. Es la cantidad inicial más lo que entró, menos lo que salió.\u003C/li>\n\u003Cli>\u003Cstrong>Nivel minimo de stock\u003C/strong>: por debajo de ese número te conviene volver a comprar.\u003C/li>\n\u003Cli>\u003Cstrong>acciones\u003C/strong>: los botones de cada renglón (Paso 5).\u003C/li>\n\u003C/ul>\n\u003Cblockquote>\n\u003Cp>💡 \u003Cstrong>Consejo útil:\u003C/strong> tocá el título de una columna para ordenar la lista. Por ejemplo, tocá \u003Cstrong>cant en stock\u003C/strong> para ver primero lo que tiene menos.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🔎 Paso 2: Buscá una mercadería\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-2-busca-una-mercaderia\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-2-busca-una-mercaderia\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/60-stock/62-04-panel-busqueda.png\" alt=\"Recuadro de búsqueda con Harina escrito, los depósitos, los rubros, los proveedores y el botón azul Buscar\">\u003C/p>\n\u003Cp>En el recuadro de búsqueda tenés:\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Buscar por Nombre\u003C/strong>: escribí parte del nombre. Por ejemplo: \u003Cem>Harina\u003C/em>.\u003C/li>\n\u003Cli>\u003Cstrong>Seleccione Depósito\u003C/strong>: mostrá solo lo que está en un depósito.\u003C/li>\n\u003Cli>\u003Cstrong>Seleccione Rubro\u003C/strong>: mostrá solo un rubro. Por ejemplo: \u003Cem>Almacén\u003C/em>.\u003C/li>\n\u003Cli>\u003Cstrong>Seleccione Proveedor\u003C/strong>: mostrá solo lo que le comprás a un proveedor.\u003C/li>\n\u003Cli>\u003Cstrong>Buscar\u003C/strong>: el botón azul de abajo, que aplica la búsqueda.\u003C/li>\n\u003C/ul>\n\u003Col>\n\u003Cli>Completá lo que necesites y tocá \u003Cstrong>Buscar\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/60-stock/62-05-resultado-busqueda.png\" alt=\"Lista con un solo renglón: Harina 0000 x 25 kg, con 68 kilos en stock\">\u003C/p>\n\u003Col start=\"2\">\n\u003Cli>La lista muestra solo las que coinciden.\u003C/li>\n\u003C/ol>\n\u003Cblockquote>\n\u003Cp>💡 \u003Cstrong>Consejo útil:\u003C/strong> la casilla \u003Cstrong>Search\u003C/strong> de arriba de la lista busca al instante entre los renglones que ya ves, sin tocar \u003Cstrong>Buscar\u003C/strong>.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                ➕ Paso 3: Empezá a controlar el stock de una mercadería\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-3-empeza-a-controlar-el-stock-de-una-mercaderia\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-3-empeza-a-controlar-el-stock-de-una-mercaderia\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/60-stock/62-02-donde-esta-boton-stockear-mercaderia.png\" alt=\"Pantalla Stock de Mercaderias con el botón verde Stockear Mercaderia marcado en rojo arriba a la derecha\">\u003C/p>\n\u003Col>\n\u003Cli>Tocá el botón verde \u003Cstrong>Stockear Mercaderia\u003C/strong>, arriba a la derecha.\u003C/li>\n\u003Cli>Se abre una ventanita con los datos para completar.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/60-stock/62-03-formulario-stockear.png\" alt=\"Ventanita Formulario Stokear Producto completa con Harina 0000 x 25 kg, Depósito Central, 50, 10, la fecha y el botón Guardar\">\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Compras Mercaderia\u003C/strong>: escribí parte del nombre y tocalo en la lista. Por ejemplo: \u003Cem>Harina 0000 x 25 kg\u003C/em>.\u003C/li>\n\u003Cli>\u003Cstrong>Deposito\u003C/strong>: dónde la guardás. Por ejemplo: \u003Cem>Depósito Central\u003C/em>.\u003C/li>\n\u003Cli>\u003Cstrong>Cant Inicial\u003C/strong>: cuánto hay hoy, contado en la unidad de stock. Por ejemplo: \u003Cem>50\u003C/em> kilos.\u003C/li>\n\u003Cli>\u003Cstrong>Stock Minimo\u003C/strong>: el número que no querés perforar. Por ejemplo: \u003Cem>10\u003C/em>.\u003C/li>\n\u003Cli>\u003Cstrong>Fecha\u003C/strong>: desde cuándo la controlás. Ya viene con la fecha y hora de hoy.\u003C/li>\n\u003C/ul>\n\u003Col start=\"3\">\n\u003Cli>Tocá el botón verde \u003Cstrong>Guardar\u003C/strong>.\u003C/li>\n\u003Cli>La mercadería aparece en la lista.\u003C/li>\n\u003C/ol>\n\u003Cblockquote>\n\u003Cp>💡 \u003Cstrong>Consejo útil:\u003C/strong> antes de stockear, buscala en esta pantalla (Paso 2). Si ya está, no la cargues de nuevo: quedaría repetida.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🧰 Paso 4: Conocé los botones de cada renglón\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-4-conoce-los-botones-de-cada-renglon\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-4-conoce-los-botones-de-cada-renglon\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/60-stock/62-06-botones-del-renglon.png\" alt=\"Botones de un renglón: Reinicializar en azul y Acciones con una flechita\">\u003C/p>\n\u003Cp>A la derecha de cada renglón hay dos botones:\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Reinicializar\u003C/strong>: cargá lo que contaste en el depósito (Paso 7).\u003C/li>\n\u003Cli>\u003Cstrong>Acciones\u003C/strong>: abre una lista con más opciones.\u003C/li>\n\u003C/ul>\n\u003Cp>\u003Cimg src=\"/images/manual/60-stock/62-07-menu-acciones.png\" alt=\"Lista Acciones abierta con Agregar Precio Unitario, Editar nivel minimo de Stock, Ver, Editar, Agregar Movimiento y Cerrar\">\u003C/p>\n\u003Cp>Al tocar \u003Cstrong>Acciones\u003C/strong> se abre esta lista:\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Agregar Precio Unitario\u003C/strong>: cargá el costo de la mercadería.\u003C/li>\n\u003Cli>\u003Cstrong>Editar nivel minimo de Stock\u003C/strong>: cambiá el mínimo (Paso 6).\u003C/li>\n\u003Cli>\u003Cstrong>Ver\u003C/strong>: mirá el stock y todo lo que entró y salió (Paso 5).\u003C/li>\n\u003Cli>\u003Cstrong>Editar\u003C/strong>: corregí el depósito, la cantidad inicial o el mínimo.\u003C/li>\n\u003Cli>\u003Cstrong>Agregar Movimiento\u003C/strong>: sumá o restá una cantidad a mano (Paso 5).\u003C/li>\n\u003Cli>\u003Cstrong>Cerrar\u003C/strong>: deja de controlar el stock de esa mercadería.\u003C/li>\n\u003C/ul>\n\u003Cblockquote>\n\u003Cp>⚠️ \u003Cstrong>Atención:\u003C/strong> \u003Cstrong>Cerrar\u003C/strong> saca la mercadería de esta lista. El sistema te pregunta si estás seguro. Usalo solo si ya no querés controlarla.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                👁️ Paso 5: Mirá lo que entró y salió, y sumá o restá a mano\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-5-mira-lo-que-entro-y-salio\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-5-mira-lo-que-entro-y-salio\">\u003C/div>\n\n\u003Col>\n\u003Cli>Tocá \u003Cstrong>Acciones\u003C/strong> y después \u003Cstrong>Ver\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/60-stock/62-08-ventana-ver.png\" alt=\"Ventanita Ver de Harina 0000 x 25 kg: Stock Actual 68 kilos, Stock Inicial 50, Ubicación Depósito Central y el Historial de Movimientos\">\u003C/p>\n\u003Col start=\"2\">\n\u003Cli>Se abre una ventanita con:\u003Cul>\n\u003Cli>\u003Cstrong>Stock Actual\u003C/strong>: lo que hay ahora. Por ejemplo: \u003Cem>68 Kilos\u003C/em>.\u003C/li>\n\u003Cli>\u003Cstrong>Stock Inicial\u003C/strong>: lo que había cuando empezaste a controlarla.\u003C/li>\n\u003Cli>\u003Cstrong>Ubicación\u003C/strong>: el depósito.\u003C/li>\n\u003Cli>\u003Cstrong>Historial de Movimientos\u003C/strong>: cada entrada (en verde, con \u003Cstrong>+\u003C/strong>) y cada salida (en rojo, con \u003Cstrong>−\u003C/strong>).\u003C/li>\n\u003C/ul>\n\u003C/li>\n\u003C/ol>\n\u003Cp>Si llegó mercadería sin factura o se rompió algo, cargalo a mano:\u003C/p>\n\u003Col start=\"3\">\n\u003Cli>Tocá \u003Cstrong>Acciones\u003C/strong> y después \u003Cstrong>Agregar Movimiento\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/60-stock/62-09-ventana-agregar-movimiento.png\" alt=\"Ventanita Agregar Movimiento de Stock para Harina 0000 x 25 kg con 20, ALTA marcado, la descripción y el botón Guardar\">\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Cant\u003C/strong>: cuánto entra o sale, en la unidad de stock. Por ejemplo: \u003Cem>20\u003C/em> kilos.\u003C/li>\n\u003Cli>\u003Cstrong>ALTA\u003C/strong>: marcalo si la mercadería \u003Cstrong>entra\u003C/strong>.\u003C/li>\n\u003Cli>\u003Cstrong>BAJA\u003C/strong>: marcalo si la mercadería \u003Cstrong>sale\u003C/strong>. Por ejemplo: una bolsa rota.\u003C/li>\n\u003Cli>\u003Cstrong>Descripción\u003C/strong>: contá qué pasó. Por ejemplo: \u003Cem>Llegaron 20 kilos sin factura\u003C/em>.\u003C/li>\n\u003C/ul>\n\u003Col start=\"4\">\n\u003Cli>Tocá \u003Cstrong>Guardar\u003C/strong>. El stock se actualiza al instante.\u003C/li>\n\u003C/ol>\n\u003Cblockquote>\n\u003Cp>💡 \u003Cstrong>Consejo útil:\u003C/strong> las compras recibidas y las ventas mueven el stock solas. Usá \u003Cstrong>Agregar Movimiento\u003C/strong> solo para lo que no pasa por el sistema. Mirá \u003Ca href=\"/user-guide/movimientos-de-stock\">Movimientos de Stock\u003C/a>.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🔔 Paso 6: Cambiá el nivel mínimo\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-6-cambia-el-nivel-minimo\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-6-cambia-el-nivel-minimo\">\u003C/div>\n\n\u003Col>\n\u003Cli>Tocá \u003Cstrong>Acciones\u003C/strong> y después \u003Cstrong>Editar nivel minimo de Stock\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/60-stock/62-10-ventana-nivel-minimo.png\" alt=\"Ventanita Editar nivel minimo de Stock para Harina 0000 x 25 kg, con el casillero Stock Minimo en 10 y el botón Guardar\">\u003C/p>\n\u003Col start=\"2\">\n\u003Cli>En \u003Cstrong>Stock Minimo\u003C/strong>, escribí el nuevo número. Por ejemplo: \u003Cem>10\u003C/em>.\u003C/li>\n\u003Cli>Tocá \u003Cstrong>Guardar\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🔢 Paso 7: Cargá lo que contaste en el depósito\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-7-carga-lo-que-contaste-en-el-deposito\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-7-carga-lo-que-contaste-en-el-deposito\">\u003C/div>\n\n\u003Cp>Hacelo cuando contás la mercadería a mano y el número no coincide con el sistema.\u003C/p>\n\u003Col>\n\u003Cli>Tocá el botón azul \u003Cstrong>Reinicializar\u003C/strong> del renglón.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/60-stock/62-11-ventana-reinicializar.png\" alt=\"Ventanita Reinicializar de Harina 0000 x 25 kg con 63 escrito, el aviso rojo Faltante 5 Kilos, la observación y el botón Guardar\">\u003C/p>\n\u003Col start=\"2\">\n\u003Cli>Arriba ves la \u003Cstrong>Cantidad Inicial\u003C/strong> y el \u003Cstrong>Movimiento Saldo\u003C/strong> (lo que entró menos lo que salió).\u003C/li>\n\u003Cli>En \u003Cstrong>Cantidad Actual en Stock\u003C/strong>, escribí lo que contaste. Por ejemplo: \u003Cem>63\u003C/em>.\u003C/li>\n\u003Cli>Mirá el aviso de abajo:\u003Cul>\n\u003Cli>\u003Cstrong>Stock perfecto!\u003C/strong> en verde: coincide con el sistema.\u003C/li>\n\u003Cli>\u003Cstrong>Faltante\u003C/strong> en rojo: contaste menos de lo que dice el sistema. Por ejemplo: \u003Cem>Faltante: 5 Kilos\u003C/em>.\u003C/li>\n\u003Cli>\u003Cstrong>Sobrante\u003C/strong> en amarillo: contaste más.\u003C/li>\n\u003C/ul>\n\u003C/li>\n\u003Cli>En \u003Cstrong>Observación\u003C/strong>, escribí algo que te ayude a recordarlo. Por ejemplo: \u003Cem>Conteo del lunes\u003C/em>.\u003C/li>\n\u003Cli>Tocá \u003Cstrong>Guardar\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cblockquote>\n\u003Cp>⚠️ \u003Cstrong>Atención:\u003C/strong> al guardar, el stock pasa a ser el número que contaste. El anterior queda en \u003Cstrong>Stock Cerrados\u003C/strong> y no se puede deshacer.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                ⚠️ Resolución de Inconvenientes\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"resolucion-de-inconvenientes\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"resolucion-de-inconvenientes\">\u003C/div>\n\n\u003Cdiv class=\"table-wrapper\">\u003Ctable>\n\u003Cthead>\n\u003Ctr>\n\u003Cth>Problema\u003C/th>\n\u003Cth>Causa más frecuente\u003C/th>\n\u003Cth>Solución recomendada\u003C/th>\n\u003C/tr>\n\u003C/thead>\n\u003Ctbody>\u003Ctr>\n\u003Ctd>\u003Cstrong>La mercadería no aparece en la lista para stockear\u003C/strong>\u003C/td>\n\u003Ctd>No está cargada en Compras.\u003C/td>\n\u003Ctd>Cargala en \u003Ca href=\"/user-guide/mercaderias\">Mercaderías\u003C/a> y volvé a tocar \u003Cstrong>Stockear Mercaderia\u003C/strong>.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>La mercadería aparece dos veces\u003C/strong>\u003C/td>\n\u003Ctd>Se stockeó dos veces.\u003C/td>\n\u003Ctd>Mirá cuál tiene los movimientos con \u003Cstrong>Ver\u003C/strong> y cerrá la otra con \u003Cstrong>Acciones\u003C/strong> → \u003Cstrong>Cerrar\u003C/strong>.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>La cantidad en stock está en negativo\u003C/strong>\u003C/td>\n\u003Ctd>Se vendió o se usó antes de cargar la compra.\u003C/td>\n\u003Ctd>Recibí la compra en \u003Ca href=\"/user-guide/todas-las-ordenes-compra\">Órdenes de Compra\u003C/a> o contá y usá \u003Cstrong>Reinicializar\u003C/strong>.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>El stock sube 25 veces más de lo que compré\u003C/strong>\u003C/td>\n\u003Ctd>La equivalencia entre la unidad de compra y la de stock está mal.\u003C/td>\n\u003Ctd>Revisá \u003Cstrong>Comprás por\u003C/strong>, \u003Cstrong>Contás por\u003C/strong> y \u003Cstrong>Equivalencia\u003C/strong> en \u003Ca href=\"/user-guide/mercaderias\">Mercaderías\u003C/a>.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>La lista está vacía\u003C/strong>\u003C/td>\n\u003Ctd>Todavía no controlás ninguna mercadería, o la búsqueda es muy estricta.\u003C/td>\n\u003Ctd>Borrá lo escrito en el buscador y tocá \u003Cstrong>Buscar\u003C/strong>. Si sigue vacía, usá \u003Cstrong>Stockear Mercaderia\u003C/strong>.\u003C/td>\n\u003C/tr>\n\u003C/tbody>\u003C/table>\u003C/div>\n",[5,9,12,15,18,21,24,27,30],{"id":6,"title":7,"level":8},"antes-de-empezar","Antes de empezar",2,{"id":10,"title":11,"level":8},"paso-1-entra-a-la-pantalla","Paso 1: Entrá a la pantalla",{"id":13,"title":14,"level":8},"paso-2-busca-una-mercaderia","Paso 2: Buscá una mercadería",{"id":16,"title":17,"level":8},"paso-3-empeza-a-controlar-el-stock-de-una-mercaderia","Paso 3: Empezá a controlar el stock de una mercadería",{"id":19,"title":20,"level":8},"paso-4-conoce-los-botones-de-cada-renglon","Paso 4: Conocé los botones de cada renglón",{"id":22,"title":23,"level":8},"paso-5-mira-lo-que-entro-y-salio","Paso 5: Mirá lo que entró y salió, y sumá o restá a mano",{"id":25,"title":26,"level":8},"paso-6-cambia-el-nivel-minimo","Paso 6: Cambiá el nivel mínimo",{"id":28,"title":29,"level":8},"paso-7-carga-lo-que-contaste-en-el-deposito","Paso 7: Cargá lo que contaste en el depósito",{"id":31,"title":32,"level":8},"resolucion-de-inconvenientes","Resolución de Inconvenientes",{"title":34,"description":35,"keywords":36},"Stock de Mercaderías - Manual","¿Dónde está en el sistema?: Menú principal → Stock → Inventario → Stock Mercaderías\n ¿Quién lo usa?: Depósito y encargados de compras","stock mercaderias, paxapos, stock de mercaderías, tutorial, guía, manual usuario","62-stock-mercaderias.txt"],"uses":{"params":["slug"]}}]}
