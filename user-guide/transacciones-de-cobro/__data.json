{"type":"data","nodes":[null,{"type":"data","data":[{"moduleCategories":1},[2,17,44,53,77,98,110,140,146,173,185,221,250],{"title":3,"modules":4},"Comenzamos",[5,8,11,14],{"slug":6,"title":7},"introduccion","Bienvenido a tu software gastronómico",{"slug":9,"title":10},"iniciar-sesion","Cómo Iniciar Sesión",{"slug":12,"title":13},"recuperar-contrasena","Cómo Recuperar tu Contraseña",{"slug":15,"title":16},"guia-de-inicio-rapido","Guía de Inicio Rápido",{"title":18,"modules":19},"Ventas",[20,23,26,29,32,35,38,41],{"slug":21,"title":22},"salon-de-ventas","Cómo Usar el Salón de Ventas (Adición)",{"slug":24,"title":25},"caja-rapida","Cómo Usar la Caja Rápida (Registradora)",{"slug":27,"title":28},"mozos","Cómo Cargar los Mozos",{"slug":30,"title":31},"clientes","Cómo Gestionar los Clientes",{"slug":33,"title":34},"descuentos","Cómo Configurar Descuentos",{"slug":36,"title":37},"nueva-reserva","Cómo Cargar una Nueva Reserva",{"slug":39,"title":40},"listado-de-reservas","Cómo Usar el Listado de Reservas",{"slug":42,"title":43},"grilla-de-reservas","Cómo Usar la Grilla de Reservas",{"title":45,"modules":46},"Medios de Pago",[47,50],{"slug":48,"title":49},"configuracion-procesadores","Configuración de Procesadores de Pago",{"slug":51,"title":52},"transacciones-mercadopago","Transacciones MercadoPago",{"title":54,"modules":55},"Productos",[56,59,62,65,68,71,74],{"slug":57,"title":58},"menu","Menú de Productos (Carta)",{"slug":60,"title":61},"categorias","Categorías de Productos",{"slug":63,"title":64},"variantes-grupo-sabores","Variantes y Grupos de Sabores",{"slug":66,"title":67},"maestro-de-productos","Maestro de Productos",{"slug":69,"title":70},"subproductos-elaborados","Sub-Productos (Elaborados)",{"slug":72,"title":73},"recetas","Recetas",{"slug":75,"title":76},"analisis-duplicados","Buscar Duplicados",{"title":78,"modules":79},"Compras",[80,83,86,89,92,95],{"slug":81,"title":82},"todas-las-ordenes-compra","Órdenes de Compra",{"slug":84,"title":85},"crear-orden-compra","Crear una Orden de Compra",{"slug":87,"title":88},"ordenes-a-aprobar","Órdenes a aprobar",{"slug":90,"title":91},"mercaderias","Mercaderías",{"slug":93,"title":94},"proveedores","Proveedores",{"slug":96,"title":97},"historial-de-compras","Historial de Compras",{"title":99,"modules":100},"Stock",[101,104,107],{"slug":102,"title":103},"stock-mercaderias","Stock de Mercaderías",{"slug":105,"title":106},"stock-subproductos","Stock de Subproductos",{"slug":108,"title":109},"movimientos-de-stock","Movimientos de Stock",{"title":111,"modules":112},"Finanzas",[113,116,119,122,125,128,131,134,137],{"slug":114,"title":115},"arqueos-de-caja","Arqueos de Caja",{"slug":117,"title":118},"listado-de-cajas","Listado de Cajas",{"slug":120,"title":121},"transacciones-de-cobro","Transacciones de Cobro",{"slug":123,"title":124},"factura-manual","Factura Manual",{"slug":126,"title":127},"resumen-de-deuda","Resumen de Deuda",{"slug":129,"title":130},"pagos","Pagos",{"slug":132,"title":133},"historial-de-facturas","Historial de Facturas",{"slug":135,"title":136},"historico-de-mesas","Histórico de Mesas",{"slug":138,"title":139},"puntos-de-venta-pdv","Puntos de Venta (PDVs)",{"title":141,"modules":142},"Comandero",[143],{"slug":144,"title":145},"comandero","Comandero (pantalla de cocina)",{"title":147,"modules":148},"RRHH",[149,152,155,158,161,164,167,170],{"slug":150,"title":151},"empleados","Empleados",{"slug":153,"title":154},"empleados-trabajando","Empleados Trabajando",{"slug":156,"title":157},"registro-diario-fichaje","Registro Diario de Fichaje",{"slug":159,"title":160},"reporte-mensual-fichaje","Reporte Mensual de Fichaje",{"slug":162,"title":163},"departamentos","Departamentos",{"slug":165,"title":166},"turnos-y-horarios-fichaje","Turnos y Horarios de Fichaje",{"slug":168,"title":169},"sueldos-y-jornales","Sueldos y Jornales",{"slug":171,"title":172},"datos-de-acceso-app","Datos de Acceso a la App de Fichaje",{"title":174,"modules":175},"Reportes",[176,179,182],{"slug":177,"title":178},"tablero-general","Tablero General",{"slug":180,"title":181},"productos-mas-vendidos","Productos Más Vendidos",{"slug":183,"title":184},"compras-por-mercaderia","Compras por Mercadería",{"title":186,"modules":187},"Configuracion",[188,191,194,197,200,203,206,209,212,215,218],{"slug":189,"title":190},"configuracion-general","Configuración general",{"slug":192,"title":193},"impresoras","Cómo cargar las impresoras del local",{"slug":195,"title":196},"perfiles-de-impresion","Cómo usar los perfiles de impresión",{"slug":198,"title":199},"usuarios-del-sistema","Cómo administrar los Usuarios del Sistema",{"slug":201,"title":202},"usuarios-con-pin","Cómo administrar los Usuarios con PIN",{"slug":204,"title":205},"punto-de-venta","🏛️ Trámite en ARCA (con clave fiscal)",{"slug":207,"title":208},"permisos-por-rol","Cómo configurar los Permisos por Rol",{"slug":210,"title":211},"turnos-mesa","Turnos de Mesa",{"slug":213,"title":214},"medios-de-cobro","Medios de cobro",{"slug":216,"title":217},"clasificacion-de-gastos","Clasificación de Gastos",{"slug":219,"title":220},"centros-de-costo","Centros de Costo",{"title":222,"modules":223},"Biblioteca de Drivers",[224,226,229,232,235,238,241,244,247],{"slug":225,"title":222},"biblioteca-de-drivers",{"slug":227,"title":228},"sam4s-giant-100","Sam4S Giant - 100",{"slug":230,"title":231},"citizen-ct-s310ii","Citizen CT-S310II",{"slug":233,"title":234},"epson-tm-t20","Epson TM-T20",{"slug":236,"title":237},"drivers-genericos","Drivers Genéricos POS",{"slug":239,"title":240},"epson-tm-t88","Epson TM-T88V",{"slug":242,"title":243},"fiscalberry-windows","Instalar Fiscalberry en Windows",{"slug":245,"title":246},"fiscalberry-linux","Instalar Fiscalberry en Linux",{"slug":248,"title":249},"fiscalberry-android","Instalar Fiscalberry en Android",{"title":251,"modules":252},"Extra",[253,256,259,262,265,268,271,274,277,280],{"slug":254,"title":255},"01-faq-solucion-inicial-pantalla-congelada","📖 Manual de Usuario: Solución Inicial si la Pantalla se Congela o no Carga",{"slug":257,"title":258},"03-faq-mozo-reabrir-mesa-anulada","📖 Manual de Usuario: Cómo Reabrir una Mesa Anulada o Cerrada por Error",{"slug":260,"title":261},"05-faq-cajero-emitir-factura-a","📖 Manual de Usuario: Cómo Emitir una Factura A Cargando Datos del Cliente",{"slug":263,"title":264},"06-faq-cajero-ingreso-egreso-cajon","📖 Manual de Usuario: Cómo Registrar Entradas y Salidas de Dinero del Cajón",{"slug":266,"title":267},"07-faq-cajero-activar-medio-pago","📖 Manual de Usuario: Cómo Activar un Medio de Pago que no Aparece al Cobrar",{"slug":269,"title":270},"08-faq-cajero-diferencia-facturado-vs-abiertas","📖 Manual de Usuario: Diferencia entre \"Facturado Total Mesas\" y \"Abiertas Por Usuario\" en Caja",{"slug":272,"title":273},"10-faq-supervisor-cierre-caja-diferencias","📖 Manual de Usuario: Cómo Auditar y Solucionar Diferencias en el Cierre de Caja",{"slug":275,"title":276},"preguntas-frecuentes","Preguntas Frecuentes y Guías Rápidas por Rol",{"slug":278,"title":279},"buchon-bot","Buchón Bot",{"slug":281,"title":282},"troubleshooting-semantico","📖 Guía Única de Resolución de Problemas y Errores (Troubleshooting)"],"uses":{}},{"type":"data","data":[{"slug":1,"title":2,"content":3,"tableOfContents":4,"seo":27,"llmTxtFile":31},"transacciones-de-cobro","Transacciones de Cobro","\u003Cdiv id=\"transacciones-de-cobro\">\u003C/div>\n\n\u003Cblockquote>\n\u003Cp>\u003Cstrong>¿Dónde está en el sistema?:\u003C/strong> Menú principal → \u003Cstrong>Finanzas\u003C/strong> → \u003Cstrong>Ingresos y Cobros\u003C/strong> → \u003Cstrong>Transacciones de Cobro\u003C/strong>\n\u003Cstrong>¿Quién lo usa?:\u003C/strong> Cajeros, encargados y contadores\u003C/p>\n\u003C/blockquote>\n\u003Cblockquote>\n\u003Cp>🎯 \u003Cstrong>¿Para qué sirve esto?\u003C/strong>\nAcá ves todos los cobros que entraron al comercio, uno por renglón. Podés buscar por fecha, por medio de pago o por mesa.\nTambién podés abrir un cobro para ver el detalle, o corregir con qué pagó el cliente.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🔑 Antes de empezar\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"antes-de-empezar\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"antes-de-empezar\">\u003C/div>\n\n\u003Cul>\n\u003Cli>Tu usuario tiene que tener alguno de estos dos permisos en \u003Ca href=\"/user-guide/permisos-por-rol\">Permisos por Rol\u003C/a>: \u003Cstrong>Configuración de Cobros\u003C/strong> (módulo Sistema) o \u003Cstrong>Contabilidad / Gastos\u003C/strong> (módulo Finanzas).\u003C/li>\n\u003Cli>Para corregir el medio de un cobro, también necesitás el permiso de cajero.\u003C/li>\n\u003Cli>Esta pantalla \u003Cstrong>no reimprime tickets\u003C/strong>. Para eso mirá \u003Ca href=\"/user-guide/historico-de-mesas\">Histórico de Mesas\u003C/a>.\u003C/li>\n\u003C/ul>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                📍 Paso 1: Entrá a la pantalla\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-1-entra-a-la-pantalla\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-1-entra-a-la-pantalla\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/70-finanzas/74-00a-menu-grupo-finanzas.png\" alt=\"Menú lateral con el grupo Finanzas marcado en rojo\">\u003C/p>\n\u003Col>\n\u003Cli>En el menú de la izquierda, tocá \u003Cstrong>Finanzas\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/70-finanzas/74-00b-menu-opcion-transacciones-de-cobro.png\" alt=\"Opción Transacciones de Cobro marcada en rojo, debajo del título Ingresos y Cobros\">\u003C/p>\n\u003Col start=\"2\">\n\u003Cli>Tocá \u003Cstrong>Transacciones de Cobro\u003C/strong>. Está debajo del título \u003Cstrong>INGRESOS Y COBROS\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/70-finanzas/74-01-pantalla-lista-de-cobros.png\" alt=\"Pantalla Listado de Cobros con el panel de filtros arriba y la lista de cobros abajo\">\u003C/p>\n\u003Cp>Se abre el \u003Cstrong>Listado de Cobros\u003C/strong>. Arriba tenés los filtros. Abajo, un renglón por cada cobro. Las columnas dicen:\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Fecha\u003C/strong>: cuándo se cobró.\u003C/li>\n\u003Cli>\u003Cstrong>Arqueo\u003C/strong>: en qué caja quedó. Tocá el número para abrirla.\u003C/li>\n\u003Cli>\u003Cstrong>Mesa\u003C/strong>: de qué mesa es. Tocá el número para verla.\u003C/li>\n\u003Cli>\u003Cstrong>Tipo de Pago\u003C/strong>: con qué pagó el cliente. Por ejemplo: \u003Cem>Tarjeta Amex\u003C/em>.\u003C/li>\n\u003Cli>\u003Cstrong>Instrumento\u003C/strong>, \u003Cstrong>Procesador\u003C/strong> y \u003Cstrong>Canal\u003C/strong>: datos técnicos del medio de pago.\u003C/li>\n\u003Cli>\u003Cstrong>Monto\u003C/strong>: cuánto se cobró.\u003C/li>\n\u003Cli>\u003Cstrong>Estado\u003C/strong>: por ejemplo, \u003Cstrong>Aprobado\u003C/strong>.\u003C/li>\n\u003Cli>\u003Cstrong>Creado por\u003C/strong>: quién cargó el cobro. Si lo hizo el sistema, dice \u003Cem>\u003Ca href=\"mailto:paxapos@paxapos.com\">paxapos@paxapos.com\u003C/a>\u003C/em>.\u003C/li>\n\u003Cli>\u003Cstrong>Acciones\u003C/strong>: los botones del renglón (Paso 3 y Paso 5).\u003C/li>\n\u003C/ul>\n\u003Cblockquote>\n\u003Cp>💡 \u003Cstrong>Consejo útil:\u003C/strong> tocá el título de una columna para ordenar la lista por esa columna.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🔎 Paso 2: Buscá un cobro\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-2-busca-un-cobro\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-2-busca-un-cobro\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/70-finanzas/74-02-panel-de-filtros.png\" alt=\"Panel de filtros completo con fechas, estado Aprobado, montos y los botones Filtrar y Limpiar\">\u003C/p>\n\u003Cp>En el panel de arriba tenés estos casilleros:\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Desde\u003C/strong> y \u003Cstrong>Hasta\u003C/strong> (las dos primeras fechas): elegí el período que querés ver.\u003C/li>\n\u003Cli>\u003Cstrong>Todos los estados\u003C/strong>: mostrá solo los cobros \u003Cstrong>Aprobado\u003C/strong>, \u003Cstrong>Rechazado\u003C/strong>, \u003Cstrong>Pendiente\u003C/strong>, etc.\u003C/li>\n\u003Cli>\u003Cstrong>ID Mesa\u003C/strong>: escribí el número interno de la mesa.\u003C/li>\n\u003Cli>\u003Cstrong>Todos los instrumentos\u003C/strong>: tarjeta, alias, efectivo, etc.\u003C/li>\n\u003Cli>\u003Cstrong>Todos los procesadores\u003C/strong>: el banco o la empresa que procesó el pago.\u003C/li>\n\u003Cli>\u003Cstrong>Todos los canales\u003C/strong>: por dónde entró el cobro (link de pago, QR, carga manual).\u003C/li>\n\u003Cli>\u003Cstrong>Todos los tipos de pago\u003C/strong>: por ejemplo \u003Cem>Tarjeta Visa\u003C/em> o \u003Cem>Transferencia bancaria\u003C/em>.\u003C/li>\n\u003Cli>\u003Cstrong>Monto desde\u003C/strong> y \u003Cstrong>Monto hasta\u003C/strong>: buscá cobros entre dos importes. Por ejemplo, de \u003Cem>100\u003C/em> a \u003Cem>5000\u003C/em>.\u003C/li>\n\u003Cli>\u003Cstrong>Filtrar\u003C/strong>: el botón azul. Aplica lo que completaste.\u003C/li>\n\u003Cli>\u003Cstrong>Limpiar\u003C/strong>: borra todos los filtros y muestra todo otra vez.\u003C/li>\n\u003C/ul>\n\u003Col>\n\u003Cli>Completá solo lo que necesites. Lo que dejás sin tocar no filtra.\u003C/li>\n\u003Cli>Tocá \u003Cstrong>Filtrar\u003C/strong>.\u003C/li>\n\u003Cli>La lista muestra solo los cobros que coinciden.\u003C/li>\n\u003C/ol>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                👁 Paso 3: Abrí el detalle de un cobro\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-3-abri-el-detalle-de-un-cobro\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-3-abri-el-detalle-de-un-cobro\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/70-finanzas/74-03-donde-esta-botones-del-renglon.png\" alt=\"Lista de cobros con los botones del ojo y del lápiz del primer renglón marcados en rojo, en la columna Acciones\">\u003C/p>\n\u003Cp>A la derecha de cada cobro, en \u003Cstrong>Acciones\u003C/strong>, hay dos botones:\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Ojo\u003C/strong> 👁: abre el detalle del cobro.\u003C/li>\n\u003Cli>\u003Cstrong>Lápiz\u003C/strong> ✏️: corrige con qué pagó el cliente (Paso 5). Aparece solo en algunos cobros.\u003C/li>\n\u003C/ul>\n\u003Col>\n\u003Cli>Tocá el \u003Cstrong>ojo\u003C/strong> 👁 del cobro que querés ver.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/70-finanzas/74-05-pantalla-detalle-del-cobro.png\" alt=\"Detalle de la transacción con los recuadros de información general, monto, método de pago y relaciones\">\u003C/p>\n\u003Cp>Se abre la pantalla \u003Cstrong>Transacción de Pago\u003C/strong>. Arriba a la derecha tiene dos botones:\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Corregir el medio\u003C/strong>: el naranja. Corrige con qué pagó el cliente (Paso 5).\u003C/li>\n\u003Cli>\u003Cstrong>Volver al listado\u003C/strong>: vuelve a la lista de cobros.\u003C/li>\n\u003C/ul>\n\u003Cp>Y abajo, estos recuadros:\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Información General\u003C/strong>: el número del cobro, el estado, la fecha y la referencia.\u003C/li>\n\u003Cli>\u003Cstrong>Detalles de Monto\u003C/strong>: el monto base, la comisión si hay y el monto total.\u003C/li>\n\u003Cli>\u003Cstrong>Método de Pago\u003C/strong>: procesador, canal e instrumento.\u003C/li>\n\u003Cli>\u003Cstrong>Relaciones\u003C/strong>: la mesa, la caja (arqueo) y quién cargó el cobro.\u003C/li>\n\u003Cli>\u003Cstrong>Correcciones del medio\u003C/strong>: aparece solo si alguien ya cambió el medio de este cobro.\u003C/li>\n\u003C/ul>\n\u003Cp>En cobros con tarjeta, QR o link de pago, abajo aparecen también dos recuadros con datos técnicos (\u003Cstrong>Datos de Request\u003C/strong> y \u003Cstrong>Datos de Response\u003C/strong>). Son para soporte técnico: no hace falta leerlos.\u003C/p>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🔗 Paso 4: Andá a la mesa o a la caja del cobro\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-4-anda-a-la-mesa-o-a-la-caja-del-cobro\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-4-anda-a-la-mesa-o-a-la-caja-del-cobro\">\u003C/div>\n\n\u003Cp>Usá la misma pantalla del Paso 3.\u003C/p>\n\u003Col>\n\u003Cli>\u003Cp>En el recuadro \u003Cstrong>Relaciones\u003C/strong>, tocá el botón azul de \u003Cstrong>Mesa\u003C/strong>. Por ejemplo: \u003Cstrong>#13rf\u003C/strong>.\u003C/p>\n\u003C/li>\n\u003Cli>\u003Cp>Se abre la mesa con todo lo que se consumió.\u003C/p>\n\u003C/li>\n\u003Cli>\u003Cp>Volvé y tocá el botón verde \u003Cstrong>Arqueo #99\u003C/strong>. El número puede ser otro.\u003C/p>\n\u003C/li>\n\u003Cli>\u003Cp>Se abre la caja donde quedó este cobro. Más en \u003Ca href=\"/user-guide/arqueos-de-caja\">Arqueos de Caja\u003C/a>.\u003C/p>\n\u003C/li>\n\u003Cli>\u003Cp>Para regresar a la lista, tocá \u003Cstrong>Volver al listado\u003C/strong>, arriba a la derecha.\u003C/p>\n\u003C/li>\n\u003C/ol>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                ✏️ Paso 5: Corregí con qué pagó el cliente\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-5-corregi-con-que-pago-el-cliente\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-5-corregi-con-que-pago-el-cliente\">\u003C/div>\n\n\u003Cp>Sirve cuando se cargó mal el medio. Por ejemplo, se anotó \u003Cem>Tarjeta Amex\u003C/em> y pagó con \u003Cem>Tarjeta Visa\u003C/em>.\u003C/p>\n\u003Cp>Solo se puede corregir un cobro \u003Cstrong>cargado a mano\u003C/strong> y cuya caja \u003Cstrong>sigue abierta\u003C/strong>. Los cobros de Mercado Pago, QR o link de pago no se tocan: los fijó el procesador.\u003C/p>\n\u003Col>\n\u003Cli>Si el cobro se puede corregir, en la lista ves un \u003Cstrong>lápiz\u003C/strong> ✏️ al lado del ojo (Paso 3). Tocalo.\u003C/li>\n\u003Cli>También podés abrir el detalle y tocar el botón naranja \u003Cstrong>Corregir el medio\u003C/strong>, arriba a la derecha.\u003C/li>\n\u003Cli>Se abre la pantalla \u003Cstrong>Corregir el medio de cobro\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/70-finanzas/74-11-formulario-corregir-el-medio.png\" alt=\"Pantalla completa con los datos del cobro, la lista de medios y los botones Corregir el medio y Cancelar\">\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Cobro a corregir\u003C/strong>: repasá la fecha, el monto, la mesa, el medio actual y la caja.\u003C/li>\n\u003Cli>\u003Cstrong>¿Con qué pagó realmente?\u003C/strong>: elegí el medio correcto. El que ya tiene está en gris y no se puede elegir.\u003C/li>\n\u003Cli>\u003Cstrong>Corregir el medio\u003C/strong>: el botón azul que confirma el cambio.\u003C/li>\n\u003Cli>\u003Cstrong>Cancelar\u003C/strong>: sale sin cambiar nada.\u003C/li>\n\u003C/ul>\n\u003Cblockquote>\n\u003Cp>⚠️ \u003Cstrong>Atención:\u003C/strong> al tocar \u003Cstrong>Corregir el medio\u003C/strong> el cobro queda con el medio nuevo. El cambio se anota en el detalle y cambia lo que se espera en la caja. Verificá bien antes de confirmar.\u003C/p>\n\u003C/blockquote>\n\u003Col start=\"4\">\n\u003Cli>Elegí el medio correcto.\u003C/li>\n\u003Cli>Tocá \u003Cstrong>Corregir el medio\u003C/strong> para guardar, o \u003Cstrong>Cancelar\u003C/strong> para salir.\u003C/li>\n\u003C/ol>\n\u003Cp>Si el cobro no se puede corregir, ves un aviso amarillo y solo el botón \u003Cstrong>Volver\u003C/strong>.\u003C/p>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                ⚠️ ¿Qué hacer si algo no sale bien?\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"que-hacer-si-algo-no-sale-bien\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"que-hacer-si-algo-no-sale-bien\">\u003C/div>\n\n\u003Cdiv class=\"table-wrapper\">\u003Ctable>\n\u003Cthead>\n\u003Ctr>\n\u003Cth>Problema\u003C/th>\n\u003Cth>Causa más frecuente\u003C/th>\n\u003Cth>Solución recomendada\u003C/th>\n\u003C/tr>\n\u003C/thead>\n\u003Ctbody>\u003Ctr>\n\u003Ctd>No veo el lápiz en un cobro.\u003C/td>\n\u003Ctd>El cobro es electrónico o su caja ya está cerrada.\u003C/td>\n\u003Ctd>Solo se corrigen cobros manuales con la caja abierta.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>La pantalla dice que no se puede cambiar el medio.\u003C/td>\n\u003Ctd>El cobro lo procesó Mercado Pago, un QR o un link de pago.\u003C/td>\n\u003Ctd>Pedile ayuda a soporte si el dato está mal.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>La lista sale vacía.\u003C/td>\n\u003Ctd>Los filtros no coinciden con ningún cobro.\u003C/td>\n\u003Ctd>Tocá \u003Cstrong>Limpiar\u003C/strong> y probá con menos filtros.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>Busco el botón \u003Cstrong>Reimprimir\u003C/strong> y no está.\u003C/td>\n\u003Ctd>Esta pantalla no imprime.\u003C/td>\n\u003Ctd>Reimprimí el ticket desde \u003Ca href=\"/user-guide/historico-de-mesas\">Histórico de Mesas\u003C/a>.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>No encuentro un cobro por mesa.\u003C/td>\n\u003Ctd>En \u003Cstrong>ID Mesa\u003C/strong> hay que escribir el número interno.\u003C/td>\n\u003Ctd>Buscá por fecha y monto, y fijate en la columna \u003Cstrong>Mesa\u003C/strong>.\u003C/td>\n\u003C/tr>\n\u003C/tbody>\u003C/table>\u003C/div>\n",[5,9,12,15,18,21,24],{"id":6,"title":7,"level":8},"antes-de-empezar","Antes de empezar",2,{"id":10,"title":11,"level":8},"paso-1-entra-a-la-pantalla","Paso 1: Entrá a la pantalla",{"id":13,"title":14,"level":8},"paso-2-busca-un-cobro","Paso 2: Buscá un cobro",{"id":16,"title":17,"level":8},"paso-3-abri-el-detalle-de-un-cobro","Paso 3: Abrí el detalle de un cobro",{"id":19,"title":20,"level":8},"paso-4-anda-a-la-mesa-o-a-la-caja-del-cobro","Paso 4: Andá a la mesa o a la caja del cobro",{"id":22,"title":23,"level":8},"paso-5-corregi-con-que-pago-el-cliente","Paso 5: Corregí con qué pagó el cliente",{"id":25,"title":26,"level":8},"que-hacer-si-algo-no-sale-bien","¿Qué hacer si algo no sale bien?",{"title":28,"description":29,"keywords":30},"Transacciones de Cobro - Manual","¿Dónde está en el sistema?: Menú principal → Finanzas → Ingresos y Cobros → Transacciones de Cobro\n ¿Quién lo usa?: Cajeros, encargado...","transacciones de cobro, paxapos, transacciones de cobro, tutorial, guía, manual usuario","74-transacciones-de-cobro.txt"],"uses":{"params":["slug"]}}]}
