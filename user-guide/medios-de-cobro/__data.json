{"type":"data","nodes":[null,{"type":"data","data":[{"moduleCategories":1},[2,17,44,53,77,98,110,140,146,173,185,221,250],{"title":3,"modules":4},"Comenzamos",[5,8,11,14],{"slug":6,"title":7},"introduccion","Bienvenido a tu software gastronómico",{"slug":9,"title":10},"iniciar-sesion","Cómo Iniciar Sesión",{"slug":12,"title":13},"recuperar-contrasena","Cómo Recuperar tu Contraseña",{"slug":15,"title":16},"guia-de-inicio-rapido","Guía de Inicio Rápido",{"title":18,"modules":19},"Ventas",[20,23,26,29,32,35,38,41],{"slug":21,"title":22},"salon-de-ventas","Cómo Usar el Salón de Ventas (Adición)",{"slug":24,"title":25},"caja-rapida","Cómo Usar la Caja Rápida (Registradora)",{"slug":27,"title":28},"mozos","Cómo Cargar los Mozos",{"slug":30,"title":31},"clientes","Cómo Gestionar los Clientes",{"slug":33,"title":34},"descuentos","Cómo Configurar Descuentos",{"slug":36,"title":37},"nueva-reserva","Cómo Cargar una Nueva Reserva",{"slug":39,"title":40},"listado-de-reservas","Cómo Usar el Listado de Reservas",{"slug":42,"title":43},"grilla-de-reservas","Cómo Usar la Grilla de Reservas",{"title":45,"modules":46},"Medios de Pago",[47,50],{"slug":48,"title":49},"configuracion-procesadores","Configuración de Procesadores de Pago",{"slug":51,"title":52},"transacciones-mercadopago","Transacciones MercadoPago",{"title":54,"modules":55},"Productos",[56,59,62,65,68,71,74],{"slug":57,"title":58},"menu","Menú de Productos (Carta)",{"slug":60,"title":61},"categorias","Categorías de Productos",{"slug":63,"title":64},"variantes-grupo-sabores","Variantes y Grupos de Sabores",{"slug":66,"title":67},"maestro-de-productos","Maestro de Productos",{"slug":69,"title":70},"subproductos-elaborados","Sub-Productos (Elaborados)",{"slug":72,"title":73},"recetas","Recetas",{"slug":75,"title":76},"analisis-duplicados","Buscar Duplicados",{"title":78,"modules":79},"Compras",[80,83,86,89,92,95],{"slug":81,"title":82},"todas-las-ordenes-compra","Órdenes de Compra",{"slug":84,"title":85},"crear-orden-compra","Crear una Orden de Compra",{"slug":87,"title":88},"ordenes-a-aprobar","Órdenes a aprobar",{"slug":90,"title":91},"mercaderias","Mercaderías",{"slug":93,"title":94},"proveedores","Proveedores",{"slug":96,"title":97},"historial-de-compras","Historial de Compras",{"title":99,"modules":100},"Stock",[101,104,107],{"slug":102,"title":103},"stock-mercaderias","Stock de Mercaderías",{"slug":105,"title":106},"stock-subproductos","Stock de Subproductos",{"slug":108,"title":109},"movimientos-de-stock","Movimientos de Stock",{"title":111,"modules":112},"Finanzas",[113,116,119,122,125,128,131,134,137],{"slug":114,"title":115},"arqueos-de-caja","Arqueos de Caja",{"slug":117,"title":118},"listado-de-cajas","Listado de Cajas",{"slug":120,"title":121},"transacciones-de-cobro","Transacciones de Cobro",{"slug":123,"title":124},"factura-manual","Factura Manual",{"slug":126,"title":127},"resumen-de-deuda","Resumen de Deuda",{"slug":129,"title":130},"pagos","Pagos",{"slug":132,"title":133},"historial-de-facturas","Historial de Facturas",{"slug":135,"title":136},"historico-de-mesas","Histórico de Mesas",{"slug":138,"title":139},"puntos-de-venta-pdv","Puntos de Venta (PDVs)",{"title":141,"modules":142},"Comandero",[143],{"slug":144,"title":145},"comandero","Comandero (pantalla de cocina)",{"title":147,"modules":148},"RRHH",[149,152,155,158,161,164,167,170],{"slug":150,"title":151},"empleados","Empleados",{"slug":153,"title":154},"empleados-trabajando","Empleados Trabajando",{"slug":156,"title":157},"registro-diario-fichaje","Registro Diario de Fichaje",{"slug":159,"title":160},"reporte-mensual-fichaje","Reporte Mensual de Fichaje",{"slug":162,"title":163},"departamentos","Departamentos",{"slug":165,"title":166},"turnos-y-horarios-fichaje","Turnos y Horarios de Fichaje",{"slug":168,"title":169},"sueldos-y-jornales","Sueldos y Jornales",{"slug":171,"title":172},"datos-de-acceso-app","Datos de Acceso a la App de Fichaje",{"title":174,"modules":175},"Reportes",[176,179,182],{"slug":177,"title":178},"tablero-general","Tablero General",{"slug":180,"title":181},"productos-mas-vendidos","Productos Más Vendidos",{"slug":183,"title":184},"compras-por-mercaderia","Compras por Mercadería",{"title":186,"modules":187},"Configuracion",[188,191,194,197,200,203,206,209,212,215,218],{"slug":189,"title":190},"configuracion-general","Configuración general",{"slug":192,"title":193},"impresoras","Cómo cargar las impresoras del local",{"slug":195,"title":196},"perfiles-de-impresion","Cómo usar los perfiles de impresión",{"slug":198,"title":199},"usuarios-del-sistema","Cómo administrar los Usuarios del Sistema",{"slug":201,"title":202},"usuarios-con-pin","Cómo administrar los Usuarios con PIN",{"slug":204,"title":205},"punto-de-venta","🏛️ Trámite en ARCA (con clave fiscal)",{"slug":207,"title":208},"permisos-por-rol","Cómo configurar los Permisos por Rol",{"slug":210,"title":211},"turnos-mesa","Turnos de Mesa",{"slug":213,"title":214},"medios-de-cobro","Medios de cobro",{"slug":216,"title":217},"clasificacion-de-gastos","Clasificación de Gastos",{"slug":219,"title":220},"centros-de-costo","Centros de Costo",{"title":222,"modules":223},"Biblioteca de Drivers",[224,226,229,232,235,238,241,244,247],{"slug":225,"title":222},"biblioteca-de-drivers",{"slug":227,"title":228},"sam4s-giant-100","Sam4S Giant - 100",{"slug":230,"title":231},"citizen-ct-s310ii","Citizen CT-S310II",{"slug":233,"title":234},"epson-tm-t20","Epson TM-T20",{"slug":236,"title":237},"drivers-genericos","Drivers Genéricos POS",{"slug":239,"title":240},"epson-tm-t88","Epson TM-T88V",{"slug":242,"title":243},"fiscalberry-windows","Instalar Fiscalberry en Windows",{"slug":245,"title":246},"fiscalberry-linux","Instalar Fiscalberry en Linux",{"slug":248,"title":249},"fiscalberry-android","Instalar Fiscalberry en Android",{"title":251,"modules":252},"Extra",[253,256,259,262,265,268,271,274,277,280],{"slug":254,"title":255},"01-faq-solucion-inicial-pantalla-congelada","📖 Manual de Usuario: Solución Inicial si la Pantalla se Congela o no Carga",{"slug":257,"title":258},"03-faq-mozo-reabrir-mesa-anulada","📖 Manual de Usuario: Cómo Reabrir una Mesa Anulada o Cerrada por Error",{"slug":260,"title":261},"05-faq-cajero-emitir-factura-a","📖 Manual de Usuario: Cómo Emitir una Factura A Cargando Datos del Cliente",{"slug":263,"title":264},"06-faq-cajero-ingreso-egreso-cajon","📖 Manual de Usuario: Cómo Registrar Entradas y Salidas de Dinero del Cajón",{"slug":266,"title":267},"07-faq-cajero-activar-medio-pago","📖 Manual de Usuario: Cómo Activar un Medio de Pago que no Aparece al Cobrar",{"slug":269,"title":270},"08-faq-cajero-diferencia-facturado-vs-abiertas","📖 Manual de Usuario: Diferencia entre \"Facturado Total Mesas\" y \"Abiertas Por Usuario\" en Caja",{"slug":272,"title":273},"10-faq-supervisor-cierre-caja-diferencias","📖 Manual de Usuario: Cómo Auditar y Solucionar Diferencias en el Cierre de Caja",{"slug":275,"title":276},"preguntas-frecuentes","Preguntas Frecuentes y Guías Rápidas por Rol",{"slug":278,"title":279},"buchon-bot","Buchón Bot",{"slug":281,"title":282},"troubleshooting-semantico","📖 Guía Única de Resolución de Problemas y Errores (Troubleshooting)"],"uses":{}},{"type":"data","data":[{"slug":1,"title":2,"content":3,"tableOfContents":4,"seo":30,"llmTxtFile":34},"medios-de-cobro","Medios de cobro","\u003Cdiv id=\"medios-de-cobro\">\u003C/div>\n\n\u003Cblockquote>\n\u003Cp>\u003Cstrong>¿Dónde está en el sistema?:\u003C/strong> Menú principal → \u003Cstrong>Configuración\u003C/strong> → \u003Cstrong>Medios de cobro\u003C/strong> (debajo del título \u003Cstrong>Tablas del Sistema\u003C/strong>)\n\u003Cstrong>¿Quién lo usa?:\u003C/strong> Administradores y Encargados de Finanzas\u003C/p>\n\u003C/blockquote>\n\u003Cblockquote>\n\u003Cp>🎯 \u003Cstrong>¿Para qué sirve esto?\u003C/strong>\nAcá elegís con qué medios cobra tu cajero a mano: efectivo, tarjetas, transferencia, cheques o vouchers.\nTambién definís cuáles se pueden usar para pagar a proveedores.\nLos pagos por QR, link o SmartPOS no se cargan acá: se registran solos.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🔑 Antes de empezar\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"antes-de-empezar\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"antes-de-empezar\">\u003C/div>\n\n\u003Cul>\n\u003Cli>Tu usuario necesita el permiso de configurar \u003Cstrong>Cobros\u003C/strong>. Fijate en \u003Ca href=\"/user-guide/permisos-por-rol\">Permisos por Rol\u003C/a>.\u003C/li>\n\u003Cli>Esta pantalla \u003Cstrong>guarda sola\u003C/strong>. Apenas tildás una casilla o cambiás un dato de un renglón, queda guardado.\u003C/li>\n\u003Cli>Por eso, tocá con cuidado: el cambio vale en la caja desde ese momento.\u003C/li>\n\u003C/ul>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                📍 Paso 1: Entrá a la pantalla\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-1-entra-a-la-pantalla\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-1-entra-a-la-pantalla\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/110-configuracion/132-00a-menu-grupo-configuracion.png\" alt=\"Menú lateral con el grupo Configuración marcado en rojo\">\u003C/p>\n\u003Col>\n\u003Cli>En el menú de la izquierda, tocá \u003Cstrong>Configuración\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/110-configuracion/132-00b-menu-opcion-medios-de-cobro.png\" alt=\"Opción Medios de cobro marcada en rojo dentro del grupo Configuración\">\u003C/p>\n\u003Col start=\"2\">\n\u003Cli>Tocá \u003Cstrong>Medios de cobro\u003C/strong>. Está debajo del título \u003Cstrong>TABLAS DEL SISTEMA\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                💳 Paso 2: Mirá la pestaña &quot;Para cobrar&quot;\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-2-mira-la-pestana-para-cobrar\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-2-mira-la-pestana-para-cobrar\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/110-configuracion/132-01-pestana-para-cobrar.png\" alt=\"Pantalla Medios de cobro con la pestaña Para cobrar y todos los renglones agrupados\">\u003C/p>\n\u003Cp>Se abre en \u003Cstrong>Para cobrar\u003C/strong>. Muestra los medios que el cajero elige al cobrar. Van agrupados: \u003Cem>Tarjetas de crédito\u003C/em>, \u003Cem>Tarjetas de débito\u003C/em>, \u003Cem>Transferencias\u003C/em>, \u003Cem>Plataformas\u003C/em> y \u003Cem>Otros\u003C/em>.\u003C/p>\n\u003Cp>Cada renglón tiene estas columnas:\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Activo\u003C/strong>: si está tildada, el cajero ve este medio al cobrar. Si la destildás, deja de aparecer.\u003C/li>\n\u003Cli>\u003Cstrong>Ícono\u003C/strong>: el dibujito que se ve en la caja. Lo elige el sistema según \u003Cstrong>¿Qué es?\u003C/strong>.\u003C/li>\n\u003Cli>\u003Cstrong>Nombre\u003C/strong>: cómo lo ve el cajero. Podés cambiarlo. Por ejemplo: \u003Cem>Tarjeta Visa\u003C/em>.\u003C/li>\n\u003Cli>\u003Cstrong>¿Qué es?\u003C/strong>: qué tipo de medio es. Por ejemplo: \u003Cem>Visa crédito\u003C/em> o \u003Cem>Transferencia\u003C/em>. Sirve para los informes.\u003C/li>\n\u003Cli>\u003Cstrong>Abre cajón\u003C/strong>: si está tildada, el cajón de dinero se abre al cobrar con este medio.\u003C/li>\n\u003Cli>\u003Cstrong>Fiscal\u003C/strong>: si está tildada, la factura sale directo al cobrar con este medio.\u003C/li>\n\u003Cli>\u003Cstrong>Proveedores\u003C/strong>: si está tildada, también lo podés usar para pagar a proveedores.\u003C/li>\n\u003Cli>\u003Cstrong>Engranaje\u003C/strong>: abre \u003Cstrong>Más opciones\u003C/strong> (Paso 5).\u003C/li>\n\u003Cli>\u003Cstrong>Papelera\u003C/strong>: borra el medio. Se ve gris apagada cuando no se puede borrar.\u003C/li>\n\u003C/ul>\n\u003Cblockquote>\n\u003Cp>⚠️ \u003Cstrong>Atención:\u003C/strong> cada casilla y cada lista se guardan al instante. Cambiar \u003Cstrong>Abre cajón\u003C/strong> o \u003Cstrong>Fiscal\u003C/strong> cambia cómo se cobra de verdad.\u003C/p>\n\u003C/blockquote>\n\u003Cblockquote>\n\u003Cp>💡 \u003Cstrong>Consejo útil:\u003C/strong> si un renglón dice \u003Cem>Sin clasificar: elegí qué es\u003C/em>, abrí la lista \u003Cstrong>¿Qué es?\u003C/strong> y elegí una opción.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🏦 Paso 3: Mirá la pestaña &quot;Para pagar proveedores&quot;\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-3-mira-la-pestana-para-pagar-proveedores\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-3-mira-la-pestana-para-pagar-proveedores\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/110-configuracion/132-02-pestana-para-pagar-proveedores.png\" alt=\"Pestaña Para pagar proveedores con solo los medios que tienen tildada la casilla Proveedores\">\u003C/p>\n\u003Col>\n\u003Cli>Tocá la pestaña \u003Cstrong>Para pagar proveedores\u003C/strong>.\u003C/li>\n\u003Cli>Ves solo los medios con la casilla \u003Cstrong>Proveedores\u003C/strong> tildada.\u003C/li>\n\u003Cli>Las columnas \u003Cstrong>Abre cajón\u003C/strong> y \u003Cstrong>Fiscal\u003C/strong> no aparecen: acá no se usan.\u003C/li>\n\u003Cli>Para volver, tocá \u003Cstrong>Para cobrar\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cp>Cambiar de pestaña solo filtra lo que ves. No guarda nada.\u003C/p>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                ➕ Paso 4: Agregá un medio personalizado\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-4-agrega-un-medio-personalizado\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-4-agrega-un-medio-personalizado\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/110-configuracion/132-03-donde-esta-boton-agregar-medio-personalizado.png\" alt=\"Pantalla con el botón Agregar medio personalizado marcado en rojo abajo de la tabla\">\u003C/p>\n\u003Col>\n\u003Cli>En la pestaña \u003Cstrong>Para cobrar\u003C/strong>, tocá \u003Cstrong>Agregar medio personalizado\u003C/strong>, abajo de la tabla.\u003C/li>\n\u003Cli>Aparece un renglón nuevo al final.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/110-configuracion/132-04-renglon-nuevo-completo.png\" alt=\"Tabla con un renglón nuevo al final: Prueba Manual, Efectivo y los botones Guardar y Cancelar\">\u003C/p>\n\u003Col start=\"3\">\n\u003Cli>Escribí el \u003Cstrong>Nombre\u003C/strong>. Por ejemplo: \u003Cem>Voucher Empresa X\u003C/em>.\u003C/li>\n\u003Cli>Elegí \u003Cstrong>¿Qué es?\u003C/strong>. Por ejemplo: \u003Cem>Voucher / Vale\u003C/em>.\u003C/li>\n\u003Cli>Tildá las casillas que necesites: \u003Cstrong>Abre cajón\u003C/strong>, \u003Cstrong>Fiscal\u003C/strong>, \u003Cstrong>Proveedores\u003C/strong>.\u003C/li>\n\u003Cli>Tocá \u003Cstrong>Guardar\u003C/strong> para crearlo. Se recarga la pantalla y el medio queda en su grupo.\u003C/li>\n\u003Cli>Si te arrepentís, tocá \u003Cstrong>Cancelar\u003C/strong>. El renglón desaparece y no se crea nada.\u003C/li>\n\u003C/ol>\n\u003Cblockquote>\n\u003Cp>💡 \u003Cstrong>Consejo útil:\u003C/strong> si el cajero no ve el medio nuevo, revisá que la casilla \u003Cstrong>Activo\u003C/strong> esté tildada.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                ⚙️ Paso 5: Abrí &quot;Más opciones&quot;\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-5-abri-mas-opciones\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-5-abri-mas-opciones\">\u003C/div>\n\n\u003Col>\n\u003Cli>Buscá el renglón del medio. A la derecha de cada renglón está el botón azul con la ruedita (el engranaje).\u003C/li>\n\u003Cli>Tocalo. Se abre una pantalla con más datos de ese medio.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/110-configuracion/132-05-formulario-mas-opciones.png\" alt=\"Pantalla Editando Tarjeta Amex con Nombre, Imagen propia, Propinas, Días hasta acreditación, Comisión y los botones Actualizar y Volver\">\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Nombre\u003C/strong>: el nombre del medio.\u003C/li>\n\u003Cli>\u003Cstrong>Imagen propia (opcional)\u003C/strong>: subí una imagen si querés reemplazar el ícono del catálogo. Se ve en la caja, en esta pantalla y en los arqueos.\u003C/li>\n\u003Cli>\u003Cstrong>Propinas\u003C/strong>: tildala si este medio se puede usar para cobrar propinas.\u003C/li>\n\u003Cli>\u003Cstrong>Días hasta acreditación\u003C/strong>: cuántos días tarda en llegarte la plata. Por ejemplo: \u003Cem>2\u003C/em>.\u003C/li>\n\u003Cli>\u003Cstrong>Comisión (%)\u003C/strong>: lo que te descuenta el banco o la plataforma. Por ejemplo: \u003Cem>3,5\u003C/em>.\u003C/li>\n\u003Cli>\u003Cstrong>Actualizar\u003C/strong>: guarda los cambios.\u003C/li>\n\u003Cli>\u003Cstrong>Volver a Medios de cobro\u003C/strong>: vuelve a la tabla sin guardar.\u003C/li>\n\u003C/ul>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🗑️ Borrar un medio\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"borrar-un-medio\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"borrar-un-medio\">\u003C/div>\n\n\u003Cblockquote>\n\u003Cp>⚠️ \u003Cstrong>Atención:\u003C/strong> borrar no se puede deshacer.\u003C/p>\n\u003C/blockquote>\n\u003Cul>\n\u003Cli>La papelera solo funciona en medios sin cobros registrados.\u003C/li>\n\u003Cli>Efectivo nunca se puede borrar.\u003C/li>\n\u003Cli>Si el medio ya se usó, la papelera queda apagada. Al apoyar el mouse te dice cuántos cobros tiene. Destildá \u003Cstrong>Activo\u003C/strong> en su lugar.\u003C/li>\n\u003Cli>Para borrar, tocá la papelera una vez. Cambia a \u003Cstrong>¿Seguro?\u003C/strong>. Tocala de nuevo dentro de 4 segundos.\u003C/li>\n\u003C/ul>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                ⚠️ Resolución de Inconvenientes\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"resolucion-de-inconvenientes\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"resolucion-de-inconvenientes\">\u003C/div>\n\n\u003Cdiv class=\"table-wrapper\">\u003Ctable>\n\u003Cthead>\n\u003Ctr>\n\u003Cth>Problema\u003C/th>\n\u003Cth>Causa más frecuente\u003C/th>\n\u003Cth>Solución recomendada\u003C/th>\n\u003C/tr>\n\u003C/thead>\n\u003Ctbody>\u003Ctr>\n\u003Ctd>El cajero no ve el medio al cobrar.\u003C/td>\n\u003Ctd>La casilla \u003Cstrong>Activo\u003C/strong> está destildada.\u003C/td>\n\u003Ctd>Tildá \u003Cstrong>Activo\u003C/strong> en el renglón del medio.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>El medio no aparece en \u003Cstrong>Para pagar proveedores\u003C/strong>.\u003C/td>\n\u003Ctd>La casilla \u003Cstrong>Proveedores\u003C/strong> está destildada.\u003C/td>\n\u003Ctd>Tildá \u003Cstrong>Proveedores\u003C/strong> en la pestaña \u003Cstrong>Para cobrar\u003C/strong>.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>Un renglón dice \u003Cem>Sin clasificar: elegí qué es\u003C/em>.\u003C/td>\n\u003Ctd>Al medio le falta el tipo.\u003C/td>\n\u003Ctd>Elegí una opción en \u003Cstrong>¿Qué es?\u003C/strong>.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>La papelera está apagada.\u003C/td>\n\u003Ctd>El medio ya tiene cobros, o es Efectivo.\u003C/td>\n\u003Ctd>Destildá \u003Cstrong>Activo\u003C/strong> para que no se use más.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>Aparece un mensaje rojo y el renglón se pinta de rojo.\u003C/td>\n\u003Ctd>No se pudo guardar el cambio.\u003C/td>\n\u003Ctd>Revisá el nombre y la conexión, y probá de nuevo.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>No veo \u003Cstrong>Medios de cobro\u003C/strong> en el menú.\u003C/td>\n\u003Ctd>Tu usuario no tiene permiso.\u003C/td>\n\u003Ctd>Pedile a un administrador el permiso en \u003Ca href=\"/user-guide/permisos-por-rol\">Permisos por Rol\u003C/a>.\u003C/td>\n\u003C/tr>\n\u003C/tbody>\u003C/table>\u003C/div>\n",[5,9,12,15,18,21,24,27],{"id":6,"title":7,"level":8},"antes-de-empezar","Antes de empezar",2,{"id":10,"title":11,"level":8},"paso-1-entra-a-la-pantalla","Paso 1: Entrá a la pantalla",{"id":13,"title":14,"level":8},"paso-2-mira-la-pestana-para-cobrar","Paso 2: Mirá la pestaña \"Para cobrar\"",{"id":16,"title":17,"level":8},"paso-3-mira-la-pestana-para-pagar-proveedores","Paso 3: Mirá la pestaña \"Para pagar proveedores\"",{"id":19,"title":20,"level":8},"paso-4-agrega-un-medio-personalizado","Paso 4: Agregá un medio personalizado",{"id":22,"title":23,"level":8},"paso-5-abri-mas-opciones","Paso 5: Abrí \"Más opciones\"",{"id":25,"title":26,"level":8},"borrar-un-medio","Borrar un medio",{"id":28,"title":29,"level":8},"resolucion-de-inconvenientes","Resolución de Inconvenientes",{"title":31,"description":32,"keywords":33},"Medios de cobro - Manual","¿Dónde está en el sistema?: Menú principal → Configuración → Medios de cobro (debajo del título Tablas del Sistema)\n ¿Quién lo usa?: A...","medios de cobro, paxapos, medios de cobro, tutorial, guía, manual usuario","132-medios-de-cobro.txt"],"uses":{"params":["slug"]}}]}
