{"type":"data","nodes":[null,{"type":"data","data":[{"moduleCategories":1},[2,17,44,53,77,98,110,140,146,173,185,221,250],{"title":3,"modules":4},"Comenzamos",[5,8,11,14],{"slug":6,"title":7},"introduccion","Bienvenido a tu software gastronómico",{"slug":9,"title":10},"iniciar-sesion","Cómo Iniciar Sesión",{"slug":12,"title":13},"recuperar-contrasena","Cómo Recuperar tu Contraseña",{"slug":15,"title":16},"guia-de-inicio-rapido","Guía de Inicio Rápido",{"title":18,"modules":19},"Ventas",[20,23,26,29,32,35,38,41],{"slug":21,"title":22},"salon-de-ventas","Cómo Usar el Salón de Ventas (Adición)",{"slug":24,"title":25},"caja-rapida","Cómo Usar la Caja Rápida (Registradora)",{"slug":27,"title":28},"mozos","Cómo Cargar los Mozos",{"slug":30,"title":31},"clientes","Cómo Gestionar los Clientes",{"slug":33,"title":34},"descuentos","Cómo Configurar Descuentos",{"slug":36,"title":37},"nueva-reserva","Cómo Cargar una Nueva Reserva",{"slug":39,"title":40},"listado-de-reservas","Cómo Usar el Listado de Reservas",{"slug":42,"title":43},"grilla-de-reservas","Cómo Usar la Grilla de Reservas",{"title":45,"modules":46},"Medios de Pago",[47,50],{"slug":48,"title":49},"configuracion-procesadores","Configuración de Procesadores de Pago",{"slug":51,"title":52},"transacciones-mercadopago","Transacciones MercadoPago",{"title":54,"modules":55},"Productos",[56,59,62,65,68,71,74],{"slug":57,"title":58},"menu","Menú de Productos (Carta)",{"slug":60,"title":61},"categorias","Categorías de Productos",{"slug":63,"title":64},"variantes-grupo-sabores","Variantes y Grupos de Sabores",{"slug":66,"title":67},"maestro-de-productos","Maestro de Productos",{"slug":69,"title":70},"subproductos-elaborados","Sub-Productos (Elaborados)",{"slug":72,"title":73},"recetas","Recetas",{"slug":75,"title":76},"analisis-duplicados","Buscar Duplicados",{"title":78,"modules":79},"Compras",[80,83,86,89,92,95],{"slug":81,"title":82},"todas-las-ordenes-compra","Órdenes de Compra",{"slug":84,"title":85},"crear-orden-compra","Crear una Orden de Compra",{"slug":87,"title":88},"ordenes-a-aprobar","Órdenes a aprobar",{"slug":90,"title":91},"mercaderias","Mercaderías",{"slug":93,"title":94},"proveedores","Proveedores",{"slug":96,"title":97},"historial-de-compras","Historial de Compras",{"title":99,"modules":100},"Stock",[101,104,107],{"slug":102,"title":103},"stock-mercaderias","Stock de Mercaderías",{"slug":105,"title":106},"stock-subproductos","Stock de Subproductos",{"slug":108,"title":109},"movimientos-de-stock","Movimientos de Stock",{"title":111,"modules":112},"Finanzas",[113,116,119,122,125,128,131,134,137],{"slug":114,"title":115},"arqueos-de-caja","Arqueos de Caja",{"slug":117,"title":118},"listado-de-cajas","Listado de Cajas",{"slug":120,"title":121},"transacciones-de-cobro","Transacciones de Cobro",{"slug":123,"title":124},"factura-manual","Factura Manual",{"slug":126,"title":127},"resumen-de-deuda","Resumen de Deuda",{"slug":129,"title":130},"pagos","Pagos",{"slug":132,"title":133},"historial-de-facturas","Historial de Facturas",{"slug":135,"title":136},"historico-de-mesas","Histórico de Mesas",{"slug":138,"title":139},"puntos-de-venta-pdv","Puntos de Venta (PDVs)",{"title":141,"modules":142},"Comandero",[143],{"slug":144,"title":145},"comandero","Comandero (pantalla de cocina)",{"title":147,"modules":148},"RRHH",[149,152,155,158,161,164,167,170],{"slug":150,"title":151},"empleados","Empleados",{"slug":153,"title":154},"empleados-trabajando","Empleados Trabajando",{"slug":156,"title":157},"registro-diario-fichaje","Registro Diario de Fichaje",{"slug":159,"title":160},"reporte-mensual-fichaje","Reporte Mensual de Fichaje",{"slug":162,"title":163},"departamentos","Departamentos",{"slug":165,"title":166},"turnos-y-horarios-fichaje","Turnos y Horarios de Fichaje",{"slug":168,"title":169},"sueldos-y-jornales","Sueldos y Jornales",{"slug":171,"title":172},"datos-de-acceso-app","Datos de Acceso a la App de Fichaje",{"title":174,"modules":175},"Reportes",[176,179,182],{"slug":177,"title":178},"tablero-general","Tablero General",{"slug":180,"title":181},"productos-mas-vendidos","Productos Más Vendidos",{"slug":183,"title":184},"compras-por-mercaderia","Compras por Mercadería",{"title":186,"modules":187},"Configuracion",[188,191,194,197,200,203,206,209,212,215,218],{"slug":189,"title":190},"configuracion-general","Configuración general",{"slug":192,"title":193},"impresoras","Cómo cargar las impresoras del local",{"slug":195,"title":196},"perfiles-de-impresion","Cómo usar los perfiles de impresión",{"slug":198,"title":199},"usuarios-del-sistema","Cómo administrar los Usuarios del Sistema",{"slug":201,"title":202},"usuarios-con-pin","Cómo administrar los Usuarios con PIN",{"slug":204,"title":205},"punto-de-venta","🏛️ Trámite en ARCA (con clave fiscal)",{"slug":207,"title":208},"permisos-por-rol","Cómo configurar los Permisos por Rol",{"slug":210,"title":211},"turnos-mesa","Turnos de Mesa",{"slug":213,"title":214},"medios-de-cobro","Medios de cobro",{"slug":216,"title":217},"clasificacion-de-gastos","Clasificación de Gastos",{"slug":219,"title":220},"centros-de-costo","Centros de Costo",{"title":222,"modules":223},"Biblioteca de Drivers",[224,226,229,232,235,238,241,244,247],{"slug":225,"title":222},"biblioteca-de-drivers",{"slug":227,"title":228},"sam4s-giant-100","Sam4S Giant - 100",{"slug":230,"title":231},"citizen-ct-s310ii","Citizen CT-S310II",{"slug":233,"title":234},"epson-tm-t20","Epson TM-T20",{"slug":236,"title":237},"drivers-genericos","Drivers Genéricos POS",{"slug":239,"title":240},"epson-tm-t88","Epson TM-T88V",{"slug":242,"title":243},"fiscalberry-windows","Instalar Fiscalberry en Windows",{"slug":245,"title":246},"fiscalberry-linux","Instalar Fiscalberry en Linux",{"slug":248,"title":249},"fiscalberry-android","Instalar Fiscalberry en Android",{"title":251,"modules":252},"Extra",[253,256,259,262,265,268,271,274,277,280],{"slug":254,"title":255},"01-faq-solucion-inicial-pantalla-congelada","📖 Manual de Usuario: Solución Inicial si la Pantalla se Congela o no Carga",{"slug":257,"title":258},"03-faq-mozo-reabrir-mesa-anulada","📖 Manual de Usuario: Cómo Reabrir una Mesa Anulada o Cerrada por Error",{"slug":260,"title":261},"05-faq-cajero-emitir-factura-a","📖 Manual de Usuario: Cómo Emitir una Factura A Cargando Datos del Cliente",{"slug":263,"title":264},"06-faq-cajero-ingreso-egreso-cajon","📖 Manual de Usuario: Cómo Registrar Entradas y Salidas de Dinero del Cajón",{"slug":266,"title":267},"07-faq-cajero-activar-medio-pago","📖 Manual de Usuario: Cómo Activar un Medio de Pago que no Aparece al Cobrar",{"slug":269,"title":270},"08-faq-cajero-diferencia-facturado-vs-abiertas","📖 Manual de Usuario: Diferencia entre \"Facturado Total Mesas\" y \"Abiertas Por Usuario\" en Caja",{"slug":272,"title":273},"10-faq-supervisor-cierre-caja-diferencias","📖 Manual de Usuario: Cómo Auditar y Solucionar Diferencias en el Cierre de Caja",{"slug":275,"title":276},"preguntas-frecuentes","Preguntas Frecuentes y Guías Rápidas por Rol",{"slug":278,"title":279},"buchon-bot","Buchón Bot",{"slug":281,"title":282},"troubleshooting-semantico","📖 Guía Única de Resolución de Problemas y Errores (Troubleshooting)"],"uses":{}},{"type":"data","data":[{"slug":1,"title":2,"content":3,"tableOfContents":4,"seo":21,"llmTxtFile":25},"nueva-reserva","Cómo Cargar una Nueva Reserva","\u003Cdiv id=\"nueva-reserva\">\u003C/div>\n\n\u003Cblockquote>\n\u003Cp>\u003Cstrong>¿Dónde está en el sistema?:\u003C/strong> Menú principal → \u003Cstrong>Ventas\u003C/strong> → \u003Cstrong>Nueva Reserva\u003C/strong>\u003Cbr>\u003Cstrong>¿Quién lo usa?:\u003C/strong> Recepción, cajeros y encargados\u003C/p>\n\u003C/blockquote>\n\u003Cblockquote>\n\u003Cp>🎯 \u003Cstrong>¿Para qué sirve esto?\u003C/strong>\nAcá anotás que un cliente va a venir: quién es, cuántos son, qué día y a qué hora. Después la reserva aparece en el \u003Ca href=\"/user-guide/listado-de-reservas\">Listado de Reservas\u003C/a>.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                📍 \u003Cstrong>Paso 1: Entrá a Nueva Reserva\u003C/strong>\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-1-entra-a-nueva-reserva\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-1-entra-a-nueva-reserva\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/27-00a-menu-grupo-ventas.png\" alt=\"Grupo Ventas del menú lateral, marcado en rojo\">\u003C/p>\n\u003Col>\n\u003Cli>En el menú de la izquierda, tocá \u003Cstrong>Ventas\u003C/strong>. Se despliegan sus opciones.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/27-00b-menu-opcion-reservas-add.png\" alt=\"Opción Nueva Reserva dentro del grupo Ventas, marcada en rojo\">\u003C/p>\n\u003Col start=\"2\">\n\u003Cli>Bajá hasta la parte \u003Cstrong>Reservas\u003C/strong> y tocá \u003Cstrong>Nueva Reserva\u003C/strong>.\u003C/li>\n\u003Cli>Se abre la pantalla para cargar la reserva.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/14-nueva-reserva-formulario.png\" alt=\"Pantalla Nueva Reserva vacía\">\u003C/p>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                👤 \u003Cstrong>Paso 2: Cargá quién viene\u003C/strong>\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-2-carga-quien-viene\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-2-carga-quien-viene\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/27-02-campo-cliente.png\" alt=\"Casillero Cliente con el nombre Juan Pérez\">\u003C/p>\n\u003Col>\n\u003Cli>En \u003Cstrong>Cliente\u003C/strong>, escribí el nombre, el DNI, el mail o el teléfono.\u003C/li>\n\u003Cli>Si el cliente ya existe, aparece en una lista. Tocalo y sus datos se completan solos.\u003C/li>\n\u003Cli>Si es nuevo, dejá el nombre escrito. El cliente se crea al guardar.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/27-03-campo-telefono.png\" alt=\"Casillero Teléfono\">\u003C/p>\n\u003Col start=\"4\">\n\u003Cli>En \u003Cstrong>Teléfono\u003C/strong>, escribí el celular. Por ejemplo: \u003Cem>1155556666\u003C/em>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/27-04-campo-email.png\" alt=\"Casillero Email\">\u003C/p>\n\u003Col start=\"5\">\n\u003Cli>En \u003Cstrong>Email\u003C/strong>, escribí el mail. Por ejemplo: \u003Cem>\u003Ca href=\"mailto:juan.perez@ejemplo.com\">juan.perez@ejemplo.com\u003C/a>\u003C/em>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/27-05-campo-dni-opcional.png\" alt=\"Casillero DNI opcional\">\u003C/p>\n\u003Col start=\"6\">\n\u003Cli>\u003Cstrong>DNI\u003C/strong> es opcional.\u003C/li>\n\u003C/ol>\n\u003Cblockquote>\n\u003Cp>💡 \u003Cstrong>Consejo útil:\u003C/strong> Cargá al menos el \u003Cstrong>teléfono\u003C/strong>, el \u003Cstrong>mail\u003C/strong> o el \u003Cstrong>DNI\u003C/strong>. Así la próxima vez el sistema encuentra al mismo cliente y no lo repite.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                📅 \u003Cstrong>Paso 3: Cargá cuándo y cuántos vienen\u003C/strong>\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-3-carga-cuando-y-cuantos-vienen\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-3-carga-cuando-y-cuantos-vienen\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/27-06-campo-cant-comensales.png\" alt=\"Casillero Cant Comensales con el número 4\">\u003C/p>\n\u003Col>\n\u003Cli>En \u003Cstrong>Cant Comensales\u003C/strong>, escribí cuántas personas vienen. Por ejemplo: \u003Cem>4\u003C/em>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/27-07-campo-fecha.png\" alt=\"Casillero Fecha\">\u003C/p>\n\u003Col start=\"2\">\n\u003Cli>En \u003Cstrong>Fecha\u003C/strong>, elegí el día. Tocá el calendario 📅 de la derecha para elegirlo.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/27-08-campo-hora.png\" alt=\"Lista Hora con las 21 elegidas\">\u003C/p>\n\u003Col start=\"3\">\n\u003Cli>En \u003Cstrong>Hora\u003C/strong>, elegí la hora. Por ejemplo: \u003Cem>21\u003C/em>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/27-09-campo-minuto.png\" alt=\"Lista Minuto con 00 elegido\">\u003C/p>\n\u003Col start=\"4\">\n\u003Cli>En \u003Cstrong>Minuto\u003C/strong>, elegí los minutos: \u003Cem>00\u003C/em>, \u003Cem>15\u003C/em>, \u003Cem>30\u003C/em> o \u003Cem>45\u003C/em>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/27-10-campo-observacion.png\" alt=\"Casillero Observación con un pedido especial\">\u003C/p>\n\u003Col start=\"5\">\n\u003Cli>En \u003Cstrong>Observación\u003C/strong>, anotá cualquier pedido especial. Por ejemplo: \u003Cem>Cumpleaños. Mesa cerca de la ventana.\u003C/em>\u003C/li>\n\u003C/ol>\n\u003Ch3>Datos opcionales\u003C/h3>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/27-12-campo-numero.png\" alt=\"Casillero Número opcional\">\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Número (Opcional):\u003C/strong> el número de mesa, si ya sabés dónde los vas a sentar.\u003C/li>\n\u003C/ul>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/27-13-campo-mozo-id.png\" alt=\"Lista para elegir el mozo, opcional\">\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Mozo (Opcional):\u003C/strong> el mozo que los va a atender.\u003C/li>\n\u003C/ul>\n\u003Cblockquote>\n\u003Cp>ℹ️ Si tu comercio usa el mapa del salón, también vas a ver \u003Cstrong>Mesa Salón (Opcional)\u003C/strong> para elegir la mesa. Si tiene el asistente de IA, vas a ver el botón \u003Cstrong>Consultar a la IA si conviene\u003C/strong>.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                💾 \u003Cstrong>Paso 4: Guardá la reserva\u003C/strong>\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-4-guarda-la-reserva\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-4-guarda-la-reserva\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/27-25-formulario-completo.png\" alt=\"Pantalla Nueva Reserva completa\">\u003C/p>\n\u003Col>\n\u003Cli>Revisá que todo esté bien.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/27-16-donde-esta-boton-guardar.png\" alt=\"Pantalla Nueva Reserva con el botón Guardar marcado en rojo\">\u003C/p>\n\u003Col start=\"2\">\n\u003Cli>Tocá el botón verde \u003Cstrong>Guardar\u003C/strong>, abajo a la izquierda.\u003C/li>\n\u003Cli>La reserva queda guardada y aparece en el calendario del \u003Ca href=\"/user-guide/listado-de-reservas\">Listado de Reservas\u003C/a>.\u003C/li>\n\u003C/ol>\n\u003Ch3>Si aparece &quot;Cliente sin datos de contacto&quot;\u003C/h3>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/27-26-aviso-sin-contacto.png\" alt=\"Ventanita Cliente sin datos de contacto\">\u003C/p>\n\u003Cp>Aparece si el cliente es nuevo y no cargaste teléfono, mail ni DNI. Todavía no se guardó nada.\u003C/p>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/27-20-donde-esta-boton-volver-y-completar.png\" alt=\"Ventanita con el botón Volver y completar marcado en rojo\">\u003C/p>\n\u003Cul>\n\u003Cli>Tocá \u003Cstrong>Volver y completar\u003C/strong> para cargar el teléfono, el mail o el DNI. \u003Cstrong>Es lo recomendado.\u003C/strong>\u003C/li>\n\u003C/ul>\n\u003Cp>\u003Cimg src=\"/images/manual/20-ventas/27-22-boton-guardar-igual.png\" alt=\"Botón naranja Guardar igual\">\u003C/p>\n\u003Cul>\n\u003Cli>Tocá \u003Cstrong>Guardar igual\u003C/strong> solo si de verdad no tenés ningún dato de contacto.\u003C/li>\n\u003C/ul>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                ⚠️ \u003Cstrong>Resolución de Inconvenientes\u003C/strong>\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"resolucion-de-inconvenientes\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"resolucion-de-inconvenientes\">\u003C/div>\n\n\u003Cdiv class=\"table-wrapper\">\u003Ctable>\n\u003Cthead>\n\u003Ctr>\n\u003Cth>Problema\u003C/th>\n\u003Cth>Causa más frecuente\u003C/th>\n\u003Cth>Solución recomendada\u003C/th>\n\u003C/tr>\n\u003C/thead>\n\u003Ctbody>\u003Ctr>\n\u003Ctd>\u003Cstrong>&quot;No se pudo procesar la reserva en este momento&quot;\u003C/strong>\u003C/td>\n\u003Ctd>Dos personas quisieron reservar la misma mesa al mismo tiempo.\u003C/td>\n\u003Ctd>Esperá unos segundos y probá de nuevo.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>Aviso de choque con otra reserva\u003C/strong>\u003C/td>\n\u003Ctd>Ya hay otra reserva para esa misma mesa en un horario muy cercano.\u003C/td>\n\u003Ctd>Elegí otro horario u otra mesa.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>No aparece Mesa Salón\u003C/strong>\u003C/td>\n\u003Ctd>Tu comercio no usa el mapa del salón.\u003C/td>\n\u003Ctd>Dejalo así. Si querés, escribí el número de mesa en \u003Cstrong>Número (Opcional)\u003C/strong>.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>Aparece &quot;Cliente sin datos de contacto&quot;\u003C/strong>\u003C/td>\n\u003Ctd>El cliente es nuevo y no tiene teléfono, mail ni DNI.\u003C/td>\n\u003Ctd>Tocá \u003Cstrong>Volver y completar\u003C/strong> y cargá al menos uno.\u003C/td>\n\u003C/tr>\n\u003C/tbody>\u003C/table>\u003C/div>\n",[5,9,12,15,18],{"id":6,"title":7,"level":8},"paso-1-entra-a-nueva-reserva","Paso 1: Entrá a Nueva Reserva",2,{"id":10,"title":11,"level":8},"paso-2-carga-quien-viene","Paso 2: Cargá quién viene",{"id":13,"title":14,"level":8},"paso-3-carga-cuando-y-cuantos-vienen","Paso 3: Cargá cuándo y cuántos vienen",{"id":16,"title":17,"level":8},"paso-4-guarda-la-reserva","Paso 4: Guardá la reserva",{"id":19,"title":20,"level":8},"resolucion-de-inconvenientes","Resolución de Inconvenientes",{"title":22,"description":23,"keywords":24},"Cómo Cargar una Nueva Reserva - Manual","¿Dónde está en el sistema?: Menú principal → Ventas → Nueva Reserva  \n ¿Quién lo usa?: Recepción, cajeros y encargados","nueva reserva, paxapos, cómo cargar una nueva reserva, tutorial, guía, manual usuario","27-nueva-reserva.txt"],"uses":{"params":["slug"]}}]}
