{"type":"data","nodes":[null,{"type":"data","data":[{"moduleCategories":1},[2,17,44,53,77,98,110,140,146,173,185,221,250],{"title":3,"modules":4},"Comenzamos",[5,8,11,14],{"slug":6,"title":7},"introduccion","Bienvenido a tu software gastronómico",{"slug":9,"title":10},"iniciar-sesion","Cómo Iniciar Sesión",{"slug":12,"title":13},"recuperar-contrasena","Cómo Recuperar tu Contraseña",{"slug":15,"title":16},"guia-de-inicio-rapido","Guía de Inicio Rápido",{"title":18,"modules":19},"Ventas",[20,23,26,29,32,35,38,41],{"slug":21,"title":22},"salon-de-ventas","Cómo Usar el Salón de Ventas (Adición)",{"slug":24,"title":25},"caja-rapida","Cómo Usar la Caja Rápida (Registradora)",{"slug":27,"title":28},"mozos","Cómo Cargar los Mozos",{"slug":30,"title":31},"clientes","Cómo Gestionar los Clientes",{"slug":33,"title":34},"descuentos","Cómo Configurar Descuentos",{"slug":36,"title":37},"nueva-reserva","Cómo Cargar una Nueva Reserva",{"slug":39,"title":40},"listado-de-reservas","Cómo Usar el Listado de Reservas",{"slug":42,"title":43},"grilla-de-reservas","Cómo Usar la Grilla de Reservas",{"title":45,"modules":46},"Medios de Pago",[47,50],{"slug":48,"title":49},"configuracion-procesadores","Configuración de Procesadores de Pago",{"slug":51,"title":52},"transacciones-mercadopago","Transacciones MercadoPago",{"title":54,"modules":55},"Productos",[56,59,62,65,68,71,74],{"slug":57,"title":58},"menu","Menú de Productos (Carta)",{"slug":60,"title":61},"categorias","Categorías de Productos",{"slug":63,"title":64},"variantes-grupo-sabores","Variantes y Grupos de Sabores",{"slug":66,"title":67},"maestro-de-productos","Maestro de Productos",{"slug":69,"title":70},"subproductos-elaborados","Sub-Productos (Elaborados)",{"slug":72,"title":73},"recetas","Recetas",{"slug":75,"title":76},"analisis-duplicados","Buscar Duplicados",{"title":78,"modules":79},"Compras",[80,83,86,89,92,95],{"slug":81,"title":82},"todas-las-ordenes-compra","Órdenes de Compra",{"slug":84,"title":85},"crear-orden-compra","Crear una Orden de Compra",{"slug":87,"title":88},"ordenes-a-aprobar","Órdenes a aprobar",{"slug":90,"title":91},"mercaderias","Mercaderías",{"slug":93,"title":94},"proveedores","Proveedores",{"slug":96,"title":97},"historial-de-compras","Historial de Compras",{"title":99,"modules":100},"Stock",[101,104,107],{"slug":102,"title":103},"stock-mercaderias","Stock de Mercaderías",{"slug":105,"title":106},"stock-subproductos","Stock de Subproductos",{"slug":108,"title":109},"movimientos-de-stock","Movimientos de Stock",{"title":111,"modules":112},"Finanzas",[113,116,119,122,125,128,131,134,137],{"slug":114,"title":115},"arqueos-de-caja","Arqueos de Caja",{"slug":117,"title":118},"listado-de-cajas","Listado de Cajas",{"slug":120,"title":121},"transacciones-de-cobro","Transacciones de Cobro",{"slug":123,"title":124},"factura-manual","Factura Manual",{"slug":126,"title":127},"resumen-de-deuda","Resumen de Deuda",{"slug":129,"title":130},"pagos","Pagos",{"slug":132,"title":133},"historial-de-facturas","Historial de Facturas",{"slug":135,"title":136},"historico-de-mesas","Histórico de Mesas",{"slug":138,"title":139},"puntos-de-venta-pdv","Puntos de Venta (PDVs)",{"title":141,"modules":142},"Comandero",[143],{"slug":144,"title":145},"comandero","Comandero (pantalla de cocina)",{"title":147,"modules":148},"RRHH",[149,152,155,158,161,164,167,170],{"slug":150,"title":151},"empleados","Empleados",{"slug":153,"title":154},"empleados-trabajando","Empleados Trabajando",{"slug":156,"title":157},"registro-diario-fichaje","Registro Diario de Fichaje",{"slug":159,"title":160},"reporte-mensual-fichaje","Reporte Mensual de Fichaje",{"slug":162,"title":163},"departamentos","Departamentos",{"slug":165,"title":166},"turnos-y-horarios-fichaje","Turnos y Horarios de Fichaje",{"slug":168,"title":169},"sueldos-y-jornales","Sueldos y Jornales",{"slug":171,"title":172},"datos-de-acceso-app","Datos de Acceso a la App de Fichaje",{"title":174,"modules":175},"Reportes",[176,179,182],{"slug":177,"title":178},"tablero-general","Tablero General",{"slug":180,"title":181},"productos-mas-vendidos","Productos Más Vendidos",{"slug":183,"title":184},"compras-por-mercaderia","Compras por Mercadería",{"title":186,"modules":187},"Configuracion",[188,191,194,197,200,203,206,209,212,215,218],{"slug":189,"title":190},"configuracion-general","Configuración general",{"slug":192,"title":193},"impresoras","Cómo cargar las impresoras del local",{"slug":195,"title":196},"perfiles-de-impresion","Cómo usar los perfiles de impresión",{"slug":198,"title":199},"usuarios-del-sistema","Cómo administrar los Usuarios del Sistema",{"slug":201,"title":202},"usuarios-con-pin","Cómo administrar los Usuarios con PIN",{"slug":204,"title":205},"punto-de-venta","🏛️ Trámite en ARCA (con clave fiscal)",{"slug":207,"title":208},"permisos-por-rol","Cómo configurar los Permisos por Rol",{"slug":210,"title":211},"turnos-mesa","Turnos de Mesa",{"slug":213,"title":214},"medios-de-cobro","Medios de cobro",{"slug":216,"title":217},"clasificacion-de-gastos","Clasificación de Gastos",{"slug":219,"title":220},"centros-de-costo","Centros de Costo",{"title":222,"modules":223},"Biblioteca de Drivers",[224,226,229,232,235,238,241,244,247],{"slug":225,"title":222},"biblioteca-de-drivers",{"slug":227,"title":228},"sam4s-giant-100","Sam4S Giant - 100",{"slug":230,"title":231},"citizen-ct-s310ii","Citizen CT-S310II",{"slug":233,"title":234},"epson-tm-t20","Epson TM-T20",{"slug":236,"title":237},"drivers-genericos","Drivers Genéricos POS",{"slug":239,"title":240},"epson-tm-t88","Epson TM-T88V",{"slug":242,"title":243},"fiscalberry-windows","Instalar Fiscalberry en Windows",{"slug":245,"title":246},"fiscalberry-linux","Instalar Fiscalberry en Linux",{"slug":248,"title":249},"fiscalberry-android","Instalar Fiscalberry en Android",{"title":251,"modules":252},"Extra",[253,256,259,262,265,268,271,274,277,280],{"slug":254,"title":255},"01-faq-solucion-inicial-pantalla-congelada","📖 Manual de Usuario: Solución Inicial si la Pantalla se Congela o no Carga",{"slug":257,"title":258},"03-faq-mozo-reabrir-mesa-anulada","📖 Manual de Usuario: Cómo Reabrir una Mesa Anulada o Cerrada por Error",{"slug":260,"title":261},"05-faq-cajero-emitir-factura-a","📖 Manual de Usuario: Cómo Emitir una Factura A Cargando Datos del Cliente",{"slug":263,"title":264},"06-faq-cajero-ingreso-egreso-cajon","📖 Manual de Usuario: Cómo Registrar Entradas y Salidas de Dinero del Cajón",{"slug":266,"title":267},"07-faq-cajero-activar-medio-pago","📖 Manual de Usuario: Cómo Activar un Medio de Pago que no Aparece al Cobrar",{"slug":269,"title":270},"08-faq-cajero-diferencia-facturado-vs-abiertas","📖 Manual de Usuario: Diferencia entre \"Facturado Total Mesas\" y \"Abiertas Por Usuario\" en Caja",{"slug":272,"title":273},"10-faq-supervisor-cierre-caja-diferencias","📖 Manual de Usuario: Cómo Auditar y Solucionar Diferencias en el Cierre de Caja",{"slug":275,"title":276},"preguntas-frecuentes","Preguntas Frecuentes y Guías Rápidas por Rol",{"slug":278,"title":279},"buchon-bot","Buchón Bot",{"slug":281,"title":282},"troubleshooting-semantico","📖 Guía Única de Resolución de Problemas y Errores (Troubleshooting)"],"uses":{}},{"type":"data","data":[{"slug":1,"title":2,"content":3,"tableOfContents":4,"seo":34,"llmTxtFile":38},"recetas","Recetas","\u003Cdiv id=\"recetas\">\u003C/div>\n\n\u003Cblockquote>\n\u003Cp>\u003Cstrong>¿Dónde está en el sistema?:\u003C/strong> Menú principal → \u003Cstrong>Productos\u003C/strong> → \u003Cstrong>Gestión Avanzada\u003C/strong> → \u003Cstrong>Recetas\u003C/strong>\n\u003Cstrong>¿Quién lo usa?:\u003C/strong> Jefes de cocina, administradores y encargados de costos\u003C/p>\n\u003C/blockquote>\n\u003Cblockquote>\n\u003Cp>🎯 \u003Cstrong>¿Para qué sirve esto?\u003C/strong>\nAcá ves todas las recetas de tu cocina juntas, como un manual. Cada receta dice qué ingredientes lleva un producto y cuánto de cada uno.\nCon las recetas, el sistema calcula cuánto te cuesta preparar cada plato y descuenta el stock al vender.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🔑 Antes de empezar\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"antes-de-empezar\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"antes-de-empezar\">\u003C/div>\n\n\u003Cul>\n\u003Cli>Tu usuario tiene que tener el permiso de \u003Cstrong>Maestro de Productos\u003C/strong> en \u003Ca href=\"/user-guide/permisos-por-rol\">Permisos por Rol\u003C/a>.\u003C/li>\n\u003Cli>Los ingredientes tienen que estar cargados como productos. Mirá \u003Ca href=\"/user-guide/maestro-de-productos\">Maestro de Productos\u003C/a>.\u003C/li>\n\u003C/ul>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                📍 Paso 1: Entrá a la pantalla\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-1-entra-a-la-pantalla\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-1-entra-a-la-pantalla\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/46-00a-menu-grupo-productos.png\" alt=\"Menú lateral con el grupo Productos marcado en rojo\">\u003C/p>\n\u003Col>\n\u003Cli>En el menú de la izquierda, tocá \u003Cstrong>Productos\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/46-00b-menu-opcion-listado-recetas.png\" alt=\"Opción Recetas marcada en rojo en el menú lateral\">\u003C/p>\n\u003Col start=\"2\">\n\u003Cli>Tocá \u003Cstrong>Recetas\u003C/strong>. Está debajo del título \u003Cstrong>GESTIÓN AVANZADA\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/46-01-pantalla-listado-recetas.png\" alt=\"Pantalla Manual de Cocina con el índice de recetas\">\u003C/p>\n\u003Cp>Así se ve la pantalla. Arriba está el \u003Cstrong>Índice de Recetas\u003C/strong>, separado en \u003Cstrong>Productos en Venta\u003C/strong> y \u003Cstrong>Subproductos\u003C/strong>. Abajo, una tarjeta por receta.\u003C/p>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🔎 Paso 2: Buscá una receta\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-2-busca-una-receta\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-2-busca-una-receta\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/46-10-campo-buscar-receta.png\" alt=\"Casillero Buscar receta\">\u003C/p>\n\u003Col>\n\u003Cli>En el casillero \u003Cstrong>Buscar receta...\u003C/strong>, escribí el nombre del producto.\u003C/li>\n\u003Cli>La lista se achica mientras escribís.\u003C/li>\n\u003Cli>También podés tocar un nombre del índice para ir directo a su receta.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/46-11-tarjeta-receta.png\" alt=\"Tarjeta de la receta JAMON Y QUESO: rinde 12 docenas, con los botones Ver, Editar e Imprimir\">\u003C/p>\n\u003Cp>Cada tarjeta muestra el nombre, cuánto \u003Cstrong>rinde\u003C/strong> la receta, los ingredientes y el costo.\u003C/p>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                👁️ Paso 3: Mirá el producto\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-3-mira-el-producto\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-3-mira-el-producto\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/46-04-donde-esta-boton-ver.png\" alt=\"Tarjeta con el botón Ver marcado en rojo\">\u003C/p>\n\u003Col>\n\u003Cli>Tocá \u003Cstrong>Ver\u003C/strong>, arriba a la derecha de la tarjeta.\u003C/li>\n\u003Cli>Se abre la ficha del producto. Mirá \u003Ca href=\"/user-guide/maestro-de-productos#paso-5-mira-la-ficha-de-un-producto\">Maestro de Productos\u003C/a>.\u003C/li>\n\u003C/ol>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                ✏️ Paso 4: Cambiá una receta\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-4-cambia-una-receta\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-4-cambia-una-receta\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/46-06-donde-esta-boton-editar.png\" alt=\"Tarjeta con el botón Editar marcado en rojo\">\u003C/p>\n\u003Col>\n\u003Cli>Tocá \u003Cstrong>Editar\u003C/strong>, arriba a la derecha de la tarjeta.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/46-12-pantalla-formulario-receta.png\" alt=\"Formulario de la receta de JAMON Y QUESO con sus cuatro ingredientes\">\u003C/p>\n\u003Col start=\"2\">\n\u003Cli>Se abre el formulario de la receta.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/46-13-campo-cant-porciones.png\" alt=\"Casillero de cantidad que rinde la receta, con 12,00\">\u003C/p>\n\u003Col start=\"3\">\n\u003Cli>Arriba, escribí cuánto \u003Cstrong>rinde\u003C/strong> la receta. Por ejemplo: \u003Cem>12\u003C/em> docenas.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/46-14-campo-detalle-de-elaboracion.png\" alt=\"Casillero Detalle de elaboración con su barra de herramientas\">\u003C/p>\n\u003Col start=\"4\">\n\u003Cli>En \u003Cstrong>Detalle de elaboración\u003C/strong>, escribí cómo se prepara. Es opcional.\u003C/li>\n\u003C/ol>\n\u003Ch3 class=\"relative\">\n                Los ingredientes\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"los-ingredientes\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h3>\n            \u003Cdiv id=\"los-ingredientes\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/46-15-renglon-ingrediente.png\" alt=\"Renglón de un ingrediente: PALETA COCIDA, 0.26, unidad, observación y tacho\">\u003C/p>\n\u003Cp>Cada renglón es un ingrediente. De izquierda a derecha:\u003C/p>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/46-16-campo-ingrediente.png\" alt=\"Casillero del ingrediente con [Kg] PALETA COCIDA\">\u003C/p>\n\u003Col start=\"5\">\n\u003Cli>\u003Cstrong>Ingrediente\u003C/strong>: escribí el nombre y elegilo de la lista. Entre corchetes ves su unidad. Por ejemplo: \u003Cem>[Kg]\u003C/em>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/46-17-campo-cantidad.png\" alt=\"Casillero de cantidad con 0.26\">\u003C/p>\n\u003Col start=\"6\">\n\u003Cli>\u003Cstrong>Cantidad\u003C/strong>: cuánto lleva. Por ejemplo: \u003Cem>0.26\u003C/em> kilos.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/46-18-campo-unidad-de-medida.png\" alt=\"Lista de unidad de medida\">\u003C/p>\n\u003Col start=\"7\">\n\u003Cli>\u003Cstrong>Unidad\u003C/strong>: en qué unidad pusiste la cantidad. Por ejemplo: \u003Cem>Kg\u003C/em> o \u003Cem>gramos\u003C/em>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/46-19-campo-observacion.png\" alt=\"Casillero Observación (opcional)\">\u003C/p>\n\u003Col start=\"8\">\n\u003Cli>\u003Cstrong>Observación\u003C/strong>: una aclaración. Es opcional.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/46-22-donde-esta-boton-agregar-ingrediente.png\" alt=\"Formulario con el botón Agregar Ingrediente marcado en rojo\">\u003C/p>\n\u003Col start=\"9\">\n\u003Cli>Para sumar un ingrediente, tocá \u003Cstrong>+ Agregar Ingrediente\u003C/strong>, debajo de la lista.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/46-24-ingrediente-nuevo-vacio.png\" alt=\"Renglón nuevo vacío, con Seleccione producto\">\u003C/p>\n\u003Col start=\"10\">\n\u003Cli>Aparece un renglón vacío. Completalo como en los pasos 5 a 8.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/46-20-donde-esta-boton-quitar-ingrediente.png\" alt=\"Formulario con el tacho del primer ingrediente marcado en rojo\">\u003C/p>\n\u003Col start=\"11\">\n\u003Cli>Para sacar un ingrediente, tocá el tacho rojo 🗑️ de ese renglón.\u003C/li>\n\u003C/ol>\n\u003Ch3 class=\"relative\">\n                Guardá los cambios\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"guarda-los-cambios\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h3>\n            \u003Cdiv id=\"guarda-los-cambios\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/46-25-donde-esta-boton-guardar.png\" alt=\"Formulario con el botón verde Guardar marcado en rojo\">\u003C/p>\n\u003Col start=\"12\">\n\u003Cli>Tocá el botón verde \u003Cstrong>Guardar\u003C/strong>, abajo a la izquierda.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/46-27-donde-esta-boton-eliminar.png\" alt=\"Formulario con el botón rojo Eliminar marcado en rojo\">\u003C/p>\n\u003Cblockquote>\n\u003Cp>⚠️ \u003Cstrong>Atención:\u003C/strong> el botón rojo \u003Cstrong>Eliminar\u003C/strong>, abajo a la derecha, borra la receta entera. El producto queda sin receta.\u003C/p>\n\u003C/blockquote>\n\u003Cblockquote>\n\u003Cp>💡 \u003Cstrong>Consejo útil:\u003C/strong> para cargar la receta de un producto que no tiene, abrí su ficha y tocá \u003Cstrong>Agregar Receta\u003C/strong>. Mirá \u003Ca href=\"/user-guide/maestro-de-productos#botones-de-arriba\">Maestro de Productos\u003C/a>.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🖨️ Paso 5: Imprimí las recetas\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-5-imprimi-las-recetas\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-5-imprimi-las-recetas\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/46-02-donde-esta-boton-imprimir-manual.png\" alt=\"Pantalla con el botón Imprimir Manual marcado en rojo\">\u003C/p>\n\u003Col>\n\u003Cli>Para imprimir \u003Cstrong>todas\u003C/strong> las recetas, tocá \u003Cstrong>Imprimir Manual\u003C/strong>, arriba a la derecha.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/40-productos/46-08-donde-esta-boton-imprimir.png\" alt=\"Tarjeta con el botón Imprimir marcado en rojo\">\u003C/p>\n\u003Col start=\"2\">\n\u003Cli>Para imprimir \u003Cstrong>una sola\u003C/strong> receta, tocá \u003Cstrong>Imprimir\u003C/strong> en su tarjeta.\u003C/li>\n\u003Cli>Se abre la ventana de impresión de tu computadora. Elegí la impresora y tocá \u003Cstrong>Imprimir\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                ⚠️ Resolución de Inconvenientes\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"resolucion-de-inconvenientes\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"resolucion-de-inconvenientes\">\u003C/div>\n\n\u003Cdiv class=\"table-wrapper\">\u003Ctable>\n\u003Cthead>\n\u003Ctr>\n\u003Cth>Problema\u003C/th>\n\u003Cth>Causa más frecuente\u003C/th>\n\u003Cth>Solución recomendada\u003C/th>\n\u003C/tr>\n\u003C/thead>\n\u003Ctbody>\u003Ctr>\n\u003Ctd>\u003Cstrong>Un producto no aparece en la lista\u003C/strong>\u003C/td>\n\u003Ctd>No tiene receta, o su receta no tiene ingredientes.\u003C/td>\n\u003Ctd>Abrí su ficha en el \u003Ca href=\"/user-guide/maestro-de-productos\">Maestro de Productos\u003C/a> y tocá \u003Cstrong>Agregar Receta\u003C/strong>.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>La receta descuenta más stock del que debería\u003C/strong>\u003C/td>\n\u003Ctd>La cantidad o la unidad están mal.\u003C/td>\n\u003Ctd>Tocá \u003Cstrong>Editar\u003C/strong> y revisá si pusiste gramos o kilos.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>El costo de la receta da $0\u003C/strong>\u003C/td>\n\u003Ctd>Los ingredientes no tienen precio de compra.\u003C/td>\n\u003Ctd>Cargá las compras de esos ingredientes.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>No encuentro el ingrediente al escribirlo\u003C/strong>\u003C/td>\n\u003Ctd>No está cargado como producto.\u003C/td>\n\u003Ctd>Crealo primero en el \u003Ca href=\"/user-guide/maestro-de-productos\">Maestro de Productos\u003C/a>.\u003C/td>\n\u003C/tr>\n\u003C/tbody>\u003C/table>\u003C/div>\n",[5,9,12,15,18,21,25,28,31],{"id":6,"title":7,"level":8},"antes-de-empezar","Antes de empezar",2,{"id":10,"title":11,"level":8},"paso-1-entra-a-la-pantalla","Paso 1: Entrá a la pantalla",{"id":13,"title":14,"level":8},"paso-2-busca-una-receta","Paso 2: Buscá una receta",{"id":16,"title":17,"level":8},"paso-3-mira-el-producto","Paso 3: Mirá el producto",{"id":19,"title":20,"level":8},"paso-4-cambia-una-receta","Paso 4: Cambiá una receta",{"id":22,"title":23,"level":24},"los-ingredientes","Los ingredientes",3,{"id":26,"title":27,"level":24},"guarda-los-cambios","Guardá los cambios",{"id":29,"title":30,"level":8},"paso-5-imprimi-las-recetas","Paso 5: Imprimí las recetas",{"id":32,"title":33,"level":8},"resolucion-de-inconvenientes","Resolución de Inconvenientes",{"title":35,"description":36,"keywords":37},"Recetas - Manual","¿Dónde está en el sistema?: Menú principal → Productos → Gestión Avanzada → Recetas\n ¿Quién lo usa?: Jefes de cocina, administradores ...","recetas, paxapos, recetas, tutorial, guía, manual usuario","46-recetas.txt"],"uses":{"params":["slug"]}}]}
