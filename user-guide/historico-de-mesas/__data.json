{"type":"data","nodes":[null,{"type":"data","data":[{"moduleCategories":1},[2,17,44,53,77,98,110,140,146,173,185,221,250],{"title":3,"modules":4},"Comenzamos",[5,8,11,14],{"slug":6,"title":7},"introduccion","Bienvenido a tu software gastronómico",{"slug":9,"title":10},"iniciar-sesion","Cómo Iniciar Sesión",{"slug":12,"title":13},"recuperar-contrasena","Cómo Recuperar tu Contraseña",{"slug":15,"title":16},"guia-de-inicio-rapido","Guía de Inicio Rápido",{"title":18,"modules":19},"Ventas",[20,23,26,29,32,35,38,41],{"slug":21,"title":22},"salon-de-ventas","Cómo Usar el Salón de Ventas (Adición)",{"slug":24,"title":25},"caja-rapida","Cómo Usar la Caja Rápida (Registradora)",{"slug":27,"title":28},"mozos","Cómo Cargar los Mozos",{"slug":30,"title":31},"clientes","Cómo Gestionar los Clientes",{"slug":33,"title":34},"descuentos","Cómo Configurar Descuentos",{"slug":36,"title":37},"nueva-reserva","Cómo Cargar una Nueva Reserva",{"slug":39,"title":40},"listado-de-reservas","Cómo Usar el Listado de Reservas",{"slug":42,"title":43},"grilla-de-reservas","Cómo Usar la Grilla de Reservas",{"title":45,"modules":46},"Medios de Pago",[47,50],{"slug":48,"title":49},"configuracion-procesadores","Configuración de Procesadores de Pago",{"slug":51,"title":52},"transacciones-mercadopago","Transacciones MercadoPago",{"title":54,"modules":55},"Productos",[56,59,62,65,68,71,74],{"slug":57,"title":58},"menu","Menú de Productos (Carta)",{"slug":60,"title":61},"categorias","Categorías de Productos",{"slug":63,"title":64},"variantes-grupo-sabores","Variantes y Grupos de Sabores",{"slug":66,"title":67},"maestro-de-productos","Maestro de Productos",{"slug":69,"title":70},"subproductos-elaborados","Sub-Productos (Elaborados)",{"slug":72,"title":73},"recetas","Recetas",{"slug":75,"title":76},"analisis-duplicados","Buscar Duplicados",{"title":78,"modules":79},"Compras",[80,83,86,89,92,95],{"slug":81,"title":82},"todas-las-ordenes-compra","Órdenes de Compra",{"slug":84,"title":85},"crear-orden-compra","Crear una Orden de Compra",{"slug":87,"title":88},"ordenes-a-aprobar","Órdenes a aprobar",{"slug":90,"title":91},"mercaderias","Mercaderías",{"slug":93,"title":94},"proveedores","Proveedores",{"slug":96,"title":97},"historial-de-compras","Historial de Compras",{"title":99,"modules":100},"Stock",[101,104,107],{"slug":102,"title":103},"stock-mercaderias","Stock de Mercaderías",{"slug":105,"title":106},"stock-subproductos","Stock de Subproductos",{"slug":108,"title":109},"movimientos-de-stock","Movimientos de Stock",{"title":111,"modules":112},"Finanzas",[113,116,119,122,125,128,131,134,137],{"slug":114,"title":115},"arqueos-de-caja","Arqueos de Caja",{"slug":117,"title":118},"listado-de-cajas","Listado de Cajas",{"slug":120,"title":121},"transacciones-de-cobro","Transacciones de Cobro",{"slug":123,"title":124},"factura-manual","Factura Manual",{"slug":126,"title":127},"resumen-de-deuda","Resumen de Deuda",{"slug":129,"title":130},"pagos","Pagos",{"slug":132,"title":133},"historial-de-facturas","Historial de Facturas",{"slug":135,"title":136},"historico-de-mesas","Histórico de Mesas",{"slug":138,"title":139},"puntos-de-venta-pdv","Puntos de Venta (PDVs)",{"title":141,"modules":142},"Comandero",[143],{"slug":144,"title":145},"comandero","Comandero (pantalla de cocina)",{"title":147,"modules":148},"RRHH",[149,152,155,158,161,164,167,170],{"slug":150,"title":151},"empleados","Empleados",{"slug":153,"title":154},"empleados-trabajando","Empleados Trabajando",{"slug":156,"title":157},"registro-diario-fichaje","Registro Diario de Fichaje",{"slug":159,"title":160},"reporte-mensual-fichaje","Reporte Mensual de Fichaje",{"slug":162,"title":163},"departamentos","Departamentos",{"slug":165,"title":166},"turnos-y-horarios-fichaje","Turnos y Horarios de Fichaje",{"slug":168,"title":169},"sueldos-y-jornales","Sueldos y Jornales",{"slug":171,"title":172},"datos-de-acceso-app","Datos de Acceso a la App de Fichaje",{"title":174,"modules":175},"Reportes",[176,179,182],{"slug":177,"title":178},"tablero-general","Tablero General",{"slug":180,"title":181},"productos-mas-vendidos","Productos Más Vendidos",{"slug":183,"title":184},"compras-por-mercaderia","Compras por Mercadería",{"title":186,"modules":187},"Configuracion",[188,191,194,197,200,203,206,209,212,215,218],{"slug":189,"title":190},"configuracion-general","Configuración general",{"slug":192,"title":193},"impresoras","Cómo cargar las impresoras del local",{"slug":195,"title":196},"perfiles-de-impresion","Cómo usar los perfiles de impresión",{"slug":198,"title":199},"usuarios-del-sistema","Cómo administrar los Usuarios del Sistema",{"slug":201,"title":202},"usuarios-con-pin","Cómo administrar los Usuarios con PIN",{"slug":204,"title":205},"punto-de-venta","🏛️ Trámite en ARCA (con clave fiscal)",{"slug":207,"title":208},"permisos-por-rol","Cómo configurar los Permisos por Rol",{"slug":210,"title":211},"turnos-mesa","Turnos de Mesa",{"slug":213,"title":214},"medios-de-cobro","Medios de cobro",{"slug":216,"title":217},"clasificacion-de-gastos","Clasificación de Gastos",{"slug":219,"title":220},"centros-de-costo","Centros de Costo",{"title":222,"modules":223},"Biblioteca de Drivers",[224,226,229,232,235,238,241,244,247],{"slug":225,"title":222},"biblioteca-de-drivers",{"slug":227,"title":228},"sam4s-giant-100","Sam4S Giant - 100",{"slug":230,"title":231},"citizen-ct-s310ii","Citizen CT-S310II",{"slug":233,"title":234},"epson-tm-t20","Epson TM-T20",{"slug":236,"title":237},"drivers-genericos","Drivers Genéricos POS",{"slug":239,"title":240},"epson-tm-t88","Epson TM-T88V",{"slug":242,"title":243},"fiscalberry-windows","Instalar Fiscalberry en Windows",{"slug":245,"title":246},"fiscalberry-linux","Instalar Fiscalberry en Linux",{"slug":248,"title":249},"fiscalberry-android","Instalar Fiscalberry en Android",{"title":251,"modules":252},"Extra",[253,256,259,262,265,268,271,274,277,280],{"slug":254,"title":255},"01-faq-solucion-inicial-pantalla-congelada","📖 Manual de Usuario: Solución Inicial si la Pantalla se Congela o no Carga",{"slug":257,"title":258},"03-faq-mozo-reabrir-mesa-anulada","📖 Manual de Usuario: Cómo Reabrir una Mesa Anulada o Cerrada por Error",{"slug":260,"title":261},"05-faq-cajero-emitir-factura-a","📖 Manual de Usuario: Cómo Emitir una Factura A Cargando Datos del Cliente",{"slug":263,"title":264},"06-faq-cajero-ingreso-egreso-cajon","📖 Manual de Usuario: Cómo Registrar Entradas y Salidas de Dinero del Cajón",{"slug":266,"title":267},"07-faq-cajero-activar-medio-pago","📖 Manual de Usuario: Cómo Activar un Medio de Pago que no Aparece al Cobrar",{"slug":269,"title":270},"08-faq-cajero-diferencia-facturado-vs-abiertas","📖 Manual de Usuario: Diferencia entre \"Facturado Total Mesas\" y \"Abiertas Por Usuario\" en Caja",{"slug":272,"title":273},"10-faq-supervisor-cierre-caja-diferencias","📖 Manual de Usuario: Cómo Auditar y Solucionar Diferencias en el Cierre de Caja",{"slug":275,"title":276},"preguntas-frecuentes","Preguntas Frecuentes y Guías Rápidas por Rol",{"slug":278,"title":279},"buchon-bot","Buchón Bot",{"slug":281,"title":282},"troubleshooting-semantico","📖 Guía Única de Resolución de Problemas y Errores (Troubleshooting)"],"uses":{}},{"type":"data","data":[{"slug":1,"title":2,"content":3,"tableOfContents":4,"seo":27,"llmTxtFile":31},"historico-de-mesas","Histórico de Mesas","\u003Cdiv id=\"historico-de-mesas\">\u003C/div>\n\n\u003Cblockquote>\n\u003Cp>\u003Cstrong>¿Dónde está en el sistema?:\u003C/strong> Menú principal → \u003Cstrong>Finanzas\u003C/strong> → \u003Cstrong>Facturación AFIP\u003C/strong> → \u003Cstrong>Historico de Mesas\u003C/strong>\n\u003Cstrong>¿Quién lo usa?:\u003C/strong> Encargados de salón, cajeros y auditores\u003C/p>\n\u003C/blockquote>\n\u003Cblockquote>\n\u003Cp>🎯 \u003Cstrong>¿Para qué sirve esto?\u003C/strong>\nAcá ves todas las mesas que ya pasaron, una por renglón, con su mozo, su total y cómo se cobraron.\nPodés buscar una mesa vieja, ver su detalle, bajar la lista a Excel o cargar a mano una mesa que faltó.\u003C/p>\n\u003C/blockquote>\n\u003Cblockquote>\n\u003Cp>💡 \u003Cstrong>Ojo con los nombres:\u003C/strong> el menú y los botones usan el nombre que tenga tu comercio. Si tu comercio usa &quot;Pedido&quot; en vez de &quot;Mesa&quot;, vas a leer \u003Cstrong>Abrir Pedido\u003C/strong>.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🔑 Antes de empezar\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"antes-de-empezar\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"antes-de-empezar\">\u003C/div>\n\n\u003Cul>\n\u003Cli>Tu usuario tiene que tener el permiso de facturación AFIP en \u003Ca href=\"/user-guide/permisos-por-rol\">Permisos por Rol\u003C/a>.\u003C/li>\n\u003Cli>Para ver los botones de cada renglón, también necesitás el permiso de anular mesas.\u003C/li>\n\u003Cli>Esta pantalla \u003Cstrong>no emite facturas\u003C/strong>. La factura se emite desde la mesa, en el Salón.\u003C/li>\n\u003Cli>Para ver solo los cobros, mirá \u003Ca href=\"/user-guide/transacciones-de-cobro\">Transacciones de Cobro\u003C/a>.\u003C/li>\n\u003C/ul>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                📍 Paso 1: Entrá a la pantalla\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-1-entra-a-la-pantalla\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-1-entra-a-la-pantalla\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/70-finanzas/81-00a-menu-grupo-finanzas.png\" alt=\"Menú lateral con el grupo Finanzas marcado en rojo\">\u003C/p>\n\u003Col>\n\u003Cli>En el menú de la izquierda, tocá \u003Cstrong>Finanzas\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/70-finanzas/81-00b-menu-opcion-historico-de-mesas.png\" alt=\"Opción Historico de Mesas marcada en rojo, debajo del título Facturación AFIP\">\u003C/p>\n\u003Col start=\"2\">\n\u003Cli>Tocá \u003Cstrong>Historico de Mesas\u003C/strong>. Está debajo del título \u003Cstrong>FACTURACIÓN AFIP\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/70-finanzas/81-01-pantalla-historico-de-mesas.png\" alt=\"Pantalla Mesas con el buscador arriba y la lista de mesas abajo\">\u003C/p>\n\u003Cp>Se abre la pantalla \u003Cstrong>Mesas\u003C/strong>. Arriba tenés el buscador. Abajo, un renglón por mesa. Las columnas dicen:\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>#ID\u003C/strong>: el número interno de la mesa.\u003C/li>\n\u003Cli>\u003Cstrong>Mesa\u003C/strong>: el número o nombre que le pusieron.\u003C/li>\n\u003Cli>\u003Cstrong>Mozo\u003C/strong>: quién la atendió.\u003C/li>\n\u003Cli>\u003Cstrong>Cubiertos\u003C/strong>: cuántas personas había.\u003C/li>\n\u003Cli>\u003Cstrong>Cliente\u003C/strong>: a quién se le asoció, si se cargó.\u003C/li>\n\u003Cli>\u003Cstrong>Estado\u003C/strong>: por ejemplo \u003Cstrong>Facturada\u003C/strong>, \u003Cstrong>Checkout\u003C/strong> o \u003Cstrong>Pendiente\u003C/strong>.\u003C/li>\n\u003Cli>\u003Cstrong>Total\u003C/strong> y \u003Cstrong>Descuento\u003C/strong>: lo que se cobró y el descuento aplicado.\u003C/li>\n\u003Cli>\u003Cstrong>Cobros\u003C/strong>: con qué medio pagó y cuánto. Si la celda sale en rojo, lo cobrado no coincide con el total.\u003C/li>\n\u003Cli>\u003Cstrong>CAE Factura\u003C/strong>: el número de la factura electrónica, si se emitió.\u003C/li>\n\u003Cli>\u003Cstrong>Checkin\u003C/strong>, \u003Cstrong>Checkout\u003C/strong> y \u003Cstrong>Tiempo de permanencia\u003C/strong>: cuándo empezó, cuándo terminó y cuánto duró.\u003C/li>\n\u003Cli>\u003Cstrong>Creador\u003C/strong>: quién la cargó.\u003C/li>\n\u003Cli>\u003Cstrong>Acciones\u003C/strong>: los botones de cada renglón (Paso 4).\u003C/li>\n\u003C/ul>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🔎 Paso 2: Buscá una mesa\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-2-busca-una-mesa\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-2-busca-una-mesa\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/70-finanzas/81-03-buscador-completo.png\" alt=\"Buscador completo con Filtrar por fechas desplegado, los botones Excel y Buscar\">\u003C/p>\n\u003Cp>En el recuadro \u003Cstrong>Filtros de Búsqueda\u003C/strong> tenés estos casilleros:\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Mesa\u003C/strong>: escribí el número. Por ejemplo: \u003Cem>10\u003C/em>.\u003C/li>\n\u003Cli>\u003Cstrong>Importe\u003C/strong>: escribí el total. Por ejemplo: \u003Cem>1500\u003C/em>.\u003C/li>\n\u003Cli>\u003Cstrong>Mozo\u003C/strong>: elegí quién la atendió.\u003C/li>\n\u003Cli>\u003Cstrong>Estado\u003C/strong>: elegí \u003Cstrong>Abierta\u003C/strong>, \u003Cstrong>Facturada\u003C/strong>, \u003Cstrong>Cobrada\u003C/strong>, etc.\u003C/li>\n\u003Cli>\u003Cstrong>Cliente\u003C/strong>: elegí un cliente.\u003C/li>\n\u003Cli>\u003Cstrong>Centro de Costo\u003C/strong>: aparece solo si tu comercio los usa.\u003C/li>\n\u003Cli>\u003Cstrong>Filtrar por fechas\u003C/strong>: tocalo para abrir los casilleros de fechas. Cada uno tiene \u003Cstrong>Desde\u003C/strong> y \u003Cstrong>Hasta\u003C/strong>:\u003Cul>\n\u003Cli>\u003Cstrong>Creada\u003C/strong>: cuándo se abrió la mesa.\u003C/li>\n\u003Cli>\u003Cstrong>Checkin\u003C/strong>: cuándo empezó.\u003C/li>\n\u003Cli>\u003Cstrong>Checkout\u003C/strong>: cuándo terminó.\u003C/li>\n\u003Cli>\u003Cstrong>Cerrada\u003C/strong>: cuándo se cerró.\u003C/li>\n\u003Cli>\u003Cstrong>Cobrada\u003C/strong>: cuándo se cobró.\u003C/li>\n\u003C/ul>\n\u003C/li>\n\u003Cli>\u003Cstrong>Descuentos\u003C/strong>: tildá uno para ver solo las mesas con ese descuento.\u003C/li>\n\u003Cli>\u003Cstrong>Incluir anuladas\u003C/strong>: tildalo para buscar las mesas anuladas.\u003C/li>\n\u003Cli>\u003Cstrong>Excel\u003C/strong>: baja la lista con lo que buscaste a un archivo de Excel.\u003C/li>\n\u003Cli>\u003Cstrong>Buscar\u003C/strong>: el botón azul. Aplica lo que completaste.\u003C/li>\n\u003C/ul>\n\u003Col>\n\u003Cli>Completá solo lo que necesites.\u003C/li>\n\u003Cli>Tocá \u003Cstrong>Buscar\u003C/strong>.\u003C/li>\n\u003Cli>La lista muestra solo las mesas que coinciden.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/70-finanzas/81-04-lista-filtrada.png\" alt=\"Lista con una sola mesa encontrada, con sus datos y los botones de la derecha\">\u003C/p>\n\u003Cblockquote>\n\u003Cp>⚠️ \u003Cstrong>Atención:\u003C/strong> con \u003Cstrong>Incluir anuladas\u003C/strong> la lista muestra solo las anuladas, no todas juntas. En nuestras pruebas la tabla salió vacía: si te pasa, destildalo.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                👁 Paso 3: Mirá el detalle de una mesa\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-3-mira-el-detalle-de-una-mesa\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-3-mira-el-detalle-de-una-mesa\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/70-finanzas/81-05-renglon-con-menu-abierto.png\" alt=\"Renglón de una mesa con el ojo, el lápiz y el menú de los tres puntos abierto: Reabrir, Imprimir Ticket, Ver detalles y Anular\">\u003C/p>\n\u003Cp>En \u003Cstrong>Acciones\u003C/strong> de cada renglón hay tres botones:\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Ojo\u003C/strong> 👁: abre el detalle de la mesa.\u003C/li>\n\u003Cli>\u003Cstrong>Lápiz\u003C/strong> ✏️: abre la mesa para cambiar sus datos.\u003C/li>\n\u003Cli>\u003Cstrong>Tres puntos\u003C/strong> ⋮: abre más opciones (Paso 4).\u003C/li>\n\u003C/ul>\n\u003Col>\n\u003Cli>Tocá el \u003Cstrong>ojo\u003C/strong> 👁 del renglón.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/70-finanzas/81-07-pantalla-ver-detalles.png\" alt=\"Ventanita Detalles de Mesa con Estadía, Información General y Cliente\">\u003C/p>\n\u003Cp>Se abre la ventanita \u003Cstrong>Detalles de Mesa\u003C/strong>. Bajando ves:\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Estadía\u003C/strong>: cuándo empezó, cuándo terminó y cuánto duró.\u003C/li>\n\u003Cli>\u003Cstrong>Información General\u003C/strong>: cubiertos, mozo, creador, fechas y total.\u003C/li>\n\u003Cli>\u003Cstrong>Cliente\u003C/strong>: quién es, si la mesa tiene uno.\u003C/li>\n\u003Cli>Más abajo: los pedidos, los cobros y el resumen de pagos.\u003C/li>\n\u003Cli>\u003Cstrong>Facturas AFIP\u003C/strong>: solo aparece si la mesa ya tiene una factura.\u003C/li>\n\u003C/ul>\n\u003Cp>\u003Cimg src=\"/images/manual/70-finanzas/81-08-botones-del-detalle.png\" alt=\"Botones Imprimir Ticket, Editar y Anular arriba a la derecha del detalle\">\u003C/p>\n\u003Cp>Arriba a la derecha hay tres botones:\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Imprimir Ticket\u003C/strong>: imprime el ticket de la mesa.\u003C/li>\n\u003Cli>\u003Cstrong>Editar\u003C/strong>: abre la mesa para cambiar sus datos.\u003C/li>\n\u003Cli>\u003Cstrong>Anular\u003C/strong>: anula la mesa.\u003C/li>\n\u003C/ul>\n\u003Cblockquote>\n\u003Cp>⚠️ \u003Cstrong>Atención:\u003C/strong> \u003Cstrong>Imprimir Ticket\u003C/strong> imprime de verdad. \u003Cstrong>Anular\u003C/strong> saca la mesa de las estadísticas. No los toques si no estás seguro.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                ⋮ Paso 4: Usá el menú de tres puntos\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-4-usa-el-menu-de-tres-puntos\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-4-usa-el-menu-de-tres-puntos\">\u003C/div>\n\n\u003Col>\n\u003Cli>En el renglón, tocá los \u003Cstrong>tres puntos\u003C/strong> ⋮. Está a la derecha.\u003C/li>\n\u003C/ol>\n\u003Cp>Se abre la lista que ves en la foto del Paso 3, con estas opciones:\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Reabrir\u003C/strong>: vuelve a abrir la mesa para seguir cargándole cosas. Solo aparece si la mesa no está abierta.\u003C/li>\n\u003Cli>\u003Cstrong>Imprimir Ticket\u003C/strong>: imprime el ticket de la mesa.\u003C/li>\n\u003Cli>\u003Cstrong>Ver detalles\u003C/strong>: abre el detalle, igual que el ojo.\u003C/li>\n\u003Cli>\u003Cstrong>Anular\u003C/strong>: anula la mesa.\u003C/li>\n\u003C/ul>\n\u003Cblockquote>\n\u003Cp>⚠️ \u003Cstrong>Atención:\u003C/strong> \u003Cstrong>Reabrir\u003C/strong>, \u003Cstrong>Imprimir Ticket\u003C/strong> y \u003Cstrong>Anular\u003C/strong> actúan al instante después de confirmar. Una mesa anulada deja de contar en las estadísticas.\u003C/p>\n\u003C/blockquote>\n\u003Cp>Si anulás una mesa, la lista la muestra en rojo con un botón verde para \u003Cstrong>Restaurar\u003C/strong> (las flechas 🔄). Al tocarlo, el sistema te pide confirmar.\u003C/p>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                ➕ Paso 5: Abrí una mesa a mano\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-5-abri-una-mesa-a-mano\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-5-abri-una-mesa-a-mano\">\u003C/div>\n\n\u003Cp>Sirve para cargar una mesa que quedó sin registrar. Por ejemplo, una venta de días atrás.\u003C/p>\n\u003Cp>\u003Cimg src=\"/images/manual/70-finanzas/81-02-donde-esta-boton-abrir-mesa.png\" alt=\"Pantalla Mesas con el botón verde Abrir Mesa marcado en rojo arriba a la derecha\">\u003C/p>\n\u003Col>\n\u003Cli>Tocá el botón verde \u003Cstrong>Abrir Mesa\u003C/strong>, arriba a la derecha.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/70-finanzas/81-09-pantalla-abrir-mesa.png\" alt=\"Pantalla Agregar Mesa vacía\">\u003C/p>\n\u003Cp>Se abre la pantalla \u003Cstrong>Agregar Mesa\u003C/strong>. Completala así:\u003C/p>\n\u003Cp>\u003Cimg src=\"/images/manual/70-finanzas/81-10-formulario-abrir-mesa.png\" alt=\"Pantalla Agregar Mesa completa con datos de ejemplo y los botones Agregar y Cancelar\">\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Listar Mesa\u003C/strong>: el botón de arriba a la derecha. Vuelve a la lista sin guardar.\u003C/li>\n\u003Cli>\u003Cstrong>Número de Mesa\u003C/strong>: escribí el número. Por ejemplo: \u003Cem>99\u003C/em>.\u003C/li>\n\u003Cli>\u003Cstrong>Mozo\u003C/strong>: elegí quién la atendió.\u003C/li>\n\u003Cli>\u003Cstrong>Tipo Entrega\u003C/strong>: elegí \u003Cstrong>En Salón\u003C/strong>, \u003Cstrong>Es Delivery\u003C/strong> o \u003Cstrong>Es Take Away\u003C/strong>.\u003C/li>\n\u003Cli>\u003Cstrong>Es Pedimelo Online\u003C/strong>: tildalo si vino de tu menú online.\u003C/li>\n\u003Cli>\u003Cstrong>Es Reserva\u003C/strong>: tildalo si es una reserva.\u003C/li>\n\u003Cli>\u003Cstrong>Checkin\u003C/strong> y \u003Cstrong>Checkout\u003C/strong>: la fecha y hora de entrada y de salida.\u003C/li>\n\u003Cli>\u003Cstrong>Cliente\u003C/strong>: elegí uno si querés. Puede quedar sin elegir.\u003C/li>\n\u003Cli>\u003Cstrong>Fecha de Facturación\u003C/strong>: cuándo se cerró la cuenta.\u003C/li>\n\u003Cli>\u003Cstrong>Importe Total\u003C/strong>: cuánto se cobró. Por ejemplo: \u003Cem>1500\u003C/em>.\u003C/li>\n\u003Cli>\u003Cstrong>Salon Mesa\u003C/strong>: la mesa del salón donde estuvo.\u003C/li>\n\u003Cli>\u003Cstrong>Estado\u003C/strong>: por ejemplo \u003Cstrong>Cobrada\u003C/strong>. Al elegir \u003Cstrong>Cobrada\u003C/strong> aparecen dos casilleros más.\u003C/li>\n\u003Cli>\u003Cstrong>Tipo De Pago\u003C/strong>: con qué pagó. Por ejemplo: \u003Cem>Transferencia bancaria\u003C/em>.\u003C/li>\n\u003Cli>\u003Cstrong>Monto a Pagar\u003C/strong>: cuánto pagó. Se completa solo con el importe.\u003C/li>\n\u003Cli>\u003Cstrong>Agregar\u003C/strong>: el botón verde de abajo. Guarda la mesa.\u003C/li>\n\u003Cli>\u003Cstrong>Cancelar\u003C/strong>: sale sin guardar nada.\u003C/li>\n\u003C/ul>\n\u003Cblockquote>\n\u003Cp>⚠️ \u003Cstrong>Atención:\u003C/strong> al tocar \u003Cstrong>Agregar\u003C/strong> se crea la mesa y, si está \u003Cstrong>Cobrada\u003C/strong>, también el cobro. Revisá los datos antes.\u003C/p>\n\u003C/blockquote>\n\u003Col>\n\u003Cli>Completá los datos.\u003C/li>\n\u003Cli>Tocá \u003Cstrong>Agregar\u003C/strong> para guardar, o \u003Cstrong>Cancelar\u003C/strong> para salir.\u003C/li>\n\u003C/ol>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                ⚠️ ¿Qué hacer si algo no sale bien?\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"que-hacer-si-algo-no-sale-bien\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"que-hacer-si-algo-no-sale-bien\">\u003C/div>\n\n\u003Cdiv class=\"table-wrapper\">\u003Ctable>\n\u003Cthead>\n\u003Ctr>\n\u003Cth>Problema\u003C/th>\n\u003Cth>Causa más frecuente\u003C/th>\n\u003Cth>Solución recomendada\u003C/th>\n\u003C/tr>\n\u003C/thead>\n\u003Ctbody>\u003Ctr>\n\u003Ctd>Busco el botón \u003Cstrong>Facturar\u003C/strong> y no está.\u003C/td>\n\u003Ctd>Esta pantalla no emite facturas.\u003C/td>\n\u003Ctd>Emití la factura desde la mesa, en el Salón.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>No veo los botones del renglón.\u003C/td>\n\u003Ctd>Tu usuario no puede anular mesas.\u003C/td>\n\u003Ctd>Pedile el permiso a quien administra el sistema.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>La lista sale vacía.\u003C/td>\n\u003Ctd>Los filtros no coinciden con ninguna mesa.\u003C/td>\n\u003Ctd>Borrá los filtros y tocá \u003Cstrong>Buscar\u003C/strong> de nuevo.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>Con \u003Cstrong>Incluir anuladas\u003C/strong> la lista sale vacía.\u003C/td>\n\u003Ctd>La pantalla no muestra las anuladas en este caso.\u003C/td>\n\u003Ctd>Destildalo y buscá por número de mesa.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>La celda de \u003Cstrong>Cobros\u003C/strong> sale en rojo.\u003C/td>\n\u003Ctd>Lo cobrado no coincide con el total de la mesa.\u003C/td>\n\u003Ctd>Abrí el detalle y revisá los cobros.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>No aparece \u003Cstrong>Reabrir\u003C/strong>.\u003C/td>\n\u003Ctd>La mesa ya está abierta.\u003C/td>\n\u003Ctd>Solo se reabren mesas cerradas o cobradas.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>Cambié un dato y la lista no cambia.\u003C/td>\n\u003Ctd>Falta tocar \u003Cstrong>Buscar\u003C/strong>.\u003C/td>\n\u003Ctd>Tocá \u003Cstrong>Buscar\u003C/strong> para actualizar la lista.\u003C/td>\n\u003C/tr>\n\u003C/tbody>\u003C/table>\u003C/div>\n",[5,9,12,15,18,21,24],{"id":6,"title":7,"level":8},"antes-de-empezar","Antes de empezar",2,{"id":10,"title":11,"level":8},"paso-1-entra-a-la-pantalla","Paso 1: Entrá a la pantalla",{"id":13,"title":14,"level":8},"paso-2-busca-una-mesa","Paso 2: Buscá una mesa",{"id":16,"title":17,"level":8},"paso-3-mira-el-detalle-de-una-mesa","Paso 3: Mirá el detalle de una mesa",{"id":19,"title":20,"level":8},"paso-4-usa-el-menu-de-tres-puntos","⋮ Paso 4: Usá el menú de tres puntos",{"id":22,"title":23,"level":8},"paso-5-abri-una-mesa-a-mano","Paso 5: Abrí una mesa a mano",{"id":25,"title":26,"level":8},"que-hacer-si-algo-no-sale-bien","¿Qué hacer si algo no sale bien?",{"title":28,"description":29,"keywords":30},"Histórico de Mesas - Manual","¿Dónde está en el sistema?: Menú principal → Finanzas → Facturación AFIP → Historico de Mesas\n ¿Quién lo usa?: Encargados de salón, ca...","historico de mesas, paxapos, histórico de mesas, tutorial, guía, manual usuario","81-historico-de-mesas.txt"],"uses":{"params":["slug"]}}]}
