{"type":"data","nodes":[null,{"type":"data","data":[{"moduleCategories":1},[2,17,44,53,77,98,110,140,146,173,185,221,250],{"title":3,"modules":4},"Comenzamos",[5,8,11,14],{"slug":6,"title":7},"introduccion","Bienvenido a tu software gastronómico",{"slug":9,"title":10},"iniciar-sesion","Cómo Iniciar Sesión",{"slug":12,"title":13},"recuperar-contrasena","Cómo Recuperar tu Contraseña",{"slug":15,"title":16},"guia-de-inicio-rapido","Guía de Inicio Rápido",{"title":18,"modules":19},"Ventas",[20,23,26,29,32,35,38,41],{"slug":21,"title":22},"salon-de-ventas","Cómo Usar el Salón de Ventas (Adición)",{"slug":24,"title":25},"caja-rapida","Cómo Usar la Caja Rápida (Registradora)",{"slug":27,"title":28},"mozos","Cómo Cargar los Mozos",{"slug":30,"title":31},"clientes","Cómo Gestionar los Clientes",{"slug":33,"title":34},"descuentos","Cómo Configurar Descuentos",{"slug":36,"title":37},"nueva-reserva","Cómo Cargar una Nueva Reserva",{"slug":39,"title":40},"listado-de-reservas","Cómo Usar el Listado de Reservas",{"slug":42,"title":43},"grilla-de-reservas","Cómo Usar la Grilla de Reservas",{"title":45,"modules":46},"Medios de Pago",[47,50],{"slug":48,"title":49},"configuracion-procesadores","Configuración de Procesadores de Pago",{"slug":51,"title":52},"transacciones-mercadopago","Transacciones MercadoPago",{"title":54,"modules":55},"Productos",[56,59,62,65,68,71,74],{"slug":57,"title":58},"menu","Menú de Productos (Carta)",{"slug":60,"title":61},"categorias","Categorías de Productos",{"slug":63,"title":64},"variantes-grupo-sabores","Variantes y Grupos de Sabores",{"slug":66,"title":67},"maestro-de-productos","Maestro de Productos",{"slug":69,"title":70},"subproductos-elaborados","Sub-Productos (Elaborados)",{"slug":72,"title":73},"recetas","Recetas",{"slug":75,"title":76},"analisis-duplicados","Buscar Duplicados",{"title":78,"modules":79},"Compras",[80,83,86,89,92,95],{"slug":81,"title":82},"todas-las-ordenes-compra","Órdenes de Compra",{"slug":84,"title":85},"crear-orden-compra","Crear una Orden de Compra",{"slug":87,"title":88},"ordenes-a-aprobar","Órdenes a aprobar",{"slug":90,"title":91},"mercaderias","Mercaderías",{"slug":93,"title":94},"proveedores","Proveedores",{"slug":96,"title":97},"historial-de-compras","Historial de Compras",{"title":99,"modules":100},"Stock",[101,104,107],{"slug":102,"title":103},"stock-mercaderias","Stock de Mercaderías",{"slug":105,"title":106},"stock-subproductos","Stock de Subproductos",{"slug":108,"title":109},"movimientos-de-stock","Movimientos de Stock",{"title":111,"modules":112},"Finanzas",[113,116,119,122,125,128,131,134,137],{"slug":114,"title":115},"arqueos-de-caja","Arqueos de Caja",{"slug":117,"title":118},"listado-de-cajas","Listado de Cajas",{"slug":120,"title":121},"transacciones-de-cobro","Transacciones de Cobro",{"slug":123,"title":124},"factura-manual","Factura Manual",{"slug":126,"title":127},"resumen-de-deuda","Resumen de Deuda",{"slug":129,"title":130},"pagos","Pagos",{"slug":132,"title":133},"historial-de-facturas","Historial de Facturas",{"slug":135,"title":136},"historico-de-mesas","Histórico de Mesas",{"slug":138,"title":139},"puntos-de-venta-pdv","Puntos de Venta (PDVs)",{"title":141,"modules":142},"Comandero",[143],{"slug":144,"title":145},"comandero","Comandero (pantalla de cocina)",{"title":147,"modules":148},"RRHH",[149,152,155,158,161,164,167,170],{"slug":150,"title":151},"empleados","Empleados",{"slug":153,"title":154},"empleados-trabajando","Empleados Trabajando",{"slug":156,"title":157},"registro-diario-fichaje","Registro Diario de Fichaje",{"slug":159,"title":160},"reporte-mensual-fichaje","Reporte Mensual de Fichaje",{"slug":162,"title":163},"departamentos","Departamentos",{"slug":165,"title":166},"turnos-y-horarios-fichaje","Turnos y Horarios de Fichaje",{"slug":168,"title":169},"sueldos-y-jornales","Sueldos y Jornales",{"slug":171,"title":172},"datos-de-acceso-app","Datos de Acceso a la App de Fichaje",{"title":174,"modules":175},"Reportes",[176,179,182],{"slug":177,"title":178},"tablero-general","Tablero General",{"slug":180,"title":181},"productos-mas-vendidos","Productos Más Vendidos",{"slug":183,"title":184},"compras-por-mercaderia","Compras por Mercadería",{"title":186,"modules":187},"Configuracion",[188,191,194,197,200,203,206,209,212,215,218],{"slug":189,"title":190},"configuracion-general","Configuración general",{"slug":192,"title":193},"impresoras","Cómo cargar las impresoras del local",{"slug":195,"title":196},"perfiles-de-impresion","Cómo usar los perfiles de impresión",{"slug":198,"title":199},"usuarios-del-sistema","Cómo administrar los Usuarios del Sistema",{"slug":201,"title":202},"usuarios-con-pin","Cómo administrar los Usuarios con PIN",{"slug":204,"title":205},"punto-de-venta","🏛️ Trámite en ARCA (con clave fiscal)",{"slug":207,"title":208},"permisos-por-rol","Cómo configurar los Permisos por Rol",{"slug":210,"title":211},"turnos-mesa","Turnos de Mesa",{"slug":213,"title":214},"medios-de-cobro","Medios de cobro",{"slug":216,"title":217},"clasificacion-de-gastos","Clasificación de Gastos",{"slug":219,"title":220},"centros-de-costo","Centros de Costo",{"title":222,"modules":223},"Biblioteca de Drivers",[224,226,229,232,235,238,241,244,247],{"slug":225,"title":222},"biblioteca-de-drivers",{"slug":227,"title":228},"sam4s-giant-100","Sam4S Giant - 100",{"slug":230,"title":231},"citizen-ct-s310ii","Citizen CT-S310II",{"slug":233,"title":234},"epson-tm-t20","Epson TM-T20",{"slug":236,"title":237},"drivers-genericos","Drivers Genéricos POS",{"slug":239,"title":240},"epson-tm-t88","Epson TM-T88V",{"slug":242,"title":243},"fiscalberry-windows","Instalar Fiscalberry en Windows",{"slug":245,"title":246},"fiscalberry-linux","Instalar Fiscalberry en Linux",{"slug":248,"title":249},"fiscalberry-android","Instalar Fiscalberry en Android",{"title":251,"modules":252},"Extra",[253,256,259,262,265,268,271,274,277,280],{"slug":254,"title":255},"01-faq-solucion-inicial-pantalla-congelada","📖 Manual de Usuario: Solución Inicial si la Pantalla se Congela o no Carga",{"slug":257,"title":258},"03-faq-mozo-reabrir-mesa-anulada","📖 Manual de Usuario: Cómo Reabrir una Mesa Anulada o Cerrada por Error",{"slug":260,"title":261},"05-faq-cajero-emitir-factura-a","📖 Manual de Usuario: Cómo Emitir una Factura A Cargando Datos del Cliente",{"slug":263,"title":264},"06-faq-cajero-ingreso-egreso-cajon","📖 Manual de Usuario: Cómo Registrar Entradas y Salidas de Dinero del Cajón",{"slug":266,"title":267},"07-faq-cajero-activar-medio-pago","📖 Manual de Usuario: Cómo Activar un Medio de Pago que no Aparece al Cobrar",{"slug":269,"title":270},"08-faq-cajero-diferencia-facturado-vs-abiertas","📖 Manual de Usuario: Diferencia entre \"Facturado Total Mesas\" y \"Abiertas Por Usuario\" en Caja",{"slug":272,"title":273},"10-faq-supervisor-cierre-caja-diferencias","📖 Manual de Usuario: Cómo Auditar y Solucionar Diferencias en el Cierre de Caja",{"slug":275,"title":276},"preguntas-frecuentes","Preguntas Frecuentes y Guías Rápidas por Rol",{"slug":278,"title":279},"buchon-bot","Buchón Bot",{"slug":281,"title":282},"troubleshooting-semantico","📖 Guía Única de Resolución de Problemas y Errores (Troubleshooting)"],"uses":{}},{"type":"data","data":[{"slug":1,"title":2,"content":3,"tableOfContents":4,"seo":42,"llmTxtFile":46},"arqueos-de-caja","Arqueos de Caja","\u003Cdiv id=\"arqueos-de-caja\">\u003C/div>\n\n\u003Cblockquote>\n\u003Cp>\u003Cstrong>¿Dónde está en el sistema?:\u003C/strong> Menú principal → \u003Cstrong>Finanzas\u003C/strong> → \u003Cstrong>Caja\u003C/strong> → \u003Cstrong>Arqueos de Caja\u003C/strong>\n\u003Cstrong>¿Quién lo usa?:\u003C/strong> Cajeros, encargados de turno y contadores\u003C/p>\n\u003C/blockquote>\n\u003Cblockquote>\n\u003Cp>🎯 \u003Cstrong>¿Para qué sirve esto?\u003C/strong>\nUn arqueo es el turno de una caja: desde que la abrís con un fondo de cambio hasta que la cerrás contando la plata.\nAcá abrís y cerrás turnos, anotás ingresos y retiros de dinero y revisás los turnos anteriores.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🔑 Antes de empezar\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"antes-de-empezar\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"antes-de-empezar\">\u003C/div>\n\n\u003Cul>\n\u003Cli>Tu usuario tiene que tener el permiso de \u003Cstrong>Arqueos\u003C/strong> en \u003Ca href=\"/user-guide/permisos-por-rol\">Permisos por Rol\u003C/a>.\u003C/li>\n\u003Cli>La caja tiene que existir y tener tu usuario tildado. Mirá \u003Ca href=\"/user-guide/listado-de-cajas\">Listado de Cajas\u003C/a>.\u003C/li>\n\u003Cli>Una caja tiene un solo turno abierto a la vez.\u003C/li>\n\u003C/ul>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                📍 Paso 1: Entrá a la pantalla\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-1-entra-a-la-pantalla\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-1-entra-a-la-pantalla\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/70-finanzas/71-00a-menu-grupo-finanzas.png\" alt=\"Menú lateral con el grupo Finanzas marcado en rojo\">\u003C/p>\n\u003Col>\n\u003Cli>En el menú de la izquierda, tocá \u003Cstrong>Finanzas\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/70-finanzas/71-00b-menu-opcion-arqueos-de-caja.png\" alt=\"Opción Arqueos de Caja marcada en rojo, debajo del título Caja\">\u003C/p>\n\u003Col start=\"2\">\n\u003Cli>Tocá \u003Cstrong>Arqueos de Caja\u003C/strong>. Está debajo del título \u003Cstrong>CAJA\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/70-finanzas/71-01-pantalla-arqueos.png\" alt=\"Pantalla Gestión de Arqueos con el aviso arriba, los filtros, los arqueos abiertos y el historial de cerrados\">\u003C/p>\n\u003Cp>De arriba hacia abajo, la pantalla tiene:\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Las cajas libres\u003C/strong>: una tarjeta por cada caja sin turno abierto. Tocá la tarjeta para abrir un turno (Paso 5).\u003C/li>\n\u003Cli>\u003Cstrong>Filtros de Búsqueda\u003C/strong>: para encontrar un turno (Paso 2).\u003C/li>\n\u003Cli>\u003Cstrong>Arqueos Abiertos - Pendientes de Cierre\u003C/strong>: los turnos que todavía no cerraste (Paso 4).\u003C/li>\n\u003Cli>\u003Cstrong>Historial de Arqueos Cerrados\u003C/strong>: los turnos terminados (Paso 3).\u003C/li>\n\u003C/ul>\n\u003Cblockquote>\n\u003Cp>⚠️ \u003Cstrong>Atención:\u003C/strong> si todas las cajas tienen un turno abierto, la pantalla dice \u003Cstrong>No hay cajas configuradas\u003C/strong>. Las cajas existen: solo no queda ninguna libre.\u003C/p>\n\u003C/blockquote>\n\u003Cp>\u003Cimg src=\"/images/manual/70-finanzas/71-02-aviso-sin-cajas-libres.png\" alt=\"Aviso No hay cajas configuradas con el botón azul Crear Primera Caja\">\u003C/p>\n\u003Cp>No toques \u003Cstrong>Crear Primera Caja\u003C/strong>. Cerrá un turno (Paso 8) para que la caja vuelva a aparecer.\u003C/p>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🔎 Paso 2: Buscá un arqueo\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-2-busca-un-arqueo\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-2-busca-un-arqueo\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/70-finanzas/71-04-filtros-de-busqueda.png\" alt=\"Recuadro Filtros de Búsqueda con Caja, Creado por, Desde, Hasta y los botones Buscar y Descargar Excel\">\u003C/p>\n\u003Cp>Este recuadro lo ve quien puede ver todos los arqueos. Tiene:\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Caja\u003C/strong>: mostrá solo una caja. Con \u003Cstrong>Todas las cajas\u003C/strong> ves todas.\u003C/li>\n\u003Cli>\u003Cstrong>Creado por\u003C/strong>: mostrá solo los turnos de un usuario.\u003C/li>\n\u003Cli>\u003Cstrong>Desde\u003C/strong> y \u003Cstrong>Hasta\u003C/strong>: elegí fecha y hora de inicio y de fin.\u003C/li>\n\u003Cli>\u003Cstrong>Buscar\u003C/strong>: el botón azul de arriba a la derecha. Aplica los filtros.\u003C/li>\n\u003Cli>\u003Cstrong>Descargar Excel\u003C/strong>: el botón azul de abajo a la derecha (Paso 9).\u003C/li>\n\u003C/ul>\n\u003Col>\n\u003Cli>Completá lo que necesites.\u003C/li>\n\u003Cli>Tocá \u003Cstrong>Buscar\u003C/strong>.\u003C/li>\n\u003Cli>El historial muestra solo los turnos que coinciden.\u003C/li>\n\u003C/ol>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                📜 Paso 3: Mirá los arqueos cerrados\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-3-mira-los-arqueos-cerrados\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-3-mira-los-arqueos-cerrados\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/70-finanzas/71-08-arqueos-cerrados.png\" alt=\"Historial de Arqueos Cerrados con columnas de importes y un botón de tres puntitos en cada renglón\">\u003C/p>\n\u003Cp>Cada renglón es un turno terminado. Las columnas dicen:\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Caja\u003C/strong>, \u003Cstrong>Inicio\u003C/strong>, \u003Cstrong>Cierre\u003C/strong> y \u003Cstrong>Hora\u003C/strong>: dónde y cuándo se abrió y se cerró.\u003C/li>\n\u003Cli>\u003Cstrong>Importe Final\u003C/strong>: la plata que se contó al cerrar.\u003C/li>\n\u003Cli>\u003Cstrong>Saldo con Arqueo Ant.\u003C/strong>: diferencia entre lo que quedó al cerrar el turno anterior y lo que se puso al abrir este.\u003C/li>\n\u003Cli>\u003Cstrong>Saldo de caja\u003C/strong>: diferencia entre lo que debía haber y lo que se contó. Verde es sin diferencia y rojo es diferencia grande.\u003C/li>\n\u003Cli>\u003Cstrong>Cobros\u003C/strong>, \u003Cstrong>Pagos\u003C/strong>, \u003Cstrong>Ingresos\u003C/strong> y \u003Cstrong>Egresos\u003C/strong>: el movimiento de efectivo del turno.\u003C/li>\n\u003Cli>\u003Cstrong>Cobrado\u003C/strong>, \u003Cstrong>Facturado\u003C/strong> y \u003Cstrong>Anulado\u003C/strong>: los totales de ventas del turno.\u003C/li>\n\u003Cli>\u003Cstrong>Creador\u003C/strong>: quién abrió el turno.\u003C/li>\n\u003Cli>\u003Cstrong>Acciones\u003C/strong>: el botón de tres puntitos.\u003C/li>\n\u003C/ul>\n\u003Cp>\u003Cimg src=\"/images/manual/70-finanzas/71-09-menu-mas-opciones.png\" alt=\"Menú del botón de tres puntitos con Ver y Acciones\">\u003C/p>\n\u003Cp>Al tocar los tres puntitos se abre una lista con:\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Ver\u003C/strong>: abre el detalle del turno.\u003C/li>\n\u003Cli>\u003Cstrong>Acciones\u003C/strong>: abre otra lista (Paso 7).\u003C/li>\n\u003C/ul>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🔓 Paso 4: Mirá los arqueos abiertos\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-4-mira-los-arqueos-abiertos\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-4-mira-los-arqueos-abiertos\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/70-finanzas/71-06-arqueos-abiertos.png\" alt=\"Recuadro Arqueos Abiertos con las columnas Caja, Inicial, Iniciado, Cobrado, Creador y Acciones\">\u003C/p>\n\u003Cp>Cada renglón es un turno que todavía no cerraste:\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Caja\u003C/strong>: cuál es la caja.\u003C/li>\n\u003Cli>\u003Cstrong>Inicial\u003C/strong>: la plata con la que abriste. Por ejemplo: \u003Cem>$10.000,00\u003C/em>.\u003C/li>\n\u003Cli>\u003Cstrong>Iniciado\u003C/strong>: cuándo lo abriste.\u003C/li>\n\u003Cli>\u003Cstrong>Cobrado\u003C/strong>: lo que se cobró en efectivo en el turno.\u003C/li>\n\u003Cli>\u003Cstrong>Creador\u003C/strong>: quién lo abrió.\u003C/li>\n\u003C/ul>\n\u003Cp>\u003Cimg src=\"/images/manual/70-finanzas/71-07-barra-de-iconos-del-arqueo.png\" alt=\"Cuatro botones de un renglón: ojo, lápiz, candado azules y tacho rojo\">\u003C/p>\n\u003Cp>Al final de cada renglón hay cuatro botones:\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>👁 (ojo)\u003C/strong>: mirá el detalle del turno (Paso 6).\u003C/li>\n\u003Cli>\u003Cstrong>✏️ (lápiz)\u003C/strong>: corregí los importes (Paso 10).\u003C/li>\n\u003Cli>\u003Cstrong>🔒 (candado)\u003C/strong>: cerrá el turno (Paso 8).\u003C/li>\n\u003Cli>\u003Cstrong>🗑 (tacho)\u003C/strong>: borra el turno.\u003C/li>\n\u003C/ul>\n\u003Cblockquote>\n\u003Cp>⚠️ \u003Cstrong>Atención:\u003C/strong> el tacho borra el turno. Los cobros y pagos quedan sin turno asignado. Usalo solo si te equivocaste al abrirlo.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                ➕ Paso 5: Abrí un arqueo\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-5-abri-un-arqueo\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-5-abri-un-arqueo\">\u003C/div>\n\n\u003Col>\n\u003Cli>En \u003Cstrong>Gestión de Arqueos\u003C/strong>, tocá la tarjeta de la caja libre que querés abrir. También podés tocar el \u003Cstrong>➕\u003C/strong> de esa caja en \u003Ca href=\"/user-guide/listado-de-cajas\">Listado de Cajas\u003C/a>.\u003C/li>\n\u003Cli>Se abre una ventana con el título \u003Cstrong>Nuevo Arqueo de\u003C/strong> y el nombre de la caja.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/70-finanzas/71-14-pantalla-abrir-arqueo.png\" alt=\"Formulario Nuevo Arqueo de Caja Prueba Manual con Importe Inicial 10000, Moneda ARS y el botón azul Abrir Arqueo\">\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Importe Inicial\u003C/strong>: escribí cuánta plata ponés en la caja para dar cambio. Por ejemplo: \u003Cem>10000\u003C/em>.\u003C/li>\n\u003Cli>\u003Cstrong>Moneda de esta caja\u003C/strong>: elegí la moneda. Por ejemplo: \u003Cem>ARS\u003C/em>.\u003C/li>\n\u003Cli>\u003Cstrong>Abrir Arqueo\u003C/strong>: el botón azul de abajo. Abre el turno.\u003C/li>\n\u003C/ul>\n\u003Col start=\"3\">\n\u003Cli>Tocá \u003Cstrong>Abrir Arqueo\u003C/strong>.\u003C/li>\n\u003Cli>El turno aparece en \u003Cstrong>Arqueos Abiertos - Pendientes de Cierre\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cblockquote>\n\u003Cp>💡 \u003Cstrong>Consejo útil:\u003C/strong> desde el momento en que abrís, los cobros en efectivo de tu turno se suman a esta caja.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                👁️ Paso 6: Mirá el detalle de un arqueo\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-6-mira-el-detalle-de-un-arqueo\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-6-mira-el-detalle-de-un-arqueo\">\u003C/div>\n\n\u003Col>\n\u003Cli>Tocá el ojo del turno que querés ver.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/70-finanzas/71-10-pantalla-detalle-del-arqueo.png\" alt=\"Detalle del arqueo abierto con el resumen de caja, la información del turno y los botones Ingreso, Retiro y Acciones arriba\">\u003C/p>\n\u003Cp>Arriba a la izquierda dice \u003Cstrong>Arqueo Abierto\u003C/strong> o \u003Cstrong>Arqueo Cerrado\u003C/strong>. Después ves:\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Movimientos de Efectivo\u003C/strong>: el \u003Cstrong>Importe Inicial\u003C/strong>, más los cobros y los ingresos, menos los pagos y los retiros.\u003C/li>\n\u003Cli>\u003Cstrong>SALDO Faltante\u003C/strong>: cuánto falta para llegar al importe final que cargues al cerrar.\u003C/li>\n\u003Cli>\u003Cstrong>Información del Turno\u003C/strong>: quién lo abrió y cuándo.\u003C/li>\n\u003Cli>\u003Cstrong>Resumen de Ventas\u003C/strong>: lo facturado, las mesas abiertas y las anulaciones.\u003C/li>\n\u003Cli>\u003Cstrong>Detalle de Movimientos\u003C/strong>: cada ingreso, egreso y retiro del turno.\u003C/li>\n\u003Cli>\u003Cstrong>¿Por qué no cierra?\u003C/strong>: te ayuda a encontrar diferencias.\u003C/li>\n\u003C/ul>\n\u003Cp>Arriba a la derecha están los botones \u003Cstrong>Ingreso\u003C/strong>, \u003Cstrong>Retiro\u003C/strong> y \u003Cstrong>Acciones\u003C/strong>.\u003C/p>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                💵 Paso 7: Anotá un ingreso o un retiro de dinero\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-7-anota-un-ingreso-o-un-retiro-de-dinero\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-7-anota-un-ingreso-o-un-retiro-de-dinero\">\u003C/div>\n\n\u003Cp>Estos botones aparecen solo mientras el turno está abierto.\u003C/p>\n\u003Ch3>Ingreso\u003C/h3>\n\u003Cp>\u003Cimg src=\"/images/manual/70-finanzas/71-12-ventana-ingreso.png\" alt=\"Ventanita Ingreso de Dinero con Monto 1500, una aclaración, la observación y los botones Registrar Ingreso y Cancelar\">\u003C/p>\n\u003Col>\n\u003Cli>Tocá el botón verde \u003Cstrong>Ingreso\u003C/strong>.\u003C/li>\n\u003Cli>Se abre la ventanita \u003Cstrong>Ingreso de Dinero\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cul>\n\u003Cli>\u003Cstrong>Monto\u003C/strong>: cuánta plata entra. Por ejemplo: \u003Cem>1500\u003C/em>.\u003C/li>\n\u003Cli>\u003Cstrong>Observación\u003C/strong>: el motivo. Por ejemplo: \u003Cem>Cambio para la caja\u003C/em>.\u003C/li>\n\u003Cli>\u003Cstrong>Registrar Ingreso\u003C/strong>: anota el ingreso de verdad.\u003C/li>\n\u003Cli>\u003Cstrong>Cancelar\u003C/strong>: cierra la ventanita sin anotar nada.\u003C/li>\n\u003C/ul>\n\u003Cblockquote>\n\u003Cp>⚠️ \u003Cstrong>Atención:\u003C/strong> si la plata viene de otra caja, no la anotes acá. Esa caja tiene que hacer un \u003Cstrong>Retiro\u003C/strong> hacia esta.\u003C/p>\n\u003C/blockquote>\n\u003Ch3>Retiro\u003C/h3>\n\u003Cp>\u003Cimg src=\"/images/manual/70-finanzas/71-13-ventana-retiro.png\" alt=\"Ventanita Retiro de Dinero con Monto 2000, A Caja opcional, la observación y los botones Registrar Retiro y Cancelar\">\u003C/p>\n\u003Col>\n\u003Cli>Tocá el botón naranja \u003Cstrong>Retiro\u003C/strong>.\u003C/li>\n\u003Cli>Se abre la ventanita \u003Cstrong>Retiro de Dinero\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cul>\n\u003Cli>\u003Cstrong>Monto\u003C/strong>: cuánta plata sale. Por ejemplo: \u003Cem>2000\u003C/em>.\u003C/li>\n\u003Cli>\u003Cstrong>A Caja (opcional)\u003C/strong>: si la plata va a otra caja, elegila. Esa caja recibe el ingreso sola. Si no, dejá \u003Cstrong>Sin especificar\u003C/strong>.\u003C/li>\n\u003Cli>\u003Cstrong>Observación\u003C/strong>: el motivo. Por ejemplo: \u003Cem>Pago a un proveedor\u003C/em>.\u003C/li>\n\u003Cli>\u003Cstrong>Registrar Retiro\u003C/strong>: anota el retiro de verdad.\u003C/li>\n\u003Cli>\u003Cstrong>Cancelar\u003C/strong>: cierra la ventanita sin anotar nada.\u003C/li>\n\u003C/ul>\n\u003Cblockquote>\n\u003Cp>⚠️ \u003Cstrong>Atención:\u003C/strong> \u003Cstrong>Registrar Ingreso\u003C/strong> y \u003Cstrong>Registrar Retiro\u003C/strong> cambian la plata de la caja. Tocalos solo con movimientos reales.\u003C/p>\n\u003C/blockquote>\n\u003Ch3>Acciones\u003C/h3>\n\u003Cp>\u003Cimg src=\"/images/manual/70-finanzas/71-11-menu-acciones.png\" alt=\"Lista Acciones abierta con Editar, Cambiar creador, Cerrar, Imprimir y Borrar\">\u003C/p>\n\u003Cp>El botón \u003Cstrong>Acciones\u003C/strong> abre una lista con:\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Editar\u003C/strong>: corregí los importes (Paso 10).\u003C/li>\n\u003Cli>\u003Cstrong>Cambiar creador\u003C/strong>: elegí a qué usuario se le asigna el turno.\u003C/li>\n\u003Cli>\u003Cstrong>Cerrar\u003C/strong>: cierra el turno (Paso 8).\u003C/li>\n\u003Cli>\u003Cstrong>Imprimir\u003C/strong>: manda el resumen del turno a la impresora.\u003C/li>\n\u003Cli>\u003Cstrong>Borrar\u003C/strong>: elimina el turno. No se puede deshacer.\u003C/li>\n\u003C/ul>\n\u003Cp>En un turno ya cerrado, en vez de \u003Cstrong>Cerrar\u003C/strong> aparece \u003Cstrong>Reabrir\u003C/strong>.\u003C/p>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🔒 Paso 8: Cerrá un arqueo\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-8-cerra-un-arqueo\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-8-cerra-un-arqueo\">\u003C/div>\n\n\u003Col>\n\u003Cli>En \u003Cstrong>Arqueos Abiertos\u003C/strong>, tocá el candado 🔒 del turno que querés cerrar. Es el tercer botón del renglón (Paso 4).\u003C/li>\n\u003Cli>Se abre la pantalla \u003Cstrong>Cerrando Arqueo\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/70-finanzas/71-16-pantalla-cerrar-arqueo.png\" alt=\"Pantalla Cerrando Arqueo con el resumen de movimientos, el Importe Final y la lista para contar billetes\">\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Resumen de Movimientos\u003C/strong>: lo que debería haber. Abajo dice \u003Cstrong>Total Esperado\u003C/strong>.\u003C/li>\n\u003Cli>\u003Cstrong>Importe Inicial\u003C/strong>: la plata con la que abriste. No se cambia acá.\u003C/li>\n\u003Cli>\u003Cstrong>Importe Final (Efectivo en Caja)\u003C/strong>: escribí lo que contaste.\u003C/li>\n\u003Cli>\u003Cstrong>Contar Billetes\u003C/strong>: escribí cuántos billetes hay de cada valor. Arriba ves el total contado.\u003C/li>\n\u003Cli>\u003Cstrong>Usar este total como Importe Final\u003C/strong>: copia el total de los billetes en \u003Cstrong>Importe Final\u003C/strong>.\u003C/li>\n\u003Cli>\u003Cstrong>Cerrar Arqueo\u003C/strong>: el botón verde de abajo. Cierra el turno.\u003C/li>\n\u003C/ul>\n\u003Cblockquote>\n\u003Cp>⚠️ \u003Cstrong>Atención:\u003C/strong> \u003Cstrong>Cerrar Arqueo\u003C/strong> termina el turno de esa caja. Contá bien antes de tocarlo.\u003C/p>\n\u003C/blockquote>\n\u003Col start=\"3\">\n\u003Cli>Tocá \u003Cstrong>Cerrar Arqueo\u003C/strong>.\u003C/li>\n\u003Cli>El turno pasa a \u003Cstrong>Historial de Arqueos Cerrados\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                📥 Paso 9: Bajá los arqueos a Excel\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-9-baja-los-arqueos-a-excel\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-9-baja-los-arqueos-a-excel\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/70-finanzas/71-05-donde-esta-boton-descargar-excel.png\" alt=\"Pantalla con el botón azul Descargar Excel marcado en rojo debajo de Buscar\">\u003C/p>\n\u003Col>\n\u003Cli>Poné los filtros que quieras (Paso 2).\u003C/li>\n\u003Cli>Tocá \u003Cstrong>Descargar Excel\u003C/strong>.\u003C/li>\n\u003Cli>Se baja un archivo con los turnos que coinciden.\u003C/li>\n\u003C/ol>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                ✏️ Paso 10: Corregí los importes de un arqueo\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-10-corregi-los-importes-de-un-arqueo\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-10-corregi-los-importes-de-un-arqueo\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/70-finanzas/71-18-pantalla-editar-arqueo.png\" alt=\"Pantalla Editando Arqueo con Importe Inicial, Importe Final y el botón Guardar\">\u003C/p>\n\u003Col>\n\u003Cli>Tocá el lápiz del turno.\u003C/li>\n\u003Cli>Cambiá \u003Cstrong>Importe Inicial\u003C/strong> o \u003Cstrong>Importe Final\u003C/strong>.\u003C/li>\n\u003Cli>Tocá \u003Cstrong>Guardar\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cblockquote>\n\u003Cp>⚠️ \u003Cstrong>Atención:\u003C/strong> cambiar los importes cambia el saldo del turno. Hacelo solo para corregir un error de carga.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                ⚠️ Resolución de Inconvenientes\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"resolucion-de-inconvenientes\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"resolucion-de-inconvenientes\">\u003C/div>\n\n\u003Cdiv class=\"table-wrapper\">\u003Ctable>\n\u003Cthead>\n\u003Ctr>\n\u003Cth>Problema\u003C/th>\n\u003Cth>Causa más frecuente\u003C/th>\n\u003Cth>Solución recomendada\u003C/th>\n\u003C/tr>\n\u003C/thead>\n\u003Ctbody>\u003Ctr>\n\u003Ctd>Dice \u003Cstrong>No hay cajas configuradas\u003C/strong> y la caja existe.\u003C/td>\n\u003Ctd>Todas las cajas ya tienen un turno abierto.\u003C/td>\n\u003Ctd>Cerrá el turno que ya no uses (Paso 8). La tarjeta vuelve a aparecer.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>No veo mi caja para abrir un turno.\u003C/td>\n\u003Ctd>Tu usuario no está tildado en la caja.\u003C/td>\n\u003Ctd>Pedile a un administrador que lo tilde en \u003Ca href=\"/user-guide/listado-de-cajas\">Listado de Cajas\u003C/a>.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>Al abrir dice que la caja ya se encuentra abierta.\u003C/td>\n\u003Ctd>Otra persona la abrió antes.\u003C/td>\n\u003Ctd>Buscá el turno en \u003Cstrong>Arqueos Abiertos\u003C/strong> y cerralo, o usá ese mismo turno.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>Faltan botones \u003Cstrong>Ingreso\u003C/strong> y \u003Cstrong>Retiro\u003C/strong>.\u003C/td>\n\u003Ctd>El turno ya está cerrado o no tenés permiso.\u003C/td>\n\u003Ctd>Solo se usan en turnos abiertos. Consultá tus permisos.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>Hay un faltante al cerrar.\u003C/td>\n\u003Ctd>Salió plata de la caja y no se anotó.\u003C/td>\n\u003Ctd>Anotá los retiros con \u003Cstrong>Retiro\u003C/strong> y mirá \u003Cstrong>¿Por qué no cierra?\u003C/strong>.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>El resumen muestra un importe en rojo entre \u003Cstrong>Facturado Total Mesas\u003C/strong> y \u003Cstrong>Abiertas Por Usuario\u003C/strong>.\u003C/td>\n\u003Ctd>Cobraste mesas de otros compañeros o quedaron mesas sin cobrar.\u003C/td>\n\u003Ctd>Es normal. Leé el \u003Ca href=\"/user-guide/08-faq-cajero-diferencia-facturado-vs-abiertas\">FAQ de Diferencias en Arqueo\u003C/a>.\u003C/td>\n\u003C/tr>\n\u003C/tbody>\u003C/table>\u003C/div>\n",[5,9,12,15,18,21,24,27,30,33,36,39],{"id":6,"title":7,"level":8},"antes-de-empezar","Antes de empezar",2,{"id":10,"title":11,"level":8},"paso-1-entra-a-la-pantalla","Paso 1: Entrá a la pantalla",{"id":13,"title":14,"level":8},"paso-2-busca-un-arqueo","Paso 2: Buscá un arqueo",{"id":16,"title":17,"level":8},"paso-3-mira-los-arqueos-cerrados","Paso 3: Mirá los arqueos cerrados",{"id":19,"title":20,"level":8},"paso-4-mira-los-arqueos-abiertos","Paso 4: Mirá los arqueos abiertos",{"id":22,"title":23,"level":8},"paso-5-abri-un-arqueo","Paso 5: Abrí un arqueo",{"id":25,"title":26,"level":8},"paso-6-mira-el-detalle-de-un-arqueo","Paso 6: Mirá el detalle de un arqueo",{"id":28,"title":29,"level":8},"paso-7-anota-un-ingreso-o-un-retiro-de-dinero","Paso 7: Anotá un ingreso o un retiro de dinero",{"id":31,"title":32,"level":8},"paso-8-cerra-un-arqueo","Paso 8: Cerrá un arqueo",{"id":34,"title":35,"level":8},"paso-9-baja-los-arqueos-a-excel","Paso 9: Bajá los arqueos a Excel",{"id":37,"title":38,"level":8},"paso-10-corregi-los-importes-de-un-arqueo","Paso 10: Corregí los importes de un arqueo",{"id":40,"title":41,"level":8},"resolucion-de-inconvenientes","Resolución de Inconvenientes",{"title":43,"description":44,"keywords":45},"Arqueos de Caja - Manual","¿Dónde está en el sistema?: Menú principal → Finanzas → Caja → Arqueos de Caja\n ¿Quién lo usa?: Cajeros, encargados de turno y contadores","arqueos de caja, paxapos, arqueos de caja, tutorial, guía, manual usuario","71-arqueos-de-caja.txt"],"uses":{"params":["slug"]}}]}
