{"type":"data","nodes":[null,{"type":"data","data":[{"moduleCategories":1},[2,17,44,53,77,98,110,140,146,173,185,221,250],{"title":3,"modules":4},"Comenzamos",[5,8,11,14],{"slug":6,"title":7},"introduccion","Bienvenido a tu software gastronómico",{"slug":9,"title":10},"iniciar-sesion","Cómo Iniciar Sesión",{"slug":12,"title":13},"recuperar-contrasena","Cómo Recuperar tu Contraseña",{"slug":15,"title":16},"guia-de-inicio-rapido","Guía de Inicio Rápido",{"title":18,"modules":19},"Ventas",[20,23,26,29,32,35,38,41],{"slug":21,"title":22},"salon-de-ventas","Cómo Usar el Salón de Ventas (Adición)",{"slug":24,"title":25},"caja-rapida","Cómo Usar la Caja Rápida (Registradora)",{"slug":27,"title":28},"mozos","Cómo Cargar los Mozos",{"slug":30,"title":31},"clientes","Cómo Gestionar los Clientes",{"slug":33,"title":34},"descuentos","Cómo Configurar Descuentos",{"slug":36,"title":37},"nueva-reserva","Cómo Cargar una Nueva Reserva",{"slug":39,"title":40},"listado-de-reservas","Cómo Usar el Listado de Reservas",{"slug":42,"title":43},"grilla-de-reservas","Cómo Usar la Grilla de Reservas",{"title":45,"modules":46},"Medios de Pago",[47,50],{"slug":48,"title":49},"configuracion-procesadores","Configuración de Procesadores de Pago",{"slug":51,"title":52},"transacciones-mercadopago","Transacciones MercadoPago",{"title":54,"modules":55},"Productos",[56,59,62,65,68,71,74],{"slug":57,"title":58},"menu","Menú de Productos (Carta)",{"slug":60,"title":61},"categorias","Categorías de Productos",{"slug":63,"title":64},"variantes-grupo-sabores","Variantes y Grupos de Sabores",{"slug":66,"title":67},"maestro-de-productos","Maestro de Productos",{"slug":69,"title":70},"subproductos-elaborados","Sub-Productos (Elaborados)",{"slug":72,"title":73},"recetas","Recetas",{"slug":75,"title":76},"analisis-duplicados","Buscar Duplicados",{"title":78,"modules":79},"Compras",[80,83,86,89,92,95],{"slug":81,"title":82},"todas-las-ordenes-compra","Órdenes de Compra",{"slug":84,"title":85},"crear-orden-compra","Crear una Orden de Compra",{"slug":87,"title":88},"ordenes-a-aprobar","Órdenes a aprobar",{"slug":90,"title":91},"mercaderias","Mercaderías",{"slug":93,"title":94},"proveedores","Proveedores",{"slug":96,"title":97},"historial-de-compras","Historial de Compras",{"title":99,"modules":100},"Stock",[101,104,107],{"slug":102,"title":103},"stock-mercaderias","Stock de Mercaderías",{"slug":105,"title":106},"stock-subproductos","Stock de Subproductos",{"slug":108,"title":109},"movimientos-de-stock","Movimientos de Stock",{"title":111,"modules":112},"Finanzas",[113,116,119,122,125,128,131,134,137],{"slug":114,"title":115},"arqueos-de-caja","Arqueos de Caja",{"slug":117,"title":118},"listado-de-cajas","Listado de Cajas",{"slug":120,"title":121},"transacciones-de-cobro","Transacciones de Cobro",{"slug":123,"title":124},"factura-manual","Factura Manual",{"slug":126,"title":127},"resumen-de-deuda","Resumen de Deuda",{"slug":129,"title":130},"pagos","Pagos",{"slug":132,"title":133},"historial-de-facturas","Historial de Facturas",{"slug":135,"title":136},"historico-de-mesas","Histórico de Mesas",{"slug":138,"title":139},"puntos-de-venta-pdv","Puntos de Venta (PDVs)",{"title":141,"modules":142},"Comandero",[143],{"slug":144,"title":145},"comandero","Comandero (pantalla de cocina)",{"title":147,"modules":148},"RRHH",[149,152,155,158,161,164,167,170],{"slug":150,"title":151},"empleados","Empleados",{"slug":153,"title":154},"empleados-trabajando","Empleados Trabajando",{"slug":156,"title":157},"registro-diario-fichaje","Registro Diario de Fichaje",{"slug":159,"title":160},"reporte-mensual-fichaje","Reporte Mensual de Fichaje",{"slug":162,"title":163},"departamentos","Departamentos",{"slug":165,"title":166},"turnos-y-horarios-fichaje","Turnos y Horarios de Fichaje",{"slug":168,"title":169},"sueldos-y-jornales","Sueldos y Jornales",{"slug":171,"title":172},"datos-de-acceso-app","Datos de Acceso a la App de Fichaje",{"title":174,"modules":175},"Reportes",[176,179,182],{"slug":177,"title":178},"tablero-general","Tablero General",{"slug":180,"title":181},"productos-mas-vendidos","Productos Más Vendidos",{"slug":183,"title":184},"compras-por-mercaderia","Compras por Mercadería",{"title":186,"modules":187},"Configuracion",[188,191,194,197,200,203,206,209,212,215,218],{"slug":189,"title":190},"configuracion-general","Configuración general",{"slug":192,"title":193},"impresoras","Cómo cargar las impresoras del local",{"slug":195,"title":196},"perfiles-de-impresion","Cómo usar los perfiles de impresión",{"slug":198,"title":199},"usuarios-del-sistema","Cómo administrar los Usuarios del Sistema",{"slug":201,"title":202},"usuarios-con-pin","Cómo administrar los Usuarios con PIN",{"slug":204,"title":205},"punto-de-venta","🏛️ Trámite en ARCA (con clave fiscal)",{"slug":207,"title":208},"permisos-por-rol","Cómo configurar los Permisos por Rol",{"slug":210,"title":211},"turnos-mesa","Turnos de Mesa",{"slug":213,"title":214},"medios-de-cobro","Medios de cobro",{"slug":216,"title":217},"clasificacion-de-gastos","Clasificación de Gastos",{"slug":219,"title":220},"centros-de-costo","Centros de Costo",{"title":222,"modules":223},"Biblioteca de Drivers",[224,226,229,232,235,238,241,244,247],{"slug":225,"title":222},"biblioteca-de-drivers",{"slug":227,"title":228},"sam4s-giant-100","Sam4S Giant - 100",{"slug":230,"title":231},"citizen-ct-s310ii","Citizen CT-S310II",{"slug":233,"title":234},"epson-tm-t20","Epson TM-T20",{"slug":236,"title":237},"drivers-genericos","Drivers Genéricos POS",{"slug":239,"title":240},"epson-tm-t88","Epson TM-T88V",{"slug":242,"title":243},"fiscalberry-windows","Instalar Fiscalberry en Windows",{"slug":245,"title":246},"fiscalberry-linux","Instalar Fiscalberry en Linux",{"slug":248,"title":249},"fiscalberry-android","Instalar Fiscalberry en Android",{"title":251,"modules":252},"Extra",[253,256,259,262,265,268,271,274,277,280],{"slug":254,"title":255},"01-faq-solucion-inicial-pantalla-congelada","📖 Manual de Usuario: Solución Inicial si la Pantalla se Congela o no Carga",{"slug":257,"title":258},"03-faq-mozo-reabrir-mesa-anulada","📖 Manual de Usuario: Cómo Reabrir una Mesa Anulada o Cerrada por Error",{"slug":260,"title":261},"05-faq-cajero-emitir-factura-a","📖 Manual de Usuario: Cómo Emitir una Factura A Cargando Datos del Cliente",{"slug":263,"title":264},"06-faq-cajero-ingreso-egreso-cajon","📖 Manual de Usuario: Cómo Registrar Entradas y Salidas de Dinero del Cajón",{"slug":266,"title":267},"07-faq-cajero-activar-medio-pago","📖 Manual de Usuario: Cómo Activar un Medio de Pago que no Aparece al Cobrar",{"slug":269,"title":270},"08-faq-cajero-diferencia-facturado-vs-abiertas","📖 Manual de Usuario: Diferencia entre \"Facturado Total Mesas\" y \"Abiertas Por Usuario\" en Caja",{"slug":272,"title":273},"10-faq-supervisor-cierre-caja-diferencias","📖 Manual de Usuario: Cómo Auditar y Solucionar Diferencias en el Cierre de Caja",{"slug":275,"title":276},"preguntas-frecuentes","Preguntas Frecuentes y Guías Rápidas por Rol",{"slug":278,"title":279},"buchon-bot","Buchón Bot",{"slug":281,"title":282},"troubleshooting-semantico","📖 Guía Única de Resolución de Problemas y Errores (Troubleshooting)"],"uses":{}},{"type":"data","data":[{"slug":1,"title":2,"content":3,"tableOfContents":4,"seo":40,"llmTxtFile":44},"proveedores","Proveedores","\u003Cdiv id=\"proveedores\">\u003C/div>\n\n\u003Cblockquote>\n\u003Cp>\u003Cstrong>¿Dónde está en el sistema?:\u003C/strong> Menú principal → \u003Cstrong>Compras\u003C/strong> → \u003Cstrong>Catálogo\u003C/strong> → \u003Cstrong>Proveedores\u003C/strong>\n\u003Cstrong>¿Quién lo usa?:\u003C/strong> Compradores, contadores y administradores\u003C/p>\n\u003C/blockquote>\n\u003Cblockquote>\n\u003Cp>🎯 \u003Cstrong>¿Para qué sirve esto?\u003C/strong>\nAcá tenés la agenda de las empresas y personas que te venden. Por ejemplo: la distribuidora de bebidas o la carnicería.\nCon cada proveedor guardás su CUIT, sus datos de contacto y ves todo lo que le compraste y lo que le debés.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🔑 Antes de empezar\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"antes-de-empezar\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"antes-de-empezar\">\u003C/div>\n\n\u003Cul>\n\u003Cli>Tu usuario tiene que tener el permiso de \u003Cstrong>Proveedores\u003C/strong> en \u003Ca href=\"/user-guide/permisos-por-rol\">Permisos por Rol\u003C/a>.\u003C/li>\n\u003C/ul>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                📍 Paso 1: Entrá a la pantalla\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-1-entra-a-la-pantalla\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-1-entra-a-la-pantalla\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/50-compras/58-00a-menu-grupo-compras.png\" alt=\"Menú lateral con el grupo Compras marcado en rojo\">\u003C/p>\n\u003Col>\n\u003Cli>En el menú de la izquierda, tocá \u003Cstrong>Compras\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/50-compras/58-00b-menu-opcion-proveedores.png\" alt=\"Opción Proveedores marcada en rojo, debajo de Catálogo\">\u003C/p>\n\u003Col start=\"2\">\n\u003Cli>Tocá \u003Cstrong>Proveedores\u003C/strong>. Está debajo del título \u003Cstrong>CATÁLOGO\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/50-compras/58-01-pantalla-index.png\" alt=\"Pantalla Proveedores con el buscador arriba y la lista abajo\">\u003C/p>\n\u003Cp>Así se ve la pantalla. Arriba está el buscador. Abajo, la lista de proveedores con su CUIT, mail, teléfono y domicilio.\u003C/p>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🔎 Paso 2: Buscá un proveedor\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-2-busca-un-proveedor\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-2-busca-un-proveedor\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/50-compras/58-04-panel-busqueda.png\" alt=\"Recuadro de búsqueda con Ejemplo escrito, la casilla Nombres Duplicados y los botones Unificar y Buscar\">\u003C/p>\n\u003Cp>En el recuadro de búsqueda tenés:\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Buscar Proveedor\u003C/strong>: escribí parte del nombre o del CUIT. Por ejemplo: \u003Cem>Ejemplo\u003C/em>.\u003C/li>\n\u003Cli>\u003Cstrong>Nombres Duplicados\u003C/strong>: marcala para ver solo los proveedores cargados dos veces.\u003C/li>\n\u003Cli>\u003Cstrong>Unificar\u003C/strong>: el botón blanco de la izquierda. Sirve para juntar dos proveedores repetidos (Paso 6).\u003C/li>\n\u003Cli>\u003Cstrong>Buscar\u003C/strong>: el botón azul de la derecha. Aplica la búsqueda.\u003C/li>\n\u003C/ul>\n\u003Col>\n\u003Cli>Escribí lo que buscás y tocá \u003Cstrong>Buscar\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/50-compras/58-52-resultado-busqueda.png\" alt=\"Lista con un solo proveedor: Distribuidora Ejemplo\">\u003C/p>\n\u003Col start=\"2\">\n\u003Cli>La lista muestra solo los que coinciden.\u003C/li>\n\u003C/ol>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                ➕ Paso 3: Cargá un proveedor nuevo\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-3-carga-un-proveedor-nuevo\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-3-carga-un-proveedor-nuevo\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/50-compras/58-02-donde-esta-boton-nuevo-proveedor.png\" alt=\"Pantalla con el botón verde Nuevo Proveedor marcado en rojo\">\u003C/p>\n\u003Col>\n\u003Cli>Tocá el botón verde \u003Cstrong>Nuevo Proveedor\u003C/strong>. Está arriba a la derecha.\u003C/li>\n\u003Cli>Se abre el formulario. Tiene cinco recuadros.\u003C/li>\n\u003C/ol>\n\u003Ch3 class=\"relative\">\n                Información del Proveedor\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"informacion-del-proveedor\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h3>\n            \u003Cdiv id=\"informacion-del-proveedor\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/50-compras/58-67-formulario-datos.png\" alt=\"Recuadro Información del Proveedor completo con los datos de Distribuidora Ejemplo SRL\">\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Razón Social\u003C/strong>: el nombre legal, como sale en la factura. Por ejemplo: \u003Cem>Distribuidora Ejemplo SRL\u003C/em>.\u003C/li>\n\u003Cli>\u003Cstrong>Nombre / Fantasía\u003C/strong>: el nombre con el que lo conocés.\u003C/li>\n\u003Cli>\u003Cstrong>Email\u003C/strong> y \u003Cstrong>Teléfono\u003C/strong>: sirven para mandarle las órdenes de compra.\u003C/li>\n\u003Cli>\u003Cstrong>Tipo Doc.\u003C/strong> y \u003Cstrong>Número\u003C/strong>: dejá \u003Cstrong>CUIT\u003C/strong> y escribí el número, sin guiones.\u003C/li>\n\u003Cli>\u003Cstrong>Condición IVA\u003C/strong>: cómo factura. Por ejemplo: \u003Cem>Responsable Inscripto\u003C/em> o \u003Cem>Monotributista\u003C/em>.\u003C/li>\n\u003Cli>\u003Cstrong>Nº de inscripción IIBB\u003C/strong>: es opcional. Si lo dejás vacío, en las retenciones se usa el CUIT.\u003C/li>\n\u003Cli>\u003Cstrong>Domicilio\u003C/strong>, \u003Cstrong>Localidad\u003C/strong> y \u003Cstrong>Provincia\u003C/strong>: dónde está.\u003C/li>\n\u003Cli>\u003Cstrong>CBU\u003C/strong> y \u003Cstrong>Alias CBU\u003C/strong>: la cuenta donde le pagás. El CBU tiene 22 números.\u003C/li>\n\u003C/ul>\n\u003Ch3 class=\"relative\">\n                Rubros y Percepciones e Impuestos en Facturas\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"rubros-y-percepciones\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h3>\n            \u003Cdiv id=\"rubros-y-percepciones\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/50-compras/58-68-formulario-rubros-e-impuestos.png\" alt=\"Recuadros Rubros y Percepciones e Impuestos en Facturas, con los botones Todos y Ninguno\">\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Rubros\u003C/strong>: marcá qué te vende. Por ejemplo: \u003Cem>Almacén\u003C/em> o \u003Cem>Bebidas\u003C/em>. Sirve para encontrarlo más rápido.\u003C/li>\n\u003Cli>\u003Cstrong>Percepciones e Impuestos en Facturas\u003C/strong>: marcá los impuestos que este proveedor suele cobrarte en la factura. Abajo dice cuántos marcaste; \u003Cstrong>Todos\u003C/strong> los marca de una vez y \u003Cstrong>Ninguno\u003C/strong> los desmarca.\u003C/li>\n\u003C/ul>\n\u003Ch3 class=\"relative\">\n                Documentación y Retenciones a Practicar\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"documentacion-y-retenciones\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h3>\n            \u003Cdiv id=\"documentacion-y-retenciones\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/50-compras/58-69-formulario-documentacion-y-retenciones.png\" alt=\"Recuadros Documentación y Retenciones a Practicar, con el botón azul Guardar Proveedor abajo\">\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Documentación\u003C/strong>: tocá \u003Cstrong>Agregar documento\u003C/strong> para guardar un contrato o una constancia.\u003C/li>\n\u003Cli>\u003Cstrong>Retenciones a Practicar\u003C/strong>: marcá las retenciones que le hacés al pagarle: \u003Cstrong>Ganancias\u003C/strong>, \u003Cstrong>IIBB\u003C/strong>, \u003Cstrong>IVA\u003C/strong> o \u003Cstrong>SUSS\u003C/strong>. Al lado podés poner una alícuota propia; el engranaje ⚙️ abre más opciones. Si no sabés, preguntale a tu contador.\u003C/li>\n\u003C/ul>\n\u003Col start=\"3\">\n\u003Cli>Tocá el botón azul \u003Cstrong>Guardar Proveedor\u003C/strong>, abajo de todo.\u003C/li>\n\u003Cli>El proveedor aparece en la lista.\u003C/li>\n\u003C/ol>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                ✏️ Paso 4: Cambiá los datos de un proveedor\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-4-cambia-los-datos-de-un-proveedor\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-4-cambia-los-datos-de-un-proveedor\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/50-compras/58-70-renglon-proveedor.png\" alt=\"Renglón del proveedor con los botones Ver proveedor y la flechita ▾\">\u003C/p>\n\u003Cp>A la derecha de cada proveedor hay dos botones: \u003Cstrong>Ver proveedor\u003C/strong> abre su ficha (Paso 5), y la flechita \u003Cstrong>▾\u003C/strong> abre más opciones.\u003C/p>\n\u003Col>\n\u003Cli>Tocá la flechita \u003Cstrong>▾\u003C/strong> al lado de \u003Cstrong>Ver proveedor\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/50-compras/58-53-menu-mas-opciones.png\" alt=\"Menú abierto con las opciones Editar y Borrar\">\u003C/p>\n\u003Col start=\"2\">\n\u003Cli>Se abre una lista:\u003Cul>\n\u003Cli>\u003Cstrong>Editar\u003C/strong>: abre el formulario con los datos del proveedor.\u003C/li>\n\u003Cli>\u003Cstrong>Borrar\u003C/strong>: borra el proveedor. El sistema te pregunta si estás seguro.\u003C/li>\n\u003C/ul>\n\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/50-compras/58-58-pantalla-editar-proveedor.png\" alt=\"Ventana Editar con los datos de Distribuidora Ejemplo\">\u003C/p>\n\u003Col start=\"3\">\n\u003Cli>Tocá \u003Cstrong>Editar\u003C/strong>, cambiá lo que necesites y tocá \u003Cstrong>Guardar Proveedor\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cblockquote>\n\u003Cp>⚠️ \u003Cstrong>Atención:\u003C/strong> \u003Cstrong>Borrar\u003C/strong> no se puede deshacer. Si el proveedor tiene compras o facturas, conviene no borrarlo.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                👁️ Paso 5: Mirá la ficha del proveedor\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-5-mira-la-ficha-del-proveedor\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-5-mira-la-ficha-del-proveedor\">\u003C/div>\n\n\u003Col>\n\u003Cli>Tocá \u003Cstrong>Ver proveedor\u003C/strong>, a la derecha del proveedor.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/50-compras/58-59-pantalla-ver-proveedor.png\" alt=\"Detalles del Proveedor Distribuidora Ejemplo con sus datos y resúmenes\">\u003C/p>\n\u003Col start=\"2\">\n\u003Cli>Se abre la ficha con todos sus datos.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/50-compras/58-63-tarjetas-resumen.png\" alt=\"Tarjetas Cuenta corriente, Facturación, Compras y Recepción\">\u003C/p>\n\u003Col start=\"3\">\n\u003Cli>Las tarjetas de colores te muestran de un vistazo:\u003Cul>\n\u003Cli>\u003Cstrong>Cuenta corriente\u003C/strong>: cuánto le debés.\u003C/li>\n\u003Cli>\u003Cstrong>Facturación\u003C/strong>: cuánto te facturó.\u003C/li>\n\u003Cli>\u003Cstrong>Compras\u003C/strong>: cuántas órdenes de compra le hiciste.\u003C/li>\n\u003Cli>\u003Cstrong>Recepción\u003C/strong>: cuándo recibiste mercadería de él por última vez.\u003C/li>\n\u003C/ul>\n\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/50-compras/58-64-solapas.png\" alt=\"Solapas Pedidos, Tabla histórica de gastos, Cuenta corriente y Lista de precios\">\u003C/p>\n\u003Col start=\"4\">\n\u003Cli>Abajo hay solapas:\u003Cul>\n\u003Cli>\u003Cstrong>Pedidos\u003C/strong>: lo que le pediste, renglón por renglón.\u003C/li>\n\u003Cli>\u003Cstrong>Tabla histórica de gastos del proveedor\u003C/strong>: sus facturas.\u003C/li>\n\u003Cli>\u003Cstrong>Cuenta corriente\u003C/strong>: facturas y pagos, con el saldo.\u003C/li>\n\u003Cli>\u003Cstrong>Lista de precios\u003C/strong>: el último precio de cada cosa que le comprás.\u003C/li>\n\u003C/ul>\n\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/50-compras/58-48-donde-esta-boton-icono.png\" alt=\"Solapa Pedidos con el nombre de la mercadería Harina 0000 marcado en rojo\">\u003C/p>\n\u003Col start=\"5\">\n\u003Cli>En \u003Cstrong>Pedidos\u003C/strong>, tocá el nombre de una mercadería para ver su detalle.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/50-compras/58-66-pantalla-cuenta-corriente.png\" alt=\"Solapa Cuenta corriente del proveedor\">\u003C/p>\n\u003Col start=\"6\">\n\u003Cli>Tocá \u003Cstrong>Cuenta corriente\u003C/strong> para ver lo que le debés.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/50-compras/58-71-botones-ficha.png\" alt=\"Botones Editar Proveedor y Borrar Proveedor\">\u003C/p>\n\u003Col start=\"7\">\n\u003Cli>Arriba a la derecha tenés \u003Cstrong>Editar Proveedor\u003C/strong>, que abre el formulario, y \u003Cstrong>Borrar Proveedor\u003C/strong>, que lo borra (el sistema te pregunta antes).\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/50-compras/58-65-donde-esta-boton-volver.png\" alt=\"Ficha con el enlace Volver a Lista de Proveedores marcado en rojo\">\u003C/p>\n\u003Col start=\"8\">\n\u003Cli>Para volver, tocá \u003Cstrong>Volver a Lista de Proveedores\u003C/strong>, abajo de todo.\u003C/li>\n\u003C/ol>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🔗 Paso 6: Juntá dos proveedores repetidos (Unificar)\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-6-junta-dos-proveedores-repetidos-unificar\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-6-junta-dos-proveedores-repetidos-unificar\">\u003C/div>\n\n\u003Cblockquote>\n\u003Cp>⚠️ \u003Cstrong>Atención:\u003C/strong> \u003Cstrong>Unificar\u003C/strong> borra un proveedor y pasa todo lo suyo al otro. No se puede deshacer.\u003C/p>\n\u003C/blockquote>\n\u003Col>\n\u003Cli>Tocá \u003Cstrong>Unificar\u003C/strong>, en el recuadro de búsqueda (Paso 2).\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/50-compras/58-60-pantalla-unificar.png\" alt=\"Pantalla Unificar proveedores con las listas Proveedor a eliminar y Proveedor destino, y el botón Unificar\">\u003C/p>\n\u003Col start=\"2\">\n\u003Cli>En \u003Cstrong>Proveedor a eliminar\u003C/strong>, elegí el que está repetido.\u003C/li>\n\u003Cli>En \u003Cstrong>Proveedor destino\u003C/strong>, elegí el que queda.\u003C/li>\n\u003Cli>Revisá bien los dos y tocá el botón azul \u003Cstrong>Unificar\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                ⚠️ Resolución de Inconvenientes\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"resolucion-de-inconvenientes\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"resolucion-de-inconvenientes\">\u003C/div>\n\n\u003Cdiv class=\"table-wrapper\">\u003Ctable>\n\u003Cthead>\n\u003Ctr>\n\u003Cth>Problema\u003C/th>\n\u003Cth>Causa más frecuente\u003C/th>\n\u003Cth>Solución recomendada\u003C/th>\n\u003C/tr>\n\u003C/thead>\n\u003Ctbody>\u003Ctr>\n\u003Ctd>\u003Cstrong>No encuentro un proveedor\u003C/strong>\u003C/td>\n\u003Ctd>Está cargado con otro nombre.\u003C/td>\n\u003Ctd>Buscalo por el CUIT o por parte de la razón social.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>El mismo proveedor aparece dos veces\u003C/strong>\u003C/td>\n\u003Ctd>Se cargó dos veces con nombres parecidos.\u003C/td>\n\u003Ctd>Marcá \u003Cstrong>Nombres Duplicados\u003C/strong>, buscá y juntalos con \u003Cstrong>Unificar\u003C/strong>.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>No le puedo mandar la orden de compra por mail\u003C/strong>\u003C/td>\n\u003Ctd>El proveedor no tiene \u003Cstrong>Email\u003C/strong> cargado.\u003C/td>\n\u003Ctd>Editalo y completá el \u003Cstrong>Email\u003C/strong>.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>Las retenciones no se calculan al pagar\u003C/strong>\u003C/td>\n\u003Ctd>No marcaste la retención en el proveedor.\u003C/td>\n\u003Ctd>Editalo y marcá la retención en \u003Cstrong>Retenciones a Practicar\u003C/strong>.\u003C/td>\n\u003C/tr>\n\u003C/tbody>\u003C/table>\u003C/div>\n",[5,9,12,15,18,22,25,28,31,34,37],{"id":6,"title":7,"level":8},"antes-de-empezar","Antes de empezar",2,{"id":10,"title":11,"level":8},"paso-1-entra-a-la-pantalla","Paso 1: Entrá a la pantalla",{"id":13,"title":14,"level":8},"paso-2-busca-un-proveedor","Paso 2: Buscá un proveedor",{"id":16,"title":17,"level":8},"paso-3-carga-un-proveedor-nuevo","Paso 3: Cargá un proveedor nuevo",{"id":19,"title":20,"level":21},"informacion-del-proveedor","Información del Proveedor",3,{"id":23,"title":24,"level":21},"rubros-y-percepciones","Rubros y Percepciones e Impuestos en Facturas",{"id":26,"title":27,"level":21},"documentacion-y-retenciones","Documentación y Retenciones a Practicar",{"id":29,"title":30,"level":8},"paso-4-cambia-los-datos-de-un-proveedor","Paso 4: Cambiá los datos de un proveedor",{"id":32,"title":33,"level":8},"paso-5-mira-la-ficha-del-proveedor","Paso 5: Mirá la ficha del proveedor",{"id":35,"title":36,"level":8},"paso-6-junta-dos-proveedores-repetidos-unificar","Paso 6: Juntá dos proveedores repetidos (Unificar)",{"id":38,"title":39,"level":8},"resolucion-de-inconvenientes","Resolución de Inconvenientes",{"title":41,"description":42,"keywords":43},"Proveedores - Manual","¿Dónde está en el sistema?: Menú principal → Compras → Catálogo → Proveedores\n ¿Quién lo usa?: Compradores, contadores y administradores","proveedores, paxapos, proveedores, tutorial, guía, manual usuario","58-proveedores.txt"],"uses":{"params":["slug"]}}]}
