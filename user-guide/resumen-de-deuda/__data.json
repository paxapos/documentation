{"type":"data","nodes":[null,{"type":"data","data":[{"moduleCategories":1},[2,17,44,53,77,98,110,140,146,173,185,221,250],{"title":3,"modules":4},"Comenzamos",[5,8,11,14],{"slug":6,"title":7},"introduccion","Bienvenido a tu software gastronómico",{"slug":9,"title":10},"iniciar-sesion","Cómo Iniciar Sesión",{"slug":12,"title":13},"recuperar-contrasena","Cómo Recuperar tu Contraseña",{"slug":15,"title":16},"guia-de-inicio-rapido","Guía de Inicio Rápido",{"title":18,"modules":19},"Ventas",[20,23,26,29,32,35,38,41],{"slug":21,"title":22},"salon-de-ventas","Cómo Usar el Salón de Ventas (Adición)",{"slug":24,"title":25},"caja-rapida","Cómo Usar la Caja Rápida (Registradora)",{"slug":27,"title":28},"mozos","Cómo Cargar los Mozos",{"slug":30,"title":31},"clientes","Cómo Gestionar los Clientes",{"slug":33,"title":34},"descuentos","Cómo Configurar Descuentos",{"slug":36,"title":37},"nueva-reserva","Cómo Cargar una Nueva Reserva",{"slug":39,"title":40},"listado-de-reservas","Cómo Usar el Listado de Reservas",{"slug":42,"title":43},"grilla-de-reservas","Cómo Usar la Grilla de Reservas",{"title":45,"modules":46},"Medios de Pago",[47,50],{"slug":48,"title":49},"configuracion-procesadores","Configuración de Procesadores de Pago",{"slug":51,"title":52},"transacciones-mercadopago","Transacciones MercadoPago",{"title":54,"modules":55},"Productos",[56,59,62,65,68,71,74],{"slug":57,"title":58},"menu","Menú de Productos (Carta)",{"slug":60,"title":61},"categorias","Categorías de Productos",{"slug":63,"title":64},"variantes-grupo-sabores","Variantes y Grupos de Sabores",{"slug":66,"title":67},"maestro-de-productos","Maestro de Productos",{"slug":69,"title":70},"subproductos-elaborados","Sub-Productos (Elaborados)",{"slug":72,"title":73},"recetas","Recetas",{"slug":75,"title":76},"analisis-duplicados","Buscar Duplicados",{"title":78,"modules":79},"Compras",[80,83,86,89,92,95],{"slug":81,"title":82},"todas-las-ordenes-compra","Órdenes de Compra",{"slug":84,"title":85},"crear-orden-compra","Crear una Orden de Compra",{"slug":87,"title":88},"ordenes-a-aprobar","Órdenes a aprobar",{"slug":90,"title":91},"mercaderias","Mercaderías",{"slug":93,"title":94},"proveedores","Proveedores",{"slug":96,"title":97},"historial-de-compras","Historial de Compras",{"title":99,"modules":100},"Stock",[101,104,107],{"slug":102,"title":103},"stock-mercaderias","Stock de Mercaderías",{"slug":105,"title":106},"stock-subproductos","Stock de Subproductos",{"slug":108,"title":109},"movimientos-de-stock","Movimientos de Stock",{"title":111,"modules":112},"Finanzas",[113,116,119,122,125,128,131,134,137],{"slug":114,"title":115},"arqueos-de-caja","Arqueos de Caja",{"slug":117,"title":118},"listado-de-cajas","Listado de Cajas",{"slug":120,"title":121},"transacciones-de-cobro","Transacciones de Cobro",{"slug":123,"title":124},"factura-manual","Factura Manual",{"slug":126,"title":127},"resumen-de-deuda","Resumen de Deuda",{"slug":129,"title":130},"pagos","Pagos",{"slug":132,"title":133},"historial-de-facturas","Historial de Facturas",{"slug":135,"title":136},"historico-de-mesas","Histórico de Mesas",{"slug":138,"title":139},"puntos-de-venta-pdv","Puntos de Venta (PDVs)",{"title":141,"modules":142},"Comandero",[143],{"slug":144,"title":145},"comandero","Comandero (pantalla de cocina)",{"title":147,"modules":148},"RRHH",[149,152,155,158,161,164,167,170],{"slug":150,"title":151},"empleados","Empleados",{"slug":153,"title":154},"empleados-trabajando","Empleados Trabajando",{"slug":156,"title":157},"registro-diario-fichaje","Registro Diario de Fichaje",{"slug":159,"title":160},"reporte-mensual-fichaje","Reporte Mensual de Fichaje",{"slug":162,"title":163},"departamentos","Departamentos",{"slug":165,"title":166},"turnos-y-horarios-fichaje","Turnos y Horarios de Fichaje",{"slug":168,"title":169},"sueldos-y-jornales","Sueldos y Jornales",{"slug":171,"title":172},"datos-de-acceso-app","Datos de Acceso a la App de Fichaje",{"title":174,"modules":175},"Reportes",[176,179,182],{"slug":177,"title":178},"tablero-general","Tablero General",{"slug":180,"title":181},"productos-mas-vendidos","Productos Más Vendidos",{"slug":183,"title":184},"compras-por-mercaderia","Compras por Mercadería",{"title":186,"modules":187},"Configuracion",[188,191,194,197,200,203,206,209,212,215,218],{"slug":189,"title":190},"configuracion-general","Configuración general",{"slug":192,"title":193},"impresoras","Cómo cargar las impresoras del local",{"slug":195,"title":196},"perfiles-de-impresion","Cómo usar los perfiles de impresión",{"slug":198,"title":199},"usuarios-del-sistema","Cómo administrar los Usuarios del Sistema",{"slug":201,"title":202},"usuarios-con-pin","Cómo administrar los Usuarios con PIN",{"slug":204,"title":205},"punto-de-venta","🏛️ Trámite en ARCA (con clave fiscal)",{"slug":207,"title":208},"permisos-por-rol","Cómo configurar los Permisos por Rol",{"slug":210,"title":211},"turnos-mesa","Turnos de Mesa",{"slug":213,"title":214},"medios-de-cobro","Medios de cobro",{"slug":216,"title":217},"clasificacion-de-gastos","Clasificación de Gastos",{"slug":219,"title":220},"centros-de-costo","Centros de Costo",{"title":222,"modules":223},"Biblioteca de Drivers",[224,226,229,232,235,238,241,244,247],{"slug":225,"title":222},"biblioteca-de-drivers",{"slug":227,"title":228},"sam4s-giant-100","Sam4S Giant - 100",{"slug":230,"title":231},"citizen-ct-s310ii","Citizen CT-S310II",{"slug":233,"title":234},"epson-tm-t20","Epson TM-T20",{"slug":236,"title":237},"drivers-genericos","Drivers Genéricos POS",{"slug":239,"title":240},"epson-tm-t88","Epson TM-T88V",{"slug":242,"title":243},"fiscalberry-windows","Instalar Fiscalberry en Windows",{"slug":245,"title":246},"fiscalberry-linux","Instalar Fiscalberry en Linux",{"slug":248,"title":249},"fiscalberry-android","Instalar Fiscalberry en Android",{"title":251,"modules":252},"Extra",[253,256,259,262,265,268,271,274,277,280],{"slug":254,"title":255},"01-faq-solucion-inicial-pantalla-congelada","📖 Manual de Usuario: Solución Inicial si la Pantalla se Congela o no Carga",{"slug":257,"title":258},"03-faq-mozo-reabrir-mesa-anulada","📖 Manual de Usuario: Cómo Reabrir una Mesa Anulada o Cerrada por Error",{"slug":260,"title":261},"05-faq-cajero-emitir-factura-a","📖 Manual de Usuario: Cómo Emitir una Factura A Cargando Datos del Cliente",{"slug":263,"title":264},"06-faq-cajero-ingreso-egreso-cajon","📖 Manual de Usuario: Cómo Registrar Entradas y Salidas de Dinero del Cajón",{"slug":266,"title":267},"07-faq-cajero-activar-medio-pago","📖 Manual de Usuario: Cómo Activar un Medio de Pago que no Aparece al Cobrar",{"slug":269,"title":270},"08-faq-cajero-diferencia-facturado-vs-abiertas","📖 Manual de Usuario: Diferencia entre \"Facturado Total Mesas\" y \"Abiertas Por Usuario\" en Caja",{"slug":272,"title":273},"10-faq-supervisor-cierre-caja-diferencias","📖 Manual de Usuario: Cómo Auditar y Solucionar Diferencias en el Cierre de Caja",{"slug":275,"title":276},"preguntas-frecuentes","Preguntas Frecuentes y Guías Rápidas por Rol",{"slug":278,"title":279},"buchon-bot","Buchón Bot",{"slug":281,"title":282},"troubleshooting-semantico","📖 Guía Única de Resolución de Problemas y Errores (Troubleshooting)"],"uses":{}},{"type":"data","data":[{"slug":1,"title":2,"content":3,"tableOfContents":4,"seo":33,"llmTxtFile":37},"resumen-de-deuda","Resumen de Deuda","\u003Cdiv id=\"resumen-de-deuda\">\u003C/div>\n\n\u003Cblockquote>\n\u003Cp>\u003Cstrong>¿Dónde está en el sistema?:\u003C/strong> Menú principal → \u003Cstrong>Finanzas\u003C/strong> → \u003Cstrong>Facturas y Pagos\u003C/strong> → \u003Cstrong>Resumen de Deuda\u003C/strong>\n\u003Cstrong>¿Quién lo usa?:\u003C/strong> Encargados de Cuentas a Pagar, Tesoreros y Contadores\u003C/p>\n\u003C/blockquote>\n\u003Cblockquote>\n\u003Cp>🎯 \u003Cstrong>¿Para qué sirve esto?\u003C/strong>\nTe muestra cuánta plata le debés a cada proveedor y hace cuánto tiempo.\nDesde acá llegás a las facturas que faltan pagar y las pagás.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🔑 Antes de empezar\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"antes-de-empezar\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"antes-de-empezar\">\u003C/div>\n\n\u003Cul>\n\u003Cli>Tu usuario tiene que tener el permiso de \u003Cstrong>Finanzas\u003C/strong> en \u003Ca href=\"/user-guide/permisos-por-rol\">Permisos por Rol\u003C/a>.\u003C/li>\n\u003Cli>La deuda sale de las facturas cargadas sin pagar. Mirá \u003Ca href=\"/user-guide/factura-manual\">Factura Manual\u003C/a>.\u003C/li>\n\u003Cli>Para pagar una factura, tu usuario también necesita permiso de pagos. Mirá \u003Ca href=\"/user-guide/pagos\">Pagos (Egresos)\u003C/a>.\u003C/li>\n\u003C/ul>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                📍 Paso 1: Entrá a la pantalla\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-1-entra-a-la-pantalla\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-1-entra-a-la-pantalla\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/70-finanzas/77-00a-menu-grupo-finanzas.png\" alt=\"Menú lateral con el grupo Finanzas marcado en rojo\">\u003C/p>\n\u003Col>\n\u003Cli>En el menú de la izquierda, tocá \u003Cstrong>Finanzas\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/70-finanzas/77-00b-menu-opcion-resumen-de-deuda.png\" alt=\"Opción Resumen de Deuda marcada en rojo, debajo del título Facturas y Pagos\">\u003C/p>\n\u003Col start=\"2\">\n\u003Cli>Tocá \u003Cstrong>Resumen de Deuda\u003C/strong>. Está debajo del título \u003Cstrong>FACTURAS Y PAGOS\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/70-finanzas/77-01-pantalla-resumen-de-deuda.png\" alt=\"Pantalla Resumen de Deuda con el total de deuda arriba, tarjetas, aging y la tabla por proveedor\">\u003C/p>\n\u003Cp>Así se ve la pantalla. Arriba, al lado del título, está la deuda total. Por ejemplo: \u003Cstrong>Resumen de Deuda: $1.500,00\u003C/strong>.\u003C/p>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🔘 Paso 2: Conocé los botones de arriba\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-2-conoce-los-botones-de-arriba\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-2-conoce-los-botones-de-arriba\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/70-finanzas/77-02-botones-de-arriba.png\" alt=\"Tres botones juntos: Nuevo Gasto en verde, Gasto Manual y Descargar\">\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Nuevo Gasto\u003C/strong>: abre la pantalla para subir la foto de una factura y cargar sus datos.\u003C/li>\n\u003Cli>\u003Cstrong>Gasto Manual\u003C/strong>: abre \u003Ca href=\"/user-guide/factura-manual\">Factura Manual\u003C/a>, para escribir los datos a mano.\u003C/li>\n\u003Cli>\u003Cstrong>Descargar\u003C/strong>: baja esta tabla en una planilla de Excel.\u003C/li>\n\u003C/ul>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                📊 Paso 3: Leé los números\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-3-lee-los-numeros\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-3-lee-los-numeros\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/70-finanzas/77-03-deuda-por-centro-de-costo.png\" alt=\"Recuadro Deuda por PDV / Centro de costo con un casillero por cada local y el monto de deuda de cada uno\">\u003C/p>\n\u003Cp>Este recuadro aparece si tu comercio usa \u003Cstrong>PDV / Centro de costo\u003C/strong>. Muestra cuánto se debe en cada uno.\u003C/p>\n\u003Cul>\n\u003Cli>Tocá un nombre para ver la tabla solo de ese local.\u003C/li>\n\u003Cli>\u003Cstrong>Sin centro\u003C/strong> junta las facturas que no tienen local asignado.\u003C/li>\n\u003Cli>Para volver a ver todo, tocá \u003Cstrong>Quitar filtro\u003C/strong>.\u003C/li>\n\u003C/ul>\n\u003Cp>\u003Cimg src=\"/images/manual/70-finanzas/77-04-tarjetas-y-aging.png\" alt=\"Cuatro tarjetas y el cuadro Aging de deuda con los rangos 0-30, 31-60, 61-90 y mayor a 90\">\u003C/p>\n\u003Cp>Las tarjetas de arriba dicen:\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Proveedores con deuda\u003C/strong>: a cuántos proveedores les debés hoy.\u003C/li>\n\u003Cli>\u003Cstrong>Deuda promedio\u003C/strong>: cuánto le debés en promedio a cada uno.\u003C/li>\n\u003Cli>\u003Cstrong>Mayor deudor\u003C/strong>: el proveedor al que más le debés, y cuánto.\u003C/li>\n\u003Cli>\u003Cstrong>Deuda vencida (+30)\u003C/strong>: lo que tiene más de 30 días, y qué parte del total es.\u003C/li>\n\u003C/ul>\n\u003Cp>El cuadro \u003Cstrong>Aging de deuda\u003C/strong> separa la deuda por antigüedad de la factura:\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>0-30\u003C/strong>: de hasta 30 días.\u003C/li>\n\u003Cli>\u003Cstrong>31-60\u003C/strong>: de 31 a 60 días.\u003C/li>\n\u003Cli>\u003Cstrong>61-90\u003C/strong>: de 61 a 90 días.\u003C/li>\n\u003Cli>\u003Cstrong>&gt;90\u003C/strong>: de más de 90 días.\u003C/li>\n\u003C/ul>\n\u003Cblockquote>\n\u003Cp>💡 \u003Cstrong>Consejo útil:\u003C/strong> mientras más plata hay en \u003Cstrong>&gt;90\u003C/strong>, más atrasado estás con tus proveedores.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                📋 Paso 4: Mirá la deuda de cada proveedor\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-4-mira-la-deuda-de-cada-proveedor\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-4-mira-la-deuda-de-cada-proveedor\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/70-finanzas/77-05-tabla-por-proveedor.png\" alt=\"Tabla con una fila del proveedor Distribuidora Ejemplo: importe total 1500, pagado 0, deuda 1500 en rojo\">\u003C/p>\n\u003Cp>Hay un renglón por cada proveedor con deuda. Las columnas dicen:\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Nombre\u003C/strong> y \u003Cstrong>CUIT\u003C/strong>: quién es el proveedor.\u003C/li>\n\u003Cli>\u003Cstrong>Importe Sin Imp.\u003C/strong>: lo que suman sus facturas sin impuestos.\u003C/li>\n\u003Cli>\u003Cstrong>Importe Total\u003C/strong>: lo que suman sus facturas con impuestos.\u003C/li>\n\u003Cli>\u003Cstrong>Pagado\u003C/strong>: lo que ya le pagaste.\u003C/li>\n\u003Cli>\u003Cstrong>Deuda\u003C/strong>: lo que todavía le debés. Va en rojo.\u003C/li>\n\u003Cli>\u003Cstrong>% Deuda/Total\u003C/strong>: qué parte de tu deuda total es de este proveedor.\u003C/li>\n\u003Cli>\u003Cstrong>0-30\u003C/strong>, \u003Cstrong>31-60\u003C/strong>, \u003Cstrong>61-90\u003C/strong> y \u003Cstrong>&gt;90\u003C/strong>: su deuda separada por antigüedad.\u003C/li>\n\u003C/ul>\n\u003Cp>Si un proveedor tiene saldo a favor, aparece en verde y arriba se muestra \u003Cstrong>Saldo a favor\u003C/strong> y \u003Cstrong>Deuda neta\u003C/strong>. Un proveedor sin deuda no aparece.\u003C/p>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                🧾 Paso 5: Abrí las facturas pendientes de un proveedor\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-5-abri-las-facturas-pendientes-de-un-proveedor\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-5-abri-las-facturas-pendientes-de-un-proveedor\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/70-finanzas/77-06-donde-esta-link-proveedor.png\" alt=\"Tabla de deuda con el nombre azul Distribuidora Ejemplo marcado en rojo\">\u003C/p>\n\u003Col>\n\u003Cli>Tocá el nombre del proveedor, en azul. Por ejemplo: \u003Cstrong>Distribuidora Ejemplo\u003C/strong>.\u003C/li>\n\u003Cli>Se abre \u003Cstrong>Pendientes de Pago\u003C/strong>, con las facturas sin pagar de ese proveedor.\u003C/li>\n\u003C/ol>\n\u003Cp>\u003Cimg src=\"/images/manual/70-finanzas/77-07-pantalla-pendientes-de-pago.png\" alt=\"Pantalla Pendientes de Pago del proveedor Distribuidora Ejemplo con los filtros y una factura\">\u003C/p>\n\u003Cp>Abajo del título se lee el nombre del proveedor que estás mirando.\u003C/p>\n\u003Cp>\u003Cimg src=\"/images/manual/70-finanzas/77-08-filtros-pendientes.png\" alt=\"Panel de filtros con Estado, Con Deuda, Proveedor, Clasificacion, Tipo Factura, Num Factura, Neto, Total, N° de OC, Desde, Hasta y los botones Descargar Excel y Buscar\">\u003C/p>\n\u003Cp>Para buscar una factura usá los filtros y tocá \u003Cstrong>Buscar\u003C/strong>:\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Estado\u003C/strong>: facturas \u003Cstrong>Abierto\u003C/strong> o \u003Cstrong>Cerrado\u003C/strong> (cerradas por un cierre contable).\u003C/li>\n\u003Cli>\u003Cstrong>Con Deuda\u003C/strong>, \u003Cstrong>Sin Clasificar\u003C/strong> y \u003Cstrong>Sin OC\u003C/strong>: tildalos para ver solo esas.\u003C/li>\n\u003Cli>\u003Cstrong>Proveedor\u003C/strong>: elegí otro proveedor.\u003C/li>\n\u003Cli>\u003Cstrong>Clasificacion\u003C/strong> y \u003Cstrong>Tipo Factura\u003C/strong>: el tipo de gasto y la letra de la factura.\u003C/li>\n\u003Cli>\u003Cstrong>CAPEX/OPEX\u003C/strong> y \u003Cstrong>Tipo Costo\u003C/strong>: si es inversión o gasto operativo, y si el costo es fijo o variable.\u003C/li>\n\u003Cli>\u003Cstrong>Num Factura\u003C/strong>, \u003Cstrong>Neto\u003C/strong> y \u003Cstrong>Total\u003C/strong>: escribí el dato exacto.\u003C/li>\n\u003Cli>\u003Cstrong>N° de OC\u003C/strong>: el número de la orden de compra.\u003C/li>\n\u003Cli>\u003Cstrong>Desde\u003C/strong> y \u003Cstrong>Hasta\u003C/strong>: el rango de fechas de la factura.\u003C/li>\n\u003Cli>\u003Cstrong>Descargar Excel\u003C/strong>: baja el resultado en una planilla.\u003C/li>\n\u003C/ul>\n\u003Cp>Abajo del buscador está la lista (se ve en la primera foto de este paso). Cada renglón muestra la fecha, lo que falta pagar, el tipo, el número, el proveedor, la observación y el botón \u003Cstrong>Acciones\u003C/strong>.\u003C/p>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                💸 Paso 6: Pagá una factura\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-6-paga-una-factura\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-6-paga-una-factura\">\u003C/div>\n\n\u003Cp>En esta pantalla no hay un botón \u003Cstrong>Registrar Pago\u003C/strong>. El pago se hace con el link \u003Cstrong>Pagar\u003C/strong> del menú \u003Cstrong>Acciones\u003C/strong>.\u003C/p>\n\u003Cp>\u003Cimg src=\"/images/manual/70-finanzas/77-10-menu-acciones-abierto.png\" alt=\"Menú Acciones abierto con Pagar marcado en rojo, y debajo Ver, Añadir items, Editar, Duplicar y Borrar\">\u003C/p>\n\u003Col>\n\u003Cli>En el renglón de la factura, tocá \u003Cstrong>Acciones\u003C/strong>.\u003C/li>\n\u003Cli>Se abre una lista. Tocá \u003Cstrong>Pagar\u003C/strong>.\u003C/li>\n\u003C/ol>\n\u003Cp>Las otras opciones de la lista son:\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Ver\u003C/strong>: muestra el detalle de la factura.\u003C/li>\n\u003Cli>\u003Cstrong>Añadir items\u003C/strong>: carga lo que compraste en esa factura.\u003C/li>\n\u003Cli>\u003Cstrong>Editar\u003C/strong>: corrige los datos de la factura.\u003C/li>\n\u003Cli>\u003Cstrong>Duplicar\u003C/strong>: hace una copia para cargar otra parecida.\u003C/li>\n\u003Cli>\u003Cstrong>Borrar\u003C/strong>: elimina la factura.\u003C/li>\n\u003C/ul>\n\u003Cblockquote>\n\u003Cp>⚠️ \u003Cstrong>Atención:\u003C/strong> \u003Cstrong>Borrar\u003C/strong> saca la factura y su deuda. Usalo solo si la cargaste por error.\u003C/p>\n\u003C/blockquote>\n\u003Cp>\u003Cimg src=\"/images/manual/70-finanzas/77-11-ventanita-pagar.png\" alt=\"Ventanita Nuevo Pago con fecha de pago, método, importe 1500, retenciones y el botón verde Pagar Ahora\">\u003C/p>\n\u003Cp>Se abre la ventanita \u003Cstrong>Nuevo Pago\u003C/strong>. Ya trae el importe que falta pagar.\u003C/p>\n\u003Cul>\n\u003Cli>\u003Cstrong>Fecha de Pago\u003C/strong>: cuándo pagaste. Si la dejás vacía, se crea una orden de pago que necesita aprobación.\u003C/li>\n\u003Cli>\u003Cstrong>Fecha Programada\u003C/strong>: solo para cheques o pagarés que se cobran más adelante.\u003C/li>\n\u003Cli>\u003Cstrong>Método\u003C/strong>: cómo pagás. Por ejemplo: efectivo o transferencia.\u003C/li>\n\u003Cli>\u003Cstrong>Importe\u003C/strong>: cuánto pagás. Podés escribir menos si pagás una parte.\u003C/li>\n\u003Cli>\u003Cstrong>ID Pago (opcional)\u003C/strong>: el número del cheque o de la tarjeta.\u003C/li>\n\u003Cli>\u003Cstrong>Comprobante\u003C/strong>: adjuntá la foto o el PDF del comprobante.\u003C/li>\n\u003Cli>\u003Cstrong>Observaciones\u003C/strong>: cualquier detalle que quieras anotar.\u003C/li>\n\u003Cli>\u003Cstrong>Retenciones\u003C/strong>: si el proveedor tiene retenciones, aparecen acá.\u003C/li>\n\u003Cli>\u003Cstrong>Pagar Ahora\u003C/strong>: confirma el pago.\u003C/li>\n\u003C/ul>\n\u003Cblockquote>\n\u003Cp>⚠️ \u003Cstrong>Atención:\u003C/strong> \u003Cstrong>Pagar Ahora\u003C/strong> registra el pago de verdad y baja la deuda. Revisá el \u003Cstrong>Método\u003C/strong> y el \u003Cstrong>Importe\u003C/strong> antes de tocarlo.\u003C/p>\n\u003C/blockquote>\n\u003Cp>Para cerrar la ventanita sin pagar, tocá la \u003Cstrong>×\u003C/strong> de arriba a la derecha.\u003C/p>\n\u003Cp>Más detalles del pago en \u003Ca href=\"/user-guide/pagos\">Pagos (Egresos)\u003C/a>.\u003C/p>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                ☑️ Paso 7: Pagá varias facturas juntas\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"paso-7-paga-varias-facturas-juntas\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"paso-7-paga-varias-facturas-juntas\">\u003C/div>\n\n\u003Cp>\u003Cimg src=\"/images/manual/70-finanzas/77-12-donde-esta-boton-pagar-seleccionados.png\" alt=\"Pantalla con la casilla Seleccionar Todos tildada y el botón azul Pagar 1.500 marcado en rojo\">\u003C/p>\n\u003Col>\n\u003Cli>Tildá la casilla de cada factura que querés pagar. O tocá \u003Cstrong>Seleccionar Todos\u003C/strong>.\u003C/li>\n\u003Cli>Aparece el botón azul \u003Cstrong>Pagar\u003C/strong> con el total. Por ejemplo: \u003Cstrong>Pagar $1.500\u003C/strong>.\u003C/li>\n\u003Cli>Tocalo para abrir la pantalla de pago de esas facturas.\u003C/li>\n\u003C/ol>\n\u003Cblockquote>\n\u003Cp>⚠️ \u003Cstrong>Atención:\u003C/strong> revisá qué facturas tildaste antes de tocar \u003Cstrong>Pagar\u003C/strong>. El total del botón es la suma de todas.\u003C/p>\n\u003C/blockquote>\n\u003Chr>\n\u003Ch2 class=\"relative\">\n                ⚠️ Resolución de Inconvenientes\n                \u003Cbutton \n                    class=\"ml-1.5 text-gray-400 hover:text-blue-500 hover:bg-gray-100 focus:text-blue-500 focus:bg-gray-100 focus:outline-none transition-all duration-200 text-sm align-middle px-1 py-0.5 rounded\"\n                    data-copy-section=\"resolucion-de-inconvenientes\"\n                    title=\"Copiar enlace a esta sección\"\n                    aria-label=\"Copiar enlace a esta sección\"\n                >\n                    🔗\n                \u003C/button>\n            \u003C/h2>\n            \u003Cdiv id=\"resolucion-de-inconvenientes\">\u003C/div>\n\n\u003Cdiv class=\"table-wrapper\">\u003Ctable>\n\u003Cthead>\n\u003Ctr>\n\u003Cth>Problema\u003C/th>\n\u003Cth>Causa más frecuente\u003C/th>\n\u003Cth>Solución recomendada\u003C/th>\n\u003C/tr>\n\u003C/thead>\n\u003Ctbody>\u003Ctr>\n\u003Ctd>\u003Cstrong>El proveedor no aparece en la tabla\u003C/strong>\u003C/td>\n\u003Ctd>No tiene deuda. Los proveedores saldados no se muestran.\u003C/td>\n\u003Ctd>Buscá sus facturas en \u003Ca href=\"/user-guide/historial-de-facturas\">Historial de Facturas\u003C/a>.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>La deuda total es $0,00\u003C/strong>\u003C/td>\n\u003Ctd>Todas las facturas están pagas o no hay ninguna cargada.\u003C/td>\n\u003Ctd>Cargá una en \u003Ca href=\"/user-guide/factura-manual\">Factura Manual\u003C/a>.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>Cargué una factura y no suma deuda\u003C/strong>\u003C/td>\n\u003Ctd>La factura se guardó con \u003Cstrong>Guardar y Pagar\u003C/strong> y ya se pagó.\u003C/td>\n\u003Ctd>Miralo en \u003Ca href=\"/user-guide/historial-de-facturas\">Historial de Facturas\u003C/a>, columna \u003Cstrong>Falta pagar\u003C/strong>.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>No veo el link Pagar en Acciones\u003C/strong>\u003C/td>\n\u003Ctd>Tu usuario no tiene permiso de pagos.\u003C/td>\n\u003Ctd>Pedile a un administrador que lo active en \u003Ca href=\"/user-guide/permisos-por-rol\">Permisos por Rol\u003C/a>.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>Pendientes de Pago dice &quot;No hay gastos pendientes de pago&quot;\u003C/strong>\u003C/td>\n\u003Ctd>El proveedor no tiene facturas sin pagar.\u003C/td>\n\u003Ctd>Tocá \u003Cstrong>Buscar\u003C/strong> con los filtros vacíos, o volvé al \u003Cstrong>Resumen de Deuda\u003C/strong>.\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Cstrong>Quiero ver la deuda de un solo local\u003C/strong>\u003C/td>\n\u003Ctd>Estás mirando el total de todos.\u003C/td>\n\u003Ctd>Tocá el nombre del local en el recuadro \u003Cstrong>Deuda por PDV / Centro de costo\u003C/strong>.\u003C/td>\n\u003C/tr>\n\u003C/tbody>\u003C/table>\u003C/div>\n",[5,9,12,15,18,21,24,27,30],{"id":6,"title":7,"level":8},"antes-de-empezar","Antes de empezar",2,{"id":10,"title":11,"level":8},"paso-1-entra-a-la-pantalla","Paso 1: Entrá a la pantalla",{"id":13,"title":14,"level":8},"paso-2-conoce-los-botones-de-arriba","Paso 2: Conocé los botones de arriba",{"id":16,"title":17,"level":8},"paso-3-lee-los-numeros","Paso 3: Leé los números",{"id":19,"title":20,"level":8},"paso-4-mira-la-deuda-de-cada-proveedor","Paso 4: Mirá la deuda de cada proveedor",{"id":22,"title":23,"level":8},"paso-5-abri-las-facturas-pendientes-de-un-proveedor","Paso 5: Abrí las facturas pendientes de un proveedor",{"id":25,"title":26,"level":8},"paso-6-paga-una-factura","Paso 6: Pagá una factura",{"id":28,"title":29,"level":8},"paso-7-paga-varias-facturas-juntas","Paso 7: Pagá varias facturas juntas",{"id":31,"title":32,"level":8},"resolucion-de-inconvenientes","Resolución de Inconvenientes",{"title":34,"description":35,"keywords":36},"Resumen de Deuda - Manual","¿Dónde está en el sistema?: Menú principal → Finanzas → Facturas y Pagos → Resumen de Deuda\n ¿Quién lo usa?: Encargados de Cuentas a P...","resumen de deuda, paxapos, resumen de deuda, tutorial, guía, manual usuario","77-resumen-de-deuda.txt"],"uses":{"params":["slug"]}}]}
